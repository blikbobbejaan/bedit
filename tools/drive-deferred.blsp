;; The DEFERRED modules, exercised from a session that never loaded them.
;;
;; Some of the editor's modules load on demand rather than at startup — `terminal.blsp` most of
;; all, because it pulls in `std/vt`. In a session that never opens a terminal its globals
;; are simply unbound. That is fine right up until an always-loaded module calls one: a
;; window resize answered `unbound symbol: terminal/term-sync-sizes` and a theme switch
;; answered `unbound symbol: terminal/term-repalette`, in the echo area, with the command
;; abandoned half-done (2026-09-22).
;;
;; Nothing else can catch this. `nest test` runs in an image that has loaded every module,
;; and so does every pty driver (`tools/term-plain.blsp` calls `project/load-sources`), so
;; for all of them the symbol is bound and the bug does not exist. The gap is exactly
;; "what the RELEASED editor loads", and the only way to stand in that image is to load
;; `main` and nothing else.
;;
;; So this driver runs its checks in a CHILD, from a directory outside the project — `nest
;; run` inside the project root loads every `src/` module, which would re-create the very
;; image we are trying to avoid.
(reflect/add-load-path (path/join (file/cwd) "tools"))
(require-one 'drive)

(def repo (file/cwd))

;; OUTSIDE the repo, deliberately — and not under `target/` either. `nest run` walks up
;; from the script for a project manifest and loads every `src/` module it finds, so a
;; probe anywhere inside bedit gets the all-modules-loaded image this driver exists to
;; avoid. (That is not hypothetical: the first version of this file put it in `target/`
;; and every check passed for the wrong reason.)
(def work (path/join (or (os/env "TMPDIR") "/tmp") "bedit-drive-deferred"))

;; The probe. `ok:`/`no:` lines are the wire back to this process: a child that dies on an
;; unbound symbol prints nothing more, which is itself the answer.
(def probe
  (str "(reflect/add-load-path \"" (path/join repo "src") "\")\n"
    "(require-one 'main)\n"
    ;; Whether terminal loaded with main: today it does (keymaps and the C-x p menu name its
    ;; commands). This said "deferred" while the module was called `term` only because
    ;; `bound? 'term/…` resolved to std's `term`, which has no `term-sync-sizes`. Asked of
    ;; the image's globals: `bound?` on a qualified name loads its module.
    "(io/puts (str \"info: terminal loaded at startup: \""
    " (includes? (reflect/global-names) 'terminal/term-sync-sizes)))\n"
    ;; The editor CATCHES a failing command and shows it in the echo area, so the fold
    ;; answers a perfectly good model either way — checking the shape is what made the
    ;; first version of this driver pass against the unfixed code. The echo is the verdict.
    "(defn- verdict (label m)\n"
    "  (let (echo (str (:echo m \"\")))\n"
    "    (io/puts (str (if (includes? echo \"unbound\") (str \"no: \" label \" — \" echo)"
    " (str \"ok: \" label))))))\n"
    "(let (m (model/ed-init (editor/buffer/make-buffer \"hello\")))\n"
    "  (do\n"
    "    (verdict \"a resize does not call into terminal.blsp\" (input/ed-update m [:resize 100 30] 100 30))\n"
    "    (verdict \"a theme switch does not call into terminal.blsp\" (themes/themes-apply m \"Nord\"))\n"
    ;; dired left commands.blsp (X1) and nothing `:use`s it: C-x d must still reach it. The
    ;; keymap swallows a failing command, so the echo proves nothing here — the PROMPT does.
    "    (io/puts (str \"info: dired loaded at startup: \" (bound? 'dired/cmd-dired)))\n"
    "    (io/puts (str (if (:minibuffer (input/ed-update (input/ed-update m :ctrl-x 100 30) \"d\" 100 30))\n"
    "                     \"ok:\" \"no:\")\n"
    "              \" C-x d opens the dired prompt\"))\n"
    ;; the Vim grammar left commands.blsp too, and the normal-mode keys name `vim/…`: in the
    ;; vim profile, `x` must still delete the character under point
    "    (io/puts (str \"info: vim loaded at startup: \" (bound? 'vim/cmd-vim-delete-char)))\n"
    "    (io/puts (str (if (= (editor/buffer/buffer-text (model/ed-current-buf\n"
    "                          (input/ed-update (commands/cmd-vim-mode m nil) \"x\" 100 30)))\n"
    "                          \"ello\")\n"
    "                     \"ok:\" \"no:\")\n"
    "              \" x in the vim profile deletes a character\"))\n"
    ;; init.blsp's :keys / :mode-keys in the released image: compiled (the M-x registry, the
    ;; mode registry), bound into the layers, and a bound key runs; the warnings and the
    ;; welcome text that names the user's keys reach no unbound symbol either
    "    (let (cfg {:keys {\"C-c f\" 'duplicate-line} :mode-keys {'markdown {\"C-c d\" 'duplicate-line}}}\n"
    "          bound (config/apply-to-model m cfg)\n"
    "          pressed (input/ed-update (input/ed-update bound :ctrl-c 100 30) \"f\" 100 30))\n"
    "      (io/puts (str (if (and (= (editor/buffer/buffer-text (model/ed-current-buf pressed)) \"hello\\nhello\")\n"
    "                           (empty? (config/init-warnings cfg \"/nonexistent/init.blsp\"))\n"
    "                           (includes? (main/welcome-text :emacs cfg) \"open\"))\n"
    "                       \"ok:\" \"no:\")\n"
    "                \" an init.blsp :keys binding runs, and checks clean\")))\n"
    ;; process-list is DEFERRED (nothing loads it until asked) and its command has no key:
    ;; M-x must still find and run it, typed the way a person types it
    "    (let (typed (fold (string/->list \"list-processes\") (input/ed-update m :alt-x 100 30)\n"
    "                  (fn (acc c) (input/ed-update acc c 100 30)))\n"
    "          ran (input/ed-update typed :enter 100 30))\n"
    "      (io/puts (str (if (= (editor/buffer/buffer-name (model/ed-current-buf ran)) \"*Process List*\")\n"
    "                       \"ok:\" \"no:\")\n"
    "                \" M-x list-processes runs the deferred process list\")))\n"
    ;; the slow-turn log answers in the released image (slowlog loads with main)
    "    (let (typed (fold (string/->list \"slow-turns\") (input/ed-update m :alt-x 100 30)\n"
    "                  (fn (acc c) (input/ed-update acc c 100 30)))\n"
    "          ran (input/ed-update typed :enter 100 30))\n"
    "      (io/puts (str (if (= (editor/buffer/buffer-name (model/ed-current-buf ran)) \"*Slow turns*\")\n"
    "                       \"ok:\" \"no:\")\n"
    "                \" M-x slow-turns opens the slow-turn report\")))\n"
    ;; collab-commands and project-search ARE deferred in this image: M-x share-session must
    ;; still find and run (its first step asks for your name), and C-x p g must reach its
    ;; command rather than an unbound symbol
    "    (let (typed (fold (string/->list \"share-session\") (input/ed-update m :alt-x 100 30)\n"
    "                  (fn (acc c) (input/ed-update acc c 100 30)))\n"
    "          ran (input/ed-update typed :enter 100 30))\n"
    "      (io/puts (str (if (and (:minibuffer ran) (bound? 'collab-commands/cmd-share-session)) \"ok:\" \"no:\")\n"
    "                \" M-x share-session reaches the deferred collab commands\")))\n"
    "    (verdict \"C-x p g reaches the deferred project search\"\n"
    "      (input/ed-update (input/ed-update (input/ed-update m :ctrl-x 100 30) \"p\" 100 30) \"g\" 100 30))\n"
    ;; C-h v and C-h f (help.blsp loads with main) reach config's settings registry, std's
    ;; `settings` and the reflect queries: each opens its *Help* page in the released image
    "    (doseq (probe [[\"v\" \"hl-line\" \":hl-line is an init.blsp setting\"]\n"
    "                    [\"f\" \"find-file\" \"find-file is an interactive command\"]])\n"
    "      (let ([key typed expected] probe\n"
    "            asked (input/ed-update (input/ed-update m :ctrl-h 100 30) key 100 30)\n"
    "            filled (fold (string/->list typed) asked (fn (acc c) (input/ed-update acc c 100 30)))\n"
    "            shown (input/ed-update filled :enter 100 30))\n"
    "        (io/puts (str (if (includes? (editor/buffer/buffer-text (model/ed-current-buf shown)) expected)\n"
    "                         \"ok:\" \"no:\")\n"
    "                  \" C-h \" key \" \" typed \" opens its *Help* page\"))))\n"
    ;; C-h P reaches packages' facts (help `:use`s packages); a list already known (empty),
    ;; so the probe asks no registry
    "    (let (asked (input/ed-update (input/ed-update (assoc m :package-list []) :ctrl-h 100 30) \"P\" 100 30)\n"
    "          filled (fold (string/->list \"zz\") asked (fn (acc c) (input/ed-update acc c 100 30)))\n"
    "          shown (input/ed-update filled :enter 100 30))\n"
    "      (io/puts (str (if (includes? (str (:echo shown)) \"no package zz\") \"ok:\" \"no:\")\n"
    "                \" C-h P describes a package, or says there is none\")))\n"
    ;; so-long (solong.blsp loads with main) is called from the view, eldoc, rainbow, spell,
    ;; the pool's open paths, frames, remote and collab: a file with a long line must open
    ;; in the cheap state by every path, paint, and toggle by M-x, in the released image
    "    (let (long-file (str \"" work "/long.log\")\n"
    "          _ (file/spit long-file (str \"a\\n\" (string/repeat \"x=1;\" 4000) \"\\n\"))\n"
    "          opened (pool/ed-find-file m long-file)\n"
    "          frame (view/ed-view opened 100 30)\n"
    "          jumped (pool/ed-pop-to-file m long-file 2)\n"
    "          typed (fold (string/->list \"so-long-mode\") (input/ed-update opened :alt-x 100 30)\n"
    "                  (fn (acc c) (input/ed-update acc c 100 30)))\n"
    "          toggled (input/ed-update typed :enter 100 30)\n"
    "          served ((remote/ed-serve-model long-file)))\n"
    "      (io/puts (str (if (and (solong/so-long? (model/ed-current-buf opened))\n"
    "                          (includes? (str (:echo opened)) \"so-long\"))\n"
    "                       \"ok:\" \"no:\")\n"
    "                \" find-file opens a long-line file in so-long's state\"))\n"
    "      (io/puts (str (if (any? frame (fn (op) (includes? (str op) \"render error\"))) \"no:\" \"ok:\")\n"
    "                \" a so-long buffer paints\"))\n"
    "      (io/puts (str (if (solong/so-long? (model/ed-current-buf jumped)) \"ok:\" \"no:\")\n"
    "                \" a jump to a location opens it in so-long's state\"))\n"
    "      (io/puts (str (if (and (not (solong/so-long? (model/ed-current-buf toggled)))\n"
    "                          (includes? (str (:echo toggled)) \"so-long-mode off\"))\n"
    "                       \"ok:\" \"no:\")\n"
    "                \" M-x so-long-mode toggles it off\"))\n"
    "      (io/puts (str (if (solong/so-long? (model/ed-current-buf served)) \"ok:\" \"no:\")\n"
    "                \" a served session's file opens in so-long's state\")))))\n"))

(defn- run-probe ()
  "Run the probe in a child outside the project; answer its combined output."
  (let (script (path/join work "probe.blsp")
        _ (file/mkdir work)
        _2 (file/spit script probe)
        r (os/cmd "nest" ["run" script] {:cwd work}))
    (str (:stdout r "") (:stderr r ""))))

(let (out (run-probe)
      lines (seq/filter (string/split out "\n")
              (fn (l) (or (string/starts-with? l "ok:") (string/starts-with? l "no:"))))
      verdicts (map lines (fn (l) [(string/starts-with? l "ok:") (string/substring l 4 (string/length l))])))
  (do
    (doseq (v verdicts) (let ([ok label] v) (drive/check label ok)))
    ;; A child that died mid-way printed fewer lines than it has checks, and an absent
    ;; check is not a passing one.
    (drive/check "the probe ran every check (none died on an unbound symbol)"
      (= (count verdicts) 17))
    (when (< (count verdicts) 17)
      (io/puts "   the child's output was:")
      (doseq (l (seq/filter (string/split out "\n") (fn (l) (not (string/blank? l)))))
        (io/puts (str "     " l))))
    (drive/done "deferred-module checks")))
