(defmodule drive-term
  "A terminal buffer, driven end to end through the real `ui-run`: a program under a pty,
its screen emulated by `std/vt` in the buffer's worker, painted into the buffer.

The model tests fold synthetic screens and drive the worker directly; what they cannot
show is the whole chain in one process — `M-x term` opening the buffer sized to the pane,
the overlay handing a typed key to the worker (not the buffer), the worker's screen event
reaching the loop and the FRAME painting the program's answer with the cursor where the
program left it, and `C-x k` taking the worker down with the buffer.

    nest run tools/drive-term.blsp"
  (:use-internals bedit/input)
  (:use-internals bedit/terminal))

(require-one 'project)
(project/load-config)
(let (root (project/find-root (file/cwd)))
  (when root (project/setup root) (project/load-sources root)))

(def *cols* 100)
(def *rows* 30)
(def *deadline-ms* 15000)
(def *pause-ms* 300)

(def *failures* (%table))

(defn check (what ok)
  (do
    (io/puts (str (if ok "  ok  " "  FAIL ") what))
    (when (not ok) (%table-put *failures* :n (inc (%table-get *failures* :n 0))))
    ok))

;; The script is held back until the loop says the program is READY (`[:open]`): keys typed
;; before a shell prints its prompt are echoed by the pty ahead of it, and the screen would
;; read `echo driven` then `> driven` — true of any terminal, and not what is being tested.
(defn sched-loop (pending open?)
  (receive
    ([:next from]
      (if (or (not open?) (empty? pending))
        (do (send from [:scripted nil]) (sched-loop pending open?))
        (do (send from [:scripted (first pending)]) (sched-loop (rest pending) open?))))
    ([:open] (sched-loop pending true))
    ([:stop] nil)))

(defn poll-fn (sch me t0)
  (fn (ms)
    (let (scripted (if (> (- (os/now) t0) *deadline-ms*)
                     ;; past the deadline the poll says so itself: a run whose keys went
                     ;; astray has nothing left to wake the loop, so a deadline checked
                     ;; only in `update` would wait for ever instead of failing
                     :deadline
                     (do (send sch [:next me]) (receive ([:scripted e] e) (after 5000 nil)))))
      ;; `:idle` in a script is a pause: a poll with nothing typed that waits
      ;; `*pause-ms*`, past the idle beat's debounce, so the loop's timers come due as they
      ;; do when your hands leave the keys (the loop's own `ms` may be shorter, or far
      ;; longer when nothing is armed).
      ;; A message still ends it early: the program's echo lands before the pause does
      (cond
        ;; capped, so the deadline above is looked at even when nothing is armed
        (nil? scripted) (receive (msg msg) (after (math/max 1 (math/min ms 1000)) nil))
        (= scripted :idle) (receive (msg msg) (after *pause-ms* nil))
        :else scripted))))

;; The last frame painted, kept in a table so the assertions can read what the SCREEN
;; showed, not only what the model holds.
(def *last-frame* (%table))

(defn frame-text (frame)
  "Every `[:text row col s …]` op's string, joined — enough to look for a needle."
  (string/join (map (seq/filter frame (fn (op) (and (vector? op) (= (first op) :text)))) (fn (op) (nth op 3))) "\n"))

(defn frame-rows (frame)
  "Each screen row as it reads: its `[:text row col s …]` ops in column order, joined. A
row of several colours is several ops, so [[frame-text]] would cut it at each colour."
  (let (ops (seq/filter frame (fn (op) (and (vector? op) (= (first op) :text))))
        by-row (seq/group-by ops (fn (op) (nth op 1))))
    (map (sort (keys by-row))
      (fn (row) (string/join (map (seq/sort-by (get by-row row) (fn (op) (nth op 2))) (fn (op) (nth op 3))) "")))))

(defn drive (m0 script ready? arrived? on-arrival what)
  (let (t0 (os/now)
        sch (spawn (fn () (sched-loop script false)))
        me (self)
        display {:enter (fn () nil)
                 :leave (fn () nil)
                 :size (fn () [*cols* *rows*])
                 :draw (fn (frame) (%table-put *last-frame* :frame frame))
                 :poll (poll-fn sch me t0)}
        update (fn (m input cols rows)
                 (let (next (if (= input :deadline) m (input/ed-update m input cols rows))
                       _ (when (ready? next) (send sch [:open])))
                   (cond
                     (arrived? next) (do (on-arrival next) (assoc next :done true))
                     (or (= input :deadline) (> (- (os/now) t0) *deadline-ms*))
                       (do (check (str what " arrived before the deadline") false)
                         (assoc next :done true))
                     :else next))))
    (do (editor/ui/ui-run m0 view/ed-view update display) (send sch [:stop]))))

(defn term-buf (m)
  (let (i (model/ed-buffer-index-by-name m (terminal/term-buffer-name "term" (file/cwd))))
    (if (nil? i) nil (nth (:buffers m) i))))

(defn drive-term (m0)
  ;; `sh -i` with a known prompt stands in for a program: `cmd-term` runs `$SHELL`, and
  ;; the driver names its program directly through the same opener
  (let (opened (terminal/term-open m0 "term" "PS1='> ' sh -i")
        b (term-buf opened))
    (do
      (check "M-x term opened a :term buffer for this project" (and b (= (:type b) :term)))
      ;; the pane keeps a column and the mode-line / echo rows for itself
      (check "sized to the pane, not a default"
        (and b (>= (first (:term-size b)) (- *cols* 2)) (< (first (:term-size b)) *cols*)
          (< (second (:term-size b)) *rows*) (> (second (:term-size b)) 24)))
      (drive opened
        ;; wait for the prompt, then type a command; the keys are the overlay's to route
        (list "e" "c" "h" "o" " " "d" "r" "i" "v" "e" "n" :enter)
        (fn (m) (let (tb (term-buf m)) (and tb (includes? (editor/buffer/buffer-text tb) "> "))))
        (fn (m) (let (tb (term-buf m)) (and tb (includes? (editor/buffer/buffer-text tb) "\ndriven"))))
        (fn (m)
          (let (tb (term-buf m)
                text (editor/buffer/buffer-text tb)
                ;; the loop stops on arrival, before its next draw — so ask the pure view for
                ;; the frame this model paints, and keep the last drawn one as a sanity check
                painted (frame-text (view/ed-view m *cols* *rows*))
                drawn (frame-text (%table-get *last-frame* :frame [])))
            (do
              (check "the typed line reached the program, not the buffer (it was echoed, not inserted)"
                (includes? text "> echo driven"))
              (check "the program's answer is in the buffer" (includes? text "\ndriven\n"))
              (check "point is the program's cursor — after the prompt that followed"
                (string/ends-with? (string/substring text 0 (editor/buffer/buffer-point (model/ed-current-buf m))) "\ndriven\n> "))
              (check "and the FRAME paints the answer" (includes? painted "driven"))
              (check "…the loop having drawn the program's prompt on the way" (includes? drawn "> "))
              (check "the buffer is read-only to the user" (editor/buffer/read-only? tb))
              ;; take the program down with the run: a worker left behind keeps its pty
              ;; child, and a child that outlives the driver holds whatever the driver held
              (commands/cmd-kill-buffer m nil))))
        "the program's answer"))))

(defn drive-colour-pause (m0)
  ;; A prompt of several colours on one row (a zsh prompt's shape), and a pause mid-word.
  ;; vt once handed a row's spans back last-first and the frame drew the prompt twice
  ;; (`dir main > main > …`); and the pause let the idle beat set an inline completion
  ;; preview at the program's cursor, which then took every key the program should have
  ;; had, so the program never answered. `window` is on the screen before the prompt, so
  ;; `win` (a preview wants three characters) has a candidate; the outer `sh` prints it
  ;; rather than the script typing it, since keys typed ahead of a prompt echo out of order
  (let (prompt "$(printf '\\033[34mdir\\033[0m \\033[35mmain\\033[0m \\033[32m>\\033[0m ')"
        opened (terminal/term-open m0 "term" (str "echo window; PS1=\"" prompt "\" sh -i")))
    (drive opened
      ;; two pauses: the word index a preview completes from is built OFF the loop by a
      ;; pause, so the preview a pause shows comes from the index the pause before it
      ;; built — as it does when you have been looking at the screen a while
      (append (list "e" "c" "h" "o" " " "w" "i")
        (seq/repeat 6 :idle)
        (list "n")
        (seq/repeat 6 :idle)
        (list "d" "o" :enter))
      (fn (m) (let (tb (term-buf m)) (and tb (includes? (editor/buffer/buffer-text tb) "> "))))
      (fn (m) (let (tb (term-buf m)) (and tb (includes? (editor/buffer/buffer-text tb) "\nwindo\n"))))
      (fn (m)
        (let (tb (term-buf m)
              text (editor/buffer/buffer-text tb)
              rows (frame-rows (view/ed-view m *cols* *rows*)))
          (do
            (check "the keys typed after the pause reached the program" (includes? text "> echo windo\nwindo\n"))
            (check "nothing was typed into the read-only buffer" (not (includes? (str (:message m)) "read-only")))
            (check "the coloured prompt paints once" (any? rows (fn (row) (includes? row "dir main > echo windo"))))
            (check "…and never twice over" (not (any? rows (fn (row) (includes? row "main > main")))))
            (commands/cmd-kill-buffer m nil))))
      "the answer to the keys typed after a pause")))

(defn drive-kill (m0)
  (let (opened (terminal/term-open m0 "term" "PS1='> ' sh -i")
        pid (:term-proc (term-buf opened)))
    (do
      (check "the worker is alive" (proc/alive? pid))
      (let (killed (commands/cmd-kill-buffer opened nil))
        (do
          (check "C-x k removed the buffer" (nil? (term-buf killed)))
          ;; the worker gets `[:shutdown]` from the layer's :on-close and leaves
          (receive (:never nil) (after 300 nil))
          (check "…and its worker with it" (not (proc/alive? pid))))))))

(let (_ (proc/register :editor (self))
      m0 (assoc (model/ed-init (editor/buffer/make-buffer "" "*scratch*"))
           :recent-files false
           :_lc [*cols* *rows*]))
  (do
    (io/puts "== a program under a pty answers through the buffer")
    (drive-term m0)
    (io/puts "== a coloured prompt, and a pause mid-word")
    (drive-colour-pause m0)
    (io/puts "== killing the buffer stops the program")
    (drive-kill m0)
    (io/puts "")
    (if (= (%table-get *failures* :n 0) 0)
      (io/puts "the terminal buffer hosts a program end to end")
      (error "drive-term: " (%table-get *failures* :n 0) " check(s) failed"))))
