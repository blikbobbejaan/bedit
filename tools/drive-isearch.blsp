;; isearch's count, regexp search and toggles — in a real terminal, on the real loop.
;;
;; The match count is the one part of isearch no model test can prove: it is taken by a
;; TIMER of its own once typing pauses (`isearch/isearch-count-timer`), a slice per turn, so
;; only the live loop arms it, fires it and paints what it wrote. `3/3` on screen is the
;; whole chain. And C-M-s / M-r are key NAMES the terminal frontend has to produce from
;; `ESC C-s` / `ESC r`, which only a frontend proves.
(reflect/add-load-path (path/join (file/cwd) "tools"))
(require-one 'drive)

(let (s (drive/start "term-plain.blsp" {:rows 30 :cols 110}))
  (do
    (drive/check "editor is up" (drive/wait-for s "*scratch*" 20000))
    ;; a plain-text buffer: brood-mode's C-M-s is paredit's splice, not a search
    (drive/send-keys s "\x18bnotes.txt\r" 600) ; C-x b notes.txt RET
    (drive/send-keys s "zork bar zork baz zork\r" 500)
    (drive/send-keys s "\x1b<" 300) ; M-<
    (drive/send-keys s "\x13zork" 600) ; C-s zork
    (drive/check "the count arrives once typing pauses" (drive/wait-for s "1/3 I-search: zork" 10000))
    (drive/send-keys s "\x13" 400) ; C-s
    (drive/check "C-s moves the ordinal" (drive/wait-for s "2/3 I-search: zork" 10000))
    (drive/send-keys s "\x1br" 400) ; M-r
    (drive/check "M-r makes it a regexp search" (drive/wait-for s "2/3 Regexp I-search: zork" 10000))
    (drive/send-keys s "\r" 300) ; RET
    (drive/send-keys s "\x1b<" 300) ; M-<
    (drive/send-keys s "\x1b\x13zork ba[rz]" 600) ; C-M-s zork ba[rz]
    (drive/check "C-M-s searches by regexp, and counts it"
      (drive/wait-for s "1/2 Regexp I-search: zork ba[rz]" 10000))
    (drive/send-keys s "\x07" 300) ; C-g
    (drive/quit s)
    (drive/done "isearch checks")))
