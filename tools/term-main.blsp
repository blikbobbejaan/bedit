;; Run bedit's REAL entry point — `main/main` — with the arguments in $BEDIT_DRIVE_ARGS
;; (space-separated), for the drivers that test what `main` itself decides: `-nw`, and the
;; terminal it falls back to with no display (tools/drive-nw.blsp). Unlike term-plain.blsp,
;; nothing here is a harness's stand-in: the lifeline, the logger, the startup path and the
;; frontend choice are main's own.
(require-one 'project)
(project/load-config)
(let (root (project/find-root (file/cwd)))
  (when root
    (project/setup root)
    (project/load-sources root)))
(let (args (seq/reject (string/split (or (os/env "BEDIT_DRIVE_ARGS") "") " ") (fn (arg) (= arg ""))))
  (apply main/main args))
