;; tools/profile-mbox.blsp — mbox navigation, timed at the top, middle and bottom of a file.
;;
;; "The mbox navigation is really slow lower down": every turn here should cost the same
;; wherever point is. A number that grows down the file is an O(position) cost — a whole-text
;; string, a scan back to the nearest `From ` line, a char offset converted from the start.
;;
;;     nest run tools/profile-mbox.blsp -- <file.mbox> <cols> <rows>
(require-one 'project)
(project/load-config)
(let (root (project/find-root (file/cwd)))
  (when root
    (project/setup root)
    (project/load-sources root)))

(def *args* (let (a (system/argv) i (index-of a "--")) (if i (drop a (inc i)) (list))))
(def *file* (first *args*))
(def *cols* (let (n (string/->number (or (second *args*) "213"))) (if (int? n) n 213)))
(def *rows* (let (n (string/->number (or (nth *args* 2) "49"))) (if (int? n) n 49)))

(defn ms (label thunk reps)
  "Run `thunk` `reps` times; print the mean wall ms; answer the last result."
  (let (start (os/now-ns)
        result (fold (range reps) nil (fn (_ _) (thunk)))
        elapsed (/ (- (os/now-ns) start) (* reps 1000000.0)))
    (do
      (io/puts (str (string/pad-right label 44) (string/pad-left (string/format "%.2f" elapsed) 9) " ms"))
      result)))

(defn press (m keys) (fold keys m (fn (acc key) (input/ed-update acc key *cols* *rows*))))

(defn frame (m) (view/ed-view m *cols* *rows*))

(defn turns (label m keys reps)
  "Time `reps` whole loop turns — the `keys` pressed, then a frame — each from `m`."
  (ms label (fn () (frame (press m keys))) reps))

(def *base*
  (input/ed-update
    (pool/ed-find-file (model/ed-init (editor/buffer/make-buffer "" "*scratch*")) *file*)
    [:timer :idle-recompute]
    *cols*
    *rows*))

(def *length* (editor/buffer/buffer-length (model/ed-current-buf *base*)))

(io/puts (str "== " *file* " · " (editor/buffer/buffer-line-count (model/ed-current-buf *base*))
           " lines · " *length* " chars · mode "
           (model/ed-buf-mode-name (model/ed-current-buf *base*))))

(defn at-fraction (fraction)
  "`*base*` with point `fraction` of the way down, scrolled to show it and its spans cached."
  (let (buf (model/ed-current-buf *base*)
        target (math/floor (* fraction *length*))
        moved (model/ed-set-buf *base* (editor/buffer/goto-char buf target)))
    (press moved [:ctrl-l])))

(map [["top" 0.0] ["middle" 0.5] ["bottom" 0.98]]
  (fn ([where fraction])
    (let (m (at-fraction fraction))
      (do
        (io/puts "")
        (io/puts (str "-- " where))
        (turns "turn: C-n" m [:ctrl-n] 10)
        (turns "turn: C-v (page down)" m [:ctrl-v] 10)
        (turns "turn: M-v (page up)" m [(keyword "alt-v")] 10)
        (turns "turn: C-c C-n (next message)" m [:ctrl-c :ctrl-n] 5)
        (turns "turn: C-c C-p (previous message)" m [:ctrl-c :ctrl-p] 5)
        (turns "turn: idle beat" m [[:timer :idle-recompute]] 5)
        (ms "command alone: next message" (fn () (languages/cmd-mbox-next-message m nil)) 10)
        (ms "command alone: previous message" (fn () (languages/cmd-mbox-previous-message m nil)) 10)
        (ms "fontify-restart over a 260-line window"
          (fn ()
            (let (buf (model/ed-current-buf m)
                  rope (editor/buffer/buffer-rope buf)
                  line (editor/buffer/buffer-current-line buf)
                  from (text/line->char rope (math/max 0 (- line 200)))
                  chunk (text/slice rope from (text/line->char rope (+ line 60))))
              (languages/mbox-fontify-restart chunk (- (text/line->char rope line) from))))
          10)))))
