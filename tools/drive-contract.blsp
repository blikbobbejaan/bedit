;; A command's marginalia in M-x — its key, its docstring, and its declared contract only
;; when that says something — which only a live run paints.
;;
;; `M-x` lists each command with the key bound to it, its docstring's first line, and its
;; `model -> model` contract in the right margin. Every `defcommand` declares the same
;; contract (`model any → model`), so plume leaves that one out (ed6fc3e6): it shows a
;; contract only for a command redefined live to claim something else. The model tests build
;; the annotation strings (tests/minibuffer_commands_test.blsp); only a frontend proves they reach the
;; Plume list the reader sees. The C-x C-e verdict on a redefined defcommand
;; (`✓ … honours (model any -> model)`) is covered by the model suite
;; (tests/eval_command_test.blsp) — the term harness forwards only record events, so a
;; task-reply eval cannot complete here.
(reflect/add-load-path (path/join (file/cwd) "tools"))
(require-one 'drive)

(let (s (drive/start "term-plain.blsp" {:rows 34 :cols 140}))
  (do
    (drive/check "editor is up" (drive/wait-for s "*scratch*" 20000))
    (drive/send-keys s "\x1bx" 400) ; M-x
    (drive/check "M-x prompt" (drive/wait-for s "M-x" 5000))
    (drive/send-keys s "forward-char" 600)
    (drive/check "the command's docstring shows in the marginalia"
      (drive/wait-for s "Move point one character forward" 8000))
    (drive/check "…alongside the key it is bound to" (drive/wait-for s "C-f" 8000))
    (drive/check "…and not the contract every command declares" (drive/gone? s "model any"))
    (drive/quit s)
    (drive/done "command marginalia checks")))
