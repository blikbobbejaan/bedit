;; The held tree-sitter tree (brood ADR-443): a tree-sitter buffer's highlighting comes from
;; the document's own parse, updated incrementally per edit, instead of a sliced window
;; parsed from scratch. A handle is freed only when a turn commits
;; (`ed-release-dropped-trees`), so a test that checks a handle is gone releases first.
(defmodule syntaxtree-test
  (:use model)
  (:use-internals panes)
  (:use pool)
  (:use main)
  (:use-internals syntaxtree)
  (:use treewarm)
  (:use editor/buffer)
  (:use test))

(defn ruby-model (text) (ed-init (make-buffer text "x.rb" "x.rb")))
(defn big-ruby (n) (string/join (map (range n) (fn (i) (str "def f" i "\n  " i "\nend"))) "\n"))
(defn refreshed (m) (ed-refresh-spans m 80 24))
(defn band-of (m)
  (get (:span-cache m) (:path (ed-selected-pane (:panes (ed-body-layout m 80 24))))))
(defn edited-at (m position text)
  (ed-set-buf m (insert (goto-char (ed-current-buf m) position) text)))
(defn has-span? (spans from to)
  (any? spans (fn (span) (and (= (nth span 0) from) (= (nth span 1) to)))))

(describe "syntaxtree: the services a held tree is coloured with"
  (test "a deflanguage mode names its face table and language"
    (let (buf (ed-current-buf (ruby-model "def f\nend\n")))
      (assert= (ed-mode-service buf :ts-lang) :ruby)
      (is (map? (ed-mode-service buf :ts-faces)))))

  (test "a lexer-only mode has no face table, so it keeps the slice path"
    (let (m (refreshed (ed-init (make-buffer "A=1\n" ".env" ".env"))))
      (is (nil? (ed-mode-service (ed-current-buf m) :ts-faces)))
      (is (nil? (syntax-tree-entry m 0))))))

(describe "syntaxtree: a tree per buffer, kept across edits"
  (test "the first refresh opens the shown buffer's tree and colours the band from it"
    (let (m (refreshed (ruby-model "def f\nend\n"))
          entry (syntax-tree-entry m 0)
          band (band-of m))
      (is (not (nil? entry)))
      (is (= (:rope entry) (buffer-rope (ed-current-buf m))))
      (assert= (:lang entry) :ruby)
      (is (:tree? band))
      (is (has-span? (:spans band) 0 3))))

  (test "an edit updates the tree from the old one, and the committed turn frees the old handle"
    (let (m0 (refreshed (ruby-model "def f\nend\n"))
          old (syntax-tree-entry m0 0)
          m1 (refreshed (edited-at m0 0 "x = 1\n"))
          new (syntax-tree-entry m1 0))
      (is (= (:rope new) (buffer-rope (ed-current-buf m1))))
      (is (= (:from-rope new) (:rope old)))
      (is (vector? (:changes new)))
      ;; not freed until the turn commits
      (is (not (nil? (tree-changed-ranges (:tree old)))))
      (ed-release-dropped-trees m0 m1)
      (is (nil? (tree-changed-ranges (:tree old))))
      (is (not (nil? (tree-changed-ranges (:tree new)))))
      ;; the def moved down six chars and is still coloured, in absolute offsets
      (is (has-span? (:spans (band-of m1)) 6 9))))

  (test "a turn rolled back to the model before it frees nothing that model names"
    (let (m0 (refreshed (ruby-model "def f\nend\n"))
          tree (:tree (syntax-tree-entry m0 0)))
      (ed-release-dropped-trees m0 m0)
      (is (not (nil? (tree-changed-ranges tree))))))

  (test "an edit far below the band keeps its spans and re-stamps its rope"
    (let (m0 (refreshed (ruby-model (big-ruby 300)))
          band0 (band-of m0)
          end (buffer-length (ed-current-buf m0))
          ;; point stays at the top, so the viewport does not follow the edit
          m1 (refreshed (ed-set-buf m0
                          (goto-char (insert (goto-char (ed-current-buf m0) end) "\nx = 1") 0)))
          band1 (band-of m1))
      (is (= (:spans band1) (:spans band0)))
      (is (= (:rope band1) (buffer-rope (ed-current-buf m1))))))

  (test "an edit inside the band re-colours it from the updated tree"
    (let (m1 (refreshed (edited-at (refreshed (ruby-model (big-ruby 300))) 0 "x = 1\n"))
          band (band-of m1))
      (is (:tree? band))
      (is (= (:rope band) (buffer-rope (ed-current-buf m1))))
      (is (has-span? (:spans band) 6 9))))

  (test "a band nothing colours is an empty band, not a gone handle"
    (let (m (refreshed (ruby-model "\n\n\n")))
      (is (:tree? (band-of m)))
      (assert= (:spans (band-of m)) [])))

  ;; a gone handle counts as none: a small buffer reopens its tree (a large one waits for
  ;; the warm, below) rather than sitting on the slice path until its rope moves
  (test "a gone handle in a small buffer is reopened"
    (let (m0 (refreshed (ruby-model "def f\nend\n"))
          gone (:tree (syntax-tree-entry m0 0))
          _ (tree-free gone)
          m1 (refreshed (assoc m0 :span-cache {}))
          band (band-of m1))
      (is (not (= (:tree (syntax-tree-entry m1 0)) gone)))
      (is (:tree? band))
      (is (has-span? (:spans band) 0 3))))

  (test "a buffer too large to parse on the loop waits for the warm"
    (binding (*tree-open-max* 10)
      (let (m (refreshed (ruby-model "def f\nend\ndef g\nend\n")))
        (is (nil? (syntax-tree-entry m 0)))
        (is (has-span? (:spans (band-of m)) 0 3))))))

(describe "syntaxtree: a tree's lifetime follows its buffer"
  (test "dropping a pool slot frees its tree on commit and shifts the ones above it down"
    (let (trees (map (range 3)
                  (fn (i) (tree-open (text/from-string (str "def f" i "\nend\n")) :ruby)))
          m0 (fold (range 3)
               (ruby-model "")
               (fn (acc i) (install-syntax-tree acc i (nth trees i) nil :ruby)))
          m1 (ed-release-dropped-trees m0 (ed-drop-syntax-tree-slot m0 1)))
      (assert= (vec (sort (keys (:syntax-trees m1)))) [0 1])
      (is (nil? (tree-changed-ranges (nth trees 1))))
      (is (= (:tree (syntax-tree-entry m1 1)) (nth trees 2)))
      (is (= (:tree (syntax-tree-entry m1 0)) (nth trees 0)))))

  (test "a warm in flight follows the pool shift, and aims at nothing when its buffer is killed"
    (let (warming (fn (index killed)
                    (:tree-warm-index (ed-drop-syntax-tree-slot (assoc (ruby-model "")
                                                                  :tree-warm-index index)
                                        killed))))
      (assert= (warming 2 1) 1)
      (assert= (warming 0 1) 0)
      (is (nil? (warming 1 1)))))

  (test "killing a buffer frees its tree once the turn commits"
    ;; the second buffer is not on screen, so its tree is installed by hand, as a warm would
    (let (opened (ed-open-buffer (ruby-model "def f\nend\n")
                   (make-buffer "def g\nend\n" "y.rb" "y.rb"))
          tree (tree-open (text/from-string "def g\nend\n") :ruby)
          m0 (install-syntax-tree opened 1 tree nil :ruby)
          m1 (ed-release-dropped-trees m0 (ed-kill-buffer-at m0 1)))
      (is (not (nil? tree)))
      (is (nil? (syntax-tree-entry m1 1)))
      (is (nil? (tree-changed-ranges tree)))))

  (test "a warm's tree is installed for its slot, or freed when the slot has one"
    (let (m0 (ruby-model "def f\nend\n")
          rope (buffer-rope (ed-current-buf m0))
          warmed (tree-open rope :ruby)
          m1 (treewarm/ed-apply-tree-warm (assoc m0 :tree-warm-index 0)
               {:tree warmed :rope rope :lang :ruby})
          spare (tree-open rope :ruby)
          m2 (treewarm/ed-apply-tree-warm (assoc m1 :tree-warm-index 0)
               {:tree spare :rope rope :lang :ruby}))
      (is (= (:tree (syntax-tree-entry m1 0)) warmed))
      (is (= (:tree (syntax-tree-entry m2 0)) warmed))
      (is (nil? (tree-changed-ranges spare)))
      (is (nil? (:tree-warm-index m2))))))

;; The update is TOLD what changed, from the buffer's own splice log, so the kernel does not
;; compare the old rope with the new one to find it. Several edits in one turn are several
;; splices, each against the text the one before it left.
(describe "syntaxtree: the edits an update is told"
  (test "one splice per edit, oldest first, in the kernel's [start old-end new-end] shape"
    (let (buf (ed-current-buf (ruby-model "def f\nend\n"))
          typed (insert (goto-char buf 0) "x = 1\n")
          ;; a second edit away from the first, so no splice log merges the two
          again (insert (goto-char typed 9) "zz"))
      (assert= (syntaxtree/splice-edits (buffer-rope buf) typed) [[0 0 6]])
      (assert= (syntaxtree/splice-edits (buffer-rope buf) again) [[0 0 6] [9 9 11]])
      ;; the same text, or a change the log cannot account for: nil — the kernel compares
      (is (nil? (syntaxtree/splice-edits (buffer-rope typed) typed)))
      (is (nil? (syntaxtree/splice-edits (buffer-rope (make-buffer "other")) typed)))))

  (test "a tree updated through several edits colours as a fresh parse of the result does"
    (let (m0 (refreshed (ruby-model (big-ruby 20)))
          buf (ed-current-buf m0)
          ;; two edits in one turn, the second inside the first's text
          twice (insert (goto-char (insert (goto-char buf 0) "x = 1\n") 4) "22")
          m1 (refreshed (ed-set-buf m0 twice))
          entry (syntax-tree-entry m1 0)
          fresh (tree-open (buffer-rope twice) :ruby)
          faces (ed-mode-service twice :ts-faces)
          length (buffer-length twice))
      (assert= (buffer-text twice) (str "x = 221\n" (big-ruby 20)))
      (is (= (:from-rope entry) (buffer-rope buf)))
      (assert= (tree-spans (:tree entry) faces 0 length) (tree-spans fresh faces 0 length))
      (tree-free fresh))))

;; The structural queries read the held tree (brood ADR-467) — but only one parsed from the
;; very text they are asked about, and a gone handle falls back to parsing that text.
(describe "syntaxtree: the structural queries are handed the held tree"
  (test "a tree is handed over only for its own rope and language"
    (let (m (refreshed (ruby-model "def f\nend\n"))
          entry (syntax-tree-entry m 0)
          buf (ed-current-buf m))
      (is (= (held-tree-for entry buf :ruby) (:tree entry)))
      (is (nil? (held-tree-for entry buf :elixir)))
      (is (nil? (held-tree-for entry (insert (goto-char buf 0) "x") :ruby)))
      (is (nil? (held-tree-for nil buf :ruby)))))

  (test "C-M-f and TAB answer the same over the held tree, and after it is gone"
    (let (m (refreshed (ruby-model "def f\n1\nend\ndef g\nend\n"))
          entry (syntax-tree-entry m 0)
          moved (buffer-point (ed-current-buf (commands/cmd-forward-sexp m nil)))
          indented (commands/ed-indent-target (goto-char (ed-current-buf m) 6) entry))
      (is (not (nil? (:tree entry))))
      (assert= moved 11)
      (assert= indented 2)
      (tree-free (:tree entry))
      (is (not (tree-alive? (:tree entry))))
      (assert= (buffer-point (ed-current-buf (commands/cmd-forward-sexp m nil))) moved)
      (assert= (commands/ed-indent-target (goto-char (ed-current-buf m) 6) entry) indented))))

(describe "treewarm: a warm is for a buffer with no tree, never per edit"
  (test "due while a large buffer has none; not once it has one, however it is edited"
    (binding (*tree-open-max* 10)
      (let (m (ruby-model "def f\nend\ndef g\nend\n")
            rope (buffer-rope (ed-current-buf m))
            held (install-syntax-tree m 0 (tree-open rope :ruby) rope :ruby))
        (is (ed-tree-warm-stale? m))
        (is (not (ed-tree-warm-stale? (assoc m :tree-warm-proc :running))))
        (is (not (ed-tree-warm-stale? held)))
        (is (not (ed-tree-warm-stale? (edited-at held 0 "x = 1\n"))))))))
