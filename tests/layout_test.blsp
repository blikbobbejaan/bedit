;; The pane body's columns: every band that stands for a whole line reaches the pane's right
;; edge. Short of it, the GUI does not carry the band on to the frame (brood ADR-508's edge
;; bleed), and the current-line highlight, a diff's tinted lines and a region's end-of-line
;; fill each once stopped a column short, a strip of bare window beside them. The spans are
;; named in one place (`view/geometry-span`); the guard at the bottom keeps it the only reader
;; of the raw widths.
(defmodule layout-test
  (:use model)
  (:use input)
  (:use view)
  (:use editor/buffer)
  (:use test))

(defn- model-of (text) (assoc (ed-init (make-buffer text)) :hl-line true))
(defn- press-keys (m keys) (fold keys m (fn (acc key) (ed-update acc key 80 24))))

(defn- rects-in (frame face)
  "The `[:rect row col w h face]` ops of `frame` painted in `face`."
  (seq/filter frame (fn (op) (and (vector? op) (= (first op) :rect) (= (nth op 5 nil) face)))))

(defn- right-edge (op)
  "The column just past a `rect` op: its column plus its width."
  (+ (nth op 2) (nth op 3)))

(def- diff-face {:bg "#203020"})

(describe "a line's background reaches the pane's edge"
  (test "the current-line highlight ends at the window's last column, at any width"
    (each [80 97 133]
      (fn (cols)
        (let (bands (rects-in (ed-view (model-of "hello\nworld") cols 24) theme/face-hl-line))
          (assert= (count bands) 1)
          (assert= (right-edge (first bands)) cols)))))
  (test "a diff's tinted line ends at the window's last column"
    (let (m (model-of "+added\n context")
          tinted (ed-set-buf m (assoc (ed-current-buf m) :line-bands {0 diff-face}))
          bands (rects-in (ed-view tinted 80 24) diff-face))
      (assert= (count bands) 1)
      (assert= (right-edge (first bands)) 80)))
  (test "a region's end-of-line fill ends at the window's last column"
    ;; "ab", a blank line, "cd": the blank line has only the fill to show it is selected
    (let (m (press-keys (model-of "ab\n\ncd") [(keyword "ctrl- ") :right :right :right :right])
          fills (rects-in (ed-view m 80 24) theme/face-region))
      (is (not (empty? fills)))
      (each fills (fn (fill) (assert= (right-edge fill) 80)))))
  (test "beside a split, the highlight stops at its own pane's edge, where its mode line does"
    (let (frame (ed-view (press-keys (model-of "hello") [:ctrl-x "3"]) 80 24)
          band (first (rects-in frame theme/face-hl-line))
          modeline (first (rects-in frame theme/face-modeline)))
      (is (not (nil? band)))
      (assert= (right-edge band) (right-edge modeline))
      (is (< (right-edge band) 80)))))

(defn- occurrences (text needle)
  "How many times `needle` occurs in `text`."
  (dec (count (string/split text needle))))

(defn- source-text ()
  "All of src/, so a read moved to another file is still counted."
  (string/join (map (sort (file/ls "src")) (fn (name) (file/slurp (path/join "src" name))))
    "\n"))

(describe "the body's widths are read in one place"
  (test "only geometry-span reads a pane geometry's raw widths"
    ;; a layer that wants a reach asks `geometry-span` for a named span (:text :row :band
    ;; :body :gutter :margin); reading these and subtracting is how bands came up short.
    ;; Counted across src/: a count of one file proves nothing once the code has left it
    (let (source (source-text))
      (is (includes? source "geometry-span (geometry span)"))
      (each ["(:width geometry)" "(:gutter-width geometry)" "(:margin-width geometry)"]
        (fn (read)
          (assert= [read (occurrences source read)] [read 1]))))))
