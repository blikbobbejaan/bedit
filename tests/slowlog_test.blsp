;; The slow-turn log (src/slowlog.blsp): reports kept across sessions, ranked by cause.
(defmodule slowlog-test
  (:use test)
  (:use model)
  (:use input)
  (:use slowlog)
  (:use editor/buffer)) ; make-buffer

(describe "the slow-turn log"
  (test "a cause's turns are summed and ranked, the costliest first"
    (let (lines (summary-lines [{:phase "update" :tag :lsp :ms 80}
                                 {:phase "update" :tag [:timer :idle] :ms 900 :interrupted true}
                                 {:phase "update" :tag :lsp :ms 120}]))
      (assert= (count lines) 2)
      (is (includes? (first lines) "[:timer :idle]"))
      (is (includes? (first lines) "(1 stopped)"))
      (is (includes? (second lines) "200 ms total"))
      (is (includes? (second lines) "2×"))
      ;; the exact line, as summary-lines's documented example shows it
      (assert= (second lines) "  200 ms total    2×  worst 120 ms   update :lsp")))
  ;; :isolated — activate! defs the global *slow-log-file*, so a test beside it in the same
  ;; parallel wave would write into this test's file (seen once the suite was sharded)
  (test "nothing is written before activate!, every report after it, read back in order"
    :isolated (let (file (path/join (temp-dir "bedit-slowlog-") "slow-turns.blsp"))
      (record! {:phase "update" :tag :before :ms 70})
      (is (not (file/exists? file)))
      (activate! file)
      (ed-update (ed-init (make-buffer "")) [:ui-slow {:phase "update" :tag :lsp :ms 75}] 80 24)
      (record! {:phase "render" :tag :frame :ms 90})
      (let (reports (read-reports file))
        (deactivate!)
        (assert= (vec (map reports :tag)) [:lsp :frame])
        (is (every? reports (fn (r) (int? (:at r))))))))
  (test "a torn line is skipped, the rest kept"
    (let (dir (temp-dir "bedit-slowlog-")
          file (path/join dir "slow-turns.blsp"))
      (file/mkdir dir)
      (file/spit file "{:phase \"update\" :tag :a :ms 70}\n{:phase \"upd\n")
      (assert= (vec (map (read-reports file) :tag)) [:a])))
  (test "an empty log says so"
    (is (includes? (report-text []) "No slow turns recorded yet"))))

(describe "a native call that blocked the loop (brood ADR-517)"
  (test "is logged under the blocking phase, its command as the cause, and noted in *Messages*"
    :isolated (let (dir (temp-dir "bedit-slowlog-")
          file (path/join dir "slow-turns.blsp"))
      (activate! file)
      (let (m (ed-update (ed-init (make-buffer ""))
                [:blocking-call {:native "os/cmd" :detail "git status" :ms 41}]
                80
                24)
            reports (read-reports file))
        (deactivate!)
        (assert= (vec (map reports :tag)) ["os/cmd git status"])
        (assert= (:phase (first reports)) "blocking")
        (is (includes? (editor/buffer/buffer-text (ed-buf-at m
                                                    (ed-buffer-index-by-name! m "*Messages*")))
              "blocked 41ms on os/cmd git status")))))
  (test "a real os/cmd in a responsive process reaches the handler"
    (let (me (self))
      (spawn (fn ()
               (responsive!)
               (os/cmd "true" [])
               (send me (receive ([:blocking-call facts] facts) (after 5000 :none)))))
      (assert= (:native (receive (facts facts) (after 10000 :none))) "os/cmd"))))

;; brood ADR-612: key-to-paint as a distribution. Made-up histograms only — the plumbing is
;; tested here, and measuring is for CI or a machine set aside for it.
(describe "key-to-paint latency in the slow-turn log"
  (test "what the window counted since the last record is due once enough keys have come"
    (let (m {:window 7}
          first-reading {:count 150 :max-us 5000 :buckets {2047 140 5119 10}}
          second-reading {:count 420 :max-us 9000 :buckets {2047 400 5119 10 9215 10}})
      (is (nil? (latency-due m first-reading)))
      (assert= (:count (latency-due m first-reading 100)) 150)
      ;; recorded up to the first reading: the second is due for what came after
      (let (recorded (assoc m :latency-recorded [7 first-reading])
            due (latency-due recorded second-reading))
        (assert= due {:count 270 :max-us 9000 :buckets {2047 260 9215 10}}))
      ;; another window (a new loop after a crash) starts over rather than subtracting
      (assert= (:count (latency-due (assoc m :latency-recorded [3 second-reading]) first-reading 1))
        150)))
  (test "records land in the log beside the slow turns and the report heads with p50 / p99 / p99.9"
    :isolated (let (file (path/join (temp-dir "bedit-slowlog-") "slow-turns.blsp")
          m {:window 7}
          reading {:count 1000 :max-us 40000 :buckets {2047 980 8191 15 40959 5}})
      (activate! file)
      (let (recorded (record-latency m reading)
            again (record-latency recorded reading)
            _ (record! {:phase "update" :tag :lsp :ms 80})
            reports (read-reports file))
        (deactivate!)
        (assert= (:latency-recorded recorded) [7 reading])
        ;; nothing new since: no second record
        (assert= again recorded)
        (assert= (count (latency-reports reports)) 1)
        (assert= (vec (map (slow-reports reports) :tag)) [:lsp])
        (assert= (recorded-latency reports) reading)
        (let (text (report-text reports))
          (is (includes? text
                "Key to paint, every session recorded: p50 2.0 ms · p99 8.2 ms · p99.9 40.0 ms · worst 40.0 ms (1000 keys)"))
          (is (includes? text "1 recorded"))))))
  (test "sessions merge into one distribution"
    (assert= (recorded-latency [{:kind :latency :key {:count 2 :max-us 3000 :buckets {3071 2}}}
                                 {:phase "update" :tag :x :ms 70}
                                 {:kind :latency :key {:count 1 :max-us 900 :buckets {911 1}}}])
      {:count 3 :max-us 3000 :buckets {911 1 3071 2}})
    (is (nil? (recorded-latency [{:phase "update" :tag :x :ms 70}]))))
  (test "with the log off, or no window of our own, nothing is recorded"
    (let (m {:window 7})
      (assert= (record-latency m {:count 500 :max-us 9 :buckets {9 500}}) m)
      (assert= (flush-latency {} 1) {})))
  (test "a log with no latency yet reports only the slow turns"
    (is (not (includes? (report-text [{:phase "update" :tag :x :ms 70}]) "Key to paint")))))
