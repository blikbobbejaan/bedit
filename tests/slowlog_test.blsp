;; The slow-turn log (src/slowlog.blsp): reports kept across sessions, ranked by cause.
(defmodule slowlog-test
  (:use test)
  (:use model)
  (:use input)
  (:use slowlog)
  (:use editor/buffer)) ; make-buffer

(describe "the slow-turn log"
  (test "a cause's turns are summed and ranked, the costliest first"
    (let (lines (summary-lines [{:phase "update" :tag :lsp :ms 80}
                                 {:phase "update" :tag [:timer :idle] :ms 900 :interrupted true}
                                 {:phase "update" :tag :lsp :ms 120}]))
      (assert= (count lines) 2)
      (is (includes? (first lines) "[:timer :idle]"))
      (is (includes? (first lines) "(1 stopped)"))
      (is (includes? (second lines) "200 ms total"))
      (is (includes? (second lines) "2×"))
      ;; the exact line, as summary-lines's documented example shows it
      (assert= (second lines) "  200 ms total    2×  worst 120 ms   update :lsp")))
  (test "nothing is written before activate!, every report after it, read back in order"
    (let (file (path/join (temp-dir "bedit-slowlog-") "slow-turns.blsp"))
      (record! {:phase "update" :tag :before :ms 70})
      (is (not (file/exists? file)))
      (activate! file)
      (ed-update (ed-init (make-buffer "")) [:ui-slow {:phase "update" :tag :lsp :ms 75}] 80 24)
      (record! {:phase "render" :tag :frame :ms 90})
      (let (reports (read-reports file))
        (deactivate!)
        (assert= (vec (map reports :tag)) [:lsp :frame])
        (is (every? reports (fn (r) (int? (:at r))))))))
  (test "a torn line is skipped, the rest kept"
    (let (dir (temp-dir "bedit-slowlog-")
          file (path/join dir "slow-turns.blsp"))
      (file/mkdir dir)
      (file/spit file "{:phase \"update\" :tag :a :ms 70}\n{:phase \"upd\n")
      (assert= (vec (map (read-reports file) :tag)) [:a])))
  (test "an empty log says so"
    (is (includes? (report-text []) "No slow turns recorded yet"))))

(describe "a native call that blocked the loop (brood ADR-517)"
  (test "is logged under the blocking phase, its command as the cause, and noted in *Messages*"
    (let (dir (temp-dir "bedit-slowlog-")
          file (path/join dir "slow-turns.blsp"))
      (activate! file)
      (let (m (ed-update (ed-init (make-buffer ""))
                [:blocking-call {:native "os/cmd" :detail "git status" :ms 41}]
                80
                24)
            reports (read-reports file))
        (deactivate!)
        (assert= (vec (map reports :tag)) ["os/cmd git status"])
        (assert= (:phase (first reports)) "blocking")
        (is (includes? (editor/buffer/buffer-text (ed-buf-at m
                                                    (ed-buffer-index-by-name! m "*Messages*")))
              "blocked 41ms on os/cmd git status")))))
  (test "a real os/cmd in a responsive process reaches the handler"
    (let (me (self))
      (spawn (fn ()
               (responsive!)
               (os/cmd "true" [])
               (send me (receive ([:blocking-call facts] facts) (after 5000 :none)))))
      (assert= (:native (receive (facts facts) (after 10000 :none))) "os/cmd"))))
