;; Paragraph and sentence motion, whitespace around point, joining lines and rectangles —
;; pure buffer -> buffer, no model. Moved with the code from brood's tests/buffer_test.blsp.
(defmodule bufferops-test
  (:use test)
  (:use editor/buffer)
  (:use bufferops))

(defn at (text point) (goto-char (make-buffer text) point))

;; paragraphs {a,b} {c,d} {e}, blank-line separated.
;;  offsets: a0 b2  blank4  c5 d7  blank9  e10  (len 11)
(describe "buffer paragraph motion (M-{ / M-})"
  (test "forward-paragraph stops at the start of the next blank line"
    (let (text "a\nb\n\nc\nd\n\ne")
      ; from line 0
      (assert= (buffer-point (forward-paragraph (make-buffer text))) 4)
      ; from inside {c,d}
      (assert= (buffer-point (forward-paragraph (at text 8))) 9)))
  (test "forward-paragraph in the last paragraph lands at end of buffer"
    (assert= (buffer-point (forward-paragraph (at "a\nb\n\nc\nd\n\ne" 10))) 11))
  (test "backward-paragraph goes to the current paragraph's start, then the previous"
    (let (text "a\nb\n\nc\nd\n\ne")
      ; from inside {c,d}
      (assert= (buffer-point (backward-paragraph (at text 8))) 5)
      ; from {c,d} start → {a,b}
      (assert= (buffer-point (backward-paragraph (at text 5))) 0)))
  (test "backward-paragraph at buffer start stays at 0"
    (assert= (buffer-point (backward-paragraph (make-buffer "a\nb\n\nc"))) 0)))

(describe "buffer sentence motion (M-a / M-e)"
  ;; "One. Two? Three!" — terminators at 3, 8, 15; sentence starts at 0, 5, 10.
  (def sentences "One. Two? Three!")
  (defn forward-sentence-at (point) (buffer-point (forward-sentence (at sentences point))))
  (defn backward-sentence-at (point) (buffer-point (backward-sentence (at sentences point))))
  (test "forward-sentence lands just past each terminator, then at the buffer's end"
    (assert= (forward-sentence-at 0) 4)
    (assert= (forward-sentence-at 4) 9)
    ; no further terminator → paragraph end
    (assert= (forward-sentence-at 9) 16)
    (assert= (forward-sentence-at 16) 16))
  (test "backward-sentence goes to the current sentence's start, then the previous one's"
    ; start of "Three!"
    (assert= (backward-sentence-at 16) 10)
    ; at a start → the previous start
    (assert= (backward-sentence-at 12) 10)
    (assert= (backward-sentence-at 10) 5)
    (assert= (backward-sentence-at 5) 0)
    (assert= (backward-sentence-at 0) 0))
  (test "a closing quote after the terminator is part of the sentence end"
    ;; `He said "stop." Then left.` — the `.` is at 13, its closing `"` at 14
    (let (text "He said \"stop.\" Then left.")
      (assert= (buffer-point (forward-sentence (make-buffer text))) 15)))
  (test "sentence motion is bounded by the paragraph — it never crosses a blank line"
    ;; "One. Two.\n\nThree." — the blank line starts at 10
    (let (text "One. Two.\n\nThree.")
      (assert= (buffer-point (forward-sentence (at text 5))) 9)
      ; stops at the paragraph boundary, not in "Three."
      (assert= (buffer-point (forward-sentence (at text 9))) 10)
      ; floors at its own paragraph's start
      (assert= (buffer-point (backward-sentence (at text 14))) 11))))

(describe "join-line / fixup-whitespace (Emacs M-^ / M-SPC)"
  (defn joined (text point) (buffer-text (join-line (at text point))))

  (test "it pulls THIS line up onto the previous one, not the next one down"
    ;; the direction is the whole point: Vim's J joins downward, Emacs M-^ joins upward
    (assert= (joined "foo\n    bar\nbaz" 8) "foo bar\nbaz"))

  (test "the joined line's indentation collapses to a single space"
    (assert= (joined "one\n\t\t  two" 9) "one two")
    (assert= (joined "one\ntwo" 4) "one two"))

  (test "no space is inserted before a closing delimiter"
    ;; (foo bar\n) must not become "(foo bar )"
    (assert= (joined "(foo bar\n)" 9) "(foo bar)")
    (assert= (joined "(foo\n  )" 5) "(foo)"))

  (test "…nor after an opening one"
    (assert= (joined "(\n  foo bar)" 2) "(foo bar)"))

  (test "point ends at the join, ahead of the space"
    (let (joined-buffer (join-line (at "foo\n    bar" 8)))
      (assert= (buffer-point joined-buffer) 3) ; right after "foo"
      (assert= (buffer-char-after joined-buffer) " ")))

  (test "on the first line there is nothing above, so the buffer is untouched"
    (let (first-line (at "foo\nbar" 1))
      (assert= (buffer-text (join-line first-line)) "foo\nbar")
      (assert= (buffer-point (join-line first-line)) 1)))

  (test "joining an empty line just removes it"
    (assert= (joined "foo\n\nbar" 4) "foo\nbar"))

  (test "repeated joins walk a wrapped paragraph together"
    (let (once (join-line (at "a\n  b\n  c" 6))
          twice (join-line (goto-char once (buffer-length once))))
      (assert= (buffer-text once) "a\n  b c")
      (assert= (buffer-text twice) "a b c")))

  (test "collapse-whitespace is just-one-space and delete-horizontal-space"
    (assert= (buffer-text (collapse-whitespace (at "a   \t  b" 4) " ")) "a b")
    (assert= (buffer-text (collapse-whitespace (at "a   \t  b" 4) "")) "ab"))

  (test "collapse-whitespace never eats across a newline"
    ;; it squeezes the gap point stands in; line structure is not its business
    (assert= (buffer-text (collapse-whitespace (at "a  \n  b" 2) "")) "a\n  b"))

  (test "whitespace-run-at is the span collapse replaces — the gap point stands in"
    ;; the span is public because reading the ORIGINAL text out of it is what a cycling
    ;; command (Emacs 29's cycle-spacing: one space → none → what was there) needs
    (assert= (whitespace-run-at (at "a   \t  b" 4)) [1 7])
    (assert= (whitespace-run-at (at "a b" 1)) [1 2]) ; beside a single space
    (assert= (whitespace-run-at (at "ab" 1)) [1 1])) ; no whitespace: empty span
  (test "whitespace-run-at stops at a newline, in both directions"
    (assert= (whitespace-run-at (at "a  \n  b" 2)) [1 3]) ; before the newline
    (assert= (whitespace-run-at (at "a  \n  b" 4)) [4 6]))) ; after it

;; ---- rectangles (Emacs C-x r r/k/d/o/c/t/y) --------------------------------------

(describe "rectangles"
  (defn rectangle-of (text point mark)
    ;; a buffer with point and mark set to make a rectangle
    (assoc (at text point) :mark mark))
  (defn lines-of (buffer) (string/split (buffer-text buffer) "\n"))
  ;; "abcde\nfghij\nklmno": a 3x5 grid; point line0 col1 (=1), mark line2 col3 (=15) → cols [1,3)
  (def grid "abcde\nfghij\nklmno")

  (test "rectangle-bounds are the line/column corners, ordered"
    (assert= (rectangle-bounds (rectangle-of grid 1 15)) [0 2 1 3])
    ;; point and mark swapped give the same rectangle
    (assert= (rectangle-bounds (rectangle-of grid 15 1)) [0 2 1 3])
    (is (nil? (rectangle-bounds (make-buffer grid))))) ; no mark
  (test "extract-rectangle is the block, each row padded to width"
    (assert= (extract-rectangle (rectangle-of grid 1 15)) (list "bc" "gh" "lm"))
    (assert= (extract-rectangle (make-buffer grid)) '()))

  (test "delete-rectangle closes the gap; point lands top-left"
    (let (deleted (delete-rectangle (rectangle-of grid 1 15)))
      (assert= (lines-of deleted) (list "ade" "fij" "kno"))
      (assert= (buffer-point deleted) 1)))

  (test "clear-rectangle blanks in place, keeping following columns"
    (assert= (lines-of (clear-rectangle (rectangle-of grid 1 15))) (list "a  de" "f  ij" "k  no")))

  (test "open-rectangle shifts the block right by its width"
    (assert= (lines-of (open-rectangle (rectangle-of grid 1 15)))
      (list "a  bcde" "f  ghij" "k  lmno")))

  (test "string-rectangle replaces each row's block with the same string"
    (assert= (lines-of (string-rectangle (rectangle-of grid 1 15) "XX"))
      (list "aXXde" "fXXij" "kXXno")))

  (test "insert-rectangle rebuilds a block at point — a kill/yank round-trip"
    (let (rows (extract-rectangle (rectangle-of grid 1 15))
          gone (delete-rectangle (rectangle-of grid 1 15))
          back (insert-rectangle (goto-char gone 0) rows))
      (assert= (lines-of back) (list "bcade" "ghfij" "lmkno"))
      ;; …and point returns to where the yank began
      (assert= (buffer-point back) 0)))

  (test "short lines: extract pads, delete takes what is there, string/open pad to the left column"
    ;; "long line"(9) / "x"(1) / "another"(7); point line0 col3 (=3), mark line2 col5 (=17) → cols [3,5)
    (let (short "long line\nx\nanother")
      (assert= (extract-rectangle (rectangle-of short 3 17)) (list "g " "  " "th"))
      (assert= (lines-of (delete-rectangle (rectangle-of short 3 17)))
        (list "lonline" "x" "anoer"))
      (assert= (lines-of (string-rectangle (rectangle-of short 3 17) "ZZ"))
        (list "lonZZline" "x  ZZ" "anoZZer"))
      (assert= (lines-of (open-rectangle (rectangle-of short 3 17)))
        (list "lon  g line" "x    " "ano  ther"))))

  (test "insert-rectangle past the end grows the buffer, padding to the column"
    ; point at end, col 2
    (assert= (string/split (buffer-text (insert-rectangle (at "ab" 2) (list "X" "Y"))) "\n")
      (list "abX" "  Y")))

  (test "a rectangle op is a no-op without a mark, and honours read-only"
    (assert= (delete-rectangle (make-buffer grid)) (make-buffer grid))
    (let (refused (try
                    (do (delete-rectangle (set-read-only (rectangle-of grid 1 15) true)) nil)
                    (catch error-value error-value)))
      (assert= (:kind refused) :read-only))))
