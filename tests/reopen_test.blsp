;; A killed file buffer opened again (src/reopen.blsp): every kill path remembers the file, its
;; point and the window's start; C-x x U reopens the newest where it was, then the one before; a
;; file gone since is skipped and said.
(defmodule reopen-test
  (:use test)
  (:use model)
  (:use pool) ; ed-find-file / ed-kill-at / cmd-kill-buffer
  (:use reopen)
  (:use main :only []) ; the released image: every slot keeper loaded
  (:use editor/buffer))

(purge-stale-temp "bedit-reopen-")

(defn- fixture (names)
  "A fresh temp directory with a file per name of `names`, each holding a few lines; the
directory."
  (let (dir (temp-dir "bedit-reopen-"))
    (do
      (file/mkdir dir)
      (doseq (name names) (file/spit (path/join dir name) "one\ntwo\nthree\nfour\n"))
      dir)))

(defn- visit (m path) (ed-find-file m path))

(defn- kill-current (m) (ed-kill-at m (ed-current-index m) true))

(defn- kill-file (m path)
  ;; the buffer visiting `path` killed, wherever it is
  (ed-kill-at m (or (ed-buffer-index-by-file m path) (error (str "not open: " path))) true))

(defn- killed-files (m) (vec (map (or (:killed-files m) []) :file)))

(defn- files-open (m) (seq/keep (:buffers m) buffer-file))

(describe "a kill is remembered"
  (test "a file buffer's file, point and window start, newest first"
    (let (dir (fixture ["a.txt" "b.txt"])
          a (path/join dir "a.txt")
          b (path/join dir "b.txt")
          m (visit (visit (ed-init (make-buffer "")) a) b)
          moved (ed-set-buf m (goto-char (ed-current-buf m) 5))
          scrolled (ed-map-panes moved (fn (pane) (assoc pane :top 2)))
          killed (kill-current scrolled))
      (assert= (killed-files killed) [b])
      (assert= (:point (first (:killed-files killed))) 5)
      (assert= (:top (first (:killed-files killed))) 2)
      (let (both (kill-file killed a))
        (assert= (killed-files both) [a b]))))

  (test "a buffer with no file is not remembered"
    (let (m (ed-open-buffer (ed-init (make-buffer "")) (make-buffer "x" "*notes*")))
      (assert= (or (:killed-files (kill-current m)) []) [])))

  (test "a file killed twice is in the list once, at the front"
    (let (dir (fixture ["a.txt"])
          a (path/join dir "a.txt")
          once (kill-current (visit (ed-init (make-buffer "")) a))
          twice (kill-current (visit once a)))
      (assert= (killed-files twice) [a])))

  (test "the list is capped"
    (let (entries (vec (map (range 40) (fn (n) {:file (str "/nowhere/" n) :point 0 :top 0})))
          m (assoc (visit (ed-init (make-buffer "")) (path/join (fixture ["a.txt"]) "a.txt"))
              :killed-files entries)
          killed (kill-current m))
      (assert= (count (:killed-files killed)) *killed-files-max*))))

(describe "C-x x U reopens"
  (test "the newest kill, where it was, then the one before it"
    (let (dir (fixture ["a.txt" "b.txt"])
          a (path/join dir "a.txt")
          b (path/join dir "b.txt")
          m (visit (visit (ed-init (make-buffer "")) a) b)
          at-b (ed-map-panes (ed-set-buf m (goto-char (ed-current-buf m) 6))
                 (fn (pane) (assoc pane :top 1)))
          killed (kill-file (kill-file at-b a) b)
          reopened (cmd-reopen-killed-buffer killed nil))
      (refute (includes? (files-open killed) b))
      (assert= (buffer-file (ed-current-buf reopened)) b)
      (assert= (buffer-point (ed-current-buf reopened)) 6)
      (assert= (:top (ed-current-pane reopened)) 1)
      (assert= (killed-files reopened) [a])
      (let (again (cmd-reopen-killed-buffer reopened nil))
        (assert= (buffer-file (ed-current-buf again)) a)
        (assert= (:killed-files again) [])
        (is (includes? (:echo (cmd-reopen-killed-buffer again nil)) "no killed file buffer")))))

  (test "a file gone since is skipped, and said"
    (let (dir (fixture ["a.txt" "b.txt"])
          a (path/join dir "a.txt")
          b (path/join dir "b.txt")
          killed (kill-file (kill-file (visit (visit (ed-init (make-buffer "")) a) b) a) b)
          _ (file/rm b)
          reopened (cmd-reopen-killed-buffer killed nil))
      (assert= (buffer-file (ed-current-buf reopened)) a)
      (is (includes? (:echo reopened) "gone since"))
      (is (includes? (:echo reopened) b))
      (assert= (:killed-files reopened) [])))

  (test "with every file gone it says so and opens nothing"
    (let (dir (fixture ["a.txt"])
          a (path/join dir "a.txt")
          killed (kill-current (visit (ed-init (make-buffer "")) a))
          _ (file/rm a)
          reopened (cmd-reopen-killed-buffer killed nil))
      (refute (includes? (files-open reopened) a))
      (is (includes? (:echo reopened) "no killed file buffer"))
      (is (includes? (:echo reopened) a))))

  (test "a file open again already is passed over"
    (let (dir (fixture ["a.txt" "b.txt"])
          a (path/join dir "a.txt")
          b (path/join dir "b.txt")
          killed (kill-file (kill-file (visit (visit (ed-init (make-buffer "")) a) b) a) b)
          ;; b opened again by hand
          by-hand (visit killed b)
          reopened (cmd-reopen-killed-buffer by-hand nil))
      (assert= (buffer-file (ed-current-buf reopened)) a)
      (assert= (count (seq/filter (files-open reopened) (fn (file) (= file b)))) 1))))
