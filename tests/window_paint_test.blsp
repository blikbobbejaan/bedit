;; What the window PAINTS, read from its pixels: bedit's real view for a model, painted
;; through brood's window painter into memory (`gui/render-frame`, brood ADR-609) at a
;; real window's size with bedit's own font, line height, inset and background.
;;
;; The frame tests elsewhere say which ops land on which row. Where those rows land on the
;; screen is the renderer's: a strip of window between the title bar and the header line
;; survived three fixes because nothing could look (brood ADR-508's 2026-11-05 addendum).
;; These look. Each one needs a GUI-built runtime; without one it checks nothing.
(defmodule window-paint-test
  (:use test)
  (:use model)
  (:use editor/buffer)
  (:use theme)) ; the palette: the window background and the header line

(def- window-width 1000)
(def- window-height 600)

(defn- rgb (hex)
  "A theme colour `#rrggbb` as `[r g b]`."
  (vec (map [1 3 5] (fn (at) (string/->number (string/substring hex at (+ at 2)) 16)))))

(defn- spec ()
  "The window bedit opens, as the renderer is told it: the init file's default font, size
and line height, startup's inset, the theme's background."
  {:width window-width
   :height window-height
   :font (config/setting {} :font)
   :size (config/setting {} :font-size)
   :line-height (config/setting {} :line-height)
   :inset startup/*inset*
   :bg *base*})

(def- source "def greet(name)\n  puts \"hello #{name}\"\nend\n")

(defn- painted ()
  "A file buffer with the header line on, painted at the grid the window holds: the
frame's ops and the picture."
  (let (grid (:grid (gui/render-frame [[:clear]] (spec)))
        buf (make-buffer source "greet.rb" (path/join (temp-dir "bedit-paint-") "greet.rb"))
        m (assoc (ed-init buf) :header-line true)
        ops (view/ed-view m (first grid) (second grid)))
    {:ops ops :image (gui/render-frame ops (spec))}))

(defn- row-text (ops row needle)
  "The first `:text` op on `row` whose text includes `needle`."
  (seq/find ops
    (fn (op)
      (and (vector? op) (= (first op) :text) (= (nth op 1) row) (includes? (nth op 3) needle)))))

(defn- inked-rows (image x0 x1 y0 y1 background)
  "The pixel rows in [y0, y1) where some pixel of columns [x0, x1) is not `background`."
  (seq/filter (vec (range (math/floor y0) (math/floor y1)))
    (fn (y)
      (any? (vec (range (math/floor x0) (math/floor x1)))
        (fn (x) (not (= (gui/pixel image x y) background)))))))

(defn- band-end (image colour)
  "The first pixel row, going down from the top, that is not `colour` — read in the grid's
  last column, which the header line leaves blank (its text stops a cell short of the edge)."
  (let ([cell-w _] (:cell image)
        [cols _] (:grid image)
        x (+ (first (:origin image)) (* cell-w (dec cols)) (math/quot cell-w 2)))
    (letrec (walk (fn (y) (if (= (gui/pixel image x y) colour) (walk (inc y)) y)))
      (walk 0))))

(describe "the header line is the top of the window"
  (test "its background starts at y = 0 and is exactly one row tall"
    (when (gui/available?)
      (let ({:keys [image]} (painted)
            [_ cell-h] (:cell image)
            header (rgb (:bg headerline/face-header-line)))
        (assert= (band-end image header) cell-h))))

  (test "the file's name is centred in it: as much space above its ink as below"
    (when (gui/available?)
      (let ({:keys [ops image]} (painted)
            [cell-w cell-h] (:cell image)
            [inset _] (:origin image)
            header (rgb (:bg headerline/face-header-line))
            name-op (row-text ops 0 "greet.rb")
            x0 (+ inset (* cell-w (nth name-op 2)))
            x1 (+ x0 (* cell-w (string/length (nth name-op 3))))
            top (band-end image header)
            inked (inked-rows image x0 x1 0 top header)
            above (or (first inked) 0)
            below (- top 1 (or (last inked) top)))
        (is (not (empty? inked)))
        ;; on failure the pair shows the space above the ink and below it, in pixels
        (assert= [above below (<= (math/abs (- above below)) 2)] [above below true]))))

  (test "the buffer's first line is painted on row 1, under the header"
    (when (gui/available?)
      (let ({:keys [ops image]} (painted)
            [cell-w cell-h] (:cell image)
            [inset _] (:origin image)
            line-op (row-text ops 1 "def")
            x0 (+ inset (* cell-w (nth line-op 2)))
            ;; `de`: the line below has spaces in those two columns, so all the ink is row 1's
            x1 (+ x0 (* cell-w 2))
            inked (inked-rows image x0 x1 cell-h (* 3 cell-h) (rgb *base*)))
        (is (not (nil? line-op)))
        (is (not (empty? inked)))
        (is (< (or (last inked) window-height) (* 2 cell-h)))))))

(describe "the inset"
  (test "is a margin on the left: no glyph's ink reaches into it"
    (when (gui/available?)
      (let ({:keys [image]} (painted)
            [inset origin-y] (:origin image))
        (assert= [inset origin-y] [startup/*inset* 0])
        ;; each pixel row of the margin is one colour — the window's, or a band bled across
        (is (every? (vec (range 0 window-height))
              (fn (y)
                (every? (vec (range 1 inset))
                  (fn (x) (= (gui/pixel image x y) (gui/pixel image 0 y))))))))))

  (test "is a margin below too: the grid stops at least the inset short of the bottom"
    (when (gui/available?)
      (let ({:keys [image]} (painted)
            [_ cell-h] (:cell image)
            [_ rows] (:grid image))
        (is (>= (- window-height (* rows cell-h)) startup/*inset*))))))
