;; A viewport's line band kept across an edit below it (src/panes.blsp
;; `ed-line-band-survives?`): a line lexer reads lines in order, so typing below the band
;; cannot change a line in it — unless the mode colours ACROSS lines past the band, as
;; markdown's fences coloured as their language do (`:line-band-pass`).
(defmodule band-survival-test
  (:use test)
  (:use editor/buffer)
  (:use modes) ; markdown-mode registers here
  (:use-internals panes))

(defn- lines (n prefix) (string/join (map (range n) (fn (i) (str prefix i))) "\n"))

(defn- band (buf)
  ;; a line band over the first 20 lines, as `ed-line-band-for` builds one
  {:rope (buffer-rope buf) :blo 0 :bhi 20 :line? true :spans []})

(defn- typed-below (buf)
  ;; one character typed at line 200, far below the band
  (insert (goto-char buf (text/line->char (buffer-rope buf) 200)) "x"))

(describe "a line band across an edit below it"
  (test "a plain line-lexed buffer keeps its band"
    (let (buf (model/ed-current-buf (model/ed-init (make-buffer (lines 300 "key = ")
                                                     "a.ini" "a.ini"))))
      (is (panes/ed-line-band-survives? (band buf) (typed-below buf) 0 10))))
  (test "markdown, whose fences are coloured past the band, rebuilds it"
    (let (buf (model/ed-current-buf (model/ed-init (make-buffer (str "```python\n"
                                                                  (lines 300 "x = ")
                                                                  "\n```\n")
                                                     "a.md" "a.md"))))
      (is (not (panes/ed-line-band-survives? (band buf) (typed-below buf) 0 10))))))
