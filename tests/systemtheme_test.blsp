;; tests/systemtheme_test.blsp — the window follows the desktop's light or dark setting when
;; init.blsp names no :theme: which theme each answer picks, and a change re-themes live.

(defmodule systemtheme-test
  (:use test)
  (:use model)
  (:use editor/buffer)
  (:use systemtheme))

(defn- config-with (entries)
  ;; an init.blsp read as `entries` (a parsed config is the map itself)
  entries)

(describe "which theme the desktop picks"
  (test "light and dark name the init file's :theme-light and :theme-dark"
    (assert= (themes/system-theme-name (config-with {}) :light) "Catppuccin Latte (light)")
    (assert= (themes/system-theme-name (config-with {}) :dark) "Catppuccin Mocha")
    (assert= (themes/system-theme-name (config-with {:theme-light "Nord"}) :light) "Nord"))
  (test "a desktop that says nothing, or a :theme named, picks nothing"
    (assert= (themes/system-theme-name (config-with {}) nil) nil)
    (assert= (themes/system-theme-name (config-with {:theme "Nord"}) :light) nil)))

(describe "following a change"
  (defn- following (seen)
    (assoc (ed-init (make-buffer ""))
      :theme-follows-system true
      :gui true
      :theme-light "Catppuccin Latte (light)"
      :theme-dark "Catppuccin Mocha"
      :system-scheme seen))
  (test "the first answer is only noted: startup already themed by it"
    (let (m (scheme-arrived (following nil) :light))
      (assert= (:system-scheme m) :light)
      (assert= (:echo m) (:echo (following nil)))))
  (test "a change re-themes, an unchanged answer does nothing"
    (let (same (scheme-arrived (following :dark) :dark)
          changed (scheme-arrived (following :dark) :light))
      (assert= same (assoc (following :dark) :system-scheme :dark))
      (assert= (:system-scheme changed) :light)
      (is (includes? (:echo changed) "Latte"))
      ;; the palette is process-wide: put the default back for the tests after this one
      (themes/theme-activate! "Catppuccin Mocha")))
  (test "the timer runs only while following"
    (is (check-timer (following nil)))
    (is (nil? (check-timer (assoc (following nil) :theme-follows-system false))))
    (is (nil? (check-timer (dissoc (following nil) :gui))))))
