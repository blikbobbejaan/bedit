;; LSP client (src/lsp.blsp) — the pure protocol + connection logic, tested without a
;; live server: completion-result shapes and request/response correlation (the framing
;; itself is brood's `jsonrpc`, tested there). The live proc round-trip is covered by the kernel
;; proc tests (../brood tests/proc_test.blsp); enabling a real server (e.g.
;; rust-analyzer) is a manual smoke step, not part of this deterministic suite.

(defmodule lsp-test
  (:use test)
  (:use-internals lsp)
  (:use-internals lsp-commands) ; the lookups and their folds — split out of commands (X1)
  (:use lsp-requests)
  (:use-internals commands)
  (:use-internals input) ; ed-event-handler — the table the loop routes by
  (:use model) ; ed-init / ed-set-buf / ed-current-buf — the sync hook is a model step
  (:use editor/buffer)) ; make-buffer / insert — the edit a sync is about

(defn serving (m conn &optional (caps {}) (spec-name nil))
  "`m` with `conn` filed as a server for its current buffer's file — the main one
`*lsp-server-specs*` names for the extension (or `spec-name`), rooted at the file's
directory — saying `caps`. What `M-x lsp-connect` files, without spawning anything."
  (let (file (buffer-file (ed-current-buf m))
        name (or spec-name (:name (first (lsp-specs-for file))))
        root (path/dirname (or file "/tmp/scratch")))
    (ed-lsp-attach m {:spec name :roots [root] :conn conn :caps caps})))

(defn rust-model (text)
  ;; a buffer whose FILE has a server configured (`.rs`): a buffer reaches a server only
  ;; through its file's extension, never by being whichever buffer happens to be current
  (model/ed-init (editor/buffer/make-buffer text "s.rs" "/tmp/s.rs")))

(defn python-model ()
  ;; a `.py` buffer: a main server and the ruff add-on both serve it
  (model/ed-init (editor/buffer/make-buffer "" "a.py" "/tmp/a.py")))

(purge-stale-temp "bedit-lsproot-")

(describe "lsp: the servers a file reaches"
  (test "a file finds the server its extension names, rooted above it"
    (let (m (serving (rust-model "fn main() {}") (self)))
      (is (= (self) (ed-lsp-live m)))
      (assert= (self) (:key (ed-lsp-server m)))
      (assert= ["/tmp"] (:roots (ed-lsp-server m)))))
  (test "a file of another language does not reach it — wos next to a Brood server"
    (let (m (serving (model/ed-init (editor/buffer/make-buffer "(fn f () 0)" "k.blsp" "/tmp/k.blsp"))
              (self))
          wos (ed-set-buf m (editor/buffer/make-buffer "(fn f () 0)" "k.wos" "/tmp/k.wos")))
      (is (= (self) (ed-lsp-live m)))
      (is (nil? (ed-lsp-live wos)))
      (is (nil? (lsp-server-entry wos "/tmp/k.wos")))))
  (test "a file outside the server's root does not reach it"
    (let (m (serving (rust-model "") (self)))
      (is (nil? (lsp-server-entry m "/elsewhere/s.rs")))))
  (test "two servers side by side, each buffer its own"
    (let (brood (serving (model/ed-init (editor/buffer/make-buffer "" "k.blsp" "/p/k.blsp"))
                  :brood-conn)
          both (serving (ed-set-buf brood (editor/buffer/make-buffer "" "s.rs" "/p/s.rs"))
                 :rust-conn))
      (assert= 2 (count (:lsp-servers both)))
      (assert= :rust-conn (:conn (lsp-server-entry both "/p/s.rs")))
      (assert= :brood-conn (:conn (lsp-server-entry both "/p/k.blsp")))))
  (test "the deeper root wins when two hold the file"
    (let (m (assoc (rust-model "")
              :lsp-servers
                {:outer {:spec "rust-analyzer" :roots ["/p"] :conn :outer}
                 :inner {:spec "rust-analyzer" :roots ["/p/crate"] :conn :inner}}))
      (assert= :inner (:conn (lsp-server-entry m "/p/crate/src/s.rs")))
      (assert= :outer (:conn (lsp-server-entry m "/p/other/s.rs")))))
  (test "a root is a directory, not a prefix: /p/crate does not hold /p/crate2"
    (is (lsp-under? "/p/crate/s.rs" "/p/crate"))
    (is (not (lsp-under? "/p/crate2/s.rs" "/p/crate"))))
  (test "a nested project is not the running server's once its root is known"
    ;; a project with its own Cargo.lock inside another's tree: rust-analyzer started at the
    ;; top would answer for it, and autostart would never start the one it needs
    (let (top (temp-dir "bedit-lsproot-")
          nested (path/join top "tools/gen")
          file (path/join nested "src/main.rs")
          top-file (path/join top "src/lib.rs")
          m (assoc (rust-model "")
              :lsp-servers {:outer {:spec "rust-analyzer" :roots [top] :conn :outer}}))
      (file/mkdir (path/join nested "src"))
      (file/mkdir (path/join top "src"))
      (file/spit (path/join top "Cargo.lock") "")
      (file/spit (path/join nested "Cargo.lock") "")
      ;; nobody has looked yet: the deepest root around the file, as before
      (assert= :outer (:conn (lsp-server-entry m file)))
      (let (learnt (ed-lsp-learn-roots (ed-lsp-learn-roots m file) top-file))
        (assert= nested (lsp-known-root learnt "rust-analyzer" file))
        (is (nil? (lsp-server-entry learnt file)))
        (assert= :outer (:conn (lsp-server-entry learnt top-file)))
        ;; the retry looks again
        (is (nil? (lsp-known-root (ed-lsp-forget-roots learnt file) "rust-analyzer" file))))))
  (test "a .py file has a main server and the ruff add-on, main first"
    (assert= ["python" "ruff"] (into [] (map (lsp-specs-for "/p/a.py") (fn (spec) (:name spec)))))
    (assert= [] (lsp-specs-for "/p/k.wos"))
    (assert= ["typescript"] (into [] (map (lsp-specs-for "/p/App.tsx") (fn (spec) (:name spec))))))
  (test "both servers of one file are found, and a lookup goes to the one that offers it"
    (let (m (serving (serving (python-model) :pyright {:hoverProvider true})
              :ruff {:codeActionProvider true}
              "ruff"))
      (assert= ["python" "ruff"]
        (into [] (map (lsp-server-entries m "/tmp/a.py") (fn (entry) (:spec entry)))))
      (assert= :pyright (:conn (lsp-server-entry m "/tmp/a.py")))))
  (test "one process can serve several projects: each root is the server's"
    (let (m (assoc (rust-model "")
              :lsp-servers {:shared {:spec "rust-analyzer" :roots ["/a" "/b"] :conn :shared}}))
      (assert= :shared (:conn (lsp-server-entry m "/a/s.rs")))
      (assert= :shared (:conn (lsp-server-entry m "/b/src/s.rs")))
      (is (nil? (lsp-server-entry m "/c/s.rs")))))
  (test "capabilities land on the server that sent them"
    (let (m (serving (rust-model "") :rust-conn)
          m2 (ed-ev-lsp-capabilities m [:lsp-capabilities {:hoverProvider true} :rust-conn] 0 0 0)
          stray (ed-ev-lsp-capabilities m [:lsp-capabilities {:hoverProvider true} :gone] 0 0 0))
      (assert= {:hoverProvider true} (:caps (lsp-server-entry m2 "/tmp/s.rs")))
      (assert= m stray)))
  (test "a server says it takes more projects only with folders and their change notices"
    (is (lsp-folders-supported? {:workspace {:workspaceFolders {:supported true
                                                                :changeNotifications true}}}))
    (is (lsp-folders-supported? {:workspace {:workspaceFolders {:supported true
                                                                :changeNotifications "id"}}}))
    (is (not (lsp-folders-supported? {:workspace {:workspaceFolders {:supported true}}})))
    (is (not (lsp-folders-supported? {}))))
  (test "a new server forgets what was pushed to IT, and only that"
    (let (m (assoc (rust-model "")
              :lsp-synced
                {[:rust-conn "file:///tmp/s.rs"] {:token :a}
                 [:brood-conn "file:///tmp/k.blsp"] {:token :b}})
          m2 (ed-lsp-attach m {:spec "rust-analyzer" :roots ["/tmp"] :conn :rust-conn}))
      (assert= [[:brood-conn "file:///tmp/k.blsp"]] (into [] (keys (:lsp-synced m2))))))
  (test "M-x lsp-servers names each server, its projects, and marks this buffer's"
    (let (other (spawn (receive (_ :done) (after 30000 :done)))
          m (assoc (rust-model "")
              :lsp-servers
                {(self) {:spec "rust-analyzer"
                         :command "rust-analyzer"
                         :roots ["/tmp" "/srv/b"]
                         :conn (self)}
                 other {:spec "brood-lsp" :command "brood-lsp" :roots ["/srv"] :conn other}}))
      (assert= "brood-lsp /srv · *rust-analyzer /tmp, /srv/b" (ed-lsp-servers-line m))
      (assert= "lsp: no servers running" (:echo (cmd-lsp-servers (rust-model "") :key)))))
  (test "M-x lsp-disconnect stops this buffer's server and leaves the others"
    ;; stand-in connections that take the `[:shutdown]` themselves, rather than the test
    ;; process — whose catch-all receives elsewhere in this file would read it
    (let (sink (fn () (spawn (receive (_ :done) (after 30000 :done))))
          brood (serving (model/ed-init (editor/buffer/make-buffer "" "k.blsp" "/p/k.blsp")) (sink))
          both (serving (ed-set-buf brood (editor/buffer/make-buffer "" "s.rs" "/p/s.rs")) (sink))
          after (cmd-lsp-disconnect both :key))
      (assert= ["brood-lsp"] (into [] (map (vals (:lsp-servers after)) (fn (entry) (:spec entry)))))
      (is (includes? (:echo after) "rust-analyzer disconnected"))))
  (test "disconnecting one project from a shared server keeps it for the others"
    (let (sink (spawn (receive (_ :done) (after 30000 :done)))
          m (assoc (rust-model "")
              :lsp-servers {sink {:spec "rust-analyzer" :roots ["/tmp" "/srv/b"] :conn sink}})
          after (cmd-lsp-disconnect m :key))
      (assert= ["/srv/b"] (get-in after [:lsp-servers sink :roots])))))

(describe "lsp: where a server starts"
  (test "the root is the nearest folder holding the first marker any folder above holds"
    ;; a cargo workspace: Cargo.lock at the top, a member crate with its own Cargo.toml
    (let (top (temp-dir "bedit-lsproot-")
          member (path/join top "crates/core")
          spec (lsp-spec-named "rust-analyzer"))
      (file/mkdir (path/join member "src"))
      (file/spit (path/join top "Cargo.lock") "")
      (file/spit (path/join top "Cargo.toml") "")
      (file/spit (path/join member "Cargo.toml") "")
      (assert= top (ed-lsp-root spec (path/join member "src/lib.rs")))))
  (test "with no marker the file's project root stands, else its own folder"
    (let (dir (temp-dir "bedit-lsproot-"))
      (file/mkdir dir)
      (assert= dir (ed-lsp-root (lsp-spec-named "gopls") (path/join dir "main.go")))))
  (test "two projects pinned alike share an identity; a different pin does not"
    (let (a (temp-dir "bedit-lsproot-")
          b (temp-dir "bedit-lsproot-")
          c (temp-dir "bedit-lsproot-"))
      (doseq (dir [a b c]) (file/mkdir dir))
      (file/spit (path/join a "rust-toolchain.toml") "[toolchain]\nchannel = \"1.80\"\n")
      (file/spit (path/join b "rust-toolchain.toml") "[toolchain]\nchannel = \"1.80\"\n")
      (file/spit (path/join c "rust-toolchain.toml") "[toolchain]\nchannel = \"nightly\"\n")
      (assert= (ed-lsp-identity "sh" a) (ed-lsp-identity "sh" b))
      (is (not (= (ed-lsp-identity "sh" a) (ed-lsp-identity "sh" c)))))))

(describe "lsp: diagnostics from several servers on one file"
  (test "each server's publication replaces only its own, and the file shows them all"
    (let (m (serving (serving (python-model) :pyright) :ruff {} "ruff")
          item (fn (text) {:line 1 :col 1 :message text})
          m1 (ed-ev-lsp-diagnostics m
               [:lsp-diagnostics "/tmp/a.py" [(item "type")] [{:message "type"}] :pyright]
               0
               0
               0)
          m2 (ed-ev-lsp-diagnostics m1
               [:lsp-diagnostics "/tmp/a.py" [(item "unused")] [{:message "unused"}] :ruff]
               0
               0
               0)
          m3 (ed-ev-lsp-diagnostics m2 [:lsp-diagnostics "/tmp/a.py" [] [] :pyright] 0 0 0))
      (assert= 2 (count (ed-lsp-merged-diags m2 "/tmp/a.py")))
      (assert= [(item "unused")] (ed-lsp-merged-diags m3 "/tmp/a.py"))
      (assert= [{:message "unused"}] (ed-lsp-raw-diags m3 "/tmp/a.py" :ruff))))
  (test "a server's marks leave the screen with it"
    (let (sink (spawn (receive (_ :done) (after 30000 :done)))
          m (serving (serving (python-model) :pyright) sink {} "ruff")
          m1 (ed-ev-lsp-diagnostics m
               [:lsp-diagnostics "/tmp/a.py" [{:line 1 :col 1 :message "unused"}] [] sink]
               0
               0
               0)
          after (ed-lsp-detach m1 sink))
      (assert= 1 (count (:diagnostics m1)))
      (assert= 0 (count (:diagnostics after)))
      (is (nil? (get-in after [:lsp-diags "/tmp/a.py"])))))
  (test "a publication from a server no longer filed is dropped, not kept for good"
    (let (m (serving (python-model) :pyright)
          late (ed-ev-lsp-diagnostics m
                 [:lsp-diagnostics "/tmp/a.py" [{:line 1 :col 1 :message "stale"}] [] :gone]
                 0
                 0
                 0))
      (assert= m late)))
  (test "a publication about a file that is not open is not kept"
    (let (m (serving (python-model) :pyright)
          other (ed-ev-lsp-diagnostics m
                  [:lsp-diagnostics "/tmp/b.py" [{:line 1 :col 1 :message "x"}] [] :pyright]
                  0
                  0
                  0))
      (is (nil? (:lsp-diags other))))))

(defn telling (to)
  ;; a stand-in connection that tells `to` the first thing it is sent
  (spawn (fn () (receive (msg (send to [:told (self) msg])) (after 5000 nil)))))

(defn told (conn)
  (receive ([:told ^conn msg] msg) (after 1000 nil)))

(defn- relay-told (to left)
  (when (> left 0)
    (receive (msg (do (send to [:told (self) msg]) (relay-told to (dec left)))) (after 5000 nil))))

(defn telling-n (to n)
  ;; a stand-in connection that tells `to` the first `n` things it is sent, in order
  (spawn (fn () (relay-told to n))))

(def folder-caps {:workspace {:workspaceFolders {:supported true :changeNotifications true}}})

(describe "lsp: servers started together become one"
  (test "the second to say it takes folders hands its projects to the first and stops"
    (let (host (telling (self))
          newer (telling (self))
          m (assoc (rust-model "")
              :lsp-servers
                {host {:spec "rust-analyzer"
                       :roots ["/a"]
                       :conn host
                       :caps folder-caps
                       :identity [:same]
                       :command "rust-analyzer"}
                 newer {:spec "rust-analyzer" :roots ["/b"] :conn newer :caps {} :identity [:same]}}
              :lsp-pending {:corr {:conn newer}})
          after (ed-ev-lsp-capabilities m [:lsp-capabilities folder-caps newer] 0 0 0))
      (assert= [host] (into [] (keys (:lsp-servers after))))
      (assert= ["/a" "/b"] (get-in after [:lsp-servers host :roots]))
      (assert= [:folders ["/b"] []] (told host))
      (assert= [:shutdown] (told newer))
      (is (empty? (:lsp-pending after)))
      (is (includes? (:echo after) "ask that again"))))
  (test "a lookup the merged server had not answered is asked of the host instead"
    (let (host (telling-n (self) 2)
          newer (telling (self))
          base (rust-model "fn main() {}")
          rope (editor/buffer/buffer-rope (model/ed-current-buf base))
          request {:uri "file:///tmp/s.rs" :lang "rust" :line 0 :char 3}
          m (assoc base
              :lsp-servers
                {host {:spec "rust-analyzer"
                       :roots ["/a"]
                       :conn host
                       :caps folder-caps
                       :identity [:same]
                       :command "rust-analyzer"}
                 newer {:spec "rust-analyzer"
                        :roots ["/tmp"]
                        :conn newer
                        :caps {}
                        :identity [:same]}}
              :lsp-pending
                {:current (assoc (lsp-hover)
                            :conn newer
                            :request-kind (lsp-hover)
                            :request request
                            :about ["/tmp/s.rs" rope])
                 ;; asked about text that has changed since: its position means nothing now
                 :stale (assoc (lsp-hover)
                          :conn newer
                          :request-kind (lsp-hover)
                          :request request
                          :about ["/tmp/s.rs" nil])})
          after (ed-ev-lsp-capabilities m [:lsp-capabilities folder-caps newer] 0 0 0)
          _ (assert= [:folders ["/tmp"] []] (told host))
          [verb _ corr reply-to sent] (told host))
      (assert= :ask verb)
      (assert= :current corr)
      (assert= (self) reply-to)
      ;; the host never saw the document, so it goes with the request
      (assert= "fn main() {}" (:text sent))
      (assert= host (get-in after [:lsp-pending :current :conn]))
      (is (nil? (get-in after [:lsp-pending :stale])))
      (is (includes? (:echo after) "ask that again"))
      (assert= [:shutdown] (told newer))))
  (test "a server pinned differently, or one that takes no folders, stays its own"
    (let (host (telling (self))
          newer (telling (self))
          servers {host {:spec "rust-analyzer"
                         :roots ["/a"]
                         :conn host
                         :caps folder-caps
                         :identity [:one]}
                   newer {:spec "rust-analyzer"
                          :roots ["/b"]
                          :conn newer
                          :caps {}
                          :identity [:other]}}
          pinned (ed-ev-lsp-capabilities (assoc (rust-model "") :lsp-servers servers)
                   [:lsp-capabilities folder-caps newer]
                   0
                   0
                   0)
          no-folders (ed-ev-lsp-capabilities (assoc (rust-model "")
                                               :lsp-servers
                                                 (assoc-in servers [newer :identity] [:one]))
                       [:lsp-capabilities {} newer]
                       0
                       0
                       0))
      (assert= 2 (count (:lsp-servers pinned)))
      (assert= 2 (count (:lsp-servers no-folders)))
      (exit host :kill)
      (exit newer :kill))))

(describe "lsp: a server that dies is cleared at once"
  (test "its entry, its marks and the lookups waiting on it go, and it is said once"
    (let (m (assoc (serving (rust-model "") :gone)
              :lsp-pending {:corr {:conn :gone} :other {:conn :alive}})
          shown (ed-ev-lsp-diagnostics m
                  [:lsp-diagnostics "/tmp/s.rs" [{:line 1 :col 1 :message "x"}] [] :gone]
                  0
                  0
                  0)
          after (ed-lsp-server-down shown :gone :crashed))
      (is (empty? (:lsp-servers after)))
      (assert= 0 (count (:diagnostics after)))
      (assert= [:other] (into [] (keys (:lsp-pending after))))
      (is (includes? (:echo after) "exited"))
      (is (contains? (:lsp-autostarted after) ["rust-analyzer" "/tmp"]))))
  (test "a server the editor stopped itself passes silently"
    (let (m (rust-model ""))
      (assert= m (ed-lsp-server-down m :stopped :normal))))
  (test "the loop routes a death to it"
    (let (m (serving (rust-model "") :gone)
          after (model/ed-run-down-handlers m :gone :crashed))
      (is (empty? (:lsp-servers after)))))
  (test "every lookup remembers the server it asked"
    (let (sink (spawn (receive (_ :done) (after 30000 :done)))
          m (serving (rust-model "fn main() {}") sink)
          asked (cmd-lsp-hover m :key))
      (is (any? (vals (:lsp-pending asked)) (fn (pending) (= (:conn pending) sink))))
      (exit sink :kill))))

(describe "lsp: a document whose buffer is gone is closed"
  (test "the server is told, and the record of it forgotten"
    ;; a stand-in connection that answers what it was asked to close; one sender's messages
    ;; arrive in order, so the question cannot overtake the close
    (let (conn (spawn (fn ()
                        (receive
                          ([:close uri] (receive
                                          ([:what to] (send to [:closed uri]))
                                          (after 2000 nil)))
                          (after 2000 nil))))
          m (assoc (python-model)
              :lsp-servers {conn {:spec "python" :roots ["/tmp"] :conn conn :caps {}}}
              :lsp-synced
                {[conn "file:///tmp/a.py"] {:token :a} [conn "file:///tmp/gone.py"] {:token :b}})
          after (ed-lsp-close-gone m))
      (assert= [[conn "file:///tmp/a.py"]] (into [] (keys (:lsp-synced after))))
      (send conn [:what (self)])
      (assert= "file:///tmp/gone.py" (receive ([:closed uri] uri) (after 1000 nil)))))
  (test "closing a document the server has open sends didClose and forgets it"
    (let (state {:proc :fake :opened {"file:///a" true} :tokens {"file:///a" :t}}
          [after frames] (lsp-close-document state "file:///a")
          [_ none] (lsp-close-document after "file:///a"))
      (assert= 1 (count frames))
      (is (includes? (first frames) "textDocument/didClose"))
      (is (nil? (get (:opened after) "file:///a")))
      (assert= [] none))))

(describe "lsp: completion-result shapes"
  (test "a CompletionItem[] vector yields its labels"
    (assert= (lsp-completion-labels [{:label "foo"} {:label "bar"}]) (list "foo" "bar")))
  (test "a {:items …} object yields its items' labels"
    (assert= (lsp-completion-labels {:isIncomplete false :items [{:label "baz"}]}) (list "baz")))
  (test "nil yields no labels"
    (assert= (lsp-completion-labels nil) '())))

(purge-stale-temp "bedit-applyedit-")

(describe "lsp: request/response correlation (pure)"
  (test "a completion request records pending and syncs the document first"
    (let (state {:proc :fake :buf "" :next-id 1 :pending {} :opened {} :version 5}
          [st2 frames] (lsp/lsp-issue state
                         :corr-a :pid
                         (lsp-completion)
                         {:uri "file:///a.rb" :lang "ruby" :text "code" :line 0 :char 2}))
      (assert= (count frames) 2)
      (is (includes? (first frames) "didOpen")) ; first sight → didOpen
      (is (includes? (first frames) "ruby")) ; tagged with the languageId
      (is (includes? (second frames) "textDocument/completion"))
      (assert= (get (:pending st2) 1) [:pid :corr-a (lsp-completion)])
      (is (get (:opened st2) "file:///a.rb"))
      ;; a second request to the same uri syncs with didChange, not didOpen
      (let ([st3 frames2] (lsp/lsp-issue st2
                            :corr-b :pid
                            (lsp-completion)
                            {:uri "file:///a.rb" :lang "ruby" :text "x" :line 1 :char 0}))
        (is (includes? (first frames2) "didChange")))))
  (test "a matching response routes labels to the waiter and clears pending"
    (let (state {:proc :fake
                 :buf ""
                 :next-id 8
                 :pending {7 [:my-pid :corr-1 (lsp-completion)]}
                 :opened {}
                 :version 1}
          resp (jsonrpc/frame (json/encode {:jsonrpc "2.0"
                                            :id 7
                                            :result {:items [{:label "foo"} {:label "bar"}]}}))
          [st2 replies] (lsp/lsp-ingest state resp))
      (assert= replies
        (list [:my-pid [:lsp-completion :corr-1 {:labels (list "foo" "bar") :incomplete false}]]))
      (is (nil? (get (:pending st2) 7)))))
  ;; The protocol is bidirectional and this half was simply missing. A server may ask the
  ;; CLIENT to do something — `client/registerCapability` is the usual one, sent by every
  ;; server that registers its file watchers dynamically — and it is a request, so the
  ;; server BLOCKS on the answer. Never answering does not degrade gracefully: Expert
  ;; initialised, advertised a full completionProvider, and then answered nothing at all,
  ;; forever, which reads as a broken server rather than a missing client feature.
  (test "a request FROM the server is answered, not ignored"
    (let (state {:proc :fake :buf "" :next-id 8 :pending {} :opened {} :version 1}
          ask (jsonrpc/frame (json/encode {:jsonrpc "2.0"
                                           :id 1
                                           :method "client/registerCapability"
                                           :params {:registrations []}}))
          [st2 replies] (lsp/lsp-ingest state ask))
      ;; nothing goes to a waiter — this is not anyone's response
      (is (empty? replies))
      ;; …but a frame is queued for the server, carrying ITS id
      (assert= (count (:outbox st2)) 1)
      (is (includes? (first (:outbox st2)) "\"id\":1"))
      (is (includes? (first (:outbox st2)) "\"result\":null"))))

  (test "a server request this client does not implement is refused, still answered"
    ;; MethodNotFound is a real answer: it unblocks the server just as well as agreement,
    ;; and silence is the only response that does not.
    (let (state {:proc :fake :buf "" :next-id 8 :pending {} :opened {} :version 1}
          ask (jsonrpc/frame (json/encode {:jsonrpc "2.0"
                                           :id 4
                                           :method "workspace/somethingElse"
                                           :params {}}))
          [st2 _] (lsp/lsp-ingest state ask))
      (assert= (count (:outbox st2)) 1)
      (is (includes? (first (:outbox st2)) "-32601"))
      (is (includes? (first (:outbox st2)) "\"id\":4"))))

  ;; …and the one server request that carries WORK: a code action's command produces its
  ;; edits this way round, as a request to us rather than as the reply to anything.
  (test "workspace/applyEdit is accepted, and its edits queued for the editor"
    (let (state {:proc :fake :buf "" :next-id 8 :pending {} :opened {} :version 1}
          ask (jsonrpc/frame (json/encode {:jsonrpc "2.0"
                                           :id 4
                                           :method "workspace/applyEdit"
                                           :params {:edit {:changes {"file:///a.ex" [{:range {:start {:line 0
                                                                                                      :character 0}
                                                                                              :end {:line 0
                                                                                                    :character 1}}
                                                                                      :newText "N"}]}}}}))
          [st2 _] (lsp/lsp-ingest state ask))
      ;; answered at once and positively: the loop that owns the buffers applies it, and a
      ;; connection that stops reading its server until that lands is how a client deadlocks
      (assert= (count (:outbox st2)) 1)
      (is (includes? (first (:outbox st2)) "\"applied\":true"))
      (is (includes? (first (:outbox st2)) "\"id\":4"))
      (assert= (into [] (:edits st2))
        [{"/a.ex" (list {:start-line 0 :start-char 0 :end-line 0 :end-char 1 :text "N"})}])))

  (test "a notification is still nothing to answer"
    ;; :method with no :id — publishDiagnostics, logMessage. Answering one would be a
    ;; protocol error in the other direction.
    (let (state {:proc :fake :buf "" :next-id 8 :pending {} :opened {} :version 1}
          note (jsonrpc/frame (json/encode {:jsonrpc "2.0"
                                            :method "window/logMessage"
                                            :params {:message "hi" :type 3}}))
          [st2 replies] (lsp/lsp-ingest state note))
      (is (empty? replies))
      (is (empty? (or (:outbox st2) [])))
      ;; …but it is KEPT, for the editor's `*lsp-log*`: the log is how someone debugging a
      ;; server finds out what it thought it was doing. Whether it is also echoed is the
      ;; editor's call (lsp-notice-echo?), and for the log the answer is no.
      (assert= (into [] (:notices st2))
        [{:channel :log :level "info" :text "hi" :line "hi"}])))

  ;; What makes a language server worth connecting for. bedit already renders diagnostics —
  ;; the underline on the token, the ⚠ note at the end of the line, the gutter mark — and
  ;; the only thing that ever produced them was the Brood checker, so every other language
  ;; had the whole apparatus and nothing to put in it.
  (test "a published diagnostic converts to bedit's 1-based shape"
    ;; LSP counts lines and characters from 0 and bedit's view reads 1-based, so both are
    ;; shifted. Getting this wrong puts every mark one line above the code it is about, and
    ;; it looks plausible.
    (let (d (lsp/lsp-diagnostic {:range {:start {:line 3 :character 17}}
                                 :severity 2
                                 :message "variable \"unused\" is unused"}))
      (assert= (:line d) 4)
      (assert= (:col d) 18)
      ;; bedit's diagnostics carry no severity field, so the word goes in the message —
      ;; which is how the Brood checker's own findings already read
      (assert= (:message d) "warning: variable \"unused\" is unused")))

  (test "each LSP severity names itself in the message"
    (let (msg (fn (sev)
                (:message (lsp/lsp-diagnostic {:range {:start {:line 0 :character 0}}
                                               :severity sev
                                               :message "x"}))))
      (assert= (msg 1) "error: x")
      (assert= (msg 2) "warning: x")
      ;; an absent severity is not invented
      (assert= (:message (lsp/lsp-diagnostic {:range {:start {:line 0 :character 0}} :message "x"}))
        "x")))

  (test "publishDiagnostics is routed as diagnostics, not as narration"
    (let (state {:proc :fake
                 :buf ""
                 :next-id 8
                 :pending {}
                 :opened {"file:///tmp/a.ex" true}
                 :version 1}
          note (jsonrpc/frame (json/encode {:jsonrpc "2.0"
                                            :method "textDocument/publishDiagnostics"
                                            :params {:uri "file:///tmp/a.ex"
                                                     :diagnostics [{:range {:start {:line 0
                                                                                    :character 0}}
                                                                    :severity 1
                                                                    :message "boom"}]}}))
          [st2 replies] (lsp/lsp-ingest state note))
      (is (empty? replies))
      (is (empty? (or (:notices st2) []))) ; not a log line
      (assert= (count (:diags st2)) 1)
      (let ([path items raw] (first (:diags st2)))
        (assert= path "/tmp/a.ex") ; a path, not a URI — that is what a buffer carries
        (assert= (count items) 1)
        (assert= (:line (first items)) 1)
        ;; the server's own object is kept beside the rendered one: a quickfix is asked for
        ;; by handing the diagnostic BACK, and bedit's flattened shape is not one a server
        ;; recognises
        (assert= (:message (first raw)) "boom")
        (assert= (get-in (first raw) [:range :start :line]) 0))))

  ;; An empty list is a MESSAGE, not an absence: it is how a server says the file is clean
  ;; now, and dropping it leaves the errors you have just fixed sitting on screen.
  (test "an empty diagnostic list is published like any other"
    (let (state {:proc :fake
                 :buf ""
                 :next-id 8
                 :pending {}
                 :opened {"file:///tmp/a.ex" true}
                 :version 1}
          note (jsonrpc/frame (json/encode {:jsonrpc "2.0"
                                            :method "textDocument/publishDiagnostics"
                                            :params {:uri "file:///tmp/a.ex" :diagnostics []}}))
          [st2 _] (lsp/lsp-ingest state note))
      (assert= (count (:diags st2)) 1)
      (assert= (second (first (:diags st2))) [])))

  ;; While a server indexes it publishes about files nobody has open, hundreds a second, and
  ;; logs a line per file. Each was its own editor event, and the editor froze behind them.
  (test "diagnostics for a document this connection never opened are not forwarded"
    (let (state {:proc :fake
                 :buf ""
                 :next-id 8
                 :pending {}
                 :opened {"file:///tmp/a.ex" true}
                 :version 1}
          publish (fn (uri)
                    (jsonrpc/frame (json/encode {:jsonrpc "2.0"
                                                 :method "textDocument/publishDiagnostics"
                                                 :params {:uri uri :diagnostics []}})))
          [st2 _] (lsp/lsp-ingest state
                    (str (publish "file:///tmp/other.ex") (publish "file:///tmp/a.ex"))))
      (assert= (map (:diags st2) first) (list "/tmp/a.ex"))))

  (test "a publication is matched to an opened document by PATH, however the server spells the URI"
    ;; bedit escapes `+` (`c%2B%2B`); rust-analyzer does not (`c++`) — the same file
    (let (state {:proc :fake
                 :buf ""
                 :next-id 8
                 :pending {}
                 :opened {(lsp/lsp-path->uri "/tmp/c++/a.rs") true}
                 :version 1}
          note (jsonrpc/frame (json/encode {:jsonrpc "2.0"
                                            :method "textDocument/publishDiagnostics"
                                            :params {:uri "file:///tmp/c++/a.rs" :diagnostics []}}))
          [st2 _] (lsp/lsp-ingest state note))
      (assert= (map (:diags st2) first) (list "/tmp/c++/a.rs"))))

  (test "within one batch the newest publication for a file replaces the older"
    (let (state {:proc :fake
                 :buf ""
                 :next-id 8
                 :pending {}
                 :opened {"file:///tmp/a.ex" true}
                 :version 1}
          publish (fn (message)
                    (jsonrpc/frame (json/encode {:jsonrpc "2.0"
                                                 :method "textDocument/publishDiagnostics"
                                                 :params {:uri "file:///tmp/a.ex"
                                                          :diagnostics [{:range {:start {:line 0
                                                                                         :character 0}}
                                                                         :message message}]}})))
          [st2 _] (lsp/lsp-ingest state (str (publish "old") (publish "new"))))
      (assert= (count (:diags st2)) 1)
      (assert= (:message (first (second (first (:diags st2))))) "new")))

  (test "a burst of log lines stays on the connection as ONE batch"
    (let (state {:proc :fake :buf "" :next-id 8 :pending {} :opened {} :version 1}
          line (fn (i)
                 (jsonrpc/frame (json/encode {:jsonrpc "2.0"
                                              :method "window/logMessage"
                                              :params {:type 3 :message (str "indexed " i)}})))
          [st2 _] (lsp/lsp-ingest state (string/join (map (range 200) line) "")))
      (assert= (count (:notices st2)) 200)
      (assert= (:text (last (:notices st2))) "indexed 199")))

  (test "a server's notice carries one clipped line for the echo, the whole text for the log"
    ;; Expert's startup log includes the entire `PATH` and a fifteen-line list of ebin
    ;; directories. The first line is the sentence; the rest is the attachment.
    (let (paths "ebin paths:\n[\"/a\"\n \"/b\"]"
          notice (lsp/lsp-notice {:method "window/logMessage" :params {:message paths :type 4}}))
      (assert= (:line notice) "ebin paths:")
      (assert= (:text notice) paths)
      (assert= (:level notice) "log"))
    (let (long (string/repeat "x" 400)
          ;; the clip answers a string for a message with content; a nil here would be the
          ;; test passing vacuously, so it is an error rather than a skipped assertion
          out (or (lsp/lsp-notice-line long)
                (error "a long log line should still clip, not vanish")))
      (is (<= (string/length out) lsp/*lsp-notice-width*))
      (is (string/ends-with? out "…")))
    ;; progress `begin` carries :title, `report` carries :message — both are worth showing
    (assert= (:line (lsp/lsp-notice {:method "$/progress"
                                     :params {:value {:kind "begin" :title "Starting engine node"}}}))
      "Starting engine node")
    (assert= (:line (lsp/lsp-notice {:method "$/progress"
                                     :params {:value {:kind "report" :message "Compiling…"}}}))
      "Compiling…")
    (assert= (:channel (lsp/lsp-notice {:method "window/showMessage"
                                        :params {:type 1 :message "build failed"}}))
      :show)
    ;; nothing to say, nothing shown
    (is (nil? (lsp/lsp-notice {:method "$/progress" :params {:value {:kind "end"}}})))
    (is (nil? (lsp/lsp-notice {:method "window/logMessage" :params {:message "  "}})))
    (is (nil? (lsp/lsp-notice {:method "textDocument/publishDiagnostics" :params {}}))))

  ;; The bug: Expert forwards its whole Logger as `window/logMessage`, and its indexer logs
  ;; an ERROR for every struct literal whose alias it cannot expand. Every one of them was
  ;; echoed, flooding the echo area in whatever buffer the reader was in.
  (test "the server's LOG is never echoed, at any level; progress and showMessage are"
    (let (alias-error {:method "window/logMessage"
                       :params {:type 1
                                :message ": Could not expand alias: {:%, [line: 36, column: 9], [{:__aliases__, [last: [line: 36, column: 10]]}]}"}}
          notice (lsp/lsp-notice alias-error))
      (assert= (:channel notice) :log)
      (assert= (:level notice) "error")
      (is (not (lsp/lsp-notice-echo? notice))))
    (is (not (lsp/lsp-notice-echo? (lsp/lsp-notice {:method "window/logMessage"
                                                    :params {:type 3 :message "Server initialized"}}))))
    (is (lsp/lsp-notice-echo? (lsp/lsp-notice {:method "$/progress"
                                               :params {:value {:kind "begin"
                                                                :title "[proj] Starting engine node"}}})))
    (is (lsp/lsp-notice-echo? (lsp/lsp-notice {:method "window/showMessage"
                                               :params {:type 2 :message "mix.lock is stale"}})))
    ;; a showMessage at `log` level is the protocol's own "not for the reader"
    (is (not (lsp/lsp-notice-echo? (lsp/lsp-notice {:method "window/showMessage"
                                                    :params {:type 4 :message "chatter"}})))))

  (test "an error RESPONSE still answers its waiter, and its reason goes to the log only"
    (let (state {:proc :fake
                 :buf ""
                 :next-id 8
                 :pending {7 [:my-pid :corr-1 (lsp-hover)]}
                 :opened {}
                 :version 1}
          resp (jsonrpc/frame (json/encode {:jsonrpc "2.0"
                                            :id 7
                                            :error {:code -32603 :message "engine not ready"}}))
          [st2 replies] (lsp/lsp-ingest state resp)
          notice (first (:notices st2)))
      ;; the waiter is not left hanging: it gets the empty answer its command words itself
      (assert= (count replies) 1)
      (is (nil? (get (:pending st2) 7)))
      (assert= (:channel notice) :log)
      (is (includes? (:text notice) "textDocument/hover failed: engine not ready"))
      (is (not (lsp/lsp-notice-echo? notice)))))

  (test "the client advertises workDoneProgress, and acknowledges a progress token"
    (assert= (get-in (lsp/lsp-init-params "file:///p") [:capabilities :window :workDoneProgress])
      true)
    (let (state {:proc :fake :buf "" :next-id 8 :pending {} :opened {} :version 1}
          ask (jsonrpc/frame (json/encode {:jsonrpc "2.0"
                                           :id 2
                                           :method "window/workDoneProgress/create"
                                           :params {:token "t"}}))
          [st2 _] (lsp/lsp-ingest state ask))
      (is (includes? (first (:outbox st2)) "\"result\":null"))))

  (test "a response split across two chunks reassembles, then routes"
    (let (f (jsonrpc/frame (json/encode {:jsonrpc "2.0" :id 7 :result {:items []}}))
          mid (math/quot (string/length f) 2)
          state {:proc :fake
                 :buf ""
                 :next-id 8
                 :pending {7 [:my-pid :corr-1 (lsp-completion)]}
                 :opened {}
                 :version 1}
          [s1 r1] (lsp/lsp-ingest state (string/substring f 0 mid))
          [s2 r2] (lsp/lsp-ingest s1 (string/substring f mid (string/length f))))
      (is (empty? r1)) ; first half: nothing complete
      (assert= (:buf s1) (string/substring f 0 mid)) ; buffered intact
      (assert= (count r2) 1) ; second half completes the frame
      (is (nil? (get (:pending s2) 7)))))) ; and clears the pending entry
(describe "lsp: documentSymbol shapes (imenu)"
  (test "a flat SymbolInformation[] flattens to {:name :kind :line :char}"
    (assert= (lsp-document-symbols [{:name "foo"
                                     :kind 12
                                     :location {:range {:start {:line 3 :character 2}}}}])
      (list {:name "foo" :kind 12 :line 3 :char 2})))
  (test "a hierarchical DocumentSymbol qualifies children with the parent name, parent first"
    (assert= (lsp-document-symbols [{:name "C"
                                     :kind 5
                                     :selectionRange {:start {:line 1 :character 0}}
                                     :children [{:name "m"
                                                 :kind 6
                                                 :selectionRange {:start {:line 2 :character 4}}}]}])
      (list {:name "C" :kind 5 :line 1 :char 0}
        {:name "C.m" :kind 6 :line 2 :char 4})))
  (test "selectionRange wins over range; missing position is [0 0]"
    (assert= (lsp-document-symbols [{:name "x" :kind 13}])
      (list {:name "x" :kind 13 :line 0 :char 0})))
  (test "nil result yields no symbols"
    (assert= (lsp-document-symbols nil) '()))
  (test "kind tags map known kinds, else \"?\""
    (assert= (lsp/lsp-symbol-kind-name 12) "fn")
    (assert= (lsp/lsp-symbol-kind-name 6) "method")
    (assert= (lsp/lsp-symbol-kind-name 999) "?")))

(describe "lsp: documentSymbol correlation (pure)"
  (test "a symbols request records pending tagged :symbols and sends documentSymbol"
    (let (state {:proc :fake :buf "" :next-id 4 :pending {} :opened {} :version 2}
          [st2 frames] (lsp/lsp-issue state
                         :corr-s :pid
                         (lsp-symbols)
                         {:uri "file:///a.rb" :lang "ruby" :text "code"}))
      (assert= (count frames) 2)
      (is (includes? (first frames) "didOpen")) ; doc synced first
      (is (includes? (second frames) "textDocument/documentSymbol"))
      (assert= (get (:pending st2) 4) [:pid :corr-s (lsp-symbols)]))) ; tagged so dispatch shapes symbols
  (test "a :symbols-tagged response routes [:lsp-symbols …] (not completion)"
    (let (state {:proc :fake
                 :buf ""
                 :next-id 9
                 :pending {8 [:my-pid :corr-2 (lsp-symbols)]}
                 :opened {}
                 :version 1}
          resp (jsonrpc/frame (json/encode {:jsonrpc "2.0"
                                            :id 8
                                            :result [{:name "g"
                                                      :kind 12
                                                      :location {:range {:start {:line 5
                                                                                 :character 0}}}}]}))
          [st2 replies] (lsp/lsp-ingest state resp))
      (assert= replies
        (list [:my-pid [:lsp-symbols :corr-2 (list {:name "g" :kind 12 :line 5 :char 0})]]))
      (is (nil? (get (:pending st2) 8))))))

(describe "lsp: location / hover / edit shapes (goto, refs, hover, rename, format)"
  (test "uri->path strips the file:// scheme"
    (assert= (lsp/lsp-uri->path "file:///x/y.rb") "/x/y.rb")
    (assert= (lsp/lsp-uri->path "/x/y.rb") "/x/y.rb"))
  (test "a single Location normalises to a one-element {:path :line :char} list"
    (assert= (lsp-locations {:uri "file:///a.rb" :range {:start {:line 4 :character 2}}})
      (list {:path "/a.rb" :line 4 :char 2})))
  (test "a Location[] normalises each; a LocationLink uses its target fields"
    (assert= (lsp-locations [{:uri "file:///a" :range {:start {:line 0 :character 0}}}
                              {:targetUri "file:///b"
                               :targetSelectionRange {:start {:line 3 :character 1}}}])
      (list {:path "/a" :line 0 :char 0} {:path "/b" :line 3 :char 1})))
  (test "nil locations → empty"
    (assert= (lsp-locations nil) '()))
  ;; ---- signature help: the one line, with the argument you are on picked out ----
  (test "the active parameter is marked, by offsets or by substring"
    ;; both forms are in the wild: Expert and rust-analyzer send `[start end]`, gopls and
    ;; several TypeScript servers send the parameter's own text
    (let (by-text {:signatures [{:label "get(map, key, default)"
                                 :parameters [{:label "map"} {:label "key"} {:label "default"}]}]
                   :activeParameter 2}
          by-offset {:signatures [{:label "get(map, key, default)"
                                   :parameters [{:label [4 7]} {:label [9 12]}]}]
                     :activeParameter 0})
      (assert= (lsp-signature-text by-text) "get(map, key, ‹default›)")
      (assert= (lsp-signature-text by-offset) "get(‹map›, key, default)")))

  (test "the signature's own activeParameter wins over the help's (LSP 3.16)"
    (assert= (lsp-signature-text {:signatures [{:label "f(a, b)"
                                                :parameters [{:label "a"} {:label "b"}]
                                                :activeParameter 1}]
                                  :activeParameter 0})
      "f(a, ‹b›)"))

  (test "more than one arity says so — the one you are typing towards is not the only one"
    (assert= (lsp-signature-text {:signatures [{:label "f(a)" :parameters [{:label "a"}]}
                                                {:label "f(a, b)"
                                                 :parameters [{:label "a"} {:label "b"}]}]
                                  :activeSignature 1
                                  :activeParameter 1})
      "f(a, ‹b›)  (2/2)"))

  (test "nothing to say is \"\" — which is the server's answer outside a call"
    (assert= (lsp-signature-text nil) "")
    (assert= (lsp-signature-text {:signatures []}) "")
    ;; no activeParameter at all: the label, unmarked, rather than a guess
    (assert= (lsp-signature-text {:signatures [{:label "f(a, b)"}]}) "f(a, b)")
    ;; an out-of-range index is a server bug we survive rather than mark at the wrong place
    (assert= (lsp-signature-text {:signatures [{:label "f(a)" :parameters [{:label "a"}]}]
                                  :activeParameter 9})
      "f(a)")
    ;; a parameter whose text is not in the label locates nothing, and marks nothing
    (assert= (lsp-signature-text {:signatures [{:label "f(a)" :parameters [{:label "zzz"}]}]
                                  :activeParameter 0})
      "f(a)"))

  ;; ---- code actions: two wire shapes, one list ----------------------------------
  ;; The server answers with `Command`s (`{:title :command :arguments}` — ask it to do the
  ;; thing) and `CodeAction`s (`{:title :kind :edit :command}` — edits we apply ourselves),
  ;; mixed in one array. Normalised here so the editor never has to tell them apart.
  (test "a CodeAction's edits and a Command's call normalise to the same shape"
    (let (as (lsp-code-action-list [{:title "Add alias"
                                     :kind "quickfix"
                                     :edit {:changes {"file:///a.ex" [{:range {:start {:line 0
                                                                                       :character 0}
                                                                               :end {:line 0
                                                                                     :character 0}}
                                                                       :newText "alias Foo\n"}]}}}
                                     {:title "Run the thing"
                                      :command "expert.doIt"
                                      :arguments ["a"]}])
          [fixit cmd] [(first as) (second as)])
      (assert= (:title fixit) "Add alias")
      (assert= (:kind fixit) "quickfix")
      (assert= (keys (:edit fixit)) (list "/a.ex"))
      (is (nil? (:command fixit)))
      (assert= (:title cmd) "Run the thing")
      (assert= (:command cmd) "expert.doIt")
      (assert= (:arguments cmd) ["a"])
      (is (nil? (:edit cmd)))))

  (test "a CodeAction's nested Command is unwrapped, not mistaken for a name"
    ;; a Command's `:command` is a string; a CodeAction's is a whole Command object — the
    ;; one field that tells the two forms apart
    (let (a (first (lsp-code-action-list [{:title "Organize imports"
                                           :kind "source.organizeImports"
                                           :command {:title "Organize imports"
                                                     :command "expert.organize"
                                                     :arguments [1 2]}}])))
      (assert= (:command a) "expert.organize")
      (assert= (:arguments a) [1 2])))

  (test "an action with neither edits nor a command is dropped"
    ;; a title with nothing behind it would promise a fix that cannot happen
    (assert= (lsp-code-action-list [{:title "Nothing"} {:title "Empty" :edit {}}]) '())
    (assert= (lsp-code-action-list nil) '()))

  (test "the code-action context is the diagnostics on THAT line"
    ;; a server matches its quickfixes to the finding you hand back, so the wrong line's
    ;; diagnostics read as the fix for the error under your cursor not existing
    (let (raw [{:range {:start {:line 2 :character 0} :end {:line 2 :character 9}} :message "a"}
                {:range {:start {:line 7 :character 0} :end {:line 9 :character 0}} :message "b"}])
      (assert= (map (lsp/lsp-diagnostics-at-line raw 2) :message) (list "a"))
      ;; a multi-line range covers every line it spans
      (assert= (map (lsp/lsp-diagnostics-at-line raw 8) :message) (list "b"))
      (assert= (lsp/lsp-diagnostics-at-line raw 4) [])
      (assert= (lsp/lsp-diagnostics-at-line nil 0) [])))

  (test "hover text: string, {:value}, and array contents"
    (assert= (lsp-hover-text {:contents "doc"}) "doc")
    (assert= (lsp-hover-text {:contents {:kind "markdown" :value "**x**"}}) "**x**")
    (assert= (lsp-hover-text {:contents ["a" {:value "b"}]}) "a\n\nb")
    (assert= (lsp-hover-text nil) ""))
  (test "text edits normalise range + newText"
    (assert= (lsp-text-edits [{:range {:start {:line 1 :character 0} :end {:line 1 :character 3}}
                               :newText "xy"}])
      (list {:start-line 1 :start-char 0 :end-line 1 :end-char 3 :text "xy"})))
  (test "workspace edit: :changes map → {path -> [edit]}"
    (assert= (lsp-workspace-edit {:changes {"file:///a.rb" [{:range {:start {:line 0 :character 0}
                                                                     :end {:line 0 :character 1}}
                                                             :newText "Z"}]}})
      {"/a.rb" (list {:start-line 0 :start-char 0 :end-line 0 :end-char 1 :text "Z"})}))
  (test "workspace edit: :documentChanges array → {path -> [edit]}"
    (assert= (lsp-workspace-edit {:documentChanges [{:textDocument {:uri "file:///b.rb" :version 1}
                                                     :edits [{:range {:start {:line 2 :character 0}
                                                                      :end {:line 2 :character 4}}
                                                              :newText "q"}]}]})
      {"/b.rb" (list {:start-line 2 :start-char 0 :end-line 2 :end-char 4 :text "q"})})))

(describe "lsp: dispatch routes each kind to its reply (pure)"
  (test "a :definition-tagged response routes [:lsp-definition locs]"
    (let (state {:proc :fake
                 :buf ""
                 :next-id 3
                 :pending {2 [:p :c (lsp-definition)]}
                 :opened {}
                 :version 1}
          resp (jsonrpc/frame (json/encode {:jsonrpc "2.0"
                                            :id 2
                                            :result {:uri "file:///d"
                                                     :range {:start {:line 7 :character 3}}}}))
          [st2 replies] (lsp/lsp-ingest state resp))
      (assert= replies (list [:p [:lsp-definition :c (list {:path "/d" :line 7 :char 3})]]))))
  (test "a :hover-tagged response routes [:lsp-hover text]"
    (let (state {:proc :fake
                 :buf ""
                 :next-id 3
                 :pending {2 [:p :c (lsp-hover)]}
                 :opened {}
                 :version 1}
          resp (jsonrpc/frame (json/encode {:jsonrpc "2.0" :id 2 :result {:contents "the docs"}}))
          [st2 replies] (lsp/lsp-ingest state resp))
      (assert= replies (list [:p [:lsp-hover :c "the docs"]]))))
  (test "the requests carry the position and the context the server needs"
    (let (sig (lsp/lsp-request-frame 3 (lsp-signature) {:uri "file:///a.rs" :line 7 :char 12})
          act (lsp/lsp-request-frame 4
                (lsp-code-actions)
                {:uri "file:///a.ex"
                 :line 2
                 :char 0
                 :diags [{:range {:start {:line 2 :character 0} :end {:line 2 :character 4}}
                          :message "boom"}]})
          cmd (lsp/lsp-request-frame 5
                (lsp-execute-command)
                {:command "expert.doIt" :arguments ["x"]}))
      (is (includes? sig "textDocument/signatureHelp"))
      (is (includes? sig "\"line\":7"))
      (is (includes? sig "\"character\":12"))
      (is (includes? act "textDocument/codeAction"))
      ;; the diagnostics go WITH it — without them most servers answer with their
      ;; unconditional refactorings only, which reads as the fix for your error not existing
      (is (includes? act "boom"))
      (is (includes? cmd "workspace/executeCommand"))
      (is (includes? cmd "expert.doIt"))))

  (test "a :signature-tagged response routes [:lsp-signature line]"
    (let (state {:proc :fake
                 :buf ""
                 :next-id 3
                 :pending {2 [:p :c (lsp-signature)]}
                 :opened {}
                 :version 1}
          resp (jsonrpc/frame (json/encode {:jsonrpc "2.0"
                                            :id 2
                                            :result {:signatures [{:label "put(map, key, value)"
                                                                   :parameters [{:label "map"}
                                                                                 {:label "key"}
                                                                                 {:label "value"}]}]
                                                     :activeSignature 0
                                                     :activeParameter 1}}))
          [st2 replies] (lsp/lsp-ingest state resp))
      (assert= replies (list [:p [:lsp-signature :c "put(map, ‹key›, value)"]]))))
  (test "a :rename-tagged response routes [:lsp-workspace-edit edit]"
    (let (state {:proc :fake
                 :buf ""
                 :next-id 3
                 :pending {2 [:p :c (lsp-rename)]}
                 :opened {}
                 :version 1}
          resp (jsonrpc/frame (json/encode {:jsonrpc "2.0"
                                            :id 2
                                            :result {:changes {"file:///a" [{:range {:start {:line 0
                                                                                             :character 0}
                                                                                     :end {:line 0
                                                                                           :character 1}}
                                                                             :newText "N"}]}}}))
          [st2 replies] (lsp/lsp-ingest state resp))
      (assert= replies
        (list [:p
                [:lsp-workspace-edit
                  :c {"/a" (list {:start-line 0 :start-char 0 :end-line 0 :end-char 1 :text "N"})}]])))))

;; ---- the editor-side ASYNC fold (§E.2 — LSP lookups never block the loop) --------
;; ed--lsp-ask registers a pending lookup under a fresh corr; the conn's tagged reply
;; folds through ed-ev-lsp-reply by corr. Pure model-side: no conn process needed —
;; the `fire` closure just hands the corr back for the test to reply with.
(describe "lsp: async lookup fold (ed--lsp-ask / ed-ev-lsp-reply)"
  (test "a hover reply folds when it arrives; a duplicate drops as stale"
    (let (me (self)
          m (model/ed-init (editor/buffer/make-buffer "x"))
          m1 (lsp-commands/ed-lsp-ask m (lsp-hover) (fn (corr) (send me [:corr corr])) nil "hover…")
          corr (receive ([:corr c] c) (after 1000 :none)))
      (assert= (:echo m1) "hover…") ; the in-flight echo
      (let (m2 (lsp-commands/ed-ev-lsp-reply m1 [:lsp-hover corr "DOCS"] 24 80 24))
        (assert= (:echo m2) "DOCS")
        (is (empty? (:lsp-pending m2)))
        ;; the same reply again (or after C-g cleared the table): stale → dropped
        (assert= (:echo (lsp-commands/ed-ev-lsp-reply m2 [:lsp-hover corr "AGAIN"] 24 80 24))
          "DOCS"))))
  ;; The argument hint is the one LSP lookup nobody asks for: the idle beat fires it as you
  ;; type. So it must be silent going out, and it must be sure it is still about where the
  ;; cursor is before it says anything coming back.
  (test "a signature reply lands in the eldoc slot, not the echo"
    (let (me (self)
          m (model/ed-init (editor/buffer/make-buffer "foo(1, 2)"))
          b (model/ed-current-buf m)
          at [(editor/buffer/buffer-point b) (editor/buffer/buffer-rope b)]
          m1 (lsp-commands/ed-lsp-ask m
               (lsp-signature)
               (fn (corr) (send me [:corr corr]))
               {:at at}
               :quiet)
          corr (receive ([:corr c] c) (after 1000 :none)))
      (assert= (:echo m1) "") ; :quiet — no narration on every keystroke
      (let (m2 (lsp-commands/ed-ev-lsp-reply m1 [:lsp-signature corr "foo(‹a›, b)"] 24 80 24))
        (assert= (:eldoc m2) "foo(‹a›, b)")
        (assert= (:echo m2) ""))))

  (test "a signature reply about a call point has left is dropped"
    (let (me (self)
          m (model/ed-init (editor/buffer/make-buffer "foo(1, 2)"))
          b (model/ed-current-buf m)
          m1 (lsp-commands/ed-lsp-ask m
               (lsp-signature)
               (fn (corr) (send me [:corr corr]))
               {:at [(editor/buffer/buffer-point b) (editor/buffer/buffer-rope b)]}
               :quiet)
          corr (receive ([:corr c] c) (after 1000 :none))
          ;; the user typed on while the server worked
          moved (model/ed-set-buf m1 (editor/buffer/insert (model/ed-current-buf m1) "X"))
          m2 (lsp-commands/ed-ev-lsp-reply moved [:lsp-signature corr "foo(‹a›, b)"] 24 80 24))
      (is (nil? (:eldoc m2)))))

  (test "an empty signature clears the hint — the server saying you are out of the call"
    (let (me (self)
          m (model/ed-init (editor/buffer/make-buffer "foo(1, 2)"))
          b (model/ed-current-buf m)
          m1 (assoc (lsp-commands/ed-lsp-ask m
                      (lsp-signature)
                      (fn (corr) (send me [:corr corr]))
                      {:at [(editor/buffer/buffer-point b) (editor/buffer/buffer-rope b)]}
                      :quiet)
               :eldoc "foo(‹a›, b)")
          corr (receive ([:corr c] c) (after 1000 :none))
          m2 (lsp-commands/ed-ev-lsp-reply m1 [:lsp-signature corr ""] 24 80 24))
      (is (nil? (:eldoc m2)))))

  ;; A code action REWRITES your file on the server's say-so, and "add missing import" and
  ;; "delete this clause" arrive through the same door. So: a picker, always, and the title
  ;; read before anything happens.
  (test "code actions open a picker; choosing one applies its edits"
    (let (me (self)
          m (model/ed-init (editor/buffer/make-buffer "defmodule M do\nend\n"))
          m1 (lsp-commands/ed-lsp-ask m
               (lsp-code-actions)
               (fn (corr) (send me [:corr corr]))
               nil
               "code actions…")
          corr (receive ([:corr c] c) (after 1000 :none))
          buf-name (editor/buffer/buffer-name (model/ed-current-buf m1))
          action {:title "Add alias"
                  :kind "quickfix"
                  :edit {buf-name (list {:start-line 0
                                         :start-char 0
                                         :end-line 0
                                         :end-char 0
                                         :text "# "})}}
          m2 (lsp-commands/ed-ev-lsp-reply m1 [:lsp-code-actions corr (list action)] 24 80 24)
          mb (:minibuffer m2))
      ;; nothing has changed yet — a list, not an edit
      (is (not (nil? mb)))
      (assert= (editor/buffer/buffer-text (model/ed-current-buf m2)) "defmodule M do\nend\n")
      (assert= (into [] (:rank-source mb)) ["Add alias  [quickfix]"])))

  (test "no code actions says so rather than opening an empty picker"
    (let (me (self)
          m (model/ed-init (editor/buffer/make-buffer "x"))
          m1 (lsp-commands/ed-lsp-ask m
               (lsp-code-actions)
               (fn (corr) (send me [:corr corr]))
               nil
               "code actions…")
          corr (receive ([:corr c] c) (after 1000 :none))
          m2 (lsp-commands/ed-ev-lsp-reply m1 [:lsp-code-actions corr '()] 24 80 24))
      (is (nil? (:minibuffer m2)))
      (is (includes? (:echo m2) "no code actions"))))

  (test "actions sharing a title are numbered — the picker matches rows by label"
    ;; Expert offers `Add alias` once per candidate module; two identical rows would
    ;; silently mean the first one
    (let (me (self)
          m (model/ed-init (editor/buffer/make-buffer "x"))
          m1 (lsp-commands/ed-lsp-ask m
               (lsp-code-actions)
               (fn (corr) (send me [:corr corr]))
               nil
               "code actions…")
          corr (receive ([:corr c] c) (after 1000 :none))
          two (list {:title "Add alias" :kind "quickfix" :command "a"}
                {:title "Add alias" :kind "quickfix" :command "b"})
          m2 (lsp-commands/ed-ev-lsp-reply m1 [:lsp-code-actions corr two] 24 80 24))
      (assert= (into [] (:rank-source (:minibuffer m2)))
        ["1. Add alias  [quickfix]" "2. Add alias  [quickfix]"])))

  (test "a server's own applyEdit lands on the buffers it names"
    ;; what a chosen action's `workspace/executeCommand` produces: edits arriving as a
    ;; request TO us, not as the reply to anything
    (let (path (str (temp-dir "bedit-applyedit-") ".ex")
          _ (file/spit path "abc\n")
          m (pool/ed-find-file (model/ed-init (editor/buffer/make-buffer "x")) path)
          m2 (lsp-commands/ed-ev-lsp-apply-edit m
               [:lsp-apply-edit
                 {path (list {:start-line 0 :start-char 0 :end-line 0 :end-char 3 :text "zzz"})}]
               24
               80
               24))
      (assert= (editor/buffer/buffer-text (model/ed-current-buf m2)) "zzz\n")
      (is (includes? (:echo m2) "applied edits"))
      (file/rm path)))

  ;; A server says what it can do, and bedit has to read it: Expert advertises code
  ;; actions, hover, definition and references and does NOT advertise signature help. The
  ;; difference between knowing that and not is a key that explains itself versus one that
  ;; appears to do nothing.
  (test "a provider is true, an options object, or absent — and only absent means no"
    (is (lsp/lsp-capable? {:hoverProvider true} :hoverProvider))
    (is (lsp/lsp-capable? {:codeActionProvider {:codeActionKinds ["quickfix"]}} :codeActionProvider))
    (is (not (lsp/lsp-capable? {:hoverProvider true} :signatureHelpProvider)))
    (is (not (lsp/lsp-capable? {:signatureHelpProvider false} :signatureHelpProvider)))
    (is (not (lsp/lsp-capable? nil :hoverProvider))))

  (test "the idle beat never asks a server that does not offer signature help"
    ;; Expert is one, so in an Elixir buffer the argument hints cost exactly nothing
    (let (expert (serving (rust-model "foo(1)")
                   (self)
                   {:codeActionProvider true :hoverProvider true}))
      (assert= (lsp-commands/ed-launch-signature expert) expert) ; not even a stamp
      (is (empty? (:lsp-pending (lsp-commands/ed-launch-signature expert) {})))))

  (test "the command says so rather than doing nothing"
    ;; a live pid, so `ed-lsp-ensure` reads the connection as ready
    (let (m (serving (rust-model "foo(1)") (self) {:hoverProvider true}))
      (is (includes? (:echo (lsp-commands/cmd-lsp-signature-help m :key))
            "does not offer signature help"))
      (is (includes? (:echo (lsp-commands/cmd-lsp-code-action m :key))
            "does not offer code actions"))))

  (test "the idle beat asks once per position, and only where nothing else answers"
    ;; live, which is what the predicate asks
    (let (m (serving (rust-model "foo(1, 2)")
              (self)
              {:signatureHelpProvider {:triggerCharacters ["("]}})
          b (model/ed-current-buf m))
      (is (lsp-commands/ed-signature-due? m)) ; never asked here yet
      (let (asked (assoc m
                    :signature-at [(editor/buffer/buffer-point b) (editor/buffer/buffer-rope b)]))
        (is (not (lsp-commands/ed-signature-due? asked))) ; and not again for the same point
        ;; point moved: ask again
        (is (lsp-commands/ed-signature-due? (model/ed-set-buf asked
                                              (editor/buffer/goto-char (model/ed-current-buf asked)
                                                4)))))
      ;; no server, nothing to ask
      (is (not (lsp-commands/ed-signature-due? (dissoc m :lsp-servers))))))

  ;; The predicate is the idle job's `:stale?` — what keeps the beat ARMED. True whenever
  ;; `:lsp` was set, it kept the beat firing on every debounce, forever, for a server that
  ;; had died or that never offered signature help: the ask declined, `:signature-at` never
  ;; moved, and the job stayed "stale".
  (test "a dead server, or one without signature help, never keeps the beat armed"
    (let (dead (spawn (fn () :done))
          _ (receive ([:never] nil) (after 50 nil))
          signature {:signatureHelpProvider {:triggerCharacters ["("]}}
          m (rust-model "foo(1, 2)"))
      (is (lsp-commands/ed-signature-due? (serving m (self) signature))) ; the control
      (is (not (lsp-commands/ed-signature-due? (serving m dead signature))))
      (is (not (lsp-commands/ed-signature-due? (serving m (self) {:hoverProvider true}))))))

  (test "a mutating reply is rope-guarded: format edits after a buffer change drop"
    (let (me (self)
          m (model/ed-init (editor/buffer/make-buffer "abc"))
          b (model/ed-current-buf m)
          m1 (lsp-commands/ed-lsp-ask m
               (lsp-formatting)
               (fn (corr) (send me [:corr corr]))
               {:rope (editor/buffer/buffer-rope b)
                :buffer (editor/buffer/buffer-name b)}
               "formatting…")
          corr (receive ([:corr c] c) (after 1000 :none))
          ;; the user typed while the server worked
          edited (model/ed-set-buf m1 (editor/buffer/insert (model/ed-current-buf m1) "X"))
          m2 (lsp-commands/ed-ev-lsp-reply edited
               [:lsp-text-edits
                 corr
                 (list {:start-line 0 :start-char 0 :end-line 0 :end-char 3 :text "zzz"})]
               24
               80
               24))
      (is (includes? (:echo m2) "dropped"))
      (assert= (editor/buffer/buffer-text (model/ed-current-buf m2)) "Xabc")))
  (test "an unchanged buffer's format edits apply on arrival — to the ORIGIN buffer"
    (let (me (self)
          m (model/ed-init (editor/buffer/make-buffer "abc"))
          b (model/ed-current-buf m)
          m1 (lsp-commands/ed-lsp-ask m
               (lsp-formatting)
               (fn (corr) (send me [:corr corr]))
               {:rope (editor/buffer/buffer-rope b)
                :buffer (editor/buffer/buffer-name b)}
               "formatting…")
          corr (receive ([:corr c] c) (after 1000 :none))
          ;; the user switched to *Messages* while the server worked: the edits must
          ;; still land on the ORIGIN buffer (unchanged), not whatever is current
          away (model/ed-show-index m1 1)
          m2 (lsp-commands/ed-ev-lsp-reply away
               [:lsp-text-edits
                 corr
                 (list {:start-line 0 :start-char 0 :end-line 0 :end-char 3 :text "zzz"})]
               24
               80
               24))
      (assert= (editor/buffer/buffer-text (model/ed-buf-at m2 0)) "zzz")
      (assert= (:echo m2) "formatted"))))

;; The report this exists for (2026-09-18): opening an Elixir file on a machine with no
;; `elixir-ls` answered a lookup with a crash trace —
;;   [crash] #<pid nonode/15> exited: proc-spawn elixir-ls: No such file or directory
;;           at os/spawn (src/lsp.blsp:548) at bedit/lsp/lsp-run
;; — because `os/spawn` raises inside the connection PROCESS, where a raise is a report on
;; the user's screen rather than a value a command could turn into a sentence. `os/which`
;; (brood's std/os, added the same day) is the ask-first that replaces it.
(defn lspt-only (command)
  ;; the server table with one Elixir server, run by `command`
  [{:name "elixir-test" :extensions ["ex"] :commands [[command []]] :root-markers ["mix.exs"]}])

(describe "lsp: a server that is not installed is a message, not a crash"
  (defn lspt-elixir-model ()
    ;; a .ex buffer, so `lsp-specs-for` resolves whatever `*lsp-server-specs*` serves "ex" with
    (model/ed-init (editor/buffer/make-buffer "defmodule M do\nend\n" "m.ex" "/tmp/m.ex")))
  ;; The absent server is NAMED here rather than assumed of this machine: asserting that
  ;; `elixir-ls` is missing would make the suite depend on nobody ever installing it, and
  ;; go red on the day someone does. `*lsp-server-specs*` is a dynvar precisely so it can be
  ;; pointed somewhere for a test.
  (def lspt-missing "bedit-no-such-language-server")
  (test "the real .ex mapping is configured, and a name that cannot exist is seen to be absent"
    (let ([cmd args] (first (:commands (first (lsp/lsp-specs-for "/tmp/m.ex")))))
      ;; Expert (expert-lsp.org) — the official Elixir server, and the one ElixirLS,
      ;; Lexical and Next LS converged into. `--stdio` because that is this client's only
      ;; transport.
      (assert= "expert" cmd) ; the shipped config, installed here or not
      (assert= ["--stdio"] (into [] args))
      (is (nil? (os/which lspt-missing)))))
  (test "M-x lsp-connect names the missing binary and leaves the model unconnected"
    (binding (*lsp-server-specs* (lspt-only lspt-missing))
      (let (m (lsp-commands/cmd-lsp-connect (lspt-elixir-model) nil))
        (is (includes? (:echo m) lspt-missing))
        (is (includes? (:echo m) "not installed"))
        (is (empty? (or (:lsp-servers m) {})))))) ; nothing was spawned, so nothing to wait on later
  (test "the lookup commands say the same thing instead of starting a doomed server"
    (binding (*lsp-server-specs* (lspt-only lspt-missing))
      (let ([m ready?] (lsp-commands/ed-lsp-ensure (lspt-elixir-model)))
        (refute ready?)
        (is (includes? (:echo m) "not installed"))
        (is (empty? (or (:lsp-servers m) {}))))))
  (test "a dead connection on the model is not a connection"
    ;; a pid whose process is gone: every request would send into the void and wait out
    ;; its timeout, and `lsp-connect` would refuse to start a replacement
    (let (dead (spawn nil)
          _ (monitor dead)
          _ (receive ([:down ref pid reason] nil) (after 2000 nil)) ; its death, observed
          m (serving (lspt-elixir-model) dead))
      (is (nil? (lsp/lsp-complete-source m))) ; no 1 s stall per Tab
      (let (m2 (lsp-commands/cmd-lsp-connect m nil))
        (is (not (includes? (:echo m2) "already connected")))))))

(describe "lsp diagnostics land on the buffer they are about"
  (defn lspd-model ()
    (model/ed-init (editor/buffer/make-buffer "defmodule M do\nend\n" "m.ex" "/tmp/m.ex")))
  (defn lspd-items () [{:line 1 :col 3 :message "warning: boom"}])

  (test "diagnostics for the current buffer are shown"
    (let (m (lsp-commands/ed-ev-lsp-diagnostics (lspd-model)
              [:lsp-diagnostics "/tmp/m.ex" (lspd-items)]
              24
              80
              24))
      (assert= (count (:diagnostics m)) 1)
      ;; indexed by 0-based line for the view, from the 1-based diagnostic
      (assert= (count (get (:diag-by-line m) 0)) 1)))

  ;; The model holds ONE diagnostic set — it is a view of the buffer you are looking at —
  ;; so a server publishing about a file in the background must not replace what is on
  ;; screen with findings about something else.
  (test "diagnostics for another file are ignored"
    (let (m (lsp-commands/ed-ev-lsp-diagnostics (lspd-model)
              [:lsp-diagnostics "/tmp/somewhere-else.ex" (lspd-items)]
              24
              80
              24))
      (is (nil? (:diagnostics m)))))

  (test "a buffer with no file is never matched"
    (let (m (lsp-commands/ed-ev-lsp-diagnostics (model/ed-init (editor/buffer/make-buffer "x"))
              [:lsp-diagnostics "/tmp/m.ex" (lspd-items)]
              24
              80
              24))
      (is (nil? (:diagnostics m)))))

  ;; Clearing is a message too: it is how a server says the file is clean now.
  (test "an empty list clears what was there"
    (let (m1 (lsp-commands/ed-ev-lsp-diagnostics (lspd-model)
               [:lsp-diagnostics "/tmp/m.ex" (lspd-items)]
               24
               80
               24)
          m2 (lsp-commands/ed-ev-lsp-diagnostics m1 [:lsp-diagnostics "/tmp/m.ex" []] 24 80 24))
      (assert= (count (:diagnostics m2)) 0)
      (is (empty? (or (:diag-by-line m2) {})))))

  (test "the handler is registered, so the loop actually routes the event"
    ;; the table and the function are two different things, and only the table is consulted —
    ;; here, the row `lsp-commands` registers when it loads
    (is (= (input/ed-event-handler :lsp-diagnostics) 'lsp-commands/ed-ev-lsp-diagnostics))
    (is (= (input/ed-event-handler :lsp-notices) 'lsp-commands/ed-ev-lsp-notices))))

(describe "a server starts on its own for a buffer that has one"
  ;; It used to start on the first LOOKUP, which was fine while a server was only ever a
  ;; lookup. Diagnostics changed that: the underline on the mistake you just made is the
  ;; thing you want without asking, and a reader who never presses `M-.` would never see one.
  (defn lspa-model (name path)
    (model/ed-init (editor/buffer/make-buffer "defmodule M do\nend\n" name path)))

  (test "a buffer with no file never starts anything"
    (let (m (model/ed-init (editor/buffer/make-buffer "x")))
      (assert= (lsp-commands/ed-lsp-autostart m) m)))

  (test "a buffer whose extension has no server configured never starts anything"
    (let (m (lspa-model "notes.txt" "/tmp/notes.txt"))
      (assert= (lsp-commands/ed-lsp-autostart m) m)))

  (test "a configured server that is not installed is not started, and says nothing"
    ;; silence matters here: a message would fire on every idle beat in every buffer whose
    ;; language has a server nobody installed
    (binding (*lsp-server-specs* (lspt-only "bedit-no-such-language-server"))
      (let (m (lspa-model "m.ex" "/tmp/m.ex")
            m2 (lsp-commands/ed-lsp-autostart m))
        (is (empty? (or (:lsp-servers m2) {})))
        (assert= (:echo m2) (:echo m)))))

  (test "a connection already alive on the model is left alone"
    ;; a real pid, because `ed-lsp-live` asks whether the process is still there — a
    ;; keyword would read as dead and the autostart would go and start a second server
    (let (conn (spawn (receive (_ :done) (after 30000 :done)))
          m (serving (lspa-model "m.ex" "/tmp/m.ex") conn))
      (assert= (ed-lsp-live (lsp-commands/ed-lsp-autostart m)) conn)
      (exit conn :kill)))

  ;; Expert compiles the whole mix project before it answers anything, which is a real
  ;; cost to pay unasked — so it is one `defdyn` in init.blsp to turn off. The name is
  ;; BARE: an earmuffed `defdyn` is ambient, never namespaced, however deep the module.
  (test "autostart is off when the reader turns it off"
    (binding (*lsp-autostart* false)
      (binding (*lsp-server-specs* (lspt-only "expert"))
        (let (m (lspa-model "m.ex" "/tmp/m.ex"))
          (assert= (lsp-commands/ed-lsp-autostart m) m)))))

  ;; A server that dies — a rustup `rust-analyzer` stub for a component that is not
  ;; installed passes `os/which` and exits at once — used to be respawned on every idle
  ;; beat. Bound inside a loop (`*ui-loop*`), because headless the autostart does nothing.
  (test "a server that died is said once and not respawned"
    (binding (*ui-loop* (self))
      (binding (*lsp-server-specs* (lspt-only "sh"))
        (let (dead (spawn (fn () :done))
              _ (receive ([:never] nil) (after 50 nil))
              m (serving (lspa-model "m.ex" "/tmp/m.ex") dead)
              m2 (lsp-commands/ed-lsp-autostart m))
          (is (empty? (:lsp-servers m2)))
          (is (includes? (:echo m2) "exited"))))))

  (test "a dead server that served several projects is dropped whole"
    (binding (*ui-loop* (self))
      (binding (*lsp-server-specs* (lspt-only "sh"))
        (let (dead (spawn (fn () :done))
              _ (receive ([:never] nil) (after 50 nil))
              m (assoc (lspa-model "m.ex" "/tmp/m.ex")
                  :lsp-servers {dead {:spec "elixir-test" :roots ["/tmp" "/srv/b"] :conn dead}})
              m2 (lsp-commands/ed-lsp-autostart m))
          (is (empty? (:lsp-servers m2)))
          (is (includes? (:echo m2) "exited"))))))

  (test "autostart tries a server once per project root, from whichever folder"
    ;; a project marked by `mix.exs`, a file two folders below it: the folder and the
    ;; project root differ, so the two records are two checks
    (binding (*ui-loop* (self))
      (binding (*lsp-server-specs* (lspt-only "sh"))
        (let (top (temp-dir "bedit-lsproot-")
              deep (path/join top "lib/app")
              file (path/join deep "m.ex")
              _ (file/mkdir deep)
              _ (file/spit (path/join top "mix.exs") "")
              tried-folder (assoc (lspa-model "m.ex" file)
                             :lsp-autostarted (conj #{} ["elixir-test" deep]))
              tried-root (assoc (lspa-model "m.ex" file)
                           :lsp-autostarted (conj #{} ["elixir-test" top])))
          (assert= top (lsp-commands/ed-lsp-root (first (lsp/lsp-specs-for file)) file))
          ;; tried from this folder: nothing starts; the root is learnt once (it decides which
          ;; running server serves the file) and never looked for again
          (let (once (lsp-commands/ed-lsp-autostart tried-folder))
            (assert= (dissoc once :lsp-roots) tried-folder)
            (assert= top (lsp/lsp-known-root once "elixir-test" file))
            (assert= (lsp-commands/ed-lsp-autostart once) once))
          ;; tried for this project from another folder: nothing starts, and this folder is
          ;; recorded so the root is not walked again
          (let (after (lsp-commands/ed-lsp-autostart tried-root))
            (is (empty? (or (:lsp-servers after) {})))
            (is (contains? (:lsp-autostarted after) ["elixir-test" deep]))))))))

;; ---- the document sync that is not a question ---------------------------------------
;; A server does not ANSWER with diagnostics; it PUSHES them when it learns the text
;; changed. Every other call into `lsp` syncs the document on its way to asking something
;; (`lsp-issue`), so the findings used to arrive only for whatever version you happened to
;; invoke a lookup on — and never while typing, which is the only time they are worth
;; having. The symptom was exact: imenu worked (asking for symbols synced the text on the
;; way past) and the underline appeared once and never moved.
(describe "the editor tells the server the text changed"
  (defn recorder ()
    ;; a stand-in for the connection process: records what the editor sends it
    (spawn (fn ()
             (letrec (go (fn (got)
                           (receive
                             ([:what to] (send to got))
                             (msg (go (append got (list (first msg)))))
                             (after 2000 :done))))
               (go '())))))
  (defn sent-to (p) (do (send p [:what (self)]) (receive (got got) (after 1000 '()))))

  (test "an edit pushes the text; an idle beat over an unchanged buffer pushes nothing"
    (let (conn (recorder)
          m0 (ed-init (assoc (make-buffer "defmodule P do\nend\n") :file "/tmp/lsp-sync.ex"))
          m (serving m0 conn)
          pushed (ed-lsp-push-text m)
          _ (ed-lsp-push-text pushed) ; nothing typed since
          _ (ed-lsp-push-text (ed-set-buf pushed (insert (ed-current-buf pushed) "x"))))
      (sleep 200)
      (assert= (sent-to conn) (list :sync :sync))))

  (test "no connection, or no file, is silent rather than an error"
    (let (m (ed-init (make-buffer "x")))
      (assert= (ed-lsp-push-text m) m) ; no :lsp
      ;; a server running for SOME file does not make a fileless buffer one of its documents
      (let (conn (recorder)
            fileless (assoc m :lsp-servers {conn {:spec "expert" :roots ["/"] :conn conn :caps {}}}))
        (assert= (ed-lsp-push-text fileless) fileless)
        (sleep 100)
        (assert= (sent-to conn) '())))))

;; ---- URIs and the configuration request (issues P6/P7) ---------------------------
(describe "lsp: URIs are percent-encoded, and configuration is answered"
  (test "a path with a space goes out encoded and comes back as the path"
    (let (uri (lsp/lsp-path->uri "/home/u/my project/a b.ex"))
      (assert= uri "file:///home/u/my%20project/a%20b.ex")
      (assert= (lsp/lsp-uri->path (or uri "")) "/home/u/my project/a b.ex")))
  (test "a server's encoded URI decodes to the file on disk"
    (assert= (lsp/lsp-uri->path "file:///p/%40scope/x.ts") "/p/@scope/x.ts"))
  (test "workspace/configuration gets one null per item, not MethodNotFound"
    (let (state {:proc :fake :buf "" :next-id 8 :pending {} :opened {} :version 1}
          ask (jsonrpc/frame (json/encode {:jsonrpc "2.0"
                                           :id 4
                                           :method "workspace/configuration"
                                           :params {:items [{:section "a"} {:section "b"}]}}))
          [st2 _] (lsp/lsp-ingest state ask)
          frame (first (:outbox st2))
          body (json/decode (string/substring frame
                              (+ 4 (index-of frame "\r\n\r\n"))
                              (string/length frame))))
      (assert= (:id body) 4)
      (assert= (:result body) [nil nil])
      (is (nil? (:error body))))))

;; ---- incremental document sync -------------------------------------------------------
;; A full-text `didChange` is the whole document JSON-encoded (341 ms on a 44k-line buffer)
;; and re-read by the server, on every idle beat after an edit and every completion. The
;; buffer logs what each edit did, so a server that accepts ranged changes gets those.
(describe "lsp: incremental document sync"
  (test "a server's sync kind is read from either spelling of the capability"
    (is (lsp-incremental-sync? {:textDocumentSync 2}))
    (is (lsp-incremental-sync? {:textDocumentSync {:openClose true :change 2}}))
    (refute (lsp-incremental-sync? {:textDocumentSync 1}))
    (refute (lsp-incremental-sync? {:textDocumentSync {:change 1}}))
    (refute (lsp-incremental-sync? nil)))

  (test "the edits since a buffer become ranged changes, each against the text before it"
    (let (before (make-buffer "ab\ncd\n")
          ;; type X at line 1 col 1, then delete the first character of the buffer
          after (delete-char (goto-char (insert (goto-char before 4) "X") 0) 1))
      (assert= (buffer-text after) "b\ncXd\n")
      (assert= (lsp-content-changes before after)
        [{:range {:start {:line 1 :character 1} :end {:line 1 :character 1}} :text "X"}
          {:range {:start {:line 0 :character 0} :end {:line 0 :character 1}} :text ""}])))

  (test "columns are UTF-16 code units: a character beyond the BMP counts two"
    (let (before (make-buffer "😀a\n")
          after (insert (goto-char before 2) "b"))
      (assert= (:range (first (lsp-content-changes before after)))
        {:start {:line 0 :character 3} :end {:line 0 :character 3}})))

  (test "a change the splice log cannot account for answers nil — send the whole text"
    (let (before (make-buffer "abc")
          edited (insert (goto-char before 3) "d"))
      (is (nil? (lsp-content-changes before (undo edited))))
      (is (nil? (lsp-content-changes edited (make-buffer "other"))))))

  (test "changes against the text the server holds apply; against any other are refused"
    (let (state {:proc :fake :buf "" :next-id 1 :pending {} :opened {} :version 1}
          uri "file:///a.ex"
          [opened frames1] (lsp/lsp-sync-document state uri "elixir" {:text "ab" :token :t1})
          change [{:range {:start {:line 0 :character 2} :end {:line 0 :character 2}} :text "c"}]
          [applied frames2] (lsp/lsp-sync-document opened
                              uri
                              "elixir"
                              {:changes change :base :t1 :token :t2})
          [refused frames3] (lsp/lsp-sync-document applied
                              uri
                              "elixir"
                              {:changes change :base :t1 :token :t3}))
      (is (includes? (first frames1) "didOpen"))
      (assert= (count frames2) 1)
      (is (includes? (first frames2) "\"range\""))
      (refute (includes? (first frames2) "\"ab"))
      (assert= (get-in applied [:tokens uri]) :t2)
      ;; a stale base: nothing goes to the server, and the editor is told to resync
      (assert= frames3 [])
      (assert= (:resyncs refused) [uri])
      (is (nil? (get-in refused [:tokens uri])))))

  (test "a request with no text asks without syncing"
    (let (state {:proc :fake :buf "" :next-id 1 :pending {} :opened {} :version 1}
          [_ frames] (lsp/lsp-issue state
                       :corr :pid
                       (lsp-completion)
                       {:uri "file:///a.ex" :lang "elixir" :line 0 :char 1}))
      (assert= (count frames) 1)
      (is (includes? (first frames) "textDocument/completion"))))

  (test "the editor pushes the whole text first, then only the edits since"
    (let (conn (spawn (fn ()
                        (letrec (go (fn (got)
                                      (receive
                                        ([:what to] (send to got))
                                        (msg (go (conj got msg)))
                                        (after 2000 :done))))
                          (go []))))
          m0 (serving (ed-init (assoc (make-buffer "defmodule P do\nend\n") :file "/tmp/lsp-inc.ex"))
               conn
               {:textDocumentSync 2})
          m1 (ed-lsp-push-text m0)
          m2 (ed-lsp-push-text (ed-set-buf m1 (insert (ed-current-buf m1) "x")))
          _ (send conn [:what (self)])
          sent (receive (got got) (after 1000 []))
          [_ _ _ first-sync] (first sent)
          [_ _ _ second-sync] (second sent))
      (assert= (count sent) 2)
      (is (string? (:text first-sync)))
      (assert= (:changes second-sync)
        [{:range {:start {:line 0 :character 0} :end {:line 0 :character 0}} :text "x"}])
      (assert= (:base second-sync) (:token first-sync))
      (assert= (get-in m2 [:lsp-synced [conn "file:///tmp/lsp-inc.ex"] :token])
        (:token second-sync))
      ;; a refused sync forgets the base, so the next push is the whole text again
      (is (nil? (get-in (lsp-commands/ed-ev-lsp-resync m2
                          [:lsp-resync "file:///tmp/lsp-inc.ex" conn]
                          0
                          0
                          0)
                  [:lsp-synced [conn "file:///tmp/lsp-inc.ex"]])))))

  (test "a server that wants the whole text gets the whole text"
    (let (conn (spawn (fn ()
                        (letrec (go (fn (got)
                                      (receive
                                        ([:what to] (send to got))
                                        (msg (go (conj got msg)))
                                        (after 2000 :done))))
                          (go []))))
          m0 (serving (ed-init (assoc (make-buffer "x\n") :file "/tmp/lsp-full.ex"))
               conn
               {:textDocumentSync 1})
          m1 (ed-lsp-push-text m0)
          _ (ed-lsp-push-text (ed-set-buf m1 (insert (ed-current-buf m1) "y")))
          _ (send conn [:what (self)])
          sent (receive (got got) (after 1000 [])))
      (assert= (map sent (fn (msg) (:text (nth msg 3)))) (list "x\n" "yx\n")))))

;; ---- completion asks once, and without the document ------------------------------------
(describe "lsp: the completion source"
  (defn lspc-conn ()
    ;; a stand-in connection: answers every completion ask with one complete list, and
    ;; tells the test what it was asked
    (let (test-pid (self))
      (spawn (fn ()
               (letrec (go (fn ()
                             (receive
                               ([:ask kind corr reply-to request] (do
                                                                    (send test-pid
                                                                      [:lspc-request request])
                                                                    (send reply-to
                                                                      [:lsp-completion
                                                                        corr
                                                                        {:labels (list "defmodule")
                                                                         :incomplete false}])
                                                                    (go)))
                               (after 2000 :done))))
                 (go))))))
  (defn lspc-request ()
    (receive ([:lspc-request request] request) (after 1000 nil)))

  (test "a buffer the server already has is asked about without its text, and cached"
    (let (conn (lspc-conn)
          buf (goto-char (assoc (make-buffer "defmo") :file "/tmp/lsp-c.ex") 5)
          ;; synced AFTER the server is filed: filing one forgets what was pushed to its files
          m (assoc (serving (ed-init buf) conn)
              :lsp-synced {[conn "file:///tmp/lsp-c.ex"] {:buf buf :token :t}})
          answer (lsp/lsp-complete-source m))
      (assert= answer [0 "defmo" (list "defmodule") {:cache true}])
      (refute (contains? (lspc-request) :text))))

  (test "a buffer edited since the last sync sends its text along"
    (let (conn (lspc-conn)
          buf (goto-char (assoc (make-buffer "defmo") :file "/tmp/lsp-c.ex") 5)
          m (serving (ed-init buf) conn)
          _ (lsp/lsp-complete-source m))
      (assert= (:text (lspc-request)) "defmo"))))

;; ---- the editor side of a server's notices: *lsp-log* always, the echo area rarely ----
(defn- notice-buffer-text (m name)
  "The text of the pool buffer called `name` — which must exist."
  (editor/buffer/buffer-text (model/ed-buf-at m (model/ed-buffer-index-by-name! m name))))

(describe "lsp: notices reach the log, and only the reader's reach the echo area"
  (test "Expert's indexer error is logged whole and leaves the echo area alone"
    (let (m (message (model/ed-init (editor/buffer/make-buffer "x")) "what I was reading")
          text ": Could not expand alias: {:%, [line: 36, column: 9], [{:__aliases__, [last: [line: 36, column: 10], line: 36]}]}"
          notice (lsp/lsp-notice {:method "window/logMessage" :params {:type 1 :message text}})
          m2 (lsp-commands/ed-ev-lsp-notices m [:lsp-notices [notice]] 24 80 24))
      (assert= (:echo m2) "what I was reading")
      (is (includes? (notice-buffer-text m2 lsp-commands/*lsp-log-buffer*)
            (str "[log error] " text)))))

  (test "progress is echoed, and not written to *Messages* once per report"
    (let (m (model/ed-init (editor/buffer/make-buffer "x"))
          notice (lsp/lsp-notice {:method "$/progress"
                                  :params {:value {:kind "begin"
                                                   :title "[proj] Starting engine node"}}})
          m2 (lsp-commands/ed-ev-lsp-notices m [:lsp-notices [notice]] 24 80 24))
      (assert= (:echo m2) "lsp: [proj] Starting engine node")
      (assert= (notice-buffer-text m2 "*Messages*") (notice-buffer-text m "*Messages*"))))

  (test "a batch of notices is one append: every line logged, oldest first, the newest progress echoed"
    (let (m (model/ed-init (editor/buffer/make-buffer "x"))
          logs (map (range 300)
                 (fn (i)
                   (lsp/lsp-notice {:method "window/logMessage"
                                    :params {:type 3 :message (str "file " i)}})))
          progress (fn (title)
                     (lsp/lsp-notice {:method "$/progress"
                                      :params {:value {:kind "report" :message title}}}))
          m2 (lsp-commands/ed-ev-lsp-notices m
               [:lsp-notices
                 (into [] (append [(progress "indexing 1/2")] logs [(progress "indexing 2/2")]))]
               24
               80
               24)
          log (notice-buffer-text m2 lsp-commands/*lsp-log-buffer*))
      (is (< (index-of log "file 0\n") (index-of log "file 299")))
      (assert= (count (string/split (string/trim log) "\n")) 302)
      (assert= (:echo m2) "lsp: indexing 2/2")))

  (test "a showMessage is echoed and kept in *Messages*, but the same one twice is not re-echoed"
    (let (m (model/ed-init (editor/buffer/make-buffer "x"))
          notice (lsp/lsp-notice {:method "window/showMessage"
                                  :params {:type 1 :message "build failed"}})
          once (lsp-commands/ed-ev-lsp-notices m [:lsp-notices [notice]] 24 80 24)
          twice (lsp-commands/ed-ev-lsp-notices once [:lsp-notices [notice]] 24 80 24))
      (assert= (:echo once) "lsp: build failed")
      (is (includes? (notice-buffer-text once "*Messages*") "lsp: build failed"))
      (assert= (:echo twice) "lsp: build failed")
      ;; one *Messages* line, not two — the second was already in front of the reader
      (assert= (notice-buffer-text twice "*Messages*") (notice-buffer-text once "*Messages*")))))
