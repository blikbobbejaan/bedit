;; src/vc.blsp — version control in the editor, whichever system the project uses: the
;; backend rows, the mode line's summary off the loop, and the C-x g / C-x v commands that
;; reach a backend through its row.
(defmodule vc-test
  (:use vc)
  (:use model)
  (:use editor/buffer) ; make-buffer
  (:use gitbar) ; git's row is registered when it loads
  (:use murbar) ; and mur's
  (:use test))

(def- fresh-dir (fn (prefix) (let (dir (temp-dir prefix)) (do (file/mkdir dir) dir))))

(describe "vc: which porcelain a checkout gets"
  (test "git and mur each have a row, with a status command and a mode line"
    (doseq (kind [:git :mur])
      (let (row (vc-backend kind))
        (is (symbol? (:status row)))
        (is (symbol? (:summary row)))
        (is (symbol? (:segments row))))))
  (test "a checkout is found by its marker, a VC buffer's own root first"
    (let (dir (fresh-dir "bedit-vc-mur-"))
      (file/mkdir (path/join dir ".mur"))
      (let (m (model/ed-init (make-buffer "x" "a.txt" (path/join dir "a.txt"))))
        (assert= (vc-checkout m) {:kind :mur :root dir}))))
  (test "outside any checkout, C-x g says so rather than running anything"
    (let (dir (fresh-dir "bedit-vc-none-"))
      (when (nil? (vcs/locate dir))
        (let (m (model/ed-init (make-buffer "x" "a.txt" (path/join dir "a.txt"))))
          (is (includes? (:echo (cmd-vc-status m nil)) "not in a version-controlled directory"))))))
  (test "a question a backend has no answer for is said, not an error"
    (let (dir (fresh-dir "bedit-vc-noblame-"))
      (file/mkdir (path/join dir ".mur"))
      (let (m (model/ed-init (make-buffer "x" "a.txt" (path/join dir "a.txt"))))
        (is (includes? (:echo (cmd-vc-blame m nil)) "mur has no blame"))))))

;; ---- the mode line's summary runs OFF the loop ------------------------------------
;; A backend's summary is subprocesses (git status alone is 40 ms on a 27,310-file repo),
;; so it ran on the loop for fifty-odd milliseconds every time typing settled. These pin the
;; async shape: what travels to the task, and what happens to an answer that arrives about
;; a buffer the reader has already left.
(describe "vc: the mode line's summary, off the loop"
  (test "the key is what the loop already knows — no subprocess to compute it"
    (let (m (model/ed-init (make-buffer "x" "notes.txt" "/proj/notes.txt")))
      (assert= [nil "/proj" true false] (vc-summary-key m))))
  (test "a fileless buffer that is not a VC buffer describes nothing"
    ;; `vc-summary` short-circuits on the key alone, so nothing runs at all
    (let (m (model/ed-init (make-buffer "x" "*scratch*")))
      (is (not (nth (vc-summary-key m) 2)))
      (is (nil? (vc-summary (vc-summary-key m))))))
  (test "an answer folds into the cached summary + segments and frees the slot"
    (let (m0 (assoc (model/ed-init (make-buffer "x" "notes.txt" "/proj/notes.txt")) :vc-proc :job-1)
          m1 (assoc m0 :vc-checking (vc-summary-key m0))
          summary {:kind :git
                   :root "/proj"
                   :branch "main"
                   :label "main"
                   :upstream nil
                   :ahead nil
                   :behind nil
                   :staged 0
                   :unstaged 1
                   :untracked 0}
          folded (vc-apply-summary m1 summary))
      (assert= summary (:vc-summary folded))
      (is (> (count (:vc-segments folded)) 0))
      (assert= (vc-label folded) "main")
      (is (nil? (:vc-proc folded)))
      (is (nil? (:vc-checking folded)))))
  (test "an answer about a buffer the reader has left is dropped, slot still freed"
    ;; the reply carries no root of its own, so without this a summary computed for one
    ;; project would paint the status bar of another
    (let (m0 (assoc (model/ed-init (make-buffer "x" "notes.txt" "/proj/notes.txt"))
               :vc-proc :job-1
               :vc-checking [nil "/somewhere-else" true])
          folded (vc-apply-summary m0 {:kind :git :root "/somewhere-else" :branch "other"}))
      (is (nil? (:vc-summary folded)))
      (is (nil? (:vc-proc folded)))))
  (test "a summary for the same key stands a while; a save or a VC command asks again"
    (let (m (model/ed-init (make-buffer "x" "notes.txt" "/proj/notes.txt"))
          key (vc-summary-key m)
          asked (assoc m :vc-summary-asked-key key :vc-summary-asked-at 1000))
      (is (vc-summary-fresh? asked key (+ 1000 (dec *vc-summary-every-ms*))))
      (is (not (vc-summary-fresh? asked key (+ 1000 *vc-summary-every-ms*))))
      ;; a save flips `modified?`, so the key differs and it is not fresh
      (is (not (vc-summary-fresh? asked (assoc key 3 true) 1001)))
      ;; a finished VC command drops the stamp (`vcproc/vc-journal-finish`)
      (is (not (vc-summary-fresh? (vcproc/vc-journal-finish asked 1 {:exit 0 :stdout "" :stderr ""})
                 key 1001)))))
  (test "a launch with one already in flight does not start a second"
    (let (m (assoc (model/ed-init (make-buffer "x" "notes.txt" "/proj/notes.txt")) :vc-proc :job-1))
      (assert= m (vc-launch-summary m))))
  (test "the window title names what the work is on, whichever VCS"
    (let (m (assoc (model/ed-init (make-buffer "x" "notes.txt" "/proj/notes.txt"))
              :vc-summary {:kind :mur :label "Fix the login page"}))
      (is (includes? (model/ed-window-title m) "Fix the login page")))))
