;; Where the OS shows through bedit's own code, in cases that run on every OS: the file URIs
;; a language server is sent and answers with, the walk up to a project's root, and URLs
;; handed to the desktop's opener. Part of the macOS / Windows smoke set
;; (tools/ci/platform-smoke.sh); `path/*windows-rules*` pins Windows's reading of a path
;; so its cases run on Linux too.
(defmodule platform-test
  (:use test)
  (:use model)
  (:use murforge)) ; mur-browse-url, *url-opener* — deferred, so loaded here for its defdyn

(purge-stale-temp "bedit-platform-")

(describe "LSP file URIs"
  (test "a path goes out encoded and comes back as itself"
    (let (path (path/join (path/temp-root) "my project/a b.rs")
          uri (or (lsp-protocol/lsp-path->uri path) (error "a path has a URI")))
      (is (string/starts-with? uri "file:///"))
      (is (includes? uri "my%20project/a%20b.rs"))
      (assert= (lsp-protocol/lsp-uri->path uri) path)))
  (test "a Windows drive path is file:///C:/…, and a server's c%3A spelling is read back"
    (binding (path/*windows-rules* true)
      (assert= (lsp-protocol/lsp-path->uri "C:\\src\\my app\\main.rs")
        "file:///C:/src/my%20app/main.rs")
      (assert= (lsp-protocol/lsp-uri->path "file:///C:/src/my%20app/main.rs")
        "C:/src/my app/main.rs")
      (assert= (lsp-protocol/lsp-uri->path "file:///c%3A/src/main.rs") "C:/src/main.rs")
      (assert= (lsp-protocol/lsp-path->uri "//server/share/x.rs") "file://server/share/x.rs")
      (assert= (lsp-protocol/lsp-uri->path "file://server/share/x.rs") "//server/share/x.rs")))
  (test "elsewhere a drive-like name is an ordinary relative segment"
    (binding (path/*windows-rules* false)
      (assert= (lsp-protocol/lsp-uri->path "file:///c%3A/x") "/c:/x")))
  (test "something that is not a file URI is left as it is"
    (assert= (lsp-protocol/lsp-uri->path "untitled:Untitled-1") "untitled:Untitled-1")))

(describe "the walk up to a project root"
  (test "a marker three levels up is found from the deepest directory"
    (let (root (temp-dir "bedit-platform-")
          _ (file/mkdir root)
          _ (file/spit (path/join root "project.blsp") "(project :name walk)")
          deep (path/join root "a" "b" "c")
          _ (file/mkdir deep))
      (assert= (projects/project-root deep) (projects/project-path root))))
  (test "with no marker the walk stops at the filesystem's top, a drive's C:/ included"
    ;; the top is its own parent — so the walk ends there, not at the depth limit
    (letrec (top (fn (dir steps)
                   (if (or (= dir (path/dirname dir)) (> steps 64))
                     [dir steps]
                     (top (path/dirname dir) (inc steps)))))
      (let ([summit steps] (top (projects/project-path (path/temp-root)) 0))
        (is (<= steps 64))
        (assert= (path/dirname summit) summit)
        (is (path/absolute? summit))))))

(describe "a URL handed to the desktop"
  (test "the opener is given the URL, and the echo says it is opening"
    (let (m (ed-init (editor/buffer/make-buffer ""))
          opened (binding (*url-opener* (fn (url) (send (self) [:opened url])))
                   (murforge/mur-browse-url m "https://brood.dev/x")))
      (assert= (:echo opened) "opening https://brood.dev/x")
      (assert= (receive ([:opened url] url) (after 1000 :nothing)) "https://brood.dev/x")))
  (test "an opener that fails is said, not raised"
    (let (m (ed-init (editor/buffer/make-buffer ""))
          refused (binding (*url-opener* (fn (url) (error "no handler for " url)))
                    (murforge/mur-browse-url m "https://brood.dev/x")))
      (is (string/starts-with? (:echo refused) "no program here opens https://brood.dev/x")))))
