;; src/vcscore.blsp — version control in the editor, whichever system the project uses: the
;; backend rows, the mode line's summary off the loop, and the C-x g / C-x v commands that
;; reach a backend through its row.
(defmodule vcscore-test
  (:use vcscore)
  (:use model)
  (:use editor/buffer) ; make-buffer
  (:use gitbar) ; git's row is registered when it loads
  (:use murbar) ; and mur's
  (:use test))

(def- fresh-dir (fn (prefix) (let (dir (temp-dir prefix)) (do (file/mkdir dir) dir))))

(describe "vc: which porcelain a checkout gets"
  (test "git and mur each have a row, with a status command and a mode line"
    (doseq (kind [:git :mur])
      (let (row (vcs-backend kind))
        (is (symbol? (:status row)))
        (is (symbol? (:summary row)))
        (is (symbol? (:chip row))))))
  (test "a checkout is found by its marker, a VC buffer's own root first"
    (let (dir (fresh-dir "bedit-vcs-mur-"))
      (file/mkdir (path/join dir ".mur"))
      (let (m (model/ed-init (make-buffer "x" "a.txt" (path/join dir "a.txt"))))
        (assert= (vcs-checkout m) {:kind :mur :root dir}))))
  (test "outside any checkout, C-x g says so rather than running anything"
    (let (dir (fresh-dir "bedit-vcs-none-"))
      (when (nil? (vcs/locate dir))
        (let (m (model/ed-init (make-buffer "x" "a.txt" (path/join dir "a.txt"))))
          (is (includes? (:echo (cmd-vcs-status m nil)) "not in a version-controlled directory"))))))
  (test "a question a backend has no answer for is said, not an error"
    (let (dir (fresh-dir "bedit-vcs-noblame-"))
      (file/mkdir (path/join dir ".mur"))
      (let (m (model/ed-init (make-buffer "x" "a.txt" (path/join dir "a.txt"))))
        (is (includes? (:echo (cmd-vcs-blame m nil)) "mur has no blame"))))))

;; ---- the mode line's summary runs OFF the loop ------------------------------------
;; A backend's summary is subprocesses (git status alone is 40 ms on a 27,310-file repo),
;; so it ran on the loop for fifty-odd milliseconds every time typing settled. These pin the
;; async shape: what travels to the task, and what happens to an answer that arrives about
;; a buffer the reader has already left.
(describe "vc: the mode line's summary, off the loop"
  (test "the key is what the loop already knows — no subprocess to compute it"
    (let (m (model/ed-init (make-buffer "x" "notes.txt" "/proj/notes.txt")))
      (assert= [nil "/proj" true false] (vcs-summary-key m))))
  (test "a fileless buffer that is not a VC buffer describes nothing"
    ;; `vcs-summary` short-circuits on the key alone, so nothing runs at all
    (let (m (model/ed-init (make-buffer "x" "*scratch*")))
      (is (not (nth (vcs-summary-key m) 2)))
      (is (nil? (vcs-summary (vcs-summary-key m))))))
  (test "an answer folds into the cached summary + segments and frees the slot"
    (let (m0 (assoc (model/ed-init (make-buffer "x" "notes.txt" "/proj/notes.txt"))
               :vcs-proc :job-1)
          m1 (assoc m0 :vcs-checking (vcs-summary-key m0))
          summary {:kind :git
                   :root "/proj"
                   :branch "main"
                   :label "main"
                   :upstream nil
                   :ahead nil
                   :behind nil
                   :staged 0
                   :unstaged 1
                   :untracked 0}
          folded (vcs-apply-summary m1 summary))
      (assert= summary (:vcs-summary folded))
      (is (> (count (:vcs-segments folded)) 0))
      (assert= (vcs-label folded) "main")
      (is (nil? (:vcs-proc folded)))
      (is (nil? (:vcs-checking folded)))))
  (test "an answer about a buffer the reader has left is dropped, slot still freed"
    ;; the reply carries no root of its own, so without this a summary computed for one
    ;; project would paint the status bar of another
    (let (m0 (assoc (model/ed-init (make-buffer "x" "notes.txt" "/proj/notes.txt"))
               :vcs-proc :job-1
               :vcs-checking [nil "/somewhere-else" true])
          folded (vcs-apply-summary m0 {:kind :git :root "/somewhere-else" :branch "other"}))
      (is (nil? (:vcs-summary folded)))
      (is (nil? (:vcs-proc folded)))))
  (test "a summary for the same key stands a while; a save or a VC command asks again"
    (let (m (model/ed-init (make-buffer "x" "notes.txt" "/proj/notes.txt"))
          key (vcs-summary-key m)
          asked (assoc m :vcs-summary-asked-key key :vcs-summary-asked-at 1000))
      (is (vcs-summary-fresh? asked key (+ 1000 (dec *vcs-summary-every-ms*))))
      (is (not (vcs-summary-fresh? asked key (+ 1000 *vcs-summary-every-ms*))))
      ;; a save flips `modified?`, so the key differs and it is not fresh
      (is (not (vcs-summary-fresh? asked (assoc key 3 true) 1001)))
      ;; a finished VC command drops the stamp (`vcsproc/vcs-journal-finish`)
      (is (not (vcs-summary-fresh? (vcsproc/vcs-journal-finish asked
                                     1
                                     {:exit 0 :stdout "" :stderr ""})
                 key 1001)))))
  (test "a launch with one already in flight does not start a second"
    (let (m (assoc (model/ed-init (make-buffer "x" "notes.txt" "/proj/notes.txt")) :vcs-proc :job-1))
      (assert= m (vcs-launch-summary m))))
  (test "the window title names what the work is on, whichever VCS"
    (let (m (assoc (model/ed-init (make-buffer "x" "notes.txt" "/proj/notes.txt"))
              :vcs-summary {:kind :mur :label "Fix the login page"}))
      (is (includes? (model/ed-window-title m) "Fix the login page")))))

(describe "vcs: every backend's chip has one shape"
  (test "git's and mur's draw as the same label and dot, clickable to C-x g, then their counts"
    (let (git (vcs-chip-segments (gitbar/git-chip {:root "/r"
                                                   :branch "main"
                                                   :staged 1
                                                   :unstaged 0
                                                   :untracked 0}))
          mur (vcs-chip-segments (murbar/mur-chip {:label "Fix it"
                                                   :changed 2
                                                   :clashes 0
                                                   :unsent 0
                                                   :unclaimed 0
                                                   :others 0
                                                   :versions 1
                                                   :state "saved"})))
      (assert= (take (map git :id) 2) (list :vcs-label :vcs-dot))
      (assert= (take (map mur :id) 2) (list :vcs-label :vcs-dot))
      (is (every? (append git mur) (fn (seg) (= (:on-click seg) 'vcscore/cmd-vcs-status))))
      (assert= (:text (nth git 2)) "+1")
      (assert= (:text (nth mur 2)) "~2")))
  (test "no chip, no segments"
    (assert= (vcs-chip-segments nil) '())))
