;; The fill-column indicator (src/fillindicator.blsp, Emacs's
;; display-fill-column-indicator-mode): a `│` at the fill column wherever a screen line leaves
;; it empty, per mode from init.blsp or toggled per buffer.
(defmodule fillindicator-test
  (:use test)
  (:use model)
  (:use editor/buffer)
  (:use-internals input)) ; ed-ensure-layers: a named buffer's modes

(defn- geometry (overrides)
  ;; a plain 40-wide pane body at the origin, no gutter: text 39 cells wide
  (into {:top 0
         :x 0
         :y 0
         :width 40
         :gutter-width 0
         :margin-width 0
         :text-height 5
         :render-height 5
         :rows nil
         :hscroll 0}
    overrides))

(defn- rule-ops (frame)
  ;; every `│` the indicator painted
  (seq/filter frame
    (fn (op)
      (and (vector? op)
        (= (first op) :text)
        (= (nth op 3 nil) fillindicator/*indicator-character*)
        (= (nth op 4 nil) fillindicator/face-fill-column-indicator)))))

(defn- with-column (m column)
  (ed-set-buf m (conventions/with-buffer-setting (ed-current-buf m) :fill-column column)))

(describe "where the rule goes"
  (test "on every line shorter than the column, at the column; not where a character stands"
    (let (buf (make-buffer "short\nthis line is longer than ten\n\nend"))
      (assert= (vec (fillindicator/indicator-cells buf (geometry {}) 10))
        [[0 10] [2 10] [3 10]])))
  (test "a line ending exactly at the column leaves it empty"
    (assert= (vec (fillindicator/indicator-cells (make-buffer "0123456789") (geometry {}) 10))
      [[0 10]]))
  (test "scrolled left, the column moves left with the text, and is gone past the left edge"
    (let (buf (make-buffer "abc\nabcdefghijklmnop"))
      (assert= (vec (fillindicator/indicator-cells buf (geometry {:hscroll 4}) 10)) [[0 6]])
      (is (empty? (fillindicator/indicator-cells buf (geometry {:hscroll 12}) 10)))))
  (test "a column past the text's right edge shows nothing"
    (is (empty? (fillindicator/indicator-cells (make-buffer "x") (geometry {:width 20}) 30))))
  (test "a wrapped line: each row measured from its own start, the rule at one x"
    ;; `aaaaaaaaaabbbbb` wrapped at 10: rows of 10 and 5 cells
    (let (buf (make-buffer "aaaaaaaaaabbbbb")
          wrapped (geometry {:rows [[0 0 10 nil] [0 10 15 nil]]}))
      (assert= (vec (fillindicator/indicator-cells buf wrapped 12)) [[0 12] [1 12]])
      (assert= (vec (fillindicator/indicator-cells buf wrapped 8)) [[1 8]])))
  (test "a truncated row (clipped) and an inlay row show none"
    (let (buf (make-buffer "aaaa\nb")
          table (geometry {:rows [[0 0 4 nil [3 "…"]] [1 0 1 :inlay] [1 0 1 nil]]}))
      (assert= (vec (fillindicator/indicator-cells buf table 10)) [[2 10]])))
  (test "a tab counts the cells it shows"
    ;; `\tx` is 9 cells at the default tab width of 8
    (let (buf (make-buffer "\tx"))
      (is (empty? (fillindicator/indicator-cells buf (geometry {}) 8)))
      (assert= (vec (fillindicator/indicator-cells buf (geometry {}) 9)) [[0 9]]))))

(describe "when it shows"
  (test "off by default: the view paints no rule"
    (is (empty? (rule-ops (view/ed-view (ed-init (make-buffer "short\n")) 60 10)))))
  (test "init.blsp's :fill-column-indicator turns it on, at the buffer's fill column"
    (let (m (assoc (with-column (ed-init (make-buffer "ab\n")) 20) :fill-column-indicator true)
          frame (view/ed-view m 60 10)
          rules (rule-ops frame)
          text-of (seq/find frame
                    (fn (op) (and (vector? op) (= (first op) :text) (= (nth op 3 nil) "ab")))))
      (is (not (empty? rules)))
      (assert= (nth (first rules) 2) (+ (nth text-of 2) 20))))
  (test "a per-mode map reaches the buffer's mode"
    (let (m (input/ed-ensure-layers (ed-init (make-buffer "x" "n.txt" "n.txt")))
          buf (ed-current-buf m))
      (is (fillindicator/shown? (assoc m :fill-column-indicator {:default false :text true}) buf))
      (is (not (fillindicator/shown? (assoc m :fill-column-indicator {:default false :prog true})
                 buf)))))
  (test "M-x display-fill-column-indicator-mode toggles this buffer, over the setting"
    (let (m (with-column (ed-init (make-buffer "short\n")) 20)
          on (fillindicator/cmd-display-fill-column-indicator-mode m nil)
          off (fillindicator/cmd-display-fill-column-indicator-mode (assoc m
                                                                      :fill-column-indicator true)
                nil))
      (is (fillindicator/shown? on (ed-current-buf on)))
      (is (not (empty? (rule-ops (view/ed-view on 60 10)))))
      (is (not (fillindicator/shown? off (ed-current-buf off))))))
  (test "the setting is checked as a per-mode switch"
    (is (empty? (config/config-warnings {:fill-column-indicator {:prog true}})))
    (is (not (empty? (config/config-warnings {:fill-column-indicator 3}))))))
