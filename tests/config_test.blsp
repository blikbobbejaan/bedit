;; The user init file — `src/config.blsp` (~/.config/bedit/init.blsp). We test
;; the pure read/ensure pieces on a *temp* path (never the real ~/.config): that a
;; `(config …)` form reads into a map, that a missing / malformed file degrades to
;; `{}` without throwing, and that `ensure-init!` writes a parseable default once and
;; doesn't clobber an existing file.

(defmodule config-test
  (:use test)
  (:use scroll) ; *long-lines* / *truncation-ellipsis* — what :long-lines sets
  (:use-internals config))

(purge-stale-temp "bedit-cfg-") ; drop fixtures a prior run left in /tmp (at load)
;; A fresh, unique init-file path under a not-yet-created temp dir.
(defn tmp-init () (str (temp-dir "bedit-cfg-") "/init.blsp"))
;; Write `src` to a fresh init-file path (creating its dir) and return the path.
(defn with-init (src)
  (let (f (tmp-init) _ (file/mkdir (path/dirname f)) _ (file/spit f src)) f))

(describe "config--read — the init file as a map"
  (test "reads a (config …) form into a map"
    (assert= (get (config/config-read (with-init "(config :fullscreen true)")) :fullscreen) true))

  (test "{} for a missing file"
    (assert= (config/config-read (tmp-init)) {}))

  (test "{} for a file that isn't a (config …) form"
    (assert= (config/config-read (with-init "(something :else 1)")) {}))

  (test "{} for unparseable garbage (never throws)"
    (assert= (config/config-read (with-init "(config :x")) {})))

(describe "*window-options* — what every bedit window opens with"
  (test "the desktop's key repeat, since bedit has none of its own (brood ADR-441)"
    (assert= (:key-repeat *window-options*) :os)
    (assert= (:app-id *window-options*) *app-id*)))

(describe "window-mode — the Emacs-style :fullscreen value"
  (test ":maximized → :maximized"
    (assert= (config/window-mode {:fullscreen :maximized}) :maximized))
  (test "true → :maximized (keeps the title bar)"
    (assert= (config/window-mode {:fullscreen true}) :maximized))
  (test ":fullboth → :fullscreen"
    (assert= (config/window-mode {:fullscreen :fullboth}) :fullscreen))
  (test ":fullscreen → :fullscreen"
    (assert= (config/window-mode {:fullscreen :fullscreen}) :fullscreen))
  (test "false → nil (a normal window)"
    (is (nil? (config/window-mode {:fullscreen false}))))
  (test "absent → nil"
    (is (nil? (config/window-mode {})))))

(describe "config-warnings — advisory feedback for the data init file"
  (test "no warning for a recognised :fullscreen value"
    (is (empty? (config-warnings {:fullscreen :maximized})))
    (is (empty? (config-warnings {:fullscreen false})))
    (is (empty? (config-warnings {})))) ; absent key → windowed, fine
  (test "an unknown :fullscreen value warns, naming the offender"
    (let (ws (config-warnings {:fullscreen :maximised}))
      ; typo
      (assert= (count ws) 1)
      (is (includes? (first ws) ":maximised"))))

  (test "no warning for a recognised :cursor value; an unknown one warns"
    (is (empty? (config-warnings {:cursor :block})))
    (is (empty? (config-warnings {:cursor :bar})))
    (is (empty? (config-warnings {}))) ; absent → defaults to :block
    (let (ws (config-warnings {:cursor :blockk}))
      ; typo
      (assert= (count ws) 1)
      (is (includes? (first ws) ":blockk"))))

  (test ":text-aa accepts the window's modes; anything else warns by name"
    (is (empty? (config-warnings {:text-aa :auto})))
    (is (empty? (config-warnings {:text-aa :subpixel})))
    (is (empty? (config-warnings {:text-aa :gray})))
    (let (ws (config-warnings {:text-aa :lcd}))
      (assert= (count ws) 1)
      (is (includes? (first ws) ":lcd"))))

  (test ":line-height accepts a number in the window's range; a typo or an absurd value warns"
    (is (empty? (config-warnings {:line-height 1.25})))
    (is (empty? (config-warnings {:line-height 2})))
    (assert= (count (config-warnings {:line-height 14})) 1) ; px, not a multiple
    (assert= (count (config-warnings {:line-height "1.4"})) 1)))

(describe "window-settings — the init file's window-side keys as gui/* calls"
  (test "absent keys ask for the window's defaults (so a reload after deleting a key restores them)"
    (assert= (window-settings {}) [[:text-aa :auto] [:line-height 1.25] [:text-contrast 1.0]]))
  (test "each recognised key maps to its call, in a fixed order"
    (assert= (window-settings {:text-aa :gray :line-height 1.3 :text-contrast 1.0})
      [[:text-aa :gray] [:line-height 1.3] [:text-contrast 1.0]]))
  (test "an invalid value falls back to the default (config-warnings reports it) rather than applied"
    (assert= (window-settings {:text-aa :lcd :line-height 1.3})
      [[:text-aa :auto] [:line-height 1.3] [:text-contrast 1.0]])
    (assert= (window-settings {:line-height 14 :text-contrast 9})
      [[:text-aa :auto] [:line-height 1.25] [:text-contrast 1.0]]))

  (test ":text-contrast accepts the window's 0.5..3.0; outside it warns and the default applies"
    (is (empty? (config-warnings {:text-contrast 1.0})))
    (is (empty? (config-warnings {:text-contrast 1.8})))
    (assert= (count (config-warnings {:text-contrast 9})) 1)
    (assert= (count (config-warnings {:text-contrast "1.4"})) 1)
    (assert= (window-settings {:text-contrast 1.8})
      [[:text-aa :auto] [:line-height 1.25] [:text-contrast 1.8]])))

(describe "apply-to-model — config → model fields (defaults + overrides)"
  (test "absent keys default: hl-line on, cursor :block"
    (let (m (apply-to-model {} {}))
      (assert= (:hl-line m) true)
      (assert= (:cursor-style m) :block)))
  (test "init values override the defaults"
    (let (m (apply-to-model {} {:hl-line false :cursor :bar}))
      (assert= (:hl-line m) false)
      (assert= (:cursor-style m) :bar))))

(describe "the settings registry — one declaration per key"
  (test "an undeclared key warns, so a typo'd key is no longer silently ignored"
    (let (ws (config-warnings {:hl-lin false}))
      (assert= (count ws) 1)
      (is (includes? (first ws) ":hl-lin"))))
  (test "every key the editor reads is declared"
    (doseq (k [:fullscreen
                :hl-line :cursor :text-aa :line-height :text-contrast :electric-pair
                :scroll-output :version-format :share-name :welcome :term-emulator])
      (is (map? (settings/spec-of *settings* k)))))
  (test "the default file names every setting, and reads back as the defaults it sets"
    (doseq (spec (settings/specs *settings*))
      (is (includes? *init-default-source* (pr-str (:name spec)))))
    (assert= {:fullscreen false :hl-line true :cursor :block :electric-pair true}
      (settings/read-form *init-default-source* 'config)))
  (test "an invalid value is never applied: the model gets the default"
    (assert= :block (:cursor-style (apply-to-model {} {:cursor :blockk})))
    (assert= true (:hl-line (apply-to-model {} {:hl-line "no"}))))
  (test "setting answers the default for an absent or invalid value"
    (assert= 1.25 (setting {} :line-height))
    (assert= 1.25 (setting {:line-height 14} :line-height))
    (assert= 1.4 (setting {:line-height 1.4} :line-height))
    (is (nil? (setting {} :share-name))))
  (test "term-emulator defaults to std/vt's :vt and reaches the model"
    (assert= :vt (:term-emulator (apply-to-model {} {})))
    (assert= :ghostty (:term-emulator (apply-to-model {} {:term-emulator :ghostty})))
    (assert= :vt (:term-emulator (apply-to-model {} {:term-emulator "ghostty"}))))
  (test "share-name seeds the participant only when set"
    (assert= "ada" (:participant (apply-to-model {} {:share-name "ada"})))
    (assert= "me" (:participant (apply-to-model {:participant "me"} {})))))

(describe "ensure-init! — the first-launch default"
  (test "writes the documented default when absent, and it parses back"
    (let (f (tmp-init) _ (ensure-init! f))
      (is (file/exists? f))
      (assert= (:fullscreen (config/config-read f)) false))) ; default is :fullscreen false
  (test "is idempotent — doesn't clobber an existing init file"
    (let (f (with-init "(config :fullscreen true)") _ (ensure-init! f))
      (assert= (:fullscreen (config/config-read f)) true))))

(describe ":long-lines / :truncation-ellipsis — how a line too long for its window shows"
  (test "a map of :default, line kinds and mode names to the three policies is clean"
    (is (empty? (config/config-warnings {:long-lines {:default :truncate
                                                      :section-heading :wrap
                                                      'markdown :scroll}}))))
  (test "a policy that is not one of the three warns, as does a value that is not a map"
    (is (not (empty? (config/config-warnings {:long-lines {'markdown :fold}}))))
    (is (not (empty? (config/config-warnings {:long-lines :truncate})))))
  (test "the default file documents both, commented out"
    (is (includes? config/*init-default-source* ";; :long-lines"))
    (is (includes? config/*init-default-source* ";; :truncation-ellipsis")))
  (test "applying the config sets the policies the row table reads, over the defaults"
    (config/apply-to-model {} {:long-lines {'markdown :truncate} :truncation-ellipsis "$"})
    (let (applied *long-lines*
          ellipsis *truncation-ellipsis*)
      ;; back to the defaults before asserting, so a failure leaves no setting behind
      (config/apply-to-model {} {})
      (assert= (get applied 'markdown) :truncate)
      (assert= (:section-heading applied) :truncate)
      (assert= ellipsis "$")
      (assert= *long-lines* *long-lines-defaults*))))
