;; tests/wrap_perf_test.blsp — what a wrap prefix costs a frame in a LARGE prose buffer, timed.
;;
;; Runs only where BEDIT_PERF_CHECK=1 is set — CI's `real-window-linux` job sets it — and never
;; on a desktop run: timing belongs on a machine nobody is working on. Elsewhere every test
;; here passes without doing anything.
;;
;; A generated ~20k-line Markdown file of deep lists, nested quotes and long wrapped lines is
;; opened under each wrap-prefix style (`:adaptive`, which reads each line's fill prefix,
;; and `:indent`), then scrolled — page by page from the top, a jump to the end and back up,
;; a jump to the middle — rendering a frame (`ed-update` + `ed-view`) at each stop. Each style
;; prints its timings and fails over a GENEROUS budget: this catches a frame that walks the
;; whole buffer (seconds), not a few milliseconds of drift.
(defmodule wrap-perf-test
  (:use test)
  (:use model)
  (:use input)
  (:use view)
  (:use scroll)
  (:use editor/buffer))

(def- *on?* (= (os/env "BEDIT_PERF_CHECK") "1"))

(def- *line-count* 20000)

(def- *columns* 100)

(def- *rows* 40)

;; a frame slower than this is a frame that walks far more than the screen
(def- *frame-budget-ms* 1500)

;; the mean over every frame of a style's run
(def- *mean-budget-ms* 250)

(def- *words*
  "the quick brown fox jumps over the lazy dog while a wrapped line keeps its prefix on every row it takes")

(defn- line-of (index)
  "Line `index` of the generated document: a cycle of the shapes a wrap prefix reads."
  (let (text (str *words* " " index " " *words*))
    (case (math/mod index 8)
      0 (str "# Heading " index)
      1 (str "- " text)
      2 (str "  - " text)
      3 (str "      - " text)
      4 (str "> " text)
      5 (str "> > > " text)
      6 (str "12. " text)
      text)))

(defn- document ()
  (string/join (map (range *line-count*) line-of) "\n"))

(defn- frame (m input)
  "`m` after `input`, and the frame it paints; `[m' ms]`."
  (let (start (os/now)
        next (ed-update m input *columns* *rows*)
        _ (ed-view next *columns* *rows*))
    [next (- (os/now) start)]))

(defn- run-frames (m inputs)
  "Every input folded and painted in turn: the frame times, in order."
  (second (fold inputs
            [m []]
            (fn (state input)
              (let ([current times] state
                    [next ms] (frame current input))
                [next (conj times ms)])))))

(defn- scroll-inputs ()
  ;; 40 pages down, the end, 20 pages up, the top
  (append (map (range 40) (fn (_) :ctrl-v)) [:alt->] (map (range 20) (fn (_) :alt-v)) [:alt-<]))

(defn- time-style (style)
  "The frame times of the scroll under wrap-prefix `style`, printed; `{:max :mean :total}`."
  (binding (*wrap-prefix* style)
    (let (opened (os/now)
          m (ed-init (make-buffer (document) "big.md" "big.md"))
          first-paint (second (frame m :ctrl-l))
          open-ms (- (os/now) opened)
          middle (ed-set-buf m
                   (goto-char (ed-current-buf m) (math/quot (buffer-length (ed-current-buf m)) 2)))
          times (into (run-frames m (scroll-inputs)) [(second (frame middle :ctrl-l))])
          labels (into (vec (map (scroll-inputs) str)) [":ctrl-l at the middle"])
          slowest (take (reverse (seq/sort-by (seq/zip times (range (count times))) first)) 3)
          total (reduce times 0 +)
          worst (reduce times 0 math/max)
          mean (/ (* 1.0 total) (count times)))
      (do
        (io/puts (string/interp "wrap-perf {style}: open + first frame {open-ms} ms (frame {first-paint} ms); {(count times)} frames, total {total} ms, mean {(math/->fixed mean 1)} ms, worst {worst} ms"))
        (io/puts (str "wrap-perf "
                   style
                   ": slowest "
                   (string/join (map slowest
                                  (fn ([ms index])
                                    (str (nth labels index) " (frame " index ") " ms " ms")))
                     ", ")))
        {:max worst :mean mean :total total}))))

(describe "a wrap prefix in a 20k-line Markdown buffer (BEDIT_PERF_CHECK=1 only)"
  (test "adaptive: every frame within budget"
    (when *on?*
      (let (result (time-style :adaptive))
        (is (< (:max result) *frame-budget-ms*))
        (is (< (:mean result) *mean-budget-ms*)))))
  (test "indent: every frame within budget"
    (when *on?*
      (let (result (time-style :indent))
        (is (< (:max result) *frame-budget-ms*))
        (is (< (:mean result) *mean-budget-ms*))))))
