;; Directory-local settings (src/dirlocals.blsp): a project's `.bedit-locals.blsp` sets the
;; settings declared safe for the files under it, between the file's .editorconfig and the
;; user's init.blsp; anything else is refused and said.
(defmodule dirlocals-test
  (:use test)
  (:use model)
  (:use pool) ; ed-find-file — a real visit, through the visit steps
  (:use editor/buffer)
  (:use conventions) ; *user-settings*, bound per test
  (:use dirlocals)
  (:use config :only [*settings*])) ; the setting declarations the file is checked against

(purge-stale-temp "bedit-dirlocals-")

(defn- project (locals &optional (editorconfig nil))
  ;; a scratch project holding `locals` as its .bedit-locals.blsp (and an .editorconfig), and
  ;; a file two directories down; answers the file's path
  (let (dir (temp-dir "bedit-dirlocals-")
        sub (path/join dir "src" "deep"))
    (file/mkdir sub)
    (file/spit (path/join dir ".bedit-locals.blsp") locals)
    (when editorconfig (file/spit (path/join dir ".editorconfig") editorconfig))
    (let (file (path/join sub "notes.txt")) (do (file/spit file "text\n") file))))

(defn- visit (file) (ed-find-file (ed-init (make-buffer "")) file))

(describe "the file that applies"
  (test "the nearest one above the file, else none"
    (let (there #{"/p/.bedit-locals.blsp" "/p/src/.bedit-locals.blsp"})
      (assert= "/p/src/.bedit-locals.blsp"
        (file-for "/p/src/a/b.txt" (fn (path) (contains? there path))))
      (assert= "/p/.bedit-locals.blsp" (file-for "/p/lib/c.txt" (fn (path) (contains? there path))))
      (assert= nil (file-for "/q/d.txt" (fn (path) (contains? there path))))))

  (test "only a safe setting with a valid value is kept, every other said"
    (let ([kept refused] (sift {:fill-column 100
                                :indent-width {'python 4}
                                :keys {"C-c x" 'find-file}
                                :tab-width "wide"
                                :no-such-setting 1}
                           "/p/.bedit-locals.blsp"))
      (assert= {:fill-column 100 :indent-width {'python 4}} kept)
      (assert= 3 (count refused))
      (is (any? refused (fn (line) (includes? line ":keys is not safe"))))
      (is (any? refused (fn (line) (includes? line ":tab-width wants"))))
      (is (any? refused (fn (line) (includes? line ":no-such-setting is no setting")))))))

(describe "a visited file takes them"
  (test "a bare value and a mode's entry, said as the source"
    (let (file (project "(dir-locals :fill-column 100 :indent-width {text 3})")
          buf (ed-current-buf (visit file)))
      (assert= 100 (conventions/fill-column buf))
      (assert= 3 (conventions/indent-width buf))
      (assert= :dir-locals (conventions/source buf :fill-column))
      (is (includes? (conventions/summary buf) "fill 100 (.bedit-locals.blsp)"))))

  (test "over init.blsp's entry for the mode, under the file's .editorconfig"
    (let (file (project
                 "(dir-locals :fill-column 100 :tab-width 3)"
                   "root = true\n[*]\nmax_line_length = 120\n")
          buf (binding (*user-settings* {:tab-width {'text 6}}) (ed-current-buf (visit file))))
      (assert= 120 (conventions/fill-column buf))
      (binding (*user-settings* {:tab-width {'text 6}}) (assert= 3 (conventions/tab-width buf)))))

  (test "a refused setting is said when the file opens, and the rest still apply"
    (let (file (project "(dir-locals :fill-column 90 :theme \"Latte\")")
          opened (visit file))
      (assert= 90 (conventions/fill-column (ed-current-buf opened)))
      (is (includes? (:echo opened) ":theme is not safe to set from a directory file"))))

  (test "a display switch reads it too"
    (let (file (project "(dir-locals :show-whitespace true :line-numbers :relative)")
          buf (ed-current-buf (visit file)))
      (assert= :relative (scroll/ed-line-numbers-for buf))
      (assert= true (scroll/ed-local-setting :show-whitespace false buf false))))

  (test "C-h v says the buffer's value came from the directory file"
    (let (file (project "(dir-locals :fill-column 100)")
          m (visit file)
          text (help/describe-setting-text m
                 (settings/spec-of *settings* :fill-column)
                 {}
                 {}))
      (is (includes? text "This buffer"))
      (is (includes? text ".bedit-locals.blsp, over init.blsp")))))
