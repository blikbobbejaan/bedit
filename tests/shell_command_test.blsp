;; M-! / M-| and C-g: the command runs off the loop, and C-g stops it — the task AND the OS
;; command it is waiting on (brood ADR-514), not only the slot.
;;
;; Coverage:
;;   - C-g on a running M-! frees its slot, says it stopped, and the shell's process is gone
;;   - a command that finishes is folded as before

(defmodule shell-command-test
  (:use test)
  (:use model)
  (:use input) ; ed-update — a reply through the loop's own update
  (:use editor/buffer))

(defn- sc-live (thunk)
  "Run `thunk` as the live loop would: the task's reply comes to this process."
  (binding (editor/ui/*loop* (self)) (thunk)))

(defn- sc-await (ready? what)
  "Wait for `ready?` to hold — a state of the OS another process changes, so there is no
message to receive — trying every 20 ms for up to ten seconds."
  (letrec (try-again (fn (left)
                       (cond
                         (ready?) true
                         (<= left 0) (error "sc-await: never " what)
                         else (receive (after 20 (try-again (dec left)))))))
    (try-again 500)))

(defn- sc-alive? (pid)
  "Whether OS process `pid` is still running."
  (= 0 (:exit (os/cmd "kill" ["-0" pid]))))

(describe "M-! and C-g"
  (test "C-g stops a running shell command — its process too — and frees the slot"
    (let (dir (path/temp "bedit-shell-command-test-")
          _ (file/mkdir dir)
          pid-file (path/join dir "pid")
          m (ed-init (make-buffer ""))
          running (sc-live (fn ()
                             (shell-command/ed-shell-launch m
                               (str "echo $$ > " (os/shell-quote pid-file) "; exec sleep 60")
                               nil
                               (fn (mm _r) (message mm "finished")))))
          _ (sc-await (fn ()
                        (and (file/exists? pid-file)
                          (not (= "" (string/trim (file/slurp pid-file))))))
              "wrote its pid")
          pid (string/trim (file/slurp pid-file))
          alive-before? (sc-alive? pid)
          quit (sc-live (fn () (commands/cmd-keyboard-quit running nil))))
      (is alive-before?)
      ;; C-g says what it stopped, after its own word — a hook's message is not overwritten
      (is (nil? (:shell-proc quit)))
      (is (string/starts-with? (:echo quit) "quit — echo $$ > "))
      (is (string/ends-with? (:echo quit) "exec sleep 60 stopped"))
      ;; the command itself, not just the task, is gone
      (sc-await (fn () (not (sc-alive? pid))) "was killed")))
  (test "a command that finishes is folded through its continuation"
    (let (m (ed-init (make-buffer ""))
          running (sc-live (fn ()
                             (shell-command/ed-shell-launch m
                               "echo hi"
                               nil
                               (fn (mm r) (message mm (str "said " (string/trim (:stdout r))))))))
          handle (:shell-proc running)
          event (receive
                  ([:task-done ^handle value] [:task-done handle value])
                  (after 20000 (error "the shell command never answered")))
          landed (sc-live (fn () (ed-update running event 80 24))))
      (assert= (:echo landed) "said hi")
      (is (nil? (:shell-proc landed))))))
