;; The user's hooks as data (src/hooks.blsp): init.blsp's `:hooks` names commands to run after
;; a save lands and when a buffer is first current in a mode — in order, a failing one said
;; and the rest still run.
(defmodule hooks-test
  (:use test)
  (:use model)
  (:use input) ; ed-update — an event, which runs the post-steps
  (:use pool) ; ed-find-file
  (:use file-save) ; ed-save-buf-at
  (:use interactive) ; defcommand — a command that fails
  (:use hooks)
  (:use main :only []) ; the released image: every row loaded
  (:use editor/layers :only [init-buffer-layers set-buffer-type])
  (:use editor/buffer))

(purge-stale-temp "bedit-hooks-")

(defcommand cmd-hooks-test-boom
  (m key)
  "Fail, as a broken hook command would."
  (error "boom"))

(defn- fixture-file (name text)
  (let (dir (temp-dir "bedit-hooks-")
        _ (file/mkdir dir)
        path (path/join dir name))
    (do (file/spit path text) path)))

(defn- with-hooks (m hooks) (config/apply-to-model m {:hooks hooks}))
(defn- text (m) (buffer-text (ed-current-buf m)))

(describe "the setting"
  (test "the shape it takes"
    (is (config/hooks-valid? {:after-save ['format-buffer "delete-trailing-whitespace"]
                              :mode {'rust ['format-buffer] :prog []}}))
    (is (not (config/hooks-valid? {:before-save ['format-buffer]})))
    (is (not (config/hooks-valid? {:after-save 'format-buffer})))
    (is (not (config/hooks-valid? {:mode {'rust [42]}})))))

(describe "running a hook's commands"
  (test "in order; one that is none, or fails, is said and the rest still run"
    (let (m (run-commands (ed-init (make-buffer "a  \n"))
              ['no-such-command-here 'hooks-test-boom 'delete-trailing-whitespace]
              "after-save hook"))
      (assert= "a\n" (text m))
      (do
        (assert= "trailing whitespace deleted" (:echo m)))))

  (test "a failing command leaves the model as it was before it"
    (let (m (run-commands (ed-init (make-buffer "x")) ['hooks-test-boom] "after-save hook"))
      (is (includes? (:echo m) "after-save hook: hooks-test-boom failed: boom")))))

(describe ":after-save"
  (test "runs once the save lands, with the saved buffer current"
    (let (path (fixture-file "notes.txt" "a\n")
          m (with-hooks (ed-find-file (ed-init (make-buffer "")) path)
              {:after-save ['delete-trailing-whitespace]})
          edited (ed-edit m (fn (b) (replace-region b 0 0 "x   \n")))
          saved (ed-save-buf-at edited (ed-current-index edited)))
      (assert= "x   \na\n" (file/slurp path))
      (assert= "x\na\n" (text saved))))

  (test "a buffer saved while another is current is made current for it, then put back"
    (let (first-path (fixture-file "one.txt" "one   \n")
          second-path (fixture-file "two.txt" "two   \n")
          opened (ed-find-file (ed-find-file (ed-init (make-buffer "")) first-path) second-path)
          m (with-hooks opened {:after-save ['delete-trailing-whitespace]})
          first-index (or (ed-buffer-index-by-file m first-path) (error "not open: " first-path))
          shown (ed-current-index m)
          edited (ed-set-buf-at m first-index (replace-region (ed-buf-at m first-index) 0 0 "1"))
          saved (ed-save-buf-at edited first-index))
      (assert= shown (ed-current-index saved))
      (assert= "two   \n" (text saved))
      (assert= "1one\n" (buffer-text (ed-buf-at saved first-index)))))

  (test "no hooks, no change"
    (let (path (fixture-file "notes.txt" "a  \n")
          m (ed-find-file (ed-init (make-buffer "")) path)
          saved (ed-save-buf-at (ed-edit m (fn (b) (replace-region b 0 0 "b")))
                  (ed-current-index m)))
      (assert= "ba  \n" (text saved)))))

(describe ":mode"
  (test "the most general mode's commands first"
    (let (buf (init-buffer-layers (set-buffer-type (make-buffer "") :markdown)))
      (assert= ['a 'b] (mode-commands {'markdown-mode ['b] :text ['a] 'rust ['c]} buf))))

  (test "run once when a buffer is first current in the mode, not on every event"
    (let (m (with-hooks (ed-init (init-buffer-layers (set-buffer-type (make-buffer "# a\n")
                                                       :markdown)))
              {:mode {'markdown ['auto-fill-mode]}})
          once (ed-update m :ctrl-f 80 24)
          twice (ed-update once :ctrl-f 80 24))
      (assert= true (:auto-fill (ed-current-buf once)))
      ;; a second run would have toggled it off again
      (assert= true (:auto-fill (ed-current-buf twice)))))

  (test "a buffer in another mode runs none"
    (let (m (with-hooks (ed-init (make-buffer "a\n")) {:mode {'markdown ['auto-fill-mode]}})
          after (ed-update m :ctrl-f 80 24))
      (assert= nil (:auto-fill (ed-current-buf after))))))
