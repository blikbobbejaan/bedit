;; Tabs (src/tabbar.blsp), Emacs's tab-bar-mode: each tab a window layout of its own, the row
;; at the top listing them. The tests drive real keys and clicks through `input/ed-update`.
(defmodule tabbar-test
  (:use test)
  (:use model)
  (:use editor/buffer)
  (:use editor/pane)
  (:use panes)
  (:use tabbar))

(defn- keys (m pressed) (fold pressed m (fn (acc key) (input/ed-update acc key 80 24))))

(defn- typed (m text) (keys m (map (string/->list text) str)))

(defn- two-buffers ()
  ;; A shown, B open behind it
  (let (m (ed-init (make-buffer "alpha\nbeta" "A")))
    (pool/ed-switch-to-named (pool/ed-open-buffer m (make-buffer "one\ntwo" "B")) "A")))

(defn- shown (m)
  ;; the buffer names the windows show, in tree order
  (vec (map (pane-leaf-paths (:layout m))
         (fn (path) (buffer-name (ed-buf-at m (:buffer (pane-payload-at (:layout m) path))))))))

(defn- texts (ops row)
  (map (seq/filter ops (fn (op) (and (vector? op) (= (first op) :text) (= (nth op 1) row))))
    (fn (op) (nth op 3))))

(describe "making and leaving tabs"
  (test "one tab and no bar to begin with"
    (let (m (two-buffers))
      (assert= (count (tabs m)) 1)
      (assert= (ed-tab-bar-rows m) 0)
      (assert= (second (:rect (first (:panes (ed-body-layout m 80 24))))) 0)))

  (test "C-x t 2 opens a tab on a copy of the layout, and the bar takes the top row"
    (let (m (keys (two-buffers) [:ctrl-x "3"])
          tabbed (keys m [:ctrl-x "t" "2"]))
      (assert= (count (tabs tabbed)) 2)
      (assert= (current-tab tabbed) 1)
      (assert= (shown tabbed) (shown m))
      (assert= (ed-tab-bar-rows tabbed) 1)
      (assert= (second (:rect (first (:panes (ed-body-layout tabbed 80 24))))) 1)))

  (test "each tab keeps its own layout and buffers"
    ;; tab 0: A split beside A; tab 1: B alone
    (let (m (keys (two-buffers) [:ctrl-x "3"])
          second-tab (keys m [:ctrl-x "t" "2" :ctrl-x "1"])
          second-tab (pool/ed-switch-to-named second-tab "B")
          back (keys second-tab [:ctrl-x "t" "o"]))
      (assert= (current-tab back) 0)
      (assert= (shown back) ["A" "A"])
      (assert= (tab-name back 1) "B")
      (let (again (keys back [:ctrl-x "t" "o"]))
        (assert= (current-tab again) 1)
        (assert= (shown again) ["B"]))
      ;; and backwards, wrapping round
      (assert= (current-tab (keys back [:ctrl-x "t" "O"])) 1)))

  (test "C-x t 0 closes the tab shown and shows its neighbour; one tab hides the bar"
    (let (m (keys (two-buffers) [:ctrl-x "t" "2"])
          m (pool/ed-switch-to-named m "B")
          m (keys m [:ctrl-x "t" "o"])
          closed (keys m [:ctrl-x "t" "0"]))
      (assert= (count (tabs closed)) 1)
      (assert= (shown closed) ["B"])
      (assert= (ed-tab-bar-rows closed) 0)))

  (test "C-<tab> / C-S-<tab> go to the next / previous tab, and help spells them so"
    ;; the keys as brood's frontends deliver Ctrl+Tab and Ctrl+Shift+Tab; std spells them
    ;; `C-tab` / `C-S-tab` (as `C-left`), and reads Emacs's `C-<tab>` too
    (let (m (keys (two-buffers) [:ctrl-x "t" "2" :ctrl-x "t" "2"])
          km (keymaps/profile-keymap :emacs))
      (assert= (current-tab m) 2)
      (assert= (current-tab (keys m [:ctrl-tab])) 0)
      (assert= (current-tab (keys m [:ctrl-shift-tab])) 1)
      (assert= (keyhelp/ed-where-is km 'tabbar/cmd-tab-next) "C-tab")
      (assert= (keyhelp/ed-where-is km 'tabbar/cmd-tab-previous) "C-S-tab")
      (assert= (editor/keymap/key-parse "C-S-<tab>") [:ctrl-shift-tab])
      (assert= (editor/keymap/key-parse "C-tab") [:ctrl-tab])))

  (test "the only tab is never closed"
    (let (m (keys (two-buffers) [:ctrl-x "t" "0"]))
      (assert= (count (tabs m)) 1)
      (is (includes? (:echo m) "sole tab"))))

  (test "the init file's :tab-bar shows the row with one tab"
    (assert= (ed-tab-bar-rows (assoc (two-buffers) :tab-bar true)) 1)))

(describe "naming and finding tabs"
  (test "a tab is named after its selected window's buffer"
    (let (m (pool/ed-switch-to-named (keys (two-buffers) [:ctrl-x "t" "2"]) "B"))
      (assert= (tab-name m 0) "A")
      (assert= (tab-name m 1) "B")))

  (test "C-x t r names the tab; an empty name gives the buffer's back"
    (let (m (keys (two-buffers) [:ctrl-x "t" "2" :ctrl-x "t" "r"])
          named (keys (typed m "work") [:enter]))
      (assert= (tab-name named 1) "work")
      (assert= (tab-name (keys named [:ctrl-x "t" "r" :enter]) 1) "A")))

  (test "C-x t RET switches by name, and a new name makes a tab of it"
    (let (m (keys (two-buffers) [:ctrl-x "t" "2" :ctrl-x "t" "r"])
          m (keys (typed m "work") [:enter])
          m (keys m [:ctrl-x "t" "o"])
          found (keys (typed (keys m [:ctrl-x "t" :enter]) "work") [:enter]))
      (assert= (current-tab found) 1)
      (let (made (keys (typed (keys found [:ctrl-x "t" :enter]) "fresh") [:enter]))
        (assert= (count (tabs made)) 3)
        (assert= (tab-name made (current-tab made)) "fresh"))))

  (test "C-x t b shows a buffer in a new tab of one window"
    (let (m (keys (two-buffers) [:ctrl-x "3"])
          opened (keys (typed (keys m [:ctrl-x "t" "b"]) "B") [:enter]))
      (assert= (count (tabs opened)) 2)
      (assert= (shown opened) ["B"])
      (assert= (shown (keys opened [:ctrl-x "t" "o"])) ["A" "A"])))

  (test "C-x t f opens a file in a new tab"
    (let (dir (temp-dir "bedit-tabbar-")
          _ (file/mkdir dir)
          path (path/join dir "c.txt")
          _ (file/spit path "c\n")
          m (two-buffers)
          opened (find-file-other-tab m path))
      (assert= (count (tabs opened)) 2)
      (assert= (buffer-file (ed-current-buf opened)) path)
      (assert= (shown (keys opened [:ctrl-x "t" "o"])) ["A"]))))

(describe "what a kept tab follows"
  (test "a buffer killed while its tab is away: the tab shows another, the rest keep theirs"
    ;; tab 0 shows A beside B; tab 1 shows B; kill A from tab 1
    (let (m (keys (two-buffers) [:ctrl-x "3"])
          m (keys m [:ctrl-x "o"])
          m (pool/ed-switch-to-named m "B")
          m (keys m [:ctrl-x "t" "2" :ctrl-x "1"])
          killed (pool/ed-kill-at m (ed-buffer-index-by-name! m "A") false)
          back (keys killed [:ctrl-x "t" "o"]))
      (assert= (shown back) ["B" "B"])))

  (test "winner's history is the tab's own: switching tabs is not a layout change"
    (let (m (keys (assoc (two-buffers) :winner-on true) [:ctrl-n :ctrl-x "3"])
          undo-count (count (or (:winner-undo m) '()))
          m (keys m [:ctrl-x "t" "2" :ctrl-x "1" :ctrl-x "t" "o"]))
      (assert= (count (or (:winner-undo m) '())) undo-count)
      (assert= (shown m) ["A" "A"]))))

(describe "the row"
  (test "the view paints every tab's name on row 0, the text from row 1"
    ;; through the keys, so the frame's cached layout (`:_lc`) is the one the switch left
    (let (m (keys (typed (keys (two-buffers) [:ctrl-x "t" "2" :ctrl-x "b"]) "B") [:enter])
          row (texts (view/ed-view m 80 24) 0))
      (is (includes? row "A"))
      (is (includes? row "B"))
      (is (any? (texts (view/ed-view m 80 24) 1) (fn (t) (includes? t "one"))))))

  (test "a click on a tab shows it; a click on its × closes it"
    (let (m (keys (two-buffers) [:ctrl-x "t" "2"])
          zones (:zones (tab-bar-widget m 80))
          first-tab (seq/find zones (fn (z) (= (:id z) [:tab 0])))
          first-close (seq/find zones (fn (z) (= (:id z) [:close 0])))
          [tab-x _ _ _] (:rect first-tab)
          [close-x _ _ _] (:rect first-close)
          clicked (input/ed-update m [:mouse :press :left 0 tab-x] 80 24))
      (assert= (current-tab clicked) 0)
      (let (closed (input/ed-update m [:mouse :press :left 0 close-x] 80 24))
        (assert= (count (tabs closed)) 1)
        (assert= (ed-tab-bar-rows closed) 0))))

  (test "a click under the bar lands on the text, the bar's row taken into account"
    (let (m (keys (two-buffers) [:ctrl-x "t" "2"])
          clicked (input/ed-update m [:mouse :press :left 2 6] 80 24))
      (assert= (buffer-current-line (ed-current-buf clicked)) 1))))
