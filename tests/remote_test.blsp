;; Slice 1 — bedit served as a daemon (the emacsclient / --daemon model, ADR-090).
;; The daemon runs the REAL editor (ed-init model + ed-view + ed-update); a thin client
;; paints pushed frames and ships back keys. Here the test process plays the client
;; in-process (local pids send/receive exactly as a node link would — "the network is
;; just a longer copy"), so the full serve → frame → key → frame path is exercised with
;; the actual editor, no node and no window. Uses only the frontend-agnostic daemon seam
;; (serve--manager + remote-display), so it runs on the installed nest; the GUI client
;; (ed-attach / attach-display) is verified live — see docs/remote-multiplayer-plan.md.
(defmodule remote-test
  (:use model)
  (:use-internals view)
  (:use input)
  (:use-internals remote)
  (:use collab)
  (:use-internals editor/serve)
  (:use editor/buffer)
  (:use test))

;; The strings of a frame's [:text row col s …] ops — the editor renders many op kinds
;; (rects, cursor, dividers); we only want the painted text to look for buffer content.
(defn r-frame-strings (f)
  (map (seq/filter f (fn (op) (and (vector? op) (= (first op) :text)))) (fn (op) (nth op 3 ""))))

(defn r-frame-has? (f sub)
  (> (count (seq/filter (r-frame-strings f) (fn (s) (includes? s sub)))) 0))

;; A make-model producing a fresh EMPTY editor buffer per session, so typed text is the
;; only buffer content and easy to find in the rendered frame.
(defn r-empty-model () (fn () (ed-init (make-buffer ""))))

;; Drain every queued frame, returning the last (the one the final key produced).
(defn r-drain-frames (acc)
  (receive ([:frame f] (r-drain-frames f)) (after 300 acc)))

(describe "remote — bedit served as a daemon (Slice 1)"
  (test "ed-serve-model builds a fresh editor model on the served-welcome scratch buffer"
    (let (m ((ed-serve-model nil)))
      (is (map? m))
      (is (includes? (buffer-text (ed-current-buf m)) "served over a Brood node link"))))

  (test "ed-serve-model opens a given file into the session buffer"
    (let (m ((ed-serve-model "src/remote.blsp")))
      (is (includes? (buffer-text (ed-current-buf m)) "defmodule remote"))))

  (test "a served session renders the real editor and folds shipped keys through ed-update"
    (let (mgr (spawn (editor/serve/serve-manager (r-empty-model) ed-view ed-update)))
      (send mgr [:attach (self) 80 24])
      (let (session (receive ([:attached s] s) (after 2000 :no-attach)))
        (is (not (= session :no-attach)))
        ;; the fresh (empty) editor renders immediately — a non-empty render-op list
        (let (f0 (receive ([:frame f] f) (after 2000 :none)))
          (is (not (= f0 :none)))
          (is (> (count f0) 0)))
        ;; ship a distinctive string; the session folds each key via the real ed-update and
        ;; re-renders via the real ed-view, so the final frame shows it in the buffer area
        (doseq (k (string/->list "Zq7"))
          (send session [:key k]))
        (let (last-frame (r-drain-frames :none))
          (is (not (= last-frame :none)))
          (is (r-frame-has? last-frame "Zq7"))))))

  (test "CLI arg parsing: --serve / --attach detection and the token after a flag"
    (is (remote-serve? ["bedit" "--name" "ed" "--serve"]))
    (is (remote-attach? ["bedit" "--attach" "ed"]))
    (is (not (remote-serve? ["bedit" "notes.txt"])))
    (is (not (remote-attach? ["bedit" "--serve"])))
    (assert= (remote/remote-arg-after ["bedit" "--attach" "ed"] "--attach") "ed")
    (assert= (remote/remote-arg-after ["bedit" "--serve" "f.txt"] "--serve") "f.txt")
    (is (nil? (remote/remote-arg-after ["bedit" "--serve"] "--serve"))) ; flag is last -> nil
    (is (nil? (remote/remote-arg-after ["bedit" "x"] "--attach"))) ; flag absent -> nil
    ;; --shared modifies --serve to a collaborative session
    (is (remote-shared? ["bedit" "--name" "ed" "--serve" "--shared"]))
    (is (not (remote-shared? ["bedit" "--serve"])))
    ;; --shared (alias --collab) is THE collaborative mode: shared content, own cursors
    (is (remote-shared? ["bedit" "--name" "ed" "--serve" "--collab"]))
    (is (remote-shared? ["bedit" "--name" "ed" "--serve" "--shared"]))
    (is (not (remote-shared? ["bedit" "--serve"])))
    ;; --as NAME is the participant identity; its value is never the filename
    (assert= (remote/remote-participant ["bedit" "--attach" "ed" "--as" "alice"]) "alice")
    (assert= (remote/remote-positional ["--attach" "ed" "--as" "alice"]) nil)
    (assert= (remote/remote-positional ["--serve" "--collab" "--as" "bob" "n.txt"]) "n.txt")
    ;; --headless opts out of the host window (a pure background daemon)
    (is (remote-headless? ["bedit" "--serve" "--headless"]))
    (is (not (remote-headless? ["bedit" "--serve"])))
    ;; --listen binds TCP: a bare port binds LOOPBACK (reaching it from elsewhere is spelled
    ;; 0.0.0.0:PORT on purpose), host:port passes through, value skipped
    (assert= (remote/remote-listen-addr ["--serve" "--listen" "7457"]) "127.0.0.1:7457")
    (assert= (remote/remote-listen-addr ["--serve" "--listen" "0.0.0.0:7457"]) "0.0.0.0:7457")
    (assert= (remote/remote-listen-addr ["--serve" "--listen" "192.168.1.7:7457"])
      "192.168.1.7:7457")
    (is (nil? (remote/remote-listen-addr ["--serve"])))
    (assert= (remote/remote-positional ["--serve" "--shared" "--listen" "7457" "n.txt"]) "n.txt"))

  ;; ADR-415: a TCP session hands out guest cookies, one per --invite name
  (test "--invite names the people a session mints a bound cookie for; --cookie is a value"
    (assert= (remote/remote-invites ["--serve" "--listen" "7457" "--invite" "alice, bob"])
      ["alice" "bob"])
    (assert= (remote/remote-invites ["--serve"]) [])
    (assert= (remote/remote-positional ["--attach" "ed@h:1" "--cookie" "c0ffee" "n.txt"]) "n.txt")
    (assert= (remote/remote-positional ["--serve" "--invite" "alice" "n.txt"]) "n.txt"))

  (test "remote-positional: the file arg, skipping flags AND flag-values (the --shared bug)"
    ;; a bare --serve/--shared must NEVER be taken as a filename, and --name's value is skipped
    (is (nil? (remote/remote-positional ["--name" "ed" "--serve" "--shared"])))
    (is (nil? (remote/remote-positional ["--name" "ed" "--serve"])))
    (assert= (remote/remote-positional ["--name" "ed" "--serve" "--shared" "notes.txt"])
      "notes.txt")
    (assert= (remote/remote-positional ["--name" "ed" "--serve" "--collab" "notes.txt"])
      "notes.txt")
    (assert= (remote/remote-positional ["--name" "ed" "--serve" "notes.txt"]) "notes.txt")
    (assert= (remote/remote-positional ["--serve" "a.txt"]) "a.txt")
    (assert= (remote/remote-positional ["notes.txt"]) "notes.txt") ; the normal `bedit notes.txt`
    (is (nil? (remote/remote-positional []))))

  (test "a served editor session quits cleanly on C-x C-c (the quit chord)"
    (let (mgr (spawn (editor/serve/serve-manager (r-empty-model) ed-view ed-update)))
      (send mgr [:attach (self) 80 24])
      (let (session (receive ([:attached s] s) (after 2000 :no-attach)))
        (monitor session)
        (receive ([:frame _] nil) (after 2000 nil)) ; consume the initial frame
        ;; C-x C-c is the editor's quit; ui-run then runs :leave -> [:bye] to the client
        (send session [:key :ctrl-x])
        (send session [:key (keyword "ctrl-c")])
        (assert= (receive ([:bye] :bye) ([:down _ _ _] :bye) (after 2000 :no-quit)) :bye)))))

;; ---- --serve --collab: shared content, a cursor per client (the live wiring) ----
;; collab_test proves the model layer (splice / share / fold) headlessly; these tests
;; prove the LIVE wiring around it: the session's make-model subscribes, the daemon-side
;; display's :poll passes the process's [:buffer-updated …] push through to the real
;; ed-update (whose registry folds it), and ed-update propagates a typed key's
;; edit back to the process. Two relay clients play two participants in-process.

;; A relay client: attach to `mgr`, announce, then forward every frame to `report`
;; (tagged with our pid) and ship any [:press k] from the test as a keystroke.
(defn rc-loop (session report)
  (receive
    ([:frame f] (do (send report [:rc-frame (self) f]) (rc-loop session report)))
    ([:press k] (do (send session [:key k]) (rc-loop session report)))
    ([:bye] nil)))

(defn rc-client (mgr report)
  (send mgr [:attach (self) 80 24])
  (receive
    ([:attached s] (do (send report [:rc-ready (self)]) (rc-loop s report)))
    (after 2000 (send report [:rc-ready :no-attach]))))

;; As rc-client, but attaching WITH an identity opts map (the 5-element handshake).
(defn rc-client-as (mgr report opts)
  (send mgr [:attach (self) 80 24 opts])
  (receive
    ([:attached s] (do (send report [:rc-ready (self)]) (rc-loop s report)))
    (after 2000 (send report [:rc-ready :no-attach]))))

;; Receive client `cid`'s frames until one paints `sub` (skipping earlier frames), or time out.
(defn rc-await-frame (cid sub)
  (receive
    ([:rc-frame ^cid f] (if (r-frame-has? f sub) :ok (rc-await-frame cid sub)))
    (after 3000 :timeout)))

;; Poll the buffer process until its text is `want` (the async splice needs a beat to land).
(defn rc-await-text (proc want n)
  (let (t (buffer-query proc buffer-text))
    (if (or (= t want) (= n 0))
      t
      (do (receive (after 100 nil)) (rc-await-text proc want (dec n))))))

(describe "remote — --serve --collab (shared content, a cursor per client)"
  :isolated (test "the collab session model links slot 0 and the seed push syncs it through the real ed-update"
    (let (proc (spawn-buffer (make-buffer "the live document" "d.txt"))
          m ((ed-serve-collab-model nil proc)))
      ; runs here, so the subscription is ours
      (is (collab-shared? m 0))
      ;; the subscribe seeds us immediately; fold it through the REAL ed-update — this
      ;; exercises the :buffer-updated handler registration, not a direct collab call
      (let (push (receive ([:buffer-updated p v t o] [:buffer-updated p v t o]) (after 2000 :none)))
        (is (not (= push :none)))
        (let (m2 (ed-update m push 80 24))
          (assert= (buffer-text (ed-current-buf m2)) "the live document")))
      (stop-buffer proc)))

  (test "ed-update does not echo a folded push back to the process"
    (let (proc (spawn-buffer (make-buffer "shared" "e.txt"))
          m ((ed-serve-collab-model nil proc)))
      ;; consume our seed, then fold a v2 push through the collab-wrapped update: the fold
      ;; must NOT propagate back (it IS the process's truth). An echo would send the
      ;; "shared"→"shared2" splice to the process, turning ITS text into "shared2" — so the
      ;; process text staying "shared" is exactly the no-echo proof.
      (receive ([:buffer-updated _ _ _ _] nil) (after 2000 nil))
      (ed-update m [:buffer-updated proc 2 "shared2"] 80 24)
      (receive (after 200 nil)) ; a beat for any (wrong) echo splice to land
      (assert= (buffer-query proc buffer-text) "shared")
      (stop-buffer proc)))

  (test "two collab sessions: a typed key reaches the process, a late joiner syncs, edits fan out live"
    (let (me (self)
          proc (spawn-buffer (make-buffer "" "c.txt"))
          mgr (spawn (editor/serve/serve-manager (ed-serve-collab-model nil proc) ed-view ed-update)))
      ;; participant A attaches and types a distinctive string
      (spawn (rc-client mgr me))
      (let (a (receive ([:rc-ready c] c) (after 2000 :none)))
        (is (not (= a :none)))
        (doseq (k (string/->list "Zq7")) (send a [:press k]))
        ;; the splices propagate to the shared process (serialized, in order)
        (assert= (rc-await-text proc "Zq7" 20) "Zq7")
        ;; participant B attaches late — the subscribe seed syncs it to the LIVE text
        (spawn (rc-client mgr me))
        (let (b (receive ([:rc-ready c] c) (after 2000 :none)))
          (is (not (= b :none)))
          (assert= (rc-await-frame b "Zq7") :ok)
          ;; B types at ITS OWN point (0 — independent of A's): the process serializes
          ;; the splice and pushes it to A, whose next frame shows B's edit
          (send b [:press "!"])
          (assert= (rc-await-text proc "!Zq7" 20) "!Zq7")
          (assert= (rc-await-frame a "!Zq7") :ok)))
      (stop-buffer proc)))

  (test "presence: an identified participant's name tag renders in the other's frame"
    (let (me (self)
          proc (spawn-buffer (make-buffer "" "pt.txt"))
          mgr (spawn (editor/serve/serve-manager (ed-serve-collab-model nil proc) ed-view ed-update)))
      ;; participant A attaches plainly …
      (spawn (rc-client mgr me))
      (let (a (receive ([:rc-ready c] c) (after 2000 :none)))
        (is (not (= a :none)))
        ;; … participant B attaches WITH an identity (the 5-element attach)
        (spawn (rc-client-as mgr me {:name "mona"}))
        (let (b (receive ([:rc-ready c] c) (after 2000 :none)))
          (is (not (= b :none)))
          ;; B's caret (its join marker) + its NAME reach A's session and render as a tag
          (assert= (rc-await-frame a "mona") :ok)))
      (stop-buffer proc)))

  (test "presence: a pure model with remote cursors renders the caret bar + name tag"
    ;; No processes: inject what a push would have stored on the shared slot and render.
    (let (m (ed-init (make-buffer "hello world" "v.txt"))
          ;; :collab? — the presence chip gates on it (hosted ≠ shared under the flip)
          m2 (assoc m
               :hosted
                 {0 {:proc :none
                     :version 3
                     :me :self
                     :collab? true
                     :cursors {:p1 6}
                     :names {:p1 "zoe"}}})
          f (ed-view m2 80 24))
      (is (r-frame-has? f "zoe"))
      ;; the presence chip names them in the modeline too
      (is (r-frame-has? f "shared: zoe"))
      ;; and an unshared model renders no tag
      (is (not (r-frame-has? (ed-view m 80 24) "zoe")))))

  (test "selections: a remote region becomes an [lo hi] tint range in the owner's colour"
    (let (m (assoc (ed-init (make-buffer "hello world" "s.txt"))
              :hosted
                {0 {:proc :none
                    :version 1
                    :me :self
                    :cursors {:p1 9}
                    :marks {:p1 4}
                    :names {:p1 "zoe"}}})
          ranges (view/ed-remote-selection-ranges m {:payload {:buffer 0}}))
      (assert= (count ranges) 1)
      (let ([lo hi face] (first ranges))
        (assert= [lo hi] [4 9])
        (is (not (nil? (:bg face))))))))

;; ADR-415: a guest attaches over a link that carries no code, but the session it reaches is
;; an editor. A guest's session runs an allowlist — editing what it was given — and refuses
;; the rest, from a key, from M-x and from the menu alike.
(defn guest-model (text)
  (ed-update (ed-init (make-buffer text)) [:client-opts {:name "alice" :guest true}] 80 24))
(defn guest-press (m keys) (fold keys m (fn (acc k) (ed-update acc k 80 24))))

(describe "a guest's session edits what it was given, and nothing more"
  (test "the attach identity marks the session, and only a guest's"
    (is (:guest-session (guest-model "")))
    (is (not (:guest-session (ed-update (ed-init (make-buffer ""))
                               [:client-opts {:name "bob"}]
                               80
                               24)))))
  (test "typing, motion, kill and undo work"
    (let (m (guest-press (guest-model "abc") [:ctrl-e "d" :ctrl-a :ctrl-k :ctrl-y]))
      (assert= (buffer-text (ed-current-buf m)) "abcd")))
  (test "opening a file, a shell command and a terminal are refused"
    (doseq (keys [[:ctrl-x :ctrl-f] [(keyword "alt-!")] [:ctrl-x :ctrl-e]])
      (let (m (guest-press (guest-model "(+ 1 2)") keys))
        (is (includes? (:echo m) "guest session"))
        (is (nil? (:minibuffer m)))
        (is (nil? (:pending m))))))
  (test "M-x offers and runs only what a guest may"
    (is (guest/ed-guest-allows-name? "kill-line"))
    (is (not (guest/ed-guest-allows-name? "find-file")))
    (is (not (guest/ed-guest-allows-name? "shell-command")))
    (is (not (guest/ed-guest-allows? 'git/cmd-git-status)))
    (is (guest/ed-guest-allows? :self-insert))))

;; A private session outlives its window (brood ADR-519): a dropped client's session parks,
;; its buffers' sidecars written at once, and attaching again under the same name takes it
;; back. A served `:close` (the window already gone) writes them and ends, asking nothing.
(purge-stale-temp "bedit-remote-")

(defn- r-fixture-file (text)
  ;; a fresh file holding `text` in its own temp directory; its path
  (let (dir (temp-dir "bedit-remote-")
        _ (file/mkdir dir)
        path (path/join dir "notes.txt"))
    (do (file/spit path text) path)))

(defn- r-await-file (path tries)
  ;; `path`'s text once the off-loop writer has made it, else nil — polled, since the
  ;; writer is a process of its own with no reply to wait on. Not merely once it EXISTS:
  ;; the writer creates the file and then writes it, and a read between the two is ""
  (cond
    (and (file/exists? path) (not (= "" (file/slurp path)))) (file/slurp path)
    (<= tries 0) nil
    else (receive (after 20 (r-await-file path (dec tries))))))

(defn- r-named-client (mgr report)
  ;; attach as "ann", say the session, then die when told — the dropped link
  (send mgr [:attach (self) 80 24 {:name "ann"}])
  (receive
    ([:attached s] (do (send report [:session s]) (receive (:die nil))))
    (after 2000 (send report [:session nil]))))

(describe "remote — a private session outlives its window"
  (test "a lost client's buffers are auto-saved at once, unthrottled"
    (let (path (r-fixture-file "text\n")
          typed (ed-update (assoc (ed-init (find-file-buffer path)) :auto-saved-at (os/now))
                  "x" 80 24)
          m (ed-ev-client-lost typed [:client-lost] 24 80 24))
      (assert= (r-await-file (sidecar/ed-auto-save-path path) 100) "xtext\n")
      (is (includes? (:echo m) "auto-saved"))))

  (test "a served :close ends the session with its sidecars written, asking nothing"
    (let (path (r-fixture-file "text\n")
          typed (ed-update (ed-init (find-file-buffer path)) "y" 80 24)
          m (ed-served-update typed :close 80 24))
      (is (:done m))
      (assert= (r-await-file (sidecar/ed-auto-save-path path) 100) "ytext\n")))

  (test "an ordinary input still folds through ed-update"
    (let (m (ed-served-update (ed-init (make-buffer "")) "z" 80 24))
      (assert= (buffer-text (ed-current-buf m)) "z")))

  (test "attaching again under the same name gets the parked session, typing intact"
    (let (me (self)
          mgr (spawn (editor/serve/serve-manager (r-empty-model)
                       ed-view
                       ed-served-update
                       {:resume-ms 60000}))
          client (spawn (r-named-client mgr me))
          session (receive ([:session s] s) (after 2000 nil)))
      (is (not (nil? session)))
      (doseq (k (string/->list "Kept9")) (send session [:key k]))
      (r-drain-frames :none)
      (send client :die)
      (receive (after 300 nil)) ; the session notices the client's death and parks
      (send mgr [:attach me 80 24 {:name "ann"}])
      (assert= (receive ([:attached s] s) (after 2000 :none)) session)
      (is (r-frame-has? (r-drain-frames :none) "Kept9"))
      (exit session :kill))))

;; ---- a served session starts as the window does, its clipboard the client's ---------
;; `--serve` used to build its sessions from the bare `ed-init` model: no init.blsp, no
;; recentf or save-place, and no clipboard at all. Now a session is prepared through the
;; window's startup path (src/startup.blsp) and kills and yanks reach the CLIENT's
;; clipboard over the link (brood ADR-539) — here the test process is that client.

;; The init file as a daemon reads it once (`startup/read-init`), built here so no test
;; reads the user's real one.
(defn r-init (config) {:config config :note nil})

(describe "remote — a served session is prepared as the window's editor is"
  (test "the daemon's init config reaches the session model"
    (let (m ((ed-serve-model nil (r-init {:hl-line false :share-name "host"}))))
      (assert= (:hl-line m) false)
      (assert= (:recent-files m) true)
      (assert= (:save-place m) true)
      ;; the participant is whoever attaches, never the host's :share-name
      (is (nil? (:participant m)))))

  (test "an init file that did not read says so in the session's echo area"
    (let (m ((ed-serve-model nil {:config {} :note "init.blsp:2:1: unclosed list"})))
      (assert= (:echo m) "init.blsp:2:1: unclosed list")))

  (test "the init file is read once, from where the daemon is told — a temp one here"
    (let (dir (temp-dir "bedit-remote-")
          broken (str dir "/broken.blsp")
          fresh (str dir "/fresh/init.blsp"))
      (file/mkdir dir)
      (file/spit broken "(config :hl-line false)\n(stray\n")
      (let (read (startup/read-init broken))
        (assert= (:config read) {:hl-line false})
        (is (string/starts-with? (:note read) "init.blsp:2:1")))
      ;; a missing one is written with its documented defaults, and reads cleanly
      (let (read (startup/read-init fresh))
        (is (file/exists? fresh))
        (is (nil? (:note read))))))

  (test "its clipboard is the client's, never the daemon's OS clipboard"
    (let (m ((ed-serve-model nil (r-init {}))))
      (assert= (:client-clipboard m) true)
      (is (not (:os-clipboard m)))))

  (test "a guest keeps the host's config but none of its on-disk memory"
    (let (m (ed-update ((ed-serve-model nil (r-init {:hl-line false})))
              [:client-opts {:name "gil" :guest true}]
              80
              24))
      (is (:guest-session m))
      (assert= (:hl-line m) false)
      (is (nil? (:recent-files m)))
      (is (nil? (:save-place m)))
      (assert= (:client-clipboard m) true)))

  (test "without an init file the session model stays the pure one"
    (let (m ((ed-serve-model nil)))
      (is (nil? (:recent-files m)))
      (is (nil? (:client-clipboard m))))))

;; A served session on an empty buffer, prepared from the default config — the test process
;; attaches as its client and is sent the session's clipboard traffic.
(defn r-clipboard-session ()
  (let (mgr (spawn (editor/serve/serve-manager (fn ()
                                                 (ed-served-model (make-buffer "") nil (r-init {})))
                     ed-view ed-update)))
    (send mgr [:attach (self) 80 24])
    (let (session (receive ([:attached s] s) (after 2000 nil)))
      (receive ([:frame _] nil) (after 2000 nil))
      session)))

(defn r-press (session keys) (doseq (k keys) (send session [:key k])))

;; :ok once a frame paints `sub`, skipping the frames before it; :timeout if none does
(defn r-await-frame-has (sub)
  (receive
    ([:frame f] (if (r-frame-has? f sub) :ok (r-await-frame-has sub)))
    (after 3000 :timeout)))

;; the first frame that paints `sub`, skipping the frames before it; :timeout if none does
(defn r-await-frame-with (sub)
  (receive
    ([:frame f] (if (r-frame-has? f sub) f (r-await-frame-with sub)))
    (after 3000 :timeout)))

;; kill `text` in the session, its clipboard-set and the frames that showed the typing taken
(defn r-kill-text (session text)
  (r-press session (into (string/->list text) [:ctrl-a :ctrl-k]))
  (receive ([:clipboard-set _] nil) (after 2000 nil))
  (r-drain-frames :none))

(describe "remote — kill and yank reach the client's clipboard"
  (test "a kill in the session is put on the client's clipboard"
    (let (session (r-clipboard-session))
      (r-press session ["a" "b" "c" :ctrl-a :ctrl-k])
      (assert= (receive ([:clipboard-set text] text) (after 2000 :none)) "abc")
      (exit session :kill)))

  (test "a yank inserts what the client says its clipboard holds"
    (let (session (r-clipboard-session))
      (r-press session [:ctrl-y])
      (receive
        ([:clipboard-get from asked] (send from [:clipboard asked "from the laptop"]))
        (after 2000 nil))
      (assert= (r-await-frame-has "from the laptop") :ok)
      (exit session :kill)))

  (test "the loop keeps taking keys while the client is asked, and the yank lands where C-y was"
    (let (session (r-clipboard-session))
      (r-kill-text session "xyz")
      (r-press session [:ctrl-y])
      (let (question (receive ([:clipboard-get from asked] [from asked]) (after 2000 nil)))
        (is (not (nil? question)))
        ;; unanswered: a key typed now is folded and drawn — nothing waits on the client
        (r-press session ["Q"])
        (assert= (r-await-frame-has "Q") :ok)
        (send (first question) [:clipboard (second question) "PASTE"]))
      ;; in at the spot C-y marked, before what was typed since
      (assert= (r-await-frame-has "PASTEQ") :ok)
      ;; and point stayed after the typing: the next key goes at the end
      (r-press session ["!"])
      (assert= (r-await-frame-has "PASTEQ!") :ok)
      (exit session :kill)))

  (test "a client that never answers leaves the yank to the kill ring"
    (let (session (r-clipboard-session))
      (is (not (r-frame-has? (r-kill-text session "xyz") "xyz")))
      (r-press session [:ctrl-y])
      ;; asked, and never answered: brood answers nil at its timeout, and the ring's head goes in
      (is (not (= (receive ([:clipboard-get _ asked] asked) (after 2000 :none)) :none)))
      (assert= (r-await-frame-has "xyz") :ok)
      (r-press session ["!"])
      (assert= (r-await-frame-has "xyz!") :ok)
      (exit session :kill)))

  (test "M-y while the client is still asked does not touch the yank before it"
    (let (session (r-clipboard-session))
      (r-kill-text session "alpha")
      (r-kill-text session "beta")
      ;; a first yank, answered: "beta"
      (r-press session [:ctrl-y])
      (receive ([:clipboard-get from asked] (send from [:clipboard asked "beta"])) (after 2000 nil))
      (assert= (r-await-frame-has "beta") :ok)
      (r-drain-frames :none)
      ;; a second, its answer held back, and M-y meanwhile: it must not cycle the FIRST
      ;; yank's span (that would leave "alpha"), only say the yank is not done
      (r-press session [:ctrl-y])
      (let (question (receive ([:clipboard-get from asked] [from asked]) (after 2000 nil)))
        (r-press session [:alt-y])
        ;; the frame that says so still shows the first yank's "beta", not "alpha"
        (let (said (r-await-frame-with "yank not done yet"))
          (is (not (= said :timeout)))
          (is (r-frame-has? said "beta"))
          (is (not (r-frame-has? said "alpha"))))
        (send (first question) [:clipboard (second question) "beta"]))
      (assert= (r-await-frame-has "betabeta") :ok)
      ;; and once it is done, M-y cycles THAT yank, as right after a C-y
      (r-press session [:alt-y])
      (assert= (r-await-frame-has "betaalpha") :ok)
      (exit session :kill))))

;; ---- a served session's loop that dies loses nothing (brood ADR-593) -------------------
;; Its buffers live in buffer processes named in a registry the SESSION owns, so the loop
;; dying costs nothing: the sidecars are written from the processes, and a fresh loop adopts
;; every buffer, for the same client. The test process is that client.

(defn- r-supervised-session (path supervision)
  ;; a served private session on the file at `path` under `supervision`, attached by this
  ;; process: `[loop session]`. Its idle auto-save held off for an hour, so a sidecar is the
  ;; crash hook's
  (let (mgr (spawn (editor/serve/serve-manager (fn ()
                                                 (assoc ((ed-serve-model path))
                                                   :auto-saved-at (+ (os/now) 3600000)))
                     ed-view
                     ed-served-update
                     {:supervise supervision})))
    (do
      (send mgr [:attach (self) 80 24])
      (let (loop-process (receive ([:attached s] s) (after 2000 nil))
            session (receive ([:session s] s) (after 2000 nil)))
        [loop-process session]))))

(describe "remote — a served session's loop that dies is saved and restarted"
  (test "the unsaved text is auto-saved, and the restarted loop shows it to the same client"
    (let (path (r-fixture-file "text\n")
          [first-loop session] (r-supervised-session path (ed-served-supervision nil)))
      (is (pid? first-loop))
      (is (pid? session))
      (doseq (k (string/->list "Kept9")) (send first-loop [:key k]))
      (is (r-frame-has? (r-drain-frames :none) "Kept9text"))
      ;; the loop dies outside update and view — a native panic, a killed process
      (exit first-loop :boom)
      (let (next-loop (receive ([:reattached l _ _] l) (after 2000 nil)))
        (is (pid? next-loop))
        (is (not (= next-loop first-loop)))
        ;; written from the buffer process, which outlived the loop
        (assert= (r-await-file (sidecar/ed-auto-save-path path) 100) "Kept9text\n")
        (let (frame (r-drain-frames :none))
          (is (r-frame-has? frame "Kept9text"))
          (is (r-frame-has? frame "restarted")))
        ;; and the new loop edits the same document
        (send next-loop [:key "!"])
        (let (frame (r-drain-frames :none))
          ;; at the point the dead loop left it at: the restarted loop restored it
          (is (r-frame-has? frame "Kept9!text")))
        (exit session :kill))))

  (test "a daemon told to end saves a live session, its loop still running"
    (let (path (r-fixture-file "text\n")
          test-process (self)
          keeper (lifeline/start-keeper (fn (sig saved) (send test-process [:kept sig saved])))
          [first-loop session] (r-supervised-session path (ed-served-supervision nil)))
      (doseq (k (string/->list "Kept9")) (send first-loop [:key k]))
      (is (r-frame-has? (r-drain-frames :none) "Kept9text"))
      (send keeper [:signal :term])
      (let ([sig saved] (receive ([:kept s paths] [s paths]) (after 4000 [nil []])))
        (assert= sig :term)
        (is (includes? saved path)))
      (assert= (file/slurp (sidecar/ed-auto-save-path path)) "Kept9text\n")
      (exit session :kill)))

  (test "past the restart budget the sidecars are still written and the session ends"
    (let (path (r-fixture-file "text\n")
          [first-loop session] (r-supervised-session path
                                 (assoc (ed-served-supervision nil) :max 0)))
      (monitor session)
      (doseq (k (string/->list "Gone")) (send first-loop [:key k]))
      (is (r-frame-has? (r-drain-frames :none) "Gonetext"))
      (exit first-loop :boom)
      (assert= (receive ([:down _ ^session reason] reason) (after 2000 :alive)) :boom)
      (assert= (r-await-file (sidecar/ed-auto-save-path path) 100) "Gonetext\n")
      (assert= (receive ([:reattached l _ _] l) (after 0 :none)) :none)))

  (test "the restarted model adopts the registry's buffers, showing the first file"
    (let (path (r-fixture-file "on disk\n")
          registry (editor/buffer-registry/registry-start)
          _ (editor/buffer-registry/registry-share registry
              "notes.txt"
              "edited\n"
              {:file path :type :text})
          m ((ed-served-restart nil) {:registry registry} {:reason :boom}))
      (assert= (:buffer-reg m) registry)
      (assert= (buffer-file (ed-current-buf m)) path)
      ;; the text is there now, not at the seed push
      (assert= (buffer-text (ed-current-buf m)) "edited\n")
      (editor/buffer-registry/registry-stop registry)))

  (test "the restarted model shows the document its predecessor showed, at its point"
    (let (first-path (r-fixture-file "first\n")
          second-path (r-fixture-file "second\n")
          registry (editor/buffer-registry/registry-start)
          _ (editor/buffer-registry/registry-share registry
              "notes.txt"
              "first\n"
              {:file first-path})
          _ (editor/buffer-registry/registry-share registry
              "notes.txt"
              "second\n"
              {:file second-path})
          snapshot {:keys [first-path second-path] :current second-path :points {second-path 3}}
          m ((ed-served-restart nil) {:registry registry :snapshot snapshot} {:reason :boom}))
      (assert= (buffer-file (ed-current-buf m)) second-path)
      (assert= (buffer-text (ed-current-buf m)) "second\n")
      (assert= (buffer-point (ed-current-buf m)) 3)
      (editor/buffer-registry/registry-stop registry)))

  (test "a restarted shared session gets back every document it had open, where it was"
    (let (first-path (r-fixture-file "shared doc\n")
          second-path (r-fixture-file "other doc\n")
          registry (editor/buffer-registry/registry-start {:mirror true})
          first-proc (collab-registry-share registry (find-file-buffer first-path))
          _ (collab-registry-share registry (find-file-buffer second-path))
          snapshot {:keys [first-path second-path] :current second-path :points {second-path 5}}
          restart (:restart (ed-collab-supervision first-path first-proc registry nil))
          m (restart {:registry registry :snapshot snapshot} {:reason :boom :identity {}})
          second-index (seq/index-where (:buffers m) (fn (b) (= (buffer-file b) second-path))))
      ;; the visited document is back, shared — linked to the registry's process — and shown
      (is (>= second-index 0))
      (is (map/get-in m [:hosted second-index :collab?]))
      (assert= (buffer-file (ed-current-buf m)) second-path)
      (assert= (buffer-text (ed-current-buf m)) "other doc\n")
      (assert= (buffer-point (ed-current-buf m)) 5)
      ;; and slot 0 is still the session's shared document
      (assert= (buffer-file (ed-buf-at m 0)) first-path)
      (editor/buffer-registry/registry-stop registry)))

  (test "a live served session hands its session the buffers it shows and their points"
    (let (m (ed-served-snapshot (ed-init (goto-char (make-buffer "abcdef" "notes") 4))))
      (assert= (:current m) "notes")
      (assert= (get (:points m) "notes") 4)))

  (test "a guest's restarted session is a guest's before its first key"
    (let (m ((ed-served-restart nil) {} {:identity {:name "eve" :guest true}}))
      (is (:guest-session m))
      (assert= (:participant m) "eve")))

  (test "the echo area says the loop was restarted, and what was saved"
    (let (m (ed-ev-session-restarted (ed-init (make-buffer ""))
              [:session-restarted {:reason :boom :saved ["/tmp/a"]}]
              24
              80
              24))
      (is (includes? (:echo m) "restarted"))
      (is (includes? (:echo m) "auto-saved 1")))))
