;; What a package update would change (src/package-review.blsp): the unified diff of two
;; texts, the diff of two package trees, the changelog entries between two versions, and the
;; *Package Diff* section tree. Pure over a scratch directory; the update round trip that
;; shows the buffer and applies or drops it is in tests/packages_test.blsp.

(defmodule package-review-test
  (:use test)
  (:use section) ; section-render — the tree as the buffer shows it
  (:use-internals package-review))

(purge-stale-temp "bedit-pkgreview-")

(defn- hunk-lines (text)
  ;; every hunk's body lines of the one file `text` holds, in order
  (vec (mapcat (:hunks (first (diff/parse-unified text))) :lines)))

(describe "unified-text — two texts as a unified diff"
  (test "a changed line, with its context, headed for the file"
    (assert= (package-review/unified-text "f" "a\nb\n" "a\nc\n")
      "--- a/f\n+++ b/f\n@@ -1,2 +1,2 @@\n a\n-b\n+c\n"))
  (test "the same text is no diff"
    (assert= (package-review/unified-text "f" "a\nb\n" "a\nb\n") nil))
  (test "an added file and a deleted one name /dev/null on the side they are not on"
    (let (added (or (package-review/unified-text "f" nil "x\ny\n") (error "no diff"))
          deleted (or (package-review/unified-text "f" "x\n" nil) (error "no diff")))
      (is (string/starts-with? added "--- /dev/null\n+++ b/f\n@@ -0,0 +1,2 @@"))
      (assert= (hunk-lines added) ["+x" "+y"])
      (is (string/starts-with? deleted "--- a/f\n+++ /dev/null\n@@ -1 +0,0 @@"))))
  (test "changes far apart are two hunks, changes close together one"
    (let (old (string/join (map (range 20) (fn (i) (str "line " i))) "\n")
          far (string/replace (string/replace old "line 2\n" "LINE 2\n") "line 17\n" "LINE 17\n")
          near (string/replace (string/replace old "line 2\n" "LINE 2\n") "line 6\n" "LINE 6\n")
          hunks (fn (new)
                  (:hunks (first (diff/parse-unified (package-review/unified-text "f" old new))))))
      (assert= (count (hunks far)) 2)
      (assert= (count (hunks near)) 1)
      ;; three lines of context each side, as diff -u
      (let (first-hunk (first (hunks far)))
        (assert= (:old-start first-hunk) 1)
        (assert= (:old-count first-hunk) 6)
        (assert= (nth (:lines first-hunk) 2) "-line 2")
        (assert= (nth (:lines first-hunk) 3) "+LINE 2"))))
  (test "the hunks parse back to the new text's line numbers"
    (let (text (package-review/unified-text "f" "a\nb\nc\nd\n" "a\nb\nX\nY\nd\n")
          hunk (first (:hunks (first (diff/parse-unified text)))))
      (assert= [(:old-start hunk) (:old-count hunk) (:new-start hunk) (:new-count hunk)] [1 4 1 5])
      (assert= (diff/hunk-new-line hunk 3) 3))))

(def- log
  (string/join ["# Changelog"
                 "" "## [1.2.0] - 2026-11-01" "- newest" "## [1.1.0] - 2026-10-01" "- middle"
                 "## [1.0.0] - 2026-09-01" "- first"]
    "\n"))

(describe "changelog-between — the entries an update brings"
  (test "the sections after the installed version up to the new one, headings first"
    (assert= (package-review/changelog-between log "1.0.0" "1.2.0")
      ["## [1.2.0] - 2026-11-01" "- newest" "## [1.1.0] - 2026-10-01" "- middle"]))
  (test "a version past the new one is left out"
    (assert= (package-review/changelog-between log "1.0.0" "1.1.0")
      ["## [1.1.0] - 2026-10-01" "- middle"]))
  (test "nothing between them, or no version headings, is nothing"
    (assert= (package-review/changelog-between log "1.2.0" "1.2.0") [])
    (assert= (package-review/changelog-between "just prose\n" "1.0.0" "2.0.0") [])))

(defn- write-tree (dir files)
  ;; `files` (relative path -> text) under `dir`
  (doseq ([path text] files)
    (os/cmd "mkdir" ["-p" (path/dirname (path/join dir path))])
    (file/spit (path/join dir path) text)))

(describe "tree-diff — what changed between two package directories"
  (test "added, deleted and modified files by path; an unchanged one is not listed"
    (let (base (temp-dir "bedit-pkgreview-")
          old (path/join base "old")
          new (path/join base "new")
          _ (write-tree old {"project.blsp" "v1\n" "src/a.blsp" "same\n" "src/gone.blsp" "bye\n"})
          _ (write-tree new {"project.blsp" "v2\n" "src/a.blsp" "same\n" "src/b.blsp" "hi\n"})
          files (package-review/tree-diff old new))
      (assert= (vec (map files (fn (file) [(:label file) (or (:new-path file) (:old-path file))])))
        [["modified" "project.blsp"] ["added" "src/b.blsp"] ["deleted" "src/gone.blsp"]])
      (assert= (:lines (first (:hunks (first files)))) ["-v1" "+v2"])))
  (test "a file that is not text is listed with no hunks"
    (let (base (temp-dir "bedit-pkgreview-")
          old (path/join base "old")
          new (path/join base "new")
          _ (write-tree old {"icon.bin" "a\u{0}b"})
          _ (write-tree new {"icon.bin" "a\u{0}c"})
          file (first (package-review/tree-diff old new)))
      (assert= (:hunks file) [])
      (assert= (:headers file) ["Binary files differ"]))))

(describe "review-tree — the *Package Diff* buffer"
  (test "the versions and keys, the changelog, then each file with its hunks"
    (let (review {:name "pkg"
                  :old-version "1.0.0"
                  :new-version "1.1.0"
                  :changelog ["## 1.1.0" "- better"]
                  :files [(assoc (first (diff/parse-unified (package-review/unified-text "src/pkg.blsp"
                                                              "(defn f () 1)\n" "(defn f () 2)\n")))
                            :label "modified")]}
          text (section-text (section-render (package-review/review-tree review) {})))
      (is (includes? text "pkg 1.0.0 → 1.1.0"))
      (is (includes? text "C-c C-c applies"))
      (is (includes? text "Changelog\n## 1.1.0\n- better"))
      (is (includes? text "Files changed (1)"))
      (is (includes? text "modified   src/pkg.blsp"))
      (is (includes? text "+(defn f () 2)"))))
  (test "no changelog shipped, no changelog section"
    (let (text (section-text (section-render (package-review/review-tree {:name "pkg"
                                                                          :old-version "1.0.0"
                                                                          :new-version "1.1.0"
                                                                          :changelog []
                                                                          :files []})
                               {})))
      (refute (includes? text "Changelog"))
      (is (includes? text "(no file changed)")))))
