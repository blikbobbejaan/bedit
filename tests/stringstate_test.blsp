;; tests/stringstate_test.blsp — the string and comment state a mode's string syntax gives
;; (`stringstate`, Emacs's syntax-ppss for strings): tokens, the state at a position, unterminated
;; strings, raw strings, block comments, the syntax a mode without one gets, and bracket balance.

(defmodule stringstate-test
  (:use test)
  (:use stringstate)
  (:use editor/buffer))

(def- python
  {:strings [{:open "\"\"\"" :multiline true}
              {:open "'''" :multiline true}
              {:open "\""}
              {:open "'"}]
   :comments ["#"]})
(def- c-like
  {:strings [{:open "\""} {:open "`" :multiline true :raw true}]
   :comments ["//"]
   :block-comments [["/*" "*/"]]})

(defn- at (text point syntax)
  ;; the state's kind and opener at `point` of `text`, or nil
  (let (state (state-at (make-buffer text) syntax point))
    (when state [(:kind state) (:open state)])))

(describe "tokens"
  (test "a lexer's leftmost tokens: a `#` in a string is not a comment, a quote in a comment opens nothing"
    (let (rope (text/from-string "a = \"x # y\" # it's\nb = 'q'"))
      (assert= (spans rope python 0 (text/length rope)) [[4 11] [12 18] [23 26]])))
  (test "a triple quote spans lines; a one-line string ends at its line"
    (let (rope (text/from-string "\"\"\"a\nb\"\"\" 'open\nc"))
      (assert= (spans rope python 0 (text/length rope)) [[0 9] [10 16]]))))

(describe "the state at a position"
  (test "inside a string, after it, in a comment, in code"
    (let (text "x = \"ab\" # c")
      (assert= (at text 6 python) [:string "\""])
      (assert= (at text 8 python) nil)
      (assert= (at text 11 python) [:comment nil])
      (assert= (at text 2 python) nil)))
  (test "an unterminated string holds point to its end; a multi-line one across lines"
    (assert= (at "x = \"ab" 7 python) [:string "\""])
    (assert= (at "x = \"\"\"doc\nmore" 15 python) [:string "\"\"\""])
    (assert= (at "x = 'ab\ny" 9 python) nil))
  (test "an escaped quote does not close; a raw string has no escapes"
    (assert= (at "x = \"a\\\"b" 9 python) [:string "\""])
    (assert= (at "`a\\` x" 5 c-like) nil))
  (test "a block comment spans lines"
    (assert= (at "/* a\n \" b */ \"c" 7 c-like) [:comment "*/"])
    (assert= (at "/* a\n \" b */ \"c" 14 c-like) [:string "\""]))
  (test "the string extent M-q fills"
    (assert= (string-extent (goto-char (make-buffer "(def x \"aa bb\")" "a.blsp" "a.blsp") 9))
      [7 14])))

(describe "a mode with no string syntax"
  (test "its quote pairs are one-line strings"
    (assert= (pairs-syntax [["(" ")"] ["\"" "\""] ["'" "'"] ["\"\"\"" "\"\"\""]])
      {:strings [{:open "\""} {:open "'"}]}))
  (test "and the scan starts at point's line"
    (let (rope (text/from-string "a \"b\nc \"d"))
      (assert= (scan-start rope (pairs-syntax [["\"" "\""]]) 8) 5)
      (assert= (scan-start rope python 8) 0))))

(describe "bracket balance"
  (test "unclosed openers and the closers that close nothing, strings and comments skipped"
    (let (buf (make-buffer "f(a, \")\" # )\n) x)"))
      (assert= (balance buf python ["(" ")"] 0 (buffer-length buf)) {:open 0 :closers [16]})))
  (test "a short buffer is counted whole"
    (let (buf (make-buffer "a\n\nb"))
      (assert= (balance-region buf) [0 4])))
  (test "a large one by the run of non-blank lines around point"
    (let (buf (goto-char (make-buffer (str "a\n\n(b\nc)\n\n" (string/repeat "x" 210000))) 4))
      (assert= (balance-region buf) [3 9]))))
