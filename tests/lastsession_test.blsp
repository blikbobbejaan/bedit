;; tests/lastsession_test.blsp — the last session in a project reopened (Emacs's desktop): its
;; files, and each pane on its file at its scroll and point; a file gone since is skipped.

(defmodule lastsession-test
  (:use test)
  (:use model)
  (:use editor/buffer)
  (:use editor/pane)
  (:use lastsession))

(defn- project ()
  (let (root (temp-dir "bedit-lastsession-"))
    (file/mkdir root)
    (file/spit (path/join root "a.txt") "alpha\nbeta\n")
    (file/spit (path/join root "b.txt") "one\ntwo\nthree\n")
    root))

(defn- working (root)
  ;; a.txt and b.txt open, the window split with b.txt (point on `two`) beside a.txt
  (let (m (assoc (ed-init (make-buffer ""))
            :project-root root
            :session-root root
            :restore-session true)
        with-a (pool/ed-find-file m (path/join root "a.txt"))
        split (assoc with-a
                :layout (pane-split (:layout with-a) :col (ed-pane (ed-current-index with-a))))
        with-b (pool/ed-find-file split (path/join root "b.txt")))
    (ed-set-buf with-b (goto-char (ed-current-buf with-b) 4))))

(defn- pane-files (m)
  (map (pane-leaf-paths (:layout m))
    (fn (path) (buffer-file (ed-buf-at m (:buffer (pane-payload-at (:layout m) path)))))))

(describe "a session"
  (test "names each pane's buffer by its file, with its point"
    (let (root (project)
          session (session-of (working root)))
      (assert= (:files session) [(path/join root "a.txt") (path/join root "b.txt")])
      (is (any? (map (pane-leaf-paths (:layout session))
                  (fn (path) (pane-payload-at (:layout session) path)))
            (fn (pane) (and (= (:file pane) (path/join root "b.txt")) (= (:point pane) 4)))))))

  (test "saved at quit and reopened at the next start: the files, the panes, the points"
    (let (root (project)
          _ (save! (working root))
          fresh (assoc (ed-init (make-buffer ""))
                  :project-root root
                  :session-root root
                  :restore-session true)
          restored (restore-for-start fresh))
      (assert= (pane-files restored) (pane-files (working root)))
      (assert= (buffer-file (ed-current-buf restored)) (path/join root "b.txt"))
      (assert= (buffer-point (ed-current-buf restored)) 4)
      (is (includes? (:echo restored) "2 files"))))

  (test "a file gone since is skipped; its panes show the session's first file"
    (let (root (project)
          session (session-of (working root))
          _ (file/rm (path/join root "b.txt"))
          restored (restore (assoc (ed-init (make-buffer "")) :project-root root) session))
      (assert= (into #{} (pane-files restored)) #{(path/join root "a.txt")})))

  (test "off, or no session kept: the start is left as it was"
    (let (root (project)
          fresh (assoc (ed-init (make-buffer ""))
                  :project-root root
                  :session-root root
                  :restore-session true))
      (assert= (restore-for-start fresh) fresh)
      (assert= (restore-for-start (assoc fresh :restore-session false))
        (assoc fresh :restore-session false)))))
