;; tests/projectdiag_test.blsp — the project's diagnostics (C-x p !): open buffers' findings and
;; what the language servers published for files that are not open, errors first, each row a
;; link to its finding.

(defmodule projectdiag-test
  (:use test)
  (:use model)
  (:use editor/buffer)
  (:use projectdiag))

(def- root "/proj")

(defn- with-open-finding ()
  ;; a model whose open buffer /proj/a.rb carries one advisory on its line 2
  (let (m (ed-init (make-buffer "x = 1\ny = 2\n" "/proj/a.rb" "/proj/a.rb")))
    (diagstore/ed-set-diagnostics m
      [{:line 2 :col 1 :message "warning: y is unused" :severity 2}]
      (buffer-rope (ed-current-buf m)))))

(defn- with-published (m)
  ;; …and a server's error for /proj/lib/b.rb, which is not open
  (assoc m
    :lsp-diags
      {"/proj/lib/b.rb" {"server" [[{:line 7 :col 3 :message "error: boom" :severity 1}] []]}
       "/elsewhere/c.rb" {"server" [[{:line 1 :col 1 :message "error: not ours" :severity 1}] []]}}))

(describe "what the project knows"
  (test "an open buffer's findings and a published file's, nothing outside the root"
    (let (findings (project-findings (with-published (with-open-finding)) root))
      (assert= (into #{} (keys findings)) #{"/proj/a.rb" "/proj/lib/b.rb"})
      (assert= (map (get findings "/proj/lib/b.rb") first) '(6)))))

(describe "*Project Diagnostics*"
  (test "files with errors come first, each finding under its file, every row a link"
    (let ([text links] (report (with-published (with-open-finding)) root)
          lines (string/split text "\n"))
      (assert= (first lines) "2 diagnostics in 2 files under /proj")
      (assert= (nth lines 2) "lib/b.rb")
      (is (string/starts-with? (string/trim (nth lines 3 "")) "7:3"))
      (assert= (get links 3) {:file "/proj/lib/b.rb" :line 7 :col 3})
      (assert= (nth lines 4) "a.rb")
      (assert= (get links 5) {:file "/proj/a.rb" :line 2 :col 1})))
  (test "C-x p ! opens the list for the project point is in, links on its buffer"
    (let (shown (cmd-project-diagnostics (with-published (with-open-finding)) nil))
      (assert= (buffer-name (ed-current-buf shown)) "*Project Diagnostics*")
      (is (map? (:line-links (ed-current-buf shown)))))))
