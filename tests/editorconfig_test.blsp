;; EditorConfig (src/editorconfig.blsp): parsing a `.editorconfig`, its section globs, and
;; resolving the files above a path into one file's properties — pure, over a map of
;; paths to text.
(defmodule editorconfig-test
  (:use test)
  (:use editorconfig))

(defn- reader (files) (fn (path) (get files path)))

(describe "parse"
  (test "the preamble's root, then each section's properties in order"
    (let (parsed (parse "# top\nroot = true\n\n[*]\nindent_style = space\n; note\n[*.py]\nindent_size = 4\n"))
      (is (:root parsed))
      (assert= (vec (map (:sections parsed) :glob)) ["*" "*.py"])
      (assert= (:properties (second (:sections parsed))) {"indent_size" "4"})))
  (test "keys and known values are case-insensitive; an unknown value keeps its case"
    (assert= (:properties (first (:sections (parse "[*]\nIndent_Style = TAB\nmy_key = MiXed\n"))))
      {"indent_style" "tab" "my_key" "MiXed"}))
  (test "root only counts before the first section, and a line without `=` is ignored"
    (let (parsed (parse "[*]\nroot = true\nnonsense\n"))
      (is (not (:root parsed)))
      (assert= (:properties (first (:sections parsed))) {"root" "true"})))
  (test "CRLF line ends are read as LF ones"
    (assert= (:properties (first (:sections (parse "[*]\r\nindent_size = 2\r\n"))))
      {"indent_size" "2"})))

(describe "section globs"
  (test "a glob without a slash matches the file name at any depth"
    (is (glob-matches? "*.py" "a.py"))
    (is (glob-matches? "*.py" "src/deep/a.py"))
    (is (not (glob-matches? "*.py" "a.pyc"))))
  (test "a glob with a slash is relative to the config's directory; a leading slash is dropped"
    (is (glob-matches? "/Makefile" "Makefile"))
    (is (not (glob-matches? "/Makefile" "lib/Makefile")))
    (is (glob-matches? "lib/*.js" "lib/a.js"))
    (is (not (glob-matches? "lib/*.js" "lib/sub/a.js"))))
  (test "* stops at a slash, ** does not, and **/ matches no directory at all"
    (is (not (glob-matches? "src/*.c" "src/a/b.c")))
    (is (glob-matches? "src/**.c" "src/a/b.c"))
    (is (glob-matches? "src/**/b.c" "src/b.c"))
    (is (glob-matches? "src/**/b.c" "src/x/y/b.c")))
  (test "? is one character, but never a slash"
    (is (glob-matches? "a?c" "abc"))
    (is (not (glob-matches? "a?c" "a/c")))
    (is (not (glob-matches? "a?c" "abbc"))))
  (test "a bracket set, its negation, and an unclosed bracket as a literal"
    (is (glob-matches? "[abc].txt" "b.txt"))
    (is (not (glob-matches? "[abc].txt" "d.txt")))
    (is (glob-matches? "[!abc].txt" "d.txt"))
    (is (glob-matches? "[a-c]x" "bx"))
    (is (glob-matches? "a[b" "a[b")))
  (test "braces are alternatives, nested ones too; a brace with no comma is literal"
    (is (glob-matches? "*.{js,py}" "x.js"))
    (is (glob-matches? "*.{js,py}" "x.py"))
    (is (not (glob-matches? "*.{js,py}" "x.rb")))
    (is (glob-matches? "{a,{b,c}}.txt" "c.txt"))
    (is (glob-matches? "{single}.txt" "{single}.txt"))
    (is (not (glob-matches? "{single}.txt" "single.txt"))))
  (test "a numeric range matches the integers in it, either way round"
    (is (glob-matches? "file{1..3}.txt" "file2.txt"))
    (is (not (glob-matches? "file{1..3}.txt" "file4.txt")))
    (is (glob-matches? "file{10..-5}.txt" "file-3.txt")))
  (test "a backslash escapes a metacharacter, and regex characters are literal"
    (is (glob-matches? "a\\*b" "a*b"))
    (is (not (glob-matches? "a\\*b" "axb")))
    (is (glob-matches? "a+b.(c)" "a+b.(c)"))
    (is (not (glob-matches? "a.c" "abc")))))

(describe "properties-for"
  (def- tree
    {"/p/.editorconfig" "root = true\n[*]\nindent_style = space\nindent_size = 2\ninsert_final_newline = true\n[*.py]\nindent_size = 4\n[Makefile]\nindent_style = tab\n"
     "/p/sub/.editorconfig" "[*.py]\nindent_size = 3\ninsert_final_newline = unset\n"
     "/.editorconfig" "[*]\ncharset = latin1\n"})
  (test "the nearest file wins, and a later section beats an earlier one"
    (assert= (properties-for "/p/a.py" (reader tree))
      {"indent_style" "space" "indent_size" "4" "tab_width" "4" "insert_final_newline" "true"})
    (assert= (get (properties-for "/p/sub/b.py" (reader tree)) "indent_size") "3"))
  (test "unset removes what an outer file set"
    (is (not (contains? (properties-for "/p/sub/b.py" (reader tree)) "insert_final_newline"))))
  (test "root = true stops the search: the top-level file's charset never applies"
    (is (not (contains? (properties-for "/p/a.py" (reader tree)) "charset")))
    (assert= (get (properties-for "/elsewhere/x.txt" (reader tree)) "charset") "latin1"))
  (test "an indent style of tab with no size is one tab wide"
    (assert= (get (properties-for "/m/Makefile"
                    (reader {"/m/.editorconfig" "[Makefile]\nindent_style = tab\n"}))
               "indent_size")
      "tab"))
  (test "no config anywhere is no properties"
    (assert= (properties-for "/q/a.py" (reader {})) {})))

(describe "settings-of"
  (test "the properties in the editor's terms, only the valid ones"
    (assert= (settings-of {"indent_style" "space"
                           "indent_size" "4"
                           "tab_width" "8"
                           "max_line_length" "off"
                           "end_of_line" "crlf"
                           "insert_final_newline" "true"
                           "trim_trailing_whitespace" "false"
                           "charset" "utf-8"})
      {:indent-tabs false
       :indent-width 4
       :tab-width 8
       :end-of-line :crlf
       :insert-final-newline true
       :trim-trailing-whitespace false
       :charset "utf-8"}))
  (test "an indent size of tab is one tab, a bad number nothing"
    (assert= (settings-of {"indent_size" "tab" "tab_width" "zero"}) {:indent-width :tab})))
