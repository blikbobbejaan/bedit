;; Key bindings from init.blsp — `:keys` and `:mode-keys` (src/userkeys.blsp): compiled
;; from the config, bound into the layers dispatch resolves through, run by a real
;; keystroke through `ed-update`, reported by help, and gone again on a reload without them.

(defmodule userkeys-test
  (:use test)
  (:use model)
  (:use input)
  (:use keyhelp) ; ed-keys-label / ed-where-is — what help prints for a key
  (:use keymaps) ; profile-keymap — every key the profiles bind
  (:use userkeys)
  (:use config) ; *config-base* — a scratch config dir for the reload, never the real one
  (:use editor/buffer)
  (:use editor/keymap) ; key-parse / keymap-bindings
  (:use editor/layers) ; scope-bindings / scope-keymap — help's view of the scope
  (:use-internals bedit/input)) ; ed-ensure-layers / ed-key-binding — the scope as dispatch sees it

(purge-stale-temp "bedit-userkeys-") ; drop fixtures a prior run left in /tmp (at load)

(defn- uk-model (text cfg)
  "An editor on a scratch buffer holding `text`, with the init config `cfg` applied as
startup applies it."
  (config/apply-to-model (ed-init (make-buffer text)) cfg))

(defn- uk-markdown (text cfg)
  "As [[uk-model]], the buffer a Markdown one."
  (config/apply-to-model (ed-init (init-buffer-layers (set-buffer-type (make-buffer text) :markdown)))
    cfg))

(defn- uk-press (m keys) (fold keys m (fn (acc key) (ed-update acc key 80 24))))
(defn- uk-text (m) (buffer-text (ed-current-buf m)))

(describe "the init file's bindings compiled"
  (test "a key description and an M-x name become a sequence and the command's symbol"
    (let (user (ed-user-keys {"C-c f" 'duplicate-line} {}))
      (assert= [] (:warnings user))
      (assert= 1 (count (:global user)))
      (let ([sequence command] (first (:global user)))
        (assert= [:ctrl-c "f"] sequence)
        (assert= "cmd-duplicate-line" (ed-command-tail command)))))

  (test "a string names a command too, and nil unbinds"
    (let (user (ed-user-keys {"C-c f" "duplicate-line" "C-z" nil} {}))
      (assert= [] (:warnings user))
      (assert= [[:ctrl-z] nil] (first (:global user)))))

  (test "a mode is named as its mode line shows it, with or without -mode"
    (let (user (ed-user-keys {}
                 {'markdown-mode {"C-c d" 'duplicate-line} :prog {"C-c e" 'duplicate-line}}))
      (assert= #{"markdown" "prog"} (into #{} (keys (:modes user))))))

  (test "a key that does not read, or a command that is not one, is a warning naming it"
    (let (warnings (ed-user-key-warnings {"C-x foo" 'duplicate-line
                                          "C-c q" 'no-such-command-anywhere}
                     {'markdown {"<nope>" 'duplicate-line}}))
      (assert= 3 (count warnings))
      (is (any? warnings (fn (w) (and (includes? w ":keys \"C-x foo\"") (includes? w "foo")))))
      (is (any? warnings (fn (w) (includes? w "no command named no-such-command-anywhere"))))
      (is (any? warnings (fn (w) (includes? w ":mode-keys markdown \"<nope>\""))))))

  (test "a binding that did not compile is left out, the rest still bind"
    (let (user (ed-user-keys {"C-x foo" 'duplicate-line "C-c f" 'duplicate-line} {}))
      (assert= [[:ctrl-c "f"]] (vec (map (:global user) first))))))

(describe "a bound key runs through the dispatcher"
  (test "a global binding runs its command"
    (let (m (uk-press (uk-model "one\n" {:keys {"C-c f" 'duplicate-line}}) [:ctrl-c "f"]))
      (assert= "one\none\n" (uk-text m))))

  (test "binding into a prefix keeps the prefix's other keys"
    (let (before (input/ed-key-binding (uk-model "" {}) :ctrl-c)
          after (input/ed-key-binding (uk-model "" {:keys {"C-c f" 'duplicate-line}}) :ctrl-c))
      (is (map? before))
      (is (contains? after "f"))
      (assert= (into #{} (keys before)) (set/disj (into #{} (keys after)) "f"))))

  (test "nil unbinds a key"
    (let (m (uk-press (uk-model "abc" {:keys {"C-e" nil}}) [:ctrl-e]))
      (assert= 0 (buffer-point (ed-current-buf m)))))

  (test "a key can be rebound to another command"
    (let (m (uk-press (uk-model "abc" {:keys {"C-a" 'end-of-line}}) [:ctrl-a]))
      (assert= 3 (buffer-point (ed-current-buf m)))))

  (test "a mode binding runs in that mode's buffers and nowhere else"
    (let (cfg {:mode-keys {'markdown {"C-c d" 'duplicate-line}}})
      (assert= "# a\n# a\n" (uk-text (uk-press (uk-markdown "# a\n" cfg) [:ctrl-c "d"])))
      (assert= "# a\n" (uk-text (uk-press (uk-model "# a\n" cfg) [:ctrl-c "d"])))))

  (test "M-x reload-config binds what init.blsp now says"
    (let (base (temp-dir "bedit-userkeys-")
          _ (file/mkdir (path/join base "bedit"))
          _ (file/spit (path/join base "bedit" "init.blsp")
              (str "(config :keys {\"C-c f\" duplicate-line \"C-z\" nil}\n"
                "        :mode-keys {markdown-mode {\"C-c d\" duplicate-line}})"))
          reloaded (binding (*config-base* base)
                     (commands/cmd-reload-config (ed-init (make-buffer "one\n")) nil)))
      (assert= "config reloaded" (:echo reloaded))
      (assert= ["markdown"] (vec (keys (:modes (:user-keys reloaded)))))
      (assert= "one\none\n" (uk-text (uk-press reloaded [:ctrl-c "f"])))))

  (test "a reload without the binding takes it away"
    (let (bound (uk-model "one\n" {:keys {"C-c f" 'duplicate-line}})
          reloaded (config/apply-to-model bound {}))
      (assert= "one\n" (uk-text (uk-press reloaded [:ctrl-c "f"]))))))

(describe "help reports a user binding as the dispatcher runs it"
  (test "describe-key's table has it, in force"
    (let (m (input/ed-ensure-layers (uk-model "" {:keys {"C-c f" 'duplicate-line}}))
          entry (seq/find (scope-bindings (input/ed-scope m))
                  (fn (e) (= (:sequence e) [:ctrl-c "f"]))))
      (is (not (nil? entry)))
      (assert= nil (:shadowed-by entry))
      (assert= "cmd-duplicate-line" (ed-command-tail (:command entry)))))

  (test "where-is names the user's key"
    (let (m (input/ed-ensure-layers (uk-model "" {:keys {"C-c f" 'duplicate-line}}))
          keymap (scope-keymap (input/ed-scope m)))
      (assert= "C-c f" (ed-where-is-named keymap 'commands/cmd-duplicate-line)))))

(describe "the init file's bindings are checked with the rest of it"
  (test "init-warnings carries a key that does not read"
    (let (warnings (config/init-warnings {:keys {"C-x foo" 'duplicate-line}}
                     "/nonexistent/init.blsp"))
      (is (any? warnings (fn (w) (includes? w "C-x foo"))))))

  (test "a :keys value of the wrong shape is a settings warning, and binds nothing"
    (is (not (empty? (config/config-warnings {:keys {:ctrl-x 'duplicate-line}}))))
    (is (not (empty? (config/config-warnings {:mode-keys {'markdown ["C-c d"]}}))))
    (assert= []
      (config/config-warnings {:keys {"C-c f" 'duplicate-line "C-z" nil}
                               :mode-keys {'markdown {"C-c d" "duplicate-line"}}})))

  (test "the default init file documents both"
    (is (includes? config/*init-default-source* ":keys"))
    (is (includes? config/*init-default-source* ":mode-keys"))))

(describe "every key the profiles bind reads back from its label"
  ;; key-parse (std) is the inverse of the printer help uses — over bedit's real keymaps,
  ;; so a binding pasted from C-h k into init.blsp is the binding C-h k described.
  (test "emacs and vim"
    (doseq (profile [:emacs :vim])
      (let (wrong (seq/filter (keymap-bindings (profile-keymap profile))
                    (fn ([_ sequence]) (not (= sequence (key-parse (ed-keys-label sequence)))))))
        (assert= [] (vec (map wrong (fn ([_ sequence]) (ed-keys-label sequence)))))))))
