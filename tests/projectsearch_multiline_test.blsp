;; tests/projectsearch_multiline_test.blsp — a project search whose regexp names a line break
;; matches across lines (ripgrep's multiline mode).

(defmodule projectsearch-multiline-test
  (:use test))

(describe "a search across line breaks"
  (test "rg is asked for multiline when the regexp names \\n, not otherwise"
    (let (args (fn (pattern literal?)
                 ((:args (first project-search/*project-searchers*)) pattern literal?)))
      (is (includes? (args "end\\n\\s*def" false) "--multiline"))
      (refute (includes? (args "end" false) "--multiline"))
      (refute (includes? (args "end\\n" true) "--multiline"))))
  (test "it finds a match spanning two lines, when rg is installed"
    (when (os/which "rg")
      (let (root (temp-dir "bedit-multiline-"))
        (file/mkdir root)
        (file/spit (path/join root "a.rb") "  end\n  def run\n")
        (file/spit (path/join root "b.rb") "end def run\n")
        (let ([rows _] (project-search/project-grep root "end\\n\\s*def"))
          (is (includes? rows "a.rb"))
          (refute (includes? rows "b.rb")))))))
