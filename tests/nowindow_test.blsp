;; bedit in the terminal — `-nw` / `--no-window`, and by itself with no display (Emacs's
;; behaviour), over brood's terminal display (ADR-586/587): choosing the frontend, the clipboard
;; a terminal session reaches, a bracketed paste whole, and what only a window can do refused.
;; The live run — the real `main` under a pty, read through std/vt — is tools/drive-nw.blsp.
(defmodule nowindow-test
  (:use startup)
  (:use remote)
  (:use model)
  (:use input)
  (:use view)
  (:use pool)
  (:use main)
  (:use editor/buffer)
  (:use editor/layers)
  (:use test))

(describe "choosing the frontend"
  (test "-nw and --no-window ask for the terminal, whatever the display"
    (assert= (choose-frontend ["-nw"] true) [:terminal nil])
    (assert= (choose-frontend ["--no-window" "notes.txt"] true) [:terminal nil])
    (assert= (choose-frontend ["notes.txt"] true) [:window nil]))
  (test "no display: the terminal, and a note that says why"
    (let ([frontend note] (choose-frontend [] false))
      (do
        (assert= frontend :terminal)
        (is (includes? note "no display"))
        (is (includes? note "-nw")))))
  (test "the terminal needs stdin and stdout to be one"
    (assert= (terminal-unusable true true) nil)
    (is (includes? (terminal-unusable false true) "not a terminal"))
    (is (includes? (terminal-unusable true false) "not a terminal")))
  (test "an --attach -nw client is refused the same way when stdin or stdout is redirected"
    (is (map? (terminal-attach-display true true)))
    (let (refused (check-allow :discarded-catch
                    (try (terminal-attach-display false true) (catch e (error-message e)))))
      (is (and (string? refused) (includes? refused "not a terminal")))))
  (test "-nw is not the file to open"
    (assert= (remote-positional ["-nw" "notes.txt"]) "notes.txt")
    (assert= (remote-positional ["notes.txt" "-nw"]) "notes.txt")
    (assert= (remote-positional ["-nw"]) nil)))

(describe "a terminal session's clipboard"
  (test "with a display, the desktop's is read; without one, nothing is read back"
    (let (with-display (terminal-clipboard-bindings true)
          without (terminal-clipboard-bindings false))
      (do
        (assert= (:reader with-display) os/clipboard-get)
        (assert= (:primary-reader with-display) os/primary-get)
        (assert= ((:reader without)) nil)
        (assert= ((:primary-reader without)) nil)
        (is (fn? (:writer without)))
        (is (fn? (:primary-writer without))))))
  (test "a writer that answers its argument (os/clipboard-set does) says nothing of the kill"
    (binding (*clipboard-writer* (fn (text) text))
      (let (m0 (assoc (ed-init (make-buffer "hunter2 is the password\n")) :os-clipboard true)
            killed (ed-update m0 :ctrl-k 80 24)
            messages (let (i (ed-buffer-index-by-name killed "*Messages*"))
                       (if (nil? i) "" (buffer-text (ed-buf-at killed i)))))
        (do
          (assert= (first (:kill-ring killed)) "hunter2 is the password")
          (is (not (includes? (or (:echo killed) "") "hunter2")))
          (is (not (includes? messages "hunter2")))))))
  (test "only the dedicated note is said: a kill too large for the terminal's clipboard"
    (binding (*clipboard-writer* (fn (text) {:clipboard-note "too large for the terminal"}))
      (let (killed (ed-update (assoc (ed-init (make-buffer "abc\n")) :os-clipboard true)
                     :ctrl-k 80 24))
        (is (includes? (:echo killed) "too large")))))
  (test "the terminal writer's note is that shape"
    (is (string? (:clipboard-note (terminal-clipboard-note :too-large "x"))))
    (assert= (terminal-clipboard-note nil "x") nil)))

(describe "a bracketed paste ([:paste text], brood ADR-586)"
  (test "goes into the buffer whole, as ONE edit — nothing typed, so nothing paired or indented"
    (let (m0 (ed-init (set-buffer-type (make-buffer "") :brood))
          pasted (ed-update m0 [:paste "(defn f (x)\n(+ x 1))"] 80 24))
      (do
        (assert= (buffer-text (ed-current-buf pasted)) "(defn f (x)\n(+ x 1))")
        ;; one undo takes all of it back
        (assert= (buffer-text (ed-current-buf (ed-update pasted :ctrl-/ 80 24))) "")
        ;; and it is on the kill ring, as Emacs's xterm-paste leaves it
        (assert= (first (:kill-ring pasted)) "(defn f (x)\n(+ x 1))"))))
  (test "typing the same text would have paired the parens — which is why a paste is not typing"
    (let (typed (ed-update (ed-init (set-buffer-type (make-buffer "") :brood)) "(" 80 24))
      (assert= (buffer-text (ed-current-buf typed)) "()")))
  (test "goes in at point, and point ends after it"
    (let (m0 (ed-init (make-buffer "hello world"))
          at-word (ed-update (ed-update m0 :ctrl-a 80 24) :alt-f 80 24)
          pasted (ed-update at-word [:paste ", big"] 80 24))
      (do
        (assert= (buffer-text (ed-current-buf pasted)) "hello, big world")
        (assert= (buffer-point (ed-current-buf pasted)) 10))))
  (test "in a prompt it is typed into the prompt"
    (let (prompt (commands/cmd-find-file (ed-init (make-buffer "")) nil)
          pasted (ed-update prompt [:paste "abc"] 80 24))
      (is (string/ends-with? (:text (map/get-in pasted [:minibuffer :edit])) "abc"))))
  (test "a keyboard macro records it"
    (let (m (assoc (ed-init (make-buffer "")) :macro-recording []))
      (assert= (:macro-recording (ed-update m [:paste "x"] 80 24)) [[:paste "x"]]))))

(describe "what only a window can do"
  (test "a terminal session has one frame"
    (let (m (assoc (ed-init (make-buffer "")) :terminal true))
      (is (includes? (:echo (frames/cmd-make-frame m nil)) "one frame"))))
  (test "a terminal model draws no sub-cell shapes"
    (let (frame (ed-view (assoc (ed-init (make-buffer "one\ntwo\n")) :terminal true) 80 24))
      (is (not (includes? (pr-str frame) ":frect"))))))
