;; A window that falls back to something lesser (brood ADR-636: the GPU painting in software, a
;; font standing in, grey text) tells the editor as `[:display-degraded …]`, and the echo area
;; says so.
(defmodule display-degraded-test
  (:use test)
  (:use model)
  (:use editor/buffer)
  (:use events))

(describe "a display that fell back"
  (test "is said in the echo area"
    (let (m (ed-init (make-buffer ""))
          handler (ed-event-handler :display-degraded)
          told ((reflect/eval handler) m
                 [:display-degraded {:what :gpu :reason "only a software adapter"}]
                 20
                 80
                 24))
      (assert= (:echo told) "display: gpu — only a software adapter")))
  (test "a detail with nothing in it still reads"
    (assert= (display-degraded-note {}) "display: degraded — fell back")))
