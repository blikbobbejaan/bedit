(defmodule recent-test
  (:use projects)
  (:use test))

;; The shared recency-ordering core that find-file, project find-file, and M-x all order
;; through (`float-recent`), plus the persisted M-x history mirroring recentf.

(describe "float-recent — the one shared recency core"
  (test "floats present recents to the front in recency order, rest in given order"
    (assert= (float-recent (list "a" "b" "c" "d") (list "c" "a"))
      (list "c" "a" "b" "d")))
  (test "empty recent leaves the candidates untouched"
    (assert= (float-recent (list "a" "b" "c") (list)) (list "a" "b" "c")))
  (test "recents not among the candidates are ignored"
    (assert= (float-recent (list "a" "b") (list "z" "b" "q")) (list "b" "a")))
  (test "sort-project-files orders via recency then the given file order"
    ;; project-recent reads persisted state; here we exercise the pure ordering directly
    (assert= (float-recent (list "src/a.blsp" "src/b.blsp" "README.md")
               (list "README.md" "src/b.blsp"))
      (list "README.md" "src/b.blsp" "src/a.blsp"))))

;; recent-commands / remember-command! are structurally identical to recentf
;; (recent-files / remember-file!) — one persist-mru write to a capped cache file — so the
;; persistence itself is covered by the recentf round-trip tests; here we pin the contract.
(describe "recent commands (M-x history, persisted like recentf)"
  (test "the cache file lives under the editor state dir"
    (is (includes? (recent-commands-file) "recent-commands.blsp")))
  (test "recent-commands returns a vector (empty when unset)"
    (is (vector? (persist-read (recent-commands-file))))))

;; ---- frecency: recency plus visit counts, as the fuzzy ranking's :boost -------
(describe "history-boost — what a history adds to a match's score"
  (test "the most recent entry adds most, one less per place, never below the floor"
    (let (boost (history-boost (into [] (map (range 30) (fn (i) (str "f" i))))))
      (assert= *history-recency-boost* (get boost "f0"))
      (assert= (dec *history-recency-boost*) (get boost "f1"))
      (assert= *history-recency-floor* (get boost "f29"))))
  (test "visits add on top of recency, capped"
    (assert= {"a" 24 "b" 29 "c" 20} (history-boost ["a" "b"] {"b" 3 "c" 20})))
  (test "no history, no boost"
    (assert= {} (history-boost []))))

(describe "persist-count — the visit counts beside the recent list"
  (test "counts each entry, and drops the least-counted past the cap"
    (let (file (str (temp-dir "bedit-count-") "/counts.blsp"))
      (do
        (persist-count file "a")
        (persist-count file "a")
        (persist-count file "b")
        (assert= {"a" 2 "b" 1} (persist-read-value file {}))
        (persist-count file "c" 2)
        ;; three entries, cap two: `b` and `c` tie at one, `a` (two) is kept
        (is (= 2 (count (persist-read-value file {}))))
        (assert= 2 (get (persist-read-value file {}) "a"))
        (file/rm file)))))
