;; tests/codecrumbs_test.blsp — breadcrumbs for code: the definitions point is inside, by name,
;; read off the held parse; a Lisp's top-level form.

(defmodule codecrumbs-test
  (:use test)
  (:use model)
  (:use editor/buffer)
  (:use codecrumbs))

(defn- crumbs-at (text file point)
  ;; the header line's crumbs with point at `point` of a `file` buffer, its parse held
  (let (m (ed-init (goto-char (make-buffer text file file) point))
        buffer (ed-current-buf m)
        lang (ed-mode-service buffer :ts-lang)
        tree (when lang (editor/treesit/open-tree (buffer-rope buffer) lang))
        found (headerline/crumbs buffer tree))
    (when tree (editor/treesit/free-tree tree))
    found))

(def- ruby
  "module Shop\n  class Cart\n    def total(items)\n      items.sum\n    end\n  end\nend\n")

(describe "breadcrumbs for code"
  (test "a definition's name is its first word that is not a keyword"
    (assert= (definition-name "  pub async fn fetch(url: &str) {") "fetch")
    (assert= (definition-name "defmodule XB.Probe do") "XB.Probe")
    (assert= (definition-name "class Cart < Base") "Cart"))
  (test "Ruby: the module, class and method around point"
    (assert= (crumbs-at ruby "a.rb" 45) '("Shop" "Cart" "total")))
  (test "Elixir: the defmodule and def calls around point"
    (assert= (crumbs-at "defmodule XB.Probe do\n  def run(x) do\n    x\n  end\nend\n" "a.ex" 34)
      '("XB.Probe" "run")))
  (test "outside every definition, none"
    (assert= (crumbs-at "x = 1\n" "a.rb" 1) '()))
  (test "a Lisp: the top-level form's name"
    (assert= (crumbs-at "(defn total (items)\n  (sum items))\n" "a.blsp" 25) '("total"))))
