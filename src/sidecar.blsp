(defmodule sidecar
  "Where a file's auto-save sidecar lives and what it says when you come back: Emacs's
`#file#` beside the file, and for a file edited as another user a PRIVATE one under the
editor's state folder, its TRAMP path percent-encoded in the name (hashed past
`*private-sidecar-name-max*`, the path in `NAME.spec` beside it). Names and files only: when
one is written is `autosave`'s, and putting one back is `recover`'s."
  (:use editor/buffer)) ; buffer-file

(defn ed-private-auto-save-dir ()
  "Where the sidecars of files edited AS ROOT go (`sudo/…`, [[ed-auto-save-path]]): the
editor's own state folder, `…/bedit/state/auto-save` — never beside the file, where only
root could write one and anyone who can read the directory would see the name."
  (path/join (config-paths/config-dir) "state" "auto-save"))

(defn sidecar-user (sudo)
  "The user a file is edited as, from a `sudo` argument: a user's name as given, `true` for
root, nil (or false) for a file edited as yourself.

    (sidecar/sidecar-user \"www\")   ;=> \"www\"
    (sidecar/sidecar-user true)   ;=> \"root\"
    (sidecar/sidecar-user false)   ;=> nil"
  (cond
    (string? sudo) sudo
    (= true sudo) "root"
    else nil))

(defn ed-auto-save-path (path &optional (sudo false))
  "The auto-save sidecar path: `#basename#` in the same directory as `path` — or, for a file
edited as another user (`sudo`: the user's name, or `true` for root, a buffer's `:sudo` and
`:sudo-user`), a name in [[ed-private-auto-save-dir]] that is the whole TRAMP-style path,
percent-encoded ([[private-sidecar-name]]) — owner-only like every sidecar.

    (sidecar/ed-auto-save-path \"/home/me/notes.txt\")   ;=> \"/home/me/#notes.txt#\"
    (path/basename (sidecar/ed-auto-save-path \"/etc/hosts\" true))   ;=> \"#%2Fsudo::%2Fetc%2Fhosts#\""
  (let (user (sidecar-user sudo))
    (if user
      (path/join (ed-private-auto-save-dir) (private-sidecar-name path user))
      (path/join (path/dirname path) (str "#" (path/basename path) "#")))))

(def *private-sidecar-name-max* 200)
;; The longest private sidecar name spelled out whole; a longer one is hashed (most
;; filesystems refuse a name past 255 bytes, and the auto-save failed with only a log line).

(defn- sidecar-spec (path user)
  ;; the TRAMP spelling of `path` edited as `user`: `/sudo::/etc/hosts`, `/sudo:www@:/srv/a`
  (str "/sudo:" (if (= user "root") "" (str user "@")) ":" path))

(defn- percent-encode (text)
  (string/replace (string/replace text "%" "%25") "/" "%2F"))

(defn- percent-decode (text)
  ;; `percent-encode` read back: `%2F` a slash, `%25` a percent sign
  (letrec (decode (fn (rest decoded)
                    (cond
                      (= rest "") decoded
                      (string/starts-with? rest "%2F")
                        (decode (string/substring rest 3 (string/length rest)) (str decoded "/"))
                      (string/starts-with? rest "%25")
                        (decode (string/substring rest 3 (string/length rest)) (str decoded "%"))
                      else
                        (decode (string/substring rest 1 (string/length rest))
                          (str decoded (string/substring rest 0 1))))))
    (decode text "")))

(defn private-sidecar-name (path &optional (user "root"))
  "The private sidecar's name for `path` edited as `user`: `#…#` around its TRAMP path
(`/sudo::/etc/hosts`, `/sudo:www@:/srv/a`) PERCENT-ENCODED (`%` as `%25`, `/` as `%2F`), so
no two files or users share one — Emacs's `!!` / `!` scheme does not tell `/a/!b` from
`/a!/b`, and a name without the user mixed root's sidecar with www's. A name that would pass
`*private-sidecar-name-max*` bytes is `#` + a hash of the TRAMP path + the tail of the file's
name + `#` instead, its TRAMP path kept beside it in `NAME.spec` ([[ensure-private-sidecar]]).
[[private-sidecar-spec]] reads either back.

    (sidecar/private-sidecar-name \"/etc/hosts\")   ;=> \"#%2Fsudo::%2Fetc%2Fhosts#\"
    (sidecar/private-sidecar-name \"/srv/a\" \"www\")   ;=> \"#%2Fsudo:www@:%2Fsrv%2Fa#\""
  (let (spec (sidecar-spec path user)
        whole (str "#" (percent-encode spec) "#"))
    (if (<= (count (string/->bytes whole)) *private-sidecar-name-max*)
      whole
      (let (base (string/replace (string/replace (path/basename path) "%" "_") "#" "_")
            tail (if (> (string/length base) 40)
                   (string/substring base (- (string/length base) 40) (string/length base))
                   base))
        (str "#" (string/substring (hash/sha256 spec) 0 32) "-" tail "#")))))

(defn private-sidecar-hashed? (name)
  "Whether private sidecar `name` is a hashed one ([[private-sidecar-name]]), whose TRAMP path
is in `NAME.spec` beside it."
  (not (string/starts-with? name "#%2F")))

(defn private-sidecar-spec (name &optional (dir nil))
  "The TRAMP path (`/sudo::/etc/hosts`) a private sidecar `name` in `dir` belongs to
([[private-sidecar-name]] read back) — a hashed name's from its `NAME.spec` — or nil when
`name` is not one.

    (sidecar/private-sidecar-spec \"#%2Fsudo::%2Fetc%2Fa!b#\")   ;=> \"/sudo::/etc/a!b\"
    (sidecar/private-sidecar-spec \"notes\")   ;=> nil"
  (cond
    (or (not (string/starts-with? name "#"))
      (not (string/ends-with? name "#"))
      (< (string/length name) 3))
      nil
    (not (private-sidecar-hashed? name))
      (percent-decode (string/substring name 1 (dec (string/length name))))
    (nil? dir) nil
    else
      (let (spec-file (path/join dir (str name ".spec")))
        (when (file/exists? spec-file)
          (check-allow :discarded-catch (try (string/trim (file/slurp spec-file)) (catch _ nil)))))))

(defn sidecar-spec-parts (spec)
  "`[path user]` of a TRAMP sudo path (`/sudo::/etc/hosts` → root, `/sudo:www@:/x` → www), or
nil when `spec` is not one.

    (sidecar/sidecar-spec-parts \"/sudo:www@:/srv/a\")   ;=> [\"/srv/a\" \"www\"]
    (sidecar/sidecar-spec-parts \"/sudo::/etc/hosts\")   ;=> [\"/etc/hosts\" \"root\"]"
  (when (and (string? spec) (string/starts-with? spec "/sudo:"))
    (let (rest (string/substring spec 6 (string/length spec))
          colon (index-of rest ":"))
      (when (>= colon 0)
        (let (host (string/substring rest 0 colon)
              user (if (string/ends-with? host "@")
                     (string/substring host 0 (dec (string/length host)))
                     "root"))
          [(string/substring rest (inc colon) (string/length rest)) (if (= user "") "root" user)])))))

(defn legacy-private-sidecar-path (name)
  "The file a private sidecar `name` written before the user went into the name
(2026-11-04/05: `#%2Fetc%2Fhosts#`, root's) belongs to, or nil when `name` is not one — a
current name decodes to a TRAMP path (`/sudo::…`) instead.

    (sidecar/legacy-private-sidecar-path \"#%2Fetc%2Fhosts#\")   ;=> \"/etc/hosts\"
    (sidecar/legacy-private-sidecar-path \"#%2Fsudo::%2Fetc%2Fhosts#\")   ;=> nil"
  (let (decoded (when (and (not (private-sidecar-hashed? name)) (string/ends-with? name "#"))
                  (private-sidecar-spec name)))
    (when (and decoded
            (string/starts-with? decoded "/")
            (not (string/starts-with? decoded "/sudo:")))
      decoded)))

(defn ed-migrate-private-sidecars (&optional (dir (ed-private-auto-save-dir)))
  "Rename every private sidecar in `dir` written under the old name
([[legacy-private-sidecar-path]]) to the name it has now — root's file, as every old one was
— so recover-session lists it and visiting the file says it has auto-save data. Where the
new name is already there, the newer of the two stays. Returns how many were moved; a
missing `dir` is none, and a rename that fails is logged and left for the next start."
  (if (not (file/dir? dir))
    0
    (fold (file/ls dir)
      0
      (fn (moved name)
        (let (path (legacy-private-sidecar-path name))
          (if (nil? path)
            moved
            (let (old (path/join dir name)
                  new (path/join dir (private-sidecar-name path "root")))
              (check-allow :discarded-catch
                (try
                  (do
                    (if (and (file/exists? new)
                          (>= (or (file/mtime new) 0) (or (file/mtime old) 0)))
                      (file/rm old)
                      (do
                        (when (private-sidecar-hashed? (path/basename new))
                          (file/spit-private (str new ".spec") (sidecar-spec path "root")))
                        (file/rename old new)))
                    (inc moved))
                  (catch failure
                    (do
                      (log/warn (str "auto-save: could not move " old ": " (error-message failure)))
                      moved)))))))))))

(defn ensure-private-sidecar (path user)
  "Get ready to write `path`'s private sidecar as `user` edits it: its folder made owner-only
(0700, since the names in it say which files were being edited as root) and, for a hashed name
([[private-sidecar-name]]), its TRAMP path written beside it (`NAME.spec`, owner-only) for
recovery. The sidecar's path."
  (let (sidecar (ed-auto-save-path path user)
        name (path/basename sidecar))
    (do
      (file/mkdir-private (path/dirname sidecar))
      (when (private-sidecar-hashed? name)
        (file/spit-private (str sidecar ".spec") (sidecar-spec path user)))
      sidecar)))

(defn ed-buffer-auto-save-path (buf)
  "The sidecar of file buffer `buf` ([[ed-auto-save-path]]), private when it is edited as
another user; nil for a buffer with no file."
  (let (file (buffer-file buf)) (when file (ed-auto-save-path file (buffer-sudo-user buf)))))

(defn ed-forget-auto-save (buf)
  "Remove file buffer `buf`'s sidecar, private or not: its text has been saved, or given up."
  (ed-remove-auto-save (buffer-file buf) (buffer-sudo-user buf)))

(defn buffer-sudo-user (buf)
  "The user buffer `buf` is edited as through sudo (`:sudo-user`, root when unnamed), or nil
for a buffer edited as yourself — the `sudo` argument the sidecar functions take.

    (sidecar/buffer-sudo-user {:sudo true :sudo-user \"www\"})   ;=> \"www\"
    (sidecar/buffer-sudo-user {})   ;=> nil"
  (when (= true (:sudo buf)) (or (:sudo-user buf) "root")))

(defn ed-remove-auto-save (path &optional (sudo false))
  "Delete `path`'s `#basename#` sidecar (the private one when `sudo` names a user, `true`
root), and a hashed one's `NAME.spec`, if there is one — what a successful write of the file
does (`C-x C-s`, `C-x C-w`), since the sidecar's text is now on disk. A nil `path` (a fileless
buffer) is a no-op; a sidecar that cannot be removed is logged, never raised — the save itself
succeeded."
  (let (sidecar (when path (ed-auto-save-path path sudo)))
    (when sidecar
      (doseq (file [sidecar (str sidecar ".spec")])
        (when (file/exists? file)
          (try
            (file/rm file)
            (catch failure
              (log/warn (str "could not remove auto-save " file ": " (error-message failure))))))))))

;; ---- recovering from a sidecar ------------------------------------------------
;; The sidecars are worth something only if they come back: a file visited with a sidecar
;; newer than itself says so, and `recover/cmd-recover-this-file` puts the text back.

(defn ed-auto-save-newer? (path &optional (sudo false))
  "Whether `path` has an auto-save sidecar (the private one when `sudo` names a user, `true` root) written after the
file was — unsaved text the editor (or one that crashed) left behind. A sidecar of a file
that no longer exists counts."
  (let (sidecar-mtime (file/mtime (ed-auto-save-path path sudo))
        file-mtime (file/mtime path))
    (and (not (nil? sidecar-mtime)) (or (nil? file-mtime) (> sidecar-mtime file-mtime)))))

(defn ed-recovery-note (path &optional (sudo false))
  "What visiting `path` (as the user `sudo` names, `true` root) should say when it has newer auto-save data
([[ed-auto-save-newer?]]), or nil. Emacs's \"has auto save data; consider M-x
recover-this-file\".

    (sidecar/ed-recovery-note \"/nowhere/at/all\")   ;=> nil"
  (when (ed-auto-save-newer? path sudo)
    (str (path/basename path) " has unsaved auto-save data — M-x recover-this-file to restore it")))
