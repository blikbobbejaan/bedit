(defmodule glyphless
  "The invisible format characters made visible (Emacs's `glyphless-char-display`, its
`hex-code` method): a zero width space, a word joiner, a BOM in mid-text, a tag character —
and the bidi controls a \"Trojan Source\" attack hides in, which Emacs's
`highlight-confusing-reorderings` points at.

Brood lays each one out as its `<200b>` escape when `*glyphless-display*` is `:hex-code`
(brood ADR-556) — the view, the row tables, the wrap and the clip all measure through that one
layout, which `conventions/with-cell-layout` binds from the init file's `:glyphless-chars`. So
the escape is already on screen and the caret, a click and a wrap already agree with it; what
this module adds is its FACE: highlight ranges over each glyphless character, dim like Emacs's
`escape-glyph` for most, a warning for a bidi control. The view tiles them under the region and
the search hits, which keep their background over an escape.

A BOM at the start of a file shows as `<feff>` too: bedit has no coding systems and keeps a
file's text as it is, so the BOM is a character of the buffer — C-f steps over it, a save
writes it back — and is shown as one. ZWJ and ZWNJ are never shown (brood ADR-556: they join
emoji and Persian or Indic letters, and the class is decided per character)."
  (:use editor/buffer) ; buffer-rope
  (:use memo) ; defmemo — asked every frame, recomputed only when the text or the window moves
  (:use theme)) ; the palette the faces are formulas over

;; Emacs's `escape-glyph`: the escape reads as furniture, not as text
(theme/defchrome face-glyphless {:fg *peach* :bg (theme/mix *overlay0* *base* 0.18)})
;; a bidi control reorders what is shown around it: marked as a hazard
(theme/defchrome face-glyphless-bidi {:fg *base* :bg *red*})

(defn bidi-control? (character)
  "Whether the one-character string `character` is a bidi formatting character — the
embeddings and overrides U+202A–202E, the isolates U+2066–2069, the marks U+200E / U+200F and
U+061C: the ones that reorder the text shown around them.

    (glyphless/bidi-control? \"\\u{202e}\")   ;=> true
    (glyphless/bidi-control? \"\\u{200b}\")   ;=> false"
  (let (code (or (first (string/->codepoints character)) 0))
    (or (and (>= code 0x202A) (<= code 0x202E))
      (and (>= code 0x2066) (<= code 0x2069))
      (= code 0x200E)
      (= code 0x200F)
      (= code 0x061C))))

(defn text-ranges (text base faces)
  "The highlight ranges `[from to face]` of the glyphless characters of `text`, whose first
character is at buffer offset `base`: each one's own range, in `(second faces)` for a bidi
control ([[bidi-control?]]) and `(first faces)` otherwise.

    (glyphless/text-ranges \"a\\u{200b}b\" 10 [:dim :hazard])   ;=> ([11 12 :dim])"
  (let ([plain bidi] faces)
    (map (string/glyphless-indices text)
      (fn (index)
        [(+ base index)
          (+ base index 1)
          (if (bidi-control? (string/substring text index (inc index))) bidi plain)]))))

;; check-allow: a hit comes back out of the memo's store, which the checker reads as unknown;
;; the store only ever holds what the body built, a list of ranges.
(check-allow :trusted
  (defmemo ranges-at 4 (rope windows faces)
    "[[ranges]] over each char range `[from to]` of `windows`, remembered on what it reads
(`faces` too, so a theme switch recomputes)."
    (mapcat windows (fn ([from to]) (text-ranges (text/slice rope from to) from faces)))))

(defn ranges (buf top rows &optional (clip nil))
  "The glyphless highlight ranges `[from to face]` of `buf`'s lines `top` through `top +
rows`, nothing when the editor hides them (`*glyphless-chars*` `:hidden`). A long
line is read only over the window of it the pane shows (`clip`, `panes/ed-visible-windows`),
so a one-line multi-megabyte file costs its window."
  (if (= *glyphless-chars* :hidden)
    '()
    (let (rope (buffer-rope buf))
      (ranges-at rope
        (panes/ed-visible-windows rope top rows clip)
        [face-glyphless face-glyphless-bidi]))))
