(defmodule spanpaint
  "What colours a line: the span band a pane keeps (`spancache`) sliced per line and tiled onto
its text, the layers under the mode's colouring (ANSI, diagnostics underlines), bracket matches as
overrides, and the highlight ranges (the region, the transient overlays) cut to a line."
  (:use editor/buffer)
  (:use model)
  (:use spancache)
  (:use editor/highlight)
  (:use theme)
  (:use ui-kit)
  (:use editor/display)
  (:use memo))

;; The chrome faces are the theme's (src/theme.blsp), read by their `face-*` names at
;; paint time. They used to be copied into `ed-face-*` aliases here at LOAD time, so a
;; theme switch re-bound `face-region` and the view kept painting the old palette's. The
;; selection is a background *tint* (`face-region`, a `:bg` only) rather than
;; reverse-video, so syntax colours stay visible under it; `face-hl-line` is a soft
;; surface band.
(defn ed-line-chunks (vis base spans hl-ranges overrides)
  "`[substring face]` chunks tiling visible substring `vis` (its first char at buffer
offset `base`), via `highlight/fontify-runs`: the lexer `spans` coloured, with the
region/overlay `hl-ranges` (`[lo hi face]`) and the bracket/diagnostic `overrides`
(`[pos face]`, each the one-char range `[pos (inc pos) face]`) merged on top. Overrides
are ordered before `hl-ranges`, so a region/overlay face wins — the old
span→override→hl merge order."
  (fontify-runs vis
    base
    spans
    ;; almost every row has no override, and `map` + `append` over an empty list still
    ;; cost more than the native tiling they feed
    (if (empty? overrides)
      hl-ranges
      (append (map overrides (fn (o) (let ([p f] o) [p (inc p) f]))) hl-ranges))))

(defn- ed-chunks->ops-impl (row x col limit chunks acc)
  "Tail-recursive: `text` ops for `[substring face]` `chunks` laid left-to-right from
screen column `x`, where `col` is the LINE column the next chunk starts at (its tab stops
are the line's, not the chunk's — ADR-342) and `limit` the screen column past which
nothing is painted. Each chunk's tabs are expanded at its column (`string/expand-tabs`)
and it advances `x` by its cell width, so a wide glyph or a tab pushes what follows."
  (if (or (empty? chunks) (>= x limit))
    (reverse acc)
    (let ([s f] (first chunks)
          expanded (string/expand-tabs s col)
          ;; ONE width per chunk where there were three. The expansion occupies exactly
          ;; `(string/display-width s col)` cells (std's guarantee), so its width is also the
          ;; line-column advance; and only a chunk that overruns the limit needs the clip,
          ;; whose own width is then measured again. A row is a dozen chunks and a typing
          ;; frame re-renders every row, so these were most of a row's cost.
          full-cells (string/display-width expanded)
          room (- limit x)
          shown (if (<= full-cells room) expanded (ed-fit-cells expanded room))
          cells (if (<= full-cells room) full-cells (string/display-width shown)))
      (ed-chunks->ops-impl row
        (+ x cells)
        (+ col full-cells)
        limit
        (rest chunks)
        (cons (if (nil? f) (text row x shown) (text row x shown f)) acc)))))

(sig ed-chunks->ops (int int list &optional int int -> list))

(defn ed-chunks->ops (row x chunks &optional (col 0) (limit 100000))
  "`text` ops for `[substring face]` `chunks`, starting at screen column `x` on `row`;
`col` is the line column the first chunk starts at (0 unless the view is h-scrolled) and
`limit` the screen column to clip at."
  (ed-chunks->ops-impl row x col limit chunks '()))

(def ed-bracket-scan 4000) ; max chars each side of point the bracket matcher scans

;; check-allow: a hit comes back out of the memo's store, which the checker reads as
;; unknown; the store only ever holds what the body below built, a list of `[pos face]`.
(check-allow :trusted
  (defmemo ed-bracket-overrides-at 1 (rope pt bm faces)
    "`ed-bracket-overrides` for point `pt` in `rope`, matched by the mode's `bm` and painted
in `faces` (`[here match error]`). Memoised on all four — one entry: it hits on idle frames,
ticks and blink events where nothing changed, and misses after any edit or motion. The
faces are in the key so a theme switch repaints the pair at once; before, the old colours
stayed until point moved."
    (let ([face-here face-match face-error] faces
          n (text/length rope)
          lo (math/max 0 (- pt ed-bracket-scan))
          hi (math/min n (+ pt ed-bracket-scan))
          clipped (or (> lo 0) (< hi n))
          r (bm (text/slice rope lo hi) (- pt lo)))
      (cond
        (nil? r) '()
        (= (second r) :unmatched) (if clipped '() (list [(+ lo (first r)) face-error]))
        ;; The two ends get DIFFERENT faces, so the solid block always means "the other end":
        ;; the bracket at point (the one just left of the cursor, else under it — the
        ;; matcher's own adjacency rule) takes an underline accent the cursor sits on, its
        ;; partner the block. One glance answers which end of the pair you are at.
        else
          (let (relpt (- pt lo)
                a (first r)
                b (second r)
                adj (if (or (= a (dec relpt)) (= a relpt)) a b)
                far (if (= adj a) b a))
            (list [(+ lo adj) face-here] [(+ lo far) face-match]))))))

(sig ed-bracket-overrides-at (any int fn vector -> list))

;; check-allow: as `ed-bracket-overrides-at`'s — a hit is the memo store's, a `[pos face]` list
(check-allow :trusted
  (defmemo ed-bracket-tree-overrides-at 1 (tree rope pt bm faces)
    "`ed-bracket-overrides` over the buffer's held `tree` of exactly `rope`: the mode's
`:bracket-match-tree` service `bm` matches in the whole document, so there is no window
and no clipping — an `:unmatched` is the parse's own verdict. Memoised like the window's."
    (let ([face-here face-match face-error] faces
          r (bm tree rope pt))
      (cond
        (nil? r) '()
        (= (second r) :unmatched) (list [(first r) face-error])
        else
          (let (a (first r)
                b (second r)
                adj (if (or (= a (dec pt)) (= a pt)) a b))
            (list [adj face-here] [(if (= adj a) b a) face-match]))))))

(sig ed-bracket-tree-overrides-at (any any int fn vector -> list))

(defn ed-bracket-overrides (buf &optional (tree nil))
  "`[pos face]` overrides for the bracket pair adjacent to point, via `buf`'s mode
`:bracket-match` service: the matched pair in the match face, a lone unmatched bracket
in the error face, or `()` when there's no service or no bracket at point. The match is
sought within a `ed-bracket-scan`-char window each side of point (not the whole
buffer), so a deep point in a large file costs O(window), not O(point); a partner
beyond the window is treated as not found, and a window-clipped `:unmatched` is
suppressed (no false red) rather than scanning the rest of the buffer.

`tree` is the buffer's held parse of exactly its text, when the caller has one
(`syntaxtree`): a tree-sitter mode's `:bracket-match-tree` then reads the pair off it
(`tsbrackets/match-tree`) — no window, no parse of a slice."
  (let (bm-tree (when tree (ed-mode-service buf :bracket-match-tree))
        bm (ed-mode-service buf :bracket-match)
        faces [face-bracket-here face-bracket-match face-bracket-error])
    (cond
      ;; no bracket match on a buffer whose line may be a megabyte of brackets (so-long)
      (:line-services-off buf) '()
      bm-tree (ed-bracket-tree-overrides-at tree (buffer-rope buf) (buffer-point buf) bm-tree faces)
      (nil? bm) '()
      else (ed-bracket-overrides-at (buffer-rope buf) (buffer-point buf) bm faces))))

(sig ed-overrides-by-line (any any -> map))

(defn ed-overrides-by-line (rope overrides)
  "Flat `[pos face]` `overrides` grouped by the line each position falls on — `{line ->
([pos face] …)}`, `{}` for none.

This exists for the **memo**, not for the painting. Every visible row is a memoised
fragment (`ed-visible-lines`, ADR-336) whose deps name what its ops read; handing each
row the whole pane's override list made `overrides` a dep that changes whenever ANY of
them does — and the bracket-match half changes on every cursor move, so one `C-n`
invalidated all forty-nine rows and the memo cost more than it saved (measured: `view`
2.92 ms with every fragment hitting, 6.53 ms after a motion, 5.62 ms with no memo at
all). Grouped, a row's dep is only what lands on that row, so a motion re-renders the
two lines the bracket pair moved between and nothing else.

Each line's list keeps the order it had in `overrides` — the tiler merges later-wins, so
a diagnostic underline on the same character as a bracket face must still come second.

An override whose position is not IN the rope is dropped rather than resolved. Overrides
are derived from state that can lag the text by a keystroke — a diagnostic computed
against the previous version, a playground note anchored before an edit shortened the
buffer — and `text/char->line` RAISES on an out-of-range index. Raising here kills the
whole frame: the editor paints `render error: %rope-char->line: index 179 out of bounds`
across the echo row and nothing else, for a stale underline. A mark that has fallen off
the end is worth exactly one missing underline."
  (let (len (text/length rope))
    (fold (reverse overrides)
      {}
      (fn (acc o)
        (let (pos (first o))
          (if (or (not (int? pos)) (< pos 0) (>= pos len))
            acc
            (let (line (text/char->line rope pos))
              (assoc acc line (cons o (or (get acc line) '()))))))))))

(defn- ed-span-skip (spans n i lo)
  "The first index at or after `i` whose span has not already ended by `lo`. The cursor only
moves forward, which is what makes the whole walk one pass rather than one per line."
  (if (and (< i n) (<= (second (nth spans i)) lo)) (ed-span-skip spans n (inc i) lo) i))

(defn ed-span-seek (spans n at)
  "The first of the `n` ascending `spans` that has not ended by offset `at`, by bisection
— so a pane whose viewport sits after a long history (a terminal buffer's scrollback,
forty thousand faces) does not walk that history every frame to reach its first span."
  (letrec (go (fn (lo hi)
                (if (>= lo hi)
                  lo
                  (let (mid (math/quot (+ lo hi) 2))
                    (if (<= (second (nth spans mid)) at) (go (inc mid) hi) (go lo mid))))))
    (go 0 n)))

(defn- ed-span-take (spans n i hi acc)
  "The spans from `i` that start before `hi`, in order."
  (if (or (>= i n) (>= (first (nth spans i)) hi))
    (reverse acc)
    (ed-span-take spans n (inc i) hi (cons (nth spans i) acc))))

(defn ed-spans-by-line (buf spans top last-line)
  "The lexer `spans` (ascending, non-overlapping, absolute offsets) grouped by the line each
covers — `{line -> (span …)}` over `top`..`last-line`; `{}` when there are none. One co-walk
of the lines and the band."
  (if (or (nil? spans) (empty? spans))
    {}
    (ed-spans-by-line-at (buffer-rope buf) spans top last-line)))

;; check-allow: a hit comes back out of the memo's store, which the checker reads as
;; unknown; the store only ever holds what the body below built, a `{line -> spans}` map.
(check-allow :trusted
  (defmemo ed-spans-by-line-at 8 (rope spans top last-line)
    "`ed-spans-by-line` over `rope`, remembered for the last eight panes' arguments.

Memoised because it is asked EVERY frame and its answer only changes when the band, the text
or the viewport does: the band is the `:span-cache` entry's own vector (the same heap cell
while it covers the viewport) and the rope is a handle, so a blink, a hover or a motion that
does not scroll hits on a few `=` that answer at once. Measured: 270 µs of a 1.8 ms
all-hit frame on src/view.blsp. A hit also hands every row the SAME span lists as last
turn, so the row memo's `=` on them (`ed-visible-lines`) stops walking a fresh copy.

A line's end is `ed-line-end`, not the length of the line's text:
that read allocated every visible line as a string just to measure it.

`spans` may also be several SOURCES (`ed-span-sources`), each sliced on its own and the
lines' lists joined in source order — a terminal's forty thousand history faces are one
source that a repaint of the screen below them does not rebuild.

Or two LAYERS (`ed-span-layers`): each sliced on its own, then per line the upper one's
spans with the lower one's showing only where the upper colours nothing."
    (cond
      (and (map? spans) (contains? spans :span-under))
        (let (slice (fn (layer)
                      (if (or (nil? layer) (empty? layer))
                        {}
                        (ed-spans-by-line-at rope layer top last-line)))
              over (slice (:span-over spans))
              under (slice (:span-under spans))
              palette (:palette spans))
          (fold under
            over
            (fn (merged [line got])
              (assoc merged
                line (ed-span-underlay (get merged line) (ed-span-resolve got palette))))))
      (map? spans)
        (ed-span-lines-merge (map (:span-sources spans)
                               (fn (source)
                                 (if (or (nil? source) (empty? source))
                                   {}
                                   (ed-spans-by-line-at rope source top last-line)))))
      else
        (let (v (if (vector? spans) spans (into [] spans))
              n (count v)
              ;; start at the first span the top line can show, found by bisection, not by
              ;; skipping forward from the band's first span
              first-index (ed-span-seek v n (text/line->char rope (math/max 0 top)))
              walked (fold (range (math/max 0 top) (inc (math/max 0 last-line)))
                       [first-index {}]
                       (fn (state line)
                         (let ([i acc] state
                               lo (text/line->char rope line)
                               hi (textpos/ed-line-end rope line)
                               i2 (ed-span-skip v n i lo)
                               got (ed-span-take v n i2 hi '()))
                           [i2 (if (empty? got) acc (assoc acc line got))]))))
          (second walked)))))

(defn ed-span-sources (sources)
  "Several ascending span vectors, each wholly before the next, handed to the view as ONE
`spans` value — what a buffer whose faces arrive in parts gives the renderer instead of
joining them: a terminal's history (thousands of faces, unchanged while the program
repaints its screen) and the screen's own. Joining them copied the whole history per
repaint; kept apart, each is sliced per line on its own (`ed-spans-by-line-at`) and its
cell stays the same between frames, so the slicing of the history is remembered too.

    (spanpaint/ed-span-sources [[[0 1 {}]] [[4 5 {}]]])   ;=> {:span-sources [[[0 1 {}]] [[4 5 {}]]]}"
  {:span-sources sources})

(defn ed-span-layers (over under &optional palette)
  "Two span values handed to the view as ONE, `over` painted on top of `under`: where both
colour a character, `over`'s face wins; where only `under` does, it shows. What a buffer
whose producer stamped faces on its text (a build's ANSI colours, its `:ansi` text property) gives
the renderer beside its mode's own colouring (the `file:line:` of an error row), as Emacs
lays font-lock over ansi-color's faces. `over` may itself be `ed-span-sources`.

With a `palette` (`theme/ansi-palette`), `under`'s faces are SGR attributes (`ansi/sgr`'s
`{:fg 1 :bold true}`) resolved through it as they are painted (`ansi/face`), never stored
resolved: the palette is part of the value, so a theme switch misses the slicing memo and
repaints the output in the new theme's colours, as Emacs's `ansi-color-*` faces follow
a theme.

    (spanpaint/ed-span-layers [[0 1 :a]] [[0 4 :b]])   ;=> {:span-over [[0 1 :a]] :span-under [[0 4 :b]] :palette nil}"
  {:span-over over :span-under under :palette palette})

(defn ed-span-face (face palette)
  "A lower layer's `face` as painted: an SGR attribute resolved through `palette`, or the
face itself when the layer has no palette."
  (if (or (nil? palette) (nil? face)) face (ansi/face face palette)))

(defn- ed-span-resolve (spans palette)
  "One line's lower-layer `spans` with their faces as painted (`ed-span-face`)."
  (if (nil? palette)
    spans
    (map spans (fn (span) (let ([from to face] span) [from to (ed-span-face face palette)])))))

(defn- ed-span-underlay-loop (over under acc)
  (cond
    (empty? under) (append (reverse acc) over)
    (empty? over) (append (reverse acc) under)
    else
      (let ([over-from over-to _] (first over)
            [under-from under-to under-face] (first under))
        (cond
          (<= under-to over-from) (ed-span-underlay-loop over (rest under) (cons (first under) acc))
          (<= over-to under-from) (ed-span-underlay-loop (rest over) under (cons (first over) acc))
          ;; they overlap: the part of `under` before `over` shows, the part after waits
          else
            (ed-span-underlay-loop over
              (if (> under-to over-to)
                (cons [over-to under-to under-face] (rest under))
                (rest under))
              (if (< under-from over-from) (cons [under-from over-from under-face] acc) acc))))))

(defn ed-span-underlay (over under)
  "One line's spans from two layers (each ascending and non-overlapping): every `over`
span, and the parts of the `under` spans no `over` span covers — ascending and
non-overlapping again, as the painter wants them.

    (spanpaint/ed-span-underlay [[2 4 :a]] [[0 6 :b]])   ;=> ([0 2 :b] [2 4 :a] [4 6 :b])
    (spanpaint/ed-span-underlay nil [[0 1 :b]])   ;=> ([0 1 :b])"
  (ed-span-underlay-loop (or over ()) (or under ()) ()))

(defn- ed-span-lines-merge (by-lines)
  "The per-source `{line -> spans}` maps joined: a line in more than one source gets the
earlier source's spans first, which keeps them ascending."
  (fold (rest by-lines)
    (or (first by-lines) {})
    (fn (acc by-line)
      (fold by-line
        acc
        (fn (merged [line got])
          (assoc merged line (let (before (get merged line)) (if before (append before got) got))))))))

(defn ed-buffer-spans (buf spans)
  "The spans a pane of `buf` paints: `spans` (`ed-pane-spans`), behind the buffer's
`:history-spans` when it keeps a settled prefix of faces apart from them (a terminal's
scrollback) — the two as `ed-span-sources`, never joined — and over the faces its producer
stamped on its text (its `:ansi` text property — a build's ANSI colours as SGR attributes, resolved
through the theme's ANSI palette as they are painted) when it has those.
Those belong to the text (brood ADR-579), so they are where it is after any edit."
  (let (history (:history-spans buf)
        output (ansicolor/colour-spans buf)
        own (if (or (nil? history) (empty? history)) spans (ed-span-sources [history spans])))
    (if (empty? output) own (ed-span-layers own output (ansi-palette)))))

(def ed-face-diagnostic {:underline {:style :wave}}) ; merged onto the token's syntax face: a wave, as flymake draws one (brood ADR-513)

(defn ed-visible-diagnostics (m from to)
  "`[line diagnostics]` for each line in `[from, to)` the model's line index
(`:diag-by-line`, `diagstore/ed-diag-index`) has findings on — `()` when it has none. The one
per-VISIBLE-line read the underline and the ghost note share: a large file's checker output
(thousands of findings) must cost a frame nothing beyond the lines on screen."
  (let (index (or (:diag-by-line m) {}))
    (if (empty? index)
      '()
      (seq/keep (range (math/max 0 from) (math/max 0 to))
        (fn (line) (let (ds (get index line)) (when ds [line ds])))))))

(defn- ed-line-diagnostic-overrides (buf line ds)
  "`[pos ed-face-diagnostic]` for each character of each token the diagnostics `ds` mark on
`line` (`ed-diag-span-end`). Reads only that line's text, never the whole buffer; the word a
diagnostic marks never crosses a newline."
  (let (bol (text/line->char (buffer-rope buf) line)
        text (buffer-line-at buf line))
    (mapcat ds
      (fn (d)
        (let (from (diagstore/ed-diag-col0 d))
          (map (range from (diagstore/ed-diag-span-end text from))
            (fn (p) [(+ bol p) ed-face-diagnostic])))))))

(sig ed-diagnostic-overrides (model buffer int int -> any))

(defn ed-diagnostic-overrides (m buf top vrows)
  "`[pos ed-face-diagnostic]` overrides underlining each diagnostic's token on the
`vrows` lines from `top` — the pane's viewport — from the model's line index
(`ed-visible-diagnostics`); `()` when there are none. Lines past EOF (stale between
rechecks) are skipped, so a deleted line can't index out of range."
  (mapcat (ed-visible-diagnostics m top (math/min (buffer-line-count buf) (+ top vrows)))
    (fn ([line ds]) (ed-line-diagnostic-overrides buf line ds))))

(defn ed-hl-ranges (m buf selected?)
  "The highlight ranges `[lo hi face]` to paint over `buf` in a pane: the active region
(point↔mark, a `:bg` tint); and the model's transient `:overlays` (a search, a query-replace
matches), gated to the selected pane. Order is priority (the tiler merges later-wins):
region then overlays. (The hl-line current-line highlight is NOT a char range — it's a
full-width `rect` band painted by `ed-hl-line-band`, so it covers the whole line, not just
its text.)"
  (let (region-b (buffer-region-bounds buf)
        region (when region-b (list [(first region-b) (second region-b) face-region]))
        overlays (if selected?
                   (map (or (:overlays m) '()) (fn (o) [(:start o) (:end o) (:face o)]))
                   '()))
    (append region overlays)))

(defn ed-ranges-on-line (ranges lo hi)
  "The `[start end face]` highlight `ranges` that touch the chars `[lo, hi)` — a line —
each clipped to them, in their order (which is their priority). What a row's memo depends
on instead of the pane's whole list: clipped, a range that covers this line before and
after a motion is the SAME value both times. A range whose ends are not numbers is kept
as it is, for the tiler to judge, as it always did."
  (reverse (fold ranges
             '()
             (fn (acc range)
               (let (start (first range)
                     end (second range))
                 (cond
                   (not (and (int? start) (int? end))) (cons range acc)
                   (and (< start hi) (> end lo))
                     (cons [(math/max start lo) (math/min end hi) (nth range 2)] acc)
                   else acc))))))
