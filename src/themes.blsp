;; Modus Vivendi Tinted — Protesilaos Stavrou's modus-themes, the night-sky variant Emacs
;; ships (etc/themes/modus-themes.el, `modus-themes-vivendi-tinted-palette` and its
;; semantic mappings). Its colours by modus's own names: the palette maps the roles the
;; chrome is drawn from, and `*modus-vivendi-tinted-faces*` the colours modus gives a face
;; that the roles cannot (the current line, the mode lines, the code's syntax, Org's
;; heading levels).
(def *modus-vivendi-tinted*
  {:base "#0d0e1c" ; bg-main
   :mantle "#1d2235" ; bg-dim: the gutter (bg-line-number-inactive)
   :surface0 "#2b3045" ; bg-inactive
   :surface1 "#4a4f69" ; bg-active
   :surface2 "#555a66" ; bg-region
   :overlay0 "#989898" ; fg-dim: line numbers
   :overlay1 "#61647a" ; border
   :overlay2 "#989898" ; fg-dim
   :text "#ffffff" ; fg-main
   :subtext1 "#c6daff" ; fg-alt
   :subtext "#c6daff" ; fg-alt
   :lavender "#ffffff" ; fg-line-number-active: fg-main
   ;; modus's greys run the other way from Catppuccin's ladder — its line numbers (fg-dim)
   ;; are brighter than its border — so it names its two quiet tiers itself
   :fg-tertiary "#989898" ; fg-line-number-inactive: fg-dim
   :fg-decor "#61647a" ; border
   :blue "#79a8ff" ; blue-warmer
   :mauve "#b6a0ff" ; magenta-cooler
   :green "#44bc44" ; green
   :yellow "#d0bc00" ; yellow
   :peach "#db8b3f" ; rust
   :red "#ff5f59" ; red
   :teal "#00d3d0" ; cyan
   :selection "#483d8a" ; bg-completion
   :on-selection "#ffffff"
   :cursor "#ff66ff"}) ; magenta-intense

(def *modus-vivendi-tinted-faces*
  {'theme/face-hl-line {:bg "#303a6f"} ; bg-hl-line
   'theme/face-modeline {:fg "#ffffff" :bg "#484d67"} ; bg-mode-line-active
   'theme/face-modeline-inactive {:fg "#969696" :bg "#292d48"}
   'theme/face-modeline-rule {:bg "#61647a"} ; border: modus boxes its mode lines
   'theme/face-isearch {:fg "#ffffff" :bg "#7a6100"} ; bg-search-current
   'theme/face-isearch-lazy {:fg "#ffffff" :bg "#2266ae"} ; bg-search-lazy (bg-cyan-intense), fg-search-lazy (fg-main)
   'theme/face-bracket-match {:fg "#ffffff" :bg "#4f7f9f"} ; bg-paren-match
   :syntax/comment {:fg "#ef8386"} ; comment: red-faint
   :syntax/string {:fg "#2fafff"} ; string: blue
   :syntax/doc {:fg "#9ac8e0"} ; docstring: cyan-faint
   :syntax/number {:fg "#ffffff"} ; number: fg-main
   :syntax/keyword {:fg "#b6a0ff"} ; constant: magenta-cooler
   :syntax/special {:fg "#79a8ff"} ; keyword: blue-warmer
   :syntax/function {:fg "#d09dc0"} ; fnname-call: pink
   :syntax/error {:fg "#ff5f59" :bold true}
   :org/level-1 {:fg "#ffffff" :bold true} ; fg-heading-1: fg-main
   :org/level-2 {:fg "#d2b580" :bold true} ; fg-heading-2: yellow-faint
   :org/level-3 {:fg "#82b0ec" :bold true} ; fg-heading-3: blue-faint
   :org/level-4 {:fg "#feacd0" :bold true} ; fg-heading-4: magenta
   ;; rainbow-delimiters-depth-N: modus's rainbow-0 … rainbow-8
   :syntax/delimiter-1 {:fg "#ffffff"} ; fg-main
   :syntax/delimiter-2 {:fg "#ff66ff"} ; magenta-intense
   :syntax/delimiter-3 {:fg "#00eff0"} ; cyan-intense
   :syntax/delimiter-4 {:fg "#ff6b55"} ; red-warmer
   :syntax/delimiter-5 {:fg "#efef00"} ; yellow-intense
   :syntax/delimiter-6 {:fg "#b6a0ff"} ; magenta-cooler
   :syntax/delimiter-7 {:fg "#44df44"} ; green-intense
   :syntax/delimiter-8 {:fg "#79a8ff"} ; blue-warmer
   :syntax/delimiter-9 {:fg "#f78fe7"}}) ; magenta-warmer

;; Catppuccin Mocha CALM — the same palette, the syntax spent sparingly (Tonsky's "if everything
;; is highlighted, nothing is", his Alabaster theme): literals coloured (strings green, numbers
;; peach, `:keywords` mauve), comments and docstrings READABLE in a sand colour (the yellow
;; toward the grey) rather than hidden, special forms the plain text colour, calls and
;; definitions a low-chroma blue, no bold or italic anywhere, and depth-coloured brackets
;; (`:rainbow-delimiters`) faded toward the grey. An option beside the default, not a
;; replacement: the evidence that either style helps comprehension is equivocal (Hannebauer
;; 2018, Sarkar 2015).
;;
;; bedit's highlighters give a definition's name and a call's head one face (`:syntax/function`),
;; so "colour definitions, leave calls plain" can only be approximated here.
(def *mocha-calm-faces*
  (let (palette theme/*theme-mocha*
        faded (fn (color) (theme/mix color (:overlay1 palette) 0.35))
        comment (theme/mix (:yellow palette) (:overlay2 palette) 0.7)
        definition (theme/mix (:blue palette) (:text palette) 0.5))
    (into {:syntax/comment {:fg comment}
           :syntax/doc {:fg comment}
           :syntax/string {:fg (:green palette)}
           :syntax/number {:fg (:peach palette)}
           :syntax/keyword {:fg (:mauve palette)}
           :syntax/special {:fg (:text palette)}
           :syntax/function {:fg definition}
           :syntax/error {:fg (:red palette)}
           :org/level-1 {:fg definition}
           :org/level-2 {:fg (:mauve palette)}
           :org/level-3 {:fg (:green palette)}
           :org/level-4 {:fg (:peach palette)}}
      (map (seq/enumerate [:text :mauve :blue :peach :green :yellow :teal :red :subtext])
        (fn ([index role])
          [(keyword (str "syntax/delimiter-" (inc index))) {:fg (faded (get palette role))}])))))

;; A theme whose AUTHORED body text sits under APCA Lc 75 — Solarized's low-contrast design, One
;; Dark's and Everforest's soft foregrounds, Tokyo Night's a hair under — says `:contrast :soft`:
;; tests/theme_contrast_test.blsp then holds its tiers to the same floors scaled by its body
;; text's own contrast, so its hierarchy is still checked without rewriting its colours.
(def *themes*
  ;; display name -> {:palette <map>}, and optionally :contrast :soft (above), :faces <map>
  ;; (`theme/theme-apply!`: what the palette cannot say) and :font <keyword> :files <map>
  ;; :height px:
  ;; a theme that names a font sets it; one that does not (every theme here) keeps the font
  ;; the init file chose (`:font` / `:font-size`, src/config.blsp).
  ;; The bundled STANDARD set — always available, no dependency. A theme *plugin*
  ;; (`:enhances bedit`, `nest add`ed) appends more of these on startup via
  ;; `register-theme!` (src/plugins.blsp), so this is the built-in floor, not the ceiling.
  [{:name "Catppuccin Mocha" :palette theme/*theme-mocha*}
    {:name "Catppuccin Mocha Calm" :palette theme/*theme-mocha* :faces *mocha-calm-faces*}
    {:name "Tokyo Night" :palette *tokyo* :contrast :soft}
    {:name "Nord" :palette *nord*}
    {:name "Gruvbox Dark" :palette *gruvbox*}
    {:name "Solarized Dark" :palette *solarized* :contrast :soft}
    {:name "One Dark" :palette *onedark* :contrast :soft}
    {:name "Everforest" :palette *everforest* :contrast :soft}
    {:name "Modus Vivendi Tinted"
     :palette *modus-vivendi-tinted*
     :faces *modus-vivendi-tinted-faces*}
    {:name "Catppuccin Latte (light)" :palette *latte*}])

(defn register-theme! (entry)
  "Add a theme `entry` to the live picker registry (`M-x theme-select`). A plugin
package supplies just `{:name :palette}` and keeps the font the init file chose; one that
also names a `:font` (with its `:files` and `:height`) sets that font too. Re-registering
the same `:name` REPLACES it in place, so a plugin reload (or a live redefine) doesn't
double the list. This is a global rebind of `*themes*` — the same live-redefine model the
rest of this file documents — so the new theme shows on the picker's next open.

Backs `packages/apply-plugin!` (folding in an installed `:enhances bedit` package) and is
equally a public seam for `init.blsp` or a `C-x C-e` one-off."
  (ownership/claim! :themes/themes (:name entry) entry))

(defn unregister-theme! (name)
  "Remove the theme named `name` from the live picker registry, so it leaves `M-x
theme-select`. A global rebind of `*themes*` like `register-theme!`; a no-op when no such
theme is registered. A package's themes need no call: removing the package takes back
everything it registered (`ownership/release-under!`)."
  (ownership/unclaim! :themes/themes name))

;; The picker list as an `ownership` kind: a theme registered while a package is applied is
;; that package's, and goes back when the package does — the theme it replaced, if any,
;; returning to the picker.
(defn- theme-write (name entry)
  (let (others (seq/filter *themes* (fn (theme) (not (= (:name theme) name)))))
    (def *themes* (conj (vec others) entry))))

(defn- theme-remove (name)
  (def *themes* (vec (seq/filter *themes* (fn (theme) (not (= (:name theme) name)))))))

(defn- theme-lookup (name)
  (let (found (seq/find *themes* (fn (theme) (= (:name theme) name))))
    [(not (nil? found)) found]))

(ownership/define-kind :themes/themes theme-lookup theme-write theme-remove)

(defn- themes-by-name (name)
  (first (seq/filter *themes* (fn (t) (= (:name t) name)))))

(defn themes-names () (map *themes* (fn (t) (:name t))))

(defn theme-activate! (name)
  "Swap the palette, the faces it overrides and the window background to the theme `name`
(`theme/theme-apply!`), registering its `:font` when it names one — the half of a switch that
needs no model, so startup can do it from the init file's `:theme`. The theme entry, or nil
when no theme is called `name`."
  (let (t (themes-by-name name))
    (when t
      (theme/theme-apply! (:palette t) (or (:faces t) {}))
      (when (and (:font t) (:files t)) (gui-only gui/font-register (:font t) (:files t)))
      t)))

(defn theme-from-config! (cfg)
  "Activate the theme init.blsp's `:theme` names (`theme-activate!`), if it names one — at
startup (`main`) and on `M-x reload-config`. A warning string for a name no theme has, else
nil."
  (let (name (config/setting cfg :theme))
    (when (and name (nil? (theme-activate! name)))
      (str "init.blsp: no theme called \"" name "\" — M-x theme-select lists them"))))

(defn themes-apply (m name)
  "Apply the theme `name` live: swap the whole palette + window background (`theme-apply!`)
and, for a theme that names a `:font`, set that font (`gui/font`), both through `gui-only` so
a headless run is a no-op and anything else raises. A theme without one keeps the font on
screen — the init file's `:font`. Returns the model with an echo status."
  (let (t (theme-activate! name))
    (if (nil? t)
      (message m (str "no such theme: " name))
      (do
        ;; the FONT half goes through `appearance/apply!` rather than `gui/font` directly, so
        ;; the model records the size this theme just imposed — otherwise a `M-x preset-save`
        ;; after a theme switch would save the size the model still believed in, not the one
        ;; on screen. (Deferred-loaded, the keymap idiom; headless it is the plain call.)
        (let (font (when (:font t) {:family (:font t) :height (or (:height t) 15)})
              sized (cond
                      (nil? font) m
                      (bound? 'appearance/apply!) ((reflect/eval 'appearance/apply!) m font)
                      else (do (gui-only gui/font font) m)))
          ;; a running terminal program re-reads its SCREEN through the new colours (only
          ;; when one runs — `ed-terminals?`)
          (message (if (ed-terminals? sized) (terminal/term-repalette sized) sized)
            (str "theme → " name)))))))

(defcommand cmd-theme-select
  (m key)
  "Pick a colour theme (`M-x theme-select`) — a Vertico list of full palettes (background,
foreground, syntax) + font, applied live to the whole editor."
  (assoc m
    :minibuffer
      (ed-name-prompt "Theme: "
        (themes-names)
        (fn (mm name) (themes-apply mm name)))))
