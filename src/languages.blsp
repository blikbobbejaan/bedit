(defmodule languages
  "The non-Lisp language modes. `deflanguage` declares a tree-sitter language from ONE spec
(faces, indent, heredocs, formatter) and generates its whole service set — Ruby, Elixir,
Python and Rust are its clients, each a face table and an indent spec. Beside them, the
fontify-only layers over the `lex-*` modules: env, shell, Dockerfile, and the configuration
formats (JSON, YAML, TOML, Makefile, INI, git commit messages). Mail (mbox, .eml) is
`mail`'s."
  (:use editor/layers) ; register-interpreter-type — shell-mode's shebang names
  (:use modes :only [register-language-mode register-prog-mode layer-commands])
  (:use interactive :only [defcommand])) ; org-mode's commands
;; editor/treesit, editor/highlight and the std lexers are referenced qualified below —
;; each `mod/name` auto-loads its module.

(defmacro deflanguage (name spec)
  "Declare a tree-sitter language mode from ONE spec, and register it.

    (deflanguage elixir
      {:lang :elixir
       :pattern \"[.](ex|exs)$\"
       :faces elixir-face-table
       :indent elixir-indent-spec
       :heredocs *elixir-heredocs*
       :comment \"# \"})

Every language used to spell out the same five definitions — a `-fontify`, a
`-fontify-restart`, an `-indent`, a layer naming all three, and the registration — of
which only the tables differed. Three copies is where a language quietly gets less than
the others: the mode was the place a service could be forgotten, and a forgotten service
is invisible until someone presses the key. Here a language supplies DATA and gets the
whole service set, or fails at load saying which part is missing.

The services are generated as named globals rather than closures because
`model/ed-mode-service` resolves a service SYMBOL late (`reflect/eval`) — which is what
lets a redefined fontify take effect on the next frame without reloading the mode. A
closure in the layer would be resolved once and frozen.

`:format` is the language's formatter as a command vector — `[\"mix\" \"format\"]`, to which
the file path is appended. It becomes the `:format-command` service that `M-x
format-buffer` and format-on-save consult, so neither names a language.

`:definitions` says which nodes C-M-a / C-M-e / C-M-h treat as a definition —
`{:kinds #{:function_item …}}`, or `:calls` for a language that defines with a call
(`editor/treesit/register-definitions`). Ruby and Elixir are declared by std, whose
grammars they are; a language that declares nothing moves by top-level form.

`:grammar` is where the language's grammar lives — a git URL, or `{:url … :subdir …}` for
a repository holding several — so `M-x grammar-install` can fetch and build it, and
opening a file of the language without one says so (`grammars/declare-grammar`).

`:indent-tabs` true writes indentation as tabs (Go's gofmt'd sources), at the indenter's
column.

`:heredocs` is optional and produces the `:fontify-restart` a windowed fontify uses;
`:restart` names one directly when the rule is more than counting paired markers (Ruby
must also notice `=begin`). A language with neither declines to restart, which is a fact
about the language — `editor/treesit/language-contract` says which services are required
and which are optional.

The generated one is `<name>-heredoc-restart`, not `<name>-fontify-restart`: the obvious
name is the one a language with a CUSTOM restart has already used, and generating it
silently replaced Ruby's — which then answered \"restart anywhere\" and coloured the prose
inside its `=begin` blocks as code. A generated definition must not be able to take a
hand-written name."
  (let (base (->string name)
        fontify (symbol (str base "-fontify"))
        restart (symbol (str base "-heredoc-restart"))
        indent (symbol (str base "-indent"))
        layer (symbol (str base "-mode-layer"))
        faces (symbol (str base "-ts-faces"))
        fontify-ref (symbol (str "languages/" base "-fontify"))
        faces-ref (symbol (str "languages/" base "-ts-faces"))
        restart-ref (symbol (str "languages/" base "-heredoc-restart"))
        indent-ref (symbol (str "languages/" base "-indent"))
        layer-ref (symbol (str "languages/" base "-mode-layer")))
    `(do
       (defn ~fontify (text)
         (editor/treesit/fontify text (get ~spec :lang) (get ~spec :faces)))
       (defn ~indent (text bol)
         (editor/treesit/indent-column text (get ~spec :lang) bol (get ~spec :indent)))
       (defn ~restart (src pos)
         (let (hd (get ~spec :heredocs))
           (if (nil? hd) pos (editor/treesit/column0-restart src pos hd))))
       ;; the face table as a global the `:ts-faces` service names, so a held tree is
       ;; coloured with the table the fontify uses (`editor/treesit/fontify-tree`)
       (def ~faces (get ~spec :faces))
       (def ~layer
         (languages/language-layer '~name
           ~spec
           {:fontify '~fontify-ref
            :indent '~indent-ref
            :restart '~restart-ref
            :faces '~faces-ref}))
       (languages/declare-definitions ~spec)
       (languages/declare-grammar ~spec)
       (register-prog-mode '~layer-ref (get ~spec :lang)))))

(defn declare-definitions (spec)
  "Register a `deflanguage` spec's `:definitions` with `editor/treesit`. A spec without one
leaves std's declaration alone — Ruby's and Elixir's live there."
  (let (definitions (get spec :definitions))
    (when (map? definitions)
      (editor/treesit/register-definitions (get spec :lang) definitions))))

(defn declare-grammar (spec)
  "Record where a `deflanguage` spec's grammar lives (`:grammar` — a git URL, or `{:url
:subdir}` for a repository holding several), so `M-x grammar-install` can fetch it and a
file of the language opened without one can say how to get it."
  (let (grammar (get spec :grammar))
    (when (not (nil? grammar))
      (grammars/declare-grammar (get spec :lang) grammar))))

(defn language-layer (name spec refs)
  "The mode layer for a `deflanguage`, checked against `editor/treesit/language-contract`.
`refs` names the generated services: `{:fontify :indent :restart :faces}`.

Raises on an incomplete language rather than registering one. A mode missing `:indent`
would register happily and simply do nothing on RET — a failure that surfaces as a key
which feels broken, in one language, much later."
  (let (restart-ref (:restart refs)
        layer {:name name
               :parser :tree-sitter
               :ts-lang (get spec :lang)
               ;; the `{:node-kind :syntax/face}` table, for colouring a HELD tree
               ;; (`syntaxtree`, brood ADR-443): `:fontify` takes text, and a view that
               ;; keeps the document's parse asks the tree with the same table instead
               :ts-faces (:faces refs)
               :file-pattern (get spec :pattern)
               :fontify (:fontify refs)
               :indent (:indent refs)
               ;; `:restart` names its own when the rule is more than counting paired
               ;; markers (Ruby must also see `=begin`); `:heredocs` gets the derived
               ;; one; a language with neither declines, which is a fact about the
               ;; language rather than a hole in the mode.
               :fontify-restart (or (get spec :restart)
                                  (when (get spec :heredocs) restart-ref))
               :comment-syntax (get spec :comment)
               ;; The language's own formatter, as `[prog arg …]` with the file appended
               ;; — `mix format <file>`. A service like any other, so `M-x format-buffer`
               ;; and format-on-save ask the BUFFER what formats it and never name a
               ;; language. Absent for a language with no formatter, which is a fact
               ;; about the language.
               :format-command (get spec :format)
               ;; Go and C's tab-indented sources: the indenter answers a column, and a
               ;; mode that indents with tabs writes it as tabs (`commands/ed-indentation`)
               :indent-tabs (= true (get spec :indent-tabs))}
        gaps (editor/treesit/missing-services layer))
    (when (not (empty? gaps))
      (error "deflanguage " name ": missing required service(s) " (->string gaps)))
    layer))

;; ---- env-mode / docker-mode: more fontify-only language layers --------------
;; Two more language modes built the same way as markdown-mode — a layer whose only
;; service is a `:fontify` span fn from a pure module (lex-dotenv,
;; lex-dockerfile). `.env` files and Dockerfiles keep every text-mode binding and gain
;; syntax colouring. The `:file-pattern` is matched against the file's basename, so a
;; bare `Dockerfile` / `.env` (no extension) triggers; both restart at the viewport's own
;; line (`editor/highlight/line-restart`: line-oriented, no cross-line lexer state, so the
;; 200-line backscan above the band is never lexed).

(def env-mode-layer
  {:name 'env
   ;; .env and its variants (.env.local, .env.production, …); the leading-dot name
   ;; carries no extension, so anchor on `.env` with an optional `.suffix`.
   :file-pattern "(^|/)\\.env(\\.[^/]+)?$"
   :fontify 'lex-dotenv/env-spans
   :fontify-restart 'editor/highlight/line-restart})

(register-language-mode 'languages/env-mode-layer :env)

;; ---- shell-mode: sh / bash / zsh scripts -----------------------------------------
;; `lex-shell` lexes per line (comments, strings, `$` expansions, keywords,
;; builtins, function names). A script is recognised by its extension or its name
;; (`.sh`, `.bashrc`, …) OR by its `#!` line (`register-interpreter-type`, the Emacs
;; `interpreter-mode-alist`) — so `run`, `deploy`, `configure` with `#!/usr/bin/env bash`
;; on top get the mode with no extension at all.

(def shell-mode-layer
  {:name 'shell
   :file-pattern "[.](sh|bash|zsh|ksh|dash)$|(^|/)[.]?(bashrc|bash_profile|bash_aliases|bash_login|bash_logout|zshrc|zshenv|zprofile|zlogin|profile|xprofile|xinitrc)$|(^|/)PKGBUILD$"
   :fontify 'lex-shell/shell-spans
   :fontify-restart 'editor/highlight/line-restart
   :comment "# "})

(register-language-mode 'languages/shell-mode-layer :shell)
(doseq (i ["sh" "bash" "zsh" "ksh" "dash" "ash" "busybox"])
  (register-interpreter-type i :shell))

(def docker-mode-layer
  {:name 'docker
   ;; `Dockerfile`, `Dockerfile.dev`, `*.dockerfile`, and Podman's `Containerfile`.
   :file-pattern "(^|/)(Dockerfile|Containerfile)([.][^/]+)?$|[.]dockerfile$"
   :fontify 'lex-dockerfile/dockerfile-spans
   :fontify-restart 'editor/highlight/line-restart})

(register-language-mode 'languages/docker-mode-layer :docker)

;; ---- ruby-mode / elixir-mode: tree-sitter-backed language modes -------------
;; The first modes whose parser is NOT Brood's reader: a `.rb`/`.ex` buffer gets
;; syntax colouring AND structural navigation from a tree-sitter grammar
;; (`tree-sitter-parse`), via `std/editor/treesit` — the foreign-language analogue
;; of brood-mode's `highlight`+`sexp`. The proof of ROADMAP §C: because the
;; builtin yields the SAME positioned-node shape Brood's reader does, the editor's
;; `:fontify` service and the `C-M-f/b/u/d/a` structural commands run over a Ruby
;; or Elixir tree unchanged — the modes are pure data (a face table + a `:ts-lang`
;; + a layer), and now an indent spec: `editor/treesit/indent-column` walks the tree and each
;; language names the node kinds that open a level (`languages/elixir-indent-spec`).
;;
;; `:fontify-restart` says where the windowed lead-in may be CUT. Without one the mode
;; parses the whole lead-in every keystroke — 245 lines for a 44-row viewport, five times
;; what is on screen, and 18 ms of a 25 ms keystroke on a 10k-line file. Elixir has one
;; (`editor/treesit/column0-restart`, guarded on heredoc parity — see there); Ruby does NOT,
;; deliberately: its heredoc terminator is arbitrary text (`<<~EOS`), so there is no paired
;; marker to count and no way to tell a column-0 line inside one from a real top-level form.
;; Guessing there would colour prose as code; Ruby keeps the lead-in until its own guard
;; exists.

;; (The `C-M-*` structural motions come from the shared `prog-mode-layer` above — ruby and
;; elixir stack it via `register-prog-mode`, and the commands dispatch on `:ts-lang`.)

;; Per-language kind→face tables name only the *named* nodes to colour; keywords
;; (anonymous alphabetic tokens — `def`/`end`/`do`/`fn`/…) come free via
;; passed straight to `editor/treesit/fontify`. Refine one by inspecting `(%tree-sitter-parse …)`.
;; ---- indentation for the tree-sitter modes ----------------------------------
;; `editor/treesit/indent-column` is the mechanism (walk the tree, count enclosing blocks);
;; these four entries are the whole per-language policy. The kinds were read off real parses
;; rather than guessed, and each spec is checked line-for-line against hand-written source —
;; every line of a sample module must re-indent to the column it already has.
;;
;; `:dedent-levels` differs because the grammars do: Elixir's `do_block` spans its own `end`,
;; so a closing line measured at the line start is still inside the block and backs out one;
;; Ruby's `body_statement` stops before `end`, so the closer is already outside and backs out
;; none.

(def elixir-indent-spec
  {:width 2
   :blocks #{:do_block :body} ; `do … end`, and a `->` clause's body
   ;; The bracketed openers — a multi-line list/map/tuple/binary/`fn` indents its
   ;; contents exactly as a block does, but must NOT indent its own opening line, which
   ;; is what `:brackets` means. `:arguments` is deliberately absent: Elixir does not add
   ;; a level for a call's argument list when the last argument is an `fn`, which is the
   ;; common shape (`Enum.reduce(xs, %{}, fn … end)`), and counting it put every such
   ;; clause one level too deep.
   :brackets #{:anonymous_function :list :map :tuple :bitstring}
   ;; keywords only; the closing delimiters decide for themselves
   :dedent #{"end" "else" "catch" "rescue" "after"}
   :dedent-levels 1})

(def ruby-indent-spec
  {:width 2
   ;; a method/class body, an if/else arm, and a BRACE block's body — `{ |x| … }` spanning
   ;; lines indents its contents like any block, and `:block_body` is the kind the grammar
   ;; gives it. Without it every multi-line `{ |t| … }` body sat a level too shallow, which
   ;; is 44 of the 46 lines the Ruby stdlib disagreed with.
   :blocks #{:body_statement :then :else :block_body}
   ;; the bracketed openers, which must not indent their own opening line
   :brackets #{:array :hash :argument_list}
   ;; Per token, because the grammar disagrees per token: a `body_statement` stops before
   ;; its `end`, so `end` is already outside it and backs out nothing — but it SPANS its
   ;; own `ensure`/`rescue`/`else`, so those must back out one. A single `:dedent-levels`
   ;; cannot say both, and with one number Ruby's `ensure` sat a level too deep in every
   ;; method that had one.
   ;; Keywords only — a closing delimiter decides for itself (see `ts-dedent-levels`),
   ;; because the same `}` closes a hash whose node encloses the closing line AND a
   ;; `{ |x| … }` block whose body ended before it. Read off the grammar, one token at a
   ;; time, against the Ruby stdlib:
   ;;   `end`                  a `body_statement` stops before it — already outside
   ;;   `else` `elsif` `when`  the arm ends before the keyword — already outside
   ;;   `rescue` `ensure`      children of the `body_statement`, which SPANS them
   :dedent {"end" 0 "else" 0 "elsif" 0 "when" 0 "rescue" 1 "ensure" 1}})

(def ruby-face-table
  {:comment :syntax/comment
   :string :syntax/string
   :heredoc_body :syntax/string
   :regex :syntax/string
   :simple_symbol :syntax/special
   :hash_key_symbol :syntax/special
   :delimited_symbol :syntax/special
   :integer :syntax/number
   :float :syntax/number
   :constant :syntax/special
   :instance_variable :syntax/function
   :global_variable :syntax/function
   :class_variable :syntax/function})

;; ---- ruby's fontify restart ---------------------------------------------------
;; Elixir decides restart safety by counting PAIRED heredoc markers; Ruby has no pair to
;; count — `<<~EOS` ends at a line holding whatever identifier the opener named. So Ruby
;; asks a weaker question with a safe answer: is there any heredoc opener, or any `=begin`
;; block comment, above the candidate at all? If so it declines and keeps the full lead-in,
;; which is exactly today's behaviour. Over-declining costs speed in files that open a
;; heredoc near the viewport and nothing else; guessing would colour heredoc prose as code.
;;
;; Bare `<<EOS` is recognised by the uppercase/underscore that conventionally follows,
;; because `<<` alone is `Array#<<` and left-shift — searching for it would decline
;; everywhere and buy nothing.

(defn- ruby-upper? (c)
  ;; an uppercase ASCII letter, tested by case-folding (Brood's `<` is numeric-only)
  (and (not (= (string/upper c) (string/lower c))) (= c (string/upper c))))

(sig ruby-heredoc-open-at? (string int -> bool))
(defn- ruby-heredoc-open-at? (src i)
  ;; `i` is the offset of a `<<` — does it open a heredoc rather than shift or append?
  (let (j (+ i 2))
    (and (< j (string/length src))
      (let (c (string/char-at src j))
        (or (= c "~") (= c "-") (= c "'") (= c "\"") (= c "_") (ruby-upper? c))))))

(defn- ruby-heredoc-above? (src upto from)
  ;; any heredoc opener in `src` before `upto`
  (let (i (index-of src "<<" from))
    (cond
      (or (< i 0) (>= i upto)) false
      (ruby-heredoc-open-at? src i) true
      else (ruby-heredoc-above? src upto (+ i 2)))))

(defn- ruby-block-comment-above? (src upto)
  ;; `=begin` / `=end` are column-0 only, so a newline-prefixed match (or offset 0) is one
  (or (string/starts-with? src "=begin")
    (let (i (index-of src "\n=begin")) (and (>= i 0) (< i upto)))))

(defn ruby-fontify-restart (src pos)
  "Ruby's `:fontify-restart`: the previous column-0 line, unless a heredoc or `=begin` block
opens above it in this window — in which case keep the whole lead-in, as before."
  (let (candidate (editor/treesit/column0-before src pos))
    (if (or (ruby-heredoc-above? src candidate 0) (ruby-block-comment-above? src candidate))
      0
      candidate)))

(deflanguage ruby
  {:lang :ruby
   :pattern "\\.rb$"
   :faces languages/ruby-face-table
   :indent languages/ruby-indent-spec
   ;; its own: a heredoc terminator is arbitrary text, and `=begin` blocks count too
   :restart 'languages/ruby-fontify-restart
   ;; the community standard, and what a Ruby project has if it has anything
   :format ["rubocop" "-a" "--stderr" "--format" "quiet"]
   :comment "# "})

;; Elixir: def/defmodule are macros (parsed as calls, not keywords), so they
;; aren't keyword-coloured — `do`/`end`/`fn`/`when`/… are. Atoms and module
;; aliases read as `:special`.
(def elixir-face-table
  {:comment :syntax/comment
   :string :syntax/string
   :charlist :syntax/string
   :sigil :syntax/string
   :integer :syntax/number
   :float :syntax/number
   :atom :syntax/special
   :alias :syntax/special
   :keyword :syntax/special})

;; Elixir's paired multi-line string markers — what the restart counts to decide whether a
;; column-0 line is real code or prose inside an `@moduledoc`.
(def *elixir-heredocs* ["\"\"\"" "'''"])

(deflanguage elixir
  {:lang :elixir
   :pattern "\\.(ex|exs)$"
   :faces languages/elixir-face-table
   :indent languages/elixir-indent-spec
   :heredocs languages/*elixir-heredocs*
   :format ["mix" "format"]
   :comment "# "})

;; ---- python-mode: a language the runtime was never built with ---------------
;; The proof that a language is a data entry rather than a build: nothing in Brood knows
;; Python. Drop `libtree-sitter-python.so` into `~/.config/bedit/grammars/` and everything
;; below — colouring, the `C-M-*` structural motions, indentation — comes from these three
;; definitions. Without the grammar the mode still registers and simply cannot parse.
;;
;; Python indents by four, and every level is the same `:block` node, so it needs no dedent
;; set at all: `else:` sits in the `if`'s own block chain, not inside the arm it follows.
(def python-face-table
  {:comment :syntax/comment
   :string :syntax/string
   :string_content :syntax/string
   :integer :syntax/number
   :float :syntax/number
   :true :syntax/special
   :false :syntax/special
   :none :syntax/special})

(def python-indent-spec
  {:width 4
   :blocks #{:block} ; every suite is a `block`; `else:` sits in the `if`'s own chain
   ;; the bracketed literals and call arguments — a multi-line one indents (or aligns)
   ;; its contents, and must not indent its own opening line
   :brackets #{:list :dictionary :set :tuple :argument_list :parameters :parenthesized_expression}
   ;; Nothing to declare: `else:`/`elif:`/`except:` are children of the statement rather
   ;; than of its block, so they already measure at the outer level, and the closing
   ;; delimiters decide for themselves.
   :dedent #{}})

(deflanguage python
  {:lang :python
   :pattern "\\.py$"
   :faces languages/python-face-table
   :indent languages/python-indent-spec
   ;; paired triple quotes, exactly Elixir's case
   :heredocs languages/*elixir-heredocs*
   :format ["black" "-q"]
   :grammar "https://github.com/tree-sitter/tree-sitter-python"
   :definitions {:kinds #{:function_definition :class_definition}}
   :comment "# "})

;; ---- rust-mode: Python's case, a grammar loaded at runtime --------------------
;; `~/.config/bedit/grammars/libtree-sitter-rust.so`. The LSP (rust-analyzer), the
;; toolchain row (cargo) and the `-->` error locations were already here; this is the mode
;; they were waiting for.
;;
;; Every Rust level is a `{`-delimited node, so they are all `:brackets` rather than
;; `:blocks`: each node SPANS its own `}`, and a closing line measured inside it must back
;; out the bracket it closes — which a delimiter decides for itself, and a block would not.
;; As brackets they also collapse per line, so `xs.map(|x| {` opens one level, not two.
;; No keyword dedents: `} else {` begins with the delimiter.
(def rust-face-table
  {:line_comment :syntax/comment
   :block_comment :syntax/comment
   :string_literal :syntax/string
   :raw_string_literal :syntax/string
   :char_literal :syntax/string
   :integer_literal :syntax/number
   :float_literal :syntax/number
   :boolean_literal :syntax/special
   :lifetime :syntax/special
   :type_identifier :syntax/special
   :primitive_type :syntax/special
   :attribute_item :syntax/special
   :inner_attribute_item :syntax/special
   ;; named nodes, so the anonymous-keyword rule never sees them
   :self :syntax/keyword
   :crate :syntax/keyword
   :super :syntax/keyword
   :mutable_specifier :syntax/keyword})

(def rust-indent-spec
  {:width 4
   :blocks #{}
   :brackets #{:block
               :declaration_list :field_declaration_list :enum_variant_list :match_block
               :field_initializer_list :use_list :token_tree :arguments
               :parameters :array_expression :tuple_expression :ordered_field_declaration_list
               :struct_pattern :tuple_pattern :tuple_struct_pattern :parenthesized_expression}
   :dedent #{}})

;; ---- rust's fontify restart ---------------------------------------------------
;; A column-0 line is not necessarily code: a plain Rust string may span lines, and
;; `const USAGE: &str = "usage:\nbedit FILE\n";` puts its prose in column 0. So the candidate
;; must also LOOK like the start of an item — an item keyword, an attribute, a comment or a
;; closing brace — and an earlier column-0 line is tried when it does not. A raw string or a
;; block comment opened above has no such tell (its contents are anything, items included),
;; so either declines the cut, as Ruby's heredocs do.

(def- *rust-item-start*
  "^((pub|fn|impl|struct|enum|union|trait|mod|use|const|static|type|unsafe|async|extern)\\b|macro_rules!|#!?\\[|//|\\})")

(def- *rust-opaque-opener* "/\\*|(^|[^A-Za-z0-9_])b?r#*\"")

(defn- item-line-before (src pos item-start)
  ;; the nearest column-0 line at or before `pos` that matches `item-start`, or 0
  (let (candidate (editor/treesit/column0-before src pos)
        eol (let (i (index-of src "\n" candidate)) (if (< i 0) (string/length src) i)))
    (cond
      (= candidate 0) 0
      (regex/match? item-start (string/substring src candidate eol)) candidate
      else (item-line-before src (dec candidate) item-start))))

(defn column0-item-restart (src pos item-start opaque-opener)
  "The fontify restart every brace language shares: the previous column-0 line that
LOOKS like the start of an item (`item-start`, a regex over the line), unless something
whose contents can be anything — a block comment, a raw or template string
(`opaque-opener`) — opens above it in this window; then the whole lead-in."
  (let (candidate (item-line-before src pos item-start)
        opener (regex/find opaque-opener src))
    (if (and opener (< (get opener :start) candidate)) 0 candidate)))

(defn rust-fontify-restart (src pos)
  "Rust's `:fontify-restart`: the previous column-0 line that starts an item, unless a raw
string or block comment opens above it in this window — then the whole lead-in."
  (column0-item-restart src pos *rust-item-start* *rust-opaque-opener*))

(deflanguage rust
  {:lang :rust
   :pattern "\\.rs$"
   :faces languages/rust-face-table
   :indent languages/rust-indent-spec
   :restart 'languages/rust-fontify-restart
   ;; rustfmt alone formats as the 2015 edition (cargo fmt passes the crate's); a new
   ;; crate is 2024
   :format ["rustfmt" "--edition" "2024"]
   :grammar "https://github.com/tree-sitter/tree-sitter-rust"
   ;; Emacs rust-ts-mode's defun types: a `fn` inside an `impl` is its own definition
   :definitions {:kinds #{:function_item
                          :impl_item :trait_item :struct_item :enum_item :union_item :type_item
                          :mod_item :macro_definition}}
   :comment "// "})

;; ---- the brace languages: JavaScript, TypeScript, TSX, Go, C ------------------------
;; Rust's shape four more times: a face table, the `{`-delimited nodes as `:brackets`, the
;; definitions C-M-a stops at (Emacs's *-ts-mode defun types), and the column-0 restart.
;; Each names where its grammar lives, so `M-x grammar-install` can fetch it.
;;
;; A matched node is painted whole (`editor/treesit/fontify` stops there), so a template
;; string colours its `string_fragment`s rather than itself — what is inside `${…}` stays
;; code.

(def js-face-table
  {:comment :syntax/comment
   :hash_bang_line :syntax/comment
   :string :syntax/string
   :string_fragment :syntax/string
   :escape_sequence :syntax/string
   :regex :syntax/string
   :number :syntax/number
   :true :syntax/special
   :false :syntax/special
   :null :syntax/special
   :undefined :syntax/special
   :decorator :syntax/special
   ;; named nodes, so the anonymous-keyword rule never sees them
   :this :syntax/keyword
   :super :syntax/keyword})

(def ts-face-table
  (merge js-face-table
    {:type_identifier :syntax/special
     :predefined_type :syntax/special
     :literal_type :syntax/special}))

(def js-indent-spec
  {:width 2
   :blocks #{}
   ;; a `case`'s statements sit one deeper than the `case`, which sits one deeper than
   ;; the `switch` — the body is a bracket, and so is each case
   :brackets #{:statement_block
               :class_body :object :array :arguments :formal_parameters :switch_body
               :switch_case :switch_default :object_pattern :array_pattern
               :parenthesized_expression :named_imports :export_clause :template_substitution
               :jsx_element :jsx_opening_element :jsx_self_closing_element}
   ;; a JSX closing tag leaves its element the way `}` leaves a block
   :dedent #{"</"}})

(def ts-indent-spec
  (assoc js-indent-spec
    :brackets
      (into (get js-indent-spec :brackets)
        #{:interface_body :enum_body :object_type :type_arguments :type_parameters})))

(def- *js-item-start*
  "^((export|import|function|class|const|let|var|async|interface|type|enum|declare|abstract|namespace|module)\\b|//|@|\\})")

;; a block comment or a template string — either may hold anything, column 0 included
(def- *js-opaque-opener* "/\\*|`")

(defn js-fontify-restart (src pos)
  "JavaScript / TypeScript's `:fontify-restart`: the previous column-0 line that starts a
statement, unless a block comment or template string opens above it in this window."
  (column0-item-restart src pos *js-item-start* *js-opaque-opener*))

(def js-definitions
  {:kinds #{:function_declaration
            :generator_function_declaration :class_declaration
            :method_definition :lexical_declaration}})

(def ts-definitions
  {:kinds (into (get js-definitions :kinds)
            #{:interface_declaration
              :type_alias_declaration :enum_declaration :abstract_class_declaration :module})})

(deflanguage javascript
  {:lang :javascript
   :pattern "\\.(js|mjs|cjs|jsx)$"
   :faces languages/js-face-table
   :indent languages/js-indent-spec
   :restart 'languages/js-fontify-restart
   :format ["prettier" "--write" "--log-level" "warn"]
   :definitions languages/js-definitions
   :grammar "https://github.com/tree-sitter/tree-sitter-javascript"
   :comment "// "})

(deflanguage typescript
  {:lang :typescript
   :pattern "\\.(ts|mts|cts)$"
   :faces languages/ts-face-table
   :indent languages/ts-indent-spec
   :restart 'languages/js-fontify-restart
   :format ["prettier" "--write" "--log-level" "warn"]
   :definitions languages/ts-definitions
   :grammar {:url "https://github.com/tree-sitter/tree-sitter-typescript" :subdir "typescript"}
   :comment "// "})

(deflanguage tsx
  {:lang :tsx
   :pattern "\\.tsx$"
   :faces languages/ts-face-table
   :indent languages/ts-indent-spec
   :restart 'languages/js-fontify-restart
   :format ["prettier" "--write" "--log-level" "warn"]
   :definitions languages/ts-definitions
   :grammar {:url "https://github.com/tree-sitter/tree-sitter-typescript" :subdir "tsx"}
   :comment "// "})

(def go-face-table
  {:comment :syntax/comment
   :interpreted_string_literal :syntax/string
   :raw_string_literal :syntax/string
   :rune_literal :syntax/string
   :int_literal :syntax/number
   :float_literal :syntax/number
   :imaginary_literal :syntax/number
   :true :syntax/special
   :false :syntax/special
   :nil :syntax/special
   :iota :syntax/special
   :type_identifier :syntax/special})

;; gofmt's layout: tabs, and a `case` at the `switch`'s own level with its statements one
;; deeper. A switch carries its braces itself (there is no body node), so the switch IS the
;; bracket — its statements one deeper — and a `case` / `default` line backs out of it.
(def go-indent-spec
  {:width 8
   :blocks #{}
   :brackets #{:block
               :field_declaration_list :interface_type :literal_value :argument_list
               :parameter_list :import_spec_list :var_spec_list :const_declaration
               :type_declaration :parenthesized_expression
               :expression_switch_statement :type_switch_statement :select_statement}
   :dedent #{"case" "default"}})

(def- *go-item-start* "^((func|type|var|const|import|package)\\b|//|\\})")

;; a block comment or a raw string — `…` spans lines
(def- *go-opaque-opener* "/\\*|`")

(defn go-fontify-restart (src pos)
  "Go's `:fontify-restart`: the previous column-0 line that starts a declaration, unless a
block comment or raw string opens above it in this window."
  (column0-item-restart src pos *go-item-start* *go-opaque-opener*))

(deflanguage go
  {:lang :go
   :pattern "\\.go$"
   :faces languages/go-face-table
   :indent languages/go-indent-spec
   :indent-tabs true
   :restart 'languages/go-fontify-restart
   :format ["gofmt" "-w"]
   :definitions {:kinds #{:function_declaration :method_declaration :type_declaration}}
   :grammar "https://github.com/tree-sitter/tree-sitter-go"
   :comment "// "})

(def c-face-table
  (merge {:comment :syntax/comment
          :string_literal :syntax/string
          :system_lib_string :syntax/string
          :char_literal :syntax/string
          :number_literal :syntax/number
          :true :syntax/special
          :false :syntax/special
          :null :syntax/special
          :primitive_type :syntax/special
          :type_identifier :syntax/special
          :preproc_directive :syntax/keyword}
    ; a directive the grammar does not know
    ;; `#include`, `#define`, … are ANONYMOUS tokens beginning with `#`, which the keyword
    ;; rule (a token beginning with a letter) cannot see — so they are named here by kind
    (into {}
      (map ["#include"
             "#define" "#undef" "#if" "#ifdef" "#ifndef" "#elif" "#elifdef" "#elifndef" "#else"
             "#endif"]
        (fn (directive) [(keyword directive) :syntax/keyword])))))

;; Four columns (K&R and most C; clang-format's LLVM default is two), and a `case` at the
;; `switch`'s level with its statements one deeper — the switch body is a block like any
;; other, and `case` / `default` back out of it.
(def c-indent-spec
  {:width 4
   :blocks #{}
   :brackets #{:compound_statement
               :field_declaration_list :enumerator_list :initializer_list :argument_list
               :parameter_list :parenthesized_expression}
   :dedent #{"case" "default"}})

;; a column-0 line in C that is not code is inside a block comment; a declaration starts
;; with a word, a preprocessor line with `#`
(def- *c-item-start* "^([A-Za-z_#]|//|\\})")

(def- *c-opaque-opener* "/\\*")

(defn c-fontify-restart (src pos)
  "C's `:fontify-restart`: the previous column-0 line that starts a declaration or a
directive, unless a block comment opens above it in this window."
  (column0-item-restart src pos *c-item-start* *c-opaque-opener*))

(deflanguage c
  {:lang :c
   :pattern "\\.[ch]$"
   :faces languages/c-face-table
   :indent languages/c-indent-spec
   :restart 'languages/c-fontify-restart
   :format ["clang-format" "-i"]
   :definitions {:kinds #{:function_definition :struct_specifier :enum_specifier :union_specifier}}
   :grammar "https://github.com/tree-sitter/tree-sitter-c"
   :comment "// "})

;; ---- the configuration formats: tables over std's `editor/lexer` ---------------------
;; Fontify-only layers like env-mode and docker-mode; the lexing is `lex-configs`'.
;; The `:file-pattern` matches the file's basename, so the extensionless names
;; (`Makefile`, `COMMIT_EDITMSG`, `.gitconfig`) trigger too. Line-oriented: each restarts at
;; the viewport's own line (`editor/highlight/line-restart`), so a keystroke lexes the band alone.

(def json-mode-layer
  {:name 'json
   :file-pattern "\\.(json|jsonc|json5|jsonl|webmanifest)$|(^|/)\\.(babelrc|eslintrc|prettierrc)$"
   :fontify 'lex-configs/json-spans
   :fontify-restart 'editor/highlight/line-restart
   :comment-syntax "// "})

(register-language-mode 'languages/json-mode-layer :json)

(def yaml-mode-layer
  {:name 'yaml
   :file-pattern "\\.(ya?ml)$|(^|/)\\.(clang-format|yamllint)$"
   :fontify 'lex-configs/yaml-spans
   :fontify-restart 'editor/highlight/line-restart
   :comment-syntax "# "})

(register-language-mode 'languages/yaml-mode-layer :yaml)

(def toml-mode-layer
  {:name 'toml
   :file-pattern "\\.toml$|(^|/)(Cargo|Pipfile|poetry)\\.lock$"
   :fontify 'lex-configs/toml-spans
   :fontify-restart 'editor/highlight/line-restart
   :comment-syntax "# "})

(register-language-mode 'languages/toml-mode-layer :toml)

(def makefile-mode-layer
  {:name 'makefile
   :file-pattern "(^|/)(GNUmakefile|Makefile|makefile)$|\\.(mk|make)$"
   :fontify 'lex-configs/makefile-spans
   :fontify-restart 'editor/highlight/line-restart
   :comment-syntax "# "})

(register-language-mode 'languages/makefile-mode-layer :makefile)

(def ini-mode-layer
  {:name 'ini
   :file-pattern "\\.(ini|cfg|conf|properties|gitconfig|gitmodules|editorconfig|npmrc|service|desktop)$|(^|/)\\.(gitconfig|gitmodules|editorconfig|npmrc|hgrc)$"
   :fontify 'lex-configs/ini-spans
   :fontify-restart 'editor/highlight/line-restart
   :comment-syntax "# "})

(register-language-mode 'languages/ini-mode-layer :ini)

(def gitcommit-mode-layer
  {:name 'gitcommit
   :file-pattern "(^|/)(COMMIT_EDITMSG|MERGE_MSG|TAG_EDITMSG|SQUASH_MSG|NOTES_EDITMSG)$"
   :fontify 'lex-configs/gitcommit-spans
   :fontify-restart 'editor/highlight/line-restart})

(register-language-mode 'languages/gitcommit-mode-layer :gitcommit)

;; ---- org-mode: outlines, TODOs and folding ---------------------------------------------
;; The text is `org`'s (src/org.blsp): the colouring and the outline facts (a heading's
;; level, where its subtree ends, the TODO cycle). Folding is the editor's
;; (src/folds.blsp) — this mode supplies what a fold covers (`:fold-extent`) and the keys.
;; Prose wraps, as in markdown: an Org paragraph is one long line.

(defn org-fold-extent (lines line)
  "Org's `:fold-extent`: the last line of the subtree under the heading at `line` of
`lines`, or nil when `line` is not a heading."
  (when (org/heading-level (nth lines line ""))
    (org/subtree-end lines line)))

(defn- org-current-line (buf) (wrap/line-text buf (editor/buffer/buffer-current-line buf)))

(defn- org-replace-line (m f)
  ;; the current line replaced by `(f text)`, point keeping its distance from the line's end
  (let (buf (model/ed-current-buf m)
        line (editor/buffer/buffer-current-line buf)
        text (wrap/line-text buf line)
        start (text/line->char (editor/buffer/buffer-rope buf) line)
        from-end (- (string/length text) (editor/buffer/buffer-column buf))
        replaced (f text))
    (first (model/ed-try-edit m
             (fn (b)
               (editor/buffer/goto-char (editor/buffer/replace-region b
                                          start
                                          (+ start (string/length text))
                                          replaced)
                 (+ start (math/max 0 (- (string/length replaced) from-end)))))))))

(defcommand cmd-org-cycle
  (m key)
  "TAB in Org: on a heading, cycle its subtree FOLDED → CHILDREN → SUBTREE (Org's
`org-cycle`); anywhere else, indent or complete as TAB always does."
  (let (buf (model/ed-current-buf m)
        [cycled state] (folds/cycle-heading buf (editor/buffer/buffer-current-line buf)))
    (if (nil? state)
      (commands/cmd-indent-or-complete m key)
      (model/message (model/ed-set-buf m cycled)
        (case state :folded "FOLDED" :children "CHILDREN" "SUBTREE")))))

(defcommand cmd-org-cycle-buffer
  (m key)
  "S-TAB in Org: every heading folded (the overview), or everything shown."
  (let ([cycled state] (folds/cycle-buffer (model/ed-current-buf m)))
    (model/message (model/ed-set-buf m cycled) (if (= state :overview) "OVERVIEW" "SHOW ALL"))))

(defcommand cmd-org-todo
  (m key)
  "Step the heading's TODO keyword: none → TODO → DONE → none (C-c C-t, Org's `org-todo`)."
  (if (nil? (org/heading-level (org-current-line (model/ed-current-buf m))))
    (model/message m "not on a heading")
    (org-replace-line m org/cycle-todo)))

(defn- org-heading-from (lines line step)
  ;; the nearest heading line from `line` in direction `step`, or nil
  (let (next (+ line step))
    (cond
      (or (< next 0) (>= next (count lines))) nil
      (org/heading-level (nth lines next)) next
      else (org-heading-from lines next step))))

(defn- org-heading-move (m step none)
  (let (buf (model/ed-current-buf m)
        lines (string/split (editor/buffer/buffer-text buf) "\n")
        target (org-heading-from lines (editor/buffer/buffer-current-line buf) step))
    (if (nil? target)
      (model/message m none)
      (model/ed-set-buf m
        (editor/buffer/goto-char buf (text/line->char (editor/buffer/buffer-rope buf) target))))))

(defcommand cmd-org-next-heading
  (m key)
  "Move to the next heading, at any level (C-c C-n)."
  (org-heading-move m 1 "No next heading"))

(defcommand cmd-org-previous-heading
  (m key)
  "Move to the previous heading, at any level (C-c C-p)."
  (org-heading-move m -1 "No previous heading"))

(defn- org-change-level (m delta)
  (let (text (org-current-line (model/ed-current-buf m))
        level (org/heading-level text))
    (cond
      (nil? level) (model/message m "not on a heading")
      (and (< delta 0) (= level 1)) (model/message m "cannot promote a top-level heading")
      else
        (org-replace-line m
          (fn (line) (if (< delta 0) (string/substring line 1 (string/length line)) (str "*" line)))))))

(defcommand cmd-org-promote
  (m key)
  "One star fewer on this heading (M-<left>, Org's `org-do-promote`)."
  (org-change-level m -1))

(defcommand cmd-org-demote
  (m key)
  "One star more on this heading (M-<right>, Org's `org-do-demote`)."
  (org-change-level m 1))

(defcommand cmd-org-meta-return
  (m key)
  "A new heading at this one's level on the line below (M-RET); off a heading, a newline."
  (let (level (org/heading-level (org-current-line (model/ed-current-buf m))))
    (if (nil? level)
      (commands/cmd-newline m key)
      (let (at-end (model/ed-set-buf m (editor/buffer/end-of-line (model/ed-current-buf m))))
        (first (model/ed-try-edit at-end
                 (fn (b) (editor/buffer/insert b (str "\n" (string/repeat "*" level) " ")))))))))

(defn org-on-move (m)
  "org-mode's `:on-move`: point that lands inside a fold some way other than C-n / C-p
— a search, a jump — opens it, so the cursor is never in hidden text."
  (let (buf (model/ed-current-buf m)
        revealed (folds/reveal buf))
    (if (= revealed buf) m (model/ed-set-buf m revealed))))

(def org-keymap
  (-> {}
    (editor/keymap/keymap-bind [:tab] 'languages/cmd-org-cycle)
    (editor/keymap/keymap-bind [:back-tab] 'languages/cmd-org-cycle-buffer)
    (editor/keymap/keymap-bind [:ctrl-c :ctrl-t] 'languages/cmd-org-todo)
    (editor/keymap/keymap-bind [:ctrl-c :ctrl-n] 'languages/cmd-org-next-heading)
    (editor/keymap/keymap-bind [:ctrl-c :ctrl-p] 'languages/cmd-org-previous-heading)
    (editor/keymap/keymap-bind [:alt-left] 'languages/cmd-org-promote)
    (editor/keymap/keymap-bind [:alt-right] 'languages/cmd-org-demote)
    (editor/keymap/keymap-bind [:alt-enter] 'languages/cmd-org-meta-return)))

(def org-mode-layer
  {:name 'org
   :file-pattern "\\.org$"
   :fontify 'org/org-spans
   :visual-line true
   :fold-extent 'languages/org-fold-extent
   :on-move 'languages/org-on-move
   :keymap languages/org-keymap
   :commands (layer-commands languages/org-keymap)
   :comment-syntax "# "})

(register-language-mode 'languages/org-mode-layer :org)
