(defmodule systemtheme
  "Following the desktop's light or dark setting (brood's `gui/color-scheme`). With init.blsp's
`:theme` unset, the window opens in `:theme-light` or `:theme-dark` as the desktop is
(`startup/apply-look`), and this keeps it so: every `*check-ms*` the desktop is asked again —
off the loop, since asking runs its settings tool — and a change re-themes the editor live, as
M-x theme-select does. A `:theme` you named stays; a served session's desktop is its client's,
and a test never asks."
  (:use model)) ; register-timer-client / register-task-reply / message

(def *check-ms* 30000) ; how often the desktop is asked again

(defn following? (m)
  "Whether `m` follows the desktop's setting: a local window whose init.blsp names no `:theme`
(`:theme-follows-system`, which startup sets)."
  (and (:theme-follows-system m) (:gui m)))

(defn check-timer (m)
  "The timer client's question: every `*check-ms*`, while following."
  (when (following? m) {:every *check-ms*}))

(defn check (m)
  "The timer's step: ask the desktop, off the loop — unless the last question is still out."
  (if (:system-scheme-job m) m (assoc m :system-scheme-job (task/task (fn () (gui/color-scheme))))))

(defn scheme-arrived (m scheme)
  "The desktop's answer `scheme` (`:light`, `:dark`, nil): the theme re-applied when it changed
since the last answer, the first answer only noted (startup already themed by it)."
  (let (seen (:system-scheme m)
        noted (assoc m :system-scheme scheme))
    (cond
      (or (nil? scheme) (nil? seen) (= scheme seen)) noted
      else
        (let (name (if (= scheme :light) (:theme-light m) (:theme-dark m)))
          (if name (themes/themes-apply noted name) noted)))))

(register-timer-client :system-theme 'systemtheme/check-timer 'systemtheme/check)
(register-task-reply :system-scheme-job 'systemtheme/scheme-arrived nil nil)
