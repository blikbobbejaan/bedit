(defmodule dired
  "Dired — a directory browser (C-x d / C-x C-j), Emacs's `dired`: a listing of a directory,
navigated and operated by single keys (`dired/dired-keymap`). Opening a directory from
anywhere comes here: `pool` reaches it at runtime ([[ed-show-dired]]) rather than
through its header, because this module builds on `pool` — the find-file prompt, the
default directory, the line motions — and a header each way would be a cycle."
  (:use modes :only []) ; register-special-type runs at load, after modes declares its kinds
  (:use editor/keymap :only [keymap-bind]) ; the mode keymap below
  (:use minibuffer)
  (:use lifecycle :only [ed-map-y-or-n]) ; R and C ask about each target that exists
  (:use model) ; message / ed-current-buf / ed-set-buf — the model a listing lives on
  (:use pool) ; ed-visit-file / ed-default-dir / ed-path-prompt / ed-show-named
  (:use editor/buffer) ; make-buffer / buffer-text / goto-char — the listing buffer
  (:use interactive) ; defcommand — the dired commands, on M-x
  (:use fileperm) ; perms-string — the `ls -l` permission column
  (:use fileops :only []) ; copy, move and delete trees, the trash — loaded with dired
  (:use projects) ; recent-files — the Dired prompt floats recent directories up
  (:use theme)) ; the palette the listing is coloured from
;; ---- dired (a directory browser, C-x d / C-x C-j) -----------------------------------
;; The same generated-read-only-buffer pattern as occur/process-menu: a listing of a
;; directory, navigated and operated by single keys (see dired/dired-keymap). State
;; lives on the listing's buffer ([[ed-dired-state]]) — `:dired-dir` (absolute dir),
;; `:dired-names` (entry names in display order), `:dired-marks` and `:dired-flags` — so the
;; command under point recovers its target by INDEX (the current line minus the one header line →
;; `:dired-names[i]`), robust to any filename (spaces included), never re-parsing
;; formatted columns. File ops are the `file/` primitives (mkdir, rename, cp) and `fileops`
;; (a whole tree copied or moved, the trash D and x delete into).
;;
;; The listing is the classic GNU `ls -l` layout (emacs `diredfl`): each row is
;; `<mark><perms> <nlink> <owner> <group> <size> <Mon DD HH:MM> <name>`, one `file-stat`
;; per entry (a single syscall yielding perms/nlink/owner/group/size/mtime). `dired-fontify` (the mode's :fontify service)
;; paints directory names blue, symlinks teal, executables green, the permission string
;; and owner/group/size dim, the date warm, and a `*` mark peach. Colours live in
;; `face-dired-*` (below), formulas over the theme palette.

(def- ed-dired-header-lines 1) ; the leading header line (the directory path)
;; Fixed leading layout: a 1-char mark cell, then the 10-char permission string; the
;; whitespace-delimited fields (nlink/owner/group/size + the 3 date tokens) follow,
;; their widths computed per listing so the columns align like `ls`. `dired-fontify`
;; finds the name by skipping those fields, so a long/space-bearing name never confuses
;; it; `ed-dired-name-at` never parses columns at all (it indexes by line).
(def- ed-dired-perms-col 1) ; the permission string (after the 1-char mark)
(def- ed-dired-perms-w 10) ; "drwxr-xr-x"
(def- ed-dired-fields-col 11) ; where the whitespace-delimited fields begin (mark+perms)
(def- ed-dired-date-w 12) ; "Mon DD HH:MM"
(def- ed-month-abbrevs ["Jan" "Feb" "Mar" "Apr" "May" "Jun" "Jul" "Aug" "Sep" "Oct" "Nov" "Dec"])

;; ---- per-entry stat → class / perms / size / date ---------------------------

(defn- ed-stat-dir? (stat)
  "True if stat map `stat` is a (followed) directory."
  (and stat (:dir? stat)))

(defn- ed-dired-date (mtime)
  "The mtime column `Mon DD HH:MM` (UTC, `ls`-style), or `ed-dired-date-w` spaces when
unknown — always that width so the name column stays aligned."
  (if (nil? mtime)
    (string/pad-right "" ed-dired-date-w)
    (let (date (datetime/epoch-ms-> mtime))
      (str (nth ed-month-abbrevs (dec (datetime/month date)))
        " "
        (string/pad-left (str (datetime/day date)) 2)
        " "
        (datetime/format date "%H:%M")))))

;; ---- listing: stat each entry once, sorted as the switches say, then render --------
;; Emacs's dired sorts the way its `ls` switches say (`dired-listing-switches`, `-al`):
;; by name — folders and files mixed, as `ls -al` lists them — unless `t` (date, newest
;; first), `S` (size, largest first), `X` (extension) or `U` (directory order) says
;; otherwise, `r` reverses whichever it is, and `--group-directories-first` lifts the folders
;; above the files. `.` and `..` stay on top either way.

(defn dired-sort-of (switches)
  "The order `ls`-style `switches` ask for, `{:key :reverse :dirs-first}` — `:key` one of
`:name` `:time` `:size` `:extension` `:none`, the LAST of `t`/`S`/`X`/`U` given winning, as
in `ls`; `:dirs-first` from `--group-directories-first`. Only short options are read
letter by letter: a long one's letters are not switches.

    (dired/dired-sort-of \"-al\")   ;=> {:key :name :reverse false :dirs-first false}
    (dired/dired-sort-of \"-altr\")   ;=> {:key :time :reverse true :dirs-first false}
    (dired/dired-sort-of \"-al --group-directories-first\")   ;=> {:key :name :reverse false :dirs-first true}"
  (fold (string/split (string/trim (or switches "")) " ")
    {:key :name :reverse false :dirs-first false}
    (fn (acc token)
      (cond
        (= token "--group-directories-first") (assoc acc :dirs-first true)
        (or (string/starts-with? token "--") (not (string/starts-with? token "-"))) acc
        else
          (fold (string/->list token)
            acc
            (fn (sort c)
              (case c
                "t" (assoc sort :key :time)
                "S" (assoc sort :key :size)
                "X" (assoc sort :key :extension)
                "U" (assoc sort :key :none)
                "r" (assoc sort :reverse true)
                sort)))))))

(defn- without-leading-dots (name)
  ;; `name` past its leading dots: `.bashrc` → `bashrc`, `..` → ""
  (let (n (string/length name))
    (letrec (skip (fn (i) (if (and (< i n) (= (string/char-at name i) ".")) (skip (inc i)) i)))
      (string/substring name (skip 0) n))))

(defn dired-name-key (name)
  "How a name sorts in `ls -al`'s order: case and a leading dot ignored (`.bashrc` among
the b's), the exact name breaking a tie so the order is total."
  [(string/lower (without-leading-dots name)) name])

(defn- dired-extension (name)
  ;; a name's extension for `X`: what follows its last dot, or "" (a dotfile has none)
  (let (base (without-leading-dots name)
        dot (string/last-index-of base "."))
    (if (< dot 0) "" (string/substring base (inc dot) (string/length base)))))

(defn dired-sort-entries (entries sort)
  "`entries` (`{:name :stat}`) in the order `sort` ([[dired-sort-of]]) asks for: name as
[[dired-name-key]], date and size largest first with the name breaking ties, extension then
name, or as listed. `:reverse` flips the result; `:dirs-first` then lifts the folders above
the files, each group keeping that order (`ls --group-directories-first`)."
  (let (by (case (:key sort)
             :time (fn (e) [(- (or (map/get-in e [:stat :mtime]) 0)) (dired-name-key (:name e))])
             :size (fn (e) [(- (or (map/get-in e [:stat :size]) 0)) (dired-name-key (:name e))])
             :extension
               (fn (e) [(string/lower (dired-extension (:name e))) (dired-name-key (:name e))])
             :none nil
             (fn (e) (dired-name-key (:name e))))
        ordered (if (nil? by) (into [] entries) (into [] (seq/sort-by entries by)))
        sorted (if (:reverse sort) (into [] (reverse ordered)) ordered))
    (if (:dirs-first sort)
      (into (into [] (seq/filter sorted (fn (e) (ed-stat-dir? (:stat e)))))
        (seq/reject sorted (fn (e) (ed-stat-dir? (:stat e)))))
      sorted)))

(defn- ed-dired-list (dir switches)
  "The display-ordered entries of `dir`, each `{:name :stat}` (one `file-stat` per entry):
`.` then `..`, then every entry in the order `switches` ask for ([[dired-sort-of]]) —
folders and files mixed, as `ls -al` lists them. Robust to an unreadable `dir` (just
`.`/`..`)."
  (let (names (try (file/ls dir) (catch e '()))
        entries (map names (fn (name) {:name name :stat (file/stat (path/join dir name))})))
    (into [{:name "." :stat (file/stat dir)} {:name ".." :stat (file/stat (path/dirname dir))}]
      (dired-sort-entries entries (dired-sort-of switches)))))

(defn- ed-stat-field-str (stat key fallback)
  "Stat field `key` of `stat` as a string, or `fallback` when the stat or field is missing."
  (str (or (and stat (get stat key)) fallback)))

(defn- ed-dired-cols (entries)
  "Per-listing column widths so the fields align like `ls`: the max string width of the
nlink / owner / group / size fields across `entries`."
  (let (widths (fn (key fallback)
                 (apply math/max
                   1
                   (map entries
                     (fn (entry) (string/length (ed-stat-field-str (:stat entry) key fallback)))))))
    {:nlink-w (widths :nlink "1")
     :owner-w (widths :owner "?")
     :group-w (widths :group "?")
     :size-w (widths :size "0")}))

(defn- ed-dired-row (mark stat name cols)
  "One `ls -l` row: `<mark><perms> <nlink> <owner> <group> <size> <date> <name>`, each
field padded to `cols`' widths so the columns line up. `mark` is the mark cell: `*` a
marked row, `D` one flagged for deletion, a space otherwise."
  (str mark
    (perms-string stat)
    " "
    (string/pad-left (ed-stat-field-str stat :nlink "1") (:nlink-w cols))
    " "
    (string/pad-right (ed-stat-field-str stat :owner "?") (:owner-w cols))
    " "
    (string/pad-right (ed-stat-field-str stat :group "?") (:group-w cols))
    " "
    (string/pad-left (ed-stat-field-str stat :size "0") (:size-w cols))
    " "
    (ed-dired-date (and stat (:mtime stat)))
    " "
    name))

(defn- ed-dired-header (dir)
  "The header line: the absolute directory path (trailing `:`, `ls`/dired style)."
  (str dir ":"))

(defn ed-dired-text (dir entries marks &optional (flags (list)))
  "The dired buffer text: the header line then one `ed-dired-row` per entry (columns
sized to the listing), a row marked `*` when its name is in `marks`, `D` when it is in
`flags` (flagged for deletion, Emacs `d`)."
  (let (cols (ed-dired-cols entries))
    (str (ed-dired-header dir)
      "\n"
      (string/join (map entries
                     (fn (entry)
                       (ed-dired-row (cond
                                       (includes? flags (:name entry)) "D"
                                       (includes? marks (:name entry)) "*"
                                       else " ")
                         (:stat entry)
                         (:name entry)
                         cols)))
        "\n")
      "\n")))

(defn ed-dired-switches (m dir)
  "The `ls` switches `dir` is listed with: the ones set for it by `s` / `C-u s` (kept per
directory, as Emacs keeps them per Dired buffer), else `dired-listing-switches` from the
config, else `-al`."
  (or (map/get-in m [:dired-switches dir]) (:dired-listing-switches m) "-al"))

(defn ed-dired-state (m key)
  "`key` of the selected buffer's Dired state: `:dired-dir` (the directory it lists),
`:dired-names` (its entries in display order — a line's entry is found by index),
`:dired-marks` and `:dired-flags`. The state lives ON the listing's buffer, as Emacs keeps
it buffer-local, so two listings never read each other's — a D in one never deletes the entry
at the same line of another."
  (get (ed-current-buf m) key))

(defn- ed-dired-put (m key value)
  "`m` with the selected Dired buffer's state `key` set to `value`."
  (ed-set-buf m (assoc (ed-current-buf m) key value)))

(defn- ed-dired-clear-marks (m dir)
  "`m` with every mark and deletion flag of `dir`'s listing removed — reached by the
buffer's NAME (the directory), not the selection, since a prompt's answer can arrive after
the user moved on."
  (ed-update-named m dir (fn (buffer) (assoc buffer :dired-marks '() :dired-flags '()))))

(defn ed-show-dired (m dir &optional (line nil))
  "Build/refresh the read-only dired listing for `dir` in the selected pane (the buffer
is named by the absolute directory path, so revisiting reuses it), recording its
`:dired-dir`/`:dired-names` on that buffer ([[ed-dired-state]]), and put point on (1-based)
`line` — default the first entry. The listing's marks and flags carry over from the buffer
it replaces, so they survive a refresh and a revisit, and an entry no longer listed drops out."
  (let (dir (path/normalize (path/absolute dir)) ; no `./` in the listing's title
        previous-index (ed-buffer-index-by-name m dir)
        previous (if (nil? previous-index) {} (nth (:buffers m) previous-index))
        entries (ed-dired-list dir (ed-dired-switches m dir))
        names (into [] (map entries :name))
        listed (into #{} names)
        still-listed (fn (key)
                       (seq/filter (or (get previous key) '()) (fn (name) (contains? listed name))))
        marks (still-listed :dired-marks)
        flags (still-listed :dired-flags)
        m1 (ed-show-named m dir (ed-dired-text dir entries marks flags) :dired)
        ;; the Dired buffer's default-directory IS the dir it lists (every buffer carries
        ;; `:dir`; this is where find-file / C-x p f resolve from when you're in Dired).
        m2 (ed-set-buf m1
             (assoc (ed-current-buf m1)
               :dir dir
               :dired-dir dir
               :dired-names names
               :dired-marks marks
               :dired-flags flags)))
    ;; land point ON the filename (not the leading mark column), Emacs dired-style
    (ed-apply m2
      (fn (buffer)
        (ed-dired-move-to-filename (ed-goto-line buffer (or line (inc ed-dired-header-lines))))))))

(defn- ed-dired-goto-entry (m index)
  "`m` with point on the filename of the listing's entry `index` (into `:dired-names`), or as
it is for an entry not listed (-1)."
  (if (< index 0)
    m
    (ed-apply m
      (fn (buffer)
        (ed-dired-move-to-filename (ed-goto-line buffer (+ ed-dired-header-lines (inc index))))))))

(defn- ed-dired-entry? (name)
  "Whether `name` is a real entry of the listing: not the `.` / `..` pseudo-entries, nor
nothing (the header, a blank line)."
  (not (or (nil? name) (= name ".") (= name ".."))))

(defn- ed-dired-name-at (m)
  "The entry name on the current line of the dired buffer, or nil on the header / a
blank line (the index is the line offset past the header into `:dired-names`)."
  (let (i (- (buffer-current-line (ed-current-buf m)) ed-dired-header-lines)
        names (ed-dired-state m :dired-names))
    (if (and (>= i 0) (< i (count names))) (nth names i) nil)))

;; ---- the listing's faces -----------------------------------------------------
;; The `ls -l`-style listing paints each row's columns with these (diredfl-style) —
;; formulas over the theme palette, so a theme switch re-skins them with the rest of
;; the chrome. Directory names lead in the blue accent (bold), symlinks in teal
;; (italic), executables in green; the permission string, owner/group/nlink/size
;; recede in the dim furniture colour, the date a touch warmer; a marked row's `*`
;; flag burns peach. The header path is the mauve accent, bold.

(theme/defchrome face-dired-dir {:fg *blue* :bold true}) ; a directory name
(theme/defchrome face-dired-symlink {:fg *teal* :italic true}) ; a symlink name
(theme/defchrome face-dired-exec {:fg *green* :bold true}) ; an executable file name
(theme/defchrome face-dired-file {:fg *text*}) ; a regular file name
(theme/defchrome face-dired-perms {:fg *subtext*}) ; the rwx permission string
(theme/defchrome face-dired-size {:fg *overlay0*}) ; nlink / owner / group / size (dim)
(theme/defchrome face-dired-date {:fg *peach*}) ; the mtime column
(theme/defchrome face-dired-header {:fg *mauve* :bold true}) ; the directory-path header line
(theme/defchrome face-dired-mark {:fg *peach* :bold true}) ; a marked row's `*` flag
(theme/defchrome face-dired-flag {:fg *red* :bold true}) ; a row flagged for deletion — its `D`

;; ---- dired-fontify: the :fontify service that colours the listing -----------
;; A pure `slice -> [start end face]` like every mode's `:fontify` — it receives a
;; windowed text/slice (the view shifts the spans to absolute coords), so it can't
;; assume slice-line-0 is the header: it classifies each line by STRUCTURE. A row is a
;; mark cell (space/`*`) then a permission string (`drwx…`); anything else is the header
;; path. A row is painted in `ls -l` columns: the `*` mark, the perms dim, the
;; nlink/owner/group/size fields dim, the date warm, and the name in its type colour.
;; The name is found by skipping the fixed leading columns + the seven whitespace fields,
;; so a filename with spaces (or any width) never confuses the colouring.

(defn- ed-dired-row-line? (line)
  "True if `line` looks like an `ls -l` row — a mark cell (space/`*`), a type char
(`d`/`l`/`-`), then the first permission bit (`r`/`-`)."
  (and (>= (string/length line) ed-dired-fields-col)
    (includes? (list " " "*" "D") (string/substring line 0 1))
    (includes? (list "d" "l" "-") (string/substring line 1 2))
    (includes? (list "r" "-") (string/substring line 2 3))))

(defn- ed-dired-name-face (line)
  "The name colour for an `ls -l` row, read from its permission string: dir → blue,
symlink → teal, an owner-executable file → green, else the plain file colour."
  (cond
    (= (string/substring line 1 2) "d") face-dired-dir
    (= (string/substring line 1 2) "l") face-dired-symlink
    (= (string/substring line 4 5) "x") face-dired-exec ; the owner-execute bit
    else face-dired-file))

(defn- ed-dired-skip-spaces (line i end)
  (if (and (< i end) (= (string/char-at line i) " ")) (ed-dired-skip-spaces line (inc i) end) i))
(sig ed-dired-skip-spaces (string int int -> int))

(defn- ed-dired-token-end (line i end)
  (if (and (< i end) (not (= (string/char-at line i) " "))) (ed-dired-token-end line (inc i) end) i))
(sig ed-dired-token-end (string int int -> int))

(defn- ed-dired-fields (line i end wanted acc)
  "Collect the `[start end]` of the next `wanted` whitespace-delimited tokens of `line` from
index `i`, returning `[token-spans name-start]` — `name-start` the first non-space past them."
  (if (= wanted 0)
    [(reverse acc) (ed-dired-skip-spaces line i end)]
    (let (start (ed-dired-skip-spaces line i end)
          stop (ed-dired-token-end line start end))
      (if (>= start end)
        [(reverse acc) end]
        (ed-dired-fields line stop end (dec wanted) (cons [start stop] acc))))))
(sig ed-dired-fields (string int int int list -> (tuple list int)))

(defn- ed-dired-meta-spans (offset tokens i acc)
  "Spans for the metadata `tokens` at slice offset `offset`: nlink/owner/group/size (the
first four) in the dim size face, the three date tokens in the date face."
  (if (empty? tokens)
    (reverse acc)
    (let ([start end] (first tokens))
      (ed-dired-meta-spans offset
        (rest tokens)
        (inc i)
        (cons [(+ offset start) (+ offset end) (if (>= i 4) face-dired-date face-dired-size)]
          acc)))))

(defn- ed-dired-row-spans (line offset size)
  "The `[start end face]` spans for an `ls -l` row `line` whose first char is at slice
offset `offset` (`size` its length): the `*` mark, the perms string, the metadata fields,
and the name in its type colour. Ascending + non-overlapping."
  (let ([tokens name-start] (ed-dired-fields line ed-dired-fields-col size 7 '())
        name-face (ed-dired-name-face line))
    (append (cond
              (= (string/substring line 0 1) "*") (list [offset (+ offset 1) face-dired-mark])
              (= (string/substring line 0 1) "D") (list [offset (+ offset 1) face-dired-flag])
              else '())
      (list [(+ offset ed-dired-perms-col)
              (+ offset ed-dired-perms-col ed-dired-perms-w)
              face-dired-perms])
      (ed-dired-meta-spans offset tokens 0 '())
      (if (> size name-start) (list [(+ offset name-start) (+ offset size) name-face]) '()))))

(defn- ed-dired-line-spans (line offset)
  "Spans for one dired line at slice offset `offset`: a row's columns, or the whole line in
the header face when it isn't a row (and `()` for a blank trailing line)."
  (let (size (string/length line))
    (cond
      (= size 0) '()
      (ed-dired-row-line? line) (ed-dired-row-spans line offset size)
      else (list [offset (+ offset size) face-dired-header]))))

(defn dired-fontify (src)
  "The dired `:fontify` service: `[start end face]` colour spans for a rendered listing
slice `src`. Line-structural (no lexer state), so the windowed slice the view passes
fontifies correctly wherever it starts."
  (modes/fontify-lines src ed-dired-line-spans))

;; ---- point-on-filename: keep the cursor on the name, not column 0 -----------
;; Emacs dired puts point (and the block cursor) on the filename. The name's column
;; varies per listing (owner/group widths), so it's found the same way `dired-fontify`
;; does: skip the mark+perms and the seven whitespace fields. Line motion (n/p/arrows)
;; snaps through here, and `ed-show-dired` lands here too.

(defn- ed-dired-filename-col (line)
  "The column on dired row `line` where the filename starts — past the mark+perms and the
seven whitespace fields; 0 when `line` isn't a row (so point isn't pulled off the header)."
  (if (ed-dired-row-line? line)
    (second (ed-dired-fields line ed-dired-fields-col (string/length line) 7 '()))
    0))

(defn- ed-dired-move-to-filename (buffer)
  "Move point onto the current line's filename (the cursor sits on the name, not the
leading mark column) — a no-op on the header line."
  (let (line (buffer-current-line buffer)
        line-start (text/line->char (buffer-rope buffer) line))
    (goto-char buffer (+ line-start (ed-dired-filename-col (wrap/line-text buffer line))))))

(defn- ed-dired-snap (m)
  "Apply `ed-dired-move-to-filename` to the current buffer (after a line move)."
  (ed-apply m ed-dired-move-to-filename))

(defcommand cmd-dired-next-line
  (m key)
  "Move to the next line and onto its filename (n / C-n / down)."
  (ed-dired-snap (motion/cmd-next-line m key)))

(defcommand cmd-dired-previous-line
  (m key)
  "Move to the previous line and onto its filename (p / C-p / up)."
  (ed-dired-snap (motion/cmd-previous-line m key)))

(defn- ed-dired-index-of (names target)
  "The position of `target` in the listing's `names`, or -1 — for a name not listed (a
file not saved yet) and for no target alike, so the caller lands on the first entry."
  (if (nil? target) -1 (index-of names target)))
(sig ed-dired-index-of (vector (or nil string) -> int))

(defcommand cmd-dired-jump
  (m key)
  "Open dired on the current buffer's directory with point on its file (C-x C-j / C-x j —
Emacs `dired-jump`): no prompt, the listing itself is the selector. A buffer with no file
(a scratch, a report) jumps to its `:dir` / the working directory, point on the first
entry; a dired buffer jumps to its parent, point on the directory just left."
  (let (buffer (ed-current-buf m)
        file (:file buffer)
        here (ed-dired-state m :dired-dir)
        in-dired? (and here
                    (= here (ed-default-dir m))
                    (= (editor/layers/buffer-type-for buffer) :dired))
        dir (cond
              in-dired? (path/dirname here)
              file (path/dirname file)
              else (ed-default-dir m))
        target (cond
                 in-dired? (path/basename here)
                 file (path/basename file)
                 else nil)
        shown (ed-show-dired m dir))
    (ed-dired-goto-entry shown
      (ed-dired-index-of (or (ed-dired-state shown :dired-names) []) target))))

(defcommand cmd-dired
  (m key)
  "Open a directory browser (dired) on a prompted directory (C-x d / C-x C-d), defaulting to the
current buffer's directory (else the working dir). Uses the **same** path-completing
prompt as find-file (`ed-path-prompt`): a Plume candidate list, Tab-expand, C-w to walk
up — opening dired on the chosen directory."
  (assoc m
    :minibuffer
      (ed-path-prompt "Dired: "
        (str (ed-default-dir m) "/")
        (if (:recent-files m) (recent-files) [])
        (fn (mm typed)
          (if (string/blank? typed)
            (message mm "(no directory)")
            ;; a directory → browse it; a FILE (or a path inside one) → browse its directory
            (let (dir (if (file/dir? typed) typed (path/dirname typed)))
              (if (file/dir? dir)
                (ed-show-dired mm dir)
                (message mm (str "no such directory: " dir)))))))))

;; ---- the other entry points: C-x 4 d (another pane), C-x p d (the project root) ----

(defn ed-show-dired-other-window (m dir)
  "Dired on `dir` in a pane OTHER than the current one, selected — `C-x 4 d`, and `C-x 4 f`
on a directory."
  ;; dired's buffer is generated, so it has to exist before it can be popped to: build it
  ;; here (which selects it), then place it where `C-x 4` promised. The two-step is what
  ;; keeps `ed-show-dired` the single owner of the listing.
  (let (listed (ed-show-dired m dir)
        name (buffer-name (ed-current-buf listed)))
    (ed-pop-to-buffer-named (ed-show-index listed (ed-current-index m)) name 1)))

(defcommand cmd-dired-other-window
  (m key)
  "Open Dired in the other window (C-x 4 d) — on the current buffer's directory."
  (ed-show-dired-other-window m (ed-default-dir m)))

(defcommand cmd-project-dired
  (m key)
  "Open Dired on the current project's root (C-x p d, Emacs `project-dired`). The project
is the one the current buffer is in (`ed-project-root`), not where the editor launched."
  (let (root (ed-project-root m))
    (if (nil? root)
      (message m "not in a project (no project.blsp found)")
      (ed-show-dired m root))))

(defcommand cmd-dired-open
  (m key)
  "Visit the file or enter the directory on the current dired line (RET / f)."
  (let (dir (ed-dired-state m :dired-dir)
        name (ed-dired-name-at m))
    (cond
      (nil? name) (message m "not on an entry")
      (= name ".") (ed-show-dired m dir (inc (buffer-current-line (ed-current-buf m))))
      (= name "..") (ed-show-dired m (path/dirname dir))
      else
        (let (path (path/join dir name))
          (if (file/dir? path) (ed-show-dired m path) (ed-visit-file m path))))))

(defcommand cmd-dired-up
  (m key)
  "Go to the parent directory (^)."
  (ed-show-dired m (path/dirname (ed-dired-state m :dired-dir))))

(defcommand cmd-dired-refresh
  (m key)
  "Re-read and redisplay the directory (g), keeping point on the same line."
  (ed-show-dired m (ed-dired-state m :dired-dir) (inc (buffer-current-line (ed-current-buf m)))))

(defcommand cmd-dired-quit
  (m key)
  "Kill the dired buffer (q)."
  (cmd-kill-buffer m key))

;; ---- sorting (s, C-u s): Emacs's dired-sort-toggle-or-edit -------------------------

(defn- short-option? (token)
  ;; a `-alt`-style token, whose letters are switches (a `--long` one's are not)
  (and (string/starts-with? token "-") (not (string/starts-with? token "--"))))

(defn dired-toggle-switches (switches)
  "`switches` toggled between name and date order, as Emacs's `s` does: a listing by date
loses its `t`; any other gains one (and loses an `S` / `X` / `U` that would outrank it).
Long options such as `--group-directories-first` are kept as they are.

    (dired/dired-toggle-switches \"-al\")   ;=> \"-alt\"
    (dired/dired-toggle-switches \"-alt\")   ;=> \"-al\"
    (dired/dired-toggle-switches \"-alS\")   ;=> \"-alt\"
    (dired/dired-toggle-switches \"-al --group-directories-first\")   ;=> \"-alt --group-directories-first\""
  (let (by-date? (= (:key (dired-sort-of switches)) :time)
        stripped (into []
                   (map (string/split (string/trim switches) " ")
                     (fn (token)
                       (if (short-option? token)
                         (apply str
                           (seq/reject (string/->list token)
                             (fn (c) (includes? ["t" "S" "X" "U"] c))))
                         token))))
        first-short (letrec (scan (fn (i)
                                    (cond
                                      (>= i (count stripped)) nil
                                      (short-option? (nth stripped i)) i
                                      else (scan (inc i)))))
                      (scan 0))
        toggled (cond
                  by-date? stripped
                  (nil? first-short) (into ["-t"] stripped)
                  else (assoc stripped first-short (str (nth stripped first-short) "t"))))
    (string/join (seq/reject toggled (fn (token) (or (= token "") (= token "-")))) " ")))

(defn dired-sort-label (switches)
  "What the mode line says about the order — Emacs's `Dired by name` / `Dired by date`.

    (dired/dired-sort-label \"-al\")   ;=> \"by name\"
    (dired/dired-sort-label \"-alSr\")   ;=> \"by size, reversed\""
  (let (sort (dired-sort-of switches))
    (str (case (:key sort)
           :time "by date"
           :size "by size"
           :extension "by extension"
           :none "unsorted"
           "by name")
      (if (:reverse sort) ", reversed" ""))))

(defn dired-modeline (m buf)
  "dired-mode's `:modeline` segment: the order the listing is in."
  (let (dir (:dir buf)) (when dir (dired-sort-label (ed-dired-switches m dir)))))

(defn- ed-dired-resort (m switches)
  "Re-list the current directory with `switches`, kept for it, point staying on the entry it
was on (a re-sort moves every line)."
  (let (dir (ed-dired-state m :dired-dir)
        name (ed-dired-name-at m)
        shown (ed-show-dired (map/assoc-in m [:dired-switches dir] switches) dir))
    (message (ed-dired-goto-entry shown
               (ed-dired-index-of (or (ed-dired-state shown :dired-names) []) name))
      (str "Dired " (dired-sort-label switches)))))

(defcommand cmd-dired-sort-toggle-or-edit
  (m key)
  "Sort the listing (s — Emacs's `dired-sort-toggle-or-edit`): toggle between name and date
order; with C-u, edit the `ls` switches themselves — `t` date, `S` size, `X` extension, `U`
unsorted, `r` reversed. Kept for this directory; `dired-listing-switches` in the config sets
the default."
  (let (dir (ed-dired-state m :dired-dir)
        switches (ed-dired-switches m dir))
    (if (nil? (current-prefix-arg m))
      (ed-dired-resort m (dired-toggle-switches switches))
      (assoc m
        :minibuffer
          {:edit (ed-mb-edit "ls switches: " switches)
           :on-complete (fn (mm text)
                          (ed-dired-resort mm (if (string/blank? text) "-al" (string/trim text))))}))))

(register-prefix-consuming 'dired/cmd-dired-sort-toggle-or-edit)
;; ---- marking (m / u / U / t → D) and flagging (d / u → x) ---------------------
;; `:dired-marks` is the set (a list, deduped) of marked entry names; a marked row
;; renders with a `*` flag (peach, via dired-fontify) and `cmd-dired-delete` operates on
;; the whole set. Marks live on the listing's buffer and survive a refresh (ed-show-dired).

(defn- ed-dired-set-in (m key name on?)
  "Return `m` with entry `name` added to (`on?`) or removed from the set under `key`
(`:dired-marks` or `:dired-flags`) — each kept a deduped list."
  (let (names (or (ed-dired-state m key) '()))
    (ed-dired-put m
      key
      (if on?
        (if (includes? names name) names (cons name names))
        (seq/reject names (fn (listed) (= listed name)))))))

(defn- ed-dired-mark-set (m name on?)
  "Return `m` with entry `name` marked (`on?` true) or unmarked. Marking clears a
deletion flag on the same entry (one mark cell per row); unmarking clears both."
  (ed-dired-set-in (ed-dired-set-in m :dired-flags name false) :dired-marks name on?))

(defn- ed-dired-flag-set (m name)
  "Return `m` with entry `name` flagged for deletion (its `*` mark, if any, replaced)."
  (ed-dired-set-in (ed-dired-set-in m :dired-marks name false) :dired-flags name true))

(defn- ed-dired-remark (m change)
  "Apply `change` (`(m name) -> m`) to the entry under point, then advance to the next
line and re-render. The `.`/`..` pseudo-entries can't be marked — just advance past them."
  (let (name (ed-dired-name-at m)
        next (+ (buffer-current-line (ed-current-buf m)) 2) ; 1-based line below point
        changed (if (ed-dired-entry? name) (change m name) m))
    (ed-show-dired changed (ed-dired-state m :dired-dir) next)))

(defcommand cmd-dired-mark
  (m key)
  "Mark the entry under point, then advance (m)."
  (ed-dired-remark m (fn (mm name) (ed-dired-mark-set mm name true))))

(defcommand cmd-dired-flag
  (m key)
  "Flag the entry under point for deletion — a `D` in the mark cell — then advance (d,
Emacs `dired-flag-file-deletion`). `x` deletes every flagged entry after a confirm;
`u` unflags."
  (ed-dired-remark m ed-dired-flag-set))

(defcommand cmd-dired-unmark
  (m key)
  "Unmark the entry under point — its `*` mark or its `D` flag — then advance (u)."
  (ed-dired-remark m (fn (mm name) (ed-dired-mark-set mm name false))))

(defcommand cmd-dired-unmark-all
  (m key)
  "Remove every mark and every deletion flag (U)."
  (ed-show-dired (ed-dired-clear-marks m (ed-dired-state m :dired-dir))
    (ed-dired-state m :dired-dir)
    (inc (buffer-current-line (ed-current-buf m)))))

(defcommand cmd-dired-toggle-marks
  (m key)
  "Toggle all marks — every unmarked entry becomes marked and vice versa, excluding
`.`/`..` (t)."
  (let (all (seq/filter (ed-dired-state m :dired-names) ed-dired-entry?)
        ;; sets: a directory listing is unbounded, and this tests every row against every
        ;; mark and every flag
        marked (into #{} (or (ed-dired-state m :dired-marks) '()))
        flagged (into #{} (or (ed-dired-state m :dired-flags) '())))
    ;; a flagged row keeps its D — one mark cell per row, so it is neither marked nor
    ;; unmarked by the toggle
    (ed-show-dired (ed-dired-put m
                     :dired-marks (seq/reject all
                       (fn (name) (or (contains? marked name) (contains? flagged name)))))
      (ed-dired-state m :dired-dir)
      (inc (buffer-current-line (ed-current-buf m))))))

(defn- ed-dired-prompt (m prompt initial run)
  "A minibuffer prompt for a dired file op: `run` is `(model dir text) -> model`,
called with the model, the current `:dired-dir`, and the entered text (a no-op-with-
message on blank input)."
  (let (dir (ed-dired-state m :dired-dir))
    (assoc m
      :minibuffer
        {:edit (ed-mb-edit prompt initial)
         :on-complete (fn (mm typed)
                        (if (string/blank? typed) (message mm "(no name)") (run mm dir typed)))})))

(defn- ed-dired-op (mm dir verb op)
  "Run file-op thunk `op`, then re-render dired for `dir`; on failure show
`<verb> failed: <error>` in the echo area. The shared shape of the dired file ops."
  (try
    (do (op) (ed-show-dired mm dir))
    (catch e (message mm (str verb " failed: " (error-message e))))))

(defcommand cmd-dired-create-dir
  (m key)
  "Create a new subdirectory (+)."
  (ed-dired-prompt m
    "Create directory: "
    ""
    (fn (mm dir typed)
      (ed-dired-op mm dir "mkdir" (fn () (file/mkdir (path/join dir typed)))))))

;; ---- running an operation: R, C, D and x over the marked entries -------------------
;; Emacs's dired acts on the MARKED entries when any are marked, else on the one at point.
;; Each entry is acted on by itself: one that fails is reported and stays marked to try
;; again, the rest are done and unmarked. The work is a thunk over paths alone, never the
;; model, so [[ed-dired-launch]] can run it wherever it likes.

(defn- ed-dired-chosen (m)
  "What an operation acts on: the marked entries in the listing's order, else the entry at
point — none on `.`, `..` or the header."
  (let (marks (into #{} (or (ed-dired-state m :dired-marks) '()))
        under (ed-dired-name-at m))
    (if (empty? marks)
      (if (ed-dired-entry? under) [under] [])
      (into []
        (seq/filter (or (ed-dired-state m :dired-names) []) (fn (name) (contains? marks name)))))))

(defn- dired-run-each (items act)
  "`act` (`item -> any`) run on each of `items`, a failure caught and kept rather than
stopping the rest: `{:done items :failed [[item reason]]}`."
  (fold items
    {:done [] :failed []}
    (fn (acc item)
      (try
        (do (act item) (update acc :done conj item))
        (catch e (update acc :failed conj [item (error-message e)]))))))

(defn- dired-entries-phrase (done)
  ;; what a report says was acted on: the one entry by name, else how many
  (if (= (count done) 1) (str (first done)) (str (count done) " entries")))

(defn- ed-dired-report (m verb report)
  "`m` saying how `report` ([[dired-run-each]], over entry names) went: `verb` and what, or
the first failure and how many failed."
  (let (done (:done report)
        failed (:failed report))
    (message m
      (if (empty? failed)
        (str verb " " (dired-entries-phrase done))
        (let ([item reason] (first failed))
          (str verb
            ": "
            (count failed)
            " of "
            (+ (count done) (count failed))
            " failed — "
            item
            ": "
            reason))))))

(defn- ed-dired-refresh (m dir)
  "`m` with `dir`'s listing read again when it is the buffer shown (point kept on its line);
a listing not shown is read again when it is next opened."
  (if (= (ed-dired-state m :dired-dir) dir)
    (ed-show-dired m dir (inc (buffer-current-line (ed-current-buf m))))
    m))

(defn- ed-dired-unmark-done (m dir names)
  "`m` with `names` taken off the marks and flags of `dir`'s listing — what an operation
finished with; one that failed stays marked to try again."
  (let (finished (into #{} names)
        keep (fn (listed) (seq/reject (or listed '()) (fn (name) (contains? finished name)))))
    (ed-update-named m
      dir
      (fn (buffer)
        (assoc buffer
          :dired-marks (keep (:dired-marks buffer))
          :dired-flags (keep (:dired-flags buffer)))))))

;; A copy of a large tree, a move across filesystems or a delete of one takes as long as the
;; disk does, so it runs OFF the loop (`offloop/ed-open-when-ready`, a task in its own slot):
;; keys keep working, the activity chip names what is running, C-g stops it, and its report
;; is folded in — the listing read again — when it lands. One at a time: a second would race
;; the first over the same files.

(def- dired-job-slot (offloop/ed-ready-slot :dired)) ; the model field a running operation waits in

(defn- ed-dired-unless-busy (m start)
  "`(start)` — an operation's first step — unless a dired operation is still running, which
is said instead: R, C, D and x refuse before their question, not after it."
  (if (nil? (get m dired-job-slot))
    (start)
    (message m "a Dired operation is still running (C-g stops it)")))

(defn- ed-dired-launch (m label work finish)
  "Run `work` (a `() -> report` thunk over paths, never the model) off the loop and fold
`(finish m report)` when it lands; `label` names it in the activity chip. Refused while
another dired operation runs. A headless model (a test) runs it inline."
  (ed-dired-unless-busy m (fn () (offloop/ed-open-when-ready m label work finish :dired))))

;; ---- R and C: rename / move and copy -------------------------------------------------

(defn- ed-dired-target (dir name typed)
  "Where R or C of `name` in `dir` to `typed` goes: `typed` under `dir`, or INTO it when it names
a directory (Emacs's dired), keeping the name."
  (let (target (path/join dir typed))
    (if (file/dir? target) (path/join target name) target)))

(defn- dired-transfer-words (kind)
  ;; how R (`:rename`) and C (`:copy`) are said
  (if (= kind :rename)
    {:prompt "Rename" :running "renaming" :done "Renamed" :word "rename"}
    {:prompt "Copy" :running "copying" :done "Copied" :word "copy"}))

(defn- dired-inside? (source target)
  "Whether `target` is `source` itself or under it — a move or copy that cannot be made."
  (let (from (path/normalize source)
        to (path/normalize target))
    (or (= from to) (string/starts-with? to (str from "/")))))

(defn- dired-transfer-one (kind move)
  "Rename or copy (`kind`) one `move` (`{:name :source :target}`): a whole directory, across
filesystems too. A directory already at the target is never replaced."
  (if (file/dir? (:target move))
    (error (str (:target move) " is a directory, not replaced"))
    (if (= kind :rename)
      (fileops/move-path (:source move) (:target move))
      (fileops/copy-tree (:source move) (:target move)))))

(defn- ed-dired-transfer-run (m dir kind moves)
  "Rename or copy (`kind`) every one of `moves` from `dir`, then: a buffer visiting a renamed
file (or one under a renamed directory) follows it (`pool/ed-file-moved`), the entries done
are unmarked, and the listing is read again."
  (let (words (dired-transfer-words kind))
    (ed-dired-launch m
      (str (:running words) " " (dired-entries-phrase (map moves :name)))
      (fn () (dired-run-each moves (fn (move) (dired-transfer-one kind move))))
      (fn (mm report)
        (let (done (:done report)
              followed (if (= kind :rename)
                         (fold done
                           mm
                           (fn (acc move) (ed-file-moved acc (:source move) (:target move))))
                         mm))
          (ed-dired-report (ed-dired-refresh (ed-dired-unmark-done followed dir (map done :name))
                             dir)
            (:done words)
            {:done (map done :name)
             :failed (map (:failed report) (fn ([move reason]) [(:name move) reason]))}))))))

(defn- ed-dired-transfer-ask (m dir kind moves)
  "Rename or copy `moves`, asking first about each target that exists — `y`, `n`, `!` for it and
every one after, `q` to stop asking (Emacs's dired-do-copy) — and refusing one onto itself or
into itself."
  (let (word (:word (dired-transfer-words kind))
        usable (seq/reject moves (fn (move) (dired-inside? (:source move) (:target move))))
        clashes (seq/filter usable (fn (move) (file/exists? (:target move))))
        fresh (seq/reject usable (fn (move) (file/exists? (:target move)))))
    (cond
      (empty? usable)
        (let (move (first moves))
          (message m
            (if (= (path/normalize (:source move)) (path/normalize (:target move)))
              (str word ": " (:target move) " is the file itself")
              (str word ": " (:target move) " is inside " (:name move)))))
      (empty? clashes) (ed-dired-transfer-run m dir kind fresh)
      else
        (ed-map-y-or-n (dissoc m :dired-accepted)
          clashes
          (fn (move) (str (:target move) " exists; overwrite it?"))
          (fn (answered move)
            (assoc answered :dired-accepted (conj (or (:dired-accepted answered) []) move)))
          (fn (answered accepted)
            (let (chosen (into (into [] fresh) (or (:dired-accepted answered) []))
                  cleared (dissoc answered :dired-accepted))
              (if (empty? chosen)
                (message cleared (str word " canceled"))
                (ed-dired-transfer-run cleared dir kind chosen))))))))

(defn- ed-dired-transfer (m kind)
  "R or C (`kind`): the marked entries — or the one at point — renamed or copied to where the
prompt says. One entry goes to the name typed, or into it when it is a directory; several go
into the directory typed."
  (let (names (ed-dired-chosen m)
        words (dired-transfer-words kind)
        many? (> (count names) 1))
    (if (empty? names)
      (message m (str "not on a " (if (= kind :rename) "renamable" "copyable") " entry"))
      (ed-dired-prompt m
        (if many?
          (str (:prompt words) " " (count names) " marked into: ")
          (str (:prompt words) " " (first names) " to: "))
        (if many? "" (first names))
        (fn (mm dir typed)
          (if (and many? (not (file/dir? (path/join dir typed))))
            (message mm (str (:word words) ": " typed " is not a directory"))
            (ed-dired-transfer-ask mm
              dir
              kind
              (map names
                (fn (name)
                  {:name name
                   :source (path/join dir name)
                   :target (ed-dired-target dir name typed)})))))))))

(defcommand cmd-dired-rename
  (m key)
  "Rename or move the marked entries — or the one at point (R): into a directory when the
answer names one; an existing file is asked about before it is replaced; a buffer visiting a
file (or a file under a renamed directory) follows it to the new name (`pool/ed-file-moved`)."
  (ed-dired-unless-busy m (fn () (ed-dired-transfer m :rename))))

(defcommand cmd-dired-copy
  (m key)
  "Copy the marked entries — or the one at point (C), a directory with everything in it: into a
directory when the answer names one; an existing file is asked about before it is replaced."
  (ed-dired-unless-busy m (fn () (ed-dired-transfer m :copy))))

;; ---- deleting: D (marked, else the entry at point) and x (the flagged) ---------------
;; Emacs's `delete-by-moving-to-trash`: what D and x delete goes to the desktop's trash
;; (`fileops/move-to-trash`), where a file manager can restore it — unless init.blsp's
;; `:delete-by-moving-to-trash` is false, or the machine has no trash this can reach
;; (Windows), and then it is deleted for good after a question that says how many files a
;; directory takes with it.

(defn- ed-dired-trash-wanted? (m)
  "Whether init.blsp asks for deletes to go to the trash — the default."
  (not (= (:delete-by-moving-to-trash m) false)))

(defn dired-delete-question (entries what how)
  "The y/n question before deleting `entries` (`{:label :dir? :files}` each: a name, a
directory's with its slash, and how many files deleting it takes) — `what` names a group of
them (`marked`, `flagged`); `how` is `:trash`, `:delete`, or `:no-trash` (deleting for good
because there is no trash to move to).

    (dired/dired-delete-question [{:label \"a.txt\" :dir? false :files 1}] \"marked\" :trash)   ;=> \"Move a.txt to the trash? (y/n)\"
    (dired/dired-delete-question [{:label \"sub/\" :dir? true :files 214}] \"marked\" :delete)   ;=> \"Delete sub/ and its 214 files for good? (y/n)\"
    (dired/dired-delete-question [{:label \"a\" :dir? false :files 1} {:label \"b/\" :dir? true :files 3}] \"flagged\" :delete)   ;=> \"Delete 2 flagged (4 files in all) for good? (y/n)\""
  (let (single? (= (count entries) 1)
        any-dir? (any? entries :dir?)
        files (fold entries 0 (fn (total entry) (+ total (:files entry))))
        named (if single? (:label (first entries)) (str (count entries) " " what)))
    (if (= how :trash)
      (str "Move " named " to the trash? (y/n)")
      (str (if (= how :no-trash) "No trash here — delete " "Delete ")
        named
        (cond
          (not any-dir?) ""
          single? (str " and its " (ed-count-noun files "file"))
          else (str " (" (ed-count-noun files "file") " in all)"))
        " for good? (y/n)"))))

(defn- dired-delete-entry (dir name count?)
  "The question's view of entry `name` under `dir`: its label, whether it is a directory, and —
when `count?` — how many files deleting it takes (a walk of the tree; else 1)."
  (let (path (path/join dir name)
        stat (file/stat path)
        dir? (= true (and stat (:dir? stat) (not (:symlink? stat)))))
    {:label (if dir? (str name "/") name)
     :dir? dir?
     :files (if count? (fileops/count-files path) 1)}))

(defn- ed-dired-delete-now (m dir names location)
  "Delete `names` under `dir` — into the trash `location`, or for good when it is nil — then
take the deleted off the marks and flags, list `dir` again, and flag an open buffer of a
deleted file as unsaved, saying so ([[ed-dired-orphans]])."
  (ed-dired-launch m
    (str (if location "trashing " "deleting ") (dired-entries-phrase names))
    (fn ()
      (dired-run-each names
        (fn (name)
          (let (path (path/join dir name))
            (if location (fileops/move-to-trash path location) (fileops/remove-path path))))))
    (fn (mm report)
      (ed-dired-orphans (ed-dired-report (ed-dired-refresh (ed-dired-unmark-done mm
                                                             dir
                                                             (:done report))
                                           dir)
                          (if location "Trashed" "Deleted")
                          report)
        (map (:done report) (fn (name) (path/join dir name)))
        (not (nil? location))))))

(defn dired-orphans-note (files trashed?)
  "What the echo area says when deleting left open buffers on `files` (`trashed?`: they went
to the trash) — that the text is still in the editor, and how to put it back.

    (dired/dired-orphans-note [\"/d/x.txt\"] false)   ;=> \"x.txt was deleted; its buffer still holds the text — C-x C-s writes it back\"
    (dired/dired-orphans-note [\"/d/x.txt\" \"/d/y.txt\"] true)   ;=> \"2 open files were moved to the trash; their buffers still hold the text — C-x C-s writes each back\""
  (let (gone (if trashed? "moved to the trash" "deleted"))
    (if (= (count files) 1)
      (str (path/basename (str (first files)))
        " was " gone "; its buffer still holds the text — C-x C-s writes it back")
      (str (count files)
        " open files were " gone "; their buffers still hold the text — C-x C-s writes each back"))))

(defn- ed-dired-orphans (m paths trashed?)
  "`m` after `paths` were deleted: every buffer visiting one (or a file under one) kept and
flagged modified (`pool/ed-file-deleted`), so its next save is a choice rather than a
surprise, and the echo area saying so — the report stays in *Messages*."
  (let ([flagged files] (fold paths
                          [m []]
                          (fn (acc path)
                            (let ([model files] acc
                                  [next more] (ed-file-deleted model path))
                              [next (into files more)]))))
    (if (empty? files) flagged (message flagged (dired-orphans-note files trashed?)))))

(defn- ed-dired-delete-asking (m dir names what)
  "Ask before deleting `names` under `dir` (`what` they are: `marked`, `flagged`), then do it:
to the trash when that is wanted and there is one, else for good. A delete for good counts the
files it takes first, off the loop like the delete — a large tree's walk is no quicker."
  (let (wanted? (ed-dired-trash-wanted? m)
        location (when wanted? (fileops/trash-location))
        how (cond
              location :trash
              wanted? :no-trash
              else :delete)
        ask (fn (mm entries)
              (ed-confirm mm
                (dired-delete-question entries what how)
                (fn (sure) (ed-dired-delete-now sure dir names location)))))
    (ed-dired-unless-busy m
      (fn ()
        (if location
          (ask m (map names (fn (name) (dired-delete-entry dir name false))))
          (ed-dired-launch m
            (str "counting " (dired-entries-phrase names))
            (fn () (map names (fn (name) (dired-delete-entry dir name true))))
            ask))))))

(defcommand cmd-dired-do-flagged-delete
  (m key)
  "Delete every entry flagged `D` after a y/n confirm (x, Emacs `dired-do-flagged-delete`):
to the trash, or for good when `:delete-by-moving-to-trash` is false; says so when nothing is
flagged."
  (let (dir (ed-dired-state m :dired-dir)
        flags (or (ed-dired-state m :dired-flags) '()))
    (if (empty? flags)
      (message m "(no files flagged for deletion)")
      (ed-dired-delete-asking m dir flags "flagged"))))

(defcommand cmd-dired-delete
  (m key)
  "Delete the marked entries — or the entry under point when none are marked — after a y/n
confirm (D, Emacs `dired-do-delete`): to the trash, or for good when
`:delete-by-moving-to-trash` is false."
  (let (names (ed-dired-chosen m))
    (if (empty? names)
      (message m "not on a deletable entry")
      (ed-dired-delete-asking m (ed-dired-state m :dired-dir) names "marked"))))

;; ---- dired-mode: the read-only directory browser ----------------------------
;; The dired buffer (dired/cmd-dired) lists a directory; it's stamped :dired, made
;; read-only on activate, and its single-key bindings navigate (RET/f open, ^ up, g
;; refresh, q quit) and operate (+ mkdir, R rename, C copy, d flag + x delete, D delete). Stacks over
;; text-mode so n/p/arrows move between rows. The commands rebuild the listing via
;; ed-show-named rather than editing text, so they work on the read-only buffer.

(def dired-keymap
  (-> {}
    (keymap-bind [:enter] 'dired/cmd-dired-open)
    (keymap-bind ["f"] 'dired/cmd-dired-open)
    (keymap-bind ["^"] 'dired/cmd-dired-up)
    (keymap-bind ["g"] 'dired/cmd-dired-refresh)
    ;; s toggles name / date order; C-u s edits the ls switches (Emacs)
    (keymap-bind ["s"] 'dired/cmd-dired-sort-toggle-or-edit)
    (keymap-bind ["q"] 'dired/cmd-dired-quit)
    ;; line motion snaps point onto the filename (Emacs dired n/p/C-n/C-p/arrows)
    (keymap-bind ["n"] 'dired/cmd-dired-next-line)
    (keymap-bind ["p"] 'dired/cmd-dired-previous-line)
    (keymap-bind [:ctrl-n] 'dired/cmd-dired-next-line)
    (keymap-bind [:ctrl-p] 'dired/cmd-dired-previous-line)
    (keymap-bind [:down] 'dired/cmd-dired-next-line)
    (keymap-bind [:up] 'dired/cmd-dired-previous-line)
    (keymap-bind ["+"] 'dired/cmd-dired-create-dir)
    (keymap-bind ["R"] 'dired/cmd-dired-rename)
    (keymap-bind ["C"] 'dired/cmd-dired-copy)
    ;; marking (emacs dired): m mark, u unmark, U unmark-all, t toggle; x/D delete
    ;; (the marked set, else the entry under point).
    (keymap-bind ["m"] 'dired/cmd-dired-mark)
    (keymap-bind ["u"] 'dired/cmd-dired-unmark)
    (keymap-bind ["U"] 'dired/cmd-dired-unmark-all)
    (keymap-bind ["t"] 'dired/cmd-dired-toggle-marks)
    ;; d flags for deletion, x deletes the flagged (Emacs); D deletes marked-or-current now
    (keymap-bind ["d"] 'dired/cmd-dired-flag)
    (keymap-bind ["x"] 'dired/cmd-dired-do-flagged-delete)
    (keymap-bind ["D"] 'dired/cmd-dired-delete)))

(def dired-mode-layer
  {:name 'dired
   :doc "A directory: RET/f opens, ^ up, g refresh, s sorts, d flags and x deletes."
   :keymap dired/dired-keymap
   ;; the order the listing is in, Emacs's `Dired by name` / `Dired by date`
   :modeline 'dired/dired-modeline
   :commands (modes/layer-commands dired/dired-keymap)
   :fontify 'dired/dired-fontify})

(modes/register-special-type :dired 'dired/dired-mode-layer)

;; A directory visited opens here (Emacs's find-file-run-dired).
(register-presenter :directory 'dired/ed-show-dired)
