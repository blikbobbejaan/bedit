(defmodule diffhl
  "diff-hl-style change gutter: per-line indicators (added / modified / deleted against what
the version control compares the file with — git's HEAD, mur's last save), painted as a
coloured bar in the left of the line-number gutter. The per-line status is computed by
`git diff --no-index` of the buffer's text against that base text (`vcs/base-text`, std's,
whichever VCS the file is in) and cached on
the buffer under `:vcs-line-status` (a `{0-based-line -> :added|:modified|:deleted}` map), so
the gutter cell — which sees only the buffer — can paint it without the model. The model-level
recompute (off the loop, re-armed on edit/save) is `ed-launch-diffhl`, below: an idle-beat job
this module registers when it loads (`model/register-idle-job`). The module is deferred: the
gutter paint (`modes/line-number-cell`) loads it, and until something has there are no bars to
recompute — what the `bound?` guard in the model used to say.

`vcs/base-text` / `diffhl-status-map` shell out (a subprocess each) and are
unit-tested against real git without the editor (tests/diffhl_test.blsp)."
  (:use editor/buffer) ; buffer-file / buffer-text
  (:use model) ; ed-current-buf / ed-set-buf / ed-buf-at / ed-headless? / the registries
  (:use interactive) ; defcommand — C-x v ] / [
  (:use task)) ; task — the diff runs off the loop
;; `theme` (a project source module, loaded with the image) provides the *green* /
;; *yellow* / *red* dynamic-var colour globals this file reads bare.
;; ---- faces + glyphs ---------------------------------------------------------

(theme/defchrome face-diff-added {:fg *green*})
(theme/defchrome face-diff-modified {:fg *yellow*})
(theme/defchrome face-diff-deleted {:fg *red*})

(defn bar-glyph (status)
  "The 1-char gutter bar for a line's git `status`: a solid bar for a present change, a thin
underbar where lines were deleted, a space for an unchanged line."
  (cond (= status :deleted) "▁" (nil? status) " " :else "▌"))

(defn bar-face (status)
  "The face for a line's git `status` bar, or nil for an unchanged line."
  (cond
    (= status :added) face-diff-added
    (= status :modified) face-diff-modified
    (= status :deleted) face-diff-deleted
    :else nil))

(defn bar-chunk (status)
  "The gutter change-bar CHUNK for a line's git `status`: `[:bar colour]` for a present
add/modify — the renderer lowers it to a solid full-height rule (a GUI `frect`, or `▌` in
the terminal) — a thin `▁` underbar glyph at a deletion marker, and a blank otherwise.
`colour` is the diff face's foreground hex. Replaces the old `[▌ face]` glyph chunk, which
read as a dashed TUI bar at the editor's 1.4 line-height."
  (cond
    (nil? status) [" " nil]
    (= status :deleted) ["▁" face-diff-deleted]
    :else [:bar (:fg (bar-face status))]))

;; ---- the line diff → per-line status map (native `git diff`) ----------------
;; diff-hl runs the diff through **git itself** (`git diff --no-index`), not a hand-rolled
;; Brood diff. Two reasons: git's C diff is fast on a heavily-edited file (where an
;; interpreted O(N·D) diff lags), and — crucially — git places an inserted/deleted line at
;; the *intuitive* boundary (its indent heuristic). A minimal-edit script is mathematically
;; correct but attributes a change to the *earliest* equivalent line, so adding a line inside
;; a run of similar lines (closing parens, blank lines, …) showed the bar lines above where
;; you typed. Routing through git makes the gutter match what `git diff` / the terminal show.

(defn- diffhl-strip-nl (s)
  "`s` without a single trailing newline (so head and buffer align — `git show` always ends
in one; the buffer may not, and a lone trailing-newline difference isn't a real change)."
  (if (and (> (string/length s) 0)
        (= (string/substring s (dec (string/length s)) (string/length s)) "\n"))
    (string/substring s 0 (dec (string/length s)))
    s))

(defn- diffhl-apply-hunk (acc oc ns nc)
  "Fold one `@@ -…,oc +ns,nc @@` hunk into the status `acc` (0-based buffer lines): `nc` new
lines from `ns` (1-based) are the change — the first `min(oc,nc)` are `:modified` (they
replace deleted lines), the rest `:added`. A pure deletion (`nc = 0`) marks the line that
follows it (`ns`, 0-based) `:deleted`."
  (if (= nc 0)
    (assoc acc ns :deleted)
    (let (base (dec ns) nmod (math/min oc nc))
      (fold (range nc) acc (fn (a j) (assoc a (+ base j) (if (< j nmod) :modified :added)))))))

(defn- diffhl-parse-diff (out)
  "Fold the `@@` hunk headers of a `git diff --unified=0` `out` into a
`{0-based-buffer-line -> :added|:modified|:deleted}` map (non-header lines ignored). The
header is read by std's `diff/hunk-header` — the reader every other diff in the editor
uses — rather than by a second one here."
  (fold (string/split out "\n")
    {}
    (fn (acc line)
      (let (hunk (diff/hunk-header line))
        (if hunk
          (diffhl-apply-hunk acc (:old-count hunk) (:new-start hunk) (:new-count hunk))
          acc)))))

(defn- diffhl-status-map (head buf-text)
  "A `{0-based-buffer-line -> :added|:modified|:deleted}` map for `buf-text` vs `head`, via
`git diff --no-index --unified=0` over temp files (so it also works for an unsaved buffer).
Trailing-newline-only differences are ignored (`diffhl-strip-nl`). Returns `{}` on a git
error. Plain strings in, plain map out — safe to run inside a spawned worker."
  (let (dir (string/trimr (:stdout (os/cmd "mktemp" ["-d"])))
        ht (str dir "/head")
        bt (str dir "/buf")
        ;; normalise to exactly one trailing newline on each side: strips a lone
        ;; trailing-newline difference AND gives both files proper line termination, so git
        ;; never emits a `\ No newline at end of file` that would flag the last line as changed.
        _ (file/spit ht (str (diffhl-strip-nl head) "\n"))
        _ (file/spit bt (str (diffhl-strip-nl buf-text) "\n"))
        r (os/cmd "git" ["diff" "--no-index" "--unified=0" ht bt])
        _ (os/cmd "rm" ["-rf" dir]))
    ;; --no-index exits 0 when identical, 1 when they differ; anything higher is an error.
    (if (<= (:exit r) 1) (diffhl-parse-diff (:stdout r)) {})))

;; ---- annotate a buffer ------------------------------------------------------

(defn diffhl-status (path text)
  "The `{0-based-line -> :added|:modified|:deleted}` diff map for the file at `path`
(vs its base text — git's HEAD, mur's last save) given its current `text` — an empty map
when the file is new or in no checkout. **Plain data in, plain data out**: it takes the text
as a string (not a buffer/rope), so it can run inside a spawned task that has no buffer
handle (the rope is process-local). The editor folds the result onto the buffer's `:vcs-line-status`."
  (let (head (vcs/base-text path))
    (if (nil? head) {} (diffhl-status-map head text))))

(defn diffhl-annotate (buf)
  "Return `buf` with `:vcs-line-status` set to its per-line diff vs its base text — an empty
map when the file is new or in no checkout (so the gutter shows the bar column but no
colours).
A fileless buffer is returned unchanged (no status key — never gets a diff gutter). The
synchronous wrapper over `diffhl-status`, used on the headless path; the live editor runs
`diffhl-status` off the loop (see `ed-launch-diffhl`)."
  (let (path (buffer-file buf))
    (if (nil? path)
      buf
      ;; one annotation, stamped with the text it describes (std `annotate`) — the
      ;; bars draw only while positionally current, which is what blanks them the
      ;; moment a line is inserted rather than drawing every bar one line off
      (editor/buffer/annotate buf
        :vcs-line-status (diffhl-status path (buffer-text buf))))))

;; ---- diff-hl annotation, off the loop (mirrors the diagnostics pair) ---------
;; Diffing a buffer against its base text is `std/diff` over the whole file. On a large
;; file that is seconds of work — far too slow for the per-event loop (it once wedged the
;; whole editor on a 3000-line file: the single ui-run process never returned, so no key,
;; not even C-g, could be processed). So the diff runs in a spawned task, exactly like the
;; advisory diagnostics check: launch on the idle beat, fold the result back on its reply.

(defn ed-diffhl-stale? (m)
  "True when the current buffer wants a diff-hl recompute: diff-hl is on (`:diff-hl?`,
default true), it's a file buffer, and its **rope differs from the one the cached gutter was
computed for** — its first view (no annotation at all), or any edit since. An O(1)
rope-handle compare (`annotation`'s `:stale?`), so plain motion costs nothing but a text change
re-arms the diff, so the change bars follow edits instead of freezing at their old lines until
a save (the 'bars drift the further down you scroll' symptom). No size cap — the recompute
runs OFF the loop (`ed-launch-diffhl`), so a large file no longer blocks it."
  (and (:diff-hl? m true)
    (let (b (ed-current-buf m))
      (and (buffer-file b)
        (let (a (editor/buffer/annotation b :vcs-line-status))
          (or (nil? a) (:stale? a)))))))

(defn ed-launch-diffhl (m)
  "Recompute the current buffer's diff-hl gutter when stale, OFF THE LOOP — mirroring
`ed-launch-diag`. Reading the base text + `git diff` is tens of ms on a normal file but scales
with the file size (~45ms on an 848KB / 12k-line doc, seconds on a huge one) — too much for the
per-event loop, which once wedged the whole editor on a large file — so it runs in a spawned
task (std/task): record the task handle on `:diffhl-proc` and the rope it is diffing on
`:diffhl-checking`, so a stale reply can't clobber a newer cache. Fires on the idle beat, gated
on an in-flight check. Headless (no `:editor`) → synchronous fallback.

(An earlier async version was blamed for a frozen gutter but later exonerated — the real bug
was the idle beat suppressed by a stuck `:held-key`, cac0ce3; the task-reply contract is pinned
by tests/diffhl_async_test.blsp's last describe. Async is restored here because sync scales
with file size and blocks the loop — the very failure the user hit on a 12k-line file.)"
  (cond
    (not (ed-diffhl-stale? m)) m
    (:diffhl-proc m) m
    (ed-headless?) (ed-set-buf m (diffhl-annotate (ed-current-buf m)))
    :else
      (let (b (ed-current-buf m)
            path (buffer-file b))
        (if (nil? path)
          m ; `ed-diffhl-stale?` already said it is a file buffer; this says so to the checker
          (let (text (buffer-text b)
                job (task (fn () (diffhl-status path text))))
            (assoc m :diffhl-proc job :diffhl-checking (buffer-rope b)))))))

(sig ed-apply-diffhl (model any -> model))
(defn ed-apply-diffhl (m result)
  "Fold a finished diff-hl compute's `result` (the `{0-based-line -> status}` map; nil/() on
error/timeout) into the buffer it was diffed for — located by the rope it carried
(`:diffhl-checking`), so a buffer switch mid-flight still stamps the RIGHT buffer — with the
rope + line count, and clear the in-flight handle. A buffer edited since the launch has no
matching rope, so its stale result is dropped and `ed-diffhl-stale?` re-fires next idle tick.
Mirrors `ed-apply-diag`."
  (let (rope (:diffhl-checking m)
        m1 (dissoc m :diffhl-proc :diffhl-checking)
        idx (seq/index-where (:buffers m1) (fn (b) (= (buffer-rope b) rope))))
    (if (< idx 0)
      m1
      ;; stamp the result onto the buffer we diffed (found BY ROPE, so a mid-flight
      ;; buffer switch still lands on the right one)
      (update m1
        :buffers assoc
        idx
        (editor/buffer/annotate (ed-buf-at m1 idx) :vcs-line-status (or result {}))))))

(defn ed-quit-diffhl (m)
  "C-g killed a diff-hl recompute (`:on-quit`): forget the rope it was diffing, and re-stamp
the current buffer's bars against its CURRENT text, so the idle beat treats the gutter as
current and does not relaunch the diff just killed (keeping any existing bars; none if there
were none). It re-arms on the next edit, because that is what makes the annotation stale
again."
  (let (b (ed-current-buf m))
    ;; `:value`, NOT `annotation-value`: the current-only accessor returns nil exactly when
    ;; a line was inserted (which is why a diff was in flight), so it would DISCARD the bars
    ;; this exists to keep.
    (dissoc (ed-set-buf m
              (editor/buffer/annotate b
                :vcs-line-status (or (:value (editor/buffer/annotation b :vcs-line-status)) {})))
      :diffhl-checking)))

;; ---- registration ---------------------------------------------------------------

(register-task-reply :diffhl-proc
  'diffhl/ed-apply-diffhl
  '()
  nil
  {:cancel-on-quit? true :on-quit 'diffhl/ed-quit-diffhl})

;; NOT held-key-gated, and also run on the blink tick: a missed key-up can leave `:held-key`
;; stuck, which would otherwise suppress the idle beat and freeze the gutter — the blink
;; tick fires whenever the editor is idle, so it keeps the bars current regardless
(register-idle-job :diffhl
  {:order 80 :run 'diffhl/ed-launch-diffhl :stale? 'diffhl/ed-diffhl-stale? :on-blink? true})

;; ---- moving between the changes (diff-hl's C-x v [ / ]) ------------------------------
;; The bars already say where the changes are, whichever VCS made them, so walking them needs
;; no VCS at all: a hunk starts where a marked line follows an unmarked one (or one of another
;; kind — an addition right after a modification is its own change).

(defn diffhl-hunk-starts (status -> (list int))
  "The 0-based lines where a change starts in a `{line -> :added|:modified|:deleted}` status
map, ascending. Pure.

    (diffhl/diffhl-hunk-starts {2 :added 3 :added 7 :modified 9 :deleted})   → (2 7 9)"
  (let (lines (sort (keys (or status {}))))
    (seq/filter lines (fn (l) (not (= (get status (dec l)) (get status l)))))))

(defn- diffhl-jump (m forward?)
  "Point to the next (or previous) change's first line in the current buffer, or say there
is none that way."
  (let (b (ed-current-buf m)
        status (editor/buffer/annotation-value b :vcs-line-status)
        here (buffer-current-line b)
        starts (diffhl-hunk-starts status)
        target (if forward?
                 (seq/find starts (fn (l) (> l here)))
                 (last (seq/filter starts (fn (l) (< l here))))))
    (cond
      (nil? status)
        (message m
          "no change marks here yet (a file the version control does not track, or not yet read)")
      (nil? target) (message m (if forward? "no more changes below" "no more changes above"))
      :else (ed-set-buf m (pool/ed-goto-line b (inc target))))))

(defcommand cmd-diffhl-next-hunk
  (m key)
  "Go to the next change in this file (C-x v ]) — the next bar in the gutter, whichever
version control drew it."
  (diffhl-jump m true))

(defcommand cmd-diffhl-previous-hunk
  (m key)
  "Go to the previous change in this file (C-x v [)."
  (diffhl-jump m false))
