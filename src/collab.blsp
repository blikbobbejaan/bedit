(defmodule collab
  "The PRESENCE layer over hosted buffers — collaboration is `hosted` plus people.

Content is not this module's job any more: every process-backed pool slot — shared or
purely local — rides the `hosted` machinery (`src/hosted.blsp` over std
`editor/buffer-client`): based-splice propagation at the loop tail, echo suppression,
exact concurrent merges, resync, crash rehosting. A SHARED buffer is simply a hosted
slot whose process has remote subscribers — `collab-share-slot` = `ed-host-slot` + a
presence announce + the slot's `:collab?` flag (`collab-shared?`), and
`ed-apply-buffer-update` = `hosted-apply-content` + the presence fold.

What lives here is everything about WHO: per-participant cursor/selection/viewport
markers keyed by the session pid (edit-adjusted inside the buffer process; cleaned up
by it when you die), the `:participants` name registry and its quiet tags
(`:tag-ttl`), join/leave echoes, `share-follow`/`share-mirror`, presence migration on
buffer switch (`collab-sync-point`), and the per-daemon FILE REGISTRY that auto-shares
every file anyone visits (`collab-autoshare`) — respawning died buffer processes from a
text mirror (std `editor/buffer-registry` started `{:mirror true}`), with subscribers resharing onto the
respawn (`collab-reshare`). Deferred to v2: a real sequence CRDT for
offline/high-latency divergence (`docs/remote-multiplayer-plan.md`, Open)."
  (:use editor/buffer) ; spawn/subscribe/buffer-edit/replace-region/make-buffer …
  (:use editor/buffer-client) ; view-parts — the protocol's push normalizer (ADR-134)
  (:use editor/buffer-registry) ; registry-share — the daemon's file -> process directory
  (:use hosted) ; ed-host-slot / ed-unhost-slot / hosted-apply-content —
  ; the content machinery (collab = its presence layer)
  (:use scroll) ; ed-scroll / ed-max-top / ed-wrap? — keeping point on screen
  (:use model)) ; ed-init / ed-current-buf / ed-set-buf / ed-buf-at / ed-stamp …
;; ---- the model <-> shared-process link --------------------------------------
;; A slot's `:hosted` record IS a buffer-client *link* (`{:proc :me :version :pending}`)
;; plus the presence keys this module layers on (`:cursors :marks :tops :names :tag-ttl`,
;; `:sent-*`): the content protocol — splice propagate, echo suppression, transform-fold,
;; resync — is `std/editor/buffer-client`; everything presence is here.

(defn collab-shared? (m &optional i)
  "Whether pool slot `i` (default the current buffer's) is SHARED — hosted with the
presence layer engaged (`collab-share-slot` sets the slot's `:collab?` flag). A merely
hosted local buffer (`ed-host-slot`, no participants) is NOT shared: presence markers,
name announces, and follow never touch it."
  (let (idx (or i (ed-current-index m)))
    (not (nil? (map/get-in m [:hosted idx :collab?])))))

;; ---- presence: who's on the buffer, and where --------------------------------
;; Each participant plants a MARKER keyed by its session pid in the shared buffer
;; process — markers are adjusted inside the process's edit primitives, so a cursor
;; stays on its logical spot while others type around it — and registers its display
;; name under `:participants` on the shared buffer value. The subscription projection
;; (`hosted-proj`) carries text + markers + names in every push, so every client
;; always knows where everyone is; the buffer process deletes a dead subscriber's
;; pid-keyed marker (std/editor/buffer), so a crashed/detached participant's caret
;; vanishes instead of ghosting.

(defn collab-share-slot (m i proc)
  "Back pool slot `i` with buffer process `proc` (`ed-host-slot` — the hosted content
machinery) and announce ourselves on it — a cursor marker keyed by our pid (so the
process cleans it up if we die) and our name (`:participant`, else \"guest\", upgraded
later by `collab-set-name` when the attach identity arrives). Sharing = hosting + a
presence announce. Returns the model."
  (let (me (self)
        name (or (:participant m) "guest"))
    (do
      (buffer-edit proc
        me
        (fn (b)
          (assoc (buffer-marker-set b me 0)
            :participants (assoc (:participants b {}) me name))))
      (map/assoc-in (ed-host-slot m i proc) [:hosted i :collab?] true))))

(defn collab-set-name (m name)
  "Record this session's participant `name` (the attach identity — `bedit --attach ed
--as alice`, delivered as a `[:client-opts …]` event) and announce it on every shared
slot's process, so other participants' name tags and join/leave echoes show the real
name instead of \"guest\". A no-op for a nil/empty name."
  (if (or (nil? name) (= name ""))
    m
    (do
      (doseq (kv (%map-pairs (or (:hosted m) {})))
        (let (sh (second kv)
              proc (:proc sh)
              me (:me sh))
          (when (and me (:collab? sh))
            ; announce on SHARED slots only
            (buffer-edit proc
              me
              (fn (b)
                (assoc b
                  :participants (assoc (:participants b {}) me name)))))))
      (assoc m :participant name))))

(defn- collab-withdraw-presence (m j)
  "Remove our presence markers (cursor, selection anchor, viewport top) from slot
`j`'s process — we moved to another buffer, and presence lives only where you ARE
(that's also how `share-follow` finds you: your cursor marker exists in exactly one
buffer). The subscription stays (content keeps tracking); the sent-* stamps reset so
re-entering the buffer re-announces."
  (let (sh (map/get-in m [:hosted j])
        me (:me sh))
    (if (or (nil? sh) (nil? me))
      m
      (do
        (buffer-edit (:proc sh)
          me
          (fn (b)
            (buffer-marker-delete (buffer-marker-delete (buffer-marker-delete b me) [me :mark])
              [me :top])))
        (assoc m
          :hosted
            (assoc (:hosted m)
              j (merge sh {:sent-point nil :sent-mark nil :sent-top nil})))))))

(defn- collab-sync-marker (m i sent-key marker value)
  "Bring our presence `marker` on slot `i`'s process to `value` when it differs from what
we last sent (`sent-key` on the slot): a nil `value` deletes the marker, any other moves
it — a structured delta, no text on the wire. Returns the model with the new stamp."
  (let (link (map/get-in m [:hosted i])
        me (:me link))
    (cond
      (= value (get link sent-key)) m
      (nil? value)
        (do
          (buffer-edit (:proc link) me (fn (b) (buffer-marker-delete b marker)))
          (map/assoc-in m [:hosted i sent-key] nil))
      :else
        (do
          (buffer-marker-move (:proc link) marker value me)
          (map/assoc-in m [:hosted i sent-key] value)))))

(defn- collab-migrate-presence (m i)
  "Note `i` as the slot we are active on, withdrawing presence from the previous one
only when ARRIVING at another shared slot (a real migration). Glancing at *Messages* /
*git-status* keeps your caret parked at its last shared spot — followers stay put
instead of being dropped, and the other side isn't spammed with left/joined echoes for
every status peek."
  (let (previous (:collab-active m))
    (assoc (if (and previous (not (= previous i)) (collab-shared? m previous) (collab-shared? m i))
             (collab-withdraw-presence m previous)
             m)
      :collab-active i)))

(defn- collab-top-offset (m)
  "The current window's top line as a char offset — what our `[me :top]` viewport marker
carries, edit-adjusted like any marker."
  (let (buffer (ed-current-buf m)
        top-line (math/min (ed-current-top m) (dec (buffer-line-count buffer))))
    (text/line->char (buffer-rope buffer) (math/max 0 top-line))))

(defn collab-sync-point (m)
  "After an event folds: keep this participant's presence honest on the buffer they're
IN — the cursor marker when point moved, the `[me :mark]` selection anchor while a
region is active (deleted when it drops), and the `[me :top]` viewport marker (the
top line's char offset — edit-adjusted like any marker) when the view scrolled, which
is what a `share-mirror` reproduces. Switching buffers first withdraws presence from
the buffer left behind (`collab-migrate-presence`). Marker moves are structured
deltas — no text on the wire. A no-op on unshared buffers and unmoved state, so the
every-event path pays nothing."
  (let (i (ed-current-index m)
        moved (collab-migrate-presence m i)
        me (map/get-in moved [:hosted i :me]))
    ;; presence lives on SHARED slots only — a merely hosted local buffer gets no
    ;; cursor markers
    (if (or (not (collab-shared? moved i)) (nil? me))
      moved
      (let (buffer (ed-current-buf moved))
        (-> moved
          (collab-sync-marker i :sent-point me (buffer-point buffer))
          (collab-sync-marker i :sent-mark [me :mark] (buffer-mark buffer))
          (collab-sync-marker i :sent-top [me :top] (collab-top-offset moved)))))))

;; ---- the shared-buffer registry: every file, one process ---------------------
;; One registry per collab daemon (`:collab-reg`, std `editor/buffer-registry` started
;; `{:mirror true}`): the first session to open a file spawns its buffer process;
;; everyone after gets the same pid. So EVERY file buffer anyone visits is
;; collaborative — not just the file the daemon was launched on — which is what lets
;; `share-follow` track a participant across buffers. The MIRROR is what lets it
;; respawn a died process from current content rather than dropping it: the shared
;; document outlives both its process and any one session's copy.

(defn collab-registry-share (reg buf)
  "The ONE buffer process for file buffer `buf` — spawned from its text on the first
ask; later askers get the existing process (their local copy then syncs from its seed
push). Synchronous; nil if the registry doesn't answer within 2s (the host went away)."
  (let (bp (registry-share reg (buffer-name buf) (buffer-text buf) {:file (buffer-file buf)}))
    (if (pid? bp) bp nil)))

(defn collab-autoshare (m)
  "Share the CURRENT buffer the moment it's visited: when this session belongs to a
collab daemon (`:collab-reg`), the buffer is a file buffer, and its slot isn't
SHARED yet, ask the registry for the file's one process and link the slot. A slot
that is merely hosted LOCALLY (the every-buffer flip) is re-linked: its local
process is stopped and the registry's takes over — the registry's seed push then
syncs the slot. The `ed-update-collab` loop hook that makes every open file
collaborative; ordinary editors (no `:collab-reg`) never do anything here."
  (let (reg (:collab-reg m)
        i (ed-current-index m)
        buf (ed-current-buf m))
    (if (or (nil? reg) (collab-shared? m i) (nil? (buffer-file buf)))
      m
      (let (bp (collab-registry-share reg buf))
        (if (nil? bp)
          ;; the registry didn't answer (host gone?) — disable sharing for this
          ;; session rather than stalling 2s on every subsequent file visit
          (message (dissoc m :collab-reg)
            "shared-session registry unreachable — sharing disabled for this session")
          ;; stop the old process only if it was this editor's own: a registry slot's
          ;; process is another frame's buffer too, and stays theirs
          (collab-share-slot (ed-unhost-slot m i (not (map/get-in m [:hosted i :registry?]))) i bp))))))

(defn collab-reshare (m i)
  "A SHARED slot's buffer process died: ask the registry for the file's process
again — the registry respawns a died buffer from its text mirror, so the fresh pid
is already carrying the document; the seed push re-syncs our slot. Without a
reachable registry (the host is gone) fall back to hosting LOCALLY from the pool
cache, so editing never stops — the graceful end of a collab session."
  (let (reg (:collab-reg m)
        buf (ed-buf-at m i)
        m1 (assoc m :hosted (dissoc (:hosted m) i))
        bp (if (and reg (buffer-file buf))
             (collab-registry-share reg buf)
             nil))
    (if (nil? bp)
      (message (ed-host-slot m1 i)
        (str "shared host for " (buffer-name buf) " lost — now editing locally"))
      (message (collab-share-slot m1 i bp) (str "reshared " (buffer-name buf))))))

;; ---- follow: ride another participant's caret (the pairing mode) -------------
;; `collab-follow` pins your point (and view) to another participant's cursor: every
;; push that moves their marker moves you too — the old one-cursor `--shared`
;; experience, but opt-in, per-person, and reversible. Any point-moving input of your
;; OWN breaks it (you took the wheel); the followed participant leaving breaks it too.

(defn collab-participants (m)
  "Every OTHER participant across ALL shared slots: `{pid name}` (a participant's
cursor marker lives in exactly the buffer they're in, so the union over slots is
everyone present anywhere). Named from the registries (\"guest\" when unnamed)."
  (fold (%map-pairs (or (:hosted m) {}))
    {}
    (fn (acc skv)
      (let (sh (second skv)
            names (or (:names sh) {}))
        (fold (%map-pairs (or (:cursors sh) {}))
          acc
          (fn (a kv) (assoc a (first kv) (get names (first kv) "guest"))))))))

(defn- collab-slot-of (m pid)
  "The pool index of the slot whose `:cursors` contains `pid` — the buffer that
participant is IN — or nil when they're nowhere (gone, or on an unshared buffer)."
  (let (hit (seq/find (%map-pairs (or (:hosted m) {}))
              (fn (kv) (contains? (or (:cursors (second kv)) {}) pid))))
    (if hit (first hit) nil)))

(defn collab-follow (m pid name &optional (mode :follow))
  "Start following participant `pid`/`name`: point (and buffer — the jump switches
slots with them) ride their caret from the next push on. `mode` `:mirror` also
reproduces their VIEWPORT (scroll top), so your window shows what theirs shows —
the `share-mirror` experience."
  (message (assoc m :follow {:pid pid :name name :mode mode})
    (str (if (= mode :mirror) "mirroring " "following ")
      name " — any move of your own stops")))

(defn collab-unfollow (m &optional reason)
  "Stop following (a no-op when not). `reason` overrides the default echo."
  (if (nil? (:follow m))
    m
    (message (dissoc m :follow)
      (or reason (str "stopped following " (map/get-in m [:follow :name]))))))

(defn collab-follow-jump (m textrows)
  "While following: put point on the followed participant's cursor — SWITCHING to
their buffer first when they moved to another shared slot — and keep it on screen.
In `:mirror` mode also adopt their viewport top (their `[pid :top]` marker), so the
window scrolls exactly as theirs does. Called from the `:buffer-updated` handler,
where the viewport height is known. A no-op when not following or their cursor is
nowhere to be seen."
  (let (f (:follow m))
    (if (or (nil? f)
          ;; mid-minibuffer, stay put: yanking the buffer out from under an open
          ;; prompt is disorienting — the jump resumes on the next push after it closes
          (not (nil? (:minibuffer m))))
      m
      (let (pid (:pid f)
            j (collab-slot-of m pid))
        (if (nil? j)
          m
          (let (m1 (if (= j (ed-current-index m)) m (ed-show-index m j))
                pos (map/get-in m1 [:hosted j :cursors pid])
                m2 (if (= pos (buffer-point (ed-current-buf m1)))
                     m1
                     (ed-scroll (ed-set-buf m1 (goto-char (ed-current-buf m1) pos)) textrows)))
            (if (not (= (:mode f) :mirror))
              m2
              (let (top-off (map/get-in m2 [:hosted j :tops pid]))
                (if (nil? top-off)
                  m2
                  (ed-set-top m2
                    (text/char->line (buffer-rope (ed-current-buf m2))
                      (math/min top-off (buffer-length (ed-current-buf m2))))))))))))))

(defn collab-step (before after input)
  "The per-event PRESENCE chain: auto-share a newly visited file (`collab-autoshare` —
a registry daemon's clients see every file anyone opens), break a follow the user
steered out of (`collab-follow-step`), and sync our presence markers
(`collab-sync-point`). Content propagation is NOT here any more — `hosted-step` (the
hosted machinery) runs it for every process-backed slot, shared or purely local; the
loop tail chains the two. Runs at the tail of EVERY `ed-update` — a no-op costing two
map lookups on a model with neither a registry nor hosted slots, so ordinary editing
pays nothing; this is what lets a live editor start sharing mid-session
(`share-session`) without swapping its update function."
  (if (and (nil? (:collab-reg after)) (nil? (:hosted after)))
    after
    (collab-sync-point (collab-follow-step before
                         (if (and (vector? input) (= (first input) :buffer-updated))
                           after
                           (collab-autoshare after))
                         input))))

(defn collab-tags-live? (m)
  "Whether any participant's name tag is still showing (a slot with a non-empty
`:tag-ttl`). Under the every-buffer flip `:hosted` is non-nil on every live model, so
this is the cheap scan that keeps the tag beat off an editor nobody shares with."
  (and (not (nil? (:hosted m)))
    (any? (%map-pairs (:hosted m)) (fn (kv) (not (empty? (or (:tag-ttl (second kv)) {})))))))

(defn collab-tag-timer (m)
  "The name-tag fade's timer while a tag is showing, else nil: the blink's period, so a tag
fades over the few beats it always did. Its own timer, since the caret blink is the window's
now (brood ADR-469) and runs no turn of the loop, and a collaborator's tag
must still fade while you sit and watch them type (`model/register-timer-client`)."
  (when (collab-tags-live? m) {:every *blink-ms*}))

(defn collab-decay-tags (m)
  "Tick every participant name-tag's time-to-live down one (the `:collab-tags` beat,
[[collab-tag-timer]]): a tag shows for a few beats after that caret MOVED, then fades to
just the coloured bar — presence without shouting."
  (if (not (collab-tags-live? m))
    m
    (assoc m
      :hosted
        (fold (%map-pairs (:hosted m))
          {}
          (fn (acc kv)
            (let (sh (second kv)
                  ttl (or (:tag-ttl sh) {}))
              (assoc acc
                (first kv)
                  (if (empty? ttl)
                    sh
                    (assoc sh
                      :tag-ttl
                        (fold (%map-pairs ttl)
                          {}
                          (fn (a t)
                            (if (> (second t) 1) (assoc a (first t) (dec (second t))) a))))))))))))

(register-timer-client :collab-tags 'collab/collab-tag-timer 'collab/collab-decay-tags)

(defn collab-follow-step (before after input)
  "Break the follow when the USER moved point — a real key/mouse (`ed-real-input?`)
that changed it means they took the wheel. Movement caused by pushes / the follow jump
/ timers never breaks it. The `ed-update-collab` loop hook."
  (if (and (:follow after)
        (ed-real-input? input)
        (not (= (buffer-point (ed-current-buf before)) (buffer-point (ed-current-buf after)))))
    (collab-unfollow after)
    after))

(defn- collab-presence-echo (m old-cursors cursors names)
  "Echo presence churn between two pushes: a participant key newly in `cursors`
announces \"NAME joined\", one gone announces \"NAME left\" (its name survives in the
`:participants` registry, so leavers are named too). One message per push — churn
beyond that is vanishingly rare. Unchanged sets echo nothing."
  (let (joined (seq/filter (keys cursors) (fn (k) (not (contains? old-cursors k))))
        left (seq/filter (keys old-cursors) (fn (k) (not (contains? cursors k)))))
    (cond
      (not (empty? joined)) (message m (str (get names (first joined) "guest") " joined"))
      (not (empty? left)) (message m (str (get names (first left) "guest") " left"))
      :else m)))

(defn- collab-partition-presence (raw me)
  "Split a view's raw presence map into `{:cursors :marks :tops}`, each keyed by pid and
each for the OTHER participants only (never `me`): a plain pid key is a cursor, a
`[pid :mark]` key a mark anchor and a `[pid :top]` key a viewport top."
  (fold (%map-pairs raw)
    {:cursors {} :marks {} :tops {}}
    (fn (acc kv)
      (let ([k v] kv
            owner (if (vector? k) (first k) k))
        (cond
          (= owner me) acc
          (not (vector? k)) (update acc :cursors assoc k v)
          (= (nth k 1 nil) :mark) (update acc :marks assoc owner v)
          (= (nth k 1 nil) :top) (update acc :tops assoc owner v)
          :else acc)))))

(defn- collab-rearm-tags (ttl old-cursors cursors)
  "Re-arm the name tag of every participant whose caret appeared or moved since
`old-cursors`, for a few blink beats (`collab-decay-tags` ticks them down) — quiet
presence."
  (fold (%map-pairs cursors)
    ttl
    (fn (acc kv)
      (if (= (get old-cursors (first kv)) (second kv)) acc (assoc acc (first kv) 6)))))

(defn- collab-fold-presence (m i link view)
  "Land a push's PRESENCE on slot `i`: other participants' cursors/marks/viewports (own
pid excluded), re-armed name tags, and the churn echo — suppressed on the seed, since
finding people already here isn't news the same way. `link` is the slot as it was
BEFORE the push folded: its cursors, names and version are what changed from."
  (let (parts (view-parts view)
        names (:names parts)
        {:keys [cursors marks tops]} (collab-partition-presence (:cursors parts) (:me link))
        old-cursors (or (:cursors link) {})
        seed? (= (or (:version link) -1) -1)
        echoed (if seed?
                 m
                 (collab-presence-echo m old-cursors cursors (merge (or (:names link) {}) names))))
    (map/assoc-in echoed
      [:hosted i]
      (merge (map/get-in echoed [:hosted i])
        {:cursors cursors
         :marks marks
         :tops tops
         :tag-ttl (collab-rearm-tags (or (:tag-ttl link) {}) old-cursors cursors)
         :names names}))))

(defn- collab-follow-vanished (m old-cursors)
  "Break the follow when the one we follow vanished from EVERY shared buffer — they're
gone (a buffer switch just moves their marker to another slot, which keeps it). Only
asked of a participant `old-cursors` showed on the slot that was just updated."
  (let (followed (:follow m))
    (if (and followed
          (contains? old-cursors (:pid followed))
          (nil? (collab-slot-of m (:pid followed))))
      (collab-unfollow m (str (:name followed) " left — stopped following"))
      m)))

(defn ed-apply-buffer-update (m proc version view &optional origin)
  "Fold a `[:buffer-updated proc version view origin]` push into the model: the
CONTENT (stale drop, echo suppression, foreign-splice transform over our in-flight
edits, ambiguous-collision resync, full-text rebuild) is `hosted-apply-content` — the
hosted machinery every process-backed buffer shares — and the PRESENCE layer (this
module's own, `collab-fold-presence`) folds around it: other participants'
cursors/marks/viewports land on the slot, name tags re-arm on movement (`:tag-ttl`,
decayed by `collab-decay-tags`), churn is echoed (`collab-presence-echo`), and a
followed participant vanishing from every shared slot breaks the follow.

Every pane's window-local point is untouched — it lives on the pane, not the buffer —
so cursors stay independent and simply clamp into the new text on render. Ignores a
stale/duplicate `version`; a no-op when no slot links to `proc`."
  (let (i (hosted-slot-for-proc m proc))
    (if (nil? i)
      m
      (let (link (map/get-in m [:hosted i])
            [content status] (hosted-apply-content m i version view origin))
        (if (= status :stale)
          m
          (collab-follow-vanished (collab-fold-presence content i link view)
            (or (:cursors link) {})))))))

(defn collab-unshare (m i)
  "Drop the shared link on pool slot `i`: withdraw our presence (delete our cursor marker
and name — the graceful counterpart of the buffer process's dead-subscriber cleanup) and
unhost the slot (`ed-unhost-slot` — its content stops tracking; the local copy is kept as
an ordinary buffer; the process is NOT stopped — a shared host outlives its subscribers).
A no-op when the slot isn't shared."
  (let (sh (map/get-in m [:hosted i])
        proc (:proc sh)
        me (:me sh))
    (if (nil? proc)
      m
      (do
        (when me
          (buffer-edit proc
            me
            (fn (b)
              (assoc (buffer-marker-delete b me)
                :participants (dissoc (:participants b {}) me)))))
        (ed-unhost-slot m i)))))

;; ---- the mode-line chip ------------------------------------------------------

(defn- presence-label (m pane)
  "The modeline presence chip for a SHARED buffer: who else is here, by name, plus the
follow target while following ('shared: alice, bob → alice'). \"\" on an unshared
buffer, so the segment is dropped — gated on the slot's `:collab?` flag, NOT mere
hostedness: under the every-buffer flip every live slot is process-backed, but only
collab-shared ones have presence. A registry-hosted slot (`:registry?` — a buffer shared
with another FRAME of this editor) is not a collaboration: no chip."
  (let (bi (map/get-in pane [:payload :buffer])
        sh (map/get-in m [:hosted bi]))
    (if (nil? (:collab? sh))
      ""
      (let (names (or (:names sh) {})
            cursors (or (:cursors sh) {})
            who (map (%map-pairs cursors) (fn (kv) (get names (first kv) "guest")))
            f (:follow m))
        (str "  —  shared: "
          (if (empty? who) "just you" (string/join who ", "))
          (if f (str " → " (:name f)) ""))))))

(defn presence-segment (m pane buf)
  "The presence chip on the selected pane's bar (the label bakes its own separator)."
  (statusbar/seg :presence (presence-label m pane)))

(statusbar/register-modeline-segment :presence 40 'collab/presence-segment)
