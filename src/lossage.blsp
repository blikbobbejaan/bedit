(defmodule lossage
  "Lossage (Emacs's recent-keys, C-h l): the last keys that reached the dispatcher, kept on the
model in a bounded ring."
  (:use log :exclude [error]))

(def *lossage-max* 100)

(def *lossage-slack* 32)

(sig lossage-record (model/model any -> model/model))

(defn lossage-record (m key)
  "`m` with `key` appended to the lossage ring. Called by the dispatcher for every key that
reaches it — including the ones no keymap binds, because \"nothing happened\" is exactly
what you press C-h l to explain.

On the hot path, so it does the least it can: `conj` onto a vector, and a trim only when
the ring has run `*lossage-slack*` past the cap. Measured at 0.013 ms a keystroke against
a 0.231 ms dispatch."
  (let (ring (or (:lossage m) [])
        grown (conj ring key))
    (assoc m
      :lossage
      ;; `into []` is load-bearing: `seq/take-last` answers a LIST, and `conj` inserts at
      ;; each kind's natural point — the head of a list. Left as one, the ring silently
      ;; reversed itself the moment it first overflowed, and `C-h l` showed the hundred
      ;; keys before the last hundred, newest last. It stays a vector so `conj` appends.
        (if (> (count grown) (+ *lossage-max* *lossage-slack*))
          (into [] (seq/take-last grown *lossage-max*))
          grown))))

(defn lossage-keys (m)
  "The last `*lossage-max*` keys, oldest first — the ring as `C-h l` shows it, with the
slack `lossage-record` leaves for amortisation trimmed off here instead."
  (let (ring (or (:lossage m) []))
    (if (> (count ring) *lossage-max*) (into [] (seq/take-last ring *lossage-max*)) ring)))
