(defmodule searchedit
  "Editable search results (Emacs's wgrep): `C-c C-p` in *Project Search* makes the text of
every `file:line:text` row editable — the `file:line:` stays read-only (`editor/buffer`'s
`narrow-to`, so no edit path can touch it) — and `C-c C-c` writes each changed row back to
its line in its file, `C-c C-k` puts the rows back. The files are edited in their buffers, left
modified for C-x s, as wgrep leaves them; a line that changed on its own since the search is
skipped and said, never overwritten. A project-wide replace is a search, `C-c C-p`, `M-%` over
the rows (query-replace keeps to what may be edited) and `C-c C-c`;
`M-x project-query-replace-regexp` is those steps in one."
  (:use editor/buffer) ; the rope, narrowing, replace-region
  (:use interactive) ; defcommand
  (:use model) ; ed-current-buf / ed-apply / message / ed-ding
  (:use editor/keymap :only [keymap-bind]) ; the edit mode's keys
  (:use modes :only []) ; register-type runs at load, after modes declares its kinds
  (:use pool :only [ed-find-file ed-return-to ed-project-root])) ; the files edited, and back; the project

;; ---- the rows ------------------------------------------------------------------

(defn- row-of (rope line root)
  ;; `{:line :file :file-line :start :end :text}` for a `file:line:text` row at buffer line
  ;; `line` — `:start`/`:end` the span of its text — or nil for any other line
  (let (start (text/line->char rope line)
        text (wrap/rope-line-text rope line)
        found (regex/find "^([^:\\n]+):([0-9]+):" text))
    (when found
      (let ([file-group line-group] (vec (:groups found))
            prefix (string/length (:text found)))
        {:line line
         :file (path/join root (:text file-group))
         :file-line (dec (reflect/read-string (:text line-group)))
         :start (+ start prefix)
         :end (+ start (string/length text))
         :text (string/substring text prefix (string/length text))}))))

(defn- search-rows (buffer)
  "Every result row of a *Project Search* `buffer`, top to bottom. The header lines (the mode
line, the search, the command) come first and match no row."
  (let (rope (buffer-rope buffer)
        root (or (:dir buffer) "."))
    (seq/keep (range 0 (text/line-count rope)) (fn (line) (row-of rope line root)))))

(defn- editing? (buffer) (not (nil? (:search-edit buffer))))

;; ---- C-c C-p: the rows become editable ------------------------------------------

(defcommand cmd-search-edit
  (m key)
  "Make *Project Search*'s rows editable (C-c C-p, wgrep's key): the text after each
`file:line:` may be changed, nothing else. C-c C-c writes the changes to the files, C-c C-k
puts the rows back."
  (let (buffer (ed-current-buf m)
        rows (into [] (search-rows buffer)))
    (cond
      (editing? buffer) (message m "already editing — C-c C-c writes, C-c C-k puts back")
      (empty? rows) (ed-ding (message m "no result rows to edit"))
      else
        (message (ed-set-buf m
                   (-> buffer
                     (narrow-to (map rows (fn (row) [(:start row) (:end row)])))
                     (assoc :search-edit rows)
                     (editor/layers/set-buffer-type :project-search-edit)
                     (editor/layers/init-buffer-layers)))
          "Editing the results — C-c C-c writes them to the files, C-c C-k puts them back"))))

;; ---- C-c C-c: the changes go to the files -----------------------------------------

(defn- edited-rows (buffer)
  "`[row new-text]` for every row whose text was changed, read from the editable regions, which
moved with the edits — one region a row, in row order."
  (let (rope (buffer-rope buffer)
        regions (editable-regions buffer))
    (seq/keep (range 0 (count (:search-edit buffer)))
      (fn (index)
        (let (row (nth (:search-edit buffer) index)
              [from to] (nth regions index)
              now (text/slice rope from to))
          (when (not (= now (:text row))) [row now]))))))

(defn- apply-row (outcome [row new-text])
  ;; `[buffer written skipped]`: the row's line in its file `buffer` replaced by `new-text` when
  ;; it still reads what the search found, else counted as skipped. A file's rows are ONE undo
  ;; step: each replacement after the first amalgamates into it
  (let ([buffer written skipped] outcome
        rope (buffer-rope buffer)
        line (:file-line row))
    (if (and (< line (text/line-count rope)) (= (wrap/rope-line-text rope line) (:text row)))
      (let (start (text/line->char rope line))
        [(replace-region (if (> written 0) (amalgamate-undo buffer) buffer)
           start
           (+ start (string/length (:text row)))
           new-text)
          (inc written)
          skipped])
      [buffer written (inc skipped)])))

(defn- write-file-rows (outcome [path changes])
  ;; `[model written skipped]` with `changes` (`[row new-text]`s of one file) applied to its
  ;; buffer, opened (or switched to) for it
  (let ([m written skipped] outcome
        opened (ed-find-file m path)
        [edited file-written file-skipped] (fold changes [(ed-current-buf opened) 0 0] apply-row))
    [(if (> file-written 0) (ed-edit opened (fn (_) edited)) opened)
      (+ written file-written)
      (+ skipped file-skipped)]))

(defn- finish-editing (m buffer-name)
  ;; *Project Search* read-only again, its rows as they now read
  (let (index (ed-buffer-index-by-name m buffer-name))
    (if (nil? index)
      m
      (ed-set-buf-at m
        index
        (-> (ed-buf-at m index)
          (dissoc :search-edit)
          (set-read-only true)
          (editor/layers/set-buffer-type :project-search)
          (editor/layers/init-buffer-layers))))))

(defcommand cmd-search-edit-commit
  (m key)
  "Write the edited rows to their files (C-c C-c): each changed row replaces its line in its
file's buffer, left modified for C-x s. A line that no longer reads what the search found
(changed since) is skipped, and said."
  (let (buffer (ed-current-buf m)
        changes (edited-rows buffer)
        rows-text (seq/find (map changes second) (fn (text) (includes? text "\n"))))
    (cond
      (not (editing? buffer)) (message m "not editing the results — C-c C-p starts")
      rows-text (ed-ding (message m "a row may not hold a line break — C-c C-k puts the rows back"))
      else
        (let (by-file (seq/group-by changes (fn ([row _]) (:file row)))
              [written-model written skipped] (fold (%map-pairs by-file) [m 0 0] write-file-rows)
              back (finish-editing (ed-return-to written-model
                                     (buffer-name buffer)
                                     (buffer-point buffer))
                     (buffer-name buffer)))
          (message back
            (str (ed-count-noun written "line")
              " changed in "
              (ed-count-noun (count by-file) "file")
              (if (> skipped 0)
                (str "; " (ed-count-noun skipped "line") " skipped (changed since the search)")
                "")
              (if (> written 0) " — C-x s saves" "")))))))

;; ---- C-c C-k: the rows put back ---------------------------------------------------

(defcommand cmd-search-edit-abort
  (m key)
  "Put every row back as the search found it and stop editing (C-c C-k)."
  (let (buffer (ed-current-buf m))
    (if (not (editing? buffer))
      (message m "not editing the results")
      (let (regions (editable-regions buffer)
            rows (:search-edit buffer)
            restored (fold (reverse (range 0 (count rows)))
                       buffer
                       (fn (b index)
                         (let ([from to] (nth regions index))
                           (replace-region b from to (:text (nth rows index)))))))
        (message (finish-editing (ed-set-buf m restored) (buffer-name buffer)) "Edits put back")))))

;; ---- the mode ------------------------------------------------------------------

(def search-edit-layer
  ;; the keys while the rows are editable; typing is text-mode's, the colours project-search's
  {:name 'search-edit
   :keymap (-> {}
             (keymap-bind [:ctrl-c :ctrl-c] 'searchedit/cmd-search-edit-commit)
             (keymap-bind [:ctrl-c :ctrl-k] 'searchedit/cmd-search-edit-abort))})

(modes/register-type :project-search-edit
  (list 'searchedit/search-edit-layer 'project-search/project-search-layer 'modes/text-mode-layer))

;; ---- M-x project-query-replace-regexp: the steps in one --------------------------------

(defn- replace-in-results (m regexp to)
  ;; the shown *Project Search* made editable and a query-replace of `regexp` over its rows;
  ;; C-c C-c then writes what was replaced
  (let (editing (cmd-search-edit m nil))
    (if (editing? (ed-current-buf editing))
      (query-replace/qr-start editing regexp to {:regexp? true})
      editing)))

(defcommand cmd-project-query-replace-regexp
  (m key)
  "Replace a regexp across the project (C-x p %, Emacs's project-query-replace-regexp): the
project is searched, the rows open for editing (C-c C-p), and a query-replace runs over them —
y / n / ! as M-% — after which C-c C-c writes the replaced rows to their files (C-c C-k puts
them back). Nothing reaches a file before C-c C-c."
  (let (root (ed-project-root m))
    (if (nil? root)
      (message m "not in a project")
      (textops/ed-two-part-prompt m
        "Project query replace regexp: "
        (fn (regexp) (str "Project query replace regexp " regexp " with: "))
        (fn (answered regexp to)
          (if (string/blank? regexp)
            (message answered "(nothing to replace)")
            (project-search/ed-project-search answered
              root
              regexp
              (fn (shown) (replace-in-results shown regexp to)))))))))
