(defmodule modes
  "The editor's modes, as **layers** (`std/layers.blsp`). A *mode* is a layer — a
named bundle of a keymap (and, later, hooks / a structural parser) — that a buffer
carries; dispatch composes the active buffer's layers (see `input`). This decouples
\"which keys do what\" from the dispatch loop and makes it per-buffer: a `.blsp`
buffer can later get a `brood-mode` layer (structural sexp nav + C-x C-e) stacked
on, while a plain buffer stays in `text-mode`.

`text-mode` is the **default**: it's registered for the `:fundamental` type, which
`layers/buffer-type-for` returns for any buffer with no matching filename and no
explicit `:type`. Its keymap holds the editor's bindings — data, built with
`keymap-bind` (which nests prefix sub-keymaps for chords like `C-x C-e`); command
values are quoted, fully-qualified symbols resolved with `(reflect/eval sym)` at dispatch,
so redefining a command or rebinding a key hot-swaps behaviour live.

This module is the mode INFRASTRUCTURE — text-mode, the shared `prog` base and the two
registration helpers every language mode goes through (`register-language-mode`,
`register-prog-mode`) — plus the generic read-only buffer modes (special, help, occur,
dired, …). The languages live beside it: `brood-mode` (src/brood-mode.blsp), the other
Lisps (src/lisp-modes.blsp), the tree-sitter and config-format modes
(src/languages.blsp); the line-number gutter they all draw is `gutter`
(src/gutter.blsp)."
  (:use editor/layers)
  (:use editor/keymap)
  (:use theme)) ; *blue* — the welcome links (src/theme.blsp)
;; regex (file-type trigger), lex-markdown, editor/highlight and model are referenced
;; qualified below — each `mod/name` auto-loads its module.
;; The universal keybindings (the old `global` layer) moved to `keymaps` (src/keymaps.blsp):
;; they're now a keybinding *profile* on the MODEL scope, not a system layer pinned to
;; every buffer, so a second profile (vim) can replace them. This module keeps the
;; per-buffer *mode* layers (text/markdown/special/…) — mode-specific keys.

;; text-mode is the visible default major: it names the mode for plain buffers (its
;; bindings are the global layer's) and carries the line-number gutter service. It's
;; the layer for `:fundamental`, the type `buffer-type-for` falls back to.
(def text-mode-layer
  {:name 'text
   :doc "Ordinary text: the movement, editing and selection every buffer has."
   :keymap {}
   ;; prose has no segments: Tab completes a word whole (`complete-at-point/complete-step`)
   :completion-separators #{}
   :gutter-width 'gutter/line-number-width
   :gutter-cell 'gutter/line-number-cell})
(register-type-layers :fundamental (list 'modes/text-mode-layer))

;; welcome-mode: the startup scratch (`main/*welcome*`). An ordinary EDITABLE text
;; buffer whose mode adds exactly one affordance: the link lines (the bedit
;; tutorial, the Brood playground) are clickable — `:line-loc` truthy on a link
;; line gives it the pointer cursor + hover underline (the shared link affordance
;; in `view`), `:on-click` runs that line's command, and a line face paints it
;; link-blue. Type over them and it's just a scratch.

(def *welcome-links*
  ;; marker substring → the (deferred-loaded) command a click on that line runs.
  ;; What `welcome-line-loc` matches and `commands/cmd-welcome-link` dispatches on.
  [["interactive bedit tutorial" 'tutor/cmd-tutorial]
    ["Brood playground" 'playground/cmd-brood-playground]])

(defn welcome-link-at (line)
  "The `[marker command]` entry of `*welcome-links*` whose marker `line` contains,
or nil for a plain line."
  (first (seq/filter modes/*welcome-links* (fn (l) (includes? line (first l))))))

(defn welcome-line-loc (buf line0)
  "Truthy on a welcome-buffer link line — the link affordance hook (this
'location' is consumed by `commands/cmd-welcome-link`, never visited as a file)."
  (when-let (link (welcome-link-at (editor/buffer/buffer-line-at buf line0)))
    {:welcome (second link)}))

(defn welcome-fontify (src)
  (fontify-line-faces src
    (fn (l) (when (welcome-link-at l) {:fg *blue*}))))

(def welcome-mode-layer
  {:name 'welcome
   :doc "The startup screen — RET follows the link under point."
   :keymap {}
   :fontify 'modes/welcome-fontify
   :line-loc 'modes/welcome-line-loc
   :on-click 'commands/cmd-welcome-link})

(register-type-layers :welcome (list 'modes/welcome-mode-layer 'modes/text-mode-layer))

;; `M-x claude` has no key of its own, so no keymap declares it; declare it here, like
;; markdown-preview, or the name would exist only once something else had loaded term
(interactive/register-deferred 'terminal/cmd-claude)

(defn- modes-register-with-layers (layer-ref type layers)
  (let (pat (:file-pattern (reflect/eval layer-ref)))
    (register-type-layers type layers)
    (register-file-type (fn (f) (regex/match? pat f)) type)))

(defn register-language-mode (layer-ref type)
  "Register a language mode that stacks over text-mode: bind `type` to `[layer
text-mode]` (head = higher precedence) and route the layer's `:file-pattern` regex to
that type. The shared shape every fontify/structural language mode registers through —
brood, markdown, env, docker, ruby, elixir; a future json-/python-mode is one more call."
  (modes-register-with-layers layer-ref type (list layer-ref 'modes/text-mode-layer)))

;; ---- the special buffer TYPE: one feature layer over special-mode over text-mode ----
;; Every generated report (*Debug*, *Run*, *Packages*, the BEAM views, dired, …) used to
;; spell out the same stack by hand, and its layer's `:commands` repeated its keymap's
;; command names by hand too. `:commands` is what M-x offers ONLY in that buffer (and
;; subtracts from the global set — `model/ed-all-layer-commands`), so a hand list that
;; drifted from the keymap silently moved commands in or out of M-x. Both are derived now.

(defn layer-commands (keymap &optional (options {}))
  "The M-x names a mode layer claims for `keymap` (its `:commands` facet): every command
the keymap binds, named as M-x names it (`interactive/command-friendly-name` of the
symbol's last segment, `dired/cmd-dired-up` → `\"dired-up\"`), sorted. `options` makes a
deliberate difference explicit — `:extra`, names claimed though no key here runs them;
`:except`, names bound here but left in the GLOBAL M-x set (a shared motion such as
`next-line`, which claiming would hide from every other buffer).

    (modes/layer-commands {\"g\" 'beam/cmd-beam-refresh})   ;=> (\"beam-refresh\")"
  (let ({:keys [extra except]} options
        bound (map (or (editor/keymap/keymap-commands keymap) '())
                (fn (sym)
                  (interactive/command-friendly-name (last (string/split (->string sym) "/")))))
        dropped (into #{} (or except '())))
    (sort (seq/distinct (append (seq/reject bound (fn (nm) (contains? dropped nm))) (or extra '()))))))

(defn register-special-type (type & layer-refs)
  "Bind buffer `type` to `layer-refs` (highest precedence first) stacked over
`special-mode-layer` (read-only, no gutter, `q` buries) over `text-mode-layer` (so motion
still walks the rows) — the shape every generated report buffer has.

    (register-special-type :run-log 'apprun/run-log-mode-layer 'results/location-jump-layer)"
  (register-type-layers type
    (append layer-refs (list 'modes/special-mode-layer 'modes/text-mode-layer))))

;; ---- the shared `prog` base: structural navigation every code mode inherits -----
;; The `C-M-f/b/u/d/a` motions are identical across languages — only the *parser* differs.
;; So they live on one base layer (`prog-mode-layer`) that code modes stack between their
;; language layer and text-mode, and the commands (`commands/cmd-forward-sexp` …) dispatch on
;; the buffer's `:ts-lang` (Brood CST vs tree-sitter — see `commands/ed-structural`). A new
;; language inherits the keys for free and overrides only the parser/faces — the "default +
;; override" model. Paredit (slurp/barf/…) stays Brood-only (a Lisp-delimiter edit), so it
;; lives on `brood-keymap`, not here.
(def prog-structural-keymap
  (-> {}
    ;; RET auto-indents the new line, through whatever `:indent` service the language
    ;; supplies — which is the same "identical key, different parser" shape as the motions
    ;; below, so it belongs here rather than on one language's keymap. It sat on
    ;; `brood-keymap` while `.blsp` was the only mode that could indent, and stayed there
    ;; after the tree-sitter modes gained an `:indent`: RET in a `.ex` buffer was still the
    ;; plain newline, landing every continuation line in column 0.
    (keymap-bind [:enter] 'commands/cmd-newline-and-indent)
    (keymap-bind [:ctrl-meta-f] 'commands/cmd-forward-sexp) ; C-M-f forward-sexp
    (keymap-bind [:ctrl-meta-b] 'commands/cmd-backward-sexp) ; C-M-b backward-sexp
    ;; the sexp/list pair: C-M-f/b stop at every form, C-M-n/p only at whole LISTS —
    ;; the "jump the next block" motion (Emacs forward-list / backward-list).
    (keymap-bind [:ctrl-meta-n] 'commands/cmd-forward-list) ; C-M-n forward-list
    (keymap-bind [:ctrl-meta-p] 'commands/cmd-backward-list) ; C-M-p backward-list
    ;; C-M-u is Emacs' `backward-up-list`; its forward twin (`up-list`) has no default
    ;; key there either — it's M-x up-list, and rebindable like anything else.
    (keymap-bind [:ctrl-meta-u] 'commands/cmd-backward-up-list) ; C-M-u backward-up-list
    (keymap-bind [:ctrl-meta-d] 'commands/cmd-down-list) ; C-M-d down-list
    (keymap-bind [:ctrl-meta-a] 'commands/cmd-beginning-of-defun) ; C-M-a beginning-of-defun
    (keymap-bind [:ctrl-meta-e] 'commands/cmd-end-of-defun) ; C-M-e end-of-defun
    ;; C-M-SPC (also C-M-@) — mark the next sexp, extending on repeat. Key encoding for
    ;; the space chord mirrors C-SPC's `"ctrl- "`; both spellings bound to be safe. It
    ;; rides the same polymorphic motion as C-M-f, so it marks a tree-sitter node in a
    ;; tree-sitter mode — which its own docstring already claimed while it sat on
    ;; `brood-keymap`, where no `.ex` buffer could reach it.
    (keymap-bind [(keyword "ctrl-meta- ")] 'commands/cmd-mark-sexp) ; C-M-SPC
    (keymap-bind [(keyword "ctrl-meta-@")] 'commands/cmd-mark-sexp) ; C-M-@
    ;; the structural kills + whole-form reindent: they ride the motions above, so they
    ;; work over a tree-sitter tree too and belong here rather than on brood-keymap.
    (keymap-bind [:ctrl-meta-k] 'commands/cmd-kill-sexp) ; C-M-k kill-sexp
    (keymap-bind [(keyword "ctrl-meta-backspace")]
      'commands/cmd-backward-kill-sexp) ; C-M-DEL backward-kill-sexp
    (keymap-bind [:ctrl-meta-q] 'commands/cmd-indent-sexp))) ; C-M-q indent-sexp
(def prog-mode-layer
  {:name 'prog
   :keymap modes/prog-structural-keymap
   ;; code divides a name into segments — `XB.Tool.call`, `mod/name`, `std::fs` — and Tab
   ;; completes one at a time (`complete-at-point/complete-step`)
   :completion-separators #{"." "/" ":"}
   :commands '("forward-sexp" "backward-sexp"
                "forward-list" "backward-list" "up-list" "backward-up-list" "down-list"
                "beginning-of-defun" "end-of-defun" "kill-sexp" "backward-kill-sexp" "indent-sexp")})

(defn register-prog-mode (layer-ref type)
  "Like `register-language-mode`, but for a **code** mode: it stacks the shared
`prog-mode-layer` (the `C-M-*` structural motions) between the language layer and text-mode,
so every code language inherits the same navigation keys and overrides only its parser/faces."
  (modes-register-with-layers layer-ref
    type
    (list layer-ref 'modes/prog-mode-layer 'modes/text-mode-layer)))

;; ---- markdown-mode: Markdown (.md) source, stacked on text-mode -------------
;; The second language mode, and the proof the editor is language-agnostic: a `.md`
;; buffer keeps every text-mode motion/edit binding and the line-number gutter, and
;; *gains* Markdown syntax colouring — purely by registering a layer whose `:fontify`
;; is `lex-markdown`'s pure `markdown-spans` (the brood analogue of
;; brood-mode's `highlight-spans`). No keymap or language services beyond fontify yet
;; (headings/code/emphasis/links/lists/quotes); a future toggle-heading command is
;; just another binding on this layer. The only state the lexer carries between lines is
;; "inside a fenced code block", which makes it a LINE LEXER (`:line-lexer`, brood
;; ADR-471): the pane keeps every line's spans and fence state (`linecache`), so a key
;; re-lexes the lines it touched. `:fontify-restart` still serves the long-line slice path:
;; the band's own first line is a safe start unless a fence above it is still open, and then
;; the fence's line is.
;;
;; A fence whose info string names a language (```python) is coloured as that language,
;; over the whole fence (brood ADR-489, `lex-markdown/markdown-fence-pass`): the line lexer
;; marks the body lines, and `:line-band-pass` swaps them for the body parsed as one
;; document, with the embedded language's own mode's face table. A language with no grammar
;; installed keeps the one code colour.
(defn markdown-fontify (src)
  "markdown-mode's `:fontify`: `lex-markdown/markdown-spans` with each fence coloured as
its language, by that language's registered face table."
  (lex-markdown/markdown-spans src languages/language-faces))

(defn markdown-fence-pass (rope spans)
  "markdown-mode's `:line-band-pass`: a line band's fences coloured as their languages
(`lex-markdown/markdown-fence-pass`)."
  (lex-markdown/markdown-fence-pass rope spans languages/language-faces))

(def markdown-keymap
  ;; C-c C-p: the rendered preview beside the buffer (src/mdpreview.blsp; the symbol
  ;; is resolved at dispatch, so the module loads on the first press)
  (-> {}
    (keymap-bind [:ctrl-c :ctrl-p] 'mdpreview/cmd-markdown-preview)))

(def markdown-mode-layer
  {:name 'markdown
   :file-pattern "\\.(md|markdown)$"
   :fontify 'modes/markdown-fontify
   :line-lexer 'lex-markdown/markdown-line-lexer
   :line-band-pass 'modes/markdown-fence-pass
   :fontify-restart 'lex-markdown/markdown-fontify-restart
   ;; prose wraps by default (Emacs users turn `visual-line-mode` on for markdown; here the
   ;; mode declares it — `M-x visual-line-mode` still toggles it off per buffer)
   :long-lines :wrap
   :keymap modes/markdown-keymap
   :commands '("markdown-preview")
   ;; the preview follows the cursor as it moves, re-renders on the idle beat, and goes
   ;; with the buffer — all three hooks are `mdpreview`'s, loaded on first use
   :on-move 'mdpreview/markdown-on-move
   :on-idle 'mdpreview/markdown-on-idle
   :hooks {:on-close '(mdpreview/markdown-on-close)}})

;; .md / .markdown files → the :markdown type, stacked over text-mode.
(register-language-mode 'modes/markdown-mode-layer :markdown)
;; `M-x markdown-preview` before any `.md` buffer has loaded the module: declared, so the
;; name is known and the module loads on demand (the profile keymaps get this for free
;; in `keymaps`; a mode keymap's commands declare themselves here).
(interactive/register-deferred 'mdpreview/cmd-markdown-preview)
;; `$` lives in a MODE keymap, and only the PROFILE keymaps are harvested for M-x
;; (`keymaps`), so `M-x vcs-process` would not exist until something had loaded git
(interactive/register-deferred 'vcsproc/cmd-vcs-process)
;; and the git commands a Magit user reaches for by NAME from any buffer: making a repo,
;; cloning one, and the views that have no global key
(interactive/register-deferred 'git/cmd-git-init)
(interactive/register-deferred 'git/cmd-git-clone)
(interactive/register-deferred 'gitview/cmd-git-log)
(interactive/register-deferred 'gitview/cmd-git-log-all)
(interactive/register-deferred 'gitview/cmd-git-reflog)
(interactive/register-deferred 'gitview/cmd-git-refs)
;; sharing this editor is reached by NAME (M-x share-session), not by a key: its commands
;; live in `collab-commands`, so they declare themselves here as git's do
(interactive/register-deferred 'collab-commands/cmd-share-session)
(interactive/register-deferred 'collab-commands/cmd-share-session-stop)
(interactive/register-deferred 'collab-commands/cmd-collab-status)
;; M-x list-processes has no key either (its buffer's keys live in a mode keymap)
(interactive/register-deferred 'process-list/cmd-list-processes)
(interactive/register-deferred 'gitview/cmd-git-find-file)

;; The preview pane itself: read-only rendered text, no line numbers (it is not a file),
;; its faces served from the buffer's `:face-spans` data rather than a `:fontify` lexer.
(def markdown-preview-layer {:name 'markdown-preview :no-line-numbers true})

(register-special-type :markdown-preview 'modes/markdown-preview-layer)

;; ---- process-menu-mode: the read-only, killable *Process List* --------------
;; Emacs `process-menu-mode` (a `special-mode`): the generated `*Process List*`
;; buffer (process-list/cmd-list-processes) is **read-only** — its `:activate` hook flips
;; the buffer's std/buffer read-only flag, so every text-edit command is refused —
;; and gains kill/refresh keys. It stacks over text-mode so motion (C-n/C-p, the
;; arrows, M-</M->) still navigates the rows. Stamped on the buffer by *type*
;; (`:process-menu`), not by filename: the list has no backing file.

(defn read-only-activate (buf)
  "An `:activate` hook that makes a generated report buffer read-only (special-mode
style) — its own keys act while text edits are refused (`ed-edit` reports it). Carried by
`special-mode-layer`, so every read-only generated buffer shares it."
  (editor/buffer/set-read-only buf true))

;; ---- special-mode: the shared base for read-only, generated buffers ---------
;; Emacs's `special-mode`, as a layer. The process menu, occur, dired, and the git
;; status/diff/log buffers are all read-only listings/reports with no line-number gutter;
;; each used to repeat those two facts. They now stack this base just above text-mode (so
;; motion still works) and drop their own copies. `init-buffer-layers` activates every layer
;; in a type's stack, so this layer's `:activate` (the read-only hook) fires at buffer
;; creation regardless of precedence. An *editable* generated buffer (e.g. *git-commit*)
;; doesn't use it — it wants only the no-gutter half, which it sets on its own layer.
(def special-keymap
  ;; `q` buries the buffer, as it does in every Emacs special-mode buffer. It lives HERE
  ;; rather than on each mode because it was missing from every generated buffer that had
  ;; not thought to bind it — *Occur*, *Process List*, *Buffer Menu*, *Diagnostics*, the
  ;; hex view and (when it arrived) all of `help` — while dired, git and packages each
  ;; carried their own copy. A read-only buffer you cannot leave the way every other one
  ;; leaves is the kind of gap nobody files and everybody works around with C-x k.
  ;;
  ;; A mode stacking ABOVE this one still binds its own `q` and wins (dired's quits dired);
  ;; this is only the floor.
  (-> {} (keymap-bind ["q"] 'commands/cmd-kill-buffer)))

(def special-mode-layer
  {:name 'special
   :doc "A generated, read-only buffer — q buries it, and nothing you type here edits it."
   :keymap modes/special-keymap
   :no-line-numbers true
   :hooks {:activate '(modes/read-only-activate)}})

;; ---- help-mode: the C-h report buffers (src/help.blsp) ----------------------
;; *Bindings* / *Modes* / *Apropos* / *Lossage* / *Help*. Read-only generated text with
;; no rows to act on, so it needs no keymap of its own — the type exists so those buffers
;; get `special-mode`'s read-only + no-gutter treatment and say what they are in the mode
;; line, rather than arriving as anonymous `:fundamental` text.
(def help-mode-layer
  {:name 'help
   :doc "A help report (C-h) — what is bound, what is on, what a name means."})

(register-special-type :help 'modes/help-mode-layer)

(def process-menu-keymap
  (-> {}
    ;; d / x / k — kill the process on the current line (Emacs process-menu `d`,
    ;; proced `x`; `k` as a kill mnemonic).
    (keymap-bind ["d"] 'process-list/cmd-process-menu-kill)
    (keymap-bind ["x"] 'process-list/cmd-process-menu-kill)
    (keymap-bind ["k"] 'process-list/cmd-process-menu-kill)
    ;; g — refresh the snapshot (Emacs `revert-buffer` on a tabulated list).
    (keymap-bind ["g"] 'process-list/cmd-process-menu-refresh)
    ;; t — toggle the tree (parent→child) vs flat (id-sorted) view.
    (keymap-bind ["t"] 'process-list/cmd-process-menu-toggle-tree)))

(def process-menu-mode-layer
  {:name 'process-menu
   :doc "The running processes — d/x/k kills the one on this line, g refreshes."
   :keymap modes/process-menu-keymap
   :commands (layer-commands modes/process-menu-keymap)})

;; :process-menu stacks process-menu-mode over special-mode (read-only + no gutter) over
;; text-mode (so motion still works); the list buffer gets it via `set-buffer-type` (see
;; pool/ed-show-named), no file.
(register-special-type :process-menu 'modes/process-menu-mode-layer)

;; ---- buffer-menu-mode: the *Buffer List* (C-x C-b) ----------------------------
(def buffer-menu-keymap
  (-> {}
    ;; RET — visit the buffer on this row (Emacs `Buffer-menu-this-window`)
    (keymap-bind [:enter] 'commands/cmd-buffer-menu-select)
    ;; g — rebuild the listing
    (keymap-bind ["g"] 'commands/cmd-buffer-menu-refresh)))

(def buffer-menu-mode-layer
  {:name 'buffer-menu
   :doc "The open buffers — RET selects the one on this line."
   :keymap modes/buffer-menu-keymap
   :commands (layer-commands modes/buffer-menu-keymap)})

;; :buffer-menu stacks over special-mode (read-only + no gutter, `q` quits) over
;; text-mode, like the process list; the buffer gets it via `set-buffer-type`.
(register-special-type :buffer-menu 'modes/buffer-menu-mode-layer)

;; ---- kill-ring-mode: *Kill Ring* (M-x browse-kill-ring) ---------------------------
(def kill-ring-keymap
  (-> {}
    ;; RET — insert the entry at point where the listing was opened from
    (keymap-bind [:enter] 'commands/cmd-kill-ring-insert)
    ;; g — rebuild the listing
    (keymap-bind ["g"] 'commands/cmd-kill-ring-refresh)))

(def kill-ring-mode-layer
  {:name 'kill-ring
   :doc "The kill ring, newest first — RET inserts the entry at point."
   :keymap modes/kill-ring-keymap
   :commands (layer-commands modes/kill-ring-keymap)})

(register-special-type :kill-ring 'modes/kill-ring-mode-layer)

;; ---- report fontify: spans per line ------------------------------------------
;; Every line-structural fontifier (*Tests*, *Run*, *Debug*, *Spy*, dired, the hex view,
;; *Project Search*) walks the slice line by line, threading the line's offset; this is
;; the one accumulator behind them all, git's diff and process buffers included.

(defn fontify-lines (src line-spans)
  "`[start end face]` spans for `src`, built a line at a time: `line-spans` is
`(line-text offset) -> spans` (a list or vector, possibly empty), `offset` being where the
line starts in `src`. Line-structural, so the windowed slice the view hands a `:fontify`
service colours correctly wherever it starts. Spans are `cons`'d and `reverse`d once (NOT
`append`ed onto a growing accumulator, which recopies it each line — O(n²) in the window):
the streaming *Run* / *Spy* / *Tests* buffers re-fontify their window on every append, so
keeping this linear is what stops them lagging as output pours in.

    (modes/fontify-lines \"ab\\ncd\" (fn (line offset) [[offset (inc offset) :x]]))   ;=> ([0 1 :x] [3 4 :x])"
  (letrec (go (fn (lines offset acc)
                (if (empty? lines)
                  (reverse acc)
                  (let (line (first lines))
                    (go (rest lines)
                      (+ offset (string/length line) 1)
                      (fold (line-spans line offset) acc (fn (spans span) (cons span spans))))))))
    (go (string/split src "\n") 0 '())))

(defn fontify-line-faces (src line-face)
  "Whole-line spans for `src`: `line-face` is `(line-text) -> face|nil` per line — the
`fontify-lines` of a report that colours each line by its role."
  (fontify-lines src
    (fn (line offset)
      (let (face (line-face line))
        (if (nil? face) '() (list [offset (+ offset (string/length line)) face]))))))

;; ---- location-jump ----------------------------------------------------------
;; The shared "report row -> source" layer (`location-jump-layer`) + its location
;; vocabulary moved to `src/results.blsp` (the results-buffer abstraction). Modes stack
;; `results/location-jump-layer`; git below keeps its own `:on-click` command.

;; ---- occur-mode: the read-only *Occur* results buffer -----------------------
;; The *Occur* buffer (commands/cmd-occur) lists matching lines; it's stamped :occur,
;; made read-only on activate (like the process list), and is a results buffer: each row's
;; `{:buffer :line}` rides in `:line-links`, so RET / a click visit it through the shared
;; `results/location-jump-layer`. Stacks over text-mode so motion (C-n/C-p, arrows)
;; navigates rows.

(def occur-mode-layer
  {:name 'occur
   :doc "Search hits, one per line — RET jumps to the line it names."
   :line-loc 'results/line-links-only-loc})

(register-special-type :occur 'modes/occur-mode-layer 'results/location-jump-layer)

;; ---- hexl-mode: a binary as a hex view --------------------------------------
;; A file that is not UTF-8 opens through `hexl/ed-open-binary` (Emacs hexl-mode):
;; xxd rows, coloured by `hexl/hexl-fontify` (offsets dim, zero bytes dimmer, the
;; ASCII column as a string). Read-only and without line numbers (each row carries its
;; offset) via the special-mode layer beneath; q quits.

(def hexl-mode-layer
  {:name 'hexl
   :doc "A binary file as hex — read-only, sixteen bytes a row."
   :fontify 'hexl/hexl-fontify
   ;; its text renders the binary, it is not the binary: C-x C-s / C-x C-w refuse it
   :no-write {:what "a hex view" :why "it renders the binary; edit the file itself"}})

(register-special-type :hexl 'modes/hexl-mode-layer)
