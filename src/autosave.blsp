(defmodule autosave
  "Emacs's auto-save: on the idle beat, and on a timer of its own after the last edit, every
modified file buffer's text goes to its `#file#` sidecar (`sidecar` says where; a real save
removes it). Policy over the pool, run off the keystroke so it costs one nothing."
  (:use editor/buffer) ; buffer-file / buffer-modified? / buffer-rope
  (:use sidecar) ; where each sidecar goes
  (:use model)) ; ed-buf-at / ed-set-buf-at / message — the pool it walks

;; ---- auto-save --------------------------------------------------------------
;; On the idle beat, write `#filename#` sidecar files for modified file-backed
;; buffers. A real save removes the sidecar (`file-save/ed-save-buf-with`, through
;; `sidecar/ed-forget-auto-save`).

(def *auto-save-interval-ms* 30000)

(defn ed-auto-save-due (m)
  "What this auto-save round has to write: `{path rope}` for every modified file buffer —
the `:due` ones, whose rope is not the one last written for that path (`:auto-saved`, the
previous round's whole map), and the `:all` map the round leaves behind — and `:sudo`, `{path
user}` for those edited as another user through sudo, whose sidecars are private ([[ed-auto-save-path]]). A
buffer nobody touched since the last round costs a rope-handle compare, not a rewrite of
its file; one saved since (unmodified now) drops out, so its next edit is written again."
  (let (written (or (:auto-saved m) {}))
    (fold (:buffers m)
      {:due {} :all {} :sudo {}}
      (fn (acc buffer)
        (let (path (buffer-file buffer))
          (if (and path (buffer-modified? buffer))
            (let (rope (buffer-rope buffer)
                  user (buffer-sudo-user buffer)
                  with-user (if user (map/assoc-in acc [:sudo path] user) acc)
                  with-all (map/assoc-in with-user [:all path] rope))
              (if (= (get written path) rope) with-all (map/assoc-in with-all [:due path] rope)))
            acc))))))

(defn ed-auto-save-write (due &optional (sudo-users {}) (report nil) (failing #{}))
  "Write each `{path rope}` in `due` to the path's `#basename#` sidecar — the private one for
a path in `sudo-users`, as its user ([[write-sidecar]]) — the text built from the rope here,
in the writer process `ed-auto-save!` spawns, so neither the text nor the disk is paid for on
the editor's loop. A sidecar that cannot be written is logged, and told to `report` (the
editor's loop) as `[:auto-save-failed path reason]`; one in `failing` that is written again
is told as `[:auto-save-ok path]`. The rest are written either way. Returns nil."
  (doseq (entry due)
    (let ([path rope] entry)
      (try
        (do
          (write-sidecar path (get sudo-users path) (text/->string rope))
          (when (and report (contains? failing path)) (send report [:auto-save-ok path])))
        (catch failure
          (do
            (log/warn (str "auto-save of " path " failed: " (error-message failure)))
            (when report (send report [:auto-save-failed path (error-message failure)]))))))))

(defn ed-auto-save! (m)
  "Write `#filename#` sidecars for the modified file-backed buffers that changed since the
last round ([[ed-auto-save-due]]), throttled to once per `*auto-save-interval-ms*`. The
writing happens off the loop: the ropes ride the writer's closure (a rope can be captured,
not sent) and [[ed-auto-save-write]] builds each text there. Returns the model with
`:auto-saved-at` and the ropes written (`:auto-saved`) updated."
  (let (now-ms (os/now)
        last (or (:auto-saved-at m) 0))
    (if (< (- now-ms last) *auto-save-interval-ms*)
      m
      (let ({:keys [due all sudo]} (ed-auto-save-due m))
        (do
          (when (not (empty? due))
            ;; the writer tells the loop of a sidecar it could not write, so the failure is
            ;; said in the echo area and the path is not counted written
            (let (loop (self)
                  failing (or (:auto-save-failing m) #{}))
              (spawn (fn () (ed-auto-save-write due sudo loop failing)))))
          (assoc m :auto-saved-at now-ms :auto-saved all))))))

(defn ed-auto-save-now! (m)
  "An auto-save round NOW, whatever the throttle says ([[ed-auto-save!]]) — for a moment
after which there may be no next round: the window a served session painted to went away."
  (ed-auto-save! (assoc m :auto-saved-at 0)))

(defn ed-auto-save-pending? (m)
  "Whether some modified file buffer holds text the last round did not write — what the
auto-save timer waits on. A rope-handle compare per buffer, asked after every event."
  (let (written (or (:auto-saved m) {}))
    (any? (:buffers m)
      (fn (buffer)
        (let (path (buffer-file buffer))
          (and path (buffer-modified? buffer) (not (= (get written path) (buffer-rope buffer)))))))))

(def *auto-save-timer-floor-ms* 1000) ; never re-arm sooner than this after a short round

(defn ed-auto-save-timer (m)
  "The auto-save timer's spec, for `model/register-timer-client`: an idle one-shot when the
next round is due, while there is something to write. The idle beat alone follows an edit by
a moment — inside the 30 s throttle — and would leave the last edits before you stopped typing
unwritten until the next key."
  (when (ed-auto-save-pending? m)
    (let (elapsed (- (os/now) (or (:auto-saved-at m) 0)))
      {:after (math/max *auto-save-timer-floor-ms* (- *auto-save-interval-ms* elapsed)) :idle? true})))

;; ---- registration: on the idle beat, after the launches ------------------------------
;; It does not arm the beat (no `:stale?`) — an edit does, and the sidecars follow it once
;; typing settles: order 110, before autorevert's disk check at 120.
(register-idle-job :auto-save {:order 110 :run 'autosave/ed-auto-save!})
;; …and a timer of its own, so the round after the last edit runs without another key
(register-timer-client :auto-save 'autosave/ed-auto-save-timer 'autosave/ed-auto-save!)

;; ---- what the writer tells the loop -------------------------------------------------------

(defn ed-ev-auto-save-failed (m input textrows cols rows)
  "`[:auto-save-failed path reason]`: the writer could not write `path`'s sidecar. Said in the
echo area once until it works again — the text is only in the editor, which is the thing to
know — and the path is no longer counted written, so the next round tries again."
  (let ([_ path reason] input
        failing (or (:auto-save-failing m) #{})
        retried (assoc m :auto-saved (dissoc (or (:auto-saved m) {}) path)))
    (if (contains? failing path)
      retried
      (message (assoc retried :auto-save-failing (conj failing path))
        (str "auto-save of "
          path " failed: " reason " — the changes are only in the editor; C-x C-s saves them")))))

(defn ed-ev-auto-save-ok (m input textrows cols rows)
  "`[:auto-save-ok path]`: a sidecar that had failed was written again."
  (let ([_ path] input)
    (message (assoc m :auto-save-failing (set/disj (or (:auto-save-failing m) #{}) path))
      (str "auto-save of " path " works again"))))

(register-event-handler :auto-save-failed 'autosave/ed-ev-auto-save-failed)
(register-event-handler :auto-save-ok 'autosave/ed-ev-auto-save-ok)
