(defmodule autosave
  "Files and the disk between saves: Emacs's `#file#` auto-save sidecars, written on the
idle beat for every modified file buffer and removed by a real save, and auto-revert — a
buffer whose file another writer changed is reloaded when it has no unsaved changes, and
warned about once when it does (`cmd-save` then asks before overwriting).

Policy over the pool, run on the idle beat (`input/ed-timer-fire`) so it costs a keystroke
nothing; the knowledge of \"changed since we last agreed\" lives in `std/editor/buffer`."
  (:use editor/buffer) ; buffer-file / buffer-modified? / revert-buffer / buffer-file-changed?
  (:use editor/pane) ; pane-leaf-paths / pane-payload-at — which buffers are on screen
  (:use model)) ; ed-buf-at / ed-set-buf-at / ed-map-panes / message — the pool it walks

;; ---- auto-save --------------------------------------------------------------
;; On the idle beat, write `#filename#` sidecar files for modified file-backed
;; buffers. `cmd-save` clears the sidecar on a real save (`delete-file`).

(def *auto-save-interval-ms* 30000)

(defn ed-private-auto-save-dir ()
  "Where the sidecars of files edited AS ROOT go (`sudo/…`, [[ed-auto-save-path]]): the
editor's own state folder, `…/bedit/state/auto-save` — never beside the file, where only
root could write one and anyone who can read the directory would see the name."
  (path/join (config/config-dir) "state" "auto-save"))

(defn ed-auto-save-path (path &optional (sudo? false))
  "The auto-save sidecar path: `#basename#` in the same directory as `path` — or, for a file
edited as root (`sudo?`, a buffer's `:sudo`), `#!etc!hosts#` in [[ed-private-auto-save-dir]],
as Emacs puts a TRAMP file's: the whole path with `/` as `!` and a `!` of its own doubled
([[private-sidecar-name]]), owner-only like every sidecar.

    (autosave/ed-auto-save-path \"/home/me/notes.txt\")   ;=> \"/home/me/#notes.txt#\"
    (path/basename (autosave/ed-auto-save-path \"/etc/hosts\" true))   ;=> \"#!etc!hosts#\""
  (if sudo?
    (path/join (ed-private-auto-save-dir) (private-sidecar-name path))
    (path/join (path/dirname path) (str "#" (path/basename path) "#"))))

(defn private-sidecar-name (path)
  "The private sidecar's name for `path`: `#…#` around the path with each `!` doubled, then
each `/` as `!` — Emacs's escaping, so `/etc/a!b` and `/etc/a/b` never share a sidecar.
[[private-sidecar-path]] reads it back.

    (autosave/private-sidecar-name \"/etc/a!b\")   ;=> \"#!etc!a!!b#\""
  (str "#" (string/replace (string/replace path "!" "!!") "/" "!") "#"))

(defn private-sidecar-path (name)
  "The file a private sidecar `name` belongs to ([[private-sidecar-name]] read back), or nil
when `name` is not one.

    (autosave/private-sidecar-path \"#!etc!a!!b#\")   ;=> \"/etc/a!b\"
    (autosave/private-sidecar-path \"notes\")   ;=> nil"
  (when (and (string/starts-with? name "#!")
          (string/ends-with? name "#")
          (> (string/length name) 2))
    (letrec (unescape (fn (chars acc)
                        (cond
                          (empty? chars) acc
                          (and (= (first chars) "!") (= (second chars) "!"))
                            (unescape (rest (rest chars)) (str acc "!"))
                          (= (first chars) "!") (unescape (rest chars) (str acc "/"))
                          else (unescape (rest chars) (str acc (first chars))))))
      (unescape (string/->graphemes (string/substring name 1 (dec (string/length name)))) ""))))

(defn ensure-private-sidecar-dir (sidecar)
  "Make the folder of a private `sidecar` ([[ed-private-auto-save-dir]]), owner-only (0700):
the names in it say which root files were being edited."
  (file/mkdir-private (path/dirname sidecar)))

(defn ed-buffer-auto-save-path (buf)
  "The sidecar of file buffer `buf` ([[ed-auto-save-path]]), private when it is edited as
root; nil for a buffer with no file."
  (let (file (buffer-file buf)) (when file (ed-auto-save-path file (= true (:sudo buf))))))

(defn ed-remove-auto-save (path &optional (sudo? false))
  "Delete `path`'s `#basename#` sidecar (the private one when `sudo?`), if there is one — what
a successful write of the file does (`C-x C-s`, `C-x C-w`), since the sidecar's text is now
on disk. A nil `path` (a fileless buffer) is a no-op; a sidecar that cannot be removed is
logged, never raised — the save itself succeeded."
  (let (sidecar (when path (ed-auto-save-path path sudo?)))
    (when (and sidecar (file/exists? sidecar))
      (try
        (file/rm sidecar)
        (catch e (log/warn (str "could not remove auto-save " sidecar ": " (error-message e))))))))

(defn ed-auto-save-due (m)
  "What this auto-save round has to write: `{path rope}` for every modified file buffer —
the `:due` ones, whose rope is not the one last written for that path (`:auto-saved`, the
previous round's whole map), and the `:all` map the round leaves behind — and `:sudo`, the
set of those paths edited as root, whose sidecars are private ([[ed-auto-save-path]]). A
buffer nobody touched since the last round costs a rope-handle compare, not a rewrite of
its file; one saved since (unmodified now) drops out, so its next edit is written again."
  (let (written (or (:auto-saved m) {}))
    (fold (:buffers m)
      {:due {} :all {} :sudo #{}}
      (fn (acc buf)
        (let (path (buffer-file buf))
          (if (and path (buffer-modified? buf))
            (let (rope (buffer-rope buf)
                  with-all (map/assoc-in (if (= true (:sudo buf))
                                           (assoc acc :sudo (conj (:sudo acc) path))
                                           acc)
                             [:all path]
                             rope))
              (if (= (get written path) rope) with-all (map/assoc-in with-all [:due path] rope)))
            acc))))))

(defn ed-auto-save-write (due &optional (sudo-paths #{}))
  "Write each `{path rope}` in `due` to the path's `#basename#` sidecar — the private one for
a path in `sudo-paths` ([[ed-auto-save-path]], its folder made first) — the text built from
the rope here, in the writer process `ed-auto-save!` spawns, so neither the text nor the
disk is paid for on the editor's loop. A sidecar that cannot be written is logged and the
rest still are. Returns nil."
  (doseq (entry due)
    (let ([path rope] entry
          sudo? (contains? sudo-paths path)
          sidecar (ed-auto-save-path path sudo?))
      (try
        (do
          (when sudo? (ensure-private-sidecar-dir sidecar))
          (file/spit-private sidecar (text/->string rope)))
        (catch e (log/warn (str "auto-save of " path " failed: " (error-message e))))))))

(defn ed-auto-save! (m)
  "Write `#filename#` sidecars for the modified file-backed buffers that changed since the
last round ([[ed-auto-save-due]]), throttled to once per `*auto-save-interval-ms*`. The
writing happens off the loop: the ropes ride the writer's closure (a rope can be captured,
not sent) and [[ed-auto-save-write]] builds each text there. Returns the model with
`:auto-saved-at` and the ropes written (`:auto-saved`) updated."
  (let (now-ms (os/now)
        last (or (:auto-saved-at m) 0))
    (if (< (- now-ms last) *auto-save-interval-ms*)
      m
      (let ({:keys [due all sudo]} (ed-auto-save-due m))
        (do
          (when (not (empty? due)) (spawn (fn () (ed-auto-save-write due sudo))))
          (assoc m :auto-saved-at now-ms :auto-saved all))))))

(defn ed-auto-save-now! (m)
  "An auto-save round NOW, whatever the throttle says ([[ed-auto-save!]]) — for a moment
after which there may be no next round: the window a served session painted to went away."
  (ed-auto-save! (assoc m :auto-saved-at 0)))

(defn ed-auto-save-pending? (m)
  "Whether some modified file buffer holds text the last round did not write — what the
auto-save timer waits on. A rope-handle compare per buffer, asked after every event."
  (let (written (or (:auto-saved m) {}))
    (any? (:buffers m)
      (fn (buf)
        (let (path (buffer-file buf))
          (and path (buffer-modified? buf) (not (= (get written path) (buffer-rope buf)))))))))

(def *auto-save-timer-floor-ms* 1000) ; never re-arm sooner than this after a short round

(defn ed-auto-save-timer (m)
  "The auto-save timer's spec, for `model/register-timer-client`: an idle one-shot when the
next round is due, while there is something to write. Without it a round ran only on an idle
beat, which follows an edit by a moment — inside the 30 s throttle — so the last edits before
you stopped typing stayed unwritten until the next key."
  (when (ed-auto-save-pending? m)
    (let (elapsed (- (os/now) (or (:auto-saved-at m) 0)))
      {:after (math/max *auto-save-timer-floor-ms* (- *auto-save-interval-ms* elapsed)) :idle? true})))

;; ---- recovering from a sidecar ------------------------------------------------
;; The sidecars are worth something only if they come back: a file visited with a sidecar
;; newer than itself says so, and `recover/cmd-recover-this-file` puts the text back.

(defn ed-auto-save-newer? (path &optional (sudo? false))
  "Whether `path` has an auto-save sidecar (the private one when `sudo?`) written after the
file was — unsaved text the editor (or one that crashed) left behind. A sidecar of a file
that no longer exists counts."
  (let (sidecar-mtime (file/mtime (ed-auto-save-path path sudo?))
        file-mtime (file/mtime path))
    (and (not (nil? sidecar-mtime)) (or (nil? file-mtime) (> sidecar-mtime file-mtime)))))

(defn ed-recovery-note (path &optional (sudo? false))
  "What visiting `path` (as root when `sudo?`) should say when it has newer auto-save data
([[ed-auto-save-newer?]]), or nil. Emacs's \"has auto save data; consider M-x
recover-this-file\".

    (autosave/ed-recovery-note \"/nowhere/at/all\")   ;=> nil"
  (when (ed-auto-save-newer? path sudo?)
    (str (path/basename path) " has unsaved auto-save data — M-x recover-this-file to restore it")))

(def *follow-points-max-chars* 400000) ; past this, a re-read keeps the character offset

(defn- ed-follow-points (old new points)
  "The character offsets `points` of rope `old` moved to the same logical line and column
of rope `new`: one line diff for all of them (`diff/map-lines`), so a point whose line was
pushed down by lines added above it stays on it, and the column is clamped to its line.
Past `*follow-points-max-chars*` the diff is skipped and each offset is only clamped to
the new length."
  (let (old-length (text/length old)
        new-length (text/length new)
        points (map points (fn (point) (math/min point old-length))))
    (if (or (>= old-length *follow-points-max-chars*) (>= new-length *follow-points-max-chars*))
      (map points (fn (point) (math/min point new-length)))
      (map (seq/zip points
             (diff/map-lines old new (map points (fn (point) (text/char->line old point)))))
        (fn ([point line])
          (let (column (- point (text/line->char old (text/char->line old point)))
                text (text/line new line)
                ;; the line's own characters: `text/line` keeps its newline
                width (if (string/ends-with? text "\n")
                        (dec (string/length text))
                        (string/length text)))
            (+ (text/line->char new line) (math/min column width))))))))

(defn ed-follow-reread (m i old)
  "The model with pool buffer `i`, which now holds a text re-read from its file, given
back its point and every pane's on it: each moved from where it was in buffer `old` (the
buffer before the re-read) to the same logical line and column of the new text, through
one line diff. A pane's mark is dropped — it named an offset of the old text. What a
revert and a formatter landing share: someone else rewrote the file, and the reader
should still be looking at the line they were on."
  (let (new (ed-buf-at m i)
        points (into [(buffer-point old)]
                 (seq/keep (pane-leaf-paths (:layout m))
                   (fn (path)
                     (let (w (pane-payload-at (:layout m) path))
                       (when (= (:buffer w) i) (:point w))))))
        moved (map/zipmap points (ed-follow-points (buffer-rope old) (buffer-rope new) points)))
    (ed-map-panes (ed-set-buf-at m i (goto-char new (get moved (buffer-point old))))
      (fn (w)
        (if (and (= (:buffer w) i) (not (nil? (:point w))))
          (assoc w :point (get moved (:point w)) :mark nil)
          w)))))

(defn ed-revert-at (m i)
  "Re-read pool buffer `i` from its file, discarding its unsaved changes as ONE undoable
edit (std's `revert-buffer`, keeping the undo list as Emacs's does): C-/ brings back what it
held, unsaved edits and all, and the history before that is still there. It is the same
buffer, so it keeps its name, mode (`:layers`), dir and everything else on it; every pane
on it keeps its point on the same logical line and column (`ed-follow-reread`). The
shared core of `M-x revert-buffer` (the current buffer) and the idle beat's auto-revert
(any buffer another writer changed). Raises if the file cannot be read — the callers
report."
  (let (b (ed-buf-at m i))
    (when (nil? (buffer-file b)) (error "revert: buffer " (buffer-name b) " has no file"))
    (ed-follow-reread (ed-set-buf-at m i (revert-buffer b)) i b)))

;; ---- files that change under the editor ------------------------------------
;; Another writer — a formatter, `git checkout`, a build step, a colleague's editor —
;; rewrites a file this editor has open. Emacs's answer is two-fold: `auto-revert` reloads
;; a buffer with no unsaved changes, and a buffer WITH changes is protected: the save
;; asks before overwriting the other writer's work. The knowledge of "changed since we
;; last agreed" lives in `std/editor/buffer` (`:file-mtime`, `buffer-file-changed?`);
;; this is the policy over it, run on the idle beat so it costs a keystroke nothing.

;; Asking the disk is a stat per buffer, and the idle beat follows every pause in typing: a
;; session with a hundred files open paid a hundred stats each time. So a beat asks about the
;; buffers on SCREEN — the ones a stale text would mislead you in right now — and the rest take
;; turns, a few every `*auto-revert-interval-ms*` (Emacs's `auto-revert-interval`), never more
;; than `*auto-revert-max-per-beat*` stats in all. A buried buffer is still reverted; within a
;; few rounds rather than on the next beat, and certainly before it is shown again.

(def *auto-revert-interval-ms* 5000)
(def *auto-revert-max-per-beat* 8)

(defn- ed-file-buffer? (m i)
  ;; a file edited as root (sudoedit) is left alone, as Emacs's auto-revert leaves a remote
  ;; file: re-reading it needs sudo, and a password nobody asked for
  (let (b (ed-buf-at m i)) (and (not (nil? (buffer-file b))) (not (= true (:sudo b))))))

(defn ed-auto-revert-candidates (m now-ms)
  "`[indices model']`: the pool indices of the file buffers this beat asks the disk about, at
most `*auto-revert-max-per-beat*` — every one shown in a pane, then, once per
`*auto-revert-interval-ms*`, the next of the rest in turn from `:auto-revert-cursor` (wrapping
round the pool). `model'` carries the cursor moved past the ones taken and the round's time
(`:auto-revert-at`)."
  (let (layout (:layout m)
        size (count (:buffers m))
        shown (seq/distinct (seq/filter (map (pane-leaf-paths layout)
                                          (fn (path) (:buffer (pane-payload-at layout path))))
                              (fn (i) (and (int? i) (< i size) (ed-file-buffer? m i)))))
        visible (take shown *auto-revert-max-per-beat*)
        room (- *auto-revert-max-per-beat* (count visible))
        due? (>= (- now-ms (or (:auto-revert-at m) 0)) *auto-revert-interval-ms*))
    (if (or (not due?) (<= room 0) (= size 0))
      [visible m]
      (let (start (math/mod (or (:auto-revert-cursor m) 0) size)
            ;; one lap of the pool at most, from the cursor
            [hidden next] (fold (range size)
                            [[] start]
                            (fn (acc step)
                              (let ([taken cursor] acc
                                    i (math/mod (+ start step) size))
                                (if (or (>= (count taken) room)
                                      (includes? visible i)
                                      (not (ed-file-buffer? m i)))
                                  (if (>= (count taken) room) acc [taken (inc i)])
                                  [(conj taken i) (inc i)])))))
        [(append visible hidden) (assoc m :auto-revert-cursor next :auto-revert-at now-ms)]))))

(defn- ed-revert-if-changed (m i)
  "Pool buffer `i` checked against its file: reverted when it is clean, warned about when it
is not (see [[ed-revert-changed-files]]), unchanged when the disk agrees."
  (let (b (ed-buf-at m i)
        f (buffer-file b))
    (if (or (nil? f) (not (buffer-file-changed? b)))
      m
      (let (now (file/mtime f))
        (cond
          (not (buffer-modified? b))
            (try
              (message (ed-revert-at m i) (str "reverted " f " (changed on disk)"))
              (catch e
                (do
                  (log/warn (str "auto-revert of " f " failed: " (error-message e)))
                  m)))
          (= (:disk-warned b) now) m
          else
            (message (assoc m :buffers (assoc (:buffers m) i (assoc b :disk-warned now)))
              (str f " changed on disk — save will ask; M-x revert-buffer to reload")))))))

(sig ed-revert-changed-files (model -> model))
(defn ed-revert-changed-files (m)
  "For the file buffers this beat asks about ([[ed-auto-revert-candidates]]: the ones on
screen, and the rest in turn) whose file was written since it last agreed with the buffer
(`buffer-file-changed?`): a buffer with NO unsaved changes is reverted in place (Emacs
`global-auto-revert-mode`) with a note in the echo area; one WITH unsaved changes is left
alone and warned about once per on-disk version (`:disk-warned` remembers the mtime told
about), since `cmd-save` will ask before overwriting. A revert that fails (the file
unreadable now) is logged and skipped. Runs on the idle beat."
  (let ([indices stepped] (ed-auto-revert-candidates m (os/now)))
    (fold indices stepped ed-revert-if-changed)))

;; ---- registration: both ride the idle beat, after the launches ----------------------
;; Neither arms the beat (no `:stale?`) — an edit does, and the sidecars and the disk check
;; follow it once typing settles: the sidecar is written, then files another writer changed
;; are reverted (the clean ones) or warned about (the rest).
(register-idle-job :auto-save {:order 110 :run 'autosave/ed-auto-save!})
;; …and a timer of its own, so the round after the last edit runs without another key
(register-timer-client :auto-save 'autosave/ed-auto-save-timer 'autosave/ed-auto-save!)
(register-idle-job :auto-revert {:order 120 :run 'autosave/ed-revert-changed-files})
