(defmodule lang-web
  "JavaScript, TypeScript, TSX, CSS and HTML: tree-sitter modes. TypeScript extends JavaScript's
spec and TSX TypeScript's, so the three stay together; an HTML page carries the others."
  (:use language-core))

;; ---- JavaScript, TypeScript and TSX -----------------------------------------------------
;; Rust's shape (src/lang-systems.blsp) again: a face table, the `{`-delimited nodes as `:brackets`, the
;; definitions C-M-a stops at (Emacs's *-ts-mode defun types), and the column-0 restart.
;; Each names where its grammar lives, so `M-x grammar-install` can fetch it.
;;
;; A matched node is painted whole (`editor/treesit/fontify` stops there), so a template
;; string colours its `string_fragment`s rather than itself — what is inside `${…}` stays
;; code.

(def js-face-table
  {:comment :syntax/comment
   :hash_bang_line :syntax/comment
   :string :syntax/string
   :string_fragment :syntax/string
   :escape_sequence :syntax/string
   :regex :syntax/string
   :number :syntax/number
   :true :syntax/constant
   :false :syntax/constant
   :null :syntax/constant
   :undefined :syntax/constant
   :decorator :syntax/special
   ;; named nodes, so the anonymous-keyword rule never sees them
   :this :syntax/keyword
   :super :syntax/keyword
   ;; a called function and a defined one (brood ADR-486), and a method call's name —
   ;; `console.log`'s `log`, told from a plain property read by its grandparent (ADR-487)
   {:field :function :kind :identifier} :syntax/function
   {:kind :property_identifier
    :field :property
    :parent {:kind :member_expression :field :function}} :syntax/function
   ;; a constructor called with `new` is a call head like any other — `new Shape(3)` reads as
   ;; Python's `Shape(3)` does — and so is `new geo.Shape(3)`'s `Shape`
   {:parent :new_expression :field :constructor :kind :identifier} :syntax/function
   {:kind :property_identifier
    :field :property
    :parent {:kind :member_expression :field :constructor}} :syntax/function
   {:parent :function_declaration :field :name} :syntax/definition
   {:parent :generator_function_declaration :field :name} :syntax/definition
   {:parent :method_definition :field :name} :syntax/definition})

(def ts-face-table
  (merge js-face-table
    {:type_identifier :syntax/special
     :predefined_type :syntax/special
     :literal_type :syntax/special}))

(def js-indent-spec
  {:width 2
   :blocks #{}
   ;; a `case`'s statements sit one deeper than the `case`, which sits one deeper than
   ;; the `switch` — the body is a bracket, and so is each case
   :brackets #{:statement_block
               :class_body :object :array :arguments :formal_parameters :switch_body
               :switch_case :switch_default :object_pattern :array_pattern
               :parenthesized_expression :named_imports :export_clause :template_substitution
               :jsx_element :jsx_opening_element :jsx_self_closing_element}
   ;; a JSX closing tag leaves its element the way `}` leaves a block
   :dedent #{"</"}})

;; the JSX nodes: JavaScript's grammar parses JSX in any file, TypeScript's only in `.tsx`
(def- jsx-brackets #{:jsx_element :jsx_opening_element :jsx_self_closing_element})

;; TypeScript's grammar has no JSX — naming its nodes there named nothing the grammar has
;; (`grammarcheck` found them) — so plain TypeScript drops them and TSX puts them back
(def ts-indent-spec
  (assoc js-indent-spec
    :brackets
      (into (set/difference (get js-indent-spec :brackets) jsx-brackets)
        #{:interface_body :enum_body :object_type :type_arguments :type_parameters})))

(def tsx-indent-spec
  (assoc ts-indent-spec :brackets (into (get ts-indent-spec :brackets) jsx-brackets)))

(def js-restart-rule
  {:item-start "^((export|import|function|class|const|let|var|async|interface|type|enum|declare|abstract|namespace|module)\\b|//|@|\\})"
   ;; a block comment or a template string — either may hold anything, column 0 included
   :opaque "/\\*|`"})

(def js-definitions
  {:kinds #{:function_declaration
            :generator_function_declaration :class_declaration
            :method_definition :lexical_declaration}})

(def ts-definitions
  {:kinds (into (get js-definitions :kinds)
            #{:interface_declaration
              :type_alias_declaration :enum_declaration :abstract_class_declaration :module})})

(deflanguage javascript
  {:lang :javascript
   :pairs *backtick-pairs*
   :strings *js-strings*
   :pattern "\\.(js|mjs|cjs|jsx)$"
   :faces js-face-table
   :indent js-indent-spec
   :restart js-restart-rule
   :format ["prettier" "--write" "--log-level" "warn"]
   :definitions js-definitions
   :grammar {:url "https://github.com/tree-sitter/tree-sitter-javascript"
             :revision "58404d8cf191d69f2674a8fd507bd5776f46cb11"
             :fingerprint "7c519b8797cca8faf6462c020da641f9a86346499e686ae93a1c01099b84240a"}
   :comment "// "})

;; TypeScript is JavaScript's spec with its own grammar, faces, indent and definitions; TSX is
;; TypeScript's with the JSX grammar — the formatter, restart rule and comment come along
(deflanguage typescript
  (merge javascript-spec
    {:lang :typescript
     :pattern "\\.(ts|mts|cts)$"
     :faces ts-face-table
     :indent ts-indent-spec
     :definitions ts-definitions
     :grammar {:url "https://github.com/tree-sitter/tree-sitter-typescript"
               :subdir "typescript"
               :revision "75b3874edb2dc714fb1fd77a32013d0f8699989f"
               :fingerprint "0e9b9ffa6fbab47b509a6434eab282d6b65c7e5d10b568273fe747eefe8c6f04"}}))

(deflanguage tsx
  (merge typescript-spec
    {:lang :tsx
     :pattern "\\.tsx$"
     :indent tsx-indent-spec
     :grammar {:url "https://github.com/tree-sitter/tree-sitter-typescript"
               :subdir "tsx"
               :revision "75b3874edb2dc714fb1fd77a32013d0f8699989f"
               :fingerprint "6cf509e3db5f0618e73debada04c2f2b511d34bc6437f0aa76909caa7beb03a1"}}))

;; ---- the web: CSS and HTML -------------------------------------------------------------
;; tree-sitter-css and tree-sitter-html, Emacs's css-ts-mode and html-ts-mode. An HTML page
;; carries the other two: a `<style>` element's text is CSS and a `<script>`'s is
;; JavaScript (brood ADR-489), each coloured with its own mode's table — and with HTML's
;; when that language's grammar is not installed.

;; A rule's selectors read as the heading of what follows, as a TOML table's header does,
;; so a tag, class, id, pseudo-class and the `&` / `*` selectors are functions; a property
;; is a symbol, as a JSON key is. An at-rule's `@media` is an ANONYMOUS token beginning
;; with `@`, which the keyword rule (a token beginning with a letter) cannot see — named
;; here, as C's `#include` is; an at-rule the grammar does not know is an `at_keyword`.
(def css-face-table
  (merge
    {:comment :syntax/comment
     :js_comment :syntax/comment
     :string_value :syntax/string
     :integer_value :syntax/number
     :float_value :syntax/number
     :color_value :syntax/number
     :important :syntax/special
     :property_name :syntax/symbol
     :feature_name :syntax/keyword
     :at_keyword :syntax/keyword
     :function_name :syntax/function
     :tag_name :syntax/function
     :nesting_selector :syntax/function
     :universal_selector :syntax/function
     ;; `.card` and `#main` whole — their `.` and `#` belong to the name
     :class_selector :syntax/function
     :id_selector :syntax/function
     :class_name :syntax/function
     :keyframes_name :syntax/function
     (keyword "::") :syntax/function
     {:parent :pseudo_class_selector :kind (keyword ":")} :syntax/function
     :attribute_name :syntax/special
     :from :syntax/special
     :to :syntax/special}
    (token-faces ["@import" "@media" "@charset" "@namespace" "@keyframes" "@supports" "@scope"]
      :syntax/keyword)))

;; Two columns, a level per `{ … }` and per bracketed argument list; a declaration continued
;; on the next line (a long `font-family:` list) indents its continuation, as prettier does.
(def css-indent-spec
  {:width 2
   :blocks #{}
   :brackets #{:block
               :declaration :keyframe_block_list :arguments :feature_query
               :parenthesized_query :selector_query}
   :dedent #{}
   ;; while a rule is being typed nothing parses, and a line ending in an opener is the one
   ;; hint left that the next line goes a level deeper
   :opens #{"{" "("}})

(deflanguage css
  {:lang :css
   :pairs *quote-pairs*
   :strings *css-strings*
   :pattern "\\.css$"
   :faces css-face-table
   :indent css-indent-spec
   ;; a selector, an at-rule or a closing brace starts at column 0; a block comment above
   ;; may hold anything there
   :restart {:item-start "^([A-Za-z.#@:*&\\[]|\\})" :opaque "/\\*"}
   :format ["prettier" "--write" "--log-level" "warn"]
   ;; css-ts-mode's: C-M-a to the rule point is in
   :definitions {:kinds #{:rule_set :media_statement :keyframes_statement :supports_statement}}
   :grammar {:url "https://github.com/tree-sitter/tree-sitter-css"
             :revision "dda5cfc5722c429eaba1c910ca32c2c0c5bb1a3f"
             :fingerprint "36f8b0ad8eae92fe9f2953e95e7eb5a2cd27b2c3e8d98740dd9965ac10996065"}
   ;; no line comment: M-; writes a prefix only, and a `/*` with no `*/` comments out the
   ;; rest of the file. `:comment-block` is the pair, for when M-; can wrap a line in one
   :comment-block ["/* " " */"]})

;; heex's table, which is HTML's with components: a tag name a keyword, an attribute's name
;; special, its value a string; the doctype and a character entity specials
(def html-face-table
  {:comment :syntax/comment
   :doctype :syntax/special
   :tag_name :syntax/keyword
   :erroneous_end_tag_name :syntax/keyword
   :attribute_name :syntax/special
   :quoted_attribute_value :syntax/string
   :attribute_value :syntax/string
   :entity :syntax/special})

;; An element is a level and its closing tag backs out of it, as HEEx's and JSX's do; a tag
;; whose attributes run over several lines indents them. A `<style>` or `<script>` body is
;; another language's text, kept where its writer put it (`:verbatim`), as a heredoc is.
(def html-indent-spec
  {:width 2
   :blocks #{}
   :brackets #{:element :style_element :script_element :start_tag :self_closing_tag}
   :dedent #{"</"}
   :opens #{}
   :verbatim #{:raw_text :comment}})

;; the text of a `<style>` is CSS and of a `<script>` JavaScript — the element's `raw_text`,
;; whatever its `type` (a `type="module"` script is JavaScript too)
(def html-injections
  [{:content {:kind :raw_text :parent :style_element} :lang :css}
    {:content {:kind :raw_text :parent :script_element} :lang :javascript}])

(deflanguage html
  {:lang :html
   :pairs *quote-pairs*
   :strings *html-strings*
   :pattern "\\.(html|htm|xhtml)$"
   :faces html-face-table
   :indent html-indent-spec
   ;; no :restart — a column-0 `<` line may be inside a `<script>`, a `<pre>` or a comment,
   ;; and nothing on the line says which
   :injections html-injections
   :format ["prettier" "--write" "--log-level" "warn"]
   ;; html-ts-mode's: C-M-a to the element point is in
   :definitions {:kinds #{:element :style_element :script_element}}
   :grammar {:url "https://github.com/tree-sitter/tree-sitter-html"
             :revision "73a3947324f6efddf9e17c0ea58d454843590cc0"
             :fingerprint "a4d05e56b97241dc241f36262d37aa45638dd480895ebc1a33b86611cee77d2d"}
   ;; a block comment only, as CSS's (`:comment-block`)
   :comment-block ["<!-- " " -->"]})
