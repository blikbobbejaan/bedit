(defmodule whichkey
  "C-h after a prefix: the which-key panel's PAGING menu (Emacs which-key's
`which-key-C-h-dispatch`). A pending prefix whose own keymap does not bind `C-h` takes it as
a menu over the continuations: `n` the next page, `p` the previous one, `u` takes the last
key of the chord back, `h` lists every binding under the prefix in *Help* (Emacs's
`describe-prefix-bindings`), `a` / `C-g` abort. Any other key leaves the menu and goes to the
prefix, so the chord still completes — `C-x C-h n C-f` pages once, then finds a file.

The page lives on the model as `:which-key-page` `{:chord :page}`, tied to the chord it was
turned for: a chord that moves on starts at its first page with no bookkeeping. The panel
lays the pages out (`echoarea/ed-which-key-columns`), so the index here is unbounded and
wraps there."
  (:use keyhelp :only [ed-keys-label ed-cmd-label ed-cancel-key?]) ; the labels the panel shows
  (:use userkeys :only [ed-key-binding]) ; what a chord's first key is bound to, for `u`
  (:use pool :only [ed-show-named])) ; `h`'s *Help* buffer

(def *paging-menu*
  ;; what the echo row says while the menu waits for its key
  "[n]ext page  [p]revious page  [u]ndo key  [h]elp  [a]bort")

(defn help-key? (m input)
  "Whether `input` opens the paging menu: `C-h` with a
prefix pending whose keymap leaves `C-h` free — a prefix that binds it (`C-c @ C-h`, the
help map's own `C-h C-h`) keeps its binding."
  (let (pending (:pending m))
    (and (= input :ctrl-h) (map? pending) (nil? (get pending :ctrl-h)))))

(defn- chord-echo (m) (str (ed-keys-label (or (:chord m) [])) "-"))

(defn open-paging (m)
  "The model with the paging menu open: the panel shown at once (no idle delay — the user
asked for it) and the echo row naming the menu's keys."
  (assoc m
    :which-key true
    :which-key-paging true
    :echo (str (ed-keys-label (conj (vec (or (:chord m) [])) :ctrl-h)) "-  " *paging-menu*)))

(defn page (m)
  "The page of the panel to show for the pending chord: the turned page when it was turned
for this chord, else 0."
  (let (turned (:which-key-page m))
    (if (and turned (= (:chord turned) (:chord m))) (:page turned) 0)))

(defn- turn (m step)
  (assoc (dissoc m :which-key-paging)
    :which-key-page {:chord (:chord m) :page (+ (page m) step)}
    :echo (chord-echo m)))

(defn- end-chord (m)
  (dissoc (assoc m :pending nil :chord []) :which-key :which-key-paging :which-key-page))

(defn- abort (m) (assoc (end-chord m) :echo "Quit"))

(defn- undo-key (m)
  "The chord with its last key taken back (which-key's `u`): the keymap the shorter chord
reaches is pending again; a one-key chord has nothing to go back to, so it ends."
  (let (chord (vec (or (:chord m) [])))
    (if (<= (count chord) 1)
      (abort m)
      (let (shorter (vec (take chord (dec (count chord))))
            keymap (fold (rest shorter)
                     (ed-key-binding m (first shorter))
                     (fn (keymap key) (when (map? keymap) (get keymap key)))))
        (if (map? keymap)
          (assoc (dissoc m :which-key-paging)
            :pending keymap
            :chord shorter
            :echo (str (ed-keys-label shorter) "-"))
          (abort m))))))

(defn- binding-rows (keymap keys)
  "Every `[keys command]` under `keymap`, its sub-keymaps walked, each sequence after `keys`."
  (mapcat (%map-pairs keymap)
    (fn ([key binding])
      (let (sequence (conj keys key))
        (if (map? binding) (binding-rows binding sequence) [[sequence binding]])))))

(defn prefix-bindings-text (keymap chord)
  "The *Help* text listing every binding under prefix `chord` (pending `keymap`), sorted,
the key column aligned — Emacs's `describe-prefix-bindings`."
  (let (rows (sort (map (binding-rows keymap (vec chord))
                     (fn ([sequence binding]) [(ed-keys-label sequence) (ed-cmd-label binding)])))
        width (fold rows 0 (fn (widest row) (math/max widest (string/display-width (first row))))))
    (str "Key bindings starting with "
      (ed-keys-label chord)
      ":\n\n"
      (string/join (map rows
                     (fn ([label command]) (str (string/pad-right-cells label width) "   " command)))
        "\n")
      "\n")))

(defn- describe-prefix (m)
  (let (text (prefix-bindings-text (:pending m) (or (:chord m) [])))
    (ed-show-named (end-chord m) "*Help*" text :help)))

(defn paging-key (m input)
  "The paging menu's answer to `input`: the next model, or nil when `input` is no menu key —
the caller then closes the menu and dispatches it to the pending prefix."
  (cond
    (= input "n") (turn m 1)
    (= input "p") (turn m -1)
    (= input "u") (undo-key m)
    (or (= input "h") (= input :ctrl-h)) (describe-prefix m)
    (or (= input "a") (ed-cancel-key? input)) (abort m)
    else nil))
