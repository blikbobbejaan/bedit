(defmodule results
  "**The results-buffer abstraction** — the one shared foundation behind every read-only
report buffer whose rows name a source location: `*Tests*`, `*Run*`, `*compilation*`,
`*Occur*`, `*git-status*`. Three concerns, all app-agnostic (no command, no pane/pool
navigation — that stays in the editor's command layer, which *consumes* this):

  1. **Location vocabulary** — parse a `file:line[:col]` out of a report row (`loc-at-line`)
     and resolve the location a row links to, walking up to the nearest one above for a
     row that names none (`line-link-loc`). A mode with OFF-text locations (a test runner
     storing them by line) overrides the `:line-loc` service; the default reads the text.
     This one predicate drives the jump, the pointer cursor, and the hover underline alike.

  2. **The layer** — `location-jump-layer`: stack it on any results buffer and every
     location row becomes navigable (RET / click → `commands/cmd-visit-location`, resolved
     late by symbol so this module needn't depend on the command layer). Read-only + the
     `:line-loc` contract is all a consumer needs; an unusual row shape just overrides
     `:line-loc`.

  3. **Streaming** — `ed-append-follow`: append a line to a report buffer and follow the
     tail in any pane already at the bottom (Emacs `compilation-scroll-output`), never
     yanking a pane the reader scrolled up. The shared append behind live `*Tests*`/`*Run*`.

Consumers (`testrun`/`apprun`/`compile`/`modes`' occur+git) stack the layer, override
`:line-loc` if needed, and stream through `ed-append-follow`. The navigation *command*
(`cmd-visit-location` in `commands` → `pool/ed-pop-to-file`, pane/pool-coupled) uses
this layer's vocabulary — the app-specific half, kept out of the abstraction."
  (:use statusbar :only []) ; its chip registers at load, after statusbar is there
  (:use model) ; ed-mode-service / ed-append-named / ed-buf-at / ed-buffer-index-by-name
  (:use editor/buffer) ; buffer-line-at / buffer-line-count — read a row's text / length
  (:use editor/keymap) ; keymap-bind — the RET binding on the jump keymap
  (:use panes) ; ed-body-layout / ed-pane-vrows / ed-pane-top — find + measure the panes
  (:use editor/pane) ; pane-update-path — scroll the pane that follows the tail
  (:use ansicolor :only [faces carriage]) ; a stream's ANSI colours as text properties on what it appended, its returns done
  (:use memo)) ; defmemo — the findings chip's counts, asked every frame while nothing changes
;; ---- location vocabulary: parse a row → a source location -------------------

;; ONE parser for "where in which file", used by every results buffer (RET / click) AND by
;; M-x compile's next-error. There used to be two — a split-on-`:` token parser here and a
;; regexp table in `compile` — and they disagreed: a Python `File "x", line 12` row jumped
;; with C-x ` but not with RET, and the table read `http://localhost:4000` as line 4000 of
;; `//localhost`. Now it is the table, behind this module's file-token guard.
;;
;; The Emacs-style table: each row a regexp and which capture group is FILE, LINE, COL.
;; Teaching the editor a new tool is adding a row. The order is the priority: a `-->` line
;; also contains `file:line:col`, and a Python traceback must be read before anything hunts
;; for colons in it. The file group is spelled `[^\s:()]*[^\s:()\d][^\s:()]*` — path
;; characters, at least one not a digit — so a bare `12:34:56` is not line 34 of `12` —
;; after an optional Windows drive (`C:\src\a.c:12:5:`, `C:/src/a.c:12`), whose colon a
;; path character class would otherwise read as the separator.

(def *error-patterns*
  [{:name :rust
    :pattern "--> +((?:[A-Za-z]:[\\\\/])?[^\\s:]+):(\\d+):(\\d+)"
    :file 1
    :line 2
    :col 3}
    ;; python traceback:   File "app.py", line 12, in foo
    {:name :python :pattern "File \"([^\"]+)\", line (\\d+)" :file 1 :line 2 :col nil}
    ;; gcc / clang / mix / elixir / brood:   path:12:5: message
    {:name :gnu
     :pattern "((?:[A-Za-z]:[\\\\/])?[^\\s:()]*[^\\s:()\\d][^\\s:()]*):(\\d+):(\\d+)"
     :file 1
     :line 2
     :col 3}
    ;; the same without a column — ExUnit's `test/foo_test.exs:12`, mix warnings,
    ;; and every `file:line:` message whose next field is prose rather than a number
    {:name :gnu-line
     :pattern "((?:[A-Za-z]:[\\\\/])?[^\\s:()]*[^\\s:()\\d][^\\s:()]*):(\\d+)"
     :file 1
     :line 2
     :col nil}])

(def *extensionless-files*
  ;; build files a compiler names bare — `Makefile:12: *** missing separator`
  ["Makefile" "GNUmakefile" "Dockerfile" "Rakefile" "Gemfile" "Justfile" "Containerfile"])

(defn- loc-file-token? (file)
  "Whether `file` looks like a source path rather than a host / clock field. A path
separator is decisive; a dot counts only when the part after the LAST dot is a
non-empty, non-numeric extension (`foo.blsp` yes; `0.0.0.0`, `127.0.0.1` no — an
all-numeric tail is an IP octet, not an extension); a few build files are named bare.
Guards against `12:34:56` timestamps and `host:port` being read as `file:line` (a red log
line + a jump to a bogus `<root>/12` on click)."
  (and (> (string/length file) 0)
    (or (includes? file "/")
      (includes? file "\\")
      (includes? *extensionless-files* file)
      (let (i (string/last-index-of file "."))
        (and (>= i 0)
          (let (ext (string/substring file (inc i) (string/length file)))
            (and (> (string/length ext) 0)
              (failure? (string/->number ext)))))))))

(defn- loc-group-int (match k)
  "Capture group `k` of `match` as an int, or nil — for a group index that is itself nil
(a pattern with no column), a group that did not participate, or one not a number."
  (when k
    (let (g (nth (get match :groups) (dec k) nil)
          n (when g (string/->number (get g :text))))
      (when (int? n) n))))

(defn- loc-group-text (match k)
  (when k
    (let (g (nth (get match :groups) (dec k) nil))
      (when g (get g :text)))))

(defn- loc-from (pattern line)
  "Apply one `*error-patterns*` row to `line`; `{:file :line :col}` or nil. A row that
matches but yields no usable file or line counts as no match, so the next row still gets
its turn. A column the pattern does not capture is column 1."
  (let (m (regex/find (get pattern :pattern) line))
    (when m
      (let (file (loc-group-text m (get pattern :file))
            ln (loc-group-int m (get pattern :line)))
        (when (and file ln (loc-file-token? file))
          {:file file :line ln :col (or (loc-group-int m (get pattern :col)) 1)})))))

(defn- loc-first (patterns text)
  (when (not (empty? patterns))
    (or (loc-from (first patterns) text) (loc-first (rest patterns) text))))

(defn loc-at-line (line)
  "Parse a `file:line[:col]` location from a report or compiler row — the first
`*error-patterns*` row that matches it — or nil when the row names none. URLs are taken out
first: `http://localhost:4000` is a server announcing itself, not line 4000 of a file."
  (let (text (regex/replace "[a-zA-Z][a-zA-Z0-9+.-]*://\\S*" (or line "") " "))
    (loc-first *error-patterns* text)))

(defn default-line-loc (buf line0)
  "The default `:line-loc` service — parse `file:line[:col]` from the line's TEXT
(`loc-at-line`). A mode with off-text locations (a test runner storing them by line)
provides its own `:line-loc (buf line0) -> loc`."
  (loc-at-line (buffer-line-at buf line0)))

(defn line-loc-service (buf)
  "The buffer's `:line-loc` service (`(buf line0) -> {:file :line :col}|nil`), or the
default text parser. THE seam a results mode implements to become link-navigable."
  (or (ed-mode-service buf :line-loc) default-line-loc))

(defn line-links-loc (buf line0)
  "A `:line-loc` for a results buffer that stores its row→location map OFF-text in `:line-links`
(0-based line → `{:file :line :col}`) — the ONE mechanism `*Tests*` and `*git-status*` share:
the visible row stays clean (no file path in the text) while the click / hover / RET resolve
through the map, falling back to the text parser (`default-line-loc`) for a row not in it. A mode
becomes link-navigable by (1) stashing `:line-links` on its buffer and (2) setting
`:line-loc 'results/line-links-loc`."
  (or (get (:line-links buf) line0)
    (default-line-loc buf line0)))

(defn line-links-only-loc (buf line0)
  "A `:line-loc` that reads `:line-links` and NOTHING else — for a buffer whose map is
complete, so a row missing from it is not a link. *git-status* is one: its files are the
map, and the rest is commit subjects and diff lines, where a text parse finds a
`file:line` that is somebody's prose (`fix foo.c:12`) and is also a regex run over every
visible row of every frame."
  (get (:line-links buf) line0))

(defn line-link-loc (buf line0)
  "The source location line `line0` links to, or — when it names none — the nearest
one on a line ABOVE it (bounded 40): so a test's indented output/detail lines link
to the test row above them. Drives BOTH the jump and the hover/cursor affordance."
  (let (svc (line-loc-service buf))
    (letrec (go (fn (i limit)
                  (cond
                    (or (< i 0) (<= limit 0)) nil
                    else
                      (let (loc (svc buf i))
                        (if (nil? loc) (go (dec i) (dec limit)) loc)))))
      (go line0 40))))

(defn ed-link-at-point (m)
  "The source location the current line of the current buffer links to (a results
buffer's `:line-loc`, resolved for indented detail lines like the click does), or nil
for an ordinary buffer / a non-link line. What M-w copies with no region, and what
enables the context menu's Copy."
  (let (buf (ed-current-buf m))
    (when (ed-mode-service buf :line-loc)
      (line-link-loc buf (buffer-current-line buf)))))

;; ---- the layer: read-only + navigable location rows -------------------------
;; Any report buffer whose rows name source locations stacks this: RET and a mouse click
;; both visit the row's location (`commands/cmd-visit-location`, resolved late by symbol),
;; parsed by the mode's `:line-loc` service or the standard `file:line[:col]:` shape, and
;; every clickable line gets a pointer cursor + a subtle hover highlight (the view reads
;; `:line-loc`). A mode with off-text locations overrides `:line-loc`; everyone else needs
;; nothing but to stack the layer.

(def location-jump-keymap
  (-> {}
    (keymap-bind [:enter] 'commands/cmd-visit-location)))

(def location-jump-layer
  {:name 'location-jump
   :keymap location-jump-keymap
   :on-click 'commands/cmd-visit-location
   :line-loc 'results/default-line-loc
   :commands '("visit-location")})

;; ---- streaming: append + follow the tail ------------------------------------

(defn- ed-follow-tail (m idx old-lines cols rows)
  "Scroll every pane showing pool buffer `idx` that was at the BOTTOM before an append
(its line count then = `old-lines`, and its viewport reached that last line) down to the
new last line — so streamed output stays in view (Emacs `compilation-scroll-output`)
without yanking a pane the user has scrolled UP to read. No-op unless `:scroll-output`."
  (if (not (:scroll-output m))
    m
    (let (buf (ed-buf-at m idx)
          new-lines (buffer-line-count buf))
      (fold (:panes (ed-body-layout m cols rows))
        m
        (fn (mm pane)
          (let (vrows (ed-pane-vrows pane buf))
            (if (and (= (map/get-in pane [:payload :buffer]) idx)
                  (>= (+ (ed-pane-top pane buf) vrows) old-lines))
              ; was showing the old last line
              (assoc mm
                :layout
                  (pane-update-path (:layout mm)
                    (:path pane)
                    (fn (w) (assoc w :top (math/max 0 (- new-lines vrows))))))
              mm)))))))

(defn ed-append-follow (m nm s cols rows &optional spans)
  "Append `s` to buffer `nm` (`ed-append-raw`) then follow the tail in any pane already
at its bottom (`ed-follow-tail`) — the streaming-output append shared by *Tests* / *Run*.
Falls back to a plain append when no pane shows the buffer. `spans` — the ANSI colours of
`s` as `ansicolor/decode` gives them, from its start — come with the appended text as its
`:ansi` text property (`ansicolor/faces`), and a carriage return in it rewrites the line as a
terminal would (`ansicolor/carriage`). Then the buffer keeps only its newest lines
(`ed-cap-output-at`): AFTER the follow, which compares a pane against the line count before
the append, and the cut moves every pane up with the text it shows; the colours go with
their text."
  (let (idx0 (ed-buffer-index-by-name m nm)
        before (when idx0 (ed-buf-at m idx0))
        old-lines (if (nil? before) 0 (buffer-line-count before))
        ;; a line from a line-buffered stream: its returns rewrite it (`10%\r20%` shows `20%`)
        [_ line line-spans] (carriage s (or spans []))
        m1 (ed-append-raw m nm line (faces line-spans))
        idx (ed-buffer-index-by-name m1 nm))
    (if (nil? idx) m1 (ed-cap-output-at (ed-follow-tail m1 idx old-lines cols rows) idx))))

;; ---- diagnostics: the findings a buffer carries ---------------------------------

(defn diagnostic-error? (d)
  "Is this finding something that will not compile, as opposed to an advisory?

An LSP server says so with `:severity 1`; Brood's checker says so in the message. One
predicate, because the margin glyph and the pane's row both have to make the same call —
a line marked ⚠ whose row reads ✗ is the margin and the list disagreeing about the same
finding."
  (or (= (:severity d) 1)
    (= (:severity d) :error)
    ;; the word, for a producer that only writes it into the message
    (string/starts-with? (or (:message d) "") "error: ")
    (includes? (or (:message d) "") "does not compile")))

(defn diagnostic-lines (buf)
  "The findings anchored on `buf` as `{0-based line -> (list diagnostic)}`, or `{}` when it
carries none or they no longer describe the text (`annotate`'s `:current?`).

THE reader for diagnostics — the margin and the `*Diagnostics*` pane both come here, so a
finding can never be in one and not the other. It is a buffer annotation rather than the
model's `:diagnostics` for two reasons: the gutter's cell cache is keyed on the buffer, and
the model holds ONE list while the findings belong to the particular buffer they were
computed from (`diagstore/ed-set-diagnostics` stamps only that one)."
  (let (a (editor/buffer/annotation buf :diagnostic-lines))
    (if (and a (:current? a)) (or (:value a) {}) {})))

;; ---- the findings chip on the mode line ---------------------------------------
;; FINDINGS: `✗ 2 ⚠ 5`, clickable. The margin can only mark lines that are on screen, so a
;; file with one error forty lines down looks exactly like a clean one; the count is the
;; part of the answer that does not fit in a margin. Read through `diagnostic-lines` — the
;; same annotation the margin reads, so the bar and the marks cannot disagree. It lives
;; here, off the buffer's own annotation, rather than in `diagnostics`: the bar is drawn
;; every frame and must not load a deferred module to do it (the same rule the
;; attached-node chip follows). `diagnostics` owns the PANE; only the click loads it.

(defn ed-diagnostics-counts (buf)
  "`[errors warnings]` for `buf` — what its findings are, by severity."
  (diagnostic-counts-of (diagnostic-lines buf)))

;; check-allow: a hit comes back out of the memo's store, which the checker reads as
;; unknown; the store only ever holds what the body below built, an `[errors warnings]` pair.
(check-allow :trusted
  (defmemo diagnostic-counts-of 4 (by-line)
    "`[errors warnings]` over a `{line -> findings}` index. Remembered on the index itself —
the annotation's own value, the same map every frame until a recheck replaces it — because
the mode line's chip asks for the counts twice a frame (its label and its face) and each
ask walked every finding in the file."
    (let (ds (mapcat (%map-pairs by-line) (fn ([_ v]) v)))
      [(count (seq/filter ds diagnostic-error?)) (count (seq/reject ds diagnostic-error?))])))

(defn ed-diagnostics-checked? (m buf)
  "Is anything actually CHECKING this buffer — a mode's own `:diagnostics` service (the
Brood checker) or a live language server that serves ITS file? A server for another language
checks nothing here, so it earns no `✓`: wos kernel source next to a running brood-lsp is
unchecked, and the chip says so by staying empty. (`lsp` is reached late-bound: it loads on
demand, and before it has, no server is running.)"
  (or (not (nil? (ed-mode-service buf :diagnostics)))
    (not (nil? (reflect/call-if-bound 'lsp/lsp-conn nil m (buffer-file buf))))))

(defn ed-diagnostics-label (m buf)
  "The findings chip — `✗ 2 ⚠ 5`, `✓` for a buffer something checked and found clean, and
`\"\"` when nothing is checking it.

The `✓` is the whole point of the three states. A clean file and a file nobody is looking
at showed the same empty bar, so a language server that had not started, or had started
and never been told the text changed, was indistinguishable from good news — which is
exactly how a broken document sync went unnoticed: `|asfd` in an Elixir buffer, and a bar
with nothing on it. An empty chip now means one thing only: no checker here."
  (let ([errors warnings] (ed-diagnostics-counts buf))
    (cond
      (or (> errors 0) (> warnings 0))
        (string/trim (str (if (> errors 0) (str "✗ " errors " ") "")
                       (if (> warnings 0) (str "⚠ " warnings) "")))
      (ed-diagnostics-checked? m buf) "✓"
      else "")))

(defn ed-diagnostics-face (m buf)
  "Red when something will not compile, amber when it is only advice — the margin's
colours — and the bar's own colour when a checker found nothing: the mode line keeps an accent
for a state that wants attention, and the `✓` says the rest."
  (let ([errors warnings] (ed-diagnostics-counts buf))
    (cond
      (> errors 0) {:fg *red* :bold true}
      (> warnings 0) {:fg *yellow*}
      else {})))

(defn ed-diagnostics-tooltip (m buf)
  "The chip's hover: the counts spelled out, and what a click does."
  (let ([errors warnings] (ed-diagnostics-counts buf))
    (if (and (= errors 0) (= warnings 0))
      ["no errors or warnings" "click for the list (C-c !)"]
      [(str errors
         " "
         (if (= errors 1) "error" "errors")
         ", "
         warnings
         " "
         (if (= warnings 1) "warning" "warnings"))
        "click for the list (C-c !)"])))

(defn diagnostics-segment (m pane buf)
  "The findings chip as a segment; the click loads `diagnostics` and opens its list."
  (statusbar/seg :diagnostics
    (ed-diagnostics-label m buf)
    {:sep "  —  "
     :face (ed-diagnostics-face m buf)
     :on-click 'diagnostics/cmd-diagnostics
     :tooltip (fn (mm) (ed-diagnostics-tooltip mm buf))}))

(statusbar/register-modeline-segment :diagnostics 60 'results/diagnostics-segment)
