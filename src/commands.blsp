;; ---- what the core must know of these commands (`interactive/declare-trait`) ------------
;; a typing run: consecutive repeats amalgamate into one undo step, and their settling arms
;; the undo-pause boundary (`input`, `model/ed-sync-timers`); `:self-insert` is the
;; unbound-printable-key fallback
(interactive/declare-trait :typing
  '(:self-insert typing/cmd-delete-backward
     typing/cmd-electric-backspace typing/cmd-delete-char typing/cmd-open-delimiter
     typing/cmd-electric-close typing/cmd-close-delimiter))

;; a kill: the next kill appends to its ring entry. Left off this list, a command silently
;; starts a new entry — `M-k M-k` used to leave two sentences on the ring instead of one
(interactive/declare-trait :kill
  '(killing/cmd-kill-region killing/cmd-copy-region
     killing/cmd-kill-line killing/cmd-kill-word killing/cmd-backward-kill-word
     killing/cmd-kill-whole-line killing/cmd-sexp-kill killing/cmd-kill-sentence
     killing/cmd-backward-kill-sentence killing/cmd-kill-sexp killing/cmd-backward-kill-sexp
     killing/cmd-zap-to-char))

;; tap-repeatable (repeat-mode): C-x → then `→ → →` cycles buffers
(interactive/declare-trait :repeat
  '(commands/cmd-next-buffer commands/cmd-previous-buffer
     editing/cmd-repeat))

;; after which the completion popup's auto trigger looks (Corfu's `corfu-auto-commands`):
;; typing and deleting backwards. Moving point is not asking for completion
(interactive/declare-trait :completion-auto
  '(:self-insert typing/cmd-delete-backward typing/cmd-electric-backspace))
