     editing/cmd-open-line-below killing/cmd-open-rectangle region/cmd-pop-jump
     commands/cmd-previous-buffer motion/cmd-previous-line commands/cmd-project-switch-buffer
     search-commands/cmd-query-replace search-commands/cmd-query-replace-regexp
     structural/cmd-raise-sexp motion/cmd-recenter editing/cmd-redo editing/cmd-repeat
     motion/cmd-scroll-down motion/cmd-scroll-up typing/cmd-self-insert indent/cmd-set-fill-column
     region/cmd-set-mark killing/cmd-sexp-kill commands/cmd-shift-motion
