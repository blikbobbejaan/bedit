(defmodule remote
  "Native remote attach — the Emacs `--daemon` / `emacsclient` model for bedit (ADR-090;
see `docs/remote-multiplayer-plan.md`). `ed-serve` runs the editor as a **headless
daemon**: its model / `ed-view` / `ed-update` all live in the serving runtime, and each
attaching frontend gets its own session (a fresh buffer). `ed-attach` opens a native window
and attaches it to a daemon over a Brood node link — the *same* editor, driven from another
terminal or machine. Both are thin wrappers over `std/editor/serve` (the frontend-agnostic
`ui-run` serving seam) — there is no editor-specific wire protocol: the render frame is plain
Brood data and the keys are the same values the local window delivers, so `ed-view`/`ed-update`
run unchanged whether the frontend is local or across a link.

The daemon's model is the pure `ed-init` model (no `gui-display`, no window id): the frame is
rendered here and *painted on the client's* window, so a served session needs nothing GUI-local.
It renders via `ed-view`'s frontend-agnostic path (`:gui` unset), which is correct on any client.

Slice 1 gives each client an **independent** session (its own buffer) — the `serve`
semantics. A private session outlives a dropped window (brood ADR-519): it parks, writes its
sidecars, and the next attach under the same name takes it back. `--shared` (alias `--collab`) builds the collaborative mode on it: each client
its OWN session and OWN cursor, with the *content* of the shared slot backed by one buffer
process ('everyone their own caret' + presence — `src/collab.blsp`); the `follow` command
gives the ride-one-caret pairing view on demand. See `docs/remote-multiplayer-plan.md`."
  (:use editor/ui) ; gui-display — the native window a client attaches
  (:use editor/serve) ; serve / attach-display — the daemon + client seam (ADR-090)
  (:use editor/buffer) ; make-buffer / find-file-buffer / spawn-buffer
  (:use model) ; ed-init — the pure editor model
  (:use view) ; ed-view
  (:use input) ; ed-update
  (:use collab) ; collab-share-slot — hosting + presence for the served buffer
  (:use config) ; init-config — the :share-name participant default
  (:use startup) ; the startup path a served session shares with the window
  (:use editor/buffer-registry) ; registry-start — the shared daemon's file -> process directory
  (:use autosave :only [ed-auto-save-now!]) ; a lost window's buffers written at once
  (:use system)) ; argv — the CLI dispatch reads it
;; ---- CLI dispatch (bedit --name ed --serve  /  bedit --attach ed) -----------
;; `main` scans `(argv)` for these flags and branches to the daemon / client instead of
;; the normal local window. Kept as pure functions here so the arg parsing is unit-tested
;; without launching anything (main is a GUI entry point, untestable headlessly).

(defn- remote-arg-after (args flag)
  "The CLI token following `flag` in the string vector `args`, or nil when `flag` is
absent or is the last token. Reads `--attach NAME` / `--serve [file]` (a tail-recursive
pair scan — no dependence on `index-of` semantics for vectors)."
  (cond
    (< (count args) 2) nil
    (= (first args) flag) (second args)
    else (remote-arg-after (rest args) flag)))

(defn remote-serve? (args)
  "Whether `args` (from `(argv)`) requests daemon mode (`--serve`)."
  (includes? args "--serve"))

(defn remote-attach? (args)
  "Whether `args` (from `(argv)`) requests client mode (`--attach`)."
  (includes? args "--attach"))

(defn remote-shared? (args)
  "Whether `args` modifies `--serve` to a SHARED session: everyone edits the same
buffer, each with their **own** cursor and presence (`--shared`, or its alias
`--collab` — one collaborative mode; use the `follow` command to ride someone's
caret when you want the single-view pairing experience)."
  (or (includes? args "--shared") (includes? args "--collab")))

(defn remote-headless? (args)
  "Whether `args` requests a HEADLESS daemon (`--headless`): serve and park with no local
window (the pure Emacs `--daemon` model — for a machine with no display, or a persistent
background daemon). Without it, `--serve` also opens the host's own window (see `ed-serve-run`)."
  (includes? args "--headless"))

(defn remote-positional (args)
  "The first positional argument (a file path) in `args` — skipping flags (`--x`) AND the
value token of a value-taking flag (`--name` / `--attach` / `--as` / `--listen` / `--cookie` /
`--invite`), and Emacs's `-nw`. So `--serve --shared` and `--serve --shared notes.txt` both parse correctly: nil
and \"notes.txt\" respectively (a bare `--serve` never swallows the following `--shared` as a
filename). nil if none."
  (cond
    (empty? args) nil
    (includes? ["--name" "--attach" "--as" "--listen" "--cookie" "--invite"] (first args))
      (remote-positional (rest (rest args)))
    (or (string/starts-with? (first args) "--") (= (first args) "-nw"))
      (remote-positional (rest args))
    else (first args)))

(defn- remote-node-name (args)
  "The daemon's node name from `--name NAME` in `args`, defaulting to \"bedit\"."
  (or (remote-arg-after args "--name") "bedit"))

(defn- remote-participant (args)
  "This user's display name for collab presence: `--as NAME`, else `:share-name` from
the init file (~/.config/bedit/init.blsp), else the OS username, else \"guest\".
Carried to the daemon as the attach identity (`{:name …}`), where the session announces
it on the shared buffer — name tags and join/leave echoes."
  (or (remote-arg-after args "--as")
    ;; peek, not init-config: attaching to someone's session must not write a default
    ;; config file onto this machine as a side effect of reading one setting
    (config/setting (config/peek-init) :share-name)
    (os/user-name)
    "guest"))

(defn- remote-listen-addr (args)
  "The daemon's TCP listen address from `--listen [HOST:]PORT` — a bare port binds
LOOPBACK (127.0.0.1): reaching the daemon from another machine is a choice you spell,
`--listen 0.0.0.0:PORT`, because a node link is full code execution for whoever holds the
cookie — or nil for the default per-user Unix socket (same machine
only). With `--listen`, machines elsewhere attach as `bedit --attach NAME@HOST:PORT`
(the shared cookie in ~/.config/brood/cookie must match on both ends). Dual-listen: the
per-user Unix socket stays bound too, so local attaches keep the bare-NAME form."
  (let (v (remote-arg-after args "--listen"))
    (cond
      (nil? v) nil
      (includes? v ":") v
      else (str "127.0.0.1:" v))))

(defn- remote-ensure-node (name)
  "Ensure this runtime is a Brood node called `name` so clients can attach to it. `nest run
--name NAME` brings the node up for you, but the standalone `bedit` does not (it passes
`--name` straight through as a program arg), so start the node here whenever we're not yet
one. Always binds the per-user Unix socket (local `bedit --attach NAME` by bare name); with
`--listen [HOST:]PORT` it ALSO listens on TCP (`node-also-listen` — ADR-074 dual-listen,
cookie-authenticated), so remote machines attach as `NAME@HOST:PORT` while local attaches
stay name-only. Idempotent for the node itself; the TCP listener is added even when
`--name` already brought the node up."
  (do
    (when (= (node/name) :nonode)
      (node/start (keyword name)))
    (let (addr (remote-listen-addr (argv)))
      (when addr
        (node/also-listen addr)
        (remote-grant-guests (argv))))))

;; ---- who may attach over TCP: guest grants, not the machine's cookie (ADR-415) -----------
;; A node link authenticated with ~/.config/brood/cookie is every node on this machine, with
;; code execution, for good. A TCP session hands out GUEST cookies instead (brood's
;; `node/grant-guest`): fresh per session, reaching only the session server
;; (`editor/serve/serve-name`) and the session it is given, and refusing any message that
;; carries code. `--invite alice,bob` mints one per person with the name bound, so the
;; server knows who attached rather than taking `--as` on trust.

(defn- remote-fresh-cookie ()
  "A new session cookie: 24 random bytes, hex."
  (encoding/hex-encode-bytes (crypto/random-bytes 24)))

(defn remote-invites (args)
  "The names `--invite alice,bob` asks for, in order — `[]` without the flag."
  (let (v (remote-arg-after args "--invite"))
    (if (nil? v)
      []
      (into [] (seq/filter (map (string/split v ",") string/trim) (fn (name) (not (= name ""))))))))

(defn- remote-grant-guests (args)
  "Grant this session's guest cookies: one anyone you give it to can attach with (they say
who they are), and one per `--invite` name (the name is bound). `{:session cookie :invites
[[name cookie] …]}`, kept for the attach hint."
  (let (names [editor/serve/serve-name]
        session (node/grant-guest (remote-fresh-cookie) {:names names})
        invites (map (remote-invites args)
                  (fn (person)
                    [person (node/grant-guest (remote-fresh-cookie) {:names names :as person})])))
    {:session session :invites invites}))

(defn- remote-attach-hint (name guests)
  "The attach command clients should run: plain NAME over the local Unix socket, or
NAME@HOST:PORT with this session's guest cookie when the daemon listens on TCP (`--listen`;
a 0.0.0.0 bind means 'use this machine's reachable address' — substitute it on the other
end), and one line per `--invite`d person with their own."
  (let (addr (remote-listen-addr (argv)))
    (if (nil? addr)
      (str "bedit --attach " name)
      (let (base (str "bedit --attach " name "@" addr " --cookie "))
        (string/join (cons (str base (:session guests))
                       (map (:invites guests)
                         (fn ([person cookie]) (str "\n    for " person ":  " base cookie))))
          "")))))

(defn remote-main? (args)
  "True when `args` (the CLI tokens `main` received) requested daemon (`--serve`) or client
(`--attach`) mode — `main` hands off to `remote-main` instead of opening a local window."
  (or (remote-serve? args) (remote-attach? args)))

(defn remote-main (args)
  "Run the CLI-requested remote mode from `args`: `--attach NAME` opens a window attached to
daemon NAME; `--serve [file]` runs this runtime as a daemon (add `--shared` — or its alias
`--collab` — for the collaborative session: shared content, a cursor per client; else a
private buffer per client). The optional file is the positional arg (`remote-positional`),
so `--serve --shared notes.txt` opens notes.txt — a flag is never mistaken for the filename.
Precondition: `remote-main?` is true."
  (cond
    (remote-attach? args) (ed-attach (remote-arg-after args "--attach"))
    (remote-shared? args) (ed-serve-collab (remote-positional args))
    else (ed-serve (remote-positional args))))

(def *served-welcome*
  "bedit — served over a Brood node link (the emacsclient / --daemon model).\n\nThis session runs on the daemon; your window just paints its frames and ships keys.\nEach client gets its own buffer. C-x C-c / the window close button detaches.\n")

(defn ed-served-model (buffer file init)
  "A served session's model on `buffer` (opened from `file`, nil for a scratch): prepared
from the daemon's init file as the window's is — `init` is that file as the daemon read it
once at startup (`startup/read-init`, `{:config :note}`), so no session reads it again —
through `startup/prepare-model` (init.blsp's model settings, recentf, save-place), with the
CLIENT's clipboard and PRIMARY selection (`:client-clipboard`, brood ADR-539, ADR-562) — never
the daemon's OS ones
(`:os-clipboard` stays off) — and nothing GUI-local: no `:window`, no `:gui`, because the
frame is rendered here and painted on the client's window. The participant name is the
client's, from its attach identity, so the host's `:share-name` is not seeded. An init file
that did not read says so in the echo area (`:note`), as the window's does. A guest's
session gives up the on-disk memory when its identity arrives (`input/ed-ev-client-opts`)."
  (let (cfg (:config init)
        ;; before `ed-init` stamps the buffer: it reads its .editorconfig then
        _ (prepare-buffer-settings cfg)
        placed (if (and file (setting cfg :save-place)) (saveplace/restore-place buffer) buffer)
        prepared (dissoc (prepare-model (assoc (ed-init placed)
                                          :project-root (launch-project file false)
                                          :client-clipboard true)
                           cfg)
                   :participant)
        unread (:note init))
    (if (nil? unread) prepared (message prepared unread))))

(defn ed-serve-model (file &optional init)
  "The `make-model` thunk for one served session: a fresh editor model, opening `file`
(or a scratch buffer when nil). Called once per attaching client, in the session's own
process (so sessions are independent — Slice 1). With the daemon's read `init` file
(`startup/read-init`) it is the live editor's model ([[ed-served-model]]) and the session's
loop is marked responsive (a native call that blocks it is reported, brood ADR-517); without
one it is the pure `ed-init` model. A file with a line past so-long's threshold opens in the
cheap state (`solong/so-long-checked`)."
  (fn ()
    (let (buffer (if (nil? file)
                   (make-buffer *served-welcome*)
                   (solong/so-long-checked (find-file-buffer file))))
      (if (nil? init)
        (ed-init buffer)
        (do (slowlog/responsive!) (ed-served-model buffer file init))))))

;; ---- a private session outlives its window (brood ADR-519) ------------------------
;; A private session's buffers live in its own model, so when the window went the work
;; went with it. Now a dropped link PARKS the session (std's `serve` with `:resume-ms`):
;; `bedit --attach NAME` again, under the same name, and it is back as it was. Its
;; sidecars are written the moment the link goes, so one nobody returns to loses nothing
;; either — the next visit offers M-x recover-this-file.

(def *served-resume-ms*
  ;; how long a parked session waits for its user: a day, so the laptop that slept
  ;; overnight comes back to its buffers
  (* 24 60 60 1000))

(defn ed-ev-client-lost (m input textrows cols rows)
  "`[:client-lost]`: the window this session served is gone — its client died or the link
dropped — and the session is parked until its user attaches again. Every modified file
buffer's sidecar is written now rather than at the next 30 s round, since the session may
never see another."
  (message (ed-auto-save-now! m) "the window went away — auto-saved; attach again to carry on"))

(defn ed-ev-client-back (m input textrows cols rows)
  "`[:client-back]`: a window attached to this parked session again."
  (message m "attached again — everything as you left it"))

(register-event-handler :client-lost 'remote/ed-ev-client-lost)
(register-event-handler :client-back 'remote/ed-ev-client-back)

(defn ed-served-update (m input cols rows)
  "`ed-update` for a served PRIVATE session. A `:close` there means the window is already
gone — its close button, a detach — so nobody is left to answer `cmd-quit`'s \"Save file?\",
which would hold the session open forever, unseen. Its buffers' sidecars are written and
the session ends. Anything else is `ed-update`'s."
  (if (= input :close)
    (assoc (ed-auto-save-now! m) :done true)
    (ed-update m input cols rows)))

(defn- ed-serve-park ()
  "Park the daemon process forever so the node stays up after `serve` returns (it is
non-blocking). Any message re-parks; the process lives until the runtime is killed.
`hibernate` first: this process genuinely waits (usually forever), so shrink its heap
and drop its caches while it does — the served sessions live in their own processes."
  (proc/hibernate)
  (receive (_ (ed-serve-park))))

(defn- ed-serve-prepare (init file)
  "Prepare this daemon's runtime from its read init file `init` (`startup/read-init`) as the
window prepares its own (`startup`): grammars, the slow-turn log, the colours and `:theme`,
the installed packages — every session renders and parses with them — and the project it
serves (`file`'s, or the working directory's) remembered for C-x p p, as the window
remembers the one it opens on. The colours without a window (`apply-look`): the daemon has
none of its own. Minibuffer history (savehist) only when the daemon listens on no TCP port:
it is one store for the whole runtime, and a TCP daemon hands out guest cookies, whose
sessions must not be offered the owner's past answers. What the init file gets wrong is
printed here, the daemon's console, and the first thing that did not read is in each
session's echo area too."
  (let (cfg (:config init))
    (prepare-runtime cfg (nil? (remote-listen-addr (argv))))
    (let (warning (apply-look cfg false)) (when warning (io/puts (str "  " warning))))
    (projects/remember-project! (launch-project file false))
    (load-packages-later cfg (fn (level line) (io/puts (str "  " line))))))

(defn- ed-window (cfg)
  "A native window for a served session's frames, set up from `cfg` — this machine's init
file: its font, inset and text settings, and its colours, as a local window's
(`startup/configure-window`), and its keyboard (`config/window-options`: which macOS Option
key is Meta, brood ADR-541). With `-nw`, or no display to open a window on, THIS terminal
(`editor/ui/*term-display*`) instead — as the local editor chooses ([[startup/choose-frontend]])."
  (if (= (first (choose-frontend (argv) (display-available?))) :terminal)
    ;; `-nw`, or no display here: the session is drawn in this terminal — the emacsclient
    ;; `-nw` — and what it copies reaches this machine's clipboard through it (brood ADR-587);
    ;; its default face is this machine's palette, as a window's background would be
    (do
      (let (warning (apply-look cfg false)) (when warning (io/puts warning)))
      (theme/use-terminal-look!)
      *term-display*)
    (let (disp (gui-display (config/window-options cfg)))
      (do
        ;; this machine's `:font` not installed here: said on the console it was started from
        (let (font-warning (configure-window cfg disp)) (when font-warning (io/puts font-warning)))
        (let (warning (apply-look cfg true)) (when warning (io/puts warning)))
        disp))))

(defn- ed-serve-run (name cfg)
  "Keep this runtime alive after `serve`/`serve-shared` registered (both are non-blocking).
With `--headless`, park forever — the pure background daemon (`ed-serve-park`). Otherwise open
the operator's OWN window attached to this runtime's session (`attach-display-local` over
`gui-display`), so the host edits in a *visible* window while serving instead of running blind.
Blocks on that window; when the host closes it the runtime exits (use `--headless` for a daemon
that outlives the host window). Needs a GUI-enabled `nest` for the windowed path; a displayless
machine should pass `--headless`."
  (if (remote-headless? (argv))
    (do
      (io/puts "  (--headless: no local window — a background daemon; Ctrl-C to stop.)")
      (ed-serve-park))
    (do
      (io/puts "  opening a local host window — close it to stop serving.")
      ;; the host is a participant too: its window attaches with an identity, so a
      ;; collab session shows the host's name on its caret like anyone else's
      (attach-display-local (ed-window cfg) {:name (remote-participant (argv))}))))

(defn ed-serve (&optional file)
  "Run bedit as a daemon (ADR-090): register a session manager under the node's serve name,
then keep the runtime alive (`ed-serve-run`). Each `ed-attach` (or `nest attach`) gets its own
editor session over the link. By default the host also gets its **own local window** onto a
session (so serving isn't blind); `--headless` skips it (a pure background daemon). The runtime
must already be a node — launch with `bedit --name NAME --serve [file]`. The daemon and its
sessions are prepared from its init file as the window is (`ed-serve-prepare`,
`ed-served-model`). Blocks."
  (let (name (remote-node-name (argv))
        init (read-init))
    (let (guests (remote-ensure-node name))
      (ed-serve-prepare init file)
      (serve (ed-serve-model file init) ed-view ed-served-update {:resume-ms *served-resume-ms*})
      (io/puts (str "bedit daemon '"
                 name
                 "' serving"
                 (if (nil? file) "" (str " " file))
                 " (private buffer per client; a dropped client's session waits a day for it)."))
      (io/puts (str "  attach from another terminal:  " (remote-attach-hint name guests)))
      (ed-serve-run name (:config init)))))

;; ---- --serve --shared: shared content, a cursor per client (src/collab.blsp) -----
;; THE collaborative mode (`--collab` is an alias; the old fan-ONE-model/one-cursor
;; `std/editor/serve/serve-shared` seam still exists in Brood for other apps, but the
;; editor's answer to \"watch one screen together\" is now the `follow` command).
;; `serve` = private everything; shared = each client its OWN session model (own
;; cursor, panes, minibuffer…) while the served buffer's CONTENT is authoritative in
;; one buffer process. Each session subscribes (`collab-share-slot`), so every edit
;; anyone makes is serialized by the process and pushed back as `[:buffer-updated …]`
;; — which the session's `ed-update` folds via the registered handler (see
;; `input/ed-ev-buffer-updated`), reaching the loop because the daemon-side display's
;; `:poll` passes async mailbox messages through (the std/editor/serve event-bus
;; pass-through). Outbound, the hosted content propagate + collab presence chain run
;; at the tail of `ed-update` itself (`hosted-step` then `collab-step` — no-ops on
;; models with nothing hosted), so ordinary commands stay `model -> model` with no
;; knowledge of sharing, and a LIVE editor can become a host mid-session
;; (M-x share-session).

(def *collab-welcome*
  "bedit — COLLAB session (shared content, your own cursor).\n\nEveryone attached edits this same buffer; each keeps their own cursor and panes.\nC-x C-c / the window close button detaches.\n")

(defn- ed-collab-buffer (file)
  "The buffer a collab daemon/session starts from: `file` opened (created on save if
absent), or the collab welcome scratch. Called on both sides — once to seed the shared
buffer process, and once per attaching session (whose content the seed push then syncs
to the process's current text, so a late joiner sees the live document, not the file
on disk)."
  (if (nil? file)
    (make-buffer *collab-welcome* "*shared*")
    (solong/so-long-checked (find-file-buffer file))))

(defn ed-serve-collab-model (file proc &optional reg init)
  "The `make-model` thunk for one SHARED session: a fresh editor model on the collab
buffer for `file`, with pool slot 0 backed by shared buffer process `proc`
(`collab-share-slot` — runs in the session process, so the subscription's pushes land on
the session's own mailbox) and the daemon's file registry on `:collab-reg` (so every
OTHER file this session visits is auto-shared too — `collab-autoshare`). Each session is
otherwise independent — its own cursor, panes, kill ring — which is the point: shared
content, per-participant everything else. With the daemon's read `init` file the session
is prepared as a private one is ([[ed-served-model]]); without one it is the pure model."
  (fn ()
    (let (buffer (ed-collab-buffer file)
          base (if (nil? init)
                 (ed-init buffer)
                 (do (slowlog/responsive!) (ed-served-model buffer file init))))
      (collab-share-slot (assoc base :collab-reg reg) 0 proc))))

(defn ed-serve-collab (&optional file)
  "Run bedit as the SHARED (collaborative) daemon: spawn ONE buffer process owning
`file`'s content (or a shared scratch), then serve a fresh session per attaching client
whose slot 0 is backed by it — everyone edits the same document and sees each other's
edits and named carets live, each with their **own** cursor (`follow` rides someone
else's). Launch as `bedit --name ed --serve --shared [file]`; clients attach with
`bedit --attach ed --as NAME`. The host gets its own window too (`--headless` to opt
out). Undo history and markers are per-session and transient on the shared buffer (v1 —
see `src/collab.blsp`). Blocks."
  (let (name (remote-node-name (argv))
        init (read-init))
    ;; the node comes up FIRST, so the buffer process's pid carries the node's
    ;; stamp from birth — one less place for the pre-node-start `nonode` stamp
    ;; (now equality-normalized in the kernel, but why invite it) to appear
    (let (guests (remote-ensure-node name))
      (ed-serve-prepare init file)
      (let (reg (registry-start {:mirror true})
            buf (ed-collab-buffer file)
            proc (if (nil? (buffer-file buf))
                   (spawn-buffer buf) ; the scratch welcome — not registry-tracked
                   (collab-registry-share reg buf)))
        (serve (ed-serve-collab-model file proc reg init) ed-view ed-update)
        (io/puts (str "bedit daemon '"
                   name
                   "' serving"
                   (if (nil? file) "" (str " " file))
                   " (SHARED — one document, everyone their own caret)."))
        (io/puts (str "  attach:  " (remote-attach-hint name guests) " [--as NAME]"))
        (ed-serve-run name (:config init))))))

(defn ed-attach (spec)
  "Open a native window and attach it to the bedit daemon named `spec` (\"name\" for a
local daemon over the per-user Unix socket, or \"name@host:port\" over TCP) — the GUI
`emacsclient`. Attaches with this user's identity (`--as NAME`, defaulting to the OS
username), so a collab daemon shows a named caret for this window. The daemon runs the
editor; this window paints the frames it pushes and ships back every keystroke, until the
session ends (C-x C-c) or the link drops. Blocks until then. Needs a GUI-enabled `nest`
whose `std` includes `attach-display` (rebuild `../brood` with `./configure --with-gui &&
make install`) — a clear error says so if it's missing."
  (if (bound? 'editor/serve/attach-display)
    (editor/serve/attach-display spec
      ;; set up from THIS machine's init file, read without writing one: the window and
      ;; its fonts are here. The session's kills and yanks reach this machine's clipboard
      ;; through it (brood ADR-539)
      (ed-window (config/peek-init))
      ;; the session's guest cookie (`--cookie`, from the daemon's attach hint), else the
      ;; machine cookie — which only reaches a daemon on this machine's own nodes
      (remote-arg-after (argv) "--cookie")
      {:name (remote-participant (argv))})
    (error "ed-attach: this nest's std lacks attach-display — rebuild Brood: (cd ../brood && ./configure --with-gui && make install)")))
