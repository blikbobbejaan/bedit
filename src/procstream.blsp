(defmodule procstream
  "The streaming-subprocess worker every runner shares (testrun's `:testrun`,
apprun's `:apprun`): one long-lived NAMED process that owns a `proc-spawn` handle
and line-buffers its stdout. Drive it with messages:

  [:run cmd argv root token reply]   spawn (or replace — re-running never queues)
                               the child; `token` (any value) tags every event of this
                               run so the editor can discard a previous run's
                               in-flight events (see below); `reply` is where they go
                               — the loop that started the run (`ed-loop-address`),
                               so a run started from a second frame answers there
  [:shutdown]                  kill the child, deliver `:on-done` with `nil`, and stop

`handlers` is a map of plain fns (closures cross `spawn`) that BUILD the event to
deliver — or nil for nothing — and never send it themselves: the worker is one
process shared by every frame, so where an event goes is a fact about the RUN, which
only the worker holds. Each takes the run token as its LAST argument, so a stale run's
events are distinguishable from the fresh run's on the editor side:

  :on-line      (line spans token)  — each complete stdout line (the trailing partial
                flushes on exit); the consumer decodes/classifies
  :on-err-line  (line spans token)  — each non-blank stderr line
  :on-done      (code token)  — the child exited (nil = killed, incl. via [:shutdown])

A line arrives DECODED: each stream keeps its own ANSI decoder (`ansicolor/decode`, over
std's `ansi/feed`), so an escape split across two reads is finished by the second rather
than leaking into the text, and the line holds no escape at all. Its colours come beside
it as `spans` — `[start end attr]` from the line's start, attributes carried from one
line to the next — for a consumer that paints them (*Run*); one that wants the text
(*Tests*) ignores them.

A handler that throws is caught and reported through `:on-err-line` rather than
killing the worker (which would orphan the OS child, unread). The handlers are
captured at the worker's FIRST spawn (a named spawn is idempotent), so redefining a
consumer's dispatch fn live reaches the worker only after a shutdown+respawn — the
one late-binding exception in the runner stack, traded for one worker implementation
instead of three."
  (:use ansicolor :only [split-lines])) ; loads it with the worker; its calls are written qualified (ansicolor/decode …), as a spawned worker's are

(defn close-quietly (proc label)
  "Close the child `proc`, logging (under `label`) rather than raising when it will not
close — a worker replacing or stopping its child must not die over the old one."
  (try
    (os/close proc)
    (catch e (log/warn (str label ": close failed: " (error-message e))))))

(defn- procstream-deliver (run f arguments)
  "Build the event `(f ...arguments token)` and send it to the run's reply address,
routing a throw through `:on-err-line` so a handler bug can't kill the worker and orphan
the child. `run` is `{:handlers :token :reply}`."
  (let (token (:token run)
        event (try
                (apply f (conj arguments token))
                (catch e
                  ((:on-err-line (:handlers run)) (str "procstream handler error: "
                                                    (error-message e))
                    []
                    token))))
    (when event (send (:reply run) event))))

(defn- procstream-out-line (run line spans)
  "Deliver a stdout `line` through `:on-line` — every line, a blank one included."
  (procstream-deliver run (:on-line (:handlers run)) [line spans]))

(defn- procstream-err-line (run line spans)
  "Deliver a stderr `line` through `:on-err-line`, unless it is blank."
  (when (not (= (string/trim line) ""))
    (procstream-deliver run (:on-err-line (:handlers run)) [line spans])))

(defn procstream-stream ()
  "A stream's state before its first chunk: a fresh ANSI decoder and no partial line."
  {:decoder (ansi/decoder) :partial ["" []]})

(defn- procstream-feed (run stream data deliver)
  "Fold a chunk into `stream` (`procstream-stream`): decode it, `(deliver run line spans)`
each complete line, and return the stream with the decoder and the trailing partial line
to continue from. One splitter for both streams — stdout and stderr differ only in
`deliver` (and each has its own `stream`)."
  (let ([decoder text spans] (ansicolor/decode (:decoder stream) data)
        [whole whole-spans] (ansicolor/continue-partial (:partial stream) text spans)
        [lines partial] (ansicolor/split-lines whole whole-spans))
    (doseq (line lines) (deliver run (first line) (second line)))
    {:decoder decoder :partial partial}))

(defn- procstream-flush (run stream deliver)
  "Deliver the partial line `stream` ended on — the child exited without a final newline."
  (let ([line spans] (:partial stream))
    (when (not (= (string/trim line) "")) (deliver run line spans))))

(defn- procstream-start (handlers cmd argv root token reply)
  "Spawn the child for a run and start receiving from it."
  (procstream-recv (os/spawn cmd argv {:cwd root})
    (procstream-stream)
    {:handlers handlers :token token :reply reply}
    (procstream-stream)))

(defn- procstream-recv (proc out run err)
  ;; `out` / `err` are the two streams' states: a decoder each, and the partial line, so
  ;; a backtrace split across read chunks is line-assembled like stdout (the contract
  ;; promises whole lines) and an escape split across them is never shown.
  (let (handlers (:handlers run))
    (receive
      ([:proc p data] (procstream-recv proc
                        (if (= p proc) (procstream-feed run out data procstream-out-line) out)
                        run
                        err))
      ([:proc-err p data] (procstream-recv proc
                            out
                            run
                            (if (= p proc) (procstream-feed run err data procstream-err-line) err)))
      ([:proc-closed p code] (if (= p proc)
                               (do
                                 (procstream-flush run out procstream-out-line)
                                 (procstream-flush run err procstream-err-line)
                                 (procstream-deliver run (:on-done handlers) [code])
                                 (procstream-loop handlers))
                               (procstream-recv proc out run err)))
      ([:run cmd argv root new-token reply] (do
                                              (close-quietly proc "procstream")
                                              (procstream-start handlers
                                                cmd argv root new-token reply)))
      ([:shutdown]
        (do
          (close-quietly proc "procstream")
          ;; a stop is an exit — the consumer clears its UI
          (procstream-deliver run (:on-done handlers) [nil])
          :procstream-stopped)))))

(defn procstream-loop (handlers)
  "The idle state between runs — runs are human-paced, so hibernate while waiting."
  (proc/hibernate)
  (receive
    ([:run cmd argv root token reply] (procstream-start handlers cmd argv root token reply))
    ([:shutdown] :procstream-stopped)))
