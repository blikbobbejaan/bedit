(defmodule treewarm
  "Warming a large tree-sitter buffer's parse tree on the idle beat, so the first structural
query (RET's enclosing chain, `C-M-f`'s siblings) does not pay for the cold parse on a
keypress. Registers its idle-beat job and task-reply fold at load (`model/register-idle-job`,
`model/register-task-reply`); the model names none of it."
  (:use editor/buffer) ; buffer-text / buffer-rope / buffer-length
  (:use model) ; ed-current-buf / ed-mode-service / ed-headless? / the registries
  (:use task)) ; task — the parse runs off the loop

(defdyn *warm-tree-min*
  ;; Below this many characters a whole-file parse is already imperceptible, so warming
  ;; it would only spend a task. Around 40 KB is where the cold parse starts to be felt.
  40000)

(defn ed-tree-warm-stale? (m)
  "True when the current buffer is a tree-sitter buffer big enough to be worth warming,
and the tree cached for it is not the one it has now."
  (let (buf (ed-current-buf m))
    (and (ed-mode-service buf :ts-lang)
      (> (buffer-length buf) *warm-tree-min*)
      (not (= (buffer-rope buf) (:tree-warm m)))
      (not (:tree-warm-proc m)))))

(defn ed-launch-tree-warm (m)
  "Parse the current buffer's whole text in a spawned task, so the tree is already in the
runtime's cache when something asks for it.

The queries an editor makes of a tree — the enclosing chain for RET, the sibling list for
`C-M-f` — are cheap once the tree exists and dominated by the parse when it does not: on
a 250 KB Elixir file the FIRST of them costs ~650 ms and every one after it ~1 ms. That
first one used to land on whichever keypress happened to need it, which is precisely the
key that then felt broken. Incremental reparse cannot help it — there is no previous tree
to reparse from — so the answer is to stop it landing on a keypress at all.

Runs on the idle beat beside the diff-hl and diagnostics launches, and for the same
reason. The cache it warms lives in the runtime, not the model, so a task warming it is
visible to the editor process without anything being sent back; the reply exists only to
clear the in-flight flag."
  (if (or (not (ed-tree-warm-stale? m)) (ed-headless?))
    m
    (let (buf (ed-current-buf m)
          text (buffer-text buf)
          lang (ed-mode-service buf :ts-lang)
          job (task (fn ()
                      (check-allow :discarded-catch
                        (try
                          (do (%tree-sitter-chain text lang 0) :warm)
                          (catch _ :failed))))))
      (assoc m :tree-warm-proc job :tree-warming (buffer-rope buf)))))

(sig ed-apply-tree-warm (model any -> model))
(defn ed-apply-tree-warm (m result)
  "A finished warm: record which rope is now parsed and clear the in-flight handle. If
the buffer moved on while it ran, `ed-tree-warm-stale?` fires again on the next beat."
  (assoc m :tree-warm (:tree-warming m) :tree-warm-proc nil :tree-warming nil))

;; ---- registration ---------------------------------------------------------------
;; the tree warm has nothing to fold — the cache it filled lives in the runtime, so the
;; reply exists only to record which rope is parsed and free the slot
(register-task-reply :tree-warm-proc 'treewarm/ed-apply-tree-warm nil nil)

;; no `:stale?`: a warm never ARMS the beat on its own — it rides one the edit armed, beside
;; the diff-hl and diagnostics launches
(register-idle-job :tree-warm {:order 90 :run 'treewarm/ed-launch-tree-warm})
