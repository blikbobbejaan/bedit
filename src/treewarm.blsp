(defmodule treewarm
  "Opening a large tree-sitter buffer's FIRST held tree (`syntaxtree`, brood ADR-443) off the
loop, on the idle beat, so neither the first highlighted frame nor the first structural
query (RET's indent, `C-M-f`'s siblings) pays for the cold parse on a keypress. After that
the loop updates the tree incrementally per edit, and the structural queries read it
(brood ADR-467), so nothing here runs again for that buffer. Registers its idle-beat job and
task-reply fold at load (`model/register-idle-job`, `model/register-task-reply`); the model
names none of it."
  (:use editor/buffer) ; buffer-rope / buffer-length
  (:use model) ; ed-current-buf / ed-current-index / ed-mode-service / ed-headless? / the registries
  (:use syntaxtree) ; tree-open / install-syntax-tree — the tree the task opens
  (:use task)) ; task — the parse runs off the loop

(defn ed-tree-warm-stale? (m)
  "True when the current buffer is one the loop will not open a tree for itself
(`syntaxtree/*tree-open-max*`), none is held for it, and no warm is already in flight —
the tree this warm opens. An edit to a buffer that HAS a tree never makes it stale: the
loop updates that tree itself."
  (let (buf (ed-current-buf m))
    (and (not (:tree-warm-proc m))
      (ed-mode-service buf :ts-faces)
      (ed-mode-service buf :ts-lang)
      (> (buffer-length buf) *tree-open-max*)
      (nil? (syntax-tree-entry m (ed-current-index m))))))

(defn ed-launch-tree-warm (m)
  "Open the current buffer's held tree in a spawned task, when it needs one
([[ed-tree-warm-stale?]]).

A whole-document parse is the one cost incremental reparse cannot help — there is no
previous tree to reparse from — and on a 250 KB Elixir file it is ~650 ms. The loop opens a
tree itself only for a buffer under `syntaxtree/*tree-open-max*`; a larger one keeps the
windowed slice path, and its structural queries parse the text, until this task's tree
arrives. The handle lives in a runtime-wide registry, so the task's handle is valid in the
editor process; the reply carries it back with the rope it was parsed from and the pool
index it belongs to.

Runs on the idle beat beside the diff-hl and diagnostics launches, and for the same
reason."
  (if (or (not (ed-tree-warm-stale? m)) (ed-headless?))
    m
    (let (buf (ed-current-buf m)
          rope (buffer-rope buf)
          lang (ed-mode-service buf :ts-lang)
          ;; the task captures the rope: the parse reads it off the loop
          job (task (fn ()
                      (check-allow :discarded-catch
                        (try
                          {:tree (tree-open rope lang) :rope rope :lang lang}
                          (catch _ :failed))))))
      (assoc m :tree-warm-proc job :tree-warm-index (ed-current-index m)))))

(sig ed-apply-tree-warm (model any -> model))
(defn ed-apply-tree-warm (m result)
  "A finished warm: install the tree it opened as that pool buffer's — unless the loop has one
for it by now, or the handle did not survive the trip, in which case it is freed — and clear
the in-flight handle. If the buffer moved on while it ran, the tree is still a sound base:
the next refresh updates it from its rope to the buffer's."
  (let (idx (:tree-warm-index m)
        tree (when (map? result) (:tree result))
        cleared (assoc m :tree-warm-proc nil :tree-warm-index nil))
    (cond
      (nil? tree) cleared
      (or (not (int? idx))
        (>= idx (count (:buffers cleared)))
        (syntax-tree-entry cleared idx)
        (not (tree-alive? tree)))
        (do (tree-free tree) cleared)
      else (install-syntax-tree cleared idx tree (:rope result) (:lang result)))))

;; ---- registration ---------------------------------------------------------------
;; the reply carries the tree the task opened, and clears the slot either way
(register-task-reply :tree-warm-proc 'treewarm/ed-apply-tree-warm nil nil)

;; no `:stale?`: a warm never ARMS the beat on its own — it rides one the edit armed, beside
;; the diff-hl and diagnostics launches
(register-idle-job :tree-warm {:order 90 :run 'treewarm/ed-launch-tree-warm})
