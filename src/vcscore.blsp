(defmodule vcscore
  "The editor's VCS layer, whichever system the project uses (Emacs's VC). The
checkout a buffer is in is found by std's `vcs` (git's `.git`, mur's `.mur`); what the
editor DOES with it goes through that system's ROW here (`register-vcs-backend`):

- `C-x g` opens its status (`cmd-vcs-status`): Magit's for git, *mur-status* for mur;
- `C-x v =` · `C-x v l` · `C-x v b` diff, log and blame the file, as Emacs's `vc-diff`,
  `vc-print-log` and `vc-annotate` do, each answered by the backend or said not to be;
- the mode line carries the backend's chip — git's branch and counts, mur's change —
  computed off the loop on the idle beat (`vcs-launch-summary`).

A backend's porcelain (git's staging and sequencer, mur's changes, saves and lands) lives in
its own modules and is reached from here only through its row's symbols, called late, so
this module names none of them and a backend that has not loaded is simply not offered."
  (:use model) ; ed-current-buf / ed-headless? / message / register-idle-job / register-task-reply
  (:use pool) ; ed-default-dir
  (:use editor/buffer) ; buffer-file
  (:use sectionbuf) ; sb-ctx — a VC buffer (a status, a log) knows which checkout it shows
  (:use statusbar) ; seg — the one chip every backend's facts are drawn as
  (:use interactive) ; defcommand
  (:use task)) ; task — the summary's subprocesses, off the loop

;; ---- the backends -------------------------------------------------------------
;; A row per VCS kind (`:git`, `:mur` — the kinds std's `vcs/locate` answers), each hook a
;; symbol resolved when it is called:
;;   :status    (m key) -> m      the status buffer (C-x g)
;;   :diff-file (m key) -> m      this file's changes (C-x v =)
;;   :log-file  (m key) -> m      this file's history (C-x v l)
;;   :blame     (m key) -> m      who changed each line (C-x v b); absent when it cannot
;;   :dispatch  (m key) -> m      every menu, from one key (C-x M-g)
;;   :file-menu (m key) -> m      the VCS about this file (C-c g)
;;   :summary   (root) -> map     the mode line's facts, off the loop; nil for none
;;   :chip      (summary) -> map  what the mode line shows of those facts, pure — `vcs-chip`
;; and the time machine's (C-x v t, src/timemachine.blsp), absent when the VCS cannot say:
;;   :file-history   (root path) -> {:revisions :branch}  a file's revisions newest first, off the loop
;;   :file-at        (root revision) -> {:text :diff}    one revision's text and its diff, off the loop
;;   :show-revision  (m root hash) -> m                  the whole commit (D)
;;   :blame-revision (m root path hash line) -> m        blame at that revision (b)
;; A summary carries `:label` — what the work is on (git's branch, mur's change) — which the
;; window title shows too.

(defn register-vcs-backend (kind row)
  "Make `row` the editor's porcelain for checkouts of `kind` (`:git`, `:mur`). Called when
the backend's module loads."
  (registry/put! :vcscore/backends kind row))

(defn vcs-backend (kind)
  "The editor's row for VCS `kind`, or nil when no porcelain for it has loaded."
  (and kind (registry/lookup :vcscore/backends kind)))

(defn vcs-checkout (m)
  "The checkout the current buffer is about, `{:kind :root}`: a VC buffer's own (a status
or a log knows which checkout it shows), else the one its directory is in. nil outside any."
  (let (root (get (sb-ctx m) :root))
    (vcs/locate (or root (pool/ed-default-dir m)))))

(defn vcs-kind-name (kind)
  "A checkout kind as a person reads it: `:mur` is `mur`.

    (vcscore/vcs-kind-name :mur)   ;=> \"mur\""
  (string/drop-prefix (->string kind) ":"))

(defn vcs-load-hook (command)
  "Load the module a row's hook lives in, when it has not loaded: a backend's porcelain
is deferred (git's status buffer loads on the first C-x g), and its row names commands by
symbol, which does not load anything by itself."
  (let (module (interactive/command-module command))
    (when (and module (not (bound? command)))
      (check-allow :discarded-catch
        (try
          (require-one (symbol module))
          (catch e (log/warn (str "could not load " module ": " (error-message e)))))))))

;; check-allow: the hook is a symbol resolved now, so the checker cannot see its result;
;; every row's command hook is a `(m key) -> m`, the contract `register-vcs-backend` states.
(check-allow :trusted
  (sig vcs-dispatch (model any keyword string -> model))
  (defn- vcs-dispatch (m key hook what)
    "Run the current checkout's `hook` command, or say why not: outside a checkout, or a
backend with no answer for `what` it is asked."
    (let (where (vcs-checkout m)
          row (vcs-backend (:kind where))
          command (and row (get row hook)))
      (cond
        (nil? where) (message m "not in a version-controlled directory")
        (nil? row)
          (message m
            (str "no porcelain for " (vcs-kind-name (:kind where)) " checkouts has loaded"))
        (nil? command) (message m (str (vcs-kind-name (:kind where)) " has no " what))
        :else
          (do
            (vcs-load-hook command)
            (reflect/call-if-bound command
              (message m
                (str (vcs-kind-name (:kind where)) "'s " what " did not load ( *Messages* say why)"))
              m
              key))))))

(defcommand cmd-vcs-status
  (m key)
  "The status of the checkout this buffer is in (C-x g): Magit's for a git repository,
*mur-status* for a mur working copy."
  (vcs-dispatch m key :status "status buffer"))

(defcommand cmd-vcs-diff
  (m key)
  "This file's changes, beside it (C-x v =): against HEAD in git, against the change's last
save in mur."
  (vcs-dispatch m key :diff-file "file diff"))

(defcommand cmd-vcs-log-file
  (m key)
  "This file's history (C-x v l): git's log following renames, mur's trunk history of it."
  (vcs-dispatch m key :log-file "file log"))

(defcommand cmd-vcs-blame
  (m key)
  "Who last changed each line of this file (C-x v b)."
  (vcs-dispatch m key :blame "blame"))

(defcommand cmd-vcs-dispatch
  (m key)
  "Every menu of the checkout's VCS, from one key (C-x M-g): Magit's dispatch for git, every
mur verb for mur."
  (vcs-dispatch m key :dispatch "menu"))

(defcommand cmd-vcs-file-menu
  (m key)
  "The VCS about THIS file (C-c g): its diff, history and the change it can make to it — git's
stage, unstage and discard, mur's save, claim and restore."
  (vcs-dispatch m key :file-menu "file menu"))

;; ---- the mode line, off the loop ---------------------------------------------------
;; A backend's summary is a subprocess or several (git's is four: status, branch, upstream,
;; ahead/behind; mur's is one `mur status --json`), and on a large repo `git status` alone
;; is tens of milliseconds. Run on the loop on every idle beat, that is a freeze each time
;; typing settles. So it runs in a task and folds back like every other async recompute.
;;
;; What travels is a KEY, not a checkout: the key is what the editor already knows (a VC
;; buffer's root, the buffer's directory, whether it is file-backed), free to compute, and
;; comparing it is how a stale answer is recognised. Finding the checkout is a walk up the
;; directories, so it happens in the task too.

(defn vcs-summary-key (m)
  "What the mode line's VC summary is ABOUT, as a value the loop computes for nothing:
`[vcs-buffer-root default-dir file-backed? modified?]`. `modified?` is what a save flips, so
a save asks again at once: what a VCS reports is the files ON DISK.

A fileless buffer that is not itself a VC buffer (*scratch*, a report) has nothing to
describe: it only inherits a `:dir` from wherever it was made."
  (let (buf (ed-current-buf m))
    [(get (sb-ctx m) :root)
      (pool/ed-default-dir m)
      (and (buffer-file buf) true)
      (and (buffer-file buf) (buffer-modified? buf))]))

;; check-allow: the summary hook is a backend's symbol called late; its contract (a map or
;; nil) is the one `register-vcs-backend` states.
(check-allow :trusted
  (sig vcs-summary (any -> any))
  (defn vcs-summary (key)
    "The mode line's summary for a `vcs-summary-key`, or nil when there is nothing to
describe: the checkout's backend's `:summary`, with `:kind` and `:root` added. Subprocesses,
so this is what the task runs and nothing on the loop calls it directly."
    (let ([vcs-root dir file? _] key
          where (if (or vcs-root file?) (vcs/locate (or vcs-root dir)) nil)
          row (and where (vcs-backend (:kind where)))
          facts (and row (reflect/call-if-bound (:summary row) nil (:root where))))
      (if (nil? facts) nil (assoc facts :kind (:kind where) :root (:root where))))))

;; ---- the chip: one shape, every backend's facts -------------------------------------
;; A backend says WHAT its chip holds; this draws it, so git's and mur's read alike — a glyph
;; and label (the branch, the change), a state dot, then counts that appear only when non-zero
;; — each clickable to C-x g, each with its tooltip. A chip:
;;
;;   {:glyph "⎇ " :label "main" :label-face f :tooltip [lines]
;;    :dot-face f :dot-tooltip [lines]
;;    :counts [{:id :git-staged :text "+2" :face f :tooltip "2 staged"} …]}

(def *vcs-dot-glyph* "●") ; the state dot, every backend's

(defn vcs-chip-segments (chip)
  "The mode line's segments for `chip` (nil ⇒ `()`): the glyph and label, the state dot, then
each count — every one clickable to C-x g. Pure."
  (if (nil? chip)
    '()
    (append (list (seg :vcs-label
                    (str (:glyph chip "") (:label chip ""))
                    {:sep "  —  "
                     :face (:label-face chip)
                     :on-click 'vcscore/cmd-vcs-status
                     :tooltip (:tooltip chip)})
              (seg :vcs-dot
                *vcs-dot-glyph*
                {:sep "   "
                 :face (:dot-face chip)
                 :on-click 'vcscore/cmd-vcs-status
                 :tooltip (:dot-tooltip chip)}))
      (map (seq/reject (or (:counts chip) []) nil?)
        (fn (count)
          (seg (:id count)
            (:text count)
            {:sep "  "
             :face (:face count)
             :on-click 'vcscore/cmd-vcs-status
             :tooltip (:tooltip count)}))))))

;; check-allow: the chip hook is a backend's symbol called late, `(summary) -> map`.
(check-allow :trusted
  (sig vcs-segments (any -> any))
  (defn vcs-segments (summary)
    "The mode line's VCS segments for `summary`: its backend's `:chip`, drawn — or `()`."
    (let (row (and summary (vcs-backend (:kind summary))))
      (if (nil? row) '() (vcs-chip-segments (reflect/call-if-bound (:chip row) nil summary))))))

(defn vcs-label (m)
  "What the current checkout's work is on — git's branch, mur's change — or nil. The window
title's suffix."
  (:label (:vcs-summary m)))

(defn- vcs-fold-summary (m summary)
  (if (= summary (:vcs-summary m))
    m
    (assoc m :vcs-summary summary :vcs-segments (vcs-segments summary))))

(defn vcs-cache-summary (m)
  "Recompute the mode line's VC summary **synchronously**: the headless path, and the one
the tests drive; a live editor goes through `vcs-launch-summary`."
  (vcs-fold-summary m (vcs-summary (vcs-summary-key m))))

(def *vcs-summary-every-ms* 10000)
;; How long a summary stands for the same key before the idle beat asks again. A summary is
;; subprocesses — `git status`, or `mur status --json`, which hashes the working files and
;; takes ~125 ms on Brood's 1,600 — and the beat fires every time typing settles, so asking
;; on each one kept a VCS busy for nothing: what it reports is the files ON DISK, and typing
;; does not change them. A save does (the key's `modified?`), a buffer switch does (its file),
;; and a VC command the editor runs clears the stamp (`vcsproc`); the interval catches what
;; changed behind the editor's back (a `mur save` in a terminal).

(defn vcs-summary-fresh? (m key now)
  "Whether the summary last asked for `key` was asked within `*vcs-summary-every-ms*`."
  (and (= key (:vcs-summary-asked-key m))
    (< (- now (:vcs-summary-asked-at m 0)) *vcs-summary-every-ms*)))

(defn vcs-launch-summary (m)
  "Recompute the mode line's VC summary OFF the loop when nothing is already in flight and
the last one is not still fresh (`vcs-summary-fresh?`). Headless (no loop for a reply to
land in) runs it synchronously instead."
  (let (key (vcs-summary-key m)
        now (os/now))
    (cond
      (:vcs-proc m) m
      (ed-headless?)
        (assoc (vcs-cache-summary m) :vcs-summary-asked-key key :vcs-summary-asked-at now)
      (vcs-summary-fresh? m key now) m
      :else
        (let (job (task (fn () (vcs-summary key))))
          (assoc m
            :vcs-proc job
            :vcs-checking key
            :vcs-summary-asked-key key
            :vcs-summary-asked-at now)))))

(defn vcs-summary-stale? (m)
  "Whether the mode line's summary has never been asked for what the current buffer is
about (`vcs-summary-key`) and none is in flight — a file opened, switched to, saved. What
ARMS the idle beat for it: a summary that only rode a beat something else armed never came
for a file opened and just read, since nothing else had work. The `*vcs-summary-every-ms*`
re-ask is not here: it catches changes behind the editor's back, and arming a beat on the
clock alone is an editor that never rests."
  (and (nil? (:vcs-proc m)) (not (= (vcs-summary-key m) (:vcs-summary-asked-key m)))))

;; asked on every idle beat (`model/register-idle-job`): the in-flight slot is its gate, and
;; a key it has not asked about yet arms the beat
(register-idle-job :vcs-summary
  {:order 100 :run 'vcscore/vcs-launch-summary :stale? 'vcscore/vcs-summary-stale?})

;; the summary, computed off the loop (`model/register-task-reply`)
(register-task-reply :vcs-proc 'vcscore/vcs-apply-summary nil nil)
(defn vcs-apply-summary (m summary)
  "Fold a finished summary into `:vcs-summary` + `:vcs-segments` and free the in-flight slot.
An answer about a buffer the reader has since left is dropped — the next idle beat asks
about the one they are in now."
  (let (asked (:vcs-checking m)
        m1 (dissoc m :vcs-proc :vcs-checking))
    (if (= asked (vcs-summary-key m1)) (vcs-fold-summary m1 summary) m1)))
