(defmodule package-store
  "What is on disk under `~/.config/bedit/packages/` (the Emacs `elpa` model): which packages
are installed, their manifests, the source files and modules each holds, and the settings
those sources declare. Reads files and nothing else: loading a package, the live image and
the *Packages* buffer are `packages`'s; what a load did is `package-ledger`'s."
  (:use config-paths :only [config-dir])) ; the user package dir lives under it

;; ---- the user package directory (~/.config/bedit/packages) ------------------

(defn user-package-dir ()
  "Where installed plugins live: `~/.config/bedit/packages/` (honouring $XDG_CONFIG_HOME)."
  (path/join (config-paths/config-dir) "packages"))

(defn package-dir (name)
  "The directory package `name` installs into, whether or not it is there."
  (path/join (user-package-dir) name))
(defn- manifest-path (name) (path/join (package-dir name) "project.blsp"))

(defn- plist-get (plist key)
  "The value after `key` in a plist, or nil — a local copy (no dependency on the project tool)."
  (cond
    (or (nil? plist) (nil? (rest plist))) nil
    (= (first plist) key) (first (rest plist))
    else (plist-get (rest (rest plist)) key)))

(defn manifest-value-in (dir key)
  "A value from the `(project …)` manifest of the package in directory `dir` — installed or
staged — or nil; a manifest that is there and does not read is logged."
  (try
    (let (form (reflect/read-string (file/slurp (path/join dir "project.blsp"))))
      (if (and (list? form) (= (first form) 'project))
        (plist-get (rest form) key)
        nil))
    (catch failure
      (do
        (log/warn (str "packages: cannot read the manifest in " dir ": " (error-message failure)))
        nil))))

(defn manifest-value (name key)
  "A value from an installed package's `(project …)` manifest, or nil."
  (manifest-value-in (package-dir name) key))

(defn installed? (name)
  "Whether package `name` is installed in the user package dir: a package NAME (one path
component, `project/valid-dep-name?` — never a path typed into a prompt, never `..`) whose
directory there holds a manifest."
  (and (project/valid-dep-name? name) (file/exists? (manifest-path name))))

(defn removable-dir (name)
  "The directory removing package `name` may delete, or nil: `name` is an installed package
([[installed?]], listed by [[installed-packages]]) and its directory, symbolic links resolved,
is a direct child of the user package dir — so neither a typed path, a `..`, nor a link
leading out of the package dir can make a removal retire or delete anything else."
  (let (packages (os/canonicalize (user-package-dir))
        real (when (installed? name) (os/canonicalize (package-dir name))))
    (when (and packages
            real
            (includes? (installed-packages) name)
            (= real (path/join packages name)))
      real)))

(defn installed-version (name)
  "The installed version string of `name`, or nil — nil without a word when it is not installed
(every hive row asks), a logged warning only for a manifest that is there and does not read."
  (when (installed? name) (manifest-value name :version)))

(defn installed-packages ()
  "The names of packages installed in the user package dir (a dir with a project.blsp)."
  (if (not (file/exists? (user-package-dir)))
    []
    (vec (seq/filter (file/ls (user-package-dir)) installed?))))

(defn source-files-under (dir)
  "Every `.blsp` file under `dir`, at any depth — `()` when `dir` is not there."
  (if (file/exists? dir)
    (seq/filter (file/walk-files dir) (fn (path) (string/ends-with? path ".blsp")))
    ()))

(defn source-files (name)
  "Every `.blsp` file under package `name`'s src/."
  (source-files-under (path/join (package-dir name) "src")))

(defn modules-in (files)
  "The modules `files` declare — each file's `(defmodule …)` — as a set of strings. A file
that does not open with one declares none."
  (into #{}
    (seq/keep files
      (fn (file)
        (let (head (check-allow :discarded-catch
                     (try (reflect/read-first (file/slurp file)) (catch _ nil))))
          (when (and (list? head) (= (first head) 'defmodule) (symbol? (second head)))
            (->string (second head))))))))

(defn package-modules (name)
  "The modules package `name`'s files declare — each file's `(defmodule …)` — as a set of
strings. A file that does not open with one declares none."
  (modules-in (source-files name)))

(def- *settings-registry-names*
  ;; how a package's source names bedit's settings registry in a `settings/define`
  #{:bedit/settings 'config/*settings* '*settings*})

(defn- setting-declared (form)
  "The setting name a `(settings/define <bedit's registry> :name …)` form declares, or nil."
  (when (and (list? form)
          (>= (count form) 3)
          (includes? ['settings/define 'define] (first form))
          (contains? *settings-registry-names* (second form))
          (keyword? (nth form 2)))
    (nth form 2)))

(defn- settings-in-forms (forms)
  "Every setting `forms` declare, at any depth, in the order they appear."
  (letrec (walk (fn (stack found)
                  (if (empty? stack)
                    found
                    (let (form (first stack)
                          more (rest stack)
                          declared (setting-declared form))
                      (cond
                        declared (walk more (conj found declared))
                        (or (list? form) (vector? form)) (walk (append (vec form) more) found)
                        else (walk more found))))))
    (walk forms [])))

(defn package-settings (name)
  "The init.blsp settings installed package `name` declares — every `(settings/define …)` of
bedit's registry its sources hold, READ, not evaluated, so a package not yet loaded answers
too. `[]` when it declares none or is not installed."
  (vec (seq/distinct (mapcat (source-files name)
                       (fn (file)
                         (settings-in-forms (check-allow :discarded-catch
                                              (try
                                                (reflect/read-all (file/slurp file))
                                                (catch failure ())))))))))
