(defmodule kmacro
  "Keyboard macros as Emacs's kmacro.el defines them: C-x ( starts recording, C-x ) ends it,
C-x e runs it (C-u N for N passes, C-u 0 until one fails). The recording itself is `input`'s
(`ed-macro-record`), and so is the replay (`ed-run-macro`): this module is the commands."
  (:use interactive) ; defcommand / current-prefix-arg / register-prefix-consuming
  (:use model)) ; message / ed-ding

;; Recording captures raw input events into `:macro-recording` (the capture happens in
;; `input/ed-update`, which sees every event); `:macro-last` holds the finished macro and
;; `:run-macro {:count N}` asks `ed-update` to replay it N times by re-feeding the events
;; (`input/ed-run-macro`) — N = 0 meaning until a key fails. A replay stops at the first key
;; whose command fails (`model/ed-ding`, or a thrown error), as Emacs's does, or at C-g: it
;; runs in slices, between the user's input. Emacs C-x (/)/e.

(defcommand cmd-start-kbd-macro
  (m key)
  "Start recording a keyboard macro (C-x (): subsequent keys are captured until C-x )."
  (assoc m :macro-recording [] :echo "Recording keyboard macro…"))

(def- ed-prefix-starters
  ;; the keys that begin a prefix argument (C-u, and the negative-argument bindings)
  #{:ctrl-u :alt-- :ctrl-- :ctrl-meta--})

(defn- ed-prefix-continues-key? (key)
  "Whether `key` can follow the start of a prefix argument: another C-u, a digit or `-`."
  (or (= key :ctrl-u)
    (= key "-")
    (and (string? key) (= (string/length key) 1) (>= (index-of "0123456789" key) 0))))

(defn ed-macro-prefix-start (keys)
  "Where the prefix argument that ends `keys` begins — the index of its C-u (or negative
argument) — or `(count keys)` when they do not end in one. The keys a `C-u 3` typed before
`C-x )` or `C-x e` were recorded too, and belong to that command, not the macro.

    (kmacro/ed-macro-prefix-start [\"a\" \"5\" :ctrl-u \"3\"])   ;=> 2"
  (letrec (back (fn (index start)
                  (if (< index 0)
                    start
                    (let (key (nth keys index))
                      (cond
                        (contains? ed-prefix-starters key) (back (dec index) index)
                        (and (ed-prefix-continues-key? key) (= start (count keys)))
                          (back (dec index) start)
                        ;; a digit before the C-u that started the argument is typed text
                        else start)))))
    (back (dec (count keys)) (count keys))))

(defn- ed-macro-body (m)
  "The keys of the macro being recorded: the keys that invoked the command ending it — the
chord (`:chord` holds its keys before the last) and a prefix argument typed before it —
dropped, since they were recorded before dispatch."
  (let (recorded (:macro-recording m)
        chord (inc (count (or (:chord m) [])))
        body (take recorded (math/max 0 (- (count recorded) chord))))
    (if (nil? (current-prefix-arg m)) body (take body (ed-macro-prefix-start body)))))

(defn- ed-macro-finish (m)
  "`m` with recording ended and the macro recorded made the last macro, said in the echo
area — unless nothing was recorded: then the last macro is KEPT, as Emacs's \"Ignore empty
macro\" keeps it, so a stray `C-x ( C-x )` never loses the macro you had."
  (let (body (ed-macro-body m)
        stopped (dissoc m :macro-recording))
    (if (empty? body)
      (message stopped "Ignore empty macro")
      (message (assoc stopped :macro-last body) "Keyboard macro defined"))))

(defn- ed-macro-run (m repeats)
  "Ask the loop to replay the last macro `repeats` times (0: until a key fails) — or say why it
cannot: none recorded, a negative count, or a macro already running (a macro that ran
itself would never end)."
  (cond
    (nil? (:macro-last m))
      (ed-ding (message m "no keyboard macro defined (record one with C-x ( … C-x ))"))
    (:macro-executing m) (ed-ding m "a keyboard macro cannot run itself")
    (< repeats 0)
      (ed-ding m "a keyboard macro runs a positive number of times, or 0: until it fails")
    else (assoc m :run-macro {:count repeats})))

(defcommand cmd-end-kbd-macro
  (m key)
  "Finish recording the keyboard macro (C-x )); it becomes the last macro for C-x e. With a
prefix argument N, run it N-1 more times (Emacs's `kmacro-end-macro`); `C-u 0 C-x )` runs it
again until a key fails."
  (cond
    (nil? (:macro-recording m)) (ed-ding (message m "not currently defining a keyboard macro"))
    (or (nil? (current-prefix-arg m)) (empty? (ed-macro-body m))) (ed-macro-finish m)
    else
      (let (repeats (current-prefix-arg m)
            finished (ed-macro-finish m))
        (cond
          (= repeats 0) (ed-macro-run finished 0)
          (> repeats 1) (ed-macro-run finished (dec repeats))
          else finished))))

(defcommand cmd-execute-kbd-macro
  (m key)
  "Execute the last keyboard macro (C-x e); `ed-update` replays its events. With a prefix
argument N it runs N times, and `C-u 0 C-x e` runs it until a key fails — a search that
finds nothing, a motion at the end of the buffer (Emacs's `call-last-kbd-macro`). Any run
stops at the first key whose command fails. Pressed while recording, it ends the recording
first and then runs the macro (Emacs's `kmacro-end-and-call-macro`)."
  (let (repeats (or (current-prefix-arg m) 1))
    (if (nil? (:macro-recording m))
      (ed-macro-run m repeats)
      (ed-macro-run (ed-macro-finish m) repeats))))

;; both read the prefix argument as their repeat count, so they run once under it
(register-prefix-consuming 'kmacro/cmd-end-kbd-macro)
(register-prefix-consuming 'kmacro/cmd-execute-kbd-macro)

(interactive/declare-trait :guest
  '(kmacro/cmd-start-kbd-macro kmacro/cmd-end-kbd-macro kmacro/cmd-execute-kbd-macro))
