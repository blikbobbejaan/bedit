(defmodule clipboard
  "The kill ring and what it shares text with: the clipboard, PRIMARY, and the other frames.

A model names the clipboard it shares its kills with: the local window's, or the client's
for a served session, never the daemon's. Kills mirror to it, a yank asks it what is newer,
a mouse drag sets only PRIMARY, and every read that can block goes off the loop. One ring
serves every frame, through a shared agent."
  (:use editor/buffer)
  (:use interactive :only [command-trait?]) ; a kill coalesces with the kill before it
  (:use model))

;; ---- the kill ring's head: what a yank inserts ------------------------------
;; The ring itself is pushed by the kill commands through `ed-push-kill` (below); what
;; every YANK site shares — the buffer's `C-y`, the minibuffer's, isearch's — is the
;; question "what text does a yank insert right now?", which first asks the OS
;; clipboard whether another app copied something newer. That lives here, below the
;; commands, so a transient input (a search, a prompt) can paste without reaching into `killing`.

;; Cap the ring like Emacs's `kill-ring-max` (default 60) so it can't grow forever.
(def ed-kill-ring-max 60)

;; ---- the user's clipboard: which one, and how it is reached ----------------------
;; A model names the clipboard it shares its kills with, if any: the local window's OS
;; clipboard (`:os-clipboard`), or — for a session served to a window elsewhere — the
;; clipboard of the machine that window runs on (`:client-clipboard`, brood's
;; `editor/serve/client-clipboard-*`, ADR-539). Never the daemon's: the user is not sitting
;; at it, and on a shared host it is someone else's. Pure test models name neither.
;;
;; Writing is always a cast. Reading comes in two shapes: [[ed-clipboard-read]] answers now,
;; for what cannot wait (a prompt's or a search's C-y); [[ed-clipboard-ask]] answers LATER,
;; through a continuation, so a clipboard on the other end of a link costs the loop nothing
;; while it answers. C-y in a buffer asks.

;;
;; Reading the OS clipboard waits on the app that owns it — an X11 round trip on a fresh
;; display connection, a Wayland pipe — and a slow or wedged owner froze the window inside
;; every C-y (brood ADR-536 makes the read a blocking call the slow-turn log names). Nothing
;; outside the editor can put text on the clipboard while the editor's window has the
;; keyboard: another app copies while it is focused, so the editor is told (`:blur`) before
;; and (`:focus-in`) after. So the clipboard is read OFF the loop when the window regains
;; focus, and a yank uses what that read found (`:clipboard-text`, `:clipboard-known?`).
;; The editor's own kills keep it known — they set the clipboard themselves. Until a read has
;; landed (the first instant after focus, a frontend that reports no focus — a terminal) a
;; yank reads it as it always did.

(defdyn *clipboard-reader* os/clipboard-get)
;; What reads the OS clipboard — a `() -> text-or-nil`; a test binds a stand-in. Captured
;; when a read is launched, since the task that runs it does not see this binding.

(defdyn *clipboard-read-timeout-ms* 5000)
;; How long an off-loop read may wait on the clipboard's owner before its task is killed and
;; its slot freed. A Wayland offer whose pipe is never written has no deadline of its own.

(defdyn *clipboard-refresh-ms* 2000)
;; While the window has the keyboard, how stale what the clipboard holds may get before the
;; idle beat reads it again: a program run from the editor (`xclip` in a terminal buffer)
;; can copy without the focus ever moving.

(defdyn *clipboard-writer* os/clipboard-set)
;; What puts a text on the OS clipboard — every kill's mirror ([[ed-clipboard-write]]); a test
;; binds a stand-in, so it never replaces what the user copied.

(defdyn *primary-reader* os/primary-get)
;; What reads the PRIMARY selection (X11 / Wayland: what is highlighted anywhere, brood
;; ADR-553) — the middle click's text; a test binds a stand-in.

(defdyn *primary-writer* os/primary-set)
;; What owns the PRIMARY selection with a text — a drag-select's region; a test binds a
;; stand-in that records what it was handed.

(defn ed-read-clipboard-with (reader)
  "What `reader` finds on the OS clipboard (or the PRIMARY selection, for a primary reader),
or `:clipboard-unread` when the read failed — a read already waiting on a wedged owner
(brood ADR-536), no display. Never nil for a failure: nil is an empty clipboard."
  (try
    (reader)
    (catch failure
      (do (log/warn (str "clipboard read failed: " (error-message failure))) :clipboard-unread))))

(defn- ed-clipboard-launch (m)
  "`m` with a read of the OS clipboard started in a task — the reader and its deadline
captured now — stamped with the epoch it was asked under and when."
  (let (reader *clipboard-reader*)
    (assoc m
      :clipboard-proc
        (task/task (fn () (ed-read-clipboard-with reader))
          {:timeout *clipboard-read-timeout-ms*})
      :clipboard-asked-epoch (:clipboard-epoch m 0)
      :clipboard-read-at (os/now))))

(defn ed-clipboard-read (m)
  "The text on the clipboard model `m` shares, read NOW, or nil. The local window's OS
clipboard (`:os-clipboard`): what the last off-loop read found once one has landed
([[ed-clipboard-focus]], [[ed-clipboard-refresh]]) — nothing is read on the loop then — and
until then a read now, best-effort. nil for a served session, whose client's clipboard is
only ever asked ([[ed-clipboard-ask]]) — a read that waited on the link would stop the loop
— and for a model with neither. A clipboard that cannot be read is nil, said in the log."
  (second (ed-clipboard-read-now m)))

(def *clipboard-race-ms* 250)
;; How long a yank pressed while the focus read is still out waits for THAT read's answer
;; before reading itself — which would only find the reader busy with it.

(defn ed-clipboard-read-now (m)
  "`[model' text]`: [[ed-clipboard-read]] with what the reading did to the model. A read
already in flight (the window has just regained focus) is the answer to wait for, briefly
(`*clipboard-race-ms*`) — a read of our own beside it finds the reader busy and nil, and the
yank took the stale ring head. A clipboard that cannot be read is SAID, once, until a read
succeeds again ([[ed-clipboard-unreadable]]): yanking the ring head in silence for ever was
the failure.

A read still out after that wait is a slow owner, not a dead one: no read of our own is
made beside it (it could only find the reader busy, and would report a healthy clipboard
unreadable). The yank takes what is known — nothing, so the ring's head — and says the
clipboard is still being read; its answer lands as any other."
  (cond
    (not (:os-clipboard m)) [m nil]
    (:clipboard-known? m) [m (:clipboard-text m)]
    (:clipboard-proc m)
      (let (landed (ed-await-clipboard m *clipboard-race-ms*))
        (cond
          (:clipboard-known? landed) [landed (:clipboard-text landed)]
          (:clipboard-proc landed)
            [(message landed "the OS clipboard is still being read — yanked the kill ring") nil]
          else (ed-clipboard-read-direct landed)))
    else (ed-clipboard-read-direct m)))

(defn- ed-clipboard-read-direct (m)
  "`[model' text]` of a read made now, on the loop: the fallback before any off-loop read
has landed (and where none can: a frontend that reports no focus)."
  (let (found (ed-read-clipboard-with *clipboard-reader*))
    (if (= found :clipboard-unread)
      [(ed-clipboard-unreadable m) nil]
      [(dissoc m :clipboard-unreadable-said) found])))

(defn- ed-await-clipboard (m wait-ms)
  "`m` with the clipboard read in flight folded in, when its answer arrives within
`wait-ms` — a selective receive of that read's own reply — else `m` as it was, the read still
out (its reply then lands as any other)."
  (let (handle (:clipboard-proc m))
    (receive
      ([:task-done ^handle value] (ed-apply-clipboard m value))
      ([:task-error ^handle _reason] (ed-apply-clipboard m :clipboard-unread))
      ([:task-timeout ^handle] (ed-apply-clipboard m :clipboard-unread))
      (after wait-ms m))))

(defn ed-clipboard-unreadable (m)
  "`m` after a clipboard read failed: said once — `the OS clipboard is not answering` — and
not again until a read succeeds, so a wedged owner (brood ADR-536) is known about without a
message on every yank."
  (if (:clipboard-unreadable-said m)
    m
    (assoc (message m "the OS clipboard is not answering — yanks use the kill ring until it does")
      :clipboard-unreadable-said true)))

(defn ed-clipboard-blur (m)
  "The window lost the keyboard (`:blur`): another app may copy now, so what the clipboard
holds is no longer known, and a read still in flight may answer from before that copy."
  (if (not (:os-clipboard m))
    m
    (assoc (dissoc m :clipboard-known?) :clipboard-epoch (inc (:clipboard-epoch m 0)))))

(defn ed-clipboard-focus (m)
  "The window has the keyboard again (`:focus-in`): read the clipboard OFF the loop, so the
next yank finds what another app copied without waiting on that app. Headless (no loop for
the answer) reads nothing; a yank there reads as it always did."
  (if (or (not (:os-clipboard m)) (ed-headless?))
    m
    (do
      ;; a read asked before the blur answers for a clipboard that may have changed since
      (when (:clipboard-proc m) (task/cancel (:clipboard-proc m)))
      (ed-clipboard-launch m))))

(defn ed-clipboard-refresh-due? (m)
  "Whether the idle beat should read the clipboard again: the editor mirrors it, has the
keyboard (a window, or a terminal reporting focus — brood ADR-536), knows what it held as of
a read [[*clipboard-refresh-ms*]] or more ago, and has no read in flight — one at a time,
however long a wedged one takes to time out."
  (and (:os-clipboard m)
    (:clipboard-known? m)
    (not (:unfocused m))
    (nil? (:clipboard-proc m))
    (not (ed-headless?))
    (>= (- (os/now) (:clipboard-read-at m 0)) *clipboard-refresh-ms*)))

(defn ed-clipboard-refresh (m)
  "The idle beat's clipboard read: started off the loop when [[ed-clipboard-refresh-due?]]."
  (if (ed-clipboard-refresh-due? m) (ed-clipboard-launch m) m))

;; armed by activity, so an idle editor polls nothing; bounded by `*clipboard-refresh-ms*`
(register-idle-job :clipboard-refresh
  {:order 140 :run 'clipboard/ed-clipboard-refresh :stale? 'clipboard/ed-clipboard-refresh-due?})

;; the clipboard read a focus change or the idle beat starts — no label: it is quick, and
;; nobody asked for it
(register-task-reply :clipboard-proc 'clipboard/ed-apply-clipboard :clipboard-unread nil)
(defn ed-apply-clipboard (m found)
  "Fold a clipboard read: what it found is what the clipboard holds — unless the window
lost focus or the editor set the clipboard since it was asked (the epoch moved), when it may
be stale and is dropped. A read that failed or timed out (`:clipboard-unread`) frees the
slot and changes nothing else: unknown stays unknown (the next yank reads it), known stays
what the last good read found, and the next refresh may try again."
  (let (freed (dissoc m :clipboard-proc :clipboard-asked-epoch))
    (cond
      (= found :clipboard-unread) (ed-clipboard-unreadable freed)
      (not (= (:clipboard-asked-epoch m) (:clipboard-epoch m 0))) freed
      else
        (assoc (dissoc freed :clipboard-unreadable-said)
          :clipboard-known? true
          :clipboard-text found))))

;; check-allow: the continuation is resolved late (`reflect/eval`), so its result is unknown
;; to the checker; every `then` is a fold, and answers a model
(sig ed-clipboard-ask (model symbol any -> model))
(check-allow :trusted
  (defn ed-clipboard-ask (m then data)
    "Ask for the text on the clipboard model `m` shares and go on with `(then m' text data)`
once it is known — `then` a symbol naming that fold, resolved when it runs (so a
redefinition hot-swaps), `text` nil when the clipboard is empty or could not be read.

A served session (`:client-clipboard`) asks its client over the link (brood's
`editor/serve/client-clipboard-ask`, ADR-539) and returns at once with the ask recorded
under `:clipboard-asks`; `then` runs when the `[:clipboard ref text]` event arrives
([[ed-ev-clipboard]]) — the loop draws and takes keys meanwhile, and brood answers nil
itself when the client says nothing in time. Any other model (or a served one with no
client attached) reads now ([[ed-clipboard-read]]) and `then` runs within this fold.

The local window needs no ask: its clipboard is read off the loop on focus and the idle beat
([[ed-clipboard-focus]]), so [[ed-clipboard-read]] answers from that without waiting."
    (let (asked (when (:client-clipboard m) (editor/serve/client-clipboard-ask)))
      (if (nil? asked)
        (let ([after-read text] (ed-clipboard-read-now m))
          ((reflect/eval then) after-read text data))
        (assoc m :clipboard-asks (assoc (or (:clipboard-asks m) {}) asked {:then then :data data}))))))

(defn ed-ev-clipboard (m input text-rows columns rows)
  "`[:clipboard ref text]` (or `[:primary ref text]`): the answer to an [[ed-clipboard-ask]]
(or a served [[ed-primary-ask]]) — its continuation run
with `text`. Only the first answer to an ask counts: the client's real answer arriving after
brood answered for it at the timeout (or the reverse) finds no ask and changes nothing."
  (let (asked (nth input 1)
        text (nth input 2)
        pending (get (or (:clipboard-asks m) {}) asked))
    (if (nil? pending)
      m
      ((reflect/eval (:then pending)) (assoc m :clipboard-asks (dissoc (:clipboard-asks m) asked))
        (if (string? text) text nil)
        (:data pending)))))

(register-event-handler :clipboard 'clipboard/ed-ev-clipboard)
;; a served session's PRIMARY answers the same way (`ed-primary-ask`, brood ADR-562)
(register-event-handler :primary 'clipboard/ed-ev-clipboard)

(defn ed-clipboard-asking? (m then)
  "Whether an [[ed-clipboard-ask]] that goes on with `then` is still waiting for its answer —
what a command that follows one (M-y after C-y) asks before it acts on the first's result."
  (any? (vals (or (:clipboard-asks m) {})) (fn (pending) (= (:then pending) then))))

;; check-allow: a writer's answer is anything; the `string?` test is the return's type, which
;; the checker cannot read through a keyword lookup on an `any`
(check-allow :trusted
  (sig ed-clipboard-note (any -> (or string nil)))
  (defn ed-clipboard-note (said)
    "The line a clipboard writer asked to be said — only when it answered the dedicated
`{:clipboard-note line}`; any other answer (the OS writer hands back its argument, the
killed text itself) says nothing, so a kill never echoes or logs what was killed.

    (clipboard/ed-clipboard-note \"secret\")   ;=> nil
    (clipboard/ed-clipboard-note {:clipboard-note \"too large\"})   ;=> \"too large\""
    (when (and (map? said) (string? (:clipboard-note said))) (:clipboard-note said))))

(defn ed-clipboard-write (m text)
  "Put `text` on the clipboard model `m` shares (see [[ed-clipboard-read]]): the OS
clipboard's (a no-op without one), or the attached client's — a cast, nothing waits. Nothing
for a model with neither. Returns nil — or the line a writer asked to be said with `{:clipboard-note line}`
([[ed-clipboard-note]]: a terminal clipboard that
cannot take a text that large); [[ed-push-kill]] says it, and records the OS write on the model
([[ed-clipboard-set-known]])."
  (cond
    ;; `os/clipboard-set` is itself a no-op without a clipboard, so nothing here is guarded:
    ;; a stale name must raise, not leave every kill un-mirrored.
    (:os-clipboard m) (ed-clipboard-note (*clipboard-writer* text))
    (:client-clipboard m) (do (editor/serve/client-clipboard-set text) nil)
    else nil))

(defn ed-adopt-clipboard-text (m copied)
  "`m` with `copied` — what the OS clipboard holds — consed onto the kill ring as its freshest
entry when it is text the ring's head is not (something copied in another app since our last
kill). Emacs's `interprogram-paste-function`."
  (let (ring (:kill-ring m))
    (if (and (string? copied) (not (= copied "")) (not (= copied (first ring))))
      (assoc m :kill-ring (take (cons copied ring) ed-kill-ring-max))
      m)))

(defn ed-adopt-clipboard (m)
  "[[ed-adopt-clipboard-text]] with what the clipboard holds now ([[ed-clipboard-read]]):
something copied in another app since our last kill becomes the ring's freshest entry, so
the next yank inserts it. A missing / unavailable clipboard leaves the ring untouched."
  (let ([after-read text] (ed-clipboard-read-now m)) (ed-adopt-clipboard-text after-read text)))

;; ---- one ring for every frame ------------------------------------------------
;; A frame (C-x 5 2) is its own process with its own model, so each used to keep its own
;; ring: kill in one window, and M-y in the other could not reach it — only the OS
;; clipboard's single entry crossed. The ring now lives in an AGENT (`std/proc/agent`, a
;; process holding a value) that the live editor starts and every frame inherits
;; (`:kill-agent`). A kill publishes the whole ring there; a yank adopts it first, the way
;; it already adopts the OS clipboard. Tests build models without one and keep a local ring.

(defn ed-start-kill-agent ()
  "Start the process that holds the kill ring every frame shares; its pid."
  (agent/start (fn () '())))

(defn- ed-shared-ring (m)
  "The ring in the model's kill agent, or nil when it has none (or the agent is gone)."
  (let (kill-agent (:kill-agent m))
    (when (pid? kill-agent)
      (check-allow :discarded-catch
        (try (agent/get kill-agent identity) (catch _ nil))))))

(defn ed-set-kill-ring (m ring)
  "`m` with `ring` as its kill ring, published to the frames' shared agent when it has one.
`update`, not `cast`: the yank that follows a kill must find the kill there."
  (let (kill-agent (:kill-agent m))
    (when (pid? kill-agent)
      (check-allow :discarded-catch
        (try (agent/update kill-agent (fn (_) ring)) (catch _ nil))))
    (assoc m :kill-ring ring)))

(defn ed-adopt-shared-ring (m)
  "`m` with the ring every frame shares, when another frame has changed it."
  (let (shared (ed-shared-ring m))
    ;; `nil` is a list too (the empty one), and is what a model with no agent gets back
    (if (and (not (nil? shared)) (list? shared) (not (= shared (:kill-ring m))))
      (assoc m :kill-ring shared)
      m)))

(defn ed-kill-head (m)
  "`[m' text]`: the text a yank inserts now — the kill-ring head after adopting the ring
the frames share and then the clipboard as it reads now ([[ed-clipboard-read]]) — or
`[m' nil]` when the ring is empty."
  (let ([after-read text] (ed-clipboard-read-now m)) (ed-kill-head-with after-read text)))

(defn ed-kill-head-with (m copied)
  "[[ed-kill-head]] with the clipboard's text `copied` already known — what a yank that ASKED
for it ([[ed-clipboard-ask]]) inserts."
  (let (shared (ed-adopt-shared-ring m)
        adopted (ed-adopt-clipboard-text shared copied)
        ;; a clipboard entry adopted here belongs to every frame's ring too
        published (if (= (:kill-ring adopted) (:kill-ring shared))
                    adopted
                    (ed-set-kill-ring adopted (:kill-ring adopted)))
        ring (:kill-ring published))
    [published (if (empty? ring) nil (first ring))]))

;; ---- pushing onto the ring: what a kill or a copy does ----------------------
;; Commands whose consecutive use coalesces into one kill-ring entry (like Emacs).
;; Every command that kills, so consecutive kills coalesce into one entry (Emacs
;; `kill-append`). `cmd-copy-region` is here on purpose: Emacs's copy-region-as-kill appends
;; after a kill too. A kill command without the `:kill` trait silently starts a new entry —
;; `M-k M-k` used to leave two sentences on the ring instead of one.

(defn ed-push-kill (m text forward?)
  "Push killed `text` onto the kill ring. If the previous command was also a kill,
**append** to the current head entry instead of starting a new one — at the end for
a forward kill, the front for a backward kill (Emacs's consecutive-kill coalescing).
Otherwise cons a fresh entry. The new ring head is also mirrored to the user's clipboard
([[ed-clipboard-write]]: the OS one, or a served session's client's) so every kill / copy is system-wide — Emacs's
`interprogram-cut-function` / `select-enable-clipboard`; `cmd-yank` reads it back."
  (let (ring (:kill-ring (ed-adopt-shared-ring m))
        coalesce? (and (command-trait? (:last-command m) :kill) (not (empty? ring)))
        head (if coalesce?
               (if forward? (str (first ring) text) (str text (first ring)))
               text)
        tail (if coalesce? (rest ring) ring)
        said (ed-clipboard-write m head)
        pushed (ed-set-kill-ring (if (:os-clipboard m) (ed-clipboard-set-known m head) m)
                 (take (cons head tail) ed-kill-ring-max)))
    ;; a clipboard that could not take it (too large for a terminal's OSC 52) says so
    (if (string? said) (message pushed said) pushed)))

(defn ed-clipboard-set-known (m text)
  "`m` after the editor put `text` on the OS clipboard: the epoch moved, so a read asked
before this answers nothing over it, and — when what the clipboard holds was known (the
window reports its focus) — known to be `text`. Not made known otherwise: a frontend that
reports no focus would then never read another app's copy again."
  (let (moved (assoc m :clipboard-epoch (inc (:clipboard-epoch m 0))))
    (if (:clipboard-known? m) (assoc moved :clipboard-text text) moved)))

(defn ed-primary-write (m text)
  "Own the PRIMARY selection with `text` — what a middle click in any app then pastes —
leaving the CLIPBOARD alone: the local window's (`:os-clipboard`), or for a served session
the client machine's, a cast over the link (`editor/serve/client-primary-set`, brood
ADR-562). Nothing for a model with neither. Returns nil."
  (cond
    (:os-clipboard m) (*primary-writer* text)
    (:client-clipboard m) (editor/serve/client-primary-set text))
  nil)

;; ---- reading the PRIMARY selection, off the loop ----------------------------------
;; A middle click pastes PRIMARY — into a buffer (`killing/ed-mouse-yank-primary`) or into a
;; terminal's program (`terminal/term-mouse`). Reading it waits on the app that owns it (brood
;; ADR-536, ADR-553), and a served session's is on the client's machine (ADR-562), so it is
;; ASKED, the clipboard's way ([[ed-clipboard-ask]]): the asker goes on with a continuation
;; when the text is known, and the loop draws and takes keys meanwhile.

(register-task-reply :primary-proc
  'clipboard/ed-primary-landed
  :clipboard-unread nil
  {:cancel-on-quit? true :on-quit 'clipboard/ed-primary-quit})

;; check-allow: the continuation is resolved late (`reflect/eval`), so its result is unknown
;; to the checker; every `then` is a fold, and answers a model
(sig ed-primary-ask (model symbol any &optional (or nil symbol) -> model))
(check-allow :trusted
  (defn ed-primary-ask (m then data &optional quit)
    "Ask for the PRIMARY selection model `m` shares and go on with `(then m' text data)` once
it is known — `text` nil when the selection is empty, unreadable or there is none to read.
`quit`, a `(model data) -> model` symbol, runs instead when C-g cancels the read.

The local window (`:os-clipboard`) reads it in a task on `:primary-proc` (inline when there
is no loop to answer, a test); while one read is out a second ask is dropped — `m` comes back
as it was. A served session (`:client-clipboard`) asks its client
(`editor/serve/client-primary-ask`, brood ADR-562); the `[:primary ref text]` answer runs
`then` through the clipboard's table ([[ed-ev-clipboard]]). A model with neither has no
PRIMARY: `then` runs now with nil."
    (cond
      (:client-clipboard m)
        (let (asked (editor/serve/client-primary-ask))
          (if (nil? asked)
            ((reflect/eval then) m nil data)
            (assoc m
              :clipboard-asks (assoc (or (:clipboard-asks m) {}) asked {:then then :data data}))))
      (not (:os-clipboard m)) ((reflect/eval then) m nil data)
      (:primary-proc m) m
      (ed-headless?)
        (let (text (ed-read-clipboard-with *primary-reader*))
          ((reflect/eval then) m (if (string? text) text nil) data))
      else
        (let (reader *primary-reader*)
          (assoc m
            :primary-proc
              (task/task (fn () (ed-read-clipboard-with reader))
                {:timeout *clipboard-read-timeout-ms*})
            :primary-then {:then then :data data :quit quit})))))

(defn ed-primary-asking? (m)
  "Whether a read of the local PRIMARY selection is still out ([[ed-primary-ask]])."
  (not (nil? (:primary-proc m))))

;; check-allow: the continuation is resolved late, as in `ed-primary-ask`
(check-allow :trusted
  (defn ed-primary-landed (m text)
    "The local PRIMARY read's answer: its asker's continuation run with `text` (nil for an
empty or unreadable selection)."
    (let (pending (:primary-then m)
          landed (dissoc m :primary-proc :primary-then))
      (if (nil? pending)
        landed
        ((reflect/eval (:then pending)) landed (if (string? text) text nil) (:data pending))))))

(defn ed-primary-quit (m)
  "C-g while a PRIMARY read is out: the task is already killed; the asker's `quit` runs."
  (let (pending (:primary-then m)
        cleared (dissoc m :primary-then))
    (if (and pending (:quit pending))
      ((reflect/eval (:quit pending)) cleared (:data pending))
      cleared)))

(defn ed-drag-select (m)
  "A mouse drag-select ended with a real region: the region stays highlighted and its text
becomes the PRIMARY selection ([[ed-primary-write]]) — and that is all. The kill ring and
the OS CLIPBOARD are not touched, as in Emacs (`select-enable-clipboard` t,
`mouse-drag-copy-region` nil, `select-active-regions` t): highlighting text never throws
away what was copied in another app. M-w copies it as any region.

With the `:mouse-drag-copy-region` setting on (Emacs's variable of that name), the region is
also copied to the kill ring — and so the clipboard, [[ed-push-kill]] — as its own entry
(`:last-command` cleared: never appended to a prior kill). Silent either way, and a no-op
when the press selected nothing."
  (let (text (buffer-region (ed-current-buf m)))
    (cond
      (nil? text) m
      (:mouse-drag-copy-region m)
        (do (ed-primary-write m text) (ed-push-kill (assoc m :last-command nil) text true))
      else (do (ed-primary-write m text) m))))
