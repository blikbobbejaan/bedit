(defmodule statusbar
  "The status bar (mode line) as an **abstraction layers can extend**, not a hand-built
string. A bar is a list of **segments** — each a small map `{:id :text :face :on-click
:tooltip}` — laid out by `statusbar-layout` into render ops **and** interaction zones. That
one function is called by both the view (to draw the bar) and the mouse handler (to hit-test
hover / click), so a segment is clickable and hoverable *exactly* where it is drawn — the
same one-pass paint-and-hit-test discipline the `ui-kit` widgets (src/ui-kit.blsp) use.

Layers put their own info on the bar through the buffer's `:modeline` service (see
`model/ed-layer-modeline-segments`): a service returns a segment (built with `seg`), or a
bare string, which `coerce-seg` lifts into one — so the old string contributions keep
working. The git layer, say, contributes a clickable branch segment and a colour-coded
working-tree indicator, each with a hover tooltip.

The look follows `docs/ui-chrome.md`: a hovered interactive segment lightens one surface
step (a rounded pill in the GUI, a flat band in the terminal) — surfaces + hairlines, never
a shadow. Every `def` is live-redefinable (ricing)."
  (:use editor/display) ; text / rect / zone / card-pill / tooltip
  (:use theme) ; the bar + hover + tooltip faces
  (:use ui-kit) ; ui-tooltip-area — a tooltip placed by the one floating-card rule
  (:use memo)) ; defmemo — the chips' rank order, sorted once per registration
;; ---- a segment --------------------------------------------------------------

(defn seg (id text &optional (opts {}))
  "A status-bar segment. `id` is a keyword (stable, so hover/hit can name it); `text` is
what shows on the bar. `opts`:
  `:sep`      — a separator string drawn *before* the segment, outside its clickable zone
                (e.g. `\"  \"` or `\"  —  \"`). Default `\"\"`.
  `:face`     — a face for the text (`{:fg …}`; the `:bg` is inherited from the bar). nil.
  `:on-click` — a command **symbol**, resolved late like a keymap binding (`(m key) -> m`),
                run when the segment is clicked. nil ⇒ not clickable.
  `:tooltip`  — a hover hint: a string, a vector of lines, or a fn `(m) -> lines`. nil.
  `:cursor`   — a pointer shape while hovered (a `cursor-zone` shape). nil."
  {:id id
   :text text
   :sep (:sep opts "")
   :face (:face opts)
   :on-click (:on-click opts)
   :tooltip (:tooltip opts)
   :cursor (:cursor opts)})

(defn coerce-seg (x i)
  "Coerce a layer's `:modeline` contribution into a segment map: a bare string becomes a
segment (auto id `:seg/<i>`, a leading `\"  —  \"` separator, matching the old string bar); a
map is returned unchanged (assumed built with `seg`). `i` gives the string case a stable id."
  (if (string? x)
    (seg (keyword (str "seg/" i)) x {:sep "  —  "})
    x))

(defn seg-interactive? (s)
  "Whether segment `s` reacts to the pointer — it has a click command or a tooltip."
  (or (:on-click s) (:tooltip s)))

(defn seg-tooltip-lines (s m)
  "The tooltip for segment `s` as a vector of lines: a fn `:tooltip` is called with the model
`m`, a string is a single line, a vector is used as-is; nil ⇒ `nil` (no tooltip)."
  (let (tt (:tooltip s))
    (cond
      (nil? tt) nil
      (fn? tt) (tt m)
      (string? tt) [tt]
      else tt)))

;; ---- layout: segments -> render ops + interaction zones ---------------------

(defn- sb-clip (s n)
  "`s` truncated to at most `n` display cells (never negative) — cells, not characters, so a
wide glyph in a buffer name no longer pushes the segments after it, and their click zones,
out of line with what is painted."
  (string/clip-cells s (math/max 0 n)))

;; The hover block's geometry, from ui-kit's spacing table (cell units). The block is
;; decoration inside the bar's row — it never moves the text — so it may use the sub-cell
;; steps: its border's OUTER edge clear of the bar's own top and bottom rule (a hairline each)
;; by a hairline of air, and the fill half a cell out from the text at each side.
;; row edge to the border's outer edge: the bar's rule, then the air inside it
(def *sb-hover-vinset* (+ (ui-kit/ui-space :hairline) (ui-kit/ui-space :hover-inset)))
(def *sb-hover-pad* (ui-kit/ui-space :hover-pad)) ; text to the fill's edge, each side
(def *sb-hover-radius* 0.28) ; a hair of corner rounding — a bordered block, not a pill
(def *sb-hover-border* (ui-kit/ui-space :hairline)) ; the border's thickness
(defn- sb-hover-block (tcol row tw)
  "A bordered, inset hover **block** behind a `tw`-cell segment text at (`tcol`, `row`): a
border-coloured `frect` with the fill inset inside it, floated within the bar with vertical
margin + horizontal padding — a crisp bordered button-hover (Emacs `mouse-face` with an edge).
GUI-only; the terminal uses a flat bg band. Returns [border-frect fill-frect]."
  (let (b *sb-hover-border*
        x (- tcol *sb-hover-pad*)
        y (+ row *sb-hover-vinset* b)
        w (+ tw (* 2 *sb-hover-pad*))
        h (- 1.0 (* 2 (+ *sb-hover-vinset* b))))
    [(frect (- x b)
       (- y b)
       (+ w (* 2 b))
       (+ h (* 2 b))
       face-modeline-hover-border
       1.0
       (+ *sb-hover-radius* b))
      (frect x y w h face-modeline-hover 1.0 *sb-hover-radius*)]))

(defn- sb-fit (s room)
  "`[clipped width]`: `s` cut to `room` display cells (`sb-clip`) and the cells it then
takes. One width measure when it fits — every segment's separator and label used to be
measured three or four times over (to clip, to place, to zone, to size its hover block)."
  (let (width (string/display-width s))
    (if (<= width (math/max 0 room))
      [s width]
      (let (clipped (sb-clip s room)) [clipped (string/display-width clipped)]))))

(defn- sb-push-text-ops (ops label tw tcol row face fg-face hov? gui?)
  "The highlight + text ops for one segment's `label` (`tw` cells wide) at column `tcol`,
consed onto the REVERSED op accumulator `ops`. `face` is the segment's fully-resolved face
(the bar's face with the segment's own overrides merged in) and `fg-face` the same without
its `:bg`. A hovered segment gets a **bordered, inset block** behind it — Emacs
`mouse-face` with a crisp edge (`sb-hover-block`, `docs/ui-chrome.md`). In the GUI the block
is a bordered `frect` pair and the text draws **fg-only** over it (a square text bg would
cover the block); in the terminal the text carries the highlight bg itself (no border — else
the bar bg it inherited)."
  (if gui?
    (let (under (if hov?
                  (let ([border fill] (sb-hover-block tcol row tw)) (cons fill (cons border ops)))
                  ops))
      (cons (text row tcol label fg-face) under))
    (cons (text row tcol label (if hov? (into face face-modeline-hover) face)) ops)))

(sig sb-segment-push
  ((tuple int list list) map int int map map any (or bool nil) -> (tuple int list list)))
(defn- sb-segment-push (acc s right row base-face base-fg hovered-id gui?)
  "The layout accumulator `acc` — `[end ops zones]`, the column the next segment starts at
and the ops and zones so far, both REVERSED — with segment `s` laid on a bar ending before
column `right`: its separator then its text in the segment's face (the bar's fg+bg, then the
segment's own overrides), on the hover highlight when it is the hovered interactive one, and
its zone over the text cells when it is interactive. `base-fg` is `base-face` without its
`:bg`, worked out once per bar.

Consed straight onto the accumulator rather than returned as per-segment lists the caller
splices: a mode line is laid again on every motion (line:col changes), and the two `append`s
and the `merge` + `dissoc` per segment were most of it — each a variadic prelude call with a
fixed cost of microseconds, on ten segments, before a single op was built."
  (let ([scol acc-ops acc-zones] acc
        [sep sep-w] (sb-fit (or (:sep s) "") (- right scol))
        tcol (+ scol sep-w)
        [label tw] (sb-fit (:text s) (- right tcol))
        interactive? (seg-interactive? s)
        own (:face s)
        ;; a segment with no face of its own takes the bar's as it is — no merge
        face (if (nil? own) base-face (into base-face own))
        fg-face (cond
                  (not gui?) face
                  (nil? own) base-fg
                  else (dissoc face :bg))
        ops (if (= sep "") acc-ops (cons (text row scol sep base-face) acc-ops)))
    [(+ tcol tw)
      (sb-push-text-ops ops
        label
        tw
        tcol
        row
        face
        fg-face
        (and (= (:id s) hovered-id) interactive?)
        gui?)
      (if interactive? (cons (zone [tcol row tw 1] (:id s) (:cursor s)) acc-zones) acc-zones)]))

;; `gui?` arrives as `(:gui m)` — nil in a terminal model — so the optional admits nil; as a
;; plain `bool` the runtime contract (ADR-380, on by default under `nest test`) refused
;; every terminal frame.
(sig statusbar-layout (list int int int map any &optional (or bool nil) -> map))
(defn statusbar-layout (segments x row w base-face hovered-id &optional (gui? false))
  "Lay `segments` left-to-right from column `x` on `row`, across a `w`-wide bar filled in
`base-face`. Returns `{:ops <render ops> :zones <interaction zones>}`: a full-width bar fill,
then each segment (`sb-segment-push`: its `:sep`, then its `:text` in the segment's face),
with the segment whose id is `hovered-id` — when interactive — sitting on a subtle hover
highlight. Each interactive segment gets a `zone` over its text cells (id = the segment's
id), so the mouse handler hit-tests hover/click against exactly the drawn glyphs. `gui?`
picks the rounded pill over the flat terminal band. Text past the bar's right edge is
clipped, never wrapped."
  (if (empty? segments)
    {:ops (list (rect row x w 1 base-face)) :zones []}
    ;; the ops and zones are consed onto REVERSED accumulators and reversed once: appending
    ;; each segment's onto everything laid so far re-copied the whole bar per segment
    (let (right (+ x w)
          base-fg (dissoc base-face :bg)
          laid (fold segments
                 [x (list (rect row x w 1 base-face)) '()]
                 (fn (acc s) (sb-segment-push acc s right row base-face base-fg hovered-id gui?))))
      {:ops (reverse (second laid)) :zones (reverse (nth laid 2))})))

(defn statusbar-zones (segments x row w &optional (gui? false))
  "The interaction zones `statusbar-layout` gives `segments` on a `w`-wide bar at `[x row]`
— what the pointer hit-tests — remembered on the facts a zone is laid from (each segment's
id, text, separator, pointer cursor and whether it is interactive) and the bar's geometry.
The segments are rebuilt per pointer move with fresh `:tooltip` / `:on-click` closures that
never compare `=`, so the facts are the key, as the view's own bar memo does
(`view/ed-modeline-layout-ops`): a move along the bar lays it out once, not per cell."
  (statusbar-zones-at (map segments
                        (fn (s)
                          [(:id s)
                            (:text s)
                            (:sep s)
                            (:cursor s)
                            (if (seg-interactive? s) true false)]))
    x row w gui?))

;; check-allow: a hit comes back out of the memo's store, which the checker reads as
;; unknown; the store only ever holds what the body below built, a zone vector.
(check-allow :trusted
  (defmemo statusbar-zones-at 4 (facts x row w gui?)
    "`statusbar-zones` over the segments' layout facts: the bar laid out from segments
rebuilt out of them — a zone's place depends on no face and no hover."
    (:zones (statusbar-layout (map facts
                                (fn ([id text sep cursor interactive?])
                                  {:id id :text text :sep sep :cursor cursor :on-click interactive?}))
              x
              row
              w
              {}
              nil
              gui?))))

;; ---- the hover tooltip ------------------------------------------------------

(defn seg-by-id (segments id)
  "The segment in `segments` with `:id` `id`, or nil."
  (first (seq/filter segments (fn (s) (= (:id s) id)))))

(defn tooltip-card-ops (anchor-row anchor-col lines stage cols rows gui?)
  "A tooltip card of `lines` for cell `(anchor-row, anchor-col)`, placed by the one
floating-card rule (`ui-kit/ui-tooltip-area`: above the anchor, else below it, `:card-gap`
off the chrome around `stage`) and drawn by `display/tooltip` — handed the anchor just
under the placed rect, which its own on-screen clamp then leaves where it is. The mode
line's tooltips and a diagnostic's both draw through here."
  (let ([col row _ h] (ui-tooltip-area anchor-row anchor-col lines stage cols rows))
    (tooltip (+ row h)
      col
      lines
      face-tooltip
      face-tooltip-fg
      cols
      rows
      gui?
      {:border face-tooltip-border})))

(defn statusbar-tooltip-ops (segments hovered-id m anchor-col row cols rows gui? stage)
  "Render ops for the hovered segment's tooltip, or `nil` — a small bordered card floated
above bar `row` at `anchor-col` (the pointer column), `:card-gap` clear of the bar and kept
inside `stage` (the pane's text rows, `panes/ed-card-stage`) by [[tooltip-card-ops]].
Resolves the hovered segment's `:tooltip` against the model `m` (`seg-tooltip-lines`); `nil`
when there is no hovered segment or it has no tooltip."
  (let (s (seg-by-id segments hovered-id)
        lines (and s (seg-tooltip-lines s m)))
    (if (or (nil? lines) (empty? lines))
      nil
      (tooltip-card-ops row anchor-col lines stage cols rows gui?))))

;; ---- the feature chips: a registry, so the view names no feature ------------
;; The selected pane's bar carries chips that belong to features — the running app, the
;; attached node, a shared buffer's presence, the findings count. The view used to build
;; each one by name, which made the pure view import half the editor to draw one row. A
;; feature now REGISTERS its chip when its module loads, the same shape as
;; `model/register-timer-client`: a module nobody has loaded is not on the bar, which is
;; also what every one of those chips did before (each read model state only its own
;; module ever sets).

;; chip id -> `{:rank n :segment sym}`, in a `std/registry` (brood ADR-412).

(defn register-modeline-segment (id rank segment)
  "Put a feature's chip on the selected pane's mode line. `segment` names a `(m pane buf)
-> seg or nil` function (a symbol, resolved late, so a redefinition hot-swaps); a nil, or
a segment whose text is `\"\"`, shows nothing. `rank` orders the chips left to right among
themselves and the view's own (`view/ed-statusbar-segments` documents the ranks it uses).
Called when the feature's module loads; registering `id` again replaces it."
  (ownership/claim! :statusbar/segments id {:rank rank :segment segment}))

;; check-allow: a hit comes back out of the memo's store, which the checker reads as
;; unknown; the store only ever holds what the body below built, a list of entries.
(check-allow :trusted
  (defmemo modeline-chip-order 1 (entries)
    "The registry's chip `entries` (`{id -> {:rank :segment}}`) as a list in rank order.
Remembered on the registry's own map, which only a registration replaces: the bar is drawn
every frame, and sorting the same handful of chips every time cost more than building them."
    (seq/sort-by (vals entries) :rank)))

(defn modeline-registered-segments (m pane buf)
  "The registered chips for `pane` as `{:rank :segment}` entries in rank order, each segment
built now — possibly nil (the caller drops the empty ones). A chip whose function is no
longer bound is skipped rather than raised on: the bar is drawn every frame."
  (seq/keep (modeline-chip-order (registry/entries :statusbar/segments))
    (fn (entry)
      (let (sym (:segment entry))
        ;; resolved and called once the `bound?` test has passed — `call-if-bound` would ask
        ;; `bound?` again and spread the arguments through `apply`, per chip, per frame
        (when (bound? sym)
          {:rank (:rank entry) :segment ((reflect/eval sym) m pane buf)})))))
