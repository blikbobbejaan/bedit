(defmodule fill
  "Filling — M-q (`fill-paragraph`) and `auto-fill-mode` — as the editor's POLICY over std's
`string/fill`: which lines are the paragraph, which prefixes it keeps, where point lands.

**The prefixes** are Emacs's adaptive fill (`string/fill-prefixes`): the first line keeps its
own — indentation, a comment or quote marker, a list bullet — and the lines after it take the
paragraph's SECOND line's, or for a one-line paragraph the first's with its bullet turned to
spaces. So a list item continues under its text (a HANGING indent), a comment paragraph keeps
its marker, and an indented paragraph keeps its indentation. A mode may answer for itself
through its `:fill-prefixes` facet (Emacs's `adaptive-fill-function`): the Lisps continue a
one-line docstring at column 0 (`docstring-fill-prefixes`).

**The markers are the MODE's** (`fill-markers`, Emacs's per-mode `adaptive-fill-regexp`): a
code mode's comment tokens from its string syntax (`stringstate/syntax-of`) — `#` in Python,
`;` in a Lisp, `//` and a block comment's ` * ` in C and JavaScript — Markdown's quote `>`, and in
other text std's common ones. So in C a run of `#include` lines is code, not a comment, and in
Markdown a `#` heading
is not a marker.

**The paragraph** is the run of non-blank lines around point, narrowed the way Emacs's modes
narrow it with `paragraph-start`:
  - to the lines that share point's line's comment or quote MARKER — so M-q in a comment
    above code fills the comment and leaves the code alone, and a `> ` quote stops at the
    text after it; a line that is a bare marker (`;;`, `#`, `>`) separates paragraphs, and so
    does a block comment's lone opener or closer (`/**`, `*/`);
  - to the list ITEM point is in — a line starting with a bullet starts a new one, so a list
    is never run together into one line;
  - by the mode's `:fill-separate` facet, a regex of lines that are paragraphs of their own
    (an Org heading, a Markdown fence or heading);
  - in code, outside a comment, to the text of the string point is in, when that string can
    span lines (a docstring, a triple-quoted string), found by the mode's string syntax
    (`stringstate`) — only the string's own text, never the code around it. Anywhere else in
    code there is nothing to fill, as in Emacs.

**Point** stays on the character it was on: it is tracked by the paragraph's text without its
prefixes (`body-index`), so neither the markers nor the whitespace a refill changes move it.

**Auto-fill** (`M-x auto-fill-mode`, per buffer; the `:auto-fill` setting per mode, as a
`text-mode-hook` turns it on) breaks the line at the last space within the fill column when a
space or RET is typed past it, the new line starting with the paragraph's continuation prefix,
in the same undo step as the space or RET (`auto-filled`). In a code buffer — one whose mode
stacks over `prog` — only a comment is broken (Emacs's `comment-auto-fill-only-comments`): a
comment line, or the comment after code on a line, which goes on at its own column with its
marker (Emacs's `comment-indent-new-line`), the code never broken. A line needing many breaks gets
them all in one left-to-right pass (`break-tail`)."
  (:use editor/buffer) ; buffer-rope / buffer-point / replace-region
  (:use interactive) ; defcommand — M-q and the auto-fill toggle
  (:use scroll :only [ed-mode-setting])
  (:use conventions :only [fill-column])
  (:use stringstate :only [ed-string-extent]) ; the string M-q fills in code
  (:use model)) ; ed-edit, ed-current-buf, ed-mode-service, message

;; ---- a line's shape ---------------------------------------------------------------

(sig line-text (any int -> string))
(defn- line-text (rope line)
  ;; line `line` of `rope` without its newline
  (let (text (text/line rope line))
    (if (string/ends-with? text "\n") (string/substring text 0 (dec (string/length text))) text)))

(defn- blank-line? (text) (= (string/trim text) ""))

(defn- prog? (buf)
  ;; a code buffer: its mode stacks over `prog`
  (= true (ed-mode-setting {:prog true} buf false)))

(defn fill-markers (buf)
  "The comment and quote markers `buf`'s paragraphs keep on every line (Emacs's per-mode
`adaptive-fill-regexp`): its mode's `:fill-markers` facet when it has one; in code, its line
comment tokens and — with block comments — the ` * ` their lines continue with
(`stringstate/syntax-of`); in other text, nil — std's common markers (`;` `#` `//` `--` `>`), as
Emacs's default `adaptive-fill-regexp` keeps them in any text. Markdown names its own (`>`)."
  (let (custom (ed-mode-service buf :fill-markers))
    (cond
      (vector? custom) custom
      (prog? buf)
        (let (syntax (stringstate/syntax-of buf))
          (into (vec (or (:comments syntax) []))
            ;; a block comment's ` * ` lines, and its opener as the marker of its first line
            (let (blocks (or (:block-comments syntax) []))
              (if (empty? blocks) [] (into ["*"] (map blocks first))))))
      else nil)))

(defn line-marker (text markers)
  "The comment or quote marker `text`'s line carries, of `markers` — `;;`, `#`, `>` — or \"\" for
none: what a paragraph's lines must share to be filled together."
  ;; a one-line paragraph's rest prefix is its marker with any bullet blanked out
  ;; a block comment's opener (`/*`, `/**`) and its ` * ` lines are one family: the comment
  ;; fills from its first line
  (let (marker (string/trim (second (string/fill-prefixes text markers))))
    (if (regex/match? "^/?\\*+$" marker) "*" marker)))

(defn item-line? (text markers)
  "True when `text` starts a list item — a bullet after its indentation and marker."
  (let ([first-prefix rest-prefix] (string/fill-prefixes text markers))
    (not (= first-prefix rest-prefix))))

(defn- bare-marker? (text markers)
  ;; a line that is a marker and nothing else — `;;`, `#`, `>` — a paragraph separator
  (let (prefix (string/fill-prefix text markers))
    (and (not (blank-line? text))
      (not (= "" (string/trim prefix)))
      (blank-line? (string/substring text (string/length prefix) (string/length text))))))

(def- *quote-line* "^[ \t]*(\"\"\"|'''|\"|'|```)[ \t]*$")
;; a line that is only a string's delimiter — a Python docstring's closing `"""` — which is never
;; filled into the text above it, in any mode

(defn- block-edge-pattern (buf)
  ;; a line that is only a block comment's opener or closer (`/*`, `/**`, `*/`), or nil
  (let (blocks (when (prog? buf) (:block-comments (stringstate/syntax-of buf))))
    (when (and blocks (not (empty? blocks)))
      (str "^[ \t]*(?:"
        (string/join (map blocks
                       (fn (pair)
                         (str (regex/escape (first pair)) "\\**|\\**" (regex/escape (second pair)))))
          "|")
        ")[ \t]*$"))))

(defn- separate? (context text)
  ;; a line that is a paragraph of its own: the mode's `:fill-separate` regex, a quote line, a
  ;; block comment's edge, or a bare marker
  (let ({:keys [separate edges markers]} context)
    (or (regex/match? *quote-line* text)
      (and (string? separate) (regex/match? separate text))
      (and (string? edges) (regex/match? edges text))
      (bare-marker? text markers))))

;; ---- the paragraph ----------------------------------------------------------------

(defn- line-in-extent? (rope extent line)
  ;; whether `line` overlaps the char `extent` — every line does when there is none
  (or (nil? extent)
    (let (bol (text/line->char rope line))
      (and (< bol (second extent))
        (>= (+ bol (string/length (line-text rope line))) (first extent))))))

(defn- line-belongs? (rope context marker extent line)
  ;; whether `line` is part of the paragraph: non-blank, not a separate line, carrying the
  ;; paragraph's marker and, in a string, one of its lines
  (let (text (line-text rope line))
    (and (not (blank-line? text))
      (not (separate? context text))
      (= (line-marker text (:markers context)) marker)
      (line-in-extent? rope extent line))))

(defn- fill-context (buf)
  ;; what deciding a paragraph's lines needs of `buf`'s mode, read once
  {:markers (fill-markers buf)
   :separate (ed-mode-service buf :fill-separate)
   :edges (block-edge-pattern buf)})

(defn paragraph-lines (buf &optional (string-extent nil))
  "The `[first last]` lines M-q fills around point in `buf`, or nil when there is nothing to
fill (point on a blank line with only blank lines after it, or on a separate line). Point on a
blank line fills the paragraph after it, as Emacs's does. In code, the lines of the comment
point is in, or of the string `string-extent` (`[start end]`, `stringstate/ed-string-extent`: a
string that can span lines) — anywhere else nothing, as Emacs's `fill-paragraph` leaves code
alone."
  (let (rope (buffer-rope buf)
        n (text/line-count rope)
        context (fill-context buf)
        markers (:markers context)
        start-line (text/char->line rope (buffer-point buf))
        here (letrec (skip (fn (i)
                             (cond
                               (>= i n) nil
                               (blank-line? (line-text rope i)) (skip (inc i))
                               else i)))
               (skip start-line))
        marker (when here (line-marker (line-text rope here) markers))
        ;; in code and not in a comment: only inside a string, and only its lines
        extent (when (and here (= marker "") (prog? buf)) string-extent))
    (when (and here
            (not (separate? context (line-text rope here)))
            (or (not (= marker ""))
              (not (prog? buf))
              (and extent (line-in-extent? rope extent here))))
      (let (
            ;; up: stop BELOW a non-member, and AT an item line (it starts this item)
            top (letrec (up (fn (i)
                              (cond
                                (item-line? (line-text rope i) markers) i
                                (and (> i 0) (line-belongs? rope context marker extent (dec i)))
                                  (up (dec i))
                                else i)))
                  (up here))
            ;; down: stop before a non-member or the next item
            bottom (letrec (down (fn (i)
                                   (if (and (< (inc i) n)
                                         (line-belongs? rope context marker extent (inc i))
                                         (not (item-line? (line-text rope (inc i)) markers)))
                                     (down (inc i))
                                     i)))
                     (down here)))
        [top bottom]))))

(sig line-range-text (any int int -> string))
(defn- line-range-text (rope first-line last-line)
  ;; lines `first-line`..`last-line` of `rope`, without the newline after the last
  (let (start (text/line->char rope first-line)
        end (if (< (inc last-line) (text/line-count rope))
              (dec (text/line->char rope (inc last-line)))
              (text/length rope)))
    (text/slice rope start end)))

(defn docstring-fill-prefixes (text &optional (markers nil))
  "The Lisps' `:fill-prefixes` (Emacs's `adaptive-fill-function` for them): a one-line
paragraph whose text opens a string — a docstring's first line — continues at column 0, as a
Lisp docstring's lines do; anything else is `string/fill-prefixes`'.

    (fill/docstring-fill-prefixes \"  \\\"Doc\")   ;=> [\"  \" \"\"]"
  (let (prefixes (string/fill-prefixes text markers)
        lines (seq/reject (string/split text "\n") blank-line?)
        first-line (if (empty? lines) "" (first lines))
        body (string/substring first-line
               (string/length (first prefixes))
               (string/length first-line)))
    (if (and (= (count lines) 1) (string/starts-with? body "\""))
      [(first prefixes) ""]
      prefixes)))

(defn paragraph-prefixes (buf text)
  "The `[first rest]` prefixes paragraph `text` of `buf` fills with: the mode's
`:fill-prefixes` when it has one, else `string/fill-prefixes` with the mode's markers. A
block comment filled from its opener's line continues with ` * ` under it (`/* aa` →
` * bb`), never with a second opener."
  (let (custom (ed-mode-service buf :fill-prefixes)
        markers (fill-markers buf)
        [first-prefix rest-prefix] (if (fn? custom)
                                     (custom text markers)
                                     (string/fill-prefixes text markers)))
    [first-prefix
      (if (regex/match? "^[ \t]*/\\*" rest-prefix)
        (regex/replace "^([ \t]*)/\\*+" rest-prefix "$1 *")
        rest-prefix)]))

;; ---- point across a refill ---------------------------------------------------------------
;; Point is kept by the paragraph's BODY — its text without each line's prefix — counted in
;; non-whitespace characters: a refill changes only whitespace and prefixes.

(defn- body-start (line prefix)
  ;; where `line`'s body starts: after `prefix` when it starts with it
  (if (and (not (= prefix "")) (string/starts-with? line prefix)) (string/length prefix) 0))

(defn- line-starts (text)
  ;; `[[offset line] …]`: each line of `text` with the offset it starts at
  (second (fold (string/split text "\n")
            [0 []]
            (fn ([at acc] line) [(+ at (string/length line) 1) (conj acc [at line])]))))

(defn body-index (text prefixes offset)
  "How many non-whitespace BODY characters of paragraph `text` lie before `offset` — the body
being each line without its prefix (`prefixes` `[first rest]`). Point on a prefix counts as on
its line's body start."
  (let ([first-prefix rest-prefix] prefixes)
    (fold (seq/enumerate (line-starts text))
      0
      (fn (acc [i [at line]])
        (let (from (+ at (body-start line (if (= i 0) first-prefix rest-prefix)))
              to (math/min (+ at (string/length line)) offset))
          (if (or (not (int? from)) (not (int? to)) (<= to from))
            acc
            (+ acc
              (count (seq/reject (string/->list (slice-of text from to)) string/blank?)))))))))

(sig slice-of (string int int -> string))
(defn- slice-of (text from to)
  ;; `text` from `from` to `to`
  (string/substring text from to))

(sig landing (int int int -> int))
(defn- landing (start offset cut)
  ;; where point lands in the buffer: `offset` in the padded refill, less the `cut` padding,
  ;; from `start`
  (+ start (- offset cut)))

(sig offset-of-body-index (string any int -> int))
(defn offset-of-body-index (text prefixes k)
  "The offset of paragraph `text`'s `k`th (0-based) non-whitespace body character — what point
lands on after a refill ([[body-index]]) — or the text's end when it has fewer."
  (let ([first-prefix rest-prefix] prefixes)
    (letrec (walk (fn (lines i seen)
                    (if (empty? lines)
                      (string/length text)
                      (let ([at line] (first lines)
                            from (body-start line (if (= i 0) first-prefix rest-prefix))
                            chars (string/->list (string/substring line from (string/length line)))
                            body (seq/keep (seq/enumerate chars)
                                   (fn ([j c]) (when (not (string/blank? c)) j)))
                            here (count body))
                        (if (< (- k seen) here)
                          (+ at from (or (nth (vec body) (- k seen)) 0))
                          (walk (rest lines) (inc i) (+ seen here)))))))
      (walk (line-starts text) 0 0))))

;; ---- M-q ------------------------------------------------------------------------------------

(defn fill-paragraph (buf &optional (string-extent nil))
  "`buf` with the paragraph around point refilled to its fill column, point kept on the
same character — the buffer M-q makes. `string-extent` is the string point is in, when it is
one that can span lines (`stringstate/ed-string-extent`): in code, what is filled — its text
alone, from its opener to its closer, the code on either side left where it is."
  (let (bounds (paragraph-lines buf string-extent))
    (if (nil? bounds)
      buf
      (let ([first-line last-line] bounds
            rope (buffer-rope buf)
            line-start (text/line->char rope first-line)
            lines-text (line-range-text rope first-line last-line)
            lines-end (+ line-start (string/length lines-text))
            ;; in a string: only its text, which may begin and end mid-line
            start (if string-extent (math/max line-start (first string-extent)) line-start)
            end (if string-extent (math/min lines-end (second string-extent)) lines-end)
            ;; a string opened mid-line stands in for the code before it with spaces of its
            ;; width, so its first line's room is what the line has left
            pad (string/repeat " " (string/display-width (text/slice rope line-start start)))
            [first-prefix rest-prefix] (paragraph-prefixes buf lines-text)
            prefixes [(if (> start line-start) pad first-prefix) rest-prefix]
            text (str (if (> start line-start) pad "") (text/slice rope start end))
            filled-padded (string/fill text (fill-column buf) prefixes)
            cut (if (> start line-start) (string/length pad) 0)
            filled (string/substring filled-padded cut (string/length filled-padded))
            point (buffer-point buf)
            inside? (and (>= point start) (<= point end))
            kept (if inside? (body-index text prefixes (+ cut (- point start))) 0))
        (if (= filled (text/slice rope start end))
          buf
          (goto-char (replace-region buf start end filled)
            (if inside?
              (landing start (offset-of-body-index filled-padded prefixes kept) cut)
              (buffer-point buf))))))))

(defcommand cmd-fill-paragraph
  (m key)
  "Re-wrap the paragraph around point to the buffer's fill column (M-q;
`conventions/fill-column` — its .editorconfig's `max_line_length`, the user's
`:fill-column`, the mode's, else 70). The first line keeps its prefix and the lines after it
the paragraph's continuation prefix (`string/fill-prefixes`): a list item hangs under its
text, a comment keeps its marker. Only the comment, quote or list item point is in is filled
(`paragraph-lines`) — in code, only a string that can span lines — and point stays on the
character it was on."
  (let ([m2 extent] (stringstate/ed-string-extent m))
    (ed-edit m2 (fn (b) (fill-paragraph b extent)))))

;; ---- auto-fill ----------------------------------------------------------------------

(sig auto-fill? (model any -> bool))
(defn auto-fill? (m buf)
  "Whether `buf` auto-fills: its own `M-x auto-fill-mode` when toggled, else the `:auto-fill`
setting for its mode."
  (let (local (when buf (:auto-fill buf)))
    (cond
      (bool? local) local
      (nil? buf) false
      else (= true (ed-mode-setting (:auto-fill m) buf false)))))

(defn- column-of (text offset)
  ;; the display column `offset` in `text` (a line) reaches
  (string/display-width (string/substring text 0 offset)))

(defn- pieces (text)
  ;; `text` cut into `[separator word]` pairs, left to right: the run of spaces before each
  ;; word (\"\" before the first) and the word; a trailing run of spaces is a last pair with \"\"
  (let (found (regex/find-all "( *)([^ ]*)" text))
    (into []
      (seq/keep found
        (fn (match)
          (let (groups (:groups match)
                separator (or (:text (first groups)) "")
                word (or (:text (second groups)) ""))
            (when (not (and (= separator "") (= word ""))) [separator word])))))))

(defn break-tail (head tail cont limit)
  "The text `tail` (what follows the protected `head` on a line — a prefix, or code and its
comment's marker) re-broken in ONE left-to-right pass so every line fits `limit` display
columns: words stay on a line while it fits, measured from the line so far; where one does not,
the spaces before it become a newline and `cont` (the continuation prefix). A word too long for
any line keeps its own. Answers the new tail, or nil when nothing needed breaking — Emacs's
`do-auto-fill` loop, without re-measuring the line once per break."
  (let ([line broke? out] (fold (pieces tail)
                            [head false ""]
                            (fn ([line broke? out] [separator word])
                              (let (candidate (str line separator word))
                                (if (or (= word "")
                                      (<= (string/display-width candidate) limit)
                                      (= (string/trim line) (string/trim (if broke? cont head))))
                                  [candidate broke? (str out separator word)]
                                  [(str cont word) true (str out "\n" cont word)])))))
    (when broke? out)))

(defn- comment-after-code (buf text)
  ;; `[start marker]` of the comment that follows code on `text` (a line), or nil
  (let (syntax (stringstate/syntax-of buf)
        data (stringstate/lexer-data syntax [])
        tokens (:tokens (stringstate/lex-line data text [nil ""]))
        comment (last (seq/filter tokens
                        (fn (token)
                          (and (= (nth token 2) :comment)
                            (> (first token) 0)
                            (not (blank-line? (string/substring text 0 (first token)))))))))
    (when comment
      (let (start (first comment))
        [start
          (string/fill-prefix (string/substring text start (string/length text))
            (vec (or (:comments syntax) [])))]))))

(defn auto-fill-line (buf)
  "`buf` with point's line broken until it fits the fill column when the text before point runs
past it, or nil when it needs none: every break in one left-to-right pass (`break-tail`), each
new line starting with the paragraph's continuation prefix — the marker of a comment line every
time — and a comment after code going on at its own column with its marker (Emacs's
`comment-indent-new-line`); the code itself is never broken. The paragraph is read once."
  (let (rope (buffer-rope buf)
        point (buffer-point buf)
        line (text/char->line rope point)
        bol (text/line->char rope line)
        text (string/substring (line-text rope line) 0 (- point bol))
        limit (fill-column buf)
        markers (fill-markers buf)
        code-line? (and (prog? buf) (= "" (line-marker text markers)))
        plan (cond
               (<= (column-of text (string/length text)) limit) nil
               code-line?
                 (let (found (comment-after-code buf text))
                   (when found
                     (let ([start marker] found)
                       {:from (+ start (string/length marker))
                        :cont (str (string/repeat " " (column-of text start))
                                (string/trim marker)
                                " ")})))
               else
                 (let (bounds (paragraph-lines buf)
                       first-line (if bounds (first bounds) line)
                       ;; the prefixes are read from the paragraph's first line, and the line
                       ;; after it when point is past it — how the paragraph continues
                       context (if (< first-line line)
                                 (str (line-text rope first-line)
                                   "\n"
                                   (line-text rope (inc first-line)))
                                 text))
                   {:from (string/length (string/fill-prefix text markers))
                    :cont (second (paragraph-prefixes buf context))}))
        from (when plan (:from plan))
        tail (when (int? from)
               (break-tail (string/substring text 0 from)
                 (string/substring text from (string/length text))
                 (:cont plan)
                 limit)))
    (when (and (int? from) tail)
      ;; the tail before point is replaced; replace-region leaves point after it, where it was
      (replace-region buf (+ bol from) point tail))))

(defn auto-filled (m buf)
  "`buf` with its line auto-filled when it auto-fills in `m`, else `buf` — the step a typed space
or RET takes INSIDE its own edit, so one undo takes it all back. Broken until the line before
point fits (Emacs's `do-auto-fill` loop: a long line yanked or pasted, then a space), in one
pass (`auto-fill-line`)."
  (if (and buf (auto-fill? m buf) (not (read-only? buf)))
    (or (auto-fill-line buf) buf)
    buf))

(defcommand cmd-auto-fill-mode
  (m key)
  "Toggle auto-fill-mode in this buffer (Emacs `auto-fill-mode`): a space or RET typed past
the fill column breaks the line at its last space within it, the new line continuing the
paragraph's prefix. The `:auto-fill` setting turns it on per mode."
  (let (buf (ed-current-buf m)
        on (not (auto-fill? m buf)))
    (message (ed-set-buf m (assoc buf :auto-fill on))
      (if on "Auto fill mode enabled in this buffer" "Auto fill mode disabled in this buffer"))))
