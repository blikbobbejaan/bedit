(defmodule appearance
  "The window's type setup — family, size, line height — and **named presets** over it
(`M-x preset-select` / `preset-save` / `preset-delete`).

Two things live here. A ZOOM is per PANE — Ctrl+mouse-wheel, `C-x C-=`/`C-x C--`/`C-x C-0`:
the pane under the pointer, bigger; nothing else — and never touches the window's font. A PRESET names a whole
window setup you can switch to in one command. The second is what you want when a
call starts: `M-x preset-select` → `Presenting`, and the person on the other end of the
screen share can read your code. Then back to `Default` after.

Why a module and not two knobs. The window has no getter for what it is showing, so
something has to hold it — the model's `:appearance`. Once that exists, a preset is a saved
value of it, `preset-save` is just naming what you are looking at, and a pane's zoom is a
size relative to it. Themes set it too (a theme carries a font), so `themes/themes-apply` records
what it applied and a preset saved afterwards records the truth.

A preset is a plain map, like a theme: `{:name :family :height :line-height}`. The
built-ins are the floor; yours are saved beside them in the editor's state dir and win on
name, so redefining `Presenting` is just saving one with that name."
  (:use interactive) ; defcommand — register the preset commands for M-x
  (:use pool) ; ed-name-prompt — the Vertico selection prompt
  (:use projects) ; persist-read / persist-write! / editor-state-dir — the shared cache layer
  (:use minibuffer)
  (:use model) ; message — the echo-area status; ed-current-pane / ed-map-panes — the zoomed pane
  (:use editor/pane)) ; pane-update-path / pane-update-selected — writing a pane's zoom
;; ---- what the window is showing ---------------------------------------------

(def *default-appearance* {:family :editor :height 15 :line-height 1.25})
;; What `main` starts at (the init file's `:font`, registered as `:editor`, at its default
;; size). The model carries the live one; this is the fallback for a model that has not been
;; through `apply!` yet — a pure test, or the first frame before startup applies the config.

(def *min-height* 6) ; below this text is unreadable and the grid maths gets silly
(def *max-height* 72) ; above this a cell is bigger than most panes
(defn current (m)
  "The window's type setup as a map — the model's, or the default when it has none."
  (merge *default-appearance* (or (:appearance m) {})))

(defn clamp-height (px)
  "`px` held inside `*min-height*`..`*max-height*`."
  (math/max *min-height* (math/min *max-height* px)))

(defn apply! (m appearance)
  "Set the window's family/size/line-height from `appearance` and record it on the model.

The record is the point: `gui/font` and `gui/line-height` are writes with no read, so the
model is the only place that knows what is on screen. Every path that changes type goes
through here — startup, a theme, a preset — so none of them can leave the model describing
something the window is not. A pane's zoom does NOT come through here (it is not a window
change); it is measured against this, so a size change re-measures every zoom."
  (let (was (current m)
        ;; over what is showing, not the default: a partial apply must not silently reset
        ;; the fields it omits
        wanted (merge was appearance)
        height (clamp-height (:height wanted))
        ;; Write only what CHANGED. Each of these costs a full re-raster — the window
        ;; clears its glyph cache and re-shapes the cell on any `gui/font` or
        ;; `gui/line-height`, whether or not the value differs.
        font? (or (not (= (:family wanted) (:family was))) (not (= height (:height was))))
        line-height? (not (= (:line-height wanted) (:line-height was))))
    (when font? (theme/gui-only gui/font {:family (:family wanted) :height height}))
    (when line-height? (theme/gui-only gui/line-height (:line-height wanted)))
    (let (applied (assoc m :appearance (assoc wanted :height height)))
      (if font? (zoom-remeasure applied) applied))))

;; ---- the per-pane zoom (Ctrl+mouse-wheel, C-x C-= / C-x C-- / C-x C-0) ------------
;; A zoom is THIS pane, bigger; the rest of the window as it was. A size belongs to the pane
;; you point at, not to the window: a change to the window's font would shrink the grid,
;; re-lay every pane, move the status bar and re-rasterise the whole window per wheel event.
;;
;; The PANE, not the buffer — deliberately not Emacs's buffer-local `text-scale-adjust`. A
;; split shows the same buffer twice, and zooming one side must not zoom the other: the
;; thing under the pointer is what grows. So a pane's payload carries `:zoom {:px :ratio}` —
;; the size, and the size of one of its cells relative to the window's (`[rw rh]`, physical
;; px over physical px); switching buffers in the pane keeps it, like its line numbers. The
;; view paints such a pane inside a `cell-region` (brood ADR-363): a block laid out for the
;; rows and columns that fit at `px`, positioned in its own cell space, the mode line and
;; every other pane untouched. The window's font never changes on a zoom; `apply!` is for
;; presets.
;;
;; The ratio is MEASURED, not derived: a cell is whatever shaping the reference glyph gives,
;; rounded to whole pixels, so 16/15 is not 1.0667 of a cell — `gui/cell-size` asks the
;; window. Headless there is no window; the size ratio stands in, which keeps the geometry
;; honest in tests and in a `editor/frontend/*term-display*` session (where a region is skipped anyway).

(defdyn *zoom-step-lines* 3.0)
;; How much accumulated wheel delta buys one pixel of size — and the units matter.
;;
;; A wheel notch does NOT arrive as one event with `dy 1`. The runtime gives the notch an
;; impulse and a kinetic ticker delivers a decaying stream of events whose deltas sum to
;; about THREE lines (brood's `WHEEL_IMPULSE / (1 - WHEEL_DECAY)`, pinned by its own
;; `a_single_notch_glides_about_three_lines`). 3.0 means one notch is one pixel, which is
;; what a notch should be.
;;
;; A fast spin still zooms faster, by design rather than by accident: quick notches form a
;; streak the runtime boosts (capped), so more lines arrive per notch and the size moves in
;; bigger steps. Raise this for a slower zoom, lower it for a faster one.

(defn zoom-of (pane)
  "`pane`'s zoom — `{:px :ratio}` on its payload — or nil at the window's own size. Takes a
laid-out pane (`{:payload …}`) or a bare payload, so a command with only
`model/ed-current-pane` in hand can ask too."
  (:zoom (or (:payload pane) pane)))

(defn zoom-px (m pane)
  "The font size `pane` shows at: its own zoom, else the window's."
  (or (:px (zoom-of pane)) (:height (current m))))

(defn- cell-ratio (m px)
  "`[rw rh]` — a cell at `px` over the window's cell, both in physical pixels, measured by
the window (`gui/cell-size`) when there is one, else the size ratio. The measurement is what
makes a zoomed pane's rows and columns exact: the region is painted with the cell the
renderer shapes, and this is that cell, not an estimate of it."
  (let (base (:height (current m))
        window (:window m)
        ;; the error IS the answer here: no window, a headless build, a window closed under
        ;; us — every one means "measure nothing, use the ratio", so it is not read
        measured (when (and window (gui/available?))
                   (check-allow :discarded-catch
                     (try
                       [(gui/cell-size window) (gui/cell-size window px)]
                       (catch _e nil))))
        [[cell-width cell-height] [zoomed-width zoomed-height]] (or measured
                                                                  [[base base] [px px]]))
    [(/ zoomed-width (math/max 1 cell-width)) (/ zoomed-height (math/max 1 cell-height))]))

(defn zoom-payload (m payload px)
  "Pane `payload` zoomed to `px` — carrying the size and its measured cell ratio — or back
to plain when `px` is the window's own size, so an unzoomed pane has no zoom rather than a
zoom of one. The accumulator is kept: it is the wheel's leftover, not part of the size."
  (let (px (clamp-height px))
    (if (= px (:height (current m)))
      (dissoc payload :zoom)
      (assoc payload :zoom {:px px :ratio (cell-ratio m px)}))))

(defn- zoom-pane-with (m update px)
  "The model with `update` (a `(layout-update-fn) -> layout`, i.e. `pane-update-path` or
`pane-update-selected` partially applied) zooming its pane to `px`, the size it landed on
echo'd — the clamped one, so the readout never claims a size past the bounds.

Only in the GUI (`:gui`, what `main` sets under a window). A terminal cell has one size,
and the frontend-agnostic path a `editor/frontend/*term-display*` or `--attach` session renders through
SKIPS a `cell-region` — a zoom there would blank the pane. It says so instead."
  (if (not (:gui m))
    (message m "zoom needs the window: a terminal cell has one size")
    (let (px (clamp-height px))
      (assoc m
        :layout (update (fn (payload) (zoom-payload m payload px)))
        :echo (str "size " px " px")))))

(defn zoom-pane (m pane px)
  "The model with the laid-out `pane` (it carries its `:path`) zoomed to `px`."
  (zoom-pane-with m (fn (update) (pane-update-path (:layout m) (:path pane) update)) px))

(defn- whole-steps (acc step)
  "How many whole `step`s fit in `acc`, counted TOWARD ZERO. Deliberately not a floor:
floor(-0.6) is -1, so shrinking would step on a nudge while growing waited for a full
notch, and a zoom that is easier to shrink than to grow feels broken rather than sensitive."
  (let (whole (math/floor (/ (math/abs acc) step)))
    (if (< acc 0) (- 0 whole) whole)))

(defn zoom-step (m pane dy)
  "Fold a Ctrl+wheel delta of `dy` line units into `pane`'s zoom, stepping the size by whole
pixels once a notch's worth has accumulated. Returns the model — with the leftover kept on
the pane (`:zoom-accum`), so a slow scroll is not rounded away to nothing.

Nothing here touches the window. A step is a model change; the view paints that one pane's
region at the new size and the rest of the frame is what it was — which is why this needs
no throttle, no timer and no clock: there is no grid to resize and no whole-window raster to
pace. The size goes to the echo area only, where a transient status belongs, not into
`*Messages*`."
  ;; the LIVE payload, not the one `pane` was laid out with: a wheel stream is many events,
  ;; and a caller holding the pane from one layout would otherwise feed a stale accumulator
  (let (live (or (pane-payload-at (:layout m) (:path pane)) (:payload pane))
        acc (+ (or (:zoom-accum live) 0.0) dy)
        steps (whole-steps acc *zoom-step-lines*)
        left (if (= steps 0) acc (- acc (* steps *zoom-step-lines*)))
        kept (assoc m
               :layout
                 (pane-update-path (:layout m)
                   (:path pane)
                   (fn (payload) (assoc payload :zoom-accum left)))))
    (if (= steps 0) kept (zoom-pane kept pane (+ (zoom-px m live) steps)))))

(defn zoom-notch (m pane direction)
  "One whole notch of zoom in `direction` (+1 bigger, -1 smaller) — for a wheel event
that carries no delta at all: a terminal, or a test written before the runtime reported one.
`direction` alone cannot say how far, and one notch is the honest reading of one event."
  (zoom-step m pane (* direction *zoom-step-lines*)))

(defn- zoom-selected (m px)
  "The selected pane zoomed to `px` — the keyboard's target."
  (zoom-pane-with m (fn (update) (pane-update-selected (:layout m) update)) px))

(defn zoom-adjust (m delta)
  "The selected pane's size stepped by `delta` px — the keyboard's zoom (`C-x C-=` /
`C-x C--`), one pixel a press, like a notch."
  (zoom-selected m (+ (zoom-px m (ed-current-pane m)) delta)))

(defn zoom-reset (m)
  "The selected pane back at the window's size (`C-x C-0`)."
  (zoom-selected m (:height (current m))))

(defn zoom-remeasure (m)
  "Every zoomed pane's ratio measured again — for after the WINDOW's size changed under it
(a preset): a pane's px stays what it was, but the cell it is relative to moved, and one
that now sits at the window's size is simply unzoomed."
  (ed-map-panes m
    (fn (payload)
      (if (nil? (:zoom payload)) payload (zoom-payload m payload (:px (:zoom payload)))))))

(defcommand cmd-text-scale-increase
  (m key)
  "Zoom the current pane one pixel bigger (`C-x C-=`, `M-x text-scale-increase`) — this
pane only; Ctrl+wheel is the same step on the pane under the pointer."
  (zoom-adjust m 1))

(defcommand cmd-text-scale-decrease
  (m key)
  "Zoom the current pane one pixel smaller (`C-x C--`, `M-x text-scale-decrease`)."
  (zoom-adjust m -1))

(defcommand cmd-text-scale-reset
  (m key)
  "Show the current pane at the window's size again (`C-x C-0`, `M-x text-scale-reset`)."
  (zoom-reset m))

;; ---- the presets ------------------------------------------------------------

(def *presets*
  ;; The built-in floor, in the init file's font (`:editor`). `Default` is the stock size; the
  ;; rest are the sizes a day actually asks for — someone reading over your shoulder, a call,
  ;; a dense diff.
  [{:name "Default" :family :editor :height 15 :line-height 1.25}
    {:name "Pairing" :family :editor :height 19 :line-height 1.4}
    {:name "Presenting" :family :editor :height 26 :line-height 1.5}
    {:name "Compact" :family :editor :height 13 :line-height 1.15}])

(defn presets-file ()
  "Path of the saved-presets file — one more re-readable literal in the editor's state dir,
beside bookmarks and the recent-file caches."
  (path/join (editor-state-dir) "presets.blsp"))

;; The file-taking forms come first and the public ones close over `presets-file`, the same
;; split `projects.blsp` uses for every persisted cache here — so a test drives the whole
;; save/list/delete cycle on a temp path and never writes the developer's real presets.

(defn saved-in (file)
  "The presets saved in `file`, most-recent first (`[]` when there are none or it is
unreadable — `persist-read`'s tolerance, so a corrupt file costs your presets, not a start)."
  (persist-read file))

(defn all-in (file)
  "Every preset for `file`: saved first, then the built-ins not shadowed by one. Saving one
named `Presenting` replaces the built-in of that name rather than sitting beside it, so the
list never shows two entries that do different things under one name."
  (let (mine (saved-in file)
        names (map mine :name))
    (append mine (seq/reject *presets* (fn (preset) (includes? names (:name preset)))))))

(defn- named? (name)
  ;; whether a preset is the one called `name`
  (fn (preset) (= (:name preset) name)))

(defn saved () (saved-in (presets-file)))
(defn all () (all-in (presets-file)))
(defn names () (map (all) :name))
(defn by-name (name) (seq/find (all) (named? name)))

(defn preset-apply (m name)
  "Apply the preset `name` live, or report that there is no such preset."
  (let (preset (by-name name))
    (if (nil? preset)
      (message m (str "no such preset: " name))
      (message (apply! m (dissoc preset :name))
        (str "preset → " name "  (" (:height preset) " px)")))))

(defn preset-save-to! (file m name)
  "Save what the window is showing into `file` as the preset `name` (dedup by name,
most-recent first). Returns the model with a status. Best-effort, like every other persisted
cache here: a write that fails costs the preset, not the edit you were making."
  (let (showing (current m)
        entry (assoc showing :name name))
    (persist-write! file (into [entry] (seq/reject (saved-in file) (named? name))))
    (message m (str "preset saved: " name "  (" (:height showing) " px, " (:family showing) ")"))))

(defn preset-delete-from! (file m name)
  "Forget the preset `name` saved in `file`. A built-in of that name comes back (it was only
shadowed); a name that was never saved reports rather than pretending."
  (if (nil? (seq/find (saved-in file) (named? name)))
    (message m (str "no saved preset: " name))
    (do
      (persist-write! file (into [] (seq/reject (saved-in file) (named? name))))
      (message m (str "preset deleted: " name)))))

(defn preset-save! (m name) (preset-save-to! (presets-file) m name))
(defn preset-delete! (m name) (preset-delete-from! (presets-file) m name))

;; ---- the commands -----------------------------------------------------------

(defcommand cmd-preset-select
  (m key)
  "Switch the window's type setup (`M-x preset-select`): a Vertico list of named font+size
presets — yours and the built-ins — applied live. This is the one to reach for when a
screen share starts: pick `Presenting`, and `Default` again afterwards."
  (assoc m
    :minibuffer (ed-name-prompt "Preset: " (names) (fn (mm name) (preset-apply mm name)))))

(defcommand cmd-preset-save
  (m key)
  "Save the current font and size as a named preset (`M-x preset-save`) — zoom to what you
want with Ctrl+wheel, then name it. Saving over an existing name replaces it."
  (assoc m
    :minibuffer
      {:edit (ed-mb-edit "Save preset as: " "")
       :on-complete (fn (mm name)
                      (if (string/blank? name)
                        (message mm "preset needs a name")
                        (preset-save! mm name)))}))

(defcommand cmd-preset-delete
  (m key)
  "Forget a saved preset (`M-x preset-delete`). Built-ins cannot be deleted — deleting one
you saved over a built-in's name simply brings the built-in back."
  (assoc m
    :minibuffer
      (ed-name-prompt "Delete preset: "
        (map (saved) :name)
        (fn (mm name) (preset-delete! mm name)))))
