(defmodule view
  "The editor's view: a pure `(model cols rows) -> render frame`, built from
`std/display.blsp` ops. The bottom row is the **echo area / minibuffer**; the rows
above it are the **pane layout** (`std/pane.blsp`): the model's `:layout` tree
is laid out into that body rect, giving one or more panes (each a buffer in its own
sub-rect) separated by dividers. Each pane reserves its bottom row for a reverse-video
**mode line** (buffer name · mode · line:col; the selected pane also shows the status).
Within a pane the buffer is offset to the pane's origin, clipped to its
width, scrolled by the pane's `:top`, and the region (point↔mark) is reverse-video.
No pane IO, no state: testable as plain data.

A single pane fills the whole body, so the lone-pane layout is identical to the
old full-screen one (mode line at `rows-2`, echo at `rows-1`)."
  (:use editor/buffer) ; line text / point + column / region bounds, read to lay out the frame
  (:use keyhelp) ; key / command labels, where-is, docstrings
  (:use scroll) ; ed-scroll / ed-max-top / ed-long-lines — keeping point on screen
  (:use minibuffer)
  (:use scrollbar)
  (:use model) ; current-buffer accessors, pane buffer + mode name
  (:use spancache)
  (:use panes) ; ed-body-layout — the :layout tree -> pane rects + divider rects
  (:use complete-at-point) ; the completion popup
  (:use complete-card :only [complete-popup-ops]) ; …its overlay
  (:use complete-words :only [complete-word-char?])
  (:use completion) ; the shared vertical-menu renderer + faces
  (:use plume) ; the minibuffer completion UI — marginalia annotations + the N/M counter
  (:use projects) ; project-name — the bracketed project label on the mode line
  (:use editor/highlight) ; fontify-runs — the shared span+overlay -> [substring face] tiler
  (:use theme) ; the curated palette + semantic chrome faces (src/theme.blsp)
  (:use statusbar) ; the status-bar segment model + layout + zones + hover tooltip
  (:use echoarea) ; the echo area: message, prompt, candidates, which-key
  (:use modeline) ; a pane's mode line + the hover tooltips
  (:use overlayview) ; the context menu + the transient menu
  (:use ui-kit) ; the widget kit (ui-panel / ui-list) — the context menu is one list
  (:use editor/ui) ; ui-memo — memoised view fragments, one per visible line (ADR-336)
  (:use editor/display) ; clear / text / cursor / frame / zone-at render ops
  (:use memo)) ; defmemo — the bracket match, asked every frame while nothing changes

(defn- frame-of (groups)
  "The frame (`editor/display/frame`'s vector of non-nil ops) of the op lists in `groups`.
Not `(apply frame …)` over the flattened list: the flatten already dropped the nils, and
`frame`'s own filter would walk every op of the frame again to find none."
  (into [] (ed-flatten-ops groups)))

(sig ed-line-text (buffer int -> string))
(defn ed-line-text (buf line)
  "Line `line`'s text without its trailing newline (`buffer-line-at` keeps it)."
  (ed-strip-newline (buffer-line-at buf line)))

;; ---- syntax highlighting: tile precomputed spans onto a visible line --------
;; A language mode may supply a `:fontify` service (`text -> [start end face]`
;; spans, the `highlight-spans` shape). When it does, each visible line is painted
;; as coloured `[substring face]` chunks — with the active region's `:reverse` and
;; any bracket-match `overrides` merged into the per-char face — instead of plain
;; text. Spans are lexed ONCE per frame (in `ed-pane-ops`) and tiled here, so the
;; buffer isn't re-lexed per visible line. The view never names a language: it asks
;; the buffer's mode for these services (`ed-mode-service`, src/model.blsp).

;; The chrome faces are the theme's (src/theme.blsp), read by their `face-*` names at
;; paint time. They used to be copied into `ed-face-*` aliases here at LOAD time, so a
;; theme switch re-bound `face-region` and the view kept painting the old palette's. The
;; selection is a background *tint* (`face-region`, a `:bg` only) rather than
;; reverse-video, so syntax colours stay visible under it; `face-hl-line` is a soft
;; surface band.
(defn- ed-line-chunks (vis base spans hl-ranges overrides)
  "`[substring face]` chunks tiling visible substring `vis` (its first char at buffer
offset `base`), via `highlight/fontify-runs`: the lexer `spans` coloured, with the
region/overlay `hl-ranges` (`[lo hi face]`) and the bracket/diagnostic `overrides`
(`[pos face]`, each the one-char range `[pos (inc pos) face]`) merged on top. Overrides
are ordered before `hl-ranges`, so a region/overlay face wins — the old
span→override→hl merge order."
  (fontify-runs vis
    base
    spans
    ;; almost every row has no override, and `map` + `append` over an empty list still
    ;; cost more than the native tiling they feed
    (if (empty? overrides)
      hl-ranges
      (append (map overrides (fn (o) (let ([p f] o) [p (inc p) f]))) hl-ranges))))

(defn- ed-chunks->ops-impl (row x col limit chunks acc)
  "Tail-recursive: `text` ops for `[substring face]` `chunks` laid left-to-right from
screen column `x`, where `col` is the LINE column the next chunk starts at (its tab stops
are the line's, not the chunk's — ADR-342) and `limit` the screen column past which
nothing is painted. Each chunk's tabs are expanded at its column (`string/expand-tabs`)
and it advances `x` by its cell width, so a wide glyph or a tab pushes what follows."
  (if (or (empty? chunks) (>= x limit))
    (reverse acc)
    (let ([s f] (first chunks)
          expanded (string/expand-tabs s col)
          ;; ONE width per chunk where there were three. The expansion occupies exactly
          ;; `(string/display-width s col)` cells (std's guarantee), so its width is also the
          ;; line-column advance; and only a chunk that overruns the limit needs the clip,
          ;; whose own width is then measured again. A row is a dozen chunks and a typing
          ;; frame re-renders every row, so these were most of a row's cost.
          full-cells (string/display-width expanded)
          room (- limit x)
          shown (if (<= full-cells room) expanded (ed-fit-cells expanded room))
          cells (if (<= full-cells room) full-cells (string/display-width shown)))
      (ed-chunks->ops-impl row
        (+ x cells)
        (+ col full-cells)
        limit
        (rest chunks)
        (cons (if (nil? f) (text row x shown) (text row x shown f)) acc)))))

(sig ed-chunks->ops (int int list &optional int int -> list))
(defn ed-chunks->ops (row x chunks &optional (col 0) (limit 100000))
  "`text` ops for `[substring face]` `chunks`, starting at screen column `x` on `row`;
`col` is the line column the first chunk starts at (0 unless the view is h-scrolled) and
`limit` the screen column to clip at."
  (ed-chunks->ops-impl row x col limit chunks '()))

(def ed-bracket-scan 4000) ; max chars each side of point the bracket matcher scans
;; check-allow: a hit comes back out of the memo's store, which the checker reads as
;; unknown; the store only ever holds what the body below built, a list of `[pos face]`.
(check-allow :trusted
  (defmemo ed-bracket-overrides-at 1 (rope pt bm faces)
    "`ed-bracket-overrides` for point `pt` in `rope`, matched by the mode's `bm` and painted
in `faces` (`[here match error]`). Memoised on all four — one entry: it hits on idle frames,
ticks and blink events where nothing changed, and misses after any edit or motion. The
faces are in the key so a theme switch repaints the pair at once; before, the old colours
stayed until point moved."
    (let ([face-here face-match face-error] faces
          n (text/length rope)
          lo (math/max 0 (- pt ed-bracket-scan))
          hi (math/min n (+ pt ed-bracket-scan))
          clipped (or (> lo 0) (< hi n))
          r (bm (text/slice rope lo hi) (- pt lo)))
      (cond
        (nil? r) '()
        (= (second r) :unmatched) (if clipped '() (list [(+ lo (first r)) face-error]))
        ;; The two ends get DIFFERENT faces, so the solid block always means "the other end":
        ;; the bracket at point (the one just left of the cursor, else under it — the
        ;; matcher's own adjacency rule) takes an underline accent the cursor sits on, its
        ;; partner the block. One glance answers which end of the pair you are at.
        else
          (let (relpt (- pt lo)
                a (first r)
                b (second r)
                adj (if (or (= a (dec relpt)) (= a relpt)) a b)
                far (if (= adj a) b a))
            (list [(+ lo adj) face-here] [(+ lo far) face-match]))))))
(sig ed-bracket-overrides-at (any int fn vector -> list))

;; check-allow: as `ed-bracket-overrides-at`'s — a hit is the memo store's, a `[pos face]` list
(check-allow :trusted
  (defmemo ed-bracket-tree-overrides-at 1 (tree rope pt bm faces)
    "`ed-bracket-overrides` over the buffer's held `tree` of exactly `rope`: the mode's
`:bracket-match-tree` service `bm` matches in the whole document, so there is no window
and no clipping — an `:unmatched` is the parse's own verdict. Memoised like the window's."
    (let ([face-here face-match face-error] faces
          r (bm tree rope pt))
      (cond
        (nil? r) '()
        (= (second r) :unmatched) (list [(first r) face-error])
        else
          (let (a (first r)
                b (second r)
                adj (if (or (= a (dec pt)) (= a pt)) a b))
            (list [adj face-here] [(if (= adj a) b a) face-match]))))))
(sig ed-bracket-tree-overrides-at (any any int fn vector -> list))

(defn ed-bracket-overrides (buf &optional (tree nil))
  "`[pos face]` overrides for the bracket pair adjacent to point, via `buf`'s mode
`:bracket-match` service: the matched pair in the match face, a lone unmatched bracket
in the error face, or `()` when there's no service or no bracket at point. The match is
sought within a `ed-bracket-scan`-char window each side of point (not the whole
buffer), so a deep point in a large file costs O(window), not O(point); a partner
beyond the window is treated as not found, and a window-clipped `:unmatched` is
suppressed (no false red) rather than scanning the rest of the buffer.

`tree` is the buffer's held parse of exactly its text, when the caller has one
(`syntaxtree`): a tree-sitter mode's `:bracket-match-tree` then reads the pair off it
(`tsbrackets/match-tree`) — no window, no parse of a slice."
  (let (bm-tree (when tree (ed-mode-service buf :bracket-match-tree))
        bm (ed-mode-service buf :bracket-match)
        faces [face-bracket-here face-bracket-match face-bracket-error])
    (cond
      ;; no bracket match on a buffer whose line may be a megabyte of brackets (so-long)
      (:line-services-off buf) '()
      bm-tree (ed-bracket-tree-overrides-at tree (buffer-rope buf) (buffer-point buf) bm-tree faces)
      (nil? bm) '()
      else (ed-bracket-overrides-at (buffer-rope buf) (buffer-point buf) bm faces))))

(sig ed-overrides-by-line (any any -> map))
(defn ed-overrides-by-line (rope overrides)
  "Flat `[pos face]` `overrides` grouped by the line each position falls on — `{line ->
([pos face] …)}`, `{}` for none.

This exists for the **memo**, not for the painting. Every visible row is a memoised
fragment (`ed-visible-lines`, ADR-336) whose deps name what its ops read; handing each
row the whole pane's override list made `overrides` a dep that changes whenever ANY of
them does — and the bracket-match half changes on every cursor move, so one `C-n`
invalidated all forty-nine rows and the memo cost more than it saved (measured: `view`
2.92 ms with every fragment hitting, 6.53 ms after a motion, 5.62 ms with no memo at
all). Grouped, a row's dep is only what lands on that row, so a motion re-renders the
two lines the bracket pair moved between and nothing else.

Each line's list keeps the order it had in `overrides` — the tiler merges later-wins, so
a diagnostic underline on the same character as a bracket face must still come second.

An override whose position is not IN the rope is dropped rather than resolved. Overrides
are derived from state that can lag the text by a keystroke — a diagnostic computed
against the previous version, a playground note anchored before an edit shortened the
buffer — and `text/char->line` RAISES on an out-of-range index. Raising here kills the
whole frame: the editor paints `render error: %rope-char->line: index 179 out of bounds`
across the echo row and nothing else, for a stale underline. A mark that has fallen off
the end is worth exactly one missing underline."
  (let (len (text/length rope))
    (fold (reverse overrides)
      {}
      (fn (acc o)
        (let (pos (first o))
          (if (or (not (int? pos)) (< pos 0) (>= pos len))
            acc
            (let (line (text/char->line rope pos))
              (assoc acc line (cons o (or (get acc line) '()))))))))))

;; ---- the span band, sliced per line ----------------------------------------
;; `fontify-runs` (native `%span-runs`) reads its whole `spans` argument into a vector
;; before it tiles anything — so handing every row the whole pane's band makes painting a
;; pane O(rows × band) rather than O(band). Nobody noticed on ordinary source, where the
;; band is a couple of thousand spans; on a file of 12,000-character lines the visible
;; text is half a megabyte, the band is enormous, and one frame measured **199 ms**.
;;
;; Slicing it once per pane and giving each row only its own spans makes that O(band + rows)
;; — a win at every file size, not a special case for long lines. The band stays in ABSOLUTE
;; offsets (what `ed-slice-ops` and `fontify-runs` already speak), so nothing downstream
;; changes; a span straddling lines appears on each line it covers.

(defn- ed-span-skip (spans n i lo)
  "The first index at or after `i` whose span has not already ended by `lo`. The cursor only
moves forward, which is what makes the whole walk one pass rather than one per line."
  (if (and (< i n) (<= (second (nth spans i)) lo)) (ed-span-skip spans n (inc i) lo) i))

(defn- ed-span-seek (spans n at)
  "The first of the `n` ascending `spans` that has not ended by offset `at`, by bisection
— so a pane whose viewport sits after a long history (a terminal buffer's scrollback,
forty thousand faces) does not walk that history every frame to reach its first span."
  (letrec (go (fn (lo hi)
                (if (>= lo hi)
                  lo
                  (let (mid (math/quot (+ lo hi) 2))
                    (if (<= (second (nth spans mid)) at) (go (inc mid) hi) (go lo mid))))))
    (go 0 n)))

(defn- ed-span-take (spans n i hi acc)
  "The spans from `i` that start before `hi`, in order."
  (if (or (>= i n) (>= (first (nth spans i)) hi))
    (reverse acc)
    (ed-span-take spans n (inc i) hi (cons (nth spans i) acc))))

(defn ed-spans-by-line (buf spans top last-line)
  "The lexer `spans` (ascending, non-overlapping, absolute offsets) grouped by the line each
covers — `{line -> (span …)}` over `top`..`last-line`; `{}` when there are none. One co-walk
of the lines and the band."
  (if (or (nil? spans) (empty? spans))
    {}
    (ed-spans-by-line-at (buffer-rope buf) spans top last-line)))

;; check-allow: a hit comes back out of the memo's store, which the checker reads as
;; unknown; the store only ever holds what the body below built, a `{line -> spans}` map.
(check-allow :trusted
  (defmemo ed-spans-by-line-at 8 (rope spans top last-line)
    "`ed-spans-by-line` over `rope`, remembered for the last eight panes' arguments.

Memoised because it is asked EVERY frame and its answer only changes when the band, the text
or the viewport does: the band is the `:span-cache` entry's own vector (the same heap cell
while it covers the viewport) and the rope is a handle, so a blink, a hover or a motion that
does not scroll hits on a few `=` that answer at once. Measured: 270 µs of a 1.8 ms
all-hit frame on src/view.blsp. A hit also hands every row the SAME span lists as last
turn, so the row memo's `=` on them (`ed-visible-lines`) stops walking a fresh copy.

A line's end is `ed-line-end`, not the length of the line's text:
that read allocated every visible line as a string just to measure it.

`spans` may also be several SOURCES (`ed-span-sources`), each sliced on its own and the
lines' lists joined in source order — a terminal's forty thousand history faces are one
source that a repaint of the screen below them does not rebuild.

Or two LAYERS (`ed-span-layers`): each sliced on its own, then per line the upper one's
spans with the lower one's showing only where the upper colours nothing."
    (cond
      (and (map? spans) (contains? spans :span-under))
        (let (slice (fn (layer)
                      (if (or (nil? layer) (empty? layer))
                        {}
                        (ed-spans-by-line-at rope layer top last-line)))
              over (slice (:span-over spans))
              under (slice (:span-under spans))
              palette (:palette spans))
          (fold under
            over
            (fn (merged [line got])
              (assoc merged
                line (ed-span-underlay (get merged line) (ed-span-resolve got palette))))))
      (map? spans)
        (ed-span-lines-merge (map (:span-sources spans)
                               (fn (source)
                                 (if (or (nil? source) (empty? source))
                                   {}
                                   (ed-spans-by-line-at rope source top last-line)))))
      else
        (let (v (if (vector? spans) spans (into [] spans))
              n (count v)
              ;; start at the first span the top line can show, found by bisection, not by
              ;; skipping forward from the band's first span
              first-index (ed-span-seek v n (text/line->char rope (math/max 0 top)))
              walked (fold (range (math/max 0 top) (inc (math/max 0 last-line)))
                       [first-index {}]
                       (fn (state line)
                         (let ([i acc] state
                               lo (text/line->char rope line)
                               hi (ed-line-end rope line)
                               i2 (ed-span-skip v n i lo)
                               got (ed-span-take v n i2 hi '()))
                           [i2 (if (empty? got) acc (assoc acc line got))]))))
          (second walked)))))

(defn ed-span-sources (sources)
  "Several ascending span vectors, each wholly before the next, handed to the view as ONE
`spans` value — what a buffer whose faces arrive in parts gives the renderer instead of
joining them: a terminal's history (thousands of faces, unchanged while the program
repaints its screen) and the screen's own. Joining them copied the whole history per
repaint; kept apart, each is sliced per line on its own (`ed-spans-by-line-at`) and its
cell stays the same between frames, so the slicing of the history is remembered too.

    (view/ed-span-sources [[[0 1 {}]] [[4 5 {}]]])   ;=> {:span-sources [[[0 1 {}]] [[4 5 {}]]]}"
  {:span-sources sources})

(defn ed-span-layers (over under &optional palette)
  "Two span values handed to the view as ONE, `over` painted on top of `under`: where both
colour a character, `over`'s face wins; where only `under` does, it shows. What a buffer
whose producer stamped faces on its text (a build's ANSI colours, its `:ansi` text property) gives
the renderer beside its mode's own colouring (the `file:line:` of an error row), as Emacs
lays font-lock over ansi-color's faces. `over` may itself be `ed-span-sources`.

With a `palette` (`theme/ansi-palette`), `under`'s faces are SGR attributes (`ansi/sgr`'s
`{:fg 1 :bold true}`) resolved through it as they are painted (`ansi/face`), never stored
resolved: the palette is part of the value, so a theme switch misses the slicing memo and
repaints the output in the new theme's colours, as Emacs's `ansi-color-*` faces follow
a theme.

    (view/ed-span-layers [[0 1 :a]] [[0 4 :b]])   ;=> {:span-over [[0 1 :a]] :span-under [[0 4 :b]] :palette nil}"
  {:span-over over :span-under under :palette palette})

(defn- ed-span-face (face palette)
  "A lower layer's `face` as painted: an SGR attribute resolved through `palette`, or the
face itself when the layer has no palette."
  (if (or (nil? palette) (nil? face)) face (ansi/face face palette)))

(defn- ed-span-resolve (spans palette)
  "One line's lower-layer `spans` with their faces as painted (`ed-span-face`)."
  (if (nil? palette)
    spans
    (map spans (fn (span) (let ([from to face] span) [from to (ed-span-face face palette)])))))

(defn- ed-span-underlay-loop (over under acc)
  (cond
    (empty? under) (append (reverse acc) over)
    (empty? over) (append (reverse acc) under)
    else
      (let ([over-from over-to _] (first over)
            [under-from under-to under-face] (first under))
        (cond
          (<= under-to over-from) (ed-span-underlay-loop over (rest under) (cons (first under) acc))
          (<= over-to under-from) (ed-span-underlay-loop (rest over) under (cons (first over) acc))
          ;; they overlap: the part of `under` before `over` shows, the part after waits
          else
            (ed-span-underlay-loop over
              (if (> under-to over-to)
                (cons [over-to under-to under-face] (rest under))
                (rest under))
              (if (< under-from over-from) (cons [under-from over-from under-face] acc) acc))))))

(defn ed-span-underlay (over under)
  "One line's spans from two layers (each ascending and non-overlapping): every `over`
span, and the parts of the `under` spans no `over` span covers — ascending and
non-overlapping again, as the painter wants them.

    (view/ed-span-underlay [[2 4 :a]] [[0 6 :b]])   ;=> ([0 2 :b] [2 4 :a] [4 6 :b])
    (view/ed-span-underlay nil [[0 1 :b]])   ;=> ([0 1 :b])"
  (ed-span-underlay-loop (or over ()) (or under ()) ()))

(defn- ed-span-lines-merge (by-lines)
  "The per-source `{line -> spans}` maps joined: a line in more than one source gets the
earlier source's spans first, which keeps them ascending."
  (fold (rest by-lines)
    (or (first by-lines) {})
    (fn (acc by-line)
      (fold by-line
        acc
        (fn (merged [line got])
          (assoc merged line (let (before (get merged line)) (if before (append before got) got))))))))

(defn- ed-buffer-spans (buf spans)
  "The spans a pane of `buf` paints: `spans` (`ed-pane-spans`), behind the buffer's
`:history-spans` when it keeps a settled prefix of faces apart from them (a terminal's
scrollback) — the two as `ed-span-sources`, never joined — and over the faces its producer
stamped on its text (its `:ansi` text property — a build's ANSI colours as SGR attributes, resolved
through the theme's ANSI palette as they are painted) when it has those.
Those belong to the text (brood ADR-579), so they are where it is after any edit."
  (let (history (:history-spans buf)
        output (ansicolor/colour-spans buf)
        own (if (or (nil? history) (empty? history)) spans (ed-span-sources [history spans])))
    (if (empty? output) own (ed-span-layers own output (ansi-palette)))))

(def ed-face-diagnostic {:underline {:style :wave}}) ; merged onto the token's syntax face: a wave, as flymake draws one (brood ADR-513)
(defn- ed-visible-diagnostics (m from to)
  "`[line diagnostics]` for each line in `[from, to)` the model's line index
(`:diag-by-line`, `model/ed-diag-index`) has findings on — `()` when it has none. The one
per-VISIBLE-line read the underline and the ghost note share: a large file's checker output
(thousands of findings) must cost a frame nothing beyond the lines on screen."
  (let (index (or (:diag-by-line m) {}))
    (if (empty? index)
      '()
      (seq/keep (range (math/max 0 from) (math/max 0 to))
        (fn (line) (let (ds (get index line)) (when ds [line ds])))))))

(defn- ed-line-diagnostic-overrides (buf line ds)
  "`[pos ed-face-diagnostic]` for each character of each token the diagnostics `ds` mark on
`line` (`ed-diag-span-end`). Reads only that line's text, never the whole buffer; the word a
diagnostic marks never crosses a newline."
  (let (bol (text/line->char (buffer-rope buf) line)
        text (buffer-line-at buf line))
    (mapcat ds
      (fn (d)
        (let (from (ed-diag-col0 d))
          (map (range from (ed-diag-span-end text from)) (fn (p) [(+ bol p) ed-face-diagnostic])))))))

(sig ed-diagnostic-overrides (model buffer int int -> any))
(defn ed-diagnostic-overrides (m buf top vrows)
  "`[pos ed-face-diagnostic]` overrides underlining each diagnostic's token on the
`vrows` lines from `top` — the pane's viewport — from the model's line index
(`ed-visible-diagnostics`); `()` when there are none. Lines past EOF (stale between
rechecks) are skipped, so a deleted line can't index out of range."
  (mapcat (ed-visible-diagnostics m top (math/min (buffer-line-count buf) (+ top vrows)))
    (fn ([line ds]) (ed-line-diagnostic-overrides buf line ds))))

;; ---- highlight ranges: the region + transient overlays ----------------------

(defn ed-hl-ranges (m buf selected?)
  "The highlight ranges `[lo hi face]` to paint over `buf` in a pane: the active region
(point↔mark, a `:bg` tint); and the model's transient `:overlays` (a search, a query-replace
matches), gated to the selected pane. Order is priority (the tiler merges later-wins):
region then overlays. (The hl-line current-line highlight is NOT a char range — it's a
full-width `rect` band painted by `ed-hl-line-band`, so it covers the whole line, not just
its text.)"
  (let (region-b (buffer-region-bounds buf)
        region (when region-b (list [(first region-b) (second region-b) face-region]))
        overlays (if selected?
                   (map (or (:overlays m) '()) (fn (o) [(:start o) (:end o) (:face o)]))
                   '()))
    (append region overlays)))

(defn ed-ranges-on-line (ranges lo hi)
  "The `[start end face]` highlight `ranges` that touch the chars `[lo, hi)` — a line —
each clipped to them, in their order (which is their priority). What a row's memo depends
on instead of the pane's whole list: clipped, a range that covers this line before and
after a motion is the SAME value both times. A range whose ends are not numbers is kept
as it is, for the tiler to judge, as it always did."
  (reverse (fold ranges
             '()
             (fn (acc range)
               (let (start (first range)
                     end (second range))
                 (cond
                   (not (and (int? start) (int? end))) (cons range acc)
                   (and (< start hi) (> end lo))
                     (cons [(math/max start lo) (math/min end hi) (nth range 2)] acc)
                   else acc))))))

;; ---- a pane body's GEOMETRY: one map, built once per pane ---------------------
;; Every layer of a pane's body (the bands, the gutter and text, the link zones, the notes,
;; the remote carets) is laid out in the same frame, so `ed-pane-ops` builds it ONCE and
;; hands each the map rather than ten positional ints in a different order apiece (`rows
;; hscroll` here, `hscroll rows` there — the kind of swap that type-checks):
;;
;;   :top            the first buffer line the pane shows
;;   :x :y           the body's origin — the pane's rect, or a zoomed pane's region (0 0)
;;   :width          the body's width in cells, the scrollbar column included
;;   :gutter-width   the gutter's columns, edit margin included — the text starts past it
;;   :text-height    the rows of text the pane shows
;;   :render-height  the rows actually painted: one more while a smooth scroll is part-way,
;;                   capped at a narrowing's last line
;;   :rows           the wrapped row table (`panes/ed-pane-rows`), nil unwrapped
;;   :top-continued  the pane starts part-way through its top line's text (no number on
;;                   that first row)
;;   :hscroll        the columns scrolled off the left of an unwrapped pane

(deftype pane-geometry
  (record &open
    :top int
    :x int
    :y int
    :width int
    :gutter-width int
    :margin-width int
    :text-height int
    :render-height int
    :rows (or nil vector)
    :top-continued (or nil bool)
    :hscroll int))

;; `ed-pane-ops` also carries `:scroll-frac` (the smooth-scroll fraction, clamped) in the
;; open record: the pane itself reads it to wrap the body, no layer does.

;; ---- the body's COLUMNS: every horizontal reach is a named span ---------------
;; A pane body, left to right:
;;
;;   | gutter (edit margin incl.) | text … | gap + right margin | scrollbar column |
;;   x                            text-x                                  x + :width
;;
;; A layer asks `geometry-span` for the span it covers and never subtracts widths itself.
;; Each hand-written `(- width gutter margin 1)` chose its own subset, and the `1` (the
;; scrollbar column) got into some and not others: the current-line highlight, a diff's
;; tinted lines and a region's end-of-line fill all stopped one column short of the pane's
;; edge. Short of the edge, a band is not carried on to the frame either (brood ADR-508's
;; edge bleed), so the gap showed twice. A guard in tests/view_test.blsp holds that only
;; `geometry-span` reads the raw widths.

(sig geometry-span (pane-geometry keyword -> vector))
(defn geometry-span (geometry span)
  "`[x width]`: the screen column the named `span` of the pane body starts at and the cells
it covers.

- `:text`: what a line is laid out into, past the gutter and short of the right margin and
  the scrollbar column. At least 1 wide.
- `:row`: the text's start to the right margin, or to the body's edge when there is none
  (the scrollbar column included). The reach of what goes after a line's text: a link zone,
  a ghost note, a region's end-of-line fill, a remote caret. At least 1 wide.
- `:band`: the text's start to the body's edge, through the margin and the scrollbar
  column. A background behind a whole line (`geometry-band`). It reaches the grid's edge
  when the pane does, so the GUI carries it on to the frame.
- `:body`: the body's whole width, gutter included (the pulse after a jump).
- `:gutter`: the gutter, its edit margin included.
- `:margin`: the right margin's text, past its gap; 0 wide without one."
  (let (x (:x geometry)
        width (:width geometry)
        gutter (:gutter-width geometry)
        margin (:margin-width geometry)
        text-x (+ x gutter)
        text-width (math/max 1 (- width gutter margin 1)))
    (case span
      :text [text-x text-width]
      :row [text-x (math/max 1 (- width gutter margin))]
      :band [text-x (math/max 0 (- width gutter))]
      :body [x width]
      :gutter [x gutter]
      ;; `:margin-width` counts the two-cell gap before the margin's text
      :margin [(+ text-x text-width 2) (math/max 0 (- margin 2))]
      (error (str "geometry-span: no span " span)))))

(defn- geometry-band (geometry row face)
  "A background behind a whole line on body `row` (0 at the body's top): a `rect` across
the `:band` span, so it reaches the pane's right edge and on to the frame. How every
full-line background is painted (the current line, a diff's tinted lines), so none of them
picks its own width."
  (let ([x width] (geometry-span geometry :band))
    (rect (+ (:y geometry) row) x width 1 face)))

(defn ed-line-screen-rows (geometry line height)
  "The `[k from to]` rows buffer `line`'s text occupies (`ed-rows-line-rows`) that fall
within the first `height` rows of the body."
  (seq/filter (ed-rows-line-rows (:rows geometry) (:top geometry) line (:hscroll geometry))
    (fn (row) (and (>= (first row) 0) (< (first row) height)))))

(defn- ed-line-last-row (geometry line height)
  "The `[k from to]` row holding the END of `line`'s text — a wrapped line's last segment —
when it is within the first `height` rows of the body, else nil. Where anything painted
after a line's text (a region's end-of-line fill, a ghost note) goes."
  (let (row (last (ed-rows-line-rows (:rows geometry) (:top geometry) line (:hscroll geometry))))
    (when (and row (< (first row) height)) row)))

(defn ed-cells-between (rope bol from to)
  "The display cells of the chars `[from, to)` on the line starting at `bol`, measured from
the LINE's start in both halves — a tab's width is a function of its line column (ADR-342),
so this is the width to `to` less the width to `from`, not the width of the slice alone."
  (- (string/display-width (text/slice rope bol to))
    (string/display-width (text/slice rope bol from))))

(sig ed-hl-line-band (model map buffer pane-geometry -> any))
(defn- ed-hl-line-band (m pane buf geometry)
  "The hl-line current-line highlight: a `geometry-band` behind each row the line at point
occupies (`ed-line-screen-rows`: one for an unwrapped line, every continuation row of a
wrapped one, as Emacs highlights the whole logical line). It starts at the text, never in
the gutter (Emacs `hl-line-mode`, sans the fringe), and runs to the pane's edge. Painted
only on the selected pane with `:hl-line` on and **no** active region, and only for rows on
screen (`:text-height`). `()` otherwise. Drawn before the text so it sits behind it."
  (if (and (:hl-line m) (:selected pane) (nil? (buffer-region-bounds buf)))
    (map (ed-line-screen-rows geometry
           (buffer-current-line buf)
           (math/max 1 (:text-height geometry)))
      (fn (row) (geometry-band geometry (first row) face-hl-line)))
    '()))

(defn- ed-region-eol-band (buf geometry lo hi line)
  "The region band filling `line`'s end-of-text → right-edge gap, or nil: when the region
`[lo, hi]` covers the line THROUGH its end and the line's last row is on screen. Reaching
the end of the text is enough; the newline itself need not be inside, which is the
difference between a selection that stops flush against the last character and one that
reads as covering the line. The last line of a region is the case that shows it, and it is
the one a reader looks at. It runs to the end of the `:row` span: the right margin, or the
pane's edge."
  (let (rope (buffer-rope buf)
        bol (text/line->char rope line)
        ;; the length from the line bounds, not from a copy of the line's text
        line-len (- (ed-line-end rope line) bol)
        eol (+ bol line-len)
        row (when (and (<= lo eol) (<= eol hi))
              (ed-line-last-row geometry line (math/max 1 (:text-height geometry)))))
    (when row
      (let ([k row-from _] row
            [x width] (geometry-span geometry :row)
            ;; the row's text width, measured from the LINE's column (its tabs)
            end-column (ed-cells-between rope bol (+ bol (math/min row-from line-len)) eol)
            band-width (- width end-column))
        (when (> band-width 0)
          (rect (+ (:y geometry) k) (+ x end-column) band-width 1 face-region))))))

(sig ed-region-eol-bands (buffer pane-geometry -> list))
(defn- ed-region-eol-bands (buf geometry)
  "Region-selection bands filling each fully-selected line's end-of-text → right-edge gap,
so an empty or short line whose newline lies inside the region shows the selection through
end-of-line (Emacs region highlighting). The char-range region tint (`ed-hl-ranges`) only
paints actual text; this is its full-width counterpart — the same relationship
`ed-hl-line-band` has to the per-line cursor. `()` when no region is active. Coords mirror
`ed-pane-body-ops`: pane-body cells, the text `:gutter-width` in from `:x`, over the
`:text-height` rows. The band sits on the line's LAST row (`ed-line-last-row`), after that
row's text. Bottom line first."
  (let (region (buffer-region-bounds buf))
    (if (nil? region)
      '()
      (let (top (:top geometry)
            last-line (math/min (dec (buffer-line-count buf))
                        (dec (+ top (math/max 1 (:text-height geometry))))))
        (seq/keep (reverse (range top (inc last-line)))
          (fn (line) (ed-region-eol-band buf geometry (first region) (second region) line)))))))

;; ---- one pane's body (a buffer clipped into a sub-rect at origin x,y) -------
;; Render ops carry absolute screen coordinates, so a pane simply offsets every
;; op by its rect's origin `(x, y)` and clips text to its width `w`.

(sig ed-row-slice (any int int (or nil int) int &optional (or nil int) -> (tuple string int int)))
(defn- ed-row-slice (rope line from to w &optional (known-col nil))
  "`[vis from-col base]` for the chars `[from, to)` of `line` a `w`-wide row shows (`to` nil
for the rest of the line): the text it paints, the display column that text starts at on
its line, and the buffer offset of its first character.

The line is read as rope SLICES — its bounds from the line index, then only the chars the
row shows (and, h-scrolled, the ones left of it) — not as the whole line's text with its
newline stripped and then substringed: two fewer copies of every visible line on every
frame that re-renders it.

`known-col` is the display column `from` sits at when the caller already knows it — the row
after another row of the same wrapped line starts where that one ended — so a row in the
middle of a megabyte line does not measure the line's text before it."
  (let (bol (text/line->char rope line)
        len (- (ed-line-end rope line) bol)
        ;; `if`, not `math/min`: the checker reads `math/min` of two ints as a `number`, and
        ;; these become rope offsets, which are ints
        h (if (< from len) from len)
        ;; `h + w` chars, not the rest of the line: `ed-fit` keeps only the first `w` of
        ;; whatever this slices, so the cap is EXACT, not an approximation — and it is the
        ;; difference between allocating what the pane shows and allocating the line. On a
        ;; file of 12,000-character lines that was a 12 KB copy per row per frame.
        end (let (cap (if (nil? to) (+ h w) to)) (if (< cap len) cap len)))
    [(ed-fit (text/slice rope (+ bol h) (+ bol (if (< end h) h end))) w)
      (cond
        (= h 0) 0
        (and (int? known-col) (= h from)) known-col
        else (string/display-width (text/slice rope bol (+ bol h))))
      (+ bol h)]))

(defn- ed-row-start-cols (rope table)
  "Per row of a pane's row `table`, the display column its text starts at when the row
before it was the same line's and ended where it starts (a wrapped line's next row: that
row's column plus its width), else nil — so only the FIRST row of a line on screen measures
the line's text before it (`ed-row-slice`)."
  (first
    (fold table
      [[] nil]
      (fn (acc row)
        (let ([cols previous] acc
              line (nth row 0)
              from (nth row 1)
              to (nth row 2)
              inlay (nth row 3 nil)
              bol (text/line->char rope line)
              start (+ bol from)
              end (when (int? to) (+ bol to))
              ;; the guard also tells the checker the offsets are ints: a row is untyped data
              wrapped? (and (nil? inlay) (int? start) (int? end) (nil? (nth row 4 nil)))
              ;; this row's start column: handed on by the row before, else — for a
              ;; wrapped row, whose end the next row needs — measured here, once
              col (cond
                    (not (nil? inlay)) nil
                    (and previous (= (first previous) line) (= (second previous) from))
                      (nth previous 2)
                    (not wrapped?) nil
                    (= from 0) 0
                    (int? start) (string/display-width (text/slice rope bol start))
                    else nil)
              ;; where a wrapped row ends, and the column there, for the row after it
              next (when (and wrapped? (int? col) (int? start) (int? end))
                     [line
                       to
                       (+ col
                         (string/display-width (text/slice rope start end) col))]))
          [(conj cols col) next])))))

(sig ed-row-ops (int int int string int int any any any any -> any))
(defn- ed-row-ops (row x w vis from-col base plain? spans ranges overrides)
  "The ops painting `vis` (`ed-row-slice`) on screen row `row` from column `x`, `w` wide:
one plain `text` op when `plain?`, else the tiled `[substring face]` chunks of the syntax
`spans`, highlight `ranges` and `overrides` (all absolute offsets, `base` being `vis`'s)."
  (if plain?
    [(text row x (ed-fit-cells (string/expand-tabs vis from-col) w))]
    (ed-chunks->ops row
      x
      (ed-line-chunks vis base (or spans '()) ranges overrides)
      from-col
      (+ x w))))

(defn- ed-with-ellipsis (ops row x w ellipsis)
  "A row's `ops` with the `ellipsis` of a truncated line (`wrap/one-row`) after them, in the
row's LAST cells and the truncation face — so the marks of a column of truncated lines line
up at the pane's edge, as Emacs's fringe `$` does. `ops` as they were for a row that shows
its whole line (nil or `\"\"`: a line that scrolls is clipped by the edge, unmarked)."
  (cond
    (or (nil? ellipsis) (= ellipsis "")) ops
    ;; a wrapped row's continuation mark sits OUTSIDE the text, in the scrollbar column every
    ;; pane keeps, as Emacs's arrow sits in the fringe: the row keeps its whole width
    (= ellipsis wrap/continuation-mark)
      (append ops (list (text row (+ x w) ellipsis face-truncation)))
    else
      (append ops
        (list (text row
                (+ x (math/max 0 (- w (string/display-width ellipsis))))
                ellipsis
                face-truncation)))))

(sig ed-slice-ops (buffer int int int int any any any int (or nil int) -> any))
(defn ed-slice-ops (buf line row x w hl-ranges spans overrides from to)
  "Render op(s) for the chars `[from, to)` of buffer `line` on screen row `row`, in a
text area starting at column `x` and `w` wide — `to` nil for the rest of the line. The
one row painter: an unwrapped pane's row is `[hscroll, len)` of its line, a wrapped
pane's a segment of it. With neither `:fontify` `spans` nor any highlight range it's a
single plain `text` op; otherwise coloured `[substring face]` chunks (the syntax spans +
highlight ranges + bracket `overrides` merged), tiled from the slice's absolute `base`
offset. Tabs are expanded to the LINE's stops (ADR-342): the slice is laid out from the
display column its first character sits at (`from-col`), so a chunk mid-line tabs where
the whole line would, and the frontend never sees a raw tab."
  (let ([vis from-col base] (ed-row-slice (buffer-rope buf) line from to w))
    (ed-row-ops row
      x
      w
      vis
      from-col
      base
      (and (nil? spans) (empty? hl-ranges))
      spans
      hl-ranges
      overrides)))

(sig ed-line-ops (buffer int int int int int any any any int -> any))
(defn ed-line-ops (buf line top x y w hl-ranges spans overrides hscroll)
  "Render op(s) for buffer `line` at its screen row `y + (line - top)` inside a pane whose
text area starts at column `x`, width `w`, scrolled `hscroll` characters left — the
unwrapped pane's row: `ed-slice-ops` over `[hscroll, end)` (long lines scroll, not wrap)."
  (ed-slice-ops buf line (+ y (- line top)) x w hl-ranges spans overrides hscroll nil))

(sig ed-visible-lines (buffer int int int int int any any any int -> any))
(defn ed-visible-lines
  (buf top textrows x y w hl-ranges spans overrides hscroll &optional (memo? false) (rows nil))
  "`text` ops for the rows of a `textrows`-tall pane whose text area starts at `(x, y)`
and is `w` wide: one buffer line per row from line `top`, scrolled `hscroll` columns
left — or, with a row table `rows` (`panes/ed-pane-rows`, a wrapped buffer), one
`[line from to]` segment per row. `hl-ranges` `[lo hi face]` highlight the
region/overlays, `spans` syntax-colour, and `overrides` is the bracket/diagnostic face
table **grouped by line** (`ed-overrides-by-line`) — each row is handed only its own.

With `memo?`, each row is a memoised fragment (`editor/ui/ui-memo`, ADR-336) keyed by
its screen cell `[:line x row]`: its ops are reused from the previous turn while what
the row shows, the width, its spans, its highlights and **that line's** overrides are `=`
— all of them values the model keeps between turns, so a cursor blink,
a mouse move or a motion that touches no bracket re-renders no line at all. (The per-line
grouping of the overrides is what makes that true — see `ed-overrides-by-line`.) Off (the
default) outside the loop and for a scaled pane, whose ops are transformed after this.

**A row's identity is its CONTENT, not its line number** — the text it shows, the column
that text starts at, and its spans, highlights and overrides rebased to that text's first
character — so a row whose text did not change hits even after an edit elsewhere re-lexed
the band, and typing re-renders the edited row (and whatever the bracket pair moved
across) rather than all of them. That was first written and MEASURED as a loss: computing
those deps per line per frame (a rope slice and a span walk) cost more than the re-render it
saved, on exactly the frames that change nothing. What makes it a win is that the per-row
facts are remembered (`ed-row-facts-at`) on the rope, the band and the viewport: a frame
where nothing moved reads them back in one comparison, and only a frame that changed the
text or scrolled pays for them, once."
  (let (facts (ed-row-facts-at (buffer-rope buf)
                spans
                top
                textrows
                hscroll
                rows
                w
                (conventions/cell-layout-key))
        any-ranges? (not (empty? hl-ranges))
        paint-row (fn (row fact)
                    (let ([line
                            vis from-col base line-spans content bol eol plain-deps tiled-deps
                            ellipsis] fact
                          line-overrides (or (get overrides line) '())
                          ;; only the highlight ranges ON this line, clipped to it: the
                          ;; region's far end moves on every motion while it is active, and
                          ;; with the whole range as the dep every row re-rendered — a
                          ;; selected line in the middle paints the same either way
                          line-ranges (if any-ranges?
                                        (ed-ranges-on-line hl-ranges bol (inc eol))
                                        '())
                          ;; tiled or plain is the LINE's call: a line with no spans, no range
                          ;; and no override of its own paints plain whatever the rest of the
                          ;; pane has. As the pane's call, the first spell underline anywhere
                          ;; (or a region) flipped every bare line to the tiler — a blank line
                          ;; lost its `\"\"` op — so every row's memo missed once per check
                          plain? (and (nil? line-spans)
                                   (empty? line-ranges)
                                   (empty? line-overrides))
                          paint (fn ()
                                  (ed-with-ellipsis (ed-row-ops row
                                                      x w vis from-col base plain? line-spans
                                                      line-ranges line-overrides)
                                    row x w ellipsis)))
                      ;; The deps are the row's content relative to its first character —
                      ;; never the whole band (`=` on a rebuilt band walks it once per row:
                      ;; on a file of 12,000-character lines that made the memo thirty times
                      ;; slower than no memo) and never the line number, so a row whose text
                      ;; and faces are unchanged hits wherever the edit was.
                      (if memo?
                        (ui-memo [:line x row]
                          ;; `content` first: the text, its column, the width and its spans, one
                          ;; vector built with the facts, so on a frame where nothing moved it
                          ;; is the SAME cell as last turn's and compares at once
                          ;; a row with no range and no override on it reads its deps back
                          ;; from the facts (the same vector as last frame, so `=` answers at
                          ;; once and nothing is built); the rest build theirs
                          (if (and (empty? line-ranges) (empty? line-overrides))
                            (if plain? plain-deps tiled-deps)
                            [content
                              (ed-rebase-ranges line-ranges base)
                              (ed-rebase-overrides line-overrides base)
                              plain?])
                          paint)
                        (paint)))))
    ;; One walk that conses each row's ops onto a reversed accumulator and reverses once.
    ;; `mapcat` over `seq/enumerate` built the index pairs, then spliced every row's
    ;; one-marker list through `append` — about twice the cost of the memo lookups
    ;; themselves on a frame where every row hits.
    (ed-visible-walk facts 0 '() y x w paint-row)))

(sig ed-visible-walk (any int any int int int fn -> any))
(defn- ed-visible-walk (facts k acc y x w paint-row)
  "`ed-visible-lines`' walk over its row `facts` from screen row `k`: each row's ops consed
onto the reversed `acc` (`paint-row` for a text row; an INLAY row paints its own derived
text, indented to the line it describes, in the hint voice — a remark about the code below
it, not code), reversed once at the end."
  (if (empty? facts)
    (reverse acc)
    (let (fact (first facts)
          ops (if (string? fact)
                (list (text (+ y k) x (ui-clip (str "  " fact) w) face-inlay-line))
                (paint-row (+ y k) fact)))
      (ed-visible-walk (rest facts)
        (inc k)
        ;; a row is almost always ONE op — its memo marker — and `fold` over a one-element
        ;; list cost a microsecond a row, the dearest step of a row that hits
        (if (and (list? ops) (empty? (rest ops)))
          (ed-push-op acc (first ops))
          (fold ops acc ed-push-op))
        y
        x
        w
        paint-row))))

;; check-allow: a hit comes back out of the memo's store, which the checker reads as
;; unknown; the store only ever holds what the body below built, a list of row facts.
(check-allow :trusted
  (defmemo ed-row-facts-at 8 (rope spans top textrows hscroll rows w cell-layout)
    "Per screen row of a pane, what painting it reads from the TEXT: an inlay row's string,
or `[line vis from-col base spans content bol eol plain-deps tiled-deps ellipsis]` — the
line, the text the row shows (`ed-row-slice`) with the display column it starts at and its
buffer offset, the line's syntax spans (absolute), the row's CONTENT key
`[vis from-col w spans ellipsis]` with the spans rebased to `base` and clipped to `vis` (what its memo compares), the line's
bounds, and the row's whole memo deps for a frame with no highlight range or override on
it, painted plain and painted tiled, and the ellipsis a truncated row ends in (nil for one
that shows its whole line — `wrap/one-row`; a row cut short shows only the chars before
its clip's cut).

Remembered on the rope, the span band (the `:span-cache` entry's own vector), the viewport
and the width — all of them the same cells on a frame where nothing moved, so the rows'
deps (`ed-visible-lines`) are read back rather than rebuilt; a wrapped pane's row table
`rows` is `wrap/rows-from`'s memoised vector."
    (let (last-line (math/min (dec (text/line-count rope)) (dec (+ top textrows)))
          ;; one `[line from to inlay]` per row: a wrapped pane's own table, or — unwrapped
          ;; — one line per row from `top`, each scrolled `hscroll` and running to the edge
          table (if (nil? rows)
                  (map (range top (inc last-line)) (fn (line) [line hscroll nil nil]))
                  (take rows textrows))
          ;; the band sliced per line, ONCE — `fontify-runs` reads its whole `spans`
          ;; argument before tiling, so handing every row the whole band is O(rows × band).
          ;; The rows a wrapped pane draws are the same LINES, so the slice covers both.
          by-line (if (or (nil? spans) (empty? spans))
                    {}
                    (ed-spans-by-line-at rope
                      spans
                      top
                      (fold table -1 (fn (acc row) (math/max acc (first row)))))))
      (map (seq/zip table (ed-row-start-cols rope table))
        (fn ([row known-col])
          (let (line (nth row 0)
                from (nth row 1)
                to (nth row 2)
                inlay (nth row 3 nil)
                clip (nth row 4 nil))
            (if (nil? inlay)
              (let ([vis from-col base] (ed-row-slice rope
                                          line
                                          from
                                          (if clip (first clip) to)
                                          w
                                          known-col)
                    ;; a wrapped row its line goes on past ends in the continuation mark,
                    ;; painted just past the text (`ed-with-ellipsis`: the scrollbar column)
                    ellipsis (cond
                               clip (second clip)
                               (and (not (nil? rows))
                                 (not (nil? to))
                                 (< (+ (text/line->char rope line) to) (ed-line-end rope line)))
                                 wrap/continuation-mark
                               else nil)
                    line-spans (get by-line line)
                    ;; the spans CLIPPED to the text the row shows: a docstring's one span
                    ;; runs over many lines and lengthens with every character typed in it,
                    ;; and every row it covers paints the same however long it is
                    content [vis
                              from-col
                              w
                              (ed-rebase-ranges (ed-ranges-on-line line-spans
                                                  base
                                                  (+ base (string/length vis)))
                                base)
                              ellipsis])
                [line
                  vis
                  from-col
                  base
                  line-spans
                  content
                  (text/line->char rope line)
                  (ed-line-end rope line)
                  ;; the row's whole memo deps for the usual frame — no highlight range
                  ;; and no override on the line — plain, then tiled: built once with the
                  ;; facts, so such a row hands its memo the SAME vector every frame
                  [content '() '() true]
                  [content '() '() false]
                  ellipsis])
              inlay)))))))

(defn- ed-rebase-ranges (ranges base)
  "`[start end face]` `ranges` with both ends made relative to offset `base` — `()` for
none. What a row's memo compares, so a row whose text moved compares equal. A range whose
ends are not numbers is kept as it is (`ed-ranges-on-line` passes those through)."
  (if (empty? ranges)
    '()
    (map ranges
      (fn (range)
        (let ([start end face] range)
          (if (and (int? start) (int? end)) [(- start base) (- end base) face] range))))))

(defn- ed-rebase-overrides (overrides base)
  "`[pos face]` `overrides` with the position made relative to offset `base` — `()` for
none."
  (if (empty? overrides) '() (map overrides (fn (o) (let ([pos face] o) [(- pos base) face])))))

;; *rendering* (`ed-gutter-ops`, below) stays here.

;; How many of the gutter's trailing columns the recessed surface leaves *unpainted*, so the
;; cell's separator space falls on the edit background — a slight light gap between the line
;; number and the text (not a heavy dark band). The gutter cell already reserves that space.
(def *gutter-edit-margin* 1)

(def- ed-gutter-bar-width 0.28) ; the change-bar's width in cells (a thin diff-hl rule)
(defn- ed-gutter-chunk-op (row col chunk gui?)
  "The op for one gutter chunk at column `col`. A `[:bar colour]` chunk is a git change bar:
in the GUI a thin **full-cell-height** `frect` (a CONTINUOUS solid rule — a half-block glyph
leaves a gap at the 1.4 line-height, reading as a dashed TUI bar), in the terminal the `▌`
half-block. Any other chunk is `[text face]`."
  (let ([t f] chunk)
    (cond
      (not (= t :bar)) (text row col t f)
      gui? (frect (+ col 0.0) (+ row 0.0) ed-gutter-bar-width 1.0 {:bg f})
      else (text row col "▌" {:fg f}))))

(defn- ed-gutter-line-ops (row col chunks gui? acc)
  "The render ops for one gutter cell's `chunks` (normalised via `model/gutter-cell-chunks`)
laid left-to-right from column `col` (`ed-gutter-chunk-op`) — so a gutter can carry a change
bar *and* the dim line number in one cell (diff-hl). A bar takes one column, a text chunk
its length. The web mirror decodes the same chunks (`web-gutter-html`).

Consed onto the reversed accumulator `acc` and left reversed — the column caller reverses
once over every line — with the column threaded as an argument rather than a `[col ops]`
pair allocated per chunk on every gutter rebuild."
  (if (empty? chunks)
    acc
    (let (chunk (first chunks)
          t (first chunk))
      (ed-gutter-line-ops row
        (+ col (if (= t :bar) 1 (string/length t)))
        (rest chunks)
        gui?
        (cons (ed-gutter-chunk-op row col chunk gui?) acc)))))

(defn ed-gutter-ops (cells bx by gui? &optional (memo? false))
  "Render ops for prebuilt gutter `cells` (one `[text face]` / `[:bar colour]` chunk list
per visible line, from `spancache/ed-pane-gutter-cells` — cached across frames, since typing
never changes them), placed at column `bx`, rows from `by`. `gui?` picks the change bar's
rendering (frect vs `▌`). `()` when `cells` is nil (gutter hidden / no service). With
`memo?` the ops are a memoised fragment (ADR-336) — off for a scaled pane, whose ops
are transformed after this."
  (if (nil? cells)
    '()
    ;; A memoised fragment (ADR-336): `cells` is the model's cached vector, the same
    ;; object turn after turn, so the ops are reused until the gutter itself changes.
    (ui-memo (if memo? [:gutter bx by] nil)
      [cells bx by gui?]
      (fn ()
        ;; one reversed accumulator across every cell's chunks, reversed once — not a list per
        ;; line spliced by `mapcat` over `seq/enumerate`'s index pairs
        (reverse (fold (range (count cells))
                   '()
                   (fn (acc i)
                     (ed-gutter-line-ops (+ by i) bx (gutter-cell-chunks (nth cells i)) gui? acc))))))))

(defn- ed-row-cells (cells rows top &optional (top-continued false))
  "The gutter `cells` (one per buffer line from `top`) re-keyed per ROW of a wrapped
pane's table: a line's first row gets its cell, a continuation row no number (as Emacs
shows none on a continuation line) but the `wrap/continued-mark` (`ed-continued-cell`). `cells` itself when `rows` is nil.
With `top-continued` the pane starts part-way through line `top`'s text, so its first rows
continue that line and get the mark too."
  (if (or (nil? rows) (nil? cells))
    cells
    ;; a line's FIRST text row is the one after a row of another line (or an inlay): not
    ;; `from = 0`, since the line at point may be shown scrolled sideways
    ;; (`wrap/follow-point`) and is still the line its number names
    (let (continued (ed-continued-cell cells))
      (letrec (walk (fn (left previous acc)
                      (if (empty? left)
                        (into [] (reverse acc))
                        (let (row (first left)
                              line (first row)
                              inlay (nth row 3 nil)
                              first? (and (nil? inlay) (not (= line previous))))
                          (walk (rest left)
                            (if (nil? inlay) line previous)
                            (cons (cond
                                    (not first?) (if (nil? inlay) continued '())
                                    (< (- line top) (count cells)) (nth cells (- line top))
                                    else '())
                              acc))))))
        (walk (seq rows) (if top-continued top -1) '())))))

(defn- ed-continued-cell (cells)
  "The gutter cell of a row that continues a wrapped line: no number, the
`wrap/continued-mark` in the number's last column (Emacs's left fringe arrow) — as wide as
the line-number cells in `cells`, so the text after it does not move. Empty when no cell
has a width to match."
  (let (sample (seq/find cells (fn (cell) (not (empty? cell))))
        chunks (cond
                 (nil? sample) '()
                 (string? (first sample)) (list sample)
                 else sample)
        ;; a change bar `[:bar colour]` is one column (`ed-gutter-line-ops`), a text chunk its width
        width (fold chunks
                0
                (fn (acc [text _]) (+ acc (if (string? text) (string/display-width text) 1)))))
    (if (<= width gutter/line-number-right-margin)
      '()
      [(string/pad-right (string/pad-left wrap/continued-mark
                           (- width gutter/line-number-right-margin))
         width)
        face-truncation])))

;; `gui?` is `(:gui m)` — absent (nil) in a terminal model, never `false` — so the
;; declaration admits nil: as a plain `bool` the runtime contract (ADR-380, on by default
;; under `nest test`) refused every terminal render.
;; The pane's BODY is two layers — its optional gutter, then its visible buffer lines (or,
;; with a row table `:rows`, its wrapped rows) — rendered into the `geometry`'s rect at
;; `[:x :y]`, `:width` wide less the gutter and the scrollbar column, and `:render-height`
;; rows tall. For a zoomed buffer the rect is the REGION's (origin 0,0, its own cells —
;; `ed-pane-ops` wraps the result in a `cell-region`), so neither knows about zoom at all.
;; Two functions rather than one appending the halves, so the pane flattens them with every
;; other layer in a single copy (`ed-flatten-ops`).

;; `gui?` is `(:gui m)` — absent (nil) in a terminal model, never `false`.
(sig ed-pane-gutter-ops (pane-geometry any (or bool nil) -> any))
(defn- ed-pane-gutter-ops (geometry cells gui?)
  "The pane's gutter ops from its prebuilt/cached chunk lists `cells`, re-keyed per row of a
wrapped pane (`ed-row-cells`)."
  (ed-gutter-ops (ed-row-cells cells (:rows geometry) (:top geometry) (:top-continued geometry))
    (:x geometry)
    (:y geometry)
    gui?
    true))

(defn- ed-number-chunk-ops (chunks row col)
  "The current line's number repainted from its gutter `chunks` laid from column `col` on
`row`: the chunk in the line-number face again in `face-gutter-line-current`, on the gutter's
background so it covers the dim one. `()` when no chunk is a line number (a mark took the
column, or relative numbering already painted the line in its current face)."
  (if (empty? chunks)
    '()
    (let ([chunk-text face] (first chunks))
      (cond
        (= chunk-text :bar) (ed-number-chunk-ops (rest chunks) row (inc col))
        (= face face-gutter-line)
          (list (text row col chunk-text (assoc face-gutter-line-current :bg (:bg face-gutter-bg))))
        else (ed-number-chunk-ops (rest chunks) row (+ col (string/length chunk-text)))))))

(defn- ed-current-number-ops (pane buf geometry cells)
  "The selected pane's current line number in lavender (`face-gutter-line-current`,
Catppuccin's \"you are here\"), painted over the cached gutter column at the line's first
screen row — an overlay rather than a part of the cells, so a motion leaves the cached
gutter alone (`spancache/ed-gutter-key` holds no point line under absolute numbering). `()`
off the selected pane, with no gutter, or when the line's first row is not on screen."
  (let (line (buffer-current-line buf)
        top (:top geometry)
        index (- line top))
    (if (or (not (:selected pane))
          (nil? cells)
          (< index 0)
          (>= index (count cells))
          (and (= line top) (:top-continued geometry)))
      '()
      (let (row (seq/find (ed-line-screen-rows geometry line (math/max 1 (:text-height geometry)))
                  (fn (row) (nil? (nth row 3 nil)))))
        (if (nil? row)
          '()
          (ed-number-chunk-ops (gutter-cell-chunks (nth cells index))
            (+ (:y geometry) (first row))
            (:x geometry)))))))

(sig ed-pane-text-ops (buffer pane-geometry any any any -> any))
(defn- ed-pane-text-ops (buf geometry hl-ranges spans overrides)
  "The pane's visible text rows (`ed-visible-lines`, memoised per row), the whole BODY one
memoised fragment around them (ADR-336): an unchanged pane's text is one lookup, not one
per row.

The body's deps are exactly what `ed-visible-lines` reads, and every one is a value the
model keeps between turns, so on a frame where nothing in the body moved they are the SAME
cells and `=` answers at once:
- the rope — the text (identity: an edit makes a new one);
- `spans` — the `:span-cache` band's own vector (or the buffer's `:face-spans`);
- the viewport — `:top`, `:render-height` (the smooth-scroll extra row and a narrowing are
  in it), `:hscroll`, the wrapped row table `:rows` (`wrap/rows-from`'s memoised vector) —
  and the text area's `x` and width (the gutter width and the pane's rect are in those);
- `hl-ranges` — the sources' ranges, the region, the overlays, remote selections and the link hover,
  with their faces (a theme switch re-derives `face-region`, so it shows up here);
- `overrides` — the bracket/diagnostic table by line (`ed-overrides-by-line-at`'s own map
  while there is no diagnostic underline; a small `=` walk while there is).
`y` is in the key. Those are also the union of every row's deps, so when the body misses
the rows still answer one by one — a `C-n` that moved the bracket pair re-renders the two
rows it touched, as before; when it hits, the stored ops carry the rows' own markers
(`%ui-harvest` keeps an entry's ops as emitted), so the next turn's rows still find
theirs."
  (let ([x width] (geometry-span geometry :text)
        y (:y geometry)
        top (:top geometry)
        height (:render-height geometry)
        hscroll (:hscroll geometry)
        rows (:rows geometry))
    ;; check-allow: the thunk's only effects are the row-facts and span-slice memo stores
    ;; (`defmemo`), which answer the same whether this turn ran them or not
    (check-allow :pure
      (ui-memo [:body x y]
        [(buffer-rope buf) spans top height hscroll rows width hl-ranges overrides]
        (fn ()
          (ed-visible-lines buf top height x y width hl-ranges spans overrides hscroll true rows))))))

;; ---- link affordance: pointer cursor + subtle hover over clickable rows ------
;; A results buffer (one whose mode provides a `:line-loc` service — *Tests* / *Run*
;; / *compilation* / *Occur* / *git-status*) makes its actionable rows FEEL like
;; links, universally and with no visible link text: every line that resolves to a
;; source location gets a `:pointer` cursor-zone (the hand), and the one under the
;; pointer (`:link-hover`) a subtle surface highlight. The location itself is off in
;; `:line-loc` (text-parsed or stored), never shown. Click-to-visit is the mode's
;; `:on-click` (`cmd-visit-location`); this is purely the affordance.

(def ed-face-link-hover {:underline true}) ; a hovered link row: a proper font underscore
(defn- ed-link-hover-range (m pane buf)
  "The `[lo hi {:underline true}]` range underlining the hovered clickable line's
TEXT — a proper font underscore (the renderer tucks it under the glyphs by font
metrics), merged into the text like a diagnostic underline. `()` unless this pane
holds the hovered link line."
  (let (hover (:link-hover m))
    (if (or (nil? hover)
          (not (= (:buffer hover) (get (:payload pane) :buffer)))
          (>= (:line hover) (buffer-line-count buf)))
      '()
      (let (bol (text/line->char (buffer-rope buf) (:line hover))
            line (ed-line-text buf (:line hover))
            ;; underline ONLY the text — skip the leading indent and any trailing
            ;; whitespace, so an indented row underscores its glyphs, not the tab
            indent (- (string/length line) (string/length (string/triml line)))
            end (string/length (string/trimr line)))
        (if (<= end indent) '() (list [(+ bol indent) (+ bol end) ed-face-link-hover]))))))

(defn- ed-link-zones (buf svc geometry)
  "A `:pointer` cursor-zone over each on-screen row (`ed-line-screen-rows`) of each visible
line the `:line-loc` service `svc` resolves, spanning the text to the body's edge."
  (let (top (:top geometry)
        height (math/max 1 (:text-height geometry))
        last-line (math/min (dec (buffer-line-count buf)) (dec (+ top height)))
        [x width] (geometry-span geometry :row))
    (mapcat (seq/filter (range top (inc last-line)) (fn (line) (svc buf line)))
      (fn (line)
        (map (ed-line-screen-rows geometry line height)
          (fn (row) (cursor-zone x (+ (:y geometry) (first row)) width 1 :pointer)))))))

(sig ed-pane-link-ops (map pane buffer pane-geometry -> any))
(defn- ed-pane-link-ops (m pane buf geometry)
  "The pointer-cursor zones for the pane's clickable visible lines (`ed-link-zones`), so
each reads as a link. (The hover underscore is a text-merged range, `ed-link-hover-range`,
not a zone.) Empty unless the buffer's mode offers `:line-loc` (ordinary buffers cost one
lookup)."
  (let (svc (ed-mode-service buf :line-loc))
    (if (nil? svc)
      '()
      ;; memoised (ADR-336) like the rows themselves: a `:line-loc` is a text parse — the
      ;; `file:line` regex table over every visible row — and a blink or a mouse move
      ;; changes none of what it reads (the text, the off-text `:line-links`)
      (ui-memo [:links (:x geometry) (:y geometry)]
        [(buffer-rope buf)
          (:line-links buf)
          svc
          (:top geometry)
          (math/max 1 (:text-height geometry))
          (geometry-span geometry :row)
          (:y geometry)
          (:rows geometry)
          (:hscroll geometry)]
        (fn () (ed-link-zones buf svc geometry))))))

;; ---- end-of-line notes: derived text shown AT a line -------------------------
;; A buffer may carry `:eol-notes` (see `eolnotes/eol-notes`) — derived text anchored
;; to lines, e.g. the tutorial's per-box verdicts. THREE renderers share that one
;; annotation: the margin glyph (gutter/gutter-mark-for), the echo row when point is
;; on the line (ed-eol-note-on-line), and here — eros-style ghost text two cells
;; past the line's end: `=> 42` muted, `✓ 42` green, `✗ …` red, `⋯` pending, all
;; dimmed once the text moves and blanked once lines shift (std `annotate` owns that
;; currency). Pure ops over existing `text` — no new display primitive (the
;; keep-the-surface-small rule).

(def *eol-note-gap* (ui-space-cells :note-gap))
;; Cells between the code and the first ghost note, and between two notes on one line. A
;; note is somebody else's voice arriving at the end of your line, and at two cells it read
;; as a continuation of the code — `|> DateTime.` followed by `error: cannot pipe` looked
;; like one expression. Three is the smallest gap that reads as a gap.

(def *eol-note-max-cols* 64)
;; A ghost note is a GLANCE, not the report. A checker message can run to a couple of
;; hundred columns (`+: expected number, got failure (#failure{:message "…"})`), and drawn
;; from the end of an already-indented line it walked off to the right edge, where the only
;; readable part was the half nobody needed. Capped here, ellipsised by `ui-clip`, and the
;; whole thing is still one keystroke away: the echo row (`eolnotes/eol-note-at`) prints the
;; full text whenever point is on the line.

;; An inlay row: derived text on a row of its own, above the code it describes. The hint
;; voice — dim and italic — because it is a remark about the line below it and must never
;; read as a line of the buffer. Same face as the type note it replaces when the note is too
;; long to sit at the end of its line. `defchrome`, so a theme switch re-derives it: as a
;; plain `def` it kept the colour of the theme the editor started with.
(defchrome face-inlay-line {:fg *overlay0* :italic true})

(def face-completion-preview
  ;; The inline completion preview: the SAME dim as a pending note, and not italic. It is
  ;; text you are about to write rather than a remark about your code, so it should read as
  ;; your own line continuing in a lighter hand — italics would make it a different kind of
  ;; thing sitting in the middle of an identifier.
  {:fg *overlay0*})

(defn ed-preview-op (m buf pane-selected? row col avail)
  "The one op for the inline completion preview — the top candidate's remainder painted
immediately after the cursor — or nil.

Painted only for the selected pane, and only while the cached preview still describes the
buffer as it stands (`:completion-preview-at`, the point-and-rope it was computed for).
That guard is the whole difference between a suggestion and a lie: the preview is computed
on the idle beat, so between the keystroke and the recompute the cached one describes text
that has already moved on, and painting it there would put somebody else's word after your
cursor."
  (let (pv (ed-live-preview m buf pane-selected?))
    (when (and pv (> avail 0))
      (text row col (ui-clip (:text pv) avail) face-completion-preview))))

(defn- ed-live-preview (m buf pane-selected?)
  "The inline completion preview the pane paints, or nil: one for the selected pane, no
minibuffer or input-method composition in the way, still stamped with `buf`'s point and
rope. [[ed-preview-op]] paints it and [[ed-preview-push]] makes room for it."
  (let (pv (:completion-preview m))
    (when (and pane-selected?
            pv
            (nil? (:minibuffer m))
            (nil? (:preedit m))
            (= (:completion-preview-at m) [(buffer-point buf) (buffer-rope buf)]))
      pv)))

(defn- ed-preview-push (m pane buf)
  "`{line cols}`: the columns the live preview takes at the end of point's line, or `{}`.
A preview is only ever offered at a line's end (`complete-at-point/completion-preview`),
which is exactly where that line's notes sit, so the notes start after it — the tutorial's
`✓ that's it` once read `-mothat's it` under a preview of `-mode`. Emacs's completion
preview is an overlay that pushes an `after-string` along the same way."
  (let (pv (ed-live-preview m buf (:selected pane)))
    (if (nil? pv) {} {(buffer-current-line buf) (string/display-width (:text pv))})))

(defn- ed-eol-note-face (kind stale)
  (cond
    ;; the dim, italic voice of a note that is not a verdict:
    ;; - no-answer-yet (`note-pending?`) — whether the sandbox is still working (:running)
    ;;   or the form isn't finished (:incomplete) — never reads as a stale verdict
    ;; - broken reads as pending too: red is for code that RAN and failed, and a form is
    ;;   unparseable for most of the keystrokes it takes to write one
    ;; - a derived type (:hint) sitting at the code it describes — the inlay-hint voice, so
    ;;   it never competes with the answer below it for being read first
    (or (eolnotes/note-pending? kind) (= kind :broken) (= kind :hint)) {:fg *overlay0* :italic true}
    (= kind :warn) {:fg *yellow*}
    stale {:fg *overlay0*}
    else {:fg (case kind :pass *green* :fail *red* *subtext*)}))

(defn- ed-eol-note-avail (note room)
  "The columns `note` may take of the `room` left on its row.

A result or a derived type is a GLANCE — a remark about code you can already read — and
capping it at [[*eol-note-max-cols*]] is what keeps the right of the screen legible.

A FAILURE is not a remark, it is the answer, and the cap cost exactly the half worth having:
`** (FunctionClauseError) no function clause matching in String.upcase/1` cut at 64 columns
keeps the words every raise shares and drops the function that raised. So a raise takes the
whole row. It still ends at the pane edge — the full text is one keystroke away in the echo
row, and in `*Diagnostics*` (C-c !), which is where a message too long for any row belongs."
  (if (= (:kind note) :fail) room (math/min room *eol-note-max-cols*)))

(sig ed-eol-note-row-ops (any int any int int int int -> any))
(defn- ed-eol-note-row-ops (notes row stale from-col text-x hcol width)
  "Ghost-text ops for the notes anchored on ONE line, on screen row `row`, laid out left
to right from the line's display column `from-col` — `hcol` columns of the line sit left
of the row's first cell, which is screen column `text-x`, and the row is `width` cells —
each keeping its own face, none painting over another.

A line can carry several (`eolnotes/notes-on-line`), and drawing them all at one column is
not a near-miss: `=> bar` and `=> 42` at the same cell render as unreadable mush, which is
what this fold exists to make unrepresentable. Each note advances the column past what it
drew; one that no longer fits is dropped, and so is everything after it."
  (second (fold notes
            [from-col '()]
            (fn (acc note) (ed-eol-note-row-step acc note row stale text-x hcol width)))))

;; The fold step above, as a function so its accumulator has a declared shape: `[col ops]`
;; — the next free column and the ops so far. A lambda's accumulator no `sig` can reach.
(sig ed-eol-note-row-step ((tuple int list) any int bool int int int -> (tuple int list)))
(defn- ed-eol-note-row-step (acc note row stale text-x hcol width)
  (let ([col ops] acc
        body (eolnotes/note-text note)
        at (- col hcol)
        avail (ed-eol-note-avail note (- width at 1)))
    (if (or (< at 0) (<= avail 3))
      acc
      [(+ col (string/display-width body) *eol-note-gap*)
        (append ops
          (list (text row
                  (+ text-x at)
                  (ui-clip body avail)
                  (ed-eol-note-face (if (:warn note) :warn (:kind note)) stale))))])))

(defn- ed-fold-notes (geometry notes)
  "`notes` plus a dim `…` after every line the row table jumps PAST — the next text row is
not the line below — which is a fold's heading: its body takes no rows (`wrap/hidden?`).
Read off the table rather than the folds, so the view needs to know nothing about them."
  (let (text-rows (seq/filter (or (:rows geometry) []) (fn (row) (nil? (nth row 3)))))
    (fold (range (dec (count text-rows)))
      notes
      (fn (acc i)
        (let (line (first (nth text-rows i))
              next-line (first (nth text-rows (inc i))))
          (if (> next-line (inc line))
            (assoc acc line (append (get acc line '()) (list {:kind :hint :text "…"})))
            acc))))))

(defn- ed-diag-note (d)
  "A checker diagnostic in the end-of-line note's shape: a `:warn`, its message after a ⚠."
  {:kind :warn :warn true :text (str "⚠ " (:message d))})

(defn- ed-diag-notes (m buf top text-h)
  "The advisory checker's cached diagnostics as end-of-line notes on the `text-h` lines
from `top`, keyed by 0-based line — `{line (⚠-note …)}` — for `buf` ONLY when it is the
very rope the diagnostics were computed from (`:diag-rope`), so a warning can never sit on
a line the text has moved out from under; `{}` otherwise. Per VISIBLE line off the model's
index (`ed-visible-diagnostics`), like `ed-diagnostic-overrides`: this runs every frame. The
gutter's ⚠ was easy to miss beside a live buffer's own ·/✓ marks, and the type note beside
a form said `: bool` about `(< number)` while the checker knew the argument could not be
ordered; the message belongs on the line, in the note's voice. Not on a form whose run
already FAILED (`eolnotes/error-spans`): its error is on screen, and the ⚠ would repeat it."
  (if (not (= (buffer-rope buf) (:diag-rope m)))
    {}
    (let (failed (eolnotes/error-spans buf))
      (into {}
        (seq/keep (ed-visible-diagnostics m top (+ top text-h))
          (fn ([line ds])
            (when (not (any? failed (fn ([from to]) (and (>= line from) (<= line to)))))
              [line (map ds ed-diag-note)])))))))

(defn- ed-eol-line-note-ops (buf geometry line notes stale push)
  "Ghost-text ops for the `notes` on `line`, after the line's LAST row (`ed-line-last-row` —
a wrapped line's last segment), its columns following that row's start like the body text
and `push` more (the completion preview's, [[ed-preview-push]]); `()` when that row is off
the painted rows."
  (let (row (ed-line-last-row geometry line (:render-height geometry)))
    (if (nil? row)
      '()
      (let ([k from _] row
            [x width] (geometry-span geometry :row)
            text (ed-line-text buf line)
            ;; the columns of the line left of this row: its hscroll, or a wrapped
            ;; row's segment start measured on the line's stops (tabs)
            hcol (if (nil? (:rows geometry))
                   (:hscroll geometry)
                   (string/display-width (string/substring text
                                           0
                                           (math/min from (string/length text))))))
        (ed-eol-note-row-ops notes
          (+ (:y geometry) k)
          stale
          (+ (string/display-width text) push *eol-note-gap*)
          x
          hcol
          width)))))

(sig ed-eol-note-ops (buffer pane-geometry &optional map (map int int) -> any))
(defn- ed-eol-note-ops (buf geometry &optional (diag {}) (push {}))
  "Ghost-text ops for the pane's visible end-of-line notes — `eolnotes/eol-notes` plus the
`diag` notes (`ed-diag-notes`), a line's set `push` columns further out (`ed-preview-push`) —
one annotation lookup on a buffer that has none. A note is
owner-keyed with its anchor line inside (`:line`), so it can never be stranded at a line the
text moved out from under. Iterated by LINE rather than by note, because a line may carry
more than one and they have to be placed relative to each other (`ed-eol-note-row-ops`).
Clipped to the pane's text width, and a line too full to fit at least a few cells drops its
note rather than overpaint. Whoever annotates gets this rendering for free: the tutorial's
verdicts today, inline eval results / inlay hints / blame next. Laid out over the
`geometry`'s `:render-height` rows."
  (let (top (:top geometry)
        end (math/min (+ top (:render-height geometry)) (buffer-line-count buf))
        ;; a diagnostic note is a `:warn`, whose face no staleness changes — so only the
        ;; buffer's own notes ask
        stale (eolnotes/eol-notes-stale? buf)
        note-lines (eolnotes/note-lines buf))
    ;; no notes and no diagnostics on screen — the usual frame — is answered here, before
    ;; the distinct/filter/mapcat walk over nothing
    (if (and (empty? note-lines) (empty? diag))
      '()
      (mapcat (seq/filter (seq/distinct (append note-lines (keys diag)))
                (fn (line) (and (>= line top) (< line end))))
        (fn (line)
          (ed-eol-line-note-ops buf
            geometry
            line
            (append (eolnotes/notes-on-line buf line) (get diag line '()))
            stale
            (get push line 0)))))))

;; ---- one pane: its geometry, its layers, its regions, its chrome ---------------

(defn- ed-pane-smooth-frac (pane buf top text-h)
  "The pane's smooth-scroll fraction (`ed-pane-scroll-frac`), or 0.0 when it is stale: the
buffer fits entirely in the viewport, or `top` is already at/past the scroll limit (e.g.
after a git-refresh shrinks the buffer). Without this clamp a stale frac renders one row
more than the text has, requesting rope lines past EOF and crashing the renderer."
  ;; the fraction FIRST: it is 0.0 on every frame but a glide's, and the clamp behind it
  ;; (`ed-max-top`, a wrap check and the gutter width) cost 60 µs a frame to answer a
  ;; question only a non-zero fraction asks
  (let (frac (ed-pane-scroll-frac pane))
    (if (or (<= frac 0.0)
          (>= top (ed-max-top buf (math/max 1 text-h) (ed-pane-text-cols pane buf))))
      0.0
      frac)))

(defn- ed-narrowed-height (pane buf top height)
  "`height` rows, capped — in a narrowed pane — at the restriction's last line, so only the
lines in the restriction are drawn (the rest of the pane stays blank: the focus look).
`top` is already clamped into the restriction by `ed-pane-top`."
  (let (restrict (get (:payload pane) :restrict))
    (if (nil? restrict)
      height
      (let ([_ last-line] (ed-restrict-lines buf restrict))
        (math/max 1 (math/min height (- (inc last-line) top)))))))

(sig ed-pane-geometry (pane buffer -> pane-geometry))
(defn- ed-pane-geometry (pane buf)
  "The body's frame, built once per pane (see the geometry note above `ed-hl-line-band`):
the pane's rect — or, zoomed, the region's own cell space, whose width and height are the
columns and rows that fit at that size (`w` counts the scrollbar column). One more row is
rendered while smoothly scrolling, so the partial-line gap at the bottom is filled (the
mode line's rect, outside the scroll-region, covers the overflow). Also carries
`:scroll-frac`, which only `ed-pane-ops` reads."
  (let ([x y w h] (:rect pane)
        zoomed? (not (nil? (get (:payload pane) :zoom)))
        top (ed-pane-top pane buf)
        text-h (if zoomed? (ed-pane-vrows pane buf) (math/max 0 (dec h)))
        scroll-frac (ed-pane-smooth-frac pane buf top text-h))
    {:top top
     :x (if zoomed? 0 x)
     :y (if zoomed? 0 y)
     :width (if zoomed? (inc (ed-pane-cols pane buf)) w)
     :gutter-width (ed-pane-gutter-width buf pane)
     ;; the right margin's cells, the gap included (`panes/ed-right-margin-width`; 0 without)
     :margin-width (ed-right-margin-width buf)
     :text-height text-h
     ;; one row more while smoothly scrolling, and in a pane over the seam, whose next line
     ;; shows partly in the leftover strip (`ed-partial-row-pane`)
     :render-height (ed-narrowed-height pane
                      buf
                      top
                      (if (or (> scroll-frac 0.001) (:partial-row pane)) (inc text-h) text-h))
     ;; the row table of a wrapped buffer (`panes/ed-pane-rows`; nil unwrapped): every
     ;; line→row question goes through it, so the text, the cursor, the bands and the
     ;; notes land on the same rows
     :rows (ed-pane-rows pane buf)
     :top-continued (ed-pane-top-continued? pane buf)
     :hscroll (ed-pane-hscroll pane)
     :scroll-frac scroll-frac}))

(defn- ed-point-cell (buf geometry)
  "`[row column avail]` — the body cell point is painted at and the text columns from it to
the edge — or nil when point's row is not on screen (`ed-rows-offset-row`: the row the text
was painted on, wrapped or not). Where the caret and the inline completion preview go."
  (let ([x width] (geometry-span geometry :text))
    (ed-point-cell-at (buffer-rope buf)
      (buffer-point buf)
      (:rows geometry)
      (:top geometry)
      (:hscroll geometry)
      (math/max 1 (:text-height geometry))
      (:y geometry)
      x
      width
      (conventions/cell-layout-key))))

;; check-allow: a hit comes back out of the memo's store, which the checker reads as
;; unknown; the store only ever holds what the body below built, a cell or nil.
(check-allow :trusted
  (defmemo ed-point-cell-at 4 (rope point rows top hscroll vrows y text-x width cell-layout)
    "`ed-point-cell` on the values it reads — the text, point and the viewport — remembered,
because it is asked every frame the caret is painted, a blink's included, and measuring
point's column reads the line from its start: on a long line that was the dearest step of
a frame in which nothing had moved."
    ;; `buffer-current-line` / `buffer-column`, over the rope and point
    (let (line (text/char->line rope point)
          at (ed-rows-offset-row rows
               top
               line
               (- point (text/line->char rope line))
               hscroll
               vrows))
      (when at
        (let ([k from] at
              column (math/max 0
                       (math/min (dec width) (ed-visual-column-at rope point from cell-layout))))
          [(+ y k) (+ text-x column) (- width column)])))))
(sig ed-point-cell-at (any int any int int int int int int any -> any))

(defn- ed-other-cursor (m)
  "The caret a window shows while it does not have the keyboard — another pane, or every
pane while the minibuffer does: the init file's `:cursor-other-windows`, `:hollow` by
default (Emacs's `cursor-in-non-selected-windows`), nil when it is `false`."
  (let (shape (:cursor-other-windows m))
    (cond
      (nil? shape) :hollow
      (= shape false) nil
      else shape)))

(defn- ed-held-spans (m pane buf)
  "The spans `pane` already holds for `buf`, with no lexing: the buffer's own `:face-spans`,
else the `:span-cache` entry while it was coloured from this rope and type — what the caret
reads its face from every frame, so a miss is the default face rather than a re-lex."
  (or (:face-spans buf)
    (let (entry (map/get-in m [:span-cache (:path pane)]))
      (when (and entry (= (:rope entry) (buffer-rope buf)) (= (:type entry) (:type buf)))
        (:spans entry)))))

(defn- ed-face-in (spans at)
  "`ed-face-at` over one span vector, or several as `ed-span-sources` (the first face found wins)."
  (cond
    (nil? spans) nil
    (map? spans)
      (fold (:span-sources spans) nil (fn (found source) (or found (ed-face-in source at))))
    else
      (let (v (if (vector? spans) spans (into [] spans))
            n (count v)
            i (ed-span-seek v n at))
        (when (and (< i n) (<= (first (nth v i)) at)) (nth (nth v i) 2 nil)))))

(defn ed-face-at (spans at)
  "The face of the span in `spans` (ascending `[start end face]`, or several as
`ed-span-sources`, or two `ed-span-layers`) covering offset `at`, by bisection, or nil
where none does. Of two layers the upper's face wins; the lower's shows where the upper
has none, an SGR attribute resolved as it is painted.

    (view/ed-face-at [[0 2 {:bold true}] [4 6 {:italic true}]] 5)   ;=> {:italic true}
    (view/ed-face-at [[0 2 {:bold true}]] 3)   ;=> nil"
  (if (and (map? spans) (contains? spans :span-under))
    (or (ed-face-in (:span-over spans) at)
      (ed-span-face (ed-face-in (:span-under spans) at) (:palette spans)))
    (ed-face-in spans at)))

(defn- ed-pane-cursor-op (m pane buf cell preview-op)
  "The caret at point's `cell`, when it is on screen. The pane with the keyboard (selected,
no minibuffer open) gets the configured style, blinking; any other gets `ed-other-cursor`,
still, as Emacs marks where point is in a window you are not typing in. A buffer may hide
its caret or name its shape — a terminal buffer's program does both (`:cursor-hidden`,
`:cursor-shape`). Nil otherwise.

`preview-op` is the text op painted at point before the caret (a completion preview or an
input method's composition), nil when there is none: a block shows ITS first character in
its face, since that is what the cell holds, and otherwise the character after point in
its syntax face (`ed-held-spans`), so a bold keyword stays bold under the caret."
  (when (and cell (not (:cursor-hidden buf)))
    (if (and (:selected pane) (nil? (:minibuffer m)))
      (ed-caret m
        (first cell)
        (second cell)
        (or (:cursor-shape buf) (ed-cursor-style m))
        (if preview-op (nth preview-op 3) (buffer-char-after buf))
        (if preview-op
          (nth preview-op 4 nil)
          (ed-face-at (ed-buffer-spans buf (ed-held-spans m pane buf)) (buffer-point buf))))
      (let (shape (ed-other-cursor m))
        (when shape (cursor (first cell) (second cell) shape *cursor*))))))

;; check-allow: a hit comes back out of the memo's store; it only ever holds what
;; `ed-point-cell` answered for that pane and buffer
(check-allow :trusted
  (defmemo ed-resting-point-cell 8 (pane buf cell-layout)
    "Point's cell in a pane that is not selected — remembered per pane and buffer, since such
a pane builds no geometry at rest (`ed-pane-op-groups`) and is asked again every frame."
    (ed-point-cell buf (ed-pane-geometry pane buf))))

(defn- ed-pane-held-tree (m pane buf)
  "The tree handle the pane's buffer keeps (`syntaxtree`) when it was parsed from exactly
the text shown, in the buffer's language — else nil, and a structural read takes the text."
  (let (lang (ed-mode-service buf :ts-lang))
    (when lang
      (syntaxtree/held-tree-for (syntaxtree/syntax-tree-entry m
                                  (map/get-in pane [:payload :buffer]))
        buf lang))))

(defn- ed-pane-overrides (m pane buf geometry)
  "The selected pane's `[pos face]` overrides — the bracket pair at point and the
diagnostic underlines — grouped by line for the row memo, so a bracket move invalidates the
two lines its pair sits on, not every row on screen (`ed-overrides-by-line`). `{}` for an
unselected pane."
  (if (:selected pane)
    (let (bracket (ed-bracket-overrides buf (ed-pane-held-tree m pane buf))
          diagnostic (ed-diagnostic-overrides m buf (:top geometry) (:render-height geometry)))
      ;; With no diagnostic underline on screen — the usual case — the list IS the bracket
      ;; memo's own value, the same cell every frame point stays put, so the grouping is
      ;; remembered too (`ed-overrides-by-line-at`) and every row gets back the SAME
      ;; per-line lists: the row memo's `=` on them answers at once instead of walking a
      ;; regrouped copy.
      (if (empty? diagnostic)
        (ed-overrides-by-line-at (buffer-rope buf) bracket)
        (ed-overrides-by-line (buffer-rope buf) (append bracket diagnostic))))
    {}))

;; check-allow: a hit comes back out of the memo's store, which the checker reads as
;; unknown; the store only ever holds what `ed-overrides-by-line` built, a `{line -> list}`.
(check-allow :trusted
  (defmemo ed-overrides-by-line-at 4 (rope overrides)
    "`ed-overrides-by-line`, remembered for the last four calls (one per pane showing a
selected buffer is plenty)."
    (ed-overrides-by-line rope overrides)))

(defn- ed-pane-hl-ranges (m pane buf)
  "The pane's highlight ranges in priority order: the registered sources, lowest `:rank` first
(`model/ed-highlight-ranges`), then the region and overlays, and the hovered clickable row's
underscore (a proper font underline)."
  (append (ed-highlight-ranges m pane buf (ed-pane-top pane buf) (ed-pane-vrows pane buf))
    (ed-hl-ranges m buf (:selected pane))
    (ed-link-hover-range m pane buf)))

(defn- ed-gutter-bg-ops (geometry)
  "The line-number gutter's own recessed surface, short of the edit margin; `[]` with no
gutter."
  (let ([x gutter-width] (geometry-span geometry :gutter))
    (if (> gutter-width 0)
      [(rect (:y geometry)
         x
         (math/max 0 (- gutter-width *gutter-edit-margin*))
         (:text-height geometry)
         face-gutter-bg)]
      [])))

(defn- ed-right-margin-ops (buf geometry)
  "The buffer's right margin (`:right-margin`, `{:width :lines {line [[text face] …]}}`):
each shown line's segments painted in the margin's column at the pane's right edge, on the
line's first screen row — Emacs's right margin, where Magit's log keeps who and when. The
text area was narrowed for it (`:margin-width`), so a long line is cut before it rather
than painted under it. `()` for a buffer without one."
  (let (margin (:right-margin buf))
    (if (nil? margin)
      '()
      (let (top (:top geometry)
            height (:render-height geometry)
            end (math/min (+ top height) (buffer-line-count buf))
            x (first (geometry-span geometry :margin))
            lines (:lines margin))
        (mapcat (range top end)
          (fn (line)
            (let (segments (get lines line)
                  row (when segments (first (first (ed-line-screen-rows geometry line height)))))
              (if (nil? row)
                '()
                (second (fold segments
                          [x '()]
                          (fn ([col ops] segment)
                            (let ([s face] segment)
                              [(+ col (string/display-width s))
                                (conj ops (text (+ (:y geometry) row) col s face))]))))))))))))

(defn- ed-line-band-ops (buf geometry)
  "The buffer's line backgrounds (`:line-bands`, `{line face}`): a band across the text area
behind each shown line, every screen row of a wrapped one — a diff's added and removed lines
tinted whole, Magit's `magit-diff-added`, rather than only as far as their text reaches.
Drawn first, so the hl-line band and the region sit over it. `()` for a buffer without any."
  (let (bands (:line-bands buf))
    (if (empty? bands)
      '()
      (let (top (:top geometry)
            height (math/max 1 (:text-height geometry))
            end (math/min (+ top height) (buffer-line-count buf)))
        (mapcat (seq/filter (range top end) (fn (line) (contains? bands line)))
          (fn (line)
            (map (ed-line-screen-rows geometry line height)
              (fn (row) (geometry-band geometry (first row) (get bands line))))))))))

(defn- ed-pane-static-ops (m pane buf geometry push)
  "The pane's scrolling layers that do not blink, as one flat op list, bottom to top: the
line backgrounds (a diff's tinted lines), the
hl-line band, the gutter surface, the region's end-of-line fill, the link zones, the body
(gutter + lines), the ghost notes (point's line's set `push` columns past the completion
preview, [[ed-preview-push]]) and other participants' carets."
  (let (top (:top geometry)
        render-h (:render-height geometry)
        ;; cached across frames — typing never changes the gutter
        gutter-cells (ed-pane-gutter-cells m
                       pane
                       buf
                       top
                       render-h
                       (second (geometry-span geometry :gutter))))
    (ed-flatten-ops
      (list (ed-line-band-ops buf geometry)
        (ed-hl-line-band m pane buf geometry)
        (ed-gutter-bg-ops geometry)
        (ed-region-eol-bands buf geometry)
        ;; link affordance (results buffers): the pointer-cursor zones draw
        ;; nothing, so their order is free
        (ed-pane-link-ops m pane buf geometry)
        (ed-pane-gutter-ops geometry gutter-cells (:gui m))
        (ed-current-number-ops pane buf geometry gutter-cells)
        (ed-pane-text-ops buf
          geometry
          (ed-pane-hl-ranges m pane buf)
          (ed-buffer-spans buf
            (ed-pane-spans m pane buf top (+ (ed-pane-vrows pane buf) (if (:partial-row pane) 1 0))))
          (ed-pane-overrides m pane buf geometry))
        ;; the right margin (a log's author and age), beside the text it was narrowed for
        (ed-right-margin-ops buf geometry)
        ;; end-of-line notes: ghost text past a line's end (`=> 42` / ✓ / ✗ /
        ;; ⋯) — one annotation lookup on ordinary buffers
        (ed-eol-note-ops buf
          geometry
          (ed-fold-notes geometry (ed-diag-notes m buf top render-h))
          push)
        ;; the pane layers that scroll with the text (collab's other participants'
        ;; carets), over the text and under our own cursor
        (ed-pane-layer-ops m pane buf geometry :with-text)))))

(defn- ed-pane-layers (m pane buf geometry)
  "Every op that scrolls with the pane's text, bottom to top: the hl-line band, the gutter
surface, the region's end-of-line fill, the link zones, the body (gutter + lines), the
ghost notes, the `:with-text` pane layers (other participants' carets), the inline completion
preview and the caret. The caret and the preview are emitted HERE, inside the scroll-region,
so they track the fractional offset with the text and the hl-line band — all three in one
coordinate frame. The renderer clips a partially-visible caret at the viewport top rather
than dropping it. Two op lists — everything up to the carets (`ed-pane-static-ops`), then the preview and
the caret — which `ed-flatten-ops` joins. `geometry` is nil for an unselected pane at rest
(`ed-pane-op-groups`): it paints no caret, and its fragment builds the geometry on a miss.

Everything but the preview and the caret is ONE memoised fragment (ADR-336) per pane, so a
pane nothing touched — the other side of a split while you type in this one, or this one
on a cursor blink — costs one lookup rather than its gutter cache check, highlight ranges,
spans, overrides, notes and the body's own memo. Its deps are every input those layers read
(`ed-pane-static-ops`), in the order most likely to differ first:
- the buffer — its text, point, mark, mode and every annotation (gutter marks, notes, the
  diff bars, `:face-spans`, `:long-lines`) live on it; the same cell until an edit, a
  motion or a re-stamp makes a new one;
- the pane — its rect, `:selected`, and its payload's top, hscroll, zoom, restriction and
  line-number toggle (the whole geometry is a function of the pane and the buffer);
- the model's caches the layers read for this pane: its `:span-cache` and `:gutter-cache`
  entries (by pane path), the diagnostics (`:diag-rope` + `:diag-by-line`, the underline and
  the ⚠ notes), what the `:with-text` pane layers read (`model/ed-pane-layer-deps`:
  collab's remote carets), the hovered link row, the `:overlays` and `:hl-line`, and the `:gui` flag;
- what the highlight sources read (`model/ed-highlight-deps`);
- the palette (`ed-palette-token`), because the bands, the gutter and the notes paint
  faces derived from it rather than handed in as data;
- the room the completion preview takes at the end of point's line (`ed-preview-push`),
  which moves that line's notes;
- the cell layout the pane is laid out at (`conventions/cell-layout-key`: tab width, glyphless display).
When it misses, the body and the gutter inside still answer from their own memos."
  (let (selected? (:selected pane)
        ;; point's cell: the selected pane's caret and preview, or another pane's resting caret
        cell (cond
               (and selected? geometry) (ed-point-cell buf geometry)
               (and (not selected?) (ed-other-cursor m))
                 (ed-resting-point-cell pane buf (conventions/cell-layout-key)))
        ;; the inline completion preview, at the cursor's own cell — same row and column
        ;; the caret is on, so it reads as the line continuing
        ;; or, while an input method composes, the text it is composing (painted where it
        ;; will be inserted, and in place of the preview)
        preview-op (when (and cell selected?)
                     (let ([row column avail] cell)
                       (if (and (:preedit m) (not (:minibuffer m)))
                         (ed-preedit-op m row column avail)
                         (ed-preview-op m buf selected? row column avail))))
        ;; the room the preview takes before point's line's notes: a dep of the memo below,
        ;; since it moves them
        push (ed-preview-push m pane buf)
        [x y _ _] (:rect pane)
        path (:path pane))
    (list
      ;; check-allow: the effects the checker sees in the thunk are memo stores (`defmemo`
      ;; remembering the bracket match, the span slicing, the row facts) and the mode-service
      ;; lookup resolving a layer by name — each answers the same whether it ran this turn
      ;; or not, so a reused fragment skips nothing a later turn can tell
      (check-allow :pure
        (ui-memo [:pane x y]
          [buf
            pane
            (map/get-in m [:span-cache path])
            (map/get-in m [:gutter-cache path])
            (:diag-rope m)
            (:diag-by-line m)
            (ed-pane-layer-deps m pane buf :with-text)
            (:link-hover m)
            (:overlays m)
            (ed-highlight-deps m pane buf)
            (:hl-line m)
            (:gui m)
            (ed-palette-token)
            push
            ;; the buffer's cell layout (bound around this pane, `ed-pane-op-groups`): M-x
            ;; reload-config with a new tab width or `:glyphless-chars` repaints the same text
            (conventions/cell-layout-key)]
          ;; an unselected pane at rest arrives without its geometry (`ed-pane-op-groups`)
          (fn () (ed-pane-static-ops m pane buf (or geometry (ed-pane-geometry pane buf)) push))))
      ;; the preview before the caret, so a block cursor sits ON its first character (a nil
      ;; of either is dropped by the flatten)
      (list preview-op (ed-pane-cursor-op m pane buf cell preview-op)))))

(defn- ed-pane-region-group (pane scroll-frac layer-groups)
  "The scrolling layers (`layer-groups`, one op list per layer) as ONE op group wrapped in
their regions — a `scroll-region` while a smooth scroll is part-way (`scroll-frac` past ≈ 0,
self-resetting, ADR-114) and, for a zoomed pane, a `cell-region` (brood ADR-363) over the
pane's rect less the scrollbar column and the mode line row, painted at the pane's size.
Only called when one of them applies: at rest the layers go out flat, so tests see
top-level ops at no overhead."
  (let ([x y w h] (:rect pane)
        zoom (get (:payload pane) :zoom)
        layers (into [] (ed-flatten-ops layer-groups))
        scrolled (if (> scroll-frac 0.001) [(scroll-region scroll-frac layers)] layers))
    (if (nil? zoom)
      scrolled
      [(cell-region x
         y
         (math/max 1 (dec w))
         (math/max 0 (dec h))
         (:px zoom)
         (into [] scrolled))])))

(defn- ed-pane-scrollbar (m pane buf geometry)
  "The selected pane's scrollbar, in the window's cells. The SELECTED pane's only — the
fade is one model-wide budget, so drawing it everywhere lit every pane's bar on any scroll,
including panes nothing had touched. It says where you are, and you are in one pane (the
same `:selected` test the cursor, hl-line and bracket overrides use)."
  (if (and (:selected pane) geometry)
    (let ([x y w h] (:rect pane))
      (ed-scrollbar-ops buf
        (:top geometry)
        (:text-height geometry)
        (+ x (dec w))
        y
        (ed-scrollbar-opacity m)
        (math/max 0 (dec h))))
    '()))

(sig ed-pane-ops (model pane -> any))
(defn ed-pane-ops (m pane)
  "All render ops for one pane: a full-width hl-line band behind the text, an optional
left line-number gutter, its visible buffer lines inside the rect above its mode line, a
1-column scrollbar on the right edge (the selected pane's only), plus the mode line. Lines are syntax-coloured when
the buffer's mode offers a `:fontify` service (spans served from the model's cross-frame
`:span-cache` via `ed-pane-spans`, so plain motion re-lexes nothing), region-highlighted,
and — in the selected pane — the bracket pair at point is marked. The scrolling layers are
`ed-pane-layers`; the band, scrollbar and base-chrome mode line wrap them.

A ZOOMED pane (`appearance/zoom-of` on its payload — Ctrl+wheel, `C-x C-=`) is painted at
its own font size inside a `cell-region` (brood ADR-363): every body op is laid out in the
REGION's cells — origin 0,0, `ed-pane-cols` wide, `ed-pane-vrows` tall — and the region
places them in the pane's rect at `px`. The mode line and the scrollbar are outside it, in
the window's cells, so a zoom moves nothing but this pane's text. Unzoomed there is no region and the
body is laid out straight into the rect, exactly as before — so every op-level test holds.

When a trackpad gesture is in progress, the pane carries a `:scroll-frac` ∈ [0, 1) from
`ed-smooth-scroll-pane`. We collect all scrollable ops (bands, gutter, body, cursor) into
a `scroll-region` block — a scoped, self-resetting primitive (ADR-114), inside the cell
region when there is one (its offset is then in the region's cells, as it should be). The
scrollbar and mode line (fixed chrome) are emitted outside both so they never shift. When
frac = 0 the ops are emitted flat (no region wrapper) for test-compatibility and zero overhead."
  (ed-flatten-ops (ed-pane-op-groups m pane)))

(sig ed-pane-op-groups (model pane -> any))
(defn- ed-pane-op-groups (m pane)
  "[[ed-pane-op-groups-at]] with the pane's BUFFER's cell layout (`conventions/with-cell-layout`):
its tab width (.editorconfig, init.blsp, the mode) as `*tab-width*` (brood ADR-537) and the
glyphless display, which every cell measure under the render reads."
  (conventions/with-cell-layout (ed-pane-buf m pane) (fn () (ed-pane-op-groups-at m pane))))

(sig ed-pane-op-groups-at (model pane -> any))
(defn- ed-pane-op-groups-at (m pane)
  "`ed-pane-ops` as op GROUPS — the scrolling layers (flat, or in their regions), then the
fixed chrome: scrollbar + mode line, always outside the scroll-region — so `ed-view`
flattens every pane of the frame in a single copy (`ed-flatten-ops`).

An UNSELECTED pane at rest builds no geometry here: its caret, preview and scrollbar are
never painted and nothing wraps its layers, so the only reader left is its memoised layers
fragment, which builds the geometry itself when it misses. A pane nothing touched is then
its layers lookup and its mode line — the other side of a split costs next to nothing while
you type in this one."
  (let (buf (ed-pane-buf m pane)
        selected? (:selected pane)
        geometry (when (or selected? (> (ed-pane-scroll-frac pane) 0.0))
                   (ed-pane-geometry pane buf))
        scroll-frac (if (nil? geometry) 0.0 (:scroll-frac geometry))
        layers (ed-pane-layers m pane buf geometry)
        scrollbar (ed-pane-scrollbar m pane buf geometry)
        modeline (ed-pane-modeline m pane buf)
        header (ed-pane-layer-ops m pane buf geometry :chrome)
        band (ed-pane-layer-ops m pane buf geometry :over-text))
    ;; built as a list directly, not `append`ed: this runs per pane per frame
    (cond
      ;; a pane over the seam: its layers, one row taller, in the block that shows that
      ;; row's top in the leftover strip (brood ADR-615)
      (:partial-row pane)
        (list [(above-seam (into []
                             (if (<= scroll-frac 0.001)
                               (ed-flatten-ops layers)
                               (ed-pane-region-group pane scroll-frac layers))))]
          band scrollbar modeline header)
      (and (nil? (get (:payload pane) :zoom)) (<= scroll-frac 0.001))
        (list (first layers) (second layers) band scrollbar modeline header)
      else (list (ed-pane-region-group pane scroll-frac layers) band scrollbar modeline header))))

(defn ed-partial-row-pane (m body-rows pane)
  "`pane` flagged `:partial-row` when its next buffer line shows in the window's leftover
strip (brood ADR-615): a GUI frame, the pane unzoomed (a zoomed pane is a cell region,
another grid) and its mode line on the seam — the body's last row, `body-rows - 1`, which
every pane whose bottom is the body's bottom shares. Such a pane paints one row more inside
`above-seam`, and the window shows that row's top between its last line and its mode line,
as Emacs shows a partly visible last line. Scrolling never counts the row as shown: the
pane's text rows are its whole rows, so point there is past the window and scrolls it."
  (let ([x y w h] (:rect pane))
    (if (and (:gui m) (nil? (get (:payload pane) :zoom)) (> h 1) (= (+ y h) body-rows))
      (assoc pane :partial-row true)
      pane)))

;; ---- dividers (the 1-cell lines between panes) ------------------------------

(def *hairline* (ui-space :hairline)) ; chrome border thickness in cells (a crisp sub-px hairline) — docs/ui-chrome.md
(defn ed-divider-ops (d gui?)
  "Render ops drawing divider `d`: a **hairline** border (thin `frect` centred in the reserved
1-cell seam) in the GUI — a crisp ≈1px line, not a stack of `│`/`─` box-drawing glyphs (ASCII
art) nor a heavy full-cell block; the terminal (no sub-cell `frect`) falls back to a solid
`rect` bar. Plus a `cursor-zone` over the seam so the GUI shows a resize cursor on hover/drag
(`:col-resize` ↔ / `:row-resize` ↕; the terminal ignores the zone). ADR-080."
  (let ([x y w h] (:rect d)
        col? (= (:dir d) :col)
        off (- 0.5 (/ *hairline* 2)))
    ; centre the hairline in the 1-cell seam
    [(if gui?
       (if col?
         (frect (+ x off) (* 1.0 y) *hairline* (* 1.0 h) face-border)
         (frect (* 1.0 x) (+ y off) (* 1.0 w) *hairline* face-border))
       (rect y x w h face-border))
      (cursor-zone x y w h (if col? :col-resize :row-resize))]))

(defn ed-visual-column (buf)
  "The cursor's *display* column on its line: the cell width (`display-width`) of the
line text from its start to point — so a wide glyph (emoji, CJK) or anything else
that isn't one cell per character advances the cursor by its real on-screen width,
keeping the block cursor over the character it edits. The width-aware counterpart to
`buffer-column` (which counts characters); the GUI grid advances by the same measure."
  (let (rope (buffer-rope buf)
        ;; Clamp to the last real line: point at EOF after a trailing newline reports
        ;; `buffer-current-line` = line-count (a phantom line the rope doesn't materialise),
        ;; which `text/line->char` rejects. A reused/regenerated report pane can leave point
        ;; there; the cursor render must never throw (it'd blank the whole frame), so pin it
        ;; to the last line's start rather than out of bounds.
        line (math/min (buffer-current-line buf) (dec (buffer-line-count buf)))
        bol (text/line->char rope line))
    (string/display-width (text/slice rope bol (buffer-point buf)))))

(sig ed-visual-column-from (buffer int -> int))
(defn ed-visual-column-from (buf hscroll)
  "The cursor's display column within a view scrolled `hscroll` characters left: the
cell width of the current line from char column `hscroll` to point (0 when point is left
of `hscroll`). The horizontal-scroll counterpart of `ed-visual-column`. Measured from the
LINE's start in both halves — a tab's width is a function of its line column (ADR-342),
so the width of `[hscroll, point)` is the width to point less the width to `hscroll`, not
the width of the slice on its own."
  ;; the guard proves the int the memo store cannot
  (let (column (ed-visual-column-at (buffer-rope buf)
                 (buffer-point buf)
                 hscroll
                 (conventions/cell-layout-key)))
    (if (int? column) column 0)))

;; check-allow: a hit comes back out of the memo's store, which the checker reads as
;; unknown; the store only ever holds what the body below built, an int.
(check-allow :trusted
  (defmemo ed-visual-column-at 4 (rope p hscroll cell-layout)
    "`ed-visual-column-from` over the rope and point, remembered: it slices and measures the
line from its start, and the caret, the completion preview and a blink frame ask the same
question about the same rope and point."
    ;; Same EOF-phantom-line clamp as `ed-visual-column` — never index past the rope.
    (let (line (math/min (text/char->line rope p) (dec (text/line-count rope)))
          bol (text/line->char rope line)
          from (+ bol hscroll))
      (cond
        (>= from p) 0
        (= hscroll 0) (string/display-width (text/slice rope bol p))
        else
          (- (string/display-width (text/slice rope bol p))
            (string/display-width (text/slice rope bol from)))))))
(sig ed-visual-column-at (any int int any -> any))

(defn- ed-cursor-style (m)
  "The caret shape. Vim insert mode is always a thin `:bar` (it signals you're inserting);
Vim normal/visual is always a `:block` over the character it acts on. Everywhere else
(the non-modal Emacs profile, every buffer alike) it's the model's configured
`:cursor-style` — `:block` by default (`(config :cursor :bar)` in init.blsp switches to a
bar). So the caret is consistent across buffers, wide by default, and user-configurable."
  (cond
    (= (:edit-state m) :insert) :bar
    (includes? (list :normal :visual) (:edit-state m)) :block
    else (or (:cursor-style m) :block)))

(defn- ed-caret-text (shown)
  "What a block caret draws over its solid fill (brood ADR-515): the first character of
`shown`, the text painted in the caret's cell, or a space where that cell shows none — a
line's end, the buffer's end, a tab — so the caret is the same solid box everywhere."
  (cond
    (or (nil? shown) (= shown "") (includes? ["\n" "\t" "\r"] (string/substring shown 0 1))) " "
    ;; a glyphless character shows as its `<200b>` escape (brood ADR-556): its cell's `<`
    (and (= *glyphless-chars* :hex-code)
      (not (empty? (string/glyphless-indices (string/substring shown 0 1)))))
      "<"
    else (string/substring shown 0 1)))

(defn- ed-caret (m row col shape under face)
  "The caret op at `row` `col`: `shape`, in the theme's text colour (brood ADR-440's cursor
colour, so a light theme gets a dark caret), or a HOLLOW box while the window is unfocused
(`:unfocused`, set by `:blur` and cleared by `:focus-in`): Emacs and every terminal show
where the caret is without claiming the keyboard. It does not blink then either.

A focused caret carries its blink (`cursor-blink`, brood ADR-469): the GUI window blinks it on
its own clock for [[model/ed-blink-count]] cycles and restarts it on every key, click and
caret move, so a blink costs no turn of the loop. The terminal and the web mirror ignore it.

`under` is the text painted in the caret's cell and `face` its face (nil: the default). A
focused block draws it over a solid fill in the window background, Emacs's box (brood
ADR-515), keeping the face's weight and slant, so the character at point stays readable
through the caret; [[ed-caret-text]] makes it a space where the cell is empty."
  (if (:unfocused m)
    (cursor row col :hollow *cursor*)
    (cursor row
      col
      shape
      *cursor*
      (cursor-blink *blink-ms* (ed-blink-count m))
      (ed-caret-text under)
      face)))

(defn ed-cursor (m panes cols rows)
  "Place the MINIBUFFER's caret: at its point (prompt + `:point`). A buffer pane's caret is
not placed here — it is one of that pane's own ops (`ed-pane-ops`), inside its scroll and
cell regions so it moves with the text and is drawn at the pane's size. Its shape is the
configurable `ed-cursor-style` (a `:block` box by default, a `:bar` thin caret on the
cell's left edge — display.blsp; Vim insert always bar, normal/visual always block). Nil
with no minibuffer open."
  (let (mb (:minibuffer m))
    (if (nil? mb)
      nil
      ;; The prompt is the first row of the echo area (just below the mode line), not the
      ;; last screen row — the Plume list fills the rows below it. The caret sits after the
      ;; `N/M ` counter (when a selection prompt) + the prompt + the line editor's point.
      ;; the minibuffer caret is the SAME shape as every buffer (`ed-cursor-style`):
      ;; the configurable block by default, not a special-case bar.
      (ed-caret m
        (ed-mb-row m rows)
        (ed-mb-caret-column mb cols)
        (ed-cursor-style m)
        (ed-mb-caret-text m mb cols)
        (when (:preedit m) face-preedit)))))

(defn- ed-frame-layout (m cols rows)
  "The pane layout of the body for a `cols`×`rows` window: the model's cached `:_lc`
(`[cols rows layout]`) when it was laid out at this size, else laid out now."
  (let (cached (get m :_lc))
    (if (and cached (= (nth cached 0) cols) (= (nth cached 1) rows))
      (nth cached 2)
      (ed-pointer-layout m cols rows))))

(defn- ed-render-error-frame (m e cols rows)
  "The frame painted when rendering raised `e`: the message on the echo row, so the window
stays alive and you can read it / quit / fix it live. Also logged to the console: the
echo-row message scrolls past / vanishes on quit, so a render bug leaves no trace without
this. stderr survives the session."
  (io/puts (str "render error: " (error-message e)) :to *err*)
  ;; Dump the model state that provoked it — but only from **raw** fields, never via the
  ;; `ed-current-*` helpers: those traverse `:layout`, which may itself be the corrupt
  ;; thing that threw (an empty/half-built model), and traversing it can run away instead
  ;; of failing cleanly. Each field is `get`-only + the whole dump is guarded, so the
  ;; handler always returns a frame. `layout=` shows every pane's `:buffer`/`:top`; cross
  ;; it against `pool=` (name:line-count per pool buffer) to find an out-of-range scroll.
  (try
    (io/puts (str "  view-rows="
               (:view-rows m)
               " | pool=["
               (string/join (map (or (:buffers m) '())
                              (fn (b) (str (buffer-name b) ":" (buffer-line-count b) "L")))
                 ", ")
               "]"
               " | layout="
               (str (:layout m)))
      :to *err*)
    (catch e2 (io/puts "  (state dump unavailable)" :to *err*)))
  (frame (clear)
    (text (dec rows) 0 (ed-fit (str "render error: " (error-message e)) cols))
    (cursor (dec rows) 0)))

(defn ed-seam-op (m rows)
  "The frame's `[:seam row …]` (brood ADR-610): the row of the bottom-most mode line — every
pane whose bottom is the body's bottom has its mode line on that row, whatever the split — so
the window anchors it and the echo area under it to its bottom edge and the leftover pixels
become the text body's partial line above it. Row 0 is a band when the header line is on (no
margin above it); without one the first text line gets the inset the sides have."
  (seam (dec (- rows (ed-echo-rows m rows))) {:top-band (if (:header-line m) true false)}))

(defn ed-view (m cols rows)
  "ui-run view (pure): lay the pane tree into the body (everything above the echo
row), paint each pane (buffer body + its mode line) and the dividers between them,
then the echo area / minibuffer, the overlays, and the minibuffer's caret. A single pane
fills the body — identical to the old full-screen layout."
  ;; Guard rendering: a bug in any view helper would otherwise throw out of
  ;; `ui-run` (which restores the screen and re-raises — killing the editor). On a
  ;; render error, paint a minimal frame with the message on the echo row instead.
  (try
    (let (layout (ed-frame-layout m cols rows))
      ;; every piece as an op GROUP, flattened once (`ed-flatten-ops`, which also drops the
      ;; nils `frame` would) — a pane's layers are not appended into the pane, the panes
      ;; into the frame and the frame again into `frame`'s arguments
      (frame-of
        (append (list [(clear) (ed-seam-op m rows)])
          (let (body-rows (- rows (ed-echo-rows m rows)))
            (mapcat (:panes layout)
              (fn (p) (ed-pane-op-groups m (ed-partial-row-pane m body-rows p)))))
          (map (:dividers layout) (fn (d) (ed-divider-ops d (:gui m))))
          (list [(ed-echo-line m cols rows)] (ed-mb-shadow-ops m cols rows))
          (list (ed-mb-preedit-ops m cols rows))
          ;; the overlays, bottom to top (`model/register-frame-overlay`)
          (ed-frame-overlay-ops m cols rows)
          ;; The caret is drawn every frame and the window blinks it (`ed-caret`, brood
          ;; ADR-469) — in the minibuffer too, so the caret is consistent everywhere.
          ;; Buffer pane cursor is inside each pane's scroll-region (see ed-pane-ops).
          ;; Only the minibuffer cursor is emitted here — it lives in the fixed echo row.
          (if (:minibuffer m)
            (list [(ed-cursor m (:panes layout) cols rows)])
            nil))))
    (catch e (ed-render-error-frame m e cols rows))))
