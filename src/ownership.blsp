(defmodule ownership
  "Who registered each entry of the editor's registries, so a package's can be taken back.

A feature registers its rows when its module LOADS — an idle job, an event handler, a mode
line chip, an M-x command, a mode, a theme (`model/register-idle-job`,
`statusbar/register-modeline-segment`, …). A package does the same. Removing or updating
one used to retire its globals and leave its rows behind, each naming a function that was no
longer defined: an idle job raising on every beat, a chip skipped every frame, a file type
whose layers would not resolve.

So every registry write goes through [[claim!]], which records the FILE whose load made it
(`reflect/current-file`) — or, outside a load, the [[*claimant*]] a caller bound (the package
manager binds the package while it applies a package's contribution). The rows a package
made are then the ones claimed from a file under its directory, and [[release-under!]] takes
them all back in ONE call before its globals go. A claim is a STACK over the entry that was
there before it: a package that replaced a core row (a theme of the same name, its own
handler for a tag) gives the core row back when it goes, not a hole.

A registry is named by a KIND. A kind that is a `std/registry` id needs nothing declared; one
kept elsewhere (the theme list, `editor/layers`' type table) says how to read, write and
remove an entry with [[define-kind]].")

(defdyn *claimant* nil)
;; The file a registration made OUTSIDE a module load is claimed for: the package manager
;; binds a file under the package's directory while it applies the package's contribution
;; (its themes are registered by the manager, not by the package's own load).

;; :ownership/claims  [kind key] -> {:stack [{:file :entry} …] :base-present? :base}
;;   the top of `:stack` (its last element) is the entry the registry holds now; `:base` is
;;   what it held before the first claim (absent when `:base-present?` is false)
;; :ownership/kinds   kind -> {:lookup :write :remove}, symbols called late

(defn define-kind (kind lookup write remove)
  "Declare a registry kept outside `std/registry`: `lookup` is a `(key) -> [present? entry]`
function, `write` a `(key entry)` and `remove` a `(key)` one. A kind nothing declared is a
`std/registry` id."
  (registry/put! :ownership/kinds kind {:lookup lookup :write write :remove remove}))

(defn- kind-lookup (kind key)
  (let (declared (registry/lookup :ownership/kinds kind))
    (if declared
      ((:lookup declared) key)
      (let (table (registry/entries kind)) [(contains? table key) (get table key)]))))

(defn- kind-write (kind key entry)
  (let (declared (registry/lookup :ownership/kinds kind))
    (if declared ((:write declared) key entry) (registry/put! kind key entry))))

(defn- kind-remove (kind key)
  (let (declared (registry/lookup :ownership/kinds kind))
    (if declared ((:remove declared) key) (registry/remove! kind key))))

(defn with-claimant (file thunk)
  "Call `thunk` with what it registers outside a module load claimed for `file` — a file
under a package's directory while the package manager applies that package."
  (binding (*claimant* file) (thunk)))

(defn current-claimant ()
  "The file a registration made now is claimed for: the one being loaded, else the bound
[[*claimant*]], else nil (a registration at run time that no file owns)."
  (or (reflect/current-file) *claimant*))

(defn- push-claim (kind key entry file)
  "Record that `file` claims `entry` under `[kind key]` — on top of what was there, replacing
its own earlier claim — without writing the registry."
  (let (claim-key [kind key]
        record (or (registry/lookup :ownership/claims claim-key)
                 (let ([present? value] (kind-lookup kind key))
                   {:stack [] :base-present? present? :base value}))
        others (into [] (seq/reject (:stack record) (fn (layer) (= (:file layer) file)))))
    (registry/put! :ownership/claims
      claim-key
      (assoc record :stack (conj others {:file file :entry entry})))))

(defn claim! (kind key entry)
  "Register `entry` under `key` in the registry `kind` — replacing what is there — and record
who did ([[current-claimant]]). A registration no file owns clears the record: the entry is
nobody's to take back. Returns `entry`."
  (let (file (current-claimant))
    (if (nil? file)
      (registry/remove! :ownership/claims [kind key])
      (push-claim kind key entry file))
    (kind-write kind key entry)
    entry))

(defn adopt! (kind key file base-present? base)
  "Record that `file` claims what `[kind key]` holds NOW — written by code that does not go
through [[claim!]] (std's `settings/define`) — over `base`, what it held before (absent when
`base-present?` is false). A key that holds nothing is not adopted."
  (let ([present? value] (kind-lookup kind key))
    (when present?
      (when (nil? (registry/lookup :ownership/claims [kind key]))
        (registry/put! :ownership/claims
          [kind key]
          {:stack [] :base-present? base-present? :base base}))
      (push-claim kind key value file))))

(defn unclaim! (kind key)
  "Remove `key` from the registry `kind` outright, with every claim on it — an explicit
unregistration (a theme taken out of the picker by name)."
  (registry/remove! :ownership/claims [kind key])
  (kind-remove kind key))

(defn- under? (file prefix)
  (and (string? file) (string/starts-with? file prefix)))

(defn claims-under (directory)
  "Every `[kind key]` a file under `directory` claims, sorted — what [[release-under!]] would
take back."
  (let (prefix (str directory "/"))
    (vec (sort (seq/keep (registry/entries :ownership/claims)
                 (fn ([claim-key record])
                   (when (any? (:stack record) (fn (layer) (under? (:file layer) prefix)))
                     claim-key)))))))

(defn release-under! (directory)
  "Take back every registry entry a file under `directory` claimed — a package's, before its
globals are retired — and answer the `[kind key]`s released. Where another claim or the
entry from before the first one is left, that is what the registry holds again; where none
is, the entry goes."
  (let (prefix (str directory "/"))
    (vec (seq/keep (registry/entries :ownership/claims)
           (fn ([claim-key record])
             (let (stack (:stack record)
                   kept (into [] (seq/reject stack (fn (layer) (under? (:file layer) prefix)))))
               (when (< (count kept) (count stack))
                 (let ([kind key] claim-key)
                   (cond
                     (not (empty? kept))
                       (do
                         (registry/put! :ownership/claims claim-key (assoc record :stack kept))
                         (when (not (= (last kept) (last stack)))
                           (kind-write kind key (:entry (last kept)))))
                     (:base-present? record)
                       (do
                         (registry/remove! :ownership/claims claim-key)
                         (kind-write kind key (:base record)))
                     else (do (registry/remove! :ownership/claims claim-key) (kind-remove kind key)))
                   claim-key))))))))
