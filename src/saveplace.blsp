(defmodule saveplace
  "Where you were in each file (Emacs's `save-place-mode`): a file's point is remembered
when its buffer is killed or the editor quits, and a file opened again opens there. One
re-readable vector of `[path point]`, most recent first, capped as Emacs's
`save-place-limit` is, in the editor's state folder. Its rows work only in the live editor
with the init file's `:save-place` on (the model's `:save-place`), the way recentf is kept
out of tests."
  (:use editor/buffer) ; buffer-file / buffer-point / goto-char
  (:use model :only [register-slot-keeper register-visit-step]) ; a kill remembers, a visit restores
  (:use projects)) ; editor-state-dir + persist-read / persist-mru

(def *places-max* 400) ; files remembered — Emacs's save-place-limit

(defn places-file ()
  "Where the places are kept: `places.blsp` in the editor's state folder."
  (path/join (editor-state-dir) "places.blsp"))

(defn- entry-for? (path)
  ;; whether a places entry is the one for `path`
  (fn (entry) (and (vector? entry) (= (first entry) path))))

(defn- place (buffer)
  ;; the places entry for `buffer`: its file and point
  [(buffer-file buffer) (buffer-point buffer)])

(defn place-of (path &optional (file nil))
  "The point remembered for the file at `path`, or nil."
  (let (entry (seq/find (persist-read (or file (places-file))) (entry-for? path)))
    (when entry (let (point (second entry)) (when (int? point) point)))))

(defn remember-place! (buffer &optional (file nil))
  "Remember `buffer`'s point for its file (most recent first, capped). Returns `buffer`; a buffer
without a file is not remembered."
  (let (path (buffer-file buffer))
    (when (string? path)
      (persist-mru (or file (places-file))
        (place buffer)
        (entry-for? path)
        *places-max*))
    buffer))

(defn remember-places! (buffers &optional (file nil))
  "`remember-place!` for every buffer of `buffers` with a file, the file written ONCE — what
quitting the editor does."
  (let (target (or file (places-file))
        files (seq/filter buffers (fn (buffer) (string? (buffer-file buffer))))
        paths (into #{} (map files buffer-file))
        kept (seq/reject (persist-read target)
               (fn (entry) (and (vector? entry) (contains? paths (first entry)))))
        entries (into (vec (map files place)) kept))
    (persist-write! target (vec (take entries *places-max*)))
    buffers))

(defn restore-place (buffer &optional (file nil))
  "`buffer` with point where it was when its file was last left — clamped to the text, which
may have changed on disk since — or `buffer` as it is when nothing is remembered."
  (let (path (buffer-file buffer)
        point (when (string? path) (place-of path file)))
    (if (nil? point) buffer (goto-char buffer (math/max 0 (math/min point (buffer-length buffer)))))))

(defn ed-remember-killed (m killed)
  "Remember where the buffer in pool slot `killed` was left, for the next time its file is
opened. Answers `m`."
  (do (when (:save-place m) (remember-place! (nth (:buffers m) killed))) m))

(defn ed-restore-visited (m buffer)
  "The visit step: `buffer` back where its file was left, no note."
  [(if (:save-place m) (restore-place buffer) buffer) nil])

;; first, so the rows after it see the buffer as the kill found it
(register-slot-keeper :save-place {:order 10 :drop 'saveplace/ed-remember-killed})
(register-visit-step :save-place {:order 10 :run 'saveplace/ed-restore-visited})
