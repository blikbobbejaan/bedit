(defmodule aside
  "The **aside pane** — a named buffer shown BESIDE the page, following what you do in
the page, that stays closed once you close it.

Every preview pane wants exactly this, and each had grown its own copy of the judgement:
the tutorial's *Workings* and the playgrounds' spy panes (through `workings`, which shows
the report of the region the cursor is in), the markdown preview (`mdpreview`, the
document the cursor is in, rendered), the diagnostics list and the time machine's commit
pane. What they share is not the CONTENT — a cascade, a rendered page, a list — but the
discipline of a pane that is a view of another buffer:

  - it is shown with `pool/ed-show-named-aside` (`:display`): split off a lone pane
    or reuse the next one, selection untouched, and REFRESHED IN PLACE while it is up;
  - a refresh without `force` only touches a pane already on screen, so an update in the
    background never opens one behind the reader;
  - **a pane the reader closed stays closed** — latched — because absence alone cannot
    tell a pane the reader dismissed from one that has never opened. Only an explicit
    [[reopen]] (the client's \"show me the pane\" command) clears the latch;
  - a client that turns a page ([[forget]]) starts over: not shown, not dismissed;
  - its key TOGGLES it ([[toggle]]): pressed with the pane up it closes and latches, pressed
    otherwise it reopens — the one gesture every preview has;
  - on a clock (the post-step, the idle beat) an open pane is re-shown only when what it
    shows has moved on ([[sync]], a staleness key the client names), so a follower that runs
    on every event costs a comparison;
  - killing the SOURCE takes the pane with it ([[close-with]], from the source mode's
    `:on-close`), and the pane is scrolled to follow a line of its own ([[scroll-to-line]]).

Where a pane goes and how big it is are the user's `:display-buffer` rules (a pane is
shown with the `:display` request), so `{:match \"^\\\\*Markdown Preview\\\\*$\" :action
{:side :right :size 0.4}}` puts the preview along the frame's right edge at 40%.

**The spec** each client passes first names where its state lives and what its pane is
called — `{:key :mdpreview :buffer \"*Markdown Preview*\" :type :markdown-preview}`.
`:key` is the model sub-map holding the pane's state, so two panes never collide; under it
`:aside-shown?` (it has been on screen this page), `:aside-closed?` (the latch) and
`:aside-key` ([[sync]]'s last staleness key) are this module's, and the client keeps its own
beside them.

**The boundary.** This knows a pane, a name and a text; it never looks at the client's
buffer or decides what the text should be. `workings` adds the region cache and the
\"what earns a split\" rule on top; `mdpreview` adds the render and the cursor-follow."
  (:use scroll) ; ed-scroll / ed-max-top / ed-long-lines — keeping point on screen
  (:use model) ; ed-buffer-index-by-name / ed-buf-at / ed-max-top — the pool + scroll clamp
  (:use pool) ; ed-display-buffer — put it beside the page, selection untouched
  (:use panes) ; ed-layout-now / ed-pane-top / ed-pane-vrows — find + measure the pane
  (:use editor/pane)) ; pane-update-path / pane-delete / pane-select-path — scroll + take down the pane
(def *unshown*
  ;; A pane's VISIBILITY state, forgotten: not on screen, and not dismissed either.
  {:aside-shown? false :aside-closed? false})

(defn path (spec & rest)
  "The model path to one of this pane's state slots — `[:mdpreview :aside-closed?]`."
  (into [(:key spec)] rest))

(sig open? (any model -> bool))
(defn open? (spec m)
  "Whether the pane is on screen — its buffer is in the pool (a pane shows every pool
buffer it names; killing the buffer is how a pane closes)."
  (not (nil? (ed-buffer-index-by-name m (:buffer spec)))))

(sig closed? (any model -> bool))
(defn closed? (spec m)
  "Whether the reader dismissed the pane — either latched already, or shown this page
and gone now, which is what a dismissal looks like from here. A pane that went because its
SOURCE was killed ([[close-with]]: the pool records it in `:closed-with-source`) was not
dismissed, so it does not latch."
  (= true
    (or (map/get-in m (path spec :aside-closed?))
      (and (not (open? spec m))
        (map/get-in m (path spec :aside-shown?))
        (not (contains? (or (:closed-with-source m) #{}) (:buffer spec)))))))

(defn- unmark-source-closed (spec m)
  "`m` without this pane's name among the panes closed with their source — it is being
shown again, so a later disappearance is the reader's doing again."
  (if (contains? (or (:closed-with-source m) #{}) (:buffer spec))
    (assoc m :closed-with-source (set/disj (:closed-with-source m) (:buffer spec)))
    m))

;; check-allow: `show` is the client's placement, `(model action) -> model`, which the checker
;; cannot see through a parameter
(check-allow :trusted
  (sig refresh-with (any model any fn -> model))
  (defn refresh-with (spec m force show)
    "[[refresh]] for a pane whose content is not a text: `show`, `(model action) -> model`,
puts it in the pane with that `ed-display-buffer` action (`:display`) — a section tree's
`sb-show`, say. The latch and the `force` rule are the same: a pane the reader closed stays
closed, and without `force` only an open pane is touched."
    (let (closed? (closed? spec m)
          m1 (map/assoc-in m (path spec :aside-closed?) closed?))
      (if (and (not (open? spec m)) (or (not force) closed?))
        m1
        (map/assoc-in (unmark-source-closed spec (show m1 :display)) (path spec :aside-shown?) true)))))

(sig refresh (any model any bool &optional map -> model))
(defn refresh (spec m content force &optional (opts {}))
  "Put `content` in the pane — a string, or `{:text :spans :fields}` for rendered text whose
faces travel as data (`ed-display-buffer` `:spans`) and whose buffer carries more data
(`:fields`, merged onto the pane's buffer: the diagnostics list's `:line-links`). With `force` the pane is opened if it isn't
there; without, only an already-open pane is refreshed. A pane the reader closed stays
closed, even against `force` — see the module docstring. `opts` pass through to
`ed-display-buffer` (`:keep-scroll` for a pane that is re-shown under a reader)."
  (let (text (if (map? content) (:text content) content)
        opts (if (and (map? content) (contains? content :spans))
               (assoc opts :spans (:spans content))
               opts)
        fields (when (map? content) (:fields content)))
    (refresh-with spec
      m
      force
      (fn (shown action)
        (let (displayed (ed-display-buffer shown
                          (:buffer spec)
                          text
                          (:type spec)
                          (assoc opts :action action))
              index (ed-buffer-index-by-name displayed (:buffer spec)))
          (if (or (nil? fields) (nil? index))
            displayed
            (ed-set-buf-at displayed index (merge (ed-buf-at displayed index) fields))))))))

(sig reopen (any model any &optional map -> model))
(defn reopen (spec m content &optional (opts {}))
  "Bring a dismissed pane back showing `content`, clearing the close latch — the only
thing that does. What a client's \"show me the pane\" command calls."
  (refresh spec (update m (:key spec) merge *unshown*) content true opts))

(sig forget (any model -> model))
(defn forget (spec m)
  "A new page: the pane is neither shown nor dismissed. The client's own state under the
key is untouched — its resets differ (a cache may well outlive a page), which is why this
is not `dissoc`."
  (unmark-source-closed spec (update m (:key spec) merge *unshown*)))

(sig close (any model -> model))
(defn close (spec m)
  "Take the pane down and latch it closed — what a client's toggle does on its second
press. The pane showing the aside is deleted (its sibling fills the space, selection kept
on the reader's own pane), then its buffer is killed; with no pane on screen only the
buffer goes. [[reopen]] is the way back."
  (let (pane (pane-of spec m)
        layout (:layout m)
        here (pane-selected-path layout)
        layout2 (if (or (nil? pane) (= (pane-count layout) 1) (= (:path pane) here))
                  layout
                  ;; `pane-delete` works on the selected pane: select the aside's, delete it,
                  ;; and come back to the reader's — whose path the collapse may have moved,
                  ;; so it is found again by the buffer it shows
                  (let (mine (:buffer (pane-payload-at layout here))
                        pruned (pane-delete (pane-select-path layout (:path pane)))
                        back (seq/find (pane-leaf-paths pruned)
                               (fn (p) (= mine (:buffer (pane-payload-at pruned p))))))
                    (if (nil? back) pruned (pane-select-path pruned back))))
        m1 (ed-kill-buffer-named (assoc m :layout layout2) (:buffer spec)))
    (map/assoc-in m1 (path spec :aside-closed?) true)))

;; check-allow: `open` is the client's opening, `(model) -> model`, which the checker cannot
;; see through a parameter
(check-allow :trusted
  (sig toggle (any model fn &optional any -> model))
  (defn toggle (spec m open &optional (closed-message nil))
    "The client's \"show me the pane\" key, pressed: an open pane is taken down and latched
([[close]], saying `closed-message` when there is one); otherwise `(open m)` runs on a model
whose latch is cleared — the client's own opening, which puts its content in with `force`
([[refresh]], [[refresh-with]]). Every preview toggles this way: C-c C-p, C-c !, the time
machine's `d`. Opening is asking, so it beats having closed the pane before."
    (if (open? spec m)
      (let (closed (close spec m))
        (if (nil? closed-message) closed (message closed closed-message)))
      (open (forget spec m)))))

(sig sync (any model any fn &optional map -> model))
(defn sync (spec m stale-key content &optional (opts {}))
  "Re-show an OPEN pane when what it shows has moved on — the follower a client runs on a
clock (the post-step, the idle beat), so it has to be free when nothing changed. `stale-key`
is anything that changes exactly when the pane's content would (a rope and a width, a list of
findings); it is compared with the one the last sync stored, and only a different key calls
`(content m)` and refreshes the pane (never opening it — a closed pane stays closed). The key
lives under the pane's own `:aside-key`."
  (if (or (not (open? spec m)) (= stale-key (map/get-in m (path spec :aside-key))))
    m
    (map/assoc-in (refresh spec m (content m) false opts) (path spec :aside-key) stale-key)))

(defn close-with (ctx spec)
  "From the SOURCE buffer's `:on-close` hook: take the pane with it — a view of a buffer that
is gone is a corpse on screen. A hook is handed only its buffer, so this NAMES the pane
(`editor/layers/request-close`) and the app closes it — recording that it went with its
source (`pool/ed-closed-with-source`), so [[closed?]] does not read it as the reader's
dismissal and the next source's pane can open."
  (editor/layers/request-close ctx (:buffer spec)))

(sig pane-of (any model -> (or nil pane)))
(defn pane-of (spec m)
  "The laid-out pane showing this aside (`:path`, `:rect`, `:payload` — `ed-body-layout`'s
shape), or nil when none does. Reads the layout as last painted (`ed-layout-now`), so it is
nil headless — for a client that places or fits its view after a refresh."
  (let (idx (ed-buffer-index-by-name m (:buffer spec))
        layout (ed-layout-now m))
    (if (or (nil? idx) (nil? layout))
      nil
      (seq/find (:panes layout) (fn (p) (= idx (map/get-in p [:payload :buffer])))))))

(sig scroll-top-to (any model int -> model))
(defn scroll-top-to (spec m line)
  "Scroll the aside so its line `line` is the pane's first — clamped to the buffer, so the
last screenful never scrolls past its end. What a pane SYNCED to its source's scroll does
(the markdown preview following the wheel over the document). A no-op with no pane on
screen."
  (let (pane (pane-of spec m))
    (if (nil? pane)
      m
      (let (buf (ed-buf-at m (map/get-in pane [:payload :buffer]))
            vrows (math/max 1 (ed-pane-vrows pane buf))
            want (math/max 0 (math/min line (ed-max-top buf vrows))))
        (assoc m
          :layout (pane-update-path (:layout m) (:path pane) (fn (w) (assoc w :top want))))))))

(sig scroll-to-line (any model int -> model))
(defn scroll-to-line (spec m line)
  "Keep rendered `line` of the aside in view: leave the pane alone while the line is
already visible, else scroll so it sits a third of the way down — the follow that makes a
preview track the cursor without twitching on every key. A no-op with no pane on screen."
  (let (pane (pane-of spec m))
    (if (nil? pane)
      m
      (let (buf (ed-buf-at m (map/get-in pane [:payload :buffer]))
            top (ed-pane-top pane buf)
            vrows (math/max 1 (ed-pane-vrows pane buf))
            visible? (and (>= line top) (< line (+ top vrows)))
            want (math/max 0 (math/min (- line (math/quot vrows 3)) (ed-max-top buf vrows))))
        (if visible?
          m
          (assoc m
            :layout (pane-update-path (:layout m) (:path pane) (fn (w) (assoc w :top want)))))))))
