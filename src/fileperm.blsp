(defmodule fileperm
  "The `ls -l` permission column: a `file-stat` map turned into `drwxr-xr-x`. Shared by
dired's listing and Plume's `:file` marginalia, which format permissions identically
through it.")

(defn rwx (bits)
  "The `rwx`/`-` triad for a 3-bit permission group `bits` (0–7)."
  (str (if (>= (math/rem (math/quot bits 4) 2) 1) "r" "-")
    (if (>= (math/rem (math/quot bits 2) 2) 1) "w" "-")
    (if (>= (math/rem bits 2) 1) "x" "-")))

(defn perms-string (stat)
  "The 10-char `ls -l` permission string for `file-stat` map `stat`: a type char
(`d`/`l`/`-`) then the owner/group/other rwx triads from `:mode`. `----------` for a
missing stat."
  (if (nil? stat)
    "----------"
    (let (mode (or (:mode stat) 0)
          type (cond (:symlink? stat) "l" (:dir? stat) "d" else "-"))
      (str type
        (rwx (math/quot (math/rem mode 512) 64))
        (rwx (math/quot (math/rem mode 64) 8))
        (rwx (math/rem mode 8))))))
