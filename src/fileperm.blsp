(defmodule fileperm
  "The `ls -l` permission column: a `file-stat` map turned into `drwxr-xr-x`. Shared by
dired's listing and Plume's `:file` marginalia, which format permissions identically
through it — its own small home, since it has nothing to do with completion ranking.")
;; no imports — math / string ops are all prelude

(defn rwx (n)
  "The `rwx`/`-` triad for a 3-bit permission group `n` (0–7)."
  (str (if (>= (math/rem (math/quot n 4) 2) 1) "r" "-")
    (if (>= (math/rem (math/quot n 2) 2) 1) "w" "-")
    (if (>= (math/rem n 2) 1) "x" "-")))

(defn perms-string (st)
  "The 10-char `ls -l` permission string for `file-stat` map `st`: a type char
(`d`/`l`/`-`) then the owner/group/other rwx triads from `:mode`. `----------` for a
missing stat."
  (if (nil? st)
    "----------"
    (let (mode (or (:mode st) 0)
          type (cond (:symlink? st) "l" (:dir? st) "d" :else "-"))
      (str type
        (rwx (math/quot (math/rem mode 512) 64))
        (rwx (math/quot (math/rem mode 64) 8))
        (rwx (math/rem mode 8))))))
