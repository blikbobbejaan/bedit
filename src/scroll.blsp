(defmodule scroll
  "Keeping point on screen: the vertical clamp (`ed-scroll` — Emacs `scroll-margin` +
`scroll-conservatively`), its horizontal analogue for long unwrapped lines
(`ed-scroll-horizontal`), the bottom-of-buffer bound (`ed-max-top`), how a buffer shows
its long lines — wrapped, truncated with an ellipsis or scrolled, per buffer and per line
(`ed-long-lines`) — and whether it lays out row-wise, and the snap that ends a fractional
glide on a whole line (`ed-settle-scroll`).

All `model -> model` over the selected pane's `:top` / `:hscroll`: the model owns the panes
and the setters (`ed-set-top`), this owns the POLICY of where they should sit, which is
what the dispatcher, the panes and the view each ask."
  (:use editor/buffer) ; buffer-line-count / buffer-current-line / buffer-column / buffer-line-at
  (:use editor/pane) ; pane-update-selected — write the selected pane's `:hscroll`
  (:use model) ; ed-current-buf / ed-current-top / ed-set-top / ed-map-panes / ed-mode-service / restriction
  (:use wrap)) ; line-segments / row-of / row-count — a wrapped buffer's rows, for the scroll clamp

;; ---- scroll settling: a glide ends on a whole line --------------------------
;; A trackpad step or a wheel notch's kinetic glide (the runtime's fractional deltas)
;; leaves a pane resting between lines — `:scroll-frac` ≠ 0 — which is fine while it
;; moves and wrong once it stops: the click→line mapping reads `top`, the cursor sits
;; half a cell off, and a screen row shows most of the line BELOW the one point is on.
;; Emacs's pixel scrolling snaps to the nearest line when the gesture ends; so does this,
;; on the `:scroll-settle` idle one-shot `model/ed-sync-timers` arms whenever a pane holds
;; a fraction (`model/ed-any-pane-fractional?`).

(defn- ed-snap-lines (m w frac)
  "How many lines pane `w`, `frac` of a line past its `top`, snaps forward: 1 from half a
line on, unless the pane is already at the bottom of its buffer, else 0."
  (let (buf (ed-buf-at m (:buffer w))
        top (or (:top w) 0))
    (if (and (>= frac 0.5) (< top (ed-max-top buf 1))) 1 0)))

(defn ed-settle-scroll (m)
  "Every pane snapped onto a whole line (`ed-snap-lines`); `:scroll-frac` is 0 everywhere
after."
  (ed-map-panes m
    (fn (w)
      (let (frac (or (:scroll-frac w) 0.0))
        (if (<= frac 0.001)
          w
          (assoc w :top (+ (or (:top w) 0) (ed-snap-lines m w frac)) :scroll-frac 0.0))))))

;; The snap is eased rather than jumped: once the deltas stop, `:scroll-settle` sets
;; `:scroll-gliding`, and the `:scroll-glide` ticker (`model/ed-sync-timers`) moves each
;; fraction halfway to the line it is nearest, a frame at a time, then snaps. Five frames
;; of 16 ms instead of a jump of up to half a line, which is how the glide's end reads.
(def *scroll-glide-ease* 0.5) ; the share of the remaining distance one frame covers
(def *scroll-glide-close* 0.03) ; within this of a whole line, the ease snaps

(defn ed-glide-scroll-step (m)
  "One frame of the settle ease: every pane between lines moves `*scroll-glide-ease*` of
the way to the whole line it is nearest. Once every pane is within `*scroll-glide-close*`
of one, the panes snap (`ed-settle-scroll`) and `:scroll-gliding` drops, which stops the
ticker."
  (let (stepped (ed-map-panes m
                  (fn (w)
                    (let (frac (or (:scroll-frac w) 0.0))
                      (if (<= frac 0.001)
                        w
                        (let (target (* 1.0 (ed-snap-lines m w frac)))
                          (assoc w :scroll-frac (+ frac (* (- target frac) *scroll-glide-ease*))))))))
        settled? (every? (pane-leaf-paths (:layout stepped))
                   (fn (path)
                     (let (w (pane-payload-at (:layout stepped) path)
                           frac (or (:scroll-frac w) 0.0))
                       (or (<= frac *scroll-glide-close*)
                         (>= frac (- 1.0 *scroll-glide-close*)))))))
    (if settled? (dissoc (ed-settle-scroll stepped) :scroll-gliding) stepped)))

;; ---- scrolling --------------------------------------------------------------

(def *scroll-margin* 4) ; Emacs `scroll-margin`: lines of context kept above/below point
(sig ed-margin (int -> int))
(defn ed-margin (textrows)
  "The effective scroll margin for a `textrows`-tall viewport: `*scroll-margin*`, capped
below half the viewport (so a tall margin in a short pane can't exceed what fits)."
  (math/max 0 (math/min *scroll-margin* (math/quot (dec textrows) 2))))

(sig ed-max-top (buffer int &optional (or nil int) -> int))
(defn ed-max-top (buf textrows &optional (w nil))
  "The largest scroll offset that still fills a `textrows`-tall viewport — the last
line sits on the bottom row. Beyond this there'd be blank space past end-of-buffer, so
scrolling clamps here (and the bottom margin relaxes near EOF, as in Emacs). For a
row-wise buffer (`ed-row-wise?` — wrapped lines, inlay rows) given its text width `w`, the
last line's LAST row sits on the bottom row — a wrapped line takes several, so the top can
be higher than the line count says; without `w` the line arithmetic stands (a caller with
no width to measure at)."
  (let (extras (ed-row-extras buf))
    (if (and w (> w 0) (ed-row-wise? buf extras))
      (let (last (dec (buffer-line-count buf))
            segs (wrap/line-segments buf last w extras))
        (ed-wrap-top-for buf last (dec (count segs)) w textrows 0 extras))
      (math/max 0 (- (buffer-line-count buf) textrows)))))

;; ---- long lines: wrap, truncate or scroll ---------------------------------------------
;; How a line too long for its pane is shown is a POLICY (`wrap` has the three and what each
;; does to the row table). Which one a line takes, first answer wins:
;;
;;   1. the buffer's own toggle — `:long-lines` on the buffer (M-x toggle-truncate-lines,
;;      M-x visual-line-mode), the whole buffer
;;   2. the user's setting for the buffer's MODE — `:long-lines {git-status :wrap}` in
;;      init.blsp, the whole buffer
;;   3. the line's KIND — `:line-kinds` on the buffer, a vector parallel to its lines (a
;;      section buffer marks headings `:section-heading` and body lines `:section-body`) —
;;      and the policy the user's setting gives that kind
;;   4. the mode's `:long-lines` facet (markdown and org wrap)
;;   5. the setting's `:default`
;;
;; The user's setting is `config`'s `:long-lines`, merged over `*long-lines-defaults*` and
;; held here as a dynamic var whose root the config re-binds (`ed-set-long-lines`) — a test
;; `binding`s it instead — as a theme switch re-binds
;; the palette: it is read from the row table's inputs, which have a buffer and no model.

(def *long-lines-defaults*
  ;; what `:long-lines` in init.blsp is merged over: lines scroll unless a mode says
  ;; otherwise, and in a section buffer (*git-status*, a log, *mur-status*) a heading — a
  ;; commit, a stash, a file — keeps to one row with an ellipsis while a hunk's code wraps
  {:default :scroll :section-heading :truncate :section-body :wrap})

(defdyn *long-lines* *long-lines-defaults*) ; the user's `:long-lines`, over the defaults
(defdyn *truncation-ellipsis* "…") ; what ends a truncated line (the user's `:truncation-ellipsis`)

(defn ed-set-long-lines (policies ellipsis)
  "Make the user's `:long-lines` `policies` (merged over `*long-lines-defaults*`) and
`:truncation-ellipsis` the ones every buffer is laid out by. `config/apply-long-lines`
calls it at startup and on M-x reload-config; an empty or missing ellipsis is the default."
  (def *long-lines* (merge *long-lines-defaults* (if (map? policies) policies {})))
  (def *truncation-ellipsis*
    (if (and (string? ellipsis) (not (empty? ellipsis))) ellipsis "…"))
  nil)

(defn- ed-long-lines-forced (buf)
  ;; the policy that holds for EVERY line of `buf`, or nil: its own toggle, else the user's
  ;; setting for its mode (looked up by the mode's name as a symbol)
  (let (own (:long-lines buf)
        mode (ed-buf-mode-name buf))
    (cond
      (keyword? own) own
      (empty? mode) nil
      else (get *long-lines* (symbol mode)))))

(defn- ed-long-lines-base (buf)
  ;; the policy of a line with no kind: the mode's facet, else the default
  (or (ed-mode-service buf :long-lines) (:default *long-lines*) :scroll))

(sig ed-long-lines (buffer &optional (or nil int) -> keyword))
(defn ed-long-lines (buf &optional (line nil))
  "How `buf` shows a line too long for its pane — `:wrap`, `:truncate` or `:scroll` — and,
given `line`, how THAT line does (its kind may say otherwise). The order is the one above
this: the buffer's toggle, the user's setting for its mode, the line's kind, the mode's
facet, the default."
  ;; the setting and the facets are data, so the answer is a keyword by this guard: a value
  ;; that is not one reads as scrolling, which is also what the row table makes of it
  (let (policy (or (ed-long-lines-forced buf)
                 (when (int? line)
                   (let (kinds (:line-kinds buf)
                         kind (when (vector? kinds) (nth kinds line nil)))
                     (when kind (get *long-lines* kind))))
                 (ed-long-lines-base buf)))
    (if (keyword? policy) policy :scroll)))

(defn ed-long-lines-spec (buf)
  "What the row table needs to lay `buf`'s lines out by their policies — `{:policy :kinds
:kind-policies :ellipsis}` (`wrap/line-policy` reads it) — or nil when every line of it
scrolls, the one case with no row table. Data, so the memoised table keys on it."
  (let (forced (ed-long-lines-forced buf)
        kinds (:line-kinds buf))
    (cond
      forced (when (not (= forced :scroll)) {:policy forced :ellipsis *truncation-ellipsis*})
      (vector? kinds)
        {:policy (ed-long-lines-base buf)
         :kinds kinds
         :kind-policies *long-lines*
         :ellipsis *truncation-ellipsis*}
      else
        (let (policy (ed-long-lines-base buf))
          (when (not (= policy :scroll)) {:policy policy :ellipsis *truncation-ellipsis*})))))

(sig ed-toggle-long-lines (buffer keyword -> buffer))
(defn ed-toggle-long-lines (buf policy)
  "`buf` with long-lines `policy` toggled as its own (M-x toggle-truncate-lines with
`:truncate`, M-x visual-line-mode with `:wrap`): on — every line of it takes `policy` —
when it does not already, else off, back to what it had without the toggle (its mode's,
its lines' kinds) or, when that is `policy` too, to scrolling."
  (cond
    (not (= policy (ed-long-lines buf))) (assoc buf :long-lines policy)
    (= policy (ed-long-lines (dissoc buf :long-lines))) (assoc buf :long-lines :scroll)
    else (dissoc buf :long-lines)))

(sig ed-wrap? (buffer -> bool))
(defn ed-wrap? (buf)
  "Whether `buf` wraps long lines visually (`visual-line-mode`): its policy is `:wrap`
(`ed-long-lines`) — a long line takes as many rows as it needs instead of scrolling
sideways. A line of it whose kind says otherwise keeps its own (`ed-long-lines` with the
line)."
  (= :wrap (ed-long-lines buf)))

(defn ed-row-wise? (buf extras)
  "Whether `buf`'s rows on screen stop being one per line, in order, from the top — so what
is visible has to be COUNTED in a row table (`wrap/rows-from`) rather than read off as
`top + k`. `extras` is `ed-row-extras`: what it holds is exactly what makes a buffer row-wise
— a long-lines policy other than scrolling everywhere (a wrapped line takes several rows, a
truncated one is cut and marked), INLAY rows (derived text on a row of its own above a
line), and the lines a FOLD hides (`:hidden`, no rows at all). The one rule the scroll clamp
(`ed-scroll`), the pane's row table (`panes/ed-pane-rows`) and the point-follows-view step
(`input/ed-point-into-view`) share: when they disagreed, an inlay pushed the last line off
the bottom while the cursor step still counted it as shown."
  (or (not (empty? extras)) (not (nil? (ed-long-lines-spec buf)))))

(defn ed-row-extras (buf)
  "What the row table needs beside the text: each line's INLAY rows (`results/inlay-lines`,
keyed by line), under `:hidden` the lines a fold hides (`folds/hidden-lines`), and under
`:long-lines` how its long lines show (`ed-long-lines-spec`) — one map, so every row↔line
question reads the same answer from one call. `{}` for a buffer whose lines simply scroll."
  (let (inlays (results/inlay-lines buf)
        hidden (folds/hidden-lines buf)
        spec (ed-long-lines-spec buf)
        with-hidden (if (empty? hidden) inlays (assoc inlays :hidden hidden)))
    (cond
      spec (assoc with-hidden :long-lines spec)
      (empty? with-hidden) with-hidden
      ;; row-wise for its inlays or folds alone: its long lines still scroll (one row each,
      ;; the one at point following it), rather than wrap because a table was built
      else (assoc with-hidden :long-lines {:policy :scroll :ellipsis *truncation-ellipsis*}))))

(sig ed-wrap-top-for (buffer int int int int int &optional map -> int))
(defn- ed-wrap-top-for (buf line seg-row w budget floor &optional (inlays {}))
  "The highest scroll top that still shows point's row within `budget` rows from the top:
from `line` (whose rows through point's, `seg-row + 1`, are already spent) walk up a line
at a time while the line above fits — never above `floor`. Tail-recursive over the lines
above.

A line above point costs its wrapped segments PLUS its inlay rows: both occupy rows, and a
walk that counted only the segments would stop one line too high for every inlay it passed."
  (let (step (fn (t used)
               (if (<= t floor)
                 t
                 (let (above (wrap/line-rows buf (dec t) w (or inlays {})))
                   (if (> (+ used above) budget)
                     t
                     (step (dec t) (+ used above)))))))
    (step line (inc seg-row))))

(sig ed-wrap-top-above (buffer int int int int int &optional map -> int))
(defn- ed-wrap-top-above (buf line seg-row w margin floor &optional (inlays {}))
  "The lowest scroll top that leaves `margin` ROWS above point's row: from `line` (point on
its `seg-row`, below the line's own inlay rows) walk up a line at a time until that many
rows are above it — never above `floor`. The top-side twin of `ed-wrap-top-for`."
  (let (inlay-rows (fn (k) (count (get (or inlays {}) k [])))
        step (fn (t used)
               (if (or (>= used margin) (<= t floor))
                 t
                 (step (dec t)
                   (+ used (wrap/line-rows buf (dec t) w (or inlays {})))))))
    (step line (+ seg-row (inlay-rows line)))))

(sig ed-scroll (model int -> model))
(defn ed-scroll (m textrows)
  "Adjust the selected pane's `:top` so point keeps `*scroll-margin*` lines of context
above and below it within a `textrows`-tall viewport — scrolling only as far as needed
(Emacs `scroll-margin` + `scroll-conservatively`: never recenter, just enough). Clamped
so it never scrolls past end-of-buffer (no blank void below the last line); near the
edges the margin is whatever the buffer allows. A wrapped buffer (`ed-wrap?`) counts
ROWS below the top, not lines — a long line above point takes several — against the
text width the loop last stored (`:view-cols`), and both margins are counted in rows. Pure."
  (let (buf (ed-current-buf m)
        line (buffer-current-line buf)
        top (ed-current-top m)
        mgn (ed-margin textrows)
        ;; a narrowed pane scrolls only within its restriction — first line `rtop`, and a
        ;; top no further than shows the last restricted line on the bottom row; a wide pane
        ;; gets `[0 .. ed-max-top]`, exactly as before (the restriction range is the whole
        ;; buffer then, so these reduce to the old bounds).
        restrict (ed-selected-restrict m)
        [rtop rbot] (if restrict (ed-restrict-lines buf restrict) [0 (dec (buffer-line-count buf))])
        mintop rtop
        w (or (:view-cols m) 0)
        inlays (ed-row-extras buf)
        wrap? (and (> w 0) (ed-row-wise? buf inlays))
        ;; row-wise: the top that puts the last (restricted) line's last row on the bottom row
        maxtop (math/max rtop
                 (if wrap?
                   (ed-wrap-top-for buf
                     rbot
                     (dec (count (wrap/line-segments buf rbot w inlays)))
                     w
                     textrows
                     rtop
                     inlays)
                   (math/min (ed-max-top buf textrows) (math/max 0 (- (inc rbot) textrows)))))
        lo (+ top mgn) ; first comfortable line (margin below top)
        hi (- (+ top textrows) 1 mgn) ; last comfortable line (margin above bottom)
        want (if (not wrap?)
               (cond
                 (< line lo) (- line mgn)
                 (> line hi) (+ (- line textrows) 1 mgn)
                 else top)
               ;; row-wise, both margins are ROWS, as Emacs counts screen lines: a long
               ;; line above point is several rows of context, not one
               (let (seg-row (wrap/row-of (wrap/line-segments buf line w inlays)
                               (buffer-column buf)))
                 (if (< line top)
                   (ed-wrap-top-above buf line seg-row w mgn mintop inlays)
                   ;; point's row below the top: the rows of the lines above it plus its
                   ;; own segment — past the comfortable last row is all that is asked,
                   ;; so the count may stop there
                   (let (r (+ (wrap/row-count buf top line w inlays textrows) seg-row))
                     (cond
                       (and (< r mgn) (> top mintop))
                         (math/min top (ed-wrap-top-above buf line seg-row w mgn mintop inlays))
                       (> r (- textrows 1 mgn))
                         (math/max top
                           (ed-wrap-top-for buf line seg-row w (- textrows mgn) mintop inlays))
                       else top))))))
    (ed-set-top m (math/max mintop (math/min maxtop want)))))

;; ---- horizontal scroll (long lines, no wrap): keep point's column in view ----
(def *hscroll-margin* 8) ; columns of context kept left/right of point
(sig ed-current-hscroll (map -> int))
(defn ed-current-hscroll (m)
  "The selected pane's horizontal scroll offset (leftmost visible char column), 0 if unset."
  (let (h (:hscroll (ed-current-pane m)))
    (if (int? h) (math/max 0 h) 0)))

(sig ed-set-hscroll (model int -> model))
(defn ed-set-hscroll (m n)
  "The model with the selected pane's `:hscroll` set to `n` (clamped non-negative)."
  (assoc m :layout (pane-update-selected (:layout m) (fn (w) (assoc w :hscroll (math/max 0 n))))))

(sig ed-scroll-horizontal (model int -> model))
(defn ed-scroll-horizontal (m cols)
  "Adjust the selected pane's `:hscroll` so point's column stays within the `cols`-wide
text area, keeping `*hscroll-margin*` columns of slack — the horizontal analogue of
`ed-scroll`, so a long line scrolls sideways to follow point instead of clipping.

`:hscroll` is a CHARACTER offset into the line (where the view starts slicing), but the pane
is `cols` display CELLS wide, so the decision is made in cells — measured as the view lays
the line out, tabs expanded — and the new origin converted back with `width->index`. It
compared characters to cells, and a line of leading tabs (a Makefile, Go) put point ninety
cells in while its column read twenty: no scroll, and the cursor painted off-screen."
  (let (buf (ed-current-buf m)
        col (buffer-column buf)
        hs (ed-current-hscroll m)
        line (ed-strip-newline (buffer-line-at buf (buffer-current-line buf)))
        cell-of (fn (i)
                  (string/display-width (string/substring line 0 (math/min i (string/length line)))))
        pcell (cell-of col)
        hcell (cell-of hs)
        mgn (math/max 0 (math/min *hscroll-margin* (math/quot (dec cols) 2))))
    (cond
      ;; a row-wise buffer never scrolls the PANE sideways: a wrapped line takes more rows, and
      ;; a truncated or clipped line at point scrolls by itself (`wrap/follow-point`)
      (ed-row-wise? buf (ed-row-extras buf)) (if (= hs 0) m (ed-set-hscroll m 0))
      (< (- pcell hcell) mgn)
        (ed-set-hscroll m (string/width->index line (math/max 0 (- pcell mgn))))
      (> (- pcell hcell) (- cols 1 mgn))
        (ed-set-hscroll m (string/width->index line (math/max 0 (+ (- pcell cols) 1 mgn))))
      else m)))
