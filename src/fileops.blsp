(defmodule fileops
  "The filesystem operations Dired runs that Brood's `file/` primitives lack: copying a whole
tree (`file/cp` takes one file), moving across filesystems (`file/rename` cannot), counting
what a recursive delete takes, and the desktop TRASH (Emacs's `move-file-to-trash`): the
freedesktop.org trash on Linux and the BSDs, `~/.Trash` on macOS, none on Windows.

The trash is a mechanism rather than an editor feature — a file manager, `nest clean` or a
script wants the same safe delete — so it belongs in Brood's `file` module; it lives here,
behind [[move-to-trash]], until it is there. Pure Brood over the kernel's file primitives;
none of it touches the model, so it can run in a task off the loop.")

;; ---- trees: copy, move, remove, count ----------------------------------------------

(defn- symlinked-dir? (stat)
  ;; a symlink to a directory: removed or copied as the link, never followed (following
  ;; one deletes or copies what it points at, and a link to an ancestor never ends)
  (and stat (:dir? stat) (:symlink? stat)))

(check-allow :non-tail-recursion
  (defn copy-tree (from to)
    "Copy the file or directory `from` to `to`: a file as `file/cp` copies it, a directory
made at `to` with everything under it copied in. A symlinked directory inside is refused —
copying what it points at can loop — before anything is removed by a caller that moves."
    (let (stat (file/stat from))
      (cond
        (nil? stat) (error (str "copy-tree: no such file: " from))
        (symlinked-dir? stat) (error (str "copy-tree: a symlinked directory: " from))
        (:dir? stat)
          (do
            (file/mkdir to)
            (doseq (name (file/ls from)) (copy-tree (path/join from name) (path/join to name))))
        else (file/cp from to)))))

(defn remove-path (path)
  "Remove `path` for good: a directory with everything under it, a file or a symlink (to a
directory too: the link goes, not what it points at)."
  (let (stat (file/stat path))
    (if (and stat (:dir? stat) (not (:symlink? stat))) (file/rmdir path) (file/rm path))))

(defn- cross-device? (error)
  ;; whether a failed `file/rename` failed because the two paths are on different
  ;; filesystems (EXDEV, `os error 18`), which a copy and a delete get round
  (let (text (string/lower (str (error-message error))))
    (or (includes? text "cross-device") (includes? text "os error 18"))))

(defn move-path (from to)
  "Move `from` to `to` as `file/rename` does, and across filesystems too (a rename there fails
with EXDEV): the tree copied ([[copy-tree]]), then the original removed — only once the copy
is whole, so a failure leaves `from` as it was."
  (try
    (file/rename from to)
    (catch e
      (if (and (cross-device? e) (file/exists? from))
        (do (copy-tree from to) (remove-path from))
        (throw e)))))

(defn count-files (path)
  "How many files deleting `path` takes: everything under a directory, else 1 — what the
question before a permanent delete names."
  (let (stat (file/stat path))
    (if (and stat (:dir? stat) (not (:symlink? stat)))
      (count (or (file/walk-files path) '()))
      1)))

;; ---- the trash ---------------------------------------------------------------------
;; freedesktop.org's trash specification: a trashed file goes to `$XDG_DATA_HOME/Trash/files`
;; under a name not taken there, with `info/NAME.trashinfo` beside it saying where it came
;; from (`Path=`, percent-encoded) and when (`DeletionDate=`, local time) — which is what a
;; file manager's "Restore" reads. macOS's Finder keeps `~/.Trash` and no info file. Windows'
;; recycle bin needs the shell's API, so there is none here and the caller deletes for good.

(defdyn *trash-home* nil) ; a trash directory standing in for the desktop's (tests bind it)

(defn trash-location ()
  "Where a trashed file goes, `{:kind :dir}` — `:freedesktop` (the `Trash` directory under
`$XDG_DATA_HOME`, else `~/.local/share`) or `:macos` (`~/.Trash`) — or nil where there is no
trash this can reach (Windows, no home). [[*trash-home*]], when bound, is a freedesktop trash;
a test run that binds none gets one in its scratch `$XDG_DATA_HOME` on every system, never the
user's own."
  (let (home (path/home))
    (cond
      (not (nil? *trash-home*)) {:kind :freedesktop :dir *trash-home*}
      (config-paths/under-test?)
        (when-let (data (os/env "XDG_DATA_HOME"))
          {:kind :freedesktop :dir (path/join data "Trash")})
      (= (os/type) :windows) nil
      (= (os/type) :macos) (when home {:kind :macos :dir (path/join home ".Trash")})
      else
        (let (data (or (os/env "XDG_DATA_HOME") (when home (path/join home ".local" "share"))))
          (when data {:kind :freedesktop :dir (path/join data "Trash")})))))

(defn trash-info-path (path)
  "`path` as a `.trashinfo` file's `Path=` holds it: each segment percent-encoded, the
slashes kept.

    (fileops/trash-info-path \"/home/me/a b.txt\")   ;=> \"/home/me/a%20b.txt\""
  (string/join (map (string/split path "/") url/percent-encode) "/"))

(defn- trash-date ()
  ;; the deletion date in local time, as the spec asks (`2026-11-08T09:15:00`); UTC when the
  ;; machine's zone cannot be read
  (let (zone (tz/local-zone)
        now (datetime/epoch-ms-> (os/now)))
    (datetime/format (if (failure? zone) now (tz/->local zone now)) "%Y-%m-%dT%H:%M:%S")))

(defn trash-info (path date)
  "The `.trashinfo` text for `path` trashed at `date`.

    (fileops/trash-info \"/tmp/a b\" \"2026-11-08T09:15:00\")   ;=> \"[Trash Info]\\nPath=/tmp/a%20b\\nDeletionDate=2026-11-08T09:15:00\\n\""
  (str "[Trash Info]\nPath=" (trash-info-path path) "\nDeletionDate=" date "\n"))

(defn- free-trash-name (files-dir info-dir name)
  ;; `name`, else `name.2`, `name.3`… — the first taken by neither a trashed file nor an
  ;; info file (an info file without its file still claims the name, as the spec says)
  (letrec (try-name (fn (n)
                      (let (candidate (if (= n 1) name (str name "." n)))
                        (if (or (file/exists? (path/join files-dir candidate))
                              (and info-dir
                                (file/exists? (path/join info-dir (str candidate ".trashinfo")))))
                          (try-name (inc n))
                          candidate))))
    (try-name 1)))

(defn move-to-trash (path location)
  "Move `path` (a file or a whole directory) into the trash `location` ([[trash-location]])
and answer where it went. A freedesktop trash gets its info file first, removed again if the
move fails; a move across filesystems copies, then deletes.

What Brood's `file` module should have as `(file/trash path)`: this, with the location
resolved inside it and Windows' recycle bin (`IFileOperation`) in Rust."
  (let (path (path/normalize (path/absolute path))
        freedesktop? (= (:kind location) :freedesktop)
        dir (:dir location)
        files-dir (if freedesktop? (path/join dir "files") dir)
        info-dir (when freedesktop? (path/join dir "info"))
        _ (file/mkdir-private dir)
        _ (file/mkdir files-dir)
        _ (when info-dir (file/mkdir info-dir))
        name (free-trash-name files-dir info-dir (path/basename path))
        target (path/join files-dir name)
        info (when info-dir (path/join info-dir (str name ".trashinfo"))))
    (do
      (when info (file/spit info (trash-info path (trash-date))))
      (try
        (move-path path target)
        (catch e (do (when info (file/rm info)) (throw e))))
      target)))
