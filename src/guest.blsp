(defmodule guest
  "A guest's session: editing what it was given, nothing more (brood ADR-415).

A guest attaches over a link that can carry no code and reach nothing it was not given —
but the session it reaches is an editor, and an editor opens files, runs shells and
evaluates code. So a guest's session (`:guest-session`, set from the attach identity
brood's `editor/serve` marks) runs an ALLOWLIST: the general editing, motion, search and
pane commands, vim's editing grammar, and following someone's caret. Opening a file,
writing one under another name, every feature module — shells, terminals, eval, git, the
debugger, packages — is refused. An allowlist, because a denylist is only as good as the
last command someone remembered to add to it.

The set is a command TRAIT, `:guest`, declared by symbol beside the commands, so a command
that moves keeps its answer and a new one is refused until someone says otherwise.
tests/guest_allowed.txt is the set as it stands; a line added there is a security decision."
  (:use model) ; message — the refusal
  (:use interactive :only [declare-trait command-trait? command-friendly-name]))

;; collab-commands loads on demand, and a declaration in it would not exist until it had:
;; these keys must be allowed before they load it
(declare-trait :guest
  '(collab-commands/cmd-share-follow collab-commands/cmd-share-mirror
     collab-commands/cmd-share-session collab-commands/cmd-share-session-stop
     collab-commands/cmd-collab-status))

(defn- command-name-of (command)
  (command-friendly-name (last (string/split (->string command) "/"))))

(memo/defmemo guest-commands-by-name
  1
  (traits)
  "M-x name -> command symbol, for the commands in `traits` a guest may run."
  (fold traits
    {}
    (fn (table entry)
      (let ([[trait command] _] entry)
        (if (= trait :guest) (assoc table (command-name-of command) command) table)))))

(defn ed-guest-allows? (command)
  "Whether a guest's session may run `command` — a command symbol, or `:self-insert`."
  (or (= command :self-insert) (command-trait? command :guest)))

(defn ed-guest-allows-name? (name)
  "Whether a guest's session may run the M-x command `name`."
  (let (command (get (guest-commands-by-name (registry/entries :interactive/traits)) name))
    ;; the command must EXIST: a declaration outlives a module it no longer loads
    (and (not (nil? command)) (bound? command))))

(defn ed-guest-refusal (m)
  "`m` saying a guest's session does not run that."
  (message m "not in a guest session — a guest edits what it was given"))
