(defmodule xrefgrep
  "A lookup without a language server (Emacs's dumb-jump): when no server is configured for a
file, or the one configured is not installed, M-. searches the project for a line DEFINING the
word at point — `def`, `defn`, `function`, `class`, `struct`, … before it — and jumps when there
is exactly one, else lists them in *Project Search*; M-? lists every use of the word. A guess
from text, said as one; a server, when there is one, answers instead."
  (:use editor/buffer) ; the buffer at point
  (:use model) ; ed-current-buf / message
  (:use pool :only [ed-project-root])) ; where to search

(def *definition-words*
  ;; the words that introduce a definition across the languages bedit edits
  ["def"
    "defp" "defn" "defn-" "defmacro" "defmodule" "defstruct" "defprotocol" "defcommand" "function"
    "fn" "func" "fun" "class" "module" "struct" "enum" "trait" "interface" "type" "impl" "let"
    "const" "var" "val" "sub" "proc"])

(defn definition-pattern (word)
  "The regexp for a line defining `word`: a definition word, then `word` as a whole word.

    (regex/match? (xrefgrep/definition-pattern \"run\") \"  def run(x) do\")   ;=> true"
  (str "\\b("
    (string/join (map *definition-words* regex/escape) "|")
    ")\\b[^\\n]*\\b"
    (regex/escape word)
    "\\b"))

(defn- word-at-point (m)
  (complete-words/complete-symbol-around-point (ed-current-buf m)))

(defn- search (m pattern then)
  ;; the project searched for `pattern` (*Project Search*), then `then` on the shown results
  (let (root (ed-project-root m))
    (if (nil? root)
      (message m "no language server, and not in a project to search")
      (project-search/ed-project-search m root pattern then))))

(defn- one-row? (m)
  ;; whether the shown search found exactly one row
  (= (count (seq/filter (string/split (buffer-text (ed-current-buf m)) "\n")
              (fn (line) (regex/match? "^[^:\\n]+:[0-9]+:" line))))
    1))

(sig find-definition (model -> model))
(defn find-definition (m)
  "M-. without a server: the project searched for a line defining the word at point; with
exactly one, point goes there (M-, comes back, as after any jump), else they are listed."
  (let (word (word-at-point m))
    (if (nil? word)
      (ed-ding (message m "no symbol at point"))
      (search m
        (definition-pattern word)
        (fn (shown)
          (if (one-row? shown)
            (message (commands/cmd-visit-location shown :enter)
              (str "no language server: the definition of " word " by search"))
            (message shown (str "no language server: lines that look like they define " word))))))))

(sig find-references (model -> model))
(defn find-references (m)
  "M-? without a server: every whole-word use of the word at point in the project."
  (let (word (word-at-point m))
    (if (nil? word)
      (ed-ding (message m "no symbol at point"))
      (search m
        (str "\\b" (regex/escape word) "\\b")
        (fn (shown) (message shown (str "no language server: every use of " word " by search")))))))
