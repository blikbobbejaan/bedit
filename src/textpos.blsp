(defmodule textpos
  "Pure text geometry: a character offset's line start and end, its column, and what an edit
changed, read from the buffer's splice log (`ed-edit-range`) — no model."
  (:use editor/buffer)
  (:use log :exclude [error]))

(sig ed-line-start-offset ((or string rope) int -> int))

(defn ed-line-start-offset (text off)
  "The offset of the start of the line containing char offset `off` — just after
the previous newline (0 at the first line)."
  (if (rope? text) (text/skip-backward text off "\n" false) (ed-string-line-start text off)))

(defn- ed-string-line-start (text:string off:int -> int)
  ;; tail-recursive walk back to the previous newline
  (if (or (<= off 0) (= (string/char-at text (dec off)) "\n"))
    off
    (ed-string-line-start text (dec off))))

(sig ed-line-end-offset ((or string rope) int -> int))

(defn ed-line-end-offset (text off)
  "The offset of the newline ending the line containing char offset `off`, or the end of
`text` on its last line."
  (if (rope? text)
    (text/skip-forward text off "\n" false)
    (let (newline (index-of text "\n" off)) (if (< newline 0) (string/length text) newline))))

(sig ed-line-end (any int -> int))

(defn ed-line-end (rope line)
  "The offset just past `line`'s last character in `rope` — its newline's offset, or the
rope's end for the last line: where `wrap/line-text` stops, found without copying the line."
  (if (< (inc line) (text/line-count rope))
    (dec (text/line->char rope (inc line)))
    (text/length rope)))

(defn ed-line-start-char (buf line)
  "The char offset where `line` begins — or the buffer's end for a line past the last."
  (if (>= line (buffer-line-count buf))
    (buffer-length buf)
    (text/line->char (buffer-rope buf) line)))

(defn ed-column-at (text off)
  "The 0-based display COLUMN of char offset `off` in `text`: the cells from the line start to
it, a tab reaching the next stop of the ambient `*tab-width*` (brood ADR-537) and a wide glyph
two — what an indenter aligns under, since its answer is a column. Within `ed-indent-target`
the tab width is the buffer's (`conventions/with-cell-layout`). A count of characters was read
as a column, so a `(` after a leading tab aligned its arguments one column in."
  (let (start (ed-line-start-offset text off))
    (string/display-width (if (string? text)
                            (string/substring text start off)
                            (text/slice text start off)))))

(defn ed-splices-cover (splices)
  "`[lo old-hi new-hi]`: the one stretch `[lo, old-hi)` of the text before `splices`
(`buffer-splices-since`, oldest first, each against the text the one before it left) that
became `[lo, new-hi)` of the text after them — everything outside it unchanged, the part after
it shifted. Nil for no splices. The shape `text/changed-range` answers; the fold is std's
(`editor/buffer/buffer-splices-cover`), the one the buffer's own undo uses.

    (textpos/ed-splices-cover [[2 4 \"xyz\"] [0 0 \"a\"]])   ;=> [0 4 6]"
  (editor/buffer/buffer-splices-cover splices))

(sig ed-splices-cover (seqable -> (or nil (tuple int int int))))

(defn ed-edit-range (buf old)
  "`[lo old-hi new-hi]`: what changed between rope `old` and `buf`'s text — `[lo, old-hi)` of
`old` became `[lo, new-hi)` of the text now — or nil when nothing did. From the buffer's splice
log ([[ed-splices-cover]]) when it reaches `old`, the edit's own cost; otherwise by comparing
the two texts (`text/changed-range`)."
  (let (splices (buffer-splices-since (assoc buf :rope old) buf))
    (if (nil? splices)
      (text/changed-range old (buffer-rope buf))
      (ed-splices-cover splices))))
