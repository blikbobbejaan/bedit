(defmodule lifeline
  "The editor's loop under a supervisor. The loop (`ui-run`) is one process; every buffer's
text lives in a process of its own, named in the buffer registry, and neither depends on the
loop. So the loop dying need not lose anything: `supervise` runs it as a child of `main`,
and when it ends ABNORMALLY — a panic in a native call, an error outside update and view —
writes an auto-save sidecar for every file buffer whose text the file does not hold
(`emergency-save!`, from the buffer processes), closes the dead loop's window and starts a
fresh loop that adopts every buffer from the registry. A loop that keeps dying is let go
once it has been restarted `*restart-max*` times inside `*restart-window-ms*`, its sidecars
written, so a fault that recurs on every start cannot spin. Told to end (SIGTERM, SIGHUP,
SIGINT) it writes the same sidecars and ends the loop, stuck or not; a daemon does the same
across its sessions (`start-keeper`). A clean quit ends the loop normally, and `main`
with it, as before.

Mechanism only: what a loop IS — how it opens its window, how a restarted one is seeded —
is `main`'s, handed in as functions."
  (:use editor/buffer) ; buffer-text
  (:use editor/buffer-file) ; file-text-decode
  (:use editor/buffer-server) ; buffer-sync
  (:use editor/buffer-registry) ; registry-entries
  (:use sidecar)) ; write-sidecar

(def *restart-max* 3)
(def *restart-window-ms* 60000)

(def- fatal-signals [:term :hup :int])

(defn- trap-fatal (pid)
  "Route the signals that end the runtime to `pid`. Who had each before, a map. A platform
without Unix signals has nothing to route, and answers an empty map."
  (check-allow :discarded-catch
    (try
      (into {} (map fatal-signals (fn (sig) [sig (os/trap sig pid)])))
      (catch _ {}))))

(defn- restore-traps (previous)
  "Give each signal in `previous` ([[trap-fatal]]) back to whoever held it."
  (doseq (entry previous) (os/trap (first entry) (second entry))))

(defn signal-exit-code (sig)
  "The exit status of a program ended by `sig`, as the shell reports a signal death.

    (lifeline/signal-exit-code :term)   ;=> 143
    (lifeline/signal-exit-code :hup)   ;=> 129"
  (case sig :hup 129 :int 130 143))

(defn- unsaved-text (entry)
  "`[path text user]` for registry `entry` when it is a file buffer MODIFIED since it was read
or saved (the buffer's own mark, which a save sets on the process too) whose text its file
does not hold, else nil. An unmodified buffer never counts: a file it cannot read — a root
file looked at through sudo, /etc/shadow — is not taken as missing and its text copied to a
sidecar. Read from the buffer process with a timeout, so a process that died too is skipped,
not waited on. `user` is who the file is edited as through sudo, nil for yourself."
  (let (path (:file (or (:meta entry) {})))
    (when path
      (let (snapshot (buffer-sync (:proc entry)
                       (fn (buffer) [(buffer-modified? buffer) (buffer-text buffer)])
                       1000))
        (when (and (vector? snapshot) (vector? (second snapshot)))
          (let ([modified? text] (second snapshot)
                on-disk (when (and modified? (file/exists? path))
                          (check-allow :discarded-catch
                            (try
                              (:text (file-text-decode (charset/read-text path
                                                         (:coding (:meta entry)))))
                              (catch _e nil)))))
            (when (and modified? (not (= text on-disk)))
              [path text (buffer-sudo-user (:meta entry))])))))))

(defn emergency-save! (registry)
  "Write an auto-save sidecar (`#file#`, owner-only) for every file buffer in `registry`
whose text its file does not hold — what a loop that died left unsaved, read from the
buffer processes, which outlive it. Returns the paths it wrote; a sidecar that cannot be
written is logged and the rest still are."
  (let (entries (registry-entries registry))
    (if (not (vector? entries))
      []
      (into []
        (seq/keep entries
          (fn (entry)
            (let (unsaved (unsaved-text entry))
              (when unsaved
                (let ([path text user] unsaved)
                  (check-allow :discarded-catch
                    (try
                      ;; a file edited as another user keeps its sidecar private
                      (do (write-sidecar path user text) path)
                      (catch failure
                        (do
                          (log/warn (str "emergency auto-save of "
                                      path
                                      " failed: "
                                      (error-message failure)))
                          nil)))))))))))))

(defn saved-note (saved)
  "What a death or a signal says of the sidecars [[emergency-save!]] wrote, `saved` its paths.

    (lifeline/saved-note [])   ;=> \"auto-saved 0 unsaved file(s)\"
    (lifeline/saved-note [\"/a\" \"/b\"])   ;=> \"auto-saved 2 unsaved file(s): /a, /b\""
  (str "auto-saved "
    (count saved)
    " unsaved file(s)"
    (if (empty? saved) "" (str ": " (string/join saved ", ")))))

(defn restart-allowed? (deaths now)
  "Whether a loop that died at `now` may be started again, given the times of the earlier
`deaths`: fewer than `*restart-max*` of them inside the last `*restart-window-ms*`.

    (lifeline/restart-allowed? [] 1000)   ;=> true
    (lifeline/restart-allowed? [100 200 300] 1000)   ;=> false
    (lifeline/restart-allowed? [100 200 300] 90000)   ;=> true"
  (< (count (seq/filter deaths (fn (at) (< (- now at) *restart-window-ms*)))) *restart-max*))

(defn announce! (supervisor window registry live)
  "Tell `supervisor` (the process running [[supervise]]) what a fresh loop is: its window
id, the buffer registry its buffers are named in, and `live`, what a restarted loop should
carry over. Called by the loop process once its model exists."
  (when supervisor
    (send supervisor [:lifeline/loop (self) {:window window :registry registry :live live}])))

(defn no-restart! (supervisor)
  "Tell `supervisor` the calling loop is ending for good — its terminal hung up — so that
however it ends, it is not restarted: a loop started on a dead terminal could only die again
until `*restart-max*`. Called by the loop process."
  (when supervisor (send supervisor [:lifeline/no-restart (self)])))

(defn- close-window! (window)
  "Close the dead loop's `window`: a window outlives the process that opened it, frozen on
its last frame, and its input would go to a mailbox nobody reads."
  (when (and window (gui/available?))
    (check-allow :discarded-catch (try (gui/close window) (catch _e nil)))))

(defn- save-announced (state)
  "The sidecars of the registry a loop announced (`state`, [[announce!]]) written
([[emergency-save!]]): their paths — none when it announced no registry."
  (let (registry (:registry state)) (if (nil? registry) [] (emergency-save! registry))))

(defn- on-fatal-signal (child on-death state sig)
  "The runtime was told to end by `sig` (a logout, a `kill`): this process holds the signal so
a loop stuck in a turn cannot lose the text. The sidecars are written, the loop ended — not
waited for — and its window closed. `[:signal sig]`."
  (let (saved (save-announced state))
    (do
      (exit child :kill)
      (close-window! (:window state))
      (when on-death (on-death {:signal sig :saved saved :restarting? false}))
      [:signal sig])))

(defn- watch (supervisor restart on-death child state deaths)
  "The supervisor's loop over one child: take its announcement, and on its death save,
close, and restart it or stop (see [[supervise]])."
  (receive
    ([:lifeline/loop ^child announced] (watch supervisor restart on-death child announced deaths))
    ([:signal sig] (on-fatal-signal child on-death state sig))
    ;; the loop is ending for good (its terminal hung up): whatever ends it, no restart
    ([:lifeline/no-restart ^child] (watch supervisor
                                     restart
                                     on-death
                                     child
                                     (assoc state :no-restart true)
                                     deaths))
    ([:down _ ^child reason] (if (= reason :normal)
                               :quit (on-loop-death supervisor restart on-death state deaths reason)))))

(defn- on-loop-death (supervisor restart on-death state deaths reason)
  "The loop died of `reason`: its sidecars written, its window closed, `on-death` told, and a
fresh loop started over the announced registry when [[restart-allowed?]] — the supervisor
watching on — else `:died`."
  (let (now (os/now)
        saved (save-announced state)
        restarting? (and (not (nil? (:registry state)))
                      (not (:no-restart state))
                      (restart-allowed? deaths now)))
    (do
      (close-window! (:window state))
      (when on-death (on-death {:reason reason :saved saved :restarting? restarting?}))
      (if restarting?
        (let (next (spawn (fn () (restart supervisor state))))
          (do
            (monitor next)
            (watch supervisor restart on-death next state (conj deaths now))))
        :died))))

(defn supervise (start restart &optional (on-death nil))
  "Run the editor loop `(start supervisor)` in a child process and keep it running: when the
loop ends abnormally, write the unsaved buffers' sidecars ([[emergency-save!]]), close its
window, and run `(restart supervisor state)` in a fresh child, where `state` is what the dead
loop announced ([[announce!]]) — `{:window :registry :live}`. `on-death`, when given, is
called with `{:reason :saved :restarting?}` (`:signal` for `:reason` below), for the log. Returns `:quit` when a loop ends
normally (the editor quit), `:died` after a loop died with no restart allowed
([[restart-allowed?]]) or without having announced a registry to restart from.

The supervisor also holds SIGTERM, SIGHUP and SIGINT ([[trap-fatal]]), taken before the first
loop starts: on one the sidecars are written from the buffer processes, the loop is ended
whatever it is doing, its window closed, and `[:signal sig]` returned ([[signal-exit-code]]
is the status). A terminal display takes `:term` and `:hup` while it is entered, for its own
hang-up (brood ADR-586), and gives them back here when it leaves."
  (let (supervisor (self)
        previous (trap-fatal supervisor)
        first-child (spawn (fn () (start supervisor))))
    (do
      (monitor first-child)
      (let (outcome (watch supervisor restart on-death first-child {} []))
        (do (restore-traps previous) outcome)))))

;; ---- the daemon: no loop of its own to supervise ---------------------------------
;; A served session's loop is supervised by `serve`, one per session, and a runtime told to
;; end takes them all at once. So a daemon has one KEEPER: it holds the signals and the
;; registry of every live session, and saves them all before the runtime goes.

(defn- keeper (on-signal registries)
  "The keeper's loop over the set `registries` (see [[start-keeper]]). A registry that dies
leaves the set, so a session that ended costs the save no timeout."
  (receive
    ([:lifeline/keep registry] (if (contains? registries registry)
                                 (keeper on-signal registries)
                                 (do
                                   (monitor registry)
                                   (keeper on-signal (conj registries registry)))))
    ([:down _ registry _] (keeper on-signal (set/disj registries registry)))
    ([:signal sig] (on-signal sig (into [] (mapcat registries emergency-save!))))))

(defn start-keeper (on-signal)
  "Start the daemon's keeper, named `:lifeline-keeper`: it takes the fatal signals and, on
one, writes the sidecars of every registry handed to it ([[keep-registry]]) and calls
`(on-signal sig saved)`, which ends the runtime. Its pid."
  (let (pid (spawn (fn () (keeper on-signal #{}))))
    (do (proc/register :lifeline-keeper pid) (trap-fatal pid) pid)))

(defn keep-registry (registry)
  "Have the daemon's keeper ([[start-keeper]]) save `registry` when the runtime is told to
end. Nothing outside a daemon, where there is no keeper."
  (when (not (nil? (proc/whereis :lifeline-keeper)))
    (send :lifeline-keeper [:lifeline/keep registry])))
