(defmodule murforge
  "The forge's side of mur, from the editor — mur-forge (`mur.fly.dev`), where every change
is open from its first words, every save is a version people can read, and checks and
reviews hang off the version they are about. Reached through the `mur` client, so a working
copy's account and server are the ones it already uses:

- `o` the change's page on the forge, in the browser (where people review it, chunk by chunk)
- `O` *mur-changes*: every open change on the forge — RET brings one into this working copy
  and goes to it (`mur change <id>`), `o` opens its page
- `C` the checks of the last saved version · `D` its discussion · `R` what the review
  policy asks of it — each in a report beside the status, read off the loop"
  (:use model) ; message / ed-headless?
  (:use editor/keymap :only [keymap-bind]) ; the *mur-changes* keymap
  (:use editor/layers :only [register-type-layers]) ; its buffer type
  (:use section) ; section — the open changes, as a tree
  (:use sectionbuf) ; sb-show / sb-at / sb-keymap
  (:use interactive) ; defcommand
  (:use murcore) ; mur-mur / mur-json / mur-launch / mur-resolve-root / the faces
  (:use murstatus)) ; mur-show-text — a forge read shown as a report

;; ---- the browser ---------------------------------------------------------------------

(defn- browser-program ()
  "What opens a URL in the desktop's browser: `open` on macOS, `xdg-open` elsewhere."
  (if (= (os/type) :macos) "open" "xdg-open"))

(defn mur-browse-url (m url)
  "Open `url` in the browser, and say so. The opener is started DETACHED (`&`, its output to
/dev/null) through `sh`, so this returns at once: run directly, a browser `xdg-open` starts
can inherit the pipes `os/cmd` reads, and the call would wait until the browser exits. The URL
reaches `sh` quoted (`os/shell-quote`), so it is one word whatever it holds."
  (cond
    (or (nil? url) (= url "")) (message m "this change has no page yet")
    (ed-headless?) (message m (str "would open " url))
    :else
      (do
        (check-allow :discarded-catch
          (try
            (os/cmd "sh"
              ["-c" (str (browser-program) " " (os/shell-quote url) " >/dev/null 2>&1 &")])
            (catch _ nil)))
        (message m (str "opening " url)))))

(defcommand cmd-mur-browse
  (m key)
  "Open the change's page on the forge in the browser (o) — the change at point in
*mur-changes*, else the one you are on."
  (let (row (sb-at m)
        root (mur-resolve-root m))
    (cond
      (nil? root) (message m "not in a mur working copy")
      (and row (= (:type row) :open)) (mur-browse-url m (:url (:value row)))
      :else (mur-browse-url m (mur-own-url m root)))))

(defn- mur-own-url (m root)
  "The forge page of the change you are on: from the mode line's summary when it is about
this working copy (no subprocess), else asked of mur."
  (let (summary (:vcs-summary m))
    (if (and (= (:kind summary) :mur) (= (:root summary) root) (:url summary))
      (:url summary)
      (let (status (mur-json root ["status" "--json"])) (if (map? status) (:url status) nil)))))

;; ---- the forge's reads, as reports ------------------------------------------------

(defcommand cmd-mur-checks
  (m key)
  "The checks of the change's last saved version (C), in *mur-checks*: each job's result,
or that it waits for a runner."
  (let (root (mur-resolve-root m))
    (if (nil? root)
      (message m "not in a mur working copy")
      (mur-show-text m root "checks" ["checks"] "*mur-checks*"))))

(defcommand cmd-mur-discussion
  (m key)
  "The change's discussion (D), in *mur-discussion*: its threads, open or resolved, and whose
turn it is."
  (let (root (mur-resolve-root m))
    (if (nil? root)
      (message m "not in a mur working copy")
      (mur-show-text m root "discussion" ["discussion"] "*mur-discussion*"))))

(defcommand cmd-mur-reviews
  (m key)
  "What trunk's review policy asks of a review of this change, and who has approved it (R)."
  (let (root (mur-resolve-root m))
    (if (nil? root)
      (message m "not in a mur working copy")
      (mur-show-text m root "reviews" ["reviews"] "*mur-reviews*"))))

;; ---- *mur-changes*: the forge's open changes ------------------------------------------

(defn mur-open-changes-tree (open)
  "PURE: the *mur-changes* tree from `mur change --open --json`'s answer."
  (section :root
    nil
    nil
    (if (empty? open)
      ["No open changes on the forge."]
      (into ["Open changes on the forge — RET goes to one here, o opens its page, g reads again" ""]
        (map open
          (fn (change)
            (section :open
              change
              (str (if (:yours change) "* " "  ")
                (mur-short (:change change))
                "  "
                (string/pad-right (or (:author change) "?") 20)
                "  "
                (or (:title change) ""))
              []
              {:key (:change change)})))))))

(defn mur-open-changes-faces (row line)
  "The *mur-changes* `:section-faces`: an ID in the ID face, the header line dim."
  (let (n (string/length line))
    (cond
      (= (:type row) :open) (if (> n 14) [[2 14 mur-face-id]] [])
      (> n 0) [[0 n mur-face-note]]
      :else [])))

(defn- mur-show-open-changes (m root open)
  (sb-show m
    "*mur-changes*"
    (mur-open-changes-tree open)
    :mur-changes {:action :pop :ctx {:root root}}))

(defcommand cmd-mur-open-changes
  (m key)
  "Every open change on the forge (O), in *mur-changes*. Read off the loop: it asks the
forge."
  (let (root (mur-resolve-root m))
    (if (nil? root)
      (message m "not in a mur working copy")
      (mur-launch m
        "open changes"
        ["change" "--open" "--json"]
        (fn (mm r)
          (let (open (and (= (:exit r) 0)
                       (check-allow :discarded-catch (try (json/decode (:stdout r)) (catch _ nil)))))
            (if (vector? open)
              (mur-show-open-changes mm root open)
              (message mm "the forge's open changes could not be read ($ shows what mur said)"))))))))

(defcommand cmd-mur-take-change
  (m key)
  "Go to the open change at point (RET in *mur-changes*): `mur change <id>` brings one only
the forge has into this working copy first."
  (let (row (sb-at m))
    (if (or (nil? row) (not (= (:type row) :open)))
      (message m "not on a change")
      (mur-launch m "change" ["change" (:change (:value row))]))))

(defcommand cmd-mur-open-changes-refresh
  (m key)
  "Read the forge's open changes again (g in *mur-changes*)."
  (cmd-mur-open-changes m key))

(def mur-changes-keymap
  (-> (sb-keymap)
    (keymap-bind [:enter] 'murforge/cmd-mur-take-change)
    (keymap-bind ["o"] 'murforge/cmd-mur-browse)
    (keymap-bind ["g"] 'murforge/cmd-mur-open-changes-refresh)
    (keymap-bind ["q"] 'vcsproc/cmd-vcs-quit)
    (keymap-bind ["$"] 'vcsproc/cmd-vcs-process)))

(def mur-changes-mode-layer
  {:name 'mur-changes
   :doc "The forge's open changes: RET goes to one in this working copy, o opens its page."
   :keymap murforge/mur-changes-keymap
   :commands '("mur-take-change" "mur-open-changes-refresh")
   :section-faces 'murforge/mur-open-changes-faces})

(register-type-layers :mur-changes
  (list 'murforge/mur-changes-mode-layer 'modes/special-mode-layer 'modes/text-mode-layer))
