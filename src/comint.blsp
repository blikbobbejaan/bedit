(defmodule comint
  "The INPUT REGION of a line-oriented program's buffer (Emacs's comint): `the text after the
prompt is yours`, one idea however many kinds of buffer have it. A shell (bshell) and a
terminal in line mode (terminal) both carry `:input-start`; this module owns that field, the
process mark, the boundary guard and commands that keep the prompt out of reach, the ↑/↓/C-r
history over a buffer's own submitted lines, and M-x send-invisible, which asks the buffer's
mode to read a line masked (the `:send-invisible` service)."
  (:use model) ; ed-current-buf / ed-set-buf / message
  (:use pool) ; ed-name-prompt
  (:use commands) ; the editing commands the input region wraps (C-a, DEL, ↑/↓ …)
  (:use interactive) ; defcommand
  (:use editor/buffer)) ; goto-char / buffer-point / buffer-marker / replace-region
;; formbuf (guard-clamp / tail-region) is referenced qualified below.

;; ---- the process mark ---------------------------------------------------------
;; While a command runs, its output lands at the PROCESS MARK (comint's `process-mark`), not
;; at the end: anything typed ahead stays after it, below the output and, once the command
;; ends, after the new prompt as input waiting to be sent. That is also what keeps the
;; output's colour spans true — every edit the user makes is after them. The mark is a real
;; buffer MARKER (`editor/buffer`'s, left gravity), so every edit carries it: text typed
;; BEFORE it — C-a back onto the command line, a click up into the output — moves it
;; along, and the next chunk still lands after the output, never mid-word. While the
;; command runs, the input region starts there too (`input-region`).

(def- process-mark :process-mark) ; the marker id

(defn process-mark-at (buf)
  "Shell buffer `buf`'s process mark — where a running command's output lands — or nil when
none is set."
  (buffer-marker buf process-mark))

(defn with-process-mark (buf position)
  "Shell buffer `buf` with its process mark at `position`."
  (buffer-marker-set buf process-mark position))

(defn without-process-mark (buf)
  "Shell buffer `buf` with no process mark: its command is over."
  (buffer-marker-delete buf process-mark))

;; ---- the input region ---------------------------------------------------------

(defn input-region? (buf)
  "Whether buffer `buf` has an input region — an `:input-start` past which typing goes: a
shell, or a terminal in line mode. What the boundary and history commands serve."
  (int? (:input-start buf)))

(defn input-region (buf)
  "`[start end]` of buffer `buf`'s input region — CLAMPED into the buffer. A kill that
reached above `:input-start` (click up into the scrollback, then C-k: the layers bind
Backspace, not every kill) leaves the field past the end of the rope, and indexing off it
would throw. With no `:input-start` the region is empty, at the end. While a shell's
command runs the region starts at its PROCESS MARK instead (`process-mark-at`), as
comint's does: the line it was started with is sent, and what is typed now is input for
later. The one reader of the field, for the shell and a line-mode terminal alike."
  (let (end (buffer-length buf)
        mark (process-mark-at buf)
        start (if (and (:input-running buf) (int? mark)) mark (:input-start buf)))
    [(math/min (or start end) end) end]))
(sig input-region (buffer -> (tuple int int)))

(defn input-text (buf)
  "The text of buffer `buf`'s input region (from the clamped input start to the end)."
  (let ([start end] (input-region buf)) (string/substring (buffer-text buf) start end)))
(sig input-text (buffer -> string))

;; ---- input-region boundary (the prompt + output are not editable) -----------
;; In a shell you can't backspace into the prompt or move left of it. These wrap the
;; ordinary editing commands so motion/deletion stops at the buffer's `:input-start`;
;; point in the output *above* the input line stays free (so you can read/select it).

(defn- current-input-start (m)
  "The current buffer's input start — `input-region`'s, clamped into the buffer."
  (first (input-region (ed-current-buf m))))

(defcommand cmd-comint-beginning-of-input
  (m key)
  "C-a / Home: jump to the start of the input (just after the prompt) on the input line;
elsewhere (point up in the output) a normal beginning-of-line."
  (let (buf (ed-current-buf m)
        start (current-input-start m))
    (if (>= (buffer-point buf) start)
      (ed-set-buf m (goto-char buf start))
      (cmd-beginning-of-line m key))))

(defcommand cmd-comint-backward-char
  (m key)
  "C-b / Left: never cross left into the prompt — a no-op exactly at the input start; a
normal backward-char otherwise (within the input, or freely within the output above)."
  (if (= (buffer-point (ed-current-buf m)) (current-input-start m))
    m
    (cmd-backward-char m key)))

(defcommand cmd-comint-delete-backward
  (m key)
  "Backspace: never delete into the prompt or the read-only output — a no-op at or before
the input start; a normal backward delete within the input."
  (if (<= (buffer-point (ed-current-buf m)) (current-input-start m))
    m
    (cmd-delete-backward m key)))

(defn- input-line-start (text input-start)
  "The offset of the start of the line that holds the input region (the char after the
last newline before `input-start`)."
  (let (last-newline (string/last-index-of (string/substring text 0 input-start) "\n"))
    (if (< last-newline 0) 0 (+ last-newline 1))))

(defn enforce-input-boundary (m)
  "Pull point out of the prompt if it landed there — `formbuf/guard-clamp` over the
one editable region a shell buffer has (`formbuf/tail-region` from the input start:
everything after the prompt is yours). The `:clamp` policy rather than `:veto`
because a shell's generated part is legitimately navigable — you scroll and select
output freely; only *typing* position is constrained. A no-op in any other buffer."
  (let (buf (ed-current-buf m))
    (if (not (input-region? buf))
      m
      (let (input-start (first (input-region buf))
            line-start (input-line-start (buffer-text buf) input-start))
        ;; Only the prompt PORTION of the input line is out of bounds: point in the
        ;; output above it stays put, so the scrollback keeps its own cursor.
        (if (and (< (buffer-point buf) input-start) (>= (buffer-point buf) line-start))
          (formbuf/guard-clamp m
            (fn (guarded) (buffer-text (ed-current-buf guarded)))
            (fn (guarded) (buffer-point (ed-current-buf guarded)))
            (fn (guarded position)
              (ed-set-buf guarded (goto-char (ed-current-buf guarded) position)))
            (fn (text) (formbuf/tail-region text input-start)))
          m)))))

(defn input-post-key (m-before m key)
  "The input-region layers' `:post-key` guard (layers §7): repair, don't veto — point is
clamped out of the prompt rather than the keystroke undone, so `m-before` is unused."
  (enforce-input-boundary m))

;; ---- command history (↑/↓ recall, like the Brood REPL; per buffer) ----------

(defn input-history (m)
  "The current buffer's submitted-line history (oldest first)."
  (or (:input-history (ed-current-buf m)) []))

(defn- set-current-field (m field value)
  "The model with field `field`=`value` set on the *current* buffer."
  (ed-set-buf m (assoc (ed-current-buf m) field value)))

(defn remember-input (m line)
  "Record submitted `line` in the current buffer's in-memory history (skipping an immediate
duplicate) and reset that buffer's browse cursor — so the next ↑ starts from the newest.
Nothing is persisted: a line-mode terminal (iex, nest repl) keeps its own history this
way, out of the SHELL's history file."
  (let (history (input-history m)
        history-length (count history)
        updated (if (and (> history-length 0) (= (nth history (dec history-length)) line))
                  history
                  (into history [line])))
    (ed-set-buf m
      (assoc (ed-current-buf m) :input-history updated :input-history-index nil :input-draft nil))))

(defn- set-input (m input)
  "Replace the input region of the current buffer with `input`, point at the end."
  (let (buf (ed-current-buf m)
        [start end] (input-region buf))
    (ed-set-buf m (end-of-buffer (replace-region buf start end input)))))

(defn- point-in-output? (m)
  "Whether point is above the input line (in the read-only output) — where ↑/↓ should move
by line to read output, not browse history."
  (let (buf (ed-current-buf m))
    (< (buffer-point buf) (input-line-start (buffer-text buf) (current-input-start m)))))

(defn- current-input-text (m)
  "The current input region's text (from the input start to the buffer end)."
  (input-text (ed-current-buf m)))

(defn- arrows-move-by-line? (m)
  "Whether ↑/↓ should move by line instead of browsing history: point is in the output
above, or the input is a multi-line form mid-edit (so the arrows navigate the form)."
  (or (point-in-output? m) (includes? (current-input-text m) "\n")))

(defcommand cmd-comint-previous-history
  (m key)
  "↑ / C-p: recall the previous command from this buffer's history into the input (browsing
the live input as the slot past the newest). Above the input line, an ordinary move-up."
  (if (arrows-move-by-line? m)
    (cmd-previous-line m key)
    (let (history (input-history m)
          history-length (count history))
      (if (= history-length 0)
        m
        (let (buf (ed-current-buf m)
              index (:input-history-index buf)
              draft (if (nil? index) (input-text buf) (:input-draft buf))
              new-index (if (nil? index) (dec history-length) (math/max 0 (dec index))))
          (set-input (set-current-field (set-current-field m :input-history-index new-index)
                       :input-draft draft)
            (nth history new-index)))))))

(defcommand cmd-comint-next-history
  (m key)
  "↓ / C-n: recall the next command, or restore the live input once you step past the
newest. Above the input line, an ordinary move-down."
  (if (arrows-move-by-line? m)
    (cmd-next-line m key)
    (let (buf (ed-current-buf m)
          history (input-history m)
          history-length (count history)
          index (:input-history-index buf))
      (if (nil? index)
        m
        (let (new-index (+ index 1))
          (if (>= new-index history-length)
            (set-input (set-current-field m :input-history-index nil) (or (:input-draft buf) ""))
            (set-input (set-current-field m :input-history-index new-index) (nth history new-index))))))))

(defcommand cmd-comint-history-search
  (m key)
  "C-r: search this buffer's command history — a filterable minibuffer list (newest first);
the chosen entry replaces the current input. Reverse-i-search, the editor-idiomatic way."
  (let (history (reverse (input-history m)))
    ; newest first
    (if (empty? history)
      (message m "no history yet")
      (assoc m
        :minibuffer
          (ed-name-prompt "History: " history (fn (prompted entry) (set-input prompted entry)) 15)))))

;; ---- send-invisible -------------------------------------------------------------

;; check-allow: the service is a command in all but name, resolved late
(check-allow :trusted
  (defcommand cmd-send-invisible
    (m key)
    "M-x send-invisible (Emacs's `comint-send-invisible`): read a line masked and send it to
the program in this buffer — a line-mode terminal's, or the command a shell is running —
without showing it or remembering it. For a password prompt bedit did not recognise; one
it recognises opens this read by itself. The buffer's mode does the reading (its
`:send-invisible` service), so this names no kind of buffer."
    (let (service (editor/layers/layer-facet (ed-current-buf m) :send-invisible))
      (if (nil? service) (message m "no program here to send to") (ed-call-deferred m service m)))))
