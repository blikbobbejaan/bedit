(defmodule bshell
  "A line-based **project shell + Brood REPL** — bedit's `bshell`/`comint`, `C-x p e`. (The
project's OWN REPL — iex, nest repl — is a terminal buffer, terminal.blsp, `C-x p r`.)

**Per project, like Emacs `project-eshell`.** Each project gets its **own** uniquely-named
buffer (`*bshell: <dir>*`) with its **own** shell process, history, and input region — so
`C-x p e` opens (or switches to) *this* project's shell, never the last one's. All of a
bshell's state lives **on its buffer** (`:bshell-root` marks it; `:bshell-proc`,
`:bshell-running`, `:input-start`, and the history fields are buffer-local), so the
shells are independent and a buffer carries everything it needs. The input-region
vocabulary is this file's and SHARED: a terminal buffer in line mode (terminal.blsp) carries
the same `:input-start` and reuses the boundary guard and the ↑/↓/C-r history commands
below, because `the text after the prompt is yours` is one idea, not two.

Type a line, press RET. A line starting with `(` is **evaluated as Brood** (a REPL — value
printed `=> …`, defs persisting across the session); anything else runs via `proc-spawn`'d
`sh -c` **in the project root** (`:cwd`, ADR-104). Output streams back, then a fresh prompt
(non-zero exit → `[exit N]`; success silent, bash-style). ↑/↓ recall history, Tab completes
(filenames / Brood globals), and `:fontify`/`:bracket-match`/`:eldoc` colour + light up the
input form. The `proc` mechanism is pipe-based (no PTY) — no raw mode; ANSI escapes stripped.

Structure mirrors `lsp.blsp`: a dedicated **shell process** (`bshell-loop`, per buffer)
owns the child `proc` (and runs Brood eval in its own image, off the editor loop). It
receives `[:bshell-run line]`, runs it, and forwards each chunk as a `bshell-output-event`
/ the exit as a `bshell-done-event` (keyed by buffer name; each folds itself in — `UiEvent`)."
  (:use editor/keymap :only [keymap-bind]) ; the mode keymap below
  (:use editor/layers :only [register-type-layers]) ; the buffer type below
  (:use scroll) ; ed-scroll / ed-max-top / ed-long-lines — keeping point on screen
  (:use model) ; ed-buffer-index-by-name / ed-scroll / ed-stamp / ed-log-buffer / ed-set-buf
  (:use pool) ; ed-open-buffer / ed-select / ed-project-root — the shell buffer and where it runs
  (:use commands) ; the editing commands the input region wraps (C-a, DEL, ↑/↓ …)
  (:use projects) ; editor-state-dir + the shared persist-read / persist-write! layer
  (:use interactive) ; defcommand — define + register the M-x commands
  (:use eval-command) ; eval-source — a line starting with `(` is evaluated as Brood (REPL)
  (:use complete-at-point) ; complete-add-source! — register the path/symbol completion source
  (:use editor/highlight) ; highlight-spans / shift-spans / bracket-match — Brood input services
  (:use ansicolor :only [insert-output]) ; a command's output: its ANSI colours as text properties, its returns done
  (:use editor/buffer) ; make-buffer / insert / end-of-buffer / buffer-length / goto-char
  (:use passwd)) ; ed-read-passwd / password-prompt? — a password a command asks for, read masked
;; formbuf (guard-clamp / tail-region), ansicolor/decode, ansi/decoder and modes (fontify + gutter
;; faces) are referenced qualified below — each `mod/name` auto-loads its module.
;; ---- prompt + per-project buffer name ---------------------------------------

(defn- bshell-prompt (dir)
  "The shell prompt: the directory you're in (home abbreviated to `~`) plus `\" $ \"`
— e.g. `~/src/broodlang/bedit $ ` — so you can always see the folder."
  (str (path/abbreviate dir) " $ "))

(defn- bshell-buffer-name (root)
  "The unique buffer name for `root`'s shell — `*bshell: <dir>*` (the abbreviated root), so
each project gets its own (Emacs `project-eshell` names per project the same way)."
  (str "*bshell: " (path/abbreviate root) "*"))

;; ---- per-buffer state (each project's shell is independent) ------------------
;; A bshell IS just a buffer (mode `:type` `:bshell`) whose `:dir` is its project root — it
;; reuses the generic per-buffer default-directory, not a bespoke root field. On top of that
;; generic buffer it carries its shell-specific runtime state, keyed by buffer name in the pool:
;;   :bshell-proc  the shell process pid    :bshell-running  a command is in flight
;;   :input-start  char index where the current input begins — the GENERIC input-region
;;                 field: a terminal buffer in line mode (terminal.blsp) carries it too, and the
;;                 boundary + history commands below serve both
;;   :bshell-history / :bshell-hist-idx / :bshell-draft  ↑/↓ recall state
;; The project root is the generic `:dir` (so project commands from a bshell buffer just work).

(defn bshell-buffer? (b)
  "Whether buffer `b` is a bshell buffer — its mode/`:type` is `:bshell` (the generic buffer
mechanism, not a bespoke field). Its project root is just the buffer's `:dir`."
  (= (:type b) :bshell))

(defn bshell-live (m)
  "Every shell whose command C-x C-c would kill (`model/register-exit-query`): a bshell
buffer with a command in flight. An idle shell loses nothing — its prompt is bedit's."
  (vec (seq/keep (:buffers m)
         (fn (b)
           (when (and (bshell-buffer? b) (:bshell-running b))
             (str (buffer-name b) ": " (or (:bshell-command b) "a command")))))))

(register-exit-query :bshell 'bshell/bshell-live)

(defn input-region? (b)
  "Whether buffer `b` has an input region — an `:input-start` past which typing goes: a
shell, or a terminal in line mode. What the boundary and history commands serve."
  (int? (:input-start b)))

(defn- bshell-bufget (m nm k)
  "Field `k` of the pool buffer named `nm`, or nil if there's no such buffer."
  (let (i (ed-buffer-index-by-name m nm))
    (when i (get (nth (:buffers m) i) k))))

(defn- bshell-bufset (m nm k v)
  "The model with field `k`=`v` set on the pool buffer named `nm` (a no-op if absent)."
  (ed-update-named m nm (fn (b) (assoc b k v))))

;; ---- persistent command history (across sessions, like the REPL) ------------

(def *bshell-history-max* 1000) ; most-recent entries kept on disk
(defn- bshell-history-path ()
  "The history file: `$BSHELL_HISTORY`, else `bshell-history.blsp` under the editor's shared
state dir — a re-readable vector, persisted through the same `persist-*` layer as every other
generated file (not a loose dotfile in `$HOME`)."
  (or (os/env "BSHELL_HISTORY") (path/join (editor-state-dir) "bshell-history.blsp")))

(defn- bshell-history-trim (history)
  "Keep the most recent `*bshell-history-max*` entries (oldest first). Pure — the testable
core of save."
  (into [] (drop history (math/max 0 (- (count history) *bshell-history-max*)))))
;; Declared: inferring the domain from the body reached for `math/max`'s numeric
;; argument and typed `history` as a datetime, which no caller passes.

(defn- bshell-load-history ()
  "The saved history as a vector (oldest first), or `[]` if none / unreadable — a missing or
corrupt history file must never stop a shell opening (the shared reader guarantees this)."
  (persist-read (bshell-history-path)))

(defn- bshell-save-history (history)
  "Atomically persist the most recent `*bshell-history-max*` entries (oldest first).
Best-effort via the shared writer — a failure is swallowed, never breaking the editor."
  (persist-write! (bshell-history-path) (bshell-history-trim history)))

;; ---- ANSI colour (pipes carry colour escapes) -----------------------------------
;; The worker keeps one decoder per stream of the command it runs (`ansicolor/decode`, over
;; std's streaming `ansi/feed`), so an escape split across two reads never shows; the
;; colours travel with the text and land on it as its text property (`ansicolor/faces`), as
;; Emacs's shell-mode colours a command's output.

(defn- bshell-forward (state stream data)
  "Decode the chunk `data` of `stream` (`:out` or `:err`) with that stream's decoder in
`state`, send its text and colours to the editor, and return `state` with the decoder
advanced."
  (let ([decoder text spans] (ansicolor/decode (get state stream) data))
    (when (not (= text ""))
      (send (:reply state) (bshell/bshell-output-event (:buffer state) text spans)))
    (assoc state stream decoder)))

;; ---- the shell process (one per buffer; mirrors lsp's connection process) ----
;; State: {:buffer <name> :root <dir> :proc <handle|nil> :reply <loop>}. Owns the child `proc` so its
;; output lands here, not in the editor's mailbox; forwards each chunk to the editor.

(defn- bshell-brood-form? (line)
  "Whether `line` should be evaluated as Brood (a REPL form) rather than run as a shell
command — true when its first non-blank char is `(`."
  (string/starts-with? (string/triml line) "("))

(defn- bshell-incomplete? (e)
  "Whether caught value `e` is the reader's *incomplete input* error (an unclosed form or
string — code E0002, ADR-049): the signal that RET should add a line, not submit."
  (and (map? e) (= (:code e) "E0002")))

(defn- bshell-complete-input? (line)
  "Whether `line` is ready to run on RET. A shell command always is. A Brood form is ready
once it parses; an *incomplete* form (unclosed paren/string) is not — RET adds a newline so
you keep typing it, like the REPL. A complete-but-malformed form still submits (reflect/eval reports
the error)."
  (if (bshell-brood-form? line)
    (try (do (reflect/read-all line) true) (catch e (not (bshell-incomplete? e))))
    true))

(defn- bshell-eval-and-reply (state line)
  "Evaluate `line` as Brood **in this process** (so defs persist across the session, like
a REPL — and off the editor loop), then push the formatted result + a success exit back."
  (let (buf (:buffer state)
        out (eval-source line))
    ; never throws: captured output then `=> value`, or `error: …`
    (do
      (send (:reply state) (bshell/bshell-output-event buf (str out "\n") []))
      (send (:reply state) (bshell/bshell-done-event buf 0))
      (bshell-loop state))))

;; The record constructors below are named QUALIFIED, and have to be. These sends run
;; inside a `spawn`ed process: the closure ships, and its free globals re-resolve on
;; the receiver — where the BARE name is not bound (only `bshell/bshell-output-event`
;; is), so the worker died with "unbound symbol: bshell-output-event" the moment it
;; had anything to say.

(defn- bshell-loop (state)
  "The shell process's receive loop: `[:bshell-run line]` evaluates `line` as Brood when it
starts with `(`, else spawns `sh -c line` in `:root`; the child's stdout/stderr forward to
the editor as a `bshell-output-event` (ANSI-decoded: a pipe's output is append-only text
that happens to be coloured, so its escapes become faces — each stream with its own
decoder, fresh per command — rather than an emulated screen); its exit as a
`bshell-done-event`; `:shutdown` kills any live child and stops. A LONG-LIVED program —
the project REPL — is not hosted here: that is a terminal buffer (terminal.blsp), under
a pty and a real emulator."
  (receive
    ([:bshell-run line] (if (bshell-brood-form? line)
                          (bshell-eval-and-reply state line)
                          (let (p (os/shell-spawn line {:cwd (:root state)}))
                            (bshell-loop (assoc state
                                           :proc p
                                           :out (ansicolor/decoder)
                                           :err (ansicolor/decoder))))))
    ([:proc p data] (bshell-loop (bshell-forward state :out data)))
    ([:proc-err p data] (bshell-loop (bshell-forward state :err data)))
    ([:proc-closed p code] (do
                             (send (:reply state) (bshell/bshell-done-event (:buffer state) code))
                             (bshell-loop (assoc state :proc nil))))
    ;; C-c C-c: Ctrl-C to the command and everything it started (`os/signal` reaches the
    ;; child's process group); its exit arrives as `[:proc-closed …]` like any other. A
    ;; Brood form is evaluated in THIS process, so there is nothing to interrupt then.
    ;; a line for the running command's stdin — a password it asked for (`bshell-read-secret`)
    ([:bshell-input text] (do
                            (when (:proc state)
                              (check-allow :discarded-catch
                                (try (os/write (:proc state) (str text "\n")) (catch _ nil))))
                            (bshell-loop state)))
    ([:bshell-interrupt] (do
                           (when (:proc state) (os/signal (:proc state) :int))
                           (bshell-loop state)))
    ([:shutdown] (do
                   (when (:proc state) (procstream/close-quietly (:proc state) "bshell"))
                   :bshell-stopped))))

(defn bshell-connect (buffer root)
  "Spawn the shell process for `buffer` rooted at `root`; returns its pid (stored on that
buffer under `:bshell-proc`). `(bshell-shutdown pid)` stops it. Output and exits go to
the loop that opened the shell (`editor/ui/*loop*`), so a shell opened in a second frame answers
there — `:editor` only for one started before any loop runs."
  (let (reply (ed-loop-address))
    (spawn (bshell-loop {:buffer buffer
                         :root root
                         :proc nil
                         :reply reply
                         :out (ansicolor/decoder)
                         :err (ansicolor/decoder)}))))

(defn bshell-interrupt (pid)
  "Interrupt whatever command shell process `pid` is running (Ctrl-C to its process group);
a no-op when it is idle."
  (send pid [:bshell-interrupt]))

(defn bshell-shutdown (pid)
  "Stop a shell process: kill any running child and end the process."
  (send pid [:shutdown]))

(defn bshell-on-close (buf)
  "The bshell layer's `:on-close` hook (fired by `commands/cmd-kill-buffer` via
`close-context`): the shell buffer is going away, so stop the worker it owns and
whatever child it was running. Without this, `C-x k` on a `*shell: …*` buffer left
both alive until the editor exited — the layers `:on-close` seam exists precisely
for a mode that spawned something."
  (do (when (:bshell-proc buf) (bshell-shutdown (:bshell-proc buf))) buf))

;; ---- buffer plumbing --------------------------------------------------------
;; Every write to a shell buffer goes through `bshell-write`, because of where the cursor
;; lives. Point is PER PANE (window-point, model.blsp): the pooled buffer's own point is
;; only a saved default, so a write that leaves the pooled point at the new end moves no
;; cursor anyone can see. That was the bug — type a command, RET, and the cursor stayed on
;; the line you typed while the output and the next prompt appeared below it. The rule is
;; comint's: a pane whose point was at or past the PROCESS MARK (where the output goes)
;; moves with the text after it; a pane up in the scrollback, reading — even the running
;; command's own output — stays put.

(defn- bshell-write (m nm f)
  "Buffer `nm` (which must exist) replaced by `(f buffer)` — a write of output at the
process mark (`bshell-output-point`) — with every pane on it that was AT or past the mark
carried along with the text after it, as comint's windows at the process mark follow: a
pane at the end stays at the end, one in the input typed ahead keeps its place in it. A
pane up in the scrollback — the running command's own output included — stays put."
  (let (idx (ed-buffer-index-by-name! m nm)
        before (ed-buf-at m idx)
        at (bshell-output-point before)
        after (f before)
        grown (- (buffer-length after) (buffer-length before)))
    (ed-map-panes (ed-set-buf-at m idx after)
      (fn (w)
        (if (and (= (:buffer w) idx) (int? (:point w)) (>= (:point w) at))
          (assoc w :point (math/max 0 (math/min (buffer-length after) (+ (:point w) grown))))
          w)))))

(defn- bshell-append (m nm s)
  "Append raw text `s` at the end of buffer `nm` (creating it if absent), point following
the inserted text. Unlike `model/ed-append-named` it forces **no** trailing newline — a
stream chunk isn't line-aligned, so a forced newline would split mid-line output. `insert`
preserves the buffer's other fields (`:bshell-*`), so its per-buffer state survives."
  (bshell-append-output m nm s nil))

;; While a command runs, its output lands at the PROCESS MARK (comint's `process-mark`), not
;; at the end: anything typed ahead stays after it, below the output and, once the command
;; ends, after the new prompt as input waiting to be sent. That is also what keeps the
;; output's colour spans true — every edit the user makes is after them. The mark is a real
;; buffer MARKER (`editor/buffer`'s, left gravity), so every edit carries it: text typed
;; BEFORE it — C-a back onto the command line, a click up into the output — moves it
;; along, and the next chunk still lands after the output, never mid-word. While the
;; command runs, the input region starts there too (`input-region`).

(def- process-mark :bshell-process-mark) ; the marker id

(defn process-mark-at (b)
  "Shell buffer `b`'s process mark — where a running command's output lands — or nil when
none is set."
  (buffer-marker b process-mark))

(defn with-process-mark (b position)
  "Shell buffer `b` with its process mark at `position`."
  (buffer-marker-set b process-mark position))

(defn- bshell-output-point (b)
  "Where output lands in shell buffer `b`: while a command runs, its process mark — before
anything typed ahead — else the buffer's end."
  (let (end (buffer-length b)
        at (process-mark-at b))
    (if (and (:bshell-running b) (int? at)) (math/min at end) end)))

(defn- bshell-append-output (m nm s spans)
  "`bshell-append` of a chunk of command output at the process mark (`bshell-output-point`),
its ANSI colours (`spans` from the chunk's start, `ansicolor/decode`'s) coming with it as its
`:ansi` text property and its carriage returns done — a progress counter rewrites its line,
Emacs's `comint-carriage-motion` (`ansicolor/insert-output`) — the mark advanced past it and
point at the buffer's end. The buffer then keeps only its newest lines (`ed-cap-output`,
Emacs's `comint-buffer-maximum-size`): its `:input-start`, process mark and every pane's
cursor move with the text, and the colours belong to it."
  (ed-cap-output (if (nil? (ed-buffer-index-by-name m nm))
                   (update m
                     :buffers into
                     [(first (insert-output (ed-stamp (ed-log-buffer nm)) 0 s spans))])
                   (bshell-write m
                     nm
                     (fn (b)
                       (let ([written end] (insert-output b (bshell-output-point b) s spans)
                             [broken mark] (bshell-break-long-line written end))
                         (end-of-buffer (with-process-mark broken mark))))))
    nm))

(defdyn *bshell-line-max* 65536)
;; The longest output line a shell lets a command grow before it ends it, as procstream hands
;; a partial line over at the same size: a command that writes without a newline (a progress
;; bar, a minified dump) would otherwise grow one line without end, and every chunk would pay
;; for the line so far (the password watch, the carriage return, the view).

(defn- bshell-break-long-line (b end)
  "`[b' end']`: shell buffer `b`, output just written up to `end`, with a newline added there
when the line `end` is on has grown past [[*bshell-line-max*]] chars — the next chunk then
starts a fresh line."
  (let (rope (buffer-rope b)
        line-start (text/line->char rope (text/char->line rope end)))
    (if (> (- end line-start) *bshell-line-max*)
      [(first (insert-output b end "\n" [])) (inc end)]
      [b end])))

(defn- bshell-buffer-end (m nm)
  "The char length of buffer `nm` — where freshly-emitted input begins."
  (buffer-length (nth (:buffers m) (ed-buffer-index-by-name! m nm))))

(defn- bshell-ensure-bol (m nm)
  "Append a newline to buffer `nm` only if its output doesn't already end at a line start —
so a fresh prompt sits at column 0 without a spurious blank line after newline-terminated
output. Asked at the process mark (`bshell-output-point`), not the end, which may hold
input typed ahead."
  (let (b (nth (:buffers m) (ed-buffer-index-by-name! m nm))
        at (bshell-output-point b)
        before (if (= at 0) nil (buffer-char-before (goto-char b at))))
    (if (or (nil? before) (= before "\n")) m (bshell-append m nm "\n"))))

(defn- bshell-emit-prompt (m nm prompt)
  "Append `prompt` (preceded by a newline) to buffer `nm` and mark its input region as
starting at the new end (`:input-start`, on the buffer)."
  (let (m1 (bshell-append m nm (str "\n" prompt)))
    (bshell-bufset m1 nm :input-start (bshell-buffer-end m1 nm))))

(defn- bshell-prompt-for (m nm)
  "The prompt string for the shell buffer `nm` (from its `:dir` — its project root)."
  (bshell-prompt (or (bshell-bufget m nm :dir) ".")))

;; ---- the inbound async events (UiEvent records — see model.blsp) ------------
;; Each folds through its named `ed-ev-*` fn (`model/defuievent`), so redefining one
;; hot-swaps the live editor (the impl's global call resolves late, like a keymap binding).

(defuievent bshell-output-event (buffer text spans) ed-ev-bshell-output) ; a chunk of shell/eval output, ANSI-decoded, and its colours
(defuievent bshell-done-event (buffer code) ed-ev-bshell-done) ; the command's exit (nil = killed)

(defn ed-ev-bshell-output (m event textrows cols rows)
  "A `bshell-output-event` from the shell process → append the (ANSI-decoded) chunk to
that buffer, its colours as faces, and keep the viewport following the output; a chunk that
leaves the running command at a password prompt reads the password (`bshell-watch-password`)."
  (let (nm (bshell-output-event-buffer event))
    (bshell-watch-password (ed-scroll (bshell-append-output m
                                        nm
                                        (bshell-output-event-text event)
                                        (bshell-output-event-spans event))
                             textrows)
      nm)))

;; ---- a password the running command asks for ------------------------------------------------
;; A command runs on PIPES (no terminal), so nothing can say it turned echo off; what it
;; printed last is the only signal — matched as comint matches it (`passwd/password-prompt?`:
;; `[sudo] password for me:` from `sudo -S`, `Password:`, `Enter passphrase …`). On a match
;; the answer is read masked and written to the command's stdin, never into the buffer or the
;; history. `:bshell-secret` marks a command waiting for one; it is re-decided per chunk of
;; output, so the prompt it answered cannot ask again until the command prints anew.

(defn- last-line (b)
  "The text of the line a command's output ends on, up to where its next output would land
(`bshell-output-point`) — its prompt, without anything typed ahead after it. A line longer
than [[*bshell-prompt-max*]] is no prompt and reads as \"\": the password watch runs on
every chunk, and must not pay for a long line of output again on each one."
  (let (rope (buffer-rope b)
        at (bshell-output-point b)
        line-start (text/line->char rope (text/char->line rope at)))
    (if (> (- at line-start) *bshell-prompt-max*) "" (text/slice rope line-start at))))

(defdyn *bshell-prompt-max* 256) ; the longest line the password watch reads as a prompt

(defn bshell-read-secret (m nm &optional (seed nil))
  "Read a line masked and send it to the command shell `nm` is running — the answer to a
password prompt, kept out of the buffer and the history. Says so when nothing is running.
With `seed` (the key that opened the read, or \"\"), what was typed after the process mark
since the prompt APPEARED is MOVED into the read — out of the buffer and its undo history
(`passwd/take-since-prompt`) — and `seed` follows it. Text typed ahead of the prompt stays
as the next input."
  (let (idx (ed-buffer-index-by-name m nm)
        b (if (nil? idx) nil (ed-buf-at m idx)))
    (if (not (and b (:bshell-running b) (:bshell-proc b)))
      (message m "no command running to send to")
      (let (line (string/trim (last-line b))
            [taken typed] (if (nil? seed)
                            [b ""]
                            (passwd/take-since-prompt b
                              (bshell-output-point b)
                              (buffer-length b))))
        (passwd/ed-read-passwd (ed-update-named m nm (fn (_) taken))
          (if (= line "") "Password: " (str line " "))
          (fn (m1 password)
            (let (now (ed-buffer-index-by-name m1 nm)
                  finished "the command has finished; nothing sent")
              (if (nil? now)
                (message m1 finished)
                (let (current (ed-buf-at m1 now))
                  (if (not (and (:bshell-running current) (:bshell-proc current)))
                    (message m1 finished)
                    (do
                      (send (:bshell-proc current) [:bshell-input password])
                      (ed-set-buf-at m1 now (assoc current :bshell-secret false))))))))
          nm
          (str typed (or seed "")))))))

(defn bshell-secret-pending? (m)
  "Whether the selected buffer is a shell whose running command waits at a password prompt
no read has been opened for yet — where a typed key belongs to a masked read
(`input/secret-overlay`)."
  (let (b (ed-current-buf m))
    (and (bshell-buffer? b)
      (= true (:bshell-secret b))
      (:bshell-running b)
      (not (nil? (:bshell-proc b)))
      (nil? (:minibuffer m)))))

(defn bshell-secret-key (m input)
  "Open the masked read of the selected shell's password prompt with typed key `input`
(`passwd/secret-key?`) as its last character, after whatever was typed since the prompt
appeared; type-ahead from before it stays in the input region."
  (bshell-read-secret m (buffer-name (ed-current-buf m)) (passwd/secret-key-text input)))

(defn- bshell-watch-password (m nm)
  "After output reached shell `nm`: note whether its running command now waits at a password
prompt, and when it has just started to — and you are looking at it, with no other prompt
open — read the password (`bshell-read-secret`). Elsewhere the first key typed there, or
RET, asks (`input/secret-overlay`). Where the input ended when the prompt appeared is
marked (`passwd/mark-prompt`): what was typed before it stays as the next input."
  (let (idx (ed-buffer-index-by-name m nm))
    (if (nil? idx)
      m
      (let (b (ed-buf-at m idx))
        (if (not (:bshell-running b))
          m
          (let (secret? (passwd/password-prompt? (last-line b))
                asked? (and secret? (not (:bshell-secret b)))
                flagged (assoc b :bshell-secret secret?)
                noted (ed-set-buf-at m idx (if asked? (passwd/mark-prompt flagged) flagged)))
            (if (and asked? (= idx (ed-current-index noted)) (passwd/ed-prompt-free? noted))
              (bshell-read-secret noted nm "")
              noted)))))))

(defn ed-ev-bshell-done (m event textrows cols rows)
  "A `bshell-done-event` → on a line of its own, a non-zero `[exit N]` (a clean exit
0 is silent; a signal is `[exit killed]`), then a fresh prompt for that buffer — all at the
process mark, so input typed ahead ends up after the prompt, waiting to be sent; mark *that*
shell idle and start *its* input region where the prompt ends (all per-buffer)."
  (let (nm (bshell-done-event-buffer event)
        code (bshell-done-event-code event)
        ;; a password prompt the command left open has nobody to answer now
        m0 (bshell-ensure-bol (passwd/ed-withdraw-read m nm) nm) ; the prompt starts at column 0, no blank line
        m1 (cond
             (= code 0) m0
             (nil? code) (bshell-append m0 nm "[exit killed]\n")
             else (bshell-append m0 nm (str "[exit " code "]\n")))
        m2 (bshell-append m1 nm (bshell-prompt-for m1 nm))
        prompt-end (bshell-output-point (nth (:buffers m2) (ed-buffer-index-by-name! m2 nm)))
        m3 (ed-update-named m2
             nm
             (fn (b)
               (buffer-marker-delete (assoc b :bshell-running false :bshell-secret false)
                 process-mark))))
    (ed-scroll (bshell-bufset m3 nm :input-start prompt-end) textrows)))

;; ---- syntax highlighting (the :fontify mode service) ------------------------
;; bash colours its prompt; we colour the prompt prefix (green/bold) of each prompt line,
;; and any `[exit N]` / `error:` line (red). Like every `:fontify` it's a pure
;; `text -> [start end face]` (ascending, non-overlapping) over the buffer. The `:fontify`
;; service only gets the text (not the buffer), so the prompt is detected *from the text*:
;; the buffer's first line is its prompt (each project's is its own), so this is per-buffer
;; correct without any global state. The faces are theme chrome (`theme/defchrome`), so
;; M-x theme-select repaints a shell with everything else.

(theme/defchrome bshell-face-prompt {:fg *green* :bold true}) ; the bash-like prompt
(theme/defchrome bshell-face-error {:fg *red*}) ; an [exit N] / error: line
(defn- bshell-detect-prompt (text)
  "The shell's prompt, detected from `text`: the buffer's first prompt is `<dir> $ `, so it's
the text up to and including the first `\" $ \"`. `\"\"` when there's none. Per-buffer (each
project's prompt is its own first line), so no global state is needed."
  (let (i (index-of text " $ "))
    (if (< i 0) "" (string/substring text 0 (+ i 3)))))

(defn- bshell-span-for (line linestart prompt)
  "A fontify span for the buffer `line` starting at offset `linestart`, given the session
`prompt`, or nil."
  (cond
    (and (> (string/length prompt) 0) (string/starts-with? line prompt))
      [linestart (+ linestart (string/length prompt)) bshell-face-prompt]
    (or (string/starts-with? line "[exit ") (string/starts-with? line "error:"))
      [linestart (+ linestart (string/length line)) bshell-face-error]
    else nil))

(defn- bshell-line-spans (text pos prompt acc)
  "Tail-recursive line scan from offset `pos`, collecting the non-nil per-line spans."
  (if (>= pos (string/length text))
    (reverse acc)
    (let (nl (index-of text "\n" pos)
          end (if (< nl 0) (string/length text) nl)
          sp (bshell-span-for (string/substring text pos end) pos prompt))
      (bshell-line-spans text (+ end 1) prompt (if (nil? sp) acc (cons sp acc))))))

(sig bshell-input-span (string -> (or nil (tuple int string))))
(defn- bshell-input-span (text)
  "`[start substring]` of the current input — everything after the last prompt in `text`
— or nil when no prompt is present. Lets the Brood services (highlight / bracket-match /
eldoc) act on just the form you're typing, not the plain-text output."
  (let (prompt (bshell-detect-prompt text))
    (if (= prompt "")
      nil
      (let (pi (string/last-index-of text prompt))
        (if (< pi 0)
          nil
          (let (start (+ pi (string/length prompt)))
            [start (string/substring text start (string/length text))]))))))

(sig bshell-input-form? ((or nil (tuple int string)) -> bool))
(defn- bshell-input-form? (isp)
  "Whether the `[start substring]` input is a Brood form (worth lexing/eldoc/bracket-match)."
  (if isp (string/starts-with? (string/triml (second isp)) "(") false))

(defn- bshell-input-spans (text)
  "Brood syntax spans for the input region, in buffer coordinates, when the input is a
`(`-form; else `()`. Sits after every prompt/error line span, so the combined list stays
ascending + non-overlapping."
  (let (isp (bshell-input-span text))
    (if (and isp (bshell-input-form? isp))
      (shift-spans (highlight-spans (second isp)) (first isp))
      ())))

(defn bshell-fontify (text)
  "The bshell `:fontify` service: colour each prompt line's prompt prefix and any
`[exit N]` / `error:` line, plus **Brood syntax** for the input form you're typing. Spans
are ascending + non-overlapping (the highlight-spans shape)."
  (append (bshell-line-spans text 0 (bshell-detect-prompt text) '()) (bshell-input-spans text)))

(sig bshell-bracket-match (string int -> any))
(defn bshell-bracket-match (full pos)
  "The bshell `:bracket-match` service: match the bracket adjacent to `pos`, scoped to the
input form (buffer coordinates), so output brackets never match. Nil outside the input."
  (let (isp (bshell-input-span full))
    (if (and isp (>= pos (first isp)) (bshell-input-form? isp))
      (let (start (first isp)
            r (bracket-match (second isp) (- pos start)))
        (cond
          (nil? r) nil
          (= (second r) :unmatched) [(+ (first r) start) :unmatched]
          else [(+ (first r) start) (+ (second r) start)]))
      nil)))

(sig bshell-eldoc (string int -> any))
(defn bshell-eldoc (text pos)
  "The bshell `:eldoc` service: the signature of the call enclosing `pos` within the input
form (reusing brood-mode's eldoc), or nil when point isn't in a form's input."
  (let (isp (bshell-input-span text))
    (if (and isp (>= pos (first isp)) (bshell-input-form? isp))
      (brood-mode/brood-eldoc (second isp) (- pos (first isp)))
      nil)))

;; ---- input-region boundary (the prompt + output are not editable) -----------
;; In a shell you can't backspace into the prompt or move left of it. These wrap the
;; ordinary editing commands so motion/deletion stops at the buffer's `:input-start`;
;; point in the output *above* the input line stays free (so you can read/select it).

(defn- bshell-cur-istart (m)
  "The current buffer's input start — `input-region`'s, clamped into the buffer."
  (first (input-region (ed-current-buf m))))

(defcommand cmd-bshell-beginning-of-input
  (m key)
  "C-a / Home: jump to the start of the input (just after the prompt) on the input line;
elsewhere (point up in the output) a normal beginning-of-line."
  (let (b (ed-current-buf m)
        start (bshell-cur-istart m))
    (if (>= (buffer-point b) start)
      (ed-set-buf m (goto-char b start))
      (cmd-beginning-of-line m key))))

(defcommand cmd-bshell-backward-char
  (m key)
  "C-b / Left: never cross left into the prompt — a no-op exactly at the input start; a
normal backward-char otherwise (within the input, or freely within the output above)."
  (if (= (buffer-point (ed-current-buf m)) (bshell-cur-istart m))
    m
    (cmd-backward-char m key)))

(defcommand cmd-bshell-delete-backward
  (m key)
  "Backspace: never delete into the prompt or the read-only output — a no-op at or before
the input start; a normal backward delete within the input."
  (if (<= (buffer-point (ed-current-buf m)) (bshell-cur-istart m))
    m
    (cmd-delete-backward m key)))

(defn- bshell-input-line-start (text istart)
  "The offset of the start of the line that holds the input region (the char after the
last newline before `istart`)."
  (let (nl (string/last-index-of (string/substring text 0 istart) "\n"))
    (if (< nl 0) 0 (+ nl 1))))

(defn bshell-enforce-boundary (m)
  "Pull point out of the prompt if it landed there — `formbuf/guard-clamp` over the
one editable region a shell buffer has (`formbuf/tail-region` from the input start:
everything after the prompt is yours). The `:clamp` policy rather than `:veto`
because a shell's generated part is legitimately navigable — you scroll and select
output freely; only *typing* position is constrained. A no-op in any other buffer."
  (let (b (ed-current-buf m))
    (if (not (input-region? b))
      m
      (let (istart (first (input-region b))
            line-start (bshell-input-line-start (buffer-text b) istart))
        ;; Only the prompt PORTION of the input line is out of bounds: point in the
        ;; output above it stays put, so the scrollback keeps its own cursor.
        (if (and (< (buffer-point b) istart) (>= (buffer-point b) line-start))
          (formbuf/guard-clamp m
            (fn (mm) (buffer-text (ed-current-buf mm)))
            (fn (mm) (buffer-point (ed-current-buf mm)))
            (fn (mm p) (ed-set-buf mm (goto-char (ed-current-buf mm) p)))
            (fn (text) (formbuf/tail-region text istart)))
          m)))))

(defn bshell-post-key (m-before m key)
  "The bshell layer's `:post-key` guard (layers §7): repair, don't veto — point is
clamped out of the prompt rather than the keystroke undone, so `m-before` is unused."
  (bshell-enforce-boundary m))

;; ---- command history (↑/↓ recall, like the Brood REPL; per buffer) ----------

(defn- bshell-history (m)
  "The current bshell buffer's submitted-line history (oldest first)."
  (or (:bshell-history (ed-current-buf m)) []))

(defn- bshell-cur-set (m k v)
  "The model with field `k`=`v` set on the *current* buffer."
  (ed-set-buf m (assoc (ed-current-buf m) k v)))

(defn remember-input (m line)
  "Record submitted `line` in the current buffer's in-memory history (skipping an immediate
duplicate) and reset that buffer's browse cursor — so the next ↑ starts from the newest.
Nothing is persisted: a line-mode terminal (iex, nest repl) keeps its own history this
way, out of the SHELL's history file."
  (let (h (bshell-history m)
        n (count h)
        h2 (if (and (> n 0) (= (nth h (dec n)) line)) h (into h [line])))
    (ed-set-buf m
      (assoc (ed-current-buf m) :bshell-history h2 :bshell-hist-idx nil :bshell-draft nil))))

(defn bshell-remember (m line)
  "Record submitted shell `line` in the current buffer's history (`remember-input`) and
persist that history to the shell's history file."
  (let (remembered (remember-input m line))
    (bshell-save-history (bshell-history remembered))
    remembered))

(defn input-region (b)
  "`[start end]` of buffer `b`'s input region — CLAMPED into the buffer. A kill that
reached above `:input-start` (click up into the scrollback, then C-k: the layers bind
Backspace, not every kill) leaves the field past the end of the rope, and indexing off it
would throw. With no `:input-start` the region is empty, at the end. While a shell's
command runs the region starts at its PROCESS MARK instead (`process-mark-at`), as
comint's does: the line it was started with is sent, and what is typed now is input for
later. The one reader of the field, for the shell and a line-mode terminal alike."
  (let (end (buffer-length b)
        mark (process-mark-at b)
        start (if (and (:bshell-running b) (int? mark)) mark (:input-start b)))
    [(math/min (or start end) end) end]))
(sig input-region (buffer -> (tuple int int)))

(defn input-text (b)
  "The text of buffer `b`'s input region (from the clamped input start to the end)."
  (let ([start end] (input-region b)) (string/substring (buffer-text b) start end)))
(sig input-text (buffer -> string))

(defn- bshell-set-input (m s)
  "Replace the input region of the current buffer with `s`, point at the end."
  (let (b (ed-current-buf m)
        [start end] (input-region b))
    (ed-set-buf m (end-of-buffer (replace-region b start end s)))))

(defn- bshell-in-output? (m)
  "Whether point is above the input line (in the read-only output) — where ↑/↓ should move
by line to read output, not browse history."
  (let (b (ed-current-buf m))
    (< (buffer-point b) (bshell-input-line-start (buffer-text b) (bshell-cur-istart m)))))

(defn- bshell-input-text (m)
  "The current input region's text (from the input start to the buffer end)."
  (input-text (ed-current-buf m)))

(defn- bshell-line-nav? (m)
  "Whether ↑/↓ should move by line instead of browsing history: point is in the output
above, or the input is a multi-line form mid-edit (so the arrows navigate the form)."
  (or (bshell-in-output? m) (includes? (bshell-input-text m) "\n")))

(defcommand cmd-bshell-previous-history
  (m key)
  "↑ / C-p: recall the previous command from this buffer's history into the input (browsing
the live input as the slot past the newest). Above the input line, an ordinary move-up."
  (if (bshell-line-nav? m)
    (cmd-previous-line m key)
    (let (h (bshell-history m)
          n (count h))
      (if (= n 0)
        m
        (let (b (ed-current-buf m)
              idx (:bshell-hist-idx b)
              draft (if (nil? idx) (input-text b) (:bshell-draft b))
              new-idx (if (nil? idx) (dec n) (math/max 0 (dec idx))))
          (bshell-set-input (bshell-cur-set (bshell-cur-set m :bshell-hist-idx new-idx)
                              :bshell-draft draft)
            (nth h new-idx)))))))

(defcommand cmd-bshell-next-history
  (m key)
  "↓ / C-n: recall the next command, or restore the live input once you step past the
newest. Above the input line, an ordinary move-down."
  (if (bshell-line-nav? m)
    (cmd-next-line m key)
    (let (b (ed-current-buf m)
          h (bshell-history m)
          n (count h)
          idx (:bshell-hist-idx b))
      (if (nil? idx)
        m
        (let (new-idx (+ idx 1))
          (if (>= new-idx n)
            (bshell-set-input (bshell-cur-set m :bshell-hist-idx nil) (or (:bshell-draft b) ""))
            (bshell-set-input (bshell-cur-set m :bshell-hist-idx new-idx) (nth h new-idx))))))))

(defcommand cmd-bshell-history-search
  (m key)
  "C-r: search this buffer's command history — a filterable minibuffer list (newest first);
the chosen entry replaces the current input. Reverse-i-search, the editor-idiomatic way."
  (let (h (reverse (bshell-history m)))
    ; newest first
    (if (empty? h)
      (message m "bshell: no history yet")
      (assoc m
        :minibuffer (ed-name-prompt "History: " h (fn (mm t) (bshell-set-input mm t)) 15)))))

;; ---- completion: filenames for a shell command, Brood globals for a form ----

(sig bshell-token-start (string int -> int))
(defn- bshell-token-start (text p)
  "The start of the whitespace-delimited token ending at offset `p`."
  (if (or (<= p 0) (includes? " \t" (string/char-at text (dec p))))
    p
    (bshell-token-start text (dec p))))

(defn- bshell-path-candidates (tok cwd)
  "Filename completions for shell token `tok` resolved against `cwd`: the entries of the
directory it references whose name starts with the token's last segment, directories
suffixed `/`. `()` on any error. Dir-ness is the cheap `dir?` stat, not a full `list-dir`."
  (let (slash (string/last-index-of tok "/")
        sub (if (< slash 0) "" (string/substring tok 0 (+ slash 1))) ; the dir part, incl trailing /
        partial (if (< slash 0) tok (string/substring tok (+ slash 1) (string/length tok)))
        dir (if (= sub "") cwd (path/absolute sub cwd)))
    ;; `dir` is the half-typed prefix of a path — an unlistable one simply has no candidates
    (check-allow :discarded-catch
      (try
        (map (seq/filter (file/ls dir) (fn (e) (string/starts-with? e partial)))
          (fn (e) (str sub e (if (file/dir? (path/join dir e)) "/" ""))))
        (catch e ())))))

(defn bshell-complete-source (m)
  "The bshell completion source (a `complete-at-point/*completion-sources*` entry): inside a bshell
buffer's input region, complete the token before point — **Brood globals** for a `(`-form
line (the REPL), else **filenames** under that shell's directory. `nil` in any other buffer
(and above the input line), so it's inert everywhere else."
  (let (buf (ed-current-buf m))
    (if (not (bshell-buffer? buf))
      nil
      (let (text (buffer-text buf)
            p (buffer-point buf)
            istart (first (input-region buf)))
        (if (< p istart)
          nil
          (if (string/starts-with? (string/triml (string/substring text istart p)) "(")
            (brood-mode/brood-complete-at text p) ; REPL: live Brood globals
            (let (start (math/max istart (bshell-token-start text p))
                  tok (string/substring text start p))
              [start tok (bshell-path-candidates tok (or (:dir buf) "."))])))))))

;; ---- the commands -----------------------------------------------------------

(defn- bshell-start (m root)
  "Open this project's shell: a fresh `*bshell: <root>*` buffer (mode `:bshell`, so RET runs
the command) with its prompt, its shell process rooted at `root`, and all its state recorded
**on the buffer** — so each project's shell is independent."
  (let (nm (bshell-buffer-name root)
        prompt (bshell-prompt root)
        raw (end-of-buffer (insert (make-buffer "" nm) prompt))
        typed (editor/layers/set-buffer-type raw :bshell)
        pid (bshell-connect nm root)
        buf (assoc typed
              :dir root ; the generic per-buffer default-directory = this shell's project root
              :bshell-proc pid
              :bshell-running false
              :input-start (string/length prompt)
              :bshell-history (bshell-load-history)
              :bshell-hist-idx nil
              :bshell-draft nil))
    (ed-open-buffer m buf)))

(defcommand cmd-project-bshell
  (m key)
  "Open a shell for the current project (C-x p e): its own `*bshell: <project>*` buffer
running commands / Brood forms in the project root. Re-running switches to *this* project's
shell (each project has its own — like Emacs `project-eshell`). Reports when not in a project."
  (let (root (ed-project-root m))
    (if (nil? root)
      (message m "not in a project (no project.blsp found)")
      (let (nm (bshell-buffer-name root)
            idx (ed-buffer-index-by-name m nm))
        (if (nil? idx)
          (bshell-start m root)
          (ed-select m idx))))))

(defcommand cmd-bshell-send
  (m key)
  "RET in a bshell buffer: run the current input (everything from the prompt to the buffer's
end) in *this* buffer's shell. An empty line emits a fresh prompt; an **incomplete Brood
form** inserts a newline so you keep typing it (REPL-style multi-line); otherwise the input
is sent to this shell's process. Ignored in a non-bshell buffer or while a command is running
— unless that command waits at a password prompt, which RET then reads, masked —
holding what was typed since the prompt appeared, moved out of the buffer."
  (let (b (ed-current-buf m))
    (cond
      (not (bshell-buffer? b)) m
      (and (:bshell-running b) (:bshell-secret b)) (bshell-read-secret m (buffer-name b) "")
      (:bshell-running b) m
      else
        (let (nm (buffer-name b)
              line (string/trimr (input-text b)))
          (cond
            (string/blank? line) (bshell-emit-prompt m nm (bshell-prompt-for m nm))
            ;; an unclosed Brood form → newline at point, keep editing (don't submit)
            (not (bshell-complete-input? line)) (ed-set-buf m (insert b "\n"))
            else
              (let (m1 (bshell-remember m line))
                ; ↑/↓ recall it later (this buffer)
                (send (:bshell-proc b) [:bshell-run line])
                (ed-update-named (bshell-append m1 nm "\n")
                  nm
                  ;; the process mark starts after the command line: its output goes there
                  (fn (buf)
                    (with-process-mark (assoc buf :bshell-running true :bshell-command line)
                      (buffer-length buf))))))))))

;; Turn the completion source on: highest precedence, but inert outside a bshell buffer.
(complete-add-source! 'bshell/bshell-complete-source)

(defcommand cmd-bshell-interrupt
  (m key)
  "C-c C-c in a bshell buffer: interrupt the running command, as Ctrl-C does in a terminal —
the signal reaches the command and everything it started (`sleep`, `make` and its
compilers), and its exit is reported as usual. Says so when nothing is running."
  (let (b (ed-current-buf m))
    (cond
      (not (bshell-buffer? b)) m
      (not (and (:bshell-running b) (:bshell-proc b))) (message m "no command running")
      else (do (bshell-interrupt (:bshell-proc b)) (message m "interrupted")))))

;; bshell-mode: the project shell + Brood REPL (`C-x p e`, see src/bshell.blsp), stacked
;; on text-mode. RET runs the current input line; Tab completes (filenames for a command,
;; Brood globals for a `(`-form — `bshell/bshell-complete-source`); `:fontify` colours the
;; prompt + error lines. C-a/Home, C-b/Left and Backspace are wrapped so editing can't
;; cross left of the prompt into the read-only prompt/output. Everything else (self-insert,
;; other motion/kill) falls through to text-mode + the global profile.
(def bshell-mode-layer
  {:name 'bshell
   :doc "A shell / REPL buffer: input at the prompt, history on the arrows."
   :keymap (-> {}
             (keymap-bind [:enter] 'bshell/cmd-bshell-send)
             (keymap-bind [:tab] 'complete-at-point/cmd-complete)
             (keymap-bind [:ctrl-a] 'bshell/cmd-bshell-beginning-of-input)
             (keymap-bind [:home] 'bshell/cmd-bshell-beginning-of-input)
             (keymap-bind [:ctrl-b] 'bshell/cmd-bshell-backward-char)
             (keymap-bind [:left] 'bshell/cmd-bshell-backward-char)
             (keymap-bind [:backspace] 'bshell/cmd-bshell-delete-backward)
             ;; ↑/↓ (and C-p/C-n) recall command history, like the Brood REPL
             (keymap-bind [:up] 'bshell/cmd-bshell-previous-history)
             (keymap-bind [:ctrl-p] 'bshell/cmd-bshell-previous-history)
             (keymap-bind [:down] 'bshell/cmd-bshell-next-history)
             (keymap-bind [:ctrl-n] 'bshell/cmd-bshell-next-history)
             ;; C-r searches command history (a filterable minibuffer list)
             (keymap-bind [:ctrl-r] 'bshell/cmd-bshell-history-search)
             ;; C-c C-c interrupts the running command (comint-interrupt-subjob)
             (keymap-bind [:ctrl-c :ctrl-c] 'bshell/cmd-bshell-interrupt))
   ;; Brood services scoped to the input form: syntax colours, bracket matching, eldoc hints
   :fontify 'bshell/bshell-fontify
   :bracket-match 'bshell/bshell-bracket-match
   :eldoc 'bshell/bshell-eldoc
   ;; after every key, keep point out of the read-only prompt (layers §7)
   :post-key 'bshell/bshell-post-key
   ;; killing the buffer stops the shell worker + its child (layers :on-close)
   :hooks {:on-close '(bshell/bshell-on-close)}})
(register-type-layers :bshell (list 'bshell/bshell-mode-layer 'modes/text-mode-layer))
