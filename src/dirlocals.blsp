(defmodule dirlocals
  "Directory-local settings (Emacs's `.dir-locals.el`): a `.bedit-locals.blsp` in a project
directory sets init.blsp settings for the files under it, per mode as init.blsp does —

    (dir-locals
      :indent-width {python 4 :default 2}
      :fill-column 100)

DATA, read with std's `settings/read-file` and never evaluated: a project you cloned cannot
run code by being opened. The NEAREST file above a visited file is the one that applies, as
in Emacs. And only a setting declared SAFE (`:safe true` on its `settings/define`, Emacs's
`safe-local-variable`) is taken from it — the layout conventions and the display switches,
never a key binding, a command or a path. Anything else is refused and the refusal said
(the visit's note, so *Messages* keeps it), as is a value its type rejects.

What a file gives a buffer is kept on it as `:dir-locals` when the file is visited (a visit
step, `:passing`, so a file a jump opens has them too); `conventions` resolves them under the
buffer's own values and its `.editorconfig` and over init.blsp's (`conventions/dir-local`),
and `C-h v` and `M-x describe-indentation` say when a value came from one."
  (:use model :only [register-visit-step])) ; the visit stamps the buffer

(def *file-name* ".bedit-locals.blsp")
(def- *head* 'dir-locals) ; the file's one form, `(dir-locals :key value …)`
(def- *settings-id* :bedit/settings) ; `config/*settings*`, named here so `config` need not load

(defn file-for (file &optional (exists? file/exists?))
  "The directory-locals file that applies to `file` (an absolute path): the nearest
`.bedit-locals.blsp` in its directory or one above it, or nil when there is none.
`exists?` asks whether a path is there (a test hands its own).

    (dirlocals/file-for \"/p/src/a.py\" (fn (path) (= path \"/p/.bedit-locals.blsp\")))   ;=> \"/p/.bedit-locals.blsp\""
  (letrec (walk (fn (dir)
                  (let (candidate (path/join dir *file-name*)
                        parent (path/dirname dir))
                    (cond
                      (exists? candidate) candidate
                      (or (= parent dir) (= parent "")) nil
                      else (walk parent)))))
    ;; a file on another machine (`/ssh:…`) is under no local directory
    (if (sshpath/remote? file) nil (walk (path/dirname file)))))

(defn safe? (name)
  "True when init.blsp setting `name` may be set from a directory file: declared with
`:safe true`."
  (let (spec (settings/spec-of *settings-id* name)) (and (map? spec) (= true (:safe spec)))))

(defn sift (entries origin)
  "`[settings refusals]` for the `entries` a directory file at `origin` gives: the safe,
valid ones as a map, and a line for each other — a setting no one declared, one not safe
from a directory, a value its type rejects.

    (second (dirlocals/sift {:no-such-thing 1} \"/p/.bedit-locals.blsp\"))   ;=> [\"/p/.bedit-locals.blsp: :no-such-thing is no setting; ignored\"]"
  (fold (seq/sort-by (vec entries) (fn ([key _]) (->string key)))
    [{} []]
    (fn ([kept refused] [name value])
      (let (spec (settings/spec-of *settings-id* name)
            problem (cond
                      (not (map? spec)) "is no setting"
                      (not (= true (:safe spec))) "is not safe to set from a directory file"
                      (not (settings/valid? spec value))
                        (str "wants " (settings/want-text spec) ", not " (pr-str value))
                      else nil))
        (if problem
          [kept (conj refused (str origin ": " (pr-str name) " " problem "; ignored"))]
          [(assoc kept name value) refused])))))

(defn read-for (file &optional (exists? file/exists?) (read settings/read-file))
  "`{:file :settings :refused}` for the visited `file`: the directory file that applies, the
settings it gives (`sift`) and what it refused; nil when no directory file applies. `read`
reads a file's `(dir-locals …)` form as a map (`settings/read-file`; a test hands its own)."
  (let (origin (file-for file exists?))
    (when (string? origin)
      (let ([kept refused] (sift (or (read origin *head*) {}) origin))
        {:file origin :settings kept :refused refused}))))

(defn stamp (buffer)
  "`[buffer note]`: `buffer` with `:dir-locals` (the settings its directory file gives) and
`:dir-locals-file` when one applies to its file, and the note saying what was refused, or
nil. A buffer that has them already, or visits no file, is left as it is."
  (let (file (get buffer :file))
    (if (or (not (string? file)) (contains? buffer :dir-locals))
      [buffer nil]
      (let (found (read-for (path/absolute file)))
        (if (nil? found)
          [buffer nil]
          [(assoc buffer :dir-locals (:settings found) :dir-locals-file (:file found))
            (when (not (empty? (:refused found))) (string/join (:refused found) " · "))])))))

(defn ed-dir-locals-visited (m buffer)
  "The visit step: `buffer` stamped with its directory-local settings ([[stamp]])."
  (stamp buffer))

(register-visit-step :dir-locals {:order 5 :run 'dirlocals/ed-dir-locals-visited :passing true})
