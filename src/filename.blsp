(defmodule filename
  "The file name typed into the minibuffer, read the way Emacs reads one
(`read-file-name`, `substitute-in-file-name`, `file-name-shadow-mode`). The one place every
path prompt turns its text into a file — `pool/ed-path-prompt` over the disk (find-file,
write-file, dired, insert-file, a mail attachment's save) and `pool/ed-path-list-prompt`
over a list of paths (recent files, C-x p p, git init / clone) — so each of them reads `~`,
`$HOME` and a restarted path the same way.

- The prompt SHOWS the home as `~` (`path/abbreviate`): `~/src/whk/`, not
  `/home/you/src/whk/`.
- A path can be RESTARTED without clearing the line: type `/`, `~/` or `~user/` after a
  slash and everything before it no longer counts. `~/src/whk//etc/` is `/etc/`, `/usr/lib/~/notes`
  is `~/notes`. The part that no longer counts is painted dim (`shadow-end`) until Tab
  completes the new path and drops it. A `~name` restarts only when it is a home and not a
  file there: a real `/tmp/~root` stays a file.
- `$VAR` and `${VAR}` are the environment's (`$$` is a literal `$`); an unset one is left
  as typed. A name from the disk goes on the line escaped (`path/escape-env`), so a file called `a$b` is not
  read as a variable.
- A relative name is read under the directory the prompt opened in (Emacs's
  `default-directory`), not the editor's working directory.

Reading the text is std's `path/substitute` (`$VAR`, `//`, `/~/` — Emacs's rule); what is
the prompt's is here: the directory a relative name is read under, the disk check that keeps
a real file called `~root` a file, and the spelling a path is shown in.")

(defn- file-in-directory? (base)
  "`path/substitute`'s `keep?` for a prompt opened in `base`: a `~name` component is a FILE,
not a home, when the directory before it has an entry by that name."
  (fn (directory component) (file/exists? (str (absolute directory base) component))))

(defn shadow-end (text &optional base)
  "Where the part of `text` that still counts begins — 0 when all of it does. Everything
before it was overridden by a later `//` or `/~/` and is painted as a shadow. `base` is the
directory a relative `text` is read under (it decides whether a `~name` there is a file).

    (filename/shadow-end \"~/src//etc/\")   → 6
    (filename/shadow-end \"~/src/\")        → 0"
  (path/substitute-start text (file-in-directory? base)))
(sig shadow-end (string &optional (or string nil) -> int))

(defn substitute (text &optional base)
  "The file name `text` means, still spelled as typed (a `~` stays a `~`): `path/substitute`
read under `base`, as in [[shadow-end]].

    (filename/substitute \"~/src//etc/hosts\")   → \"/etc/hosts\"
    (filename/substitute \"/tmp/$$x\")           → \"/tmp/$x\""
  (path/substitute text (file-in-directory? base)))
(sig substitute (string &optional (or string nil) -> string))

(defn expand (text &optional base)
  "The absolute file `text` names: `substitute`d, then `~` expanded and a relative name
made absolute under `base` — the directory the prompt was opened in, as Emacs reads a
relative name against `default-directory` (else the working dir). A trailing `/` is kept, so
a directory still reads as one; a blank line stays as it is, so a prompt can still tell
nothing was typed.

    (filename/expand \"/srv//etc/\")      → \"/etc/\"
    (filename/expand \"notes\" \"/srv\")    → \"/srv/notes\""
  (if (string/blank? text) text (absolute (substitute text base) base)))
(sig expand (string &optional (or string nil) -> string))

(defn absolute (path base)
  "`path` made absolute (`path/absolute`: `~` expanded) with a relative one under `base` —
the working dir when `base` is nil. `path` is taken literally: no `$` or `//` is read.

    (filename/absolute \"a\" \"/srv\")   → \"/srv/a\""
  (if (nil? base) (path/absolute path) (path/absolute path base)))
(sig absolute (string (or string nil) -> string))

(defn unescape (text)
  "The name an escaped (`path/escape-env`) `text` spells — `$$` read back as `$` — for SHOWING a candidate
(its label), where nothing is going to be read as a variable.

    (filename/unescape \"a$$b\")   → \"a$b\""
  (string/replace text "$$" "$"))
(sig unescape (string -> string))

(defn as-input (path)
  "`path` the way a prompt shows it, and is prefilled with it — the inverse of [[expand]]:
the home as `~` (`path/abbreviate`), a doubled slash collapsed (it would restart the path)
and escaped (`path/escape-env`), so expanding the line gives `path` back.

    (filename/as-input \"/srv//a$b/\")   → \"/srv/a$$b/\""
  (path/escape-env (regex/replace "/{2,}" (path/abbreviate path) "/")))
(sig as-input (string -> string))
