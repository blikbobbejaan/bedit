(defmodule gitpick
  "Asking for one thing — a remote, a ref, a commit, a name, a start point — in a
completing prompt, the one at point offered first. Every git command that needs a noun
asks through `git-prompt`, so they all refuse an empty answer, or a buffer outside a repo,
the same way."
  (:use model) ; message
  (:use pool) ; ed-name-prompt
  (:use gitcore) ; git-resolve-root / git-remotes / git-refs / git-first
  (:use gitsection)) ; git-ref-at-point / git-commit-at-point / git-log-commits

;; ---- asking for one thing: a remote, a stash, a ref, a commit, a name ----------

(defn git-prompt (m options)
  "Ask for one thing in a completing prompt and hand it, trimmed, to `(then model answer)`.
Every `git-with-…` below is this sentence with different nouns — resolve the repo, list
the candidates, offer the one at point first, refuse an empty answer — and seven copies of
it had drifted into seven slightly different refusals. `options`:

- `:prompt` — the prompt text
- `:candidates` — `(root) -> names`. With it, the repo is resolved first and a buffer
  outside one is told so; without it the prompt completes over nothing and needs no repo
  (a NEW name)
- `:here` — `(root) -> name-or-nil`, the candidate at point, offered first
- `:none` — what to say when there are no candidates at all, instead of prompting
- `:blank` — what to say to an empty answer
- `:blank-takes-here?` — an empty answer takes `:here` instead, when there is one
- `:then` — `(model answer) -> model`"
  (let ({:keys [prompt candidates here none]} options
        root (if (nil? candidates) nil (git-resolve-root m)))
    (if (and candidates (nil? root))
      (message m "not in a git repository")
      (let (names (if (nil? candidates) '() (candidates root))
            at-point (if (nil? here) nil (here root)))
        (if (and none (empty? names))
          (message m none)
          (assoc m
            :minibuffer
              (pool/ed-name-prompt prompt
                (git-first at-point names)
                (git-prompt-answer options at-point))))))))

(defn- git-prompt-answer (options at-point)
  "What `git-prompt` does with the answer: a non-blank one, trimmed, goes to `:then`; a
blank one takes `at-point` when `:blank-takes-here?` says so, else is refused with `:blank`."
  (let ({:keys [blank blank-takes-here? then]} options)
    (fn (m text)
      (let (chosen (string/trim text))
        (cond
          (not (= chosen "")) (then m chosen)
          (and blank-takes-here? at-point) (then m at-point)
          :else (message m blank))))))

(defn git-with-remote (m prompt then)
  "Prompt for one of the repo's remotes (`origin` first) and hand it to `then`."
  (git-prompt m
    {:prompt prompt
     :candidates git-remotes
     :none "this repository has no remotes — M a adds one"
     :blank "no remote chosen"
     :then then}))

(defn git-with-start (m prompt then)
  "Prompt for a starting point — the commit or ref at point first, else the current branch."
  (git-prompt m
    {:prompt prompt
     :candidates (fn (root) (git-refs root :branches))
     :here (fn (root) (or (git-commit-at-point m) (git-current-branch root) "HEAD"))
     :blank-takes-here? true
     :then then}))

(defn git-with-name (m prompt then)
  "Prompt for a new name and hand it to `then`, refusing an empty one."
  (git-prompt m {:prompt prompt :blank "a name is needed" :then then}))

(defn git-with-range (m prompt suffix then)
  "Prompt for a revision range (`main..feature`, `HEAD~3..`) and hand it to `then`. The
branches complete, each followed by `suffix` — `..` where a range open at the end is what
is usually meant."
  (git-prompt m
    {:prompt prompt
     :candidates (fn (root) (map (git-refs root :branches) (fn (b) (str b suffix))))
     :blank "no range"
     :then then}))

;; ---- picking a ref, and the shape every new command shares -------------------
;; Six of the commands are the same sentence: "pick a ref, run a subcommand with the menu's
;; flags and that ref, refresh". Written out six times that is six chances to forget the
;; flags, the refresh, or the not-a-repo case — `cmd-git-checkout` (`gitrefs`) is the
;; hand-written version, kept because checkout is the one that reports differently.

(defn git-with-ref (m prompt kind then)
  "Prompt for a ref of `kind` (completing over what the repo has) and hand it to `then`
(`(model ref) -> model`). The refs are read on the loop, which is the one thing here that
costs a subprocess — acceptable, because the prompt cannot be shown before they are known."
  (git-prompt m
    {:prompt prompt
     :candidates (fn (root) (git-refs root kind))
     ;; the ref at point first: RET on the branch you are looking at takes it
     :here (fn (_root) (git-ref-at-point m))
     :blank "nothing chosen"
     :then then}))

(defn git-pick-commit (m prompt then)
  "Prompt for a commit, defaulting to the one under point in *git-status*, and hand it to
`then`. The recent commits complete, so picking one off the log is a keystroke."
  (let (here (git-commit-at-point m))
    (git-prompt m
      {:prompt (str prompt (if here (str "(" here ") ") ""))
       :candidates (fn (root) (map (git-log-commits root ["-30"]) :hash))
       :here (fn (_root) here)
       :blank-takes-here? true
       :blank "no commit chosen"
       :then then})))

(defn git-on-commit (m prompt verb argv-of &optional (question nil))
  "Pick a commit (`git-pick-commit`) and run `(argv-of commit)` as `verb` — after asking
`(question commit)` first, when there is a question. The whole of every reset, cherry-pick
and revert command, which differ only in their argv and in whether they can destroy work."
  (git-pick-commit m
    prompt
    (fn (mm commit)
      (let (run (fn (answered) (git-do answered verb (argv-of commit))))
        (if (nil? question) (run mm) (vcproc/vc-confirm mm (question commit) run))))))
