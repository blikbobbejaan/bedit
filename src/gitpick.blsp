(defmodule gitpick
  "Asking for one thing — a remote, a ref, a commit, a name, a start point — in a
completing prompt, the one at point offered first. Every git command that needs a noun
asks through `git-prompt`, so they all refuse an empty answer, or a buffer outside a repo,
the same way."
  (:use minibuffer)
  (:use model) ; message
  (:use pool) ; ed-name-prompt
  (:use gitcore) ; git-resolve-root / git-remotes / git-refs / git-first
  (:use gitsection)) ; git-ref-at-point / git-commit-at-point / git-log-commits

;; ---- asking for one thing: a remote, a stash, a ref, a commit, a name ----------

(defn git-prompt (m options)
  "Ask for one thing in a completing prompt and hand it, trimmed, to `(then model answer)`.
Every `git-with-…` below is this sentence with different nouns — resolve the repo, list
the candidates, offer the one at point first, refuse an empty answer — so they all refuse
alike. `options`:

- `:prompt` — the prompt text
- `:candidates` — `(root) -> names`. With it, the repo is resolved first and a buffer
  outside one is told so; without it the prompt completes over nothing and needs no repo
  (a NEW name)
- `:here` — `(root) -> name-or-nil`, the candidate at point, offered first
- `:seed` — the candidate at point as far as it is known WITHOUT git (a ref or commit at
  point): offered, and taken by a blank RET, from the moment the prompt opens
- `:none` — what to say when there are no candidates at all, instead of prompting
- `:blank` — what to say to an empty answer
- `:blank-takes-here?` — an empty answer takes `:here` instead, when there is one
- `:then` — `(model answer) -> model`

The candidates are git's to give (`for-each-ref`, `stash list`, `log`), so they are read OFF
the loop (`git-gather`, behind any working-tree command still queued) and the prompt opens
AT ONCE, filling in when they land: what you type meanwhile goes into the prompt rather than
into the buffer under it as commands, and RET on a typed name does not wait for the list.
`:candidates` and `:here` run in that task, so they close over plain data only — a `:here`
that reads the model reads it first, outside the closure."
  (let ({:keys [candidates here seed]} options
        ;; the repo the answer acts on — resolved NOW (a disk read), and pinned for the answer
        root (git-resolve-root m))
    (cond
      (and candidates (nil? root)) (message m "not in a git repository")
      (nil? candidates)
        (assoc m :minibuffer (git-prompt-spec options '() (if (nil? here) seed (here nil)) root))
      else
        (let (token (inc (or (:git-prompt-seq m) 0))
              ;; what is known without git — the commit or ref at point — is the default
              ;; from the first keystroke: RET before the list lands takes it
              opened (assoc m
                       :git-prompt-seq token
                       :minibuffer
                         (assoc (git-prompt-spec options '() seed root) :git-prompt-token token)))
          (git-gather opened
            "refs"
            root
            (fn (dir) {:names (candidates dir) :here (if (nil? here) nil (here dir))})
            (fn (mm answer) (git-prompt-fill mm options token answer root)))))))

(defn- git-prompt-spec (options names at-point root)
  "The minibuffer of a `git-prompt` completing over `names`, `at-point` first; its answer
runs in `root` (`vcsproc/vcs-pinned`), whatever buffer is current when it is given."
  (pool/ed-name-prompt (:prompt options)
    (git-first at-point names)
    (git-prompt-answer options at-point root)))

(defn- git-prompt-fill (m options token answer root)
  "Fill the prompt `token` opened with the candidates git answered (`{:names :here}`) — or,
when there are none and the caller said what that means (`:none`), close it and say so. A
prompt the reader has already answered or left (another minibuffer, or none) is not touched;
what they typed so far stays."
  (let (shown (:minibuffer m)
        names (:names answer))
    (cond
      (not (= (:git-prompt-token shown) token)) m
      (and (:none options) (empty? names))
        (message (dissoc (ed-mb-stop-ranker m) :minibuffer) (:none options))
      else
        (assoc m
          :minibuffer
            (assoc (git-prompt-spec options names (or (:here answer) (:seed options)) root)
              :edit (:edit shown)
              :git-prompt-token token)))))

(defn- git-prompt-answer (options at-point root)
  "What `git-prompt` does with the answer, in the repo `root` the prompt was asked in: a
non-blank one, trimmed, goes to `:then`; a blank one takes `at-point` when
`:blank-takes-here?` says so, else is refused with `:blank` (or a plain refusal, never
silence)."
  (let ({:keys [blank blank-takes-here? then]} options)
    (fn (m text)
      (let (chosen (string/trim text))
        (vcsproc/vcs-pinned m
          root
          (fn (mm)
            (cond
              (not (= chosen "")) (then mm chosen)
              (and blank-takes-here? at-point) (then mm at-point)
              else (message mm (or blank "nothing chosen")))))))))

(defn git-with-remote (m prompt then)
  "Prompt for one of the repo's remotes (`origin` first) and hand it to `then`."
  (git-prompt m
    {:prompt prompt
     :candidates git-remotes
     :none "this repository has no remotes — M a adds one"
     :blank "no remote chosen"
     :then then}))

(defn git-with-start (m prompt then)
  "Prompt for a starting point — the commit or ref at point first, else the current branch."
  (let (at-point (git-commit-at-point m))
    (git-prompt m
      {:prompt prompt
       :candidates (fn (root) (git-refs root :branches))
       :here (fn (root) (or at-point (git-current-branch root) "HEAD"))
       ;; before git answers: the commit at point, else HEAD — where the current branch is
       :seed (or at-point "HEAD")
       :blank-takes-here? true
       :then then})))

(defn git-with-name (m prompt then)
  "Prompt for a new name and hand it to `then`, refusing an empty one."
  (git-prompt m {:prompt prompt :blank "a name is needed" :then then}))

(defn git-with-range (m prompt suffix then)
  "Prompt for a revision range (`main..feature`, `HEAD~3..`) and hand it to `then`. The
branches complete, each followed by `suffix` — `..` where a range open at the end is what
is usually meant."
  (git-prompt m
    {:prompt prompt
     :candidates (fn (root) (map (git-refs root :branches) (fn (b) (str b suffix))))
     :blank "no range"
     :then then}))

;; ---- picking a ref, and the shape every new command shares -------------------
;; Six of the commands are the same sentence: "pick a ref, run a subcommand with the menu's
;; flags and that ref, refresh". Written out six times that is six chances to forget the
;; flags, the refresh, or the not-a-repo case — `cmd-git-checkout` (`gitrefs`) is the
;; hand-written version, kept because checkout is the one that reports differently.

(defn git-with-ref (m prompt kind then)
  "Prompt for a ref of `kind` (completing over what the repo has) and hand it to `then`
(`(model ref) -> model`). The refs are read off the loop, the prompt open meanwhile."
  (let (at-point (git-ref-at-point m))
    (git-prompt m
      {:prompt prompt
       :candidates (fn (root) (git-refs root kind))
       ;; the ref at point first: RET on the branch you are looking at takes it
       :here (fn (_root) at-point)
       :seed at-point
       :blank "nothing chosen"
       :then then})))

(defn git-pick-commit (m prompt then)
  "Prompt for a commit, defaulting to the one under point in *git-status*, and hand it to
`then`. The recent commits complete, so picking one off the log is a keystroke."
  (let (here (git-commit-at-point m))
    (git-prompt m
      {:prompt (str prompt (if here (str "(" here ") ") ""))
       :candidates (fn (root) (map (git-log-commits root ["-30"]) :hash))
       :here (fn (_root) here)
       :seed here
       :blank-takes-here? true
       :blank "no commit chosen"
       :then then})))

(defn git-on-commit (m prompt verb argv-of &optional (question nil))
  "Pick a commit (`git-pick-commit`) and run `(argv-of commit)` as `verb` — after asking
`(question commit)` first, when there is a question. The whole of every reset, cherry-pick
and revert command, which differ only in their argv and in whether they can destroy work."
  (git-pick-commit m
    prompt
    (fn (mm commit)
      (let (run (fn (answered) (git-do answered verb (argv-of commit))))
        (if (nil? question) (run mm) (vcsproc/vcs-confirm mm (question commit) run))))))
