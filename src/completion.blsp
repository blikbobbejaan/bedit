(defmodule completion
  "The editor's completion framework: **fuzzy ranking** (`std/fuzzy`) + the shared **menu
model** (the scroll window around the selection, the width clamp), used by the in-buffer
popup (`complete`, anchored at point — Corfu-style) and the minibuffer prompt
(`input`/`view`, anchored at the prompt — Vertico-style). The popup now *renders* through
the `ui-kit` widget (a windowed `ui-list` in a card — src/ui-kit.blsp), styled by the
theme's roles; this layer keeps the ranking + the window/width helpers those callers
share. The look (`*completion-max*`, `*completion-card-radius*`) is redefinable live
(ricing)."
  ;; `:exclude` — fuzzy's `filter`/`match` would shadow the prelude's, and every
  ;; call here is qualified anyway. The refer-all is kept for `rank`.
  (:use fuzzy :exclude [filter match])) ; fuzzy/filter — the one ranking seam
;; ---- look (redefine to rice the menu) ---------------------------------------
;; The popup's faces are the theme's roles (`ui-kit`); only its size and shape live here.
;; The `ls -l` permission column lives in src/fileperm.blsp — it was never ranking.

(defdyn *completion-max* 8) ; most rows shown at once
(def *completion-card-radius* 0.5) ; corner radius (cells) of the rounded GUI card

;; ---- ranking ----------------------------------------------------------------

(defn completion-rank (query items &optional (limit nil))
  "The items fuzzily matching `query`, best first (`std/fuzzy`); an empty `query`
returns them unchanged. The single seam every completer ranks through.

**Pass the `limit` you will display.** `fuzzy/top` then keeps the best `limit` in a
bounded fold and, past a few thousand candidates, shards the ranking across processes —
where ranking without one sorts every match to show twenty of them. On a 27k-file project
that is the difference between ~1.1s and ~110ms per keystroke; the result is identical
either way, so the limit is purely how much work the ranking is allowed to skip."
  (fuzzy/top query items limit))

;; ---- the vertical menu (shared geometry + rendering) ------------------------

(sig completion-menu-width (any -> int))
(defn completion-menu-width (items)
  "A column width for the menu: the widest item, clamped to [8, 40]. Public so a caller
can clamp the menu's column to the screen before rendering."
  (math/min 40 (math/max 8 (fold items 0 (fn (w s) (math/max w (string/length s)))))))

(sig completion-cell (string int -> string))
(defn- completion-cell (s w)
  "An item rendered as a menu row: ` <item padded to w> ` (one space of padding). An
item wider than `w` is shortened by keeping its **tail** behind a leading `…` (so a long
file path still shows its filename, not just the directory prefix)."
  (let (len (string/length s)
        clip (if (> len w)
               (str "…" (string/substring s (- (+ len 1) w) len)) ; … + the last (w-1) chars
               s))
    (str " " clip (string/repeat " " (- w (string/length clip))) " ")))

;; The popup card's geometry + hit-test moved to `src/ui-kit.blsp` (`ui-list` / `ui-panel` /
;; `ui-list-measure`) — one widget now renders AND hit-tests the completion popup and the
;; right-click menu alike, so no shared card-rect geometry lives here any more.

(sig completion-window-start (int int int -> int))
(defn completion-window-start (total selected vis)
  "The index of the first visible item when a `vis`-row window scrolls to keep
`selected` centred in a list of `total` items."
  (math/max 0 (math/min (- total vis) (- selected (math/quot vis 2)))))

;; The in-buffer popup card is now ONE `ui-list` in a frameless `ui-panel` (src/ui-kit.blsp,
;; via complete-at-point/complete-popup-ops) — the same widget behind the right-click menu —
;; so no popup-specific renderer lives here any more. This layer keeps only the pieces both
;; the popup and Plume still share: `completion-window-start`, `completion-menu-width`, and
;; `completion-cell`.

;; The marginalia-annotated row renderer + the N/M counter live in the Plume layer
;; (src/plume.blsp), built on `completion-cell`.
