(defmodule config-paths
  "Where the editor's own files live and who it is to the system: the application id, the
config directory (`$XDG_CONFIG_HOME`, or a scratch home under a test run) and the init
file's path. Nothing here reads a setting, so a module that only needs a path (the state
files, the package store) stands below the settings table.")

;; ---- who the editor is, to the rest of the system ---------------------------

(def *app-id*
  ;; The editor's identity outside its own window: the name of its config directory,
  ;; and the **desktop application id** every window declares (`gui-display`'s
  ;; `:app-id` — Wayland's `app_id`, X11's `WM_CLASS`). A desktop matches a window to
  ;; an installed `<app-id>.desktop` entry by this string and nothing else, so it is
  ;; what earns the window its own icon and name in the GNOME dash / alt-tab instead
  ;; of the generic fallback. It must stay in step with `assets/bedit.desktop`
  ;; (that file's basename, and its `StartupWMClass`) — see `assets/README.md`.
  "bedit")

;; ---- where the init file lives ----------------------------------------------

(defdyn *config-base* nil)
;; A config base that wins over the environment, for the one caller that must not touch the
;; user's real config: a test (no process can set its own environment variables). nil —
;; the default — means "ask the environment".

;; ---- a test run never reaches the user's config ---------------------------------
;; Every file the editor keeps — init.blsp, state/ (recent files, places, histories, the
;; slow-turn log, transient memory, a shell's history), packages/, grammars/, auto-save —
;; is under `config-dir`, which follows `$XDG_CONFIG_HOME`. The test runner points that at
;; a scratch home of the run's own (brood ADR-602), so a test that calls a command which
;; persists something (RET in a shell remembers the line — once over the user's real
;; history) writes there. `persist-write!` and `ensure-init!` also refuse a path under the
;; user's REAL config base while a test runs ([[test-forbidden-path?]]), in case one is
;; ever spelled out some other way.

(defn under-test? ()
  "Whether this process is part of a test run — the runner's own word, `BROOD_TEST_RUN`
(`test/running?`, brood ADR-602), read here without loading the test framework into the
editor."
  (= (os/env "BROOD_TEST_RUN") "1"))

(defn config-base-dir ()
  "The XDG config base: `*config-base*` when bound, else `$XDG_CONFIG_HOME` — a test run's
scratch home under the test runner — else `~/.config`."
  ;; no HOME (a bare container, a service unit): the working directory, rather than a crash
  ;; before the first frame — the config is optional and its absence is already handled
  (or *config-base* (os/env "XDG_CONFIG_HOME") (path/join (or (path/home) ".") ".config")))

(defdyn *user-config-base* nil)
;; The user's REAL config base as the test runner kept it aside, bound in place of the
;; environment's by a test of the guard below — a stand-in directory, so a guard that
;; regressed writes into the stand-in and never into the user's config. nil — the default —
;; means `BROOD_USER_CONFIG_HOME`.

(defn test-forbidden-path? (file)
  "Whether writing `file` would reach the user's REAL editor config while a test runs in a
scratch home: `file` is inside `bedit/` under the config base the runner kept aside
(`BROOD_USER_CONFIG_HOME`, or `*user-config-base*`). Both are compared normalized, so a path
spelled with `//` or `.` is caught too. A run with the real home (`--real-home`) asked for it,
and is not guarded. The writers that persist state refuse such a write."
  (let (real-base (or *user-config-base* (os/env "BROOD_USER_CONFIG_HOME")))
    (and (under-test?)
      (string? real-base)
      (string? file)
      (let (real (path/normalize (path/join real-base *app-id*))
            target (path/normalize file))
        (or (= target real) (string/starts-with? target (str real "/")))))))

(defn config-dir ()
  "The editor's config directory: `$XDG_CONFIG_HOME/bedit` or `~/.config/bedit`."
  (path/join (config-base-dir) *app-id*))

(defn init-file ()
  "Path of the user init file (`~/.config/bedit/init.blsp`)."
  (path/join (config-dir) "init.blsp"))
