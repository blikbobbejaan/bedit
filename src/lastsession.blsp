(defmodule lastsession
  "The last session in a project, reopened (Emacs's `desktop-save-mode`): quitting remembers the
project's open files and the window layout — each pane's file, its scroll and its point, and
each tab's layout the same way (src/tabbar.blsp) — and
starting in that project with no file named opens them again, as they were. One file per
project in the editor's state folder (`state/sessions/`); on with the init file's
`:restore-session` (the model's `:restore-session`), so a test never reads or writes one.

Only files are kept: a pane on a report, a shell or a scratch buffer comes back on the session's
first file. A file that has gone since is skipped, and its panes show that first file too."
  (:use editor/buffer) ; buffer-file / buffer-point / goto-char
  (:use editor/pane :only [pane-map]) ; the layout's panes, file for buffer and back
  (:use model) ; ed-buf-at / ed-current-buf / message
  (:use projects :only [editor-state-dir persist-read-value persist-write!])) ; the session files

(defn session-file (root)
  "Where the session of the project at `root` is kept: `state/sessions/NAME.blsp`, NAME the root
with every character a file name would trip on made `_`."
  (path/join (editor-state-dir) "sessions" (str (regex/replace "[^A-Za-z0-9._-]" root "_") ".blsp")))

;; ---- what a session is -------------------------------------------------------------

(defn- file-of (m index)
  ;; the file pool buffer `index` visits, or nil
  (when (and (int? index) (< index (count (:buffers m)))) (buffer-file (ed-buf-at m index))))

(defn- saved-layout (m layout)
  ;; `layout` with each pane's buffer named by its file, its scroll and its point
  (pane-map layout
    (fn (payload)
      (let (buffer (when (file-of m (:buffer payload)) (ed-buf-at m (:buffer payload))))
        {:file (file-of m (:buffer payload))
         :top (or (:top payload) 0)
         :point (or (:point payload) (when buffer (buffer-point buffer)) 0)}))))

(defn session-of (m)
  "`{:files [path …] :layout tree}` for `m`: its file buffers in pool order, and its pane tree
with each pane's buffer named by its file (`:file`, nil for a buffer with none), its scroll and
its point — nil when no buffer visits a file. With more than one tab (src/tabbar.blsp), also
`:tabs`, each `{:name :layout}` saved the same way, and `:tab-index`, the one shown."
  (let (files (into [] (seq/keep (range 0 (count (:buffers m))) (fn (index) (file-of m index))))
        tab-count (count (tabbar/tabs m)))
    (when (not (empty? files))
      (merge {:files files :layout (saved-layout m (:layout m))}
        (if (<= tab-count 1)
          {}
          {:tab-index (tabbar/current-tab m)
           :tabs (vec (map (range tab-count)
                        (fn (index)
                          {:name (:name (nth (tabbar/tabs m) index))
                           :layout (saved-layout m (tabbar/tab-layout m index))})))})))))

(defn save! (m)
  "Remember `m`'s session for the project it started in (`:session-root`, which main records)
— quitting does this, with `:restore-session` on. Returns `m`."
  (let (root (:session-root m)
        session (session-of m))
    (when (and root session (:restore-session m)) (persist-write! (session-file root) session))
    m))

;; ---- reopening it -------------------------------------------------------------------

(defn- open-files (m files)
  ;; `[model {path index}]`: every file of the session that still exists opened, in order
  (fold files
    [m {}]
    (fn ([acc indices] path)
      (if (file/exists? path)
        (let (opened (pool/ed-find-file acc path))
          [opened (assoc indices path (ed-current-index opened))])
        [acc indices]))))

(defn restore (m session)
  "`m` with `session` (as [[session-of]] gave it) opened: its files, and its layout with each
pane on its file again at its scroll and point. Unchanged when none of its files is left."
  (let ([opened indices] (open-files m (:files session)))
    (if (empty? indices)
      m
      (let (fallback (get indices (seq/find (:files session) (fn (path) (contains? indices path))))
            restored (fn (saved-tree)
                       (pane-map saved-tree
                         (fn (saved)
                           (let (index (or (get indices (:file saved)) fallback)
                                 here? (contains? indices (:file saved)))
                             (if here?
                               {:buffer index :top (:top saved) :point (:point saved)}
                               {:buffer index :top 0})))))
            tabs (:tabs session)
            tabbed (if (and (vector? tabs) (> (count tabs) 1) (int? (:tab-index session)))
                     (assoc opened
                       :tabs
                         (vec (map tabs
                                (fn (tab)
                                  (let (named (if (string? (:name tab)) {:name (:name tab)} {}))
                                    (assoc named :layout (restored (:layout tab)))))))
                       :tab-index (:tab-index session))
                     opened)
            laid-out (assoc tabbed :layout (restored (:layout session))))
        (message (ed-set-buf laid-out (ed-current-buf laid-out))
          (str "restored the last session: " (ed-count-noun (count indices) "file")))))))

(defn restore-for-start (m)
  "At startup with no file named: the last session of `m`'s project reopened when there is one
and `:restore-session` is on, else `m`."
  (let (root (:session-root m)
        session (when (and root (:restore-session m))
                  (persist-read-value (session-file root) nil)))
    (if (map? session) (restore m session) m)))
