(defmodule display-rules
  "`:display-buffer` rules as data (Emacs's `display-buffer-alist`): the action names, the
defaults, what makes a rule valid, what the init file's warnings say about one that is not,
and an action read into `{:kind :side :size}`. Which rule matches a buffer and what the action
does to the panes are `pool`'s.")

(def *display-actions* #{:same-window :other-window :reuse :side :new-frame})

(def *display-buffer-defaults*
  ;; Where a command's buffer goes when no rule of the user's says (`pool/ed-display-buffer`),
  ;; as rules: what the command asked for decides — show it here, pop to another pane, or
  ;; preview it in another pane. The user's `:display-buffer` rules are consulted before these.
  [{:request :here :action :same-window}
    {:request :pop :action :other-window}
    {:request :display :action :other-window}])

(defn display-buffer-regex-valid? (pattern)
  "True when `pattern` is a `:display-buffer` rule's name regex that compiles to what it says: a
string that does not stop part-way through a group or set, nor end in a lone backslash
(`regex/incomplete?`). Brood's dialect is lenient — a stray `*` is a literal, so
`\"*Help*\"` matches `*Help*` — and an incomplete pattern is the one it reads as something
else."
  (and (string? pattern) (not (regex/incomplete? pattern))))

(defn display-buffer-rule-valid? (rule)
  "True when `rule` is one `:display-buffer` rule: a map whose `:match` is a regex string, a
keyword or a symbol (or absent), whose `:request` is `:here`, `:pop` or `:display` (or absent),
and whose `:action` is `:same-window`, `:other-window`, `:reuse`, `:side`, `:new-frame` or a
side map `{:side … :size …}`."
  (and (map? rule)
    (let ({:keys [match request action side size]} rule
          side-ok? (fn (value) (or (nil? value) (contains? #{:bottom :top :left :right} value)))
          size-ok? (fn (value) (or (nil? value) (and (number? value) (> value 0) (< value 1)))))
      (and (or (nil? match) (display-buffer-regex-valid? match) (keyword? match) (symbol? match))
        (or (nil? request) (contains? #{:here :pop :display} request))
        (side-ok? side)
        (size-ok? size)
        (cond
          (map? action) (and (side-ok? (:side action)) (size-ok? (:size action)))
          else (contains? *display-actions* action))))))

(defn display-buffer-valid? (value)
  "True when `value` is a `:display-buffer` value: a vector of maps. Each rule is checked on its
own (`display-buffer-rule-valid?`): an invalid one is dropped and named by
[[display-buffer-warnings]], the others kept — one mistyped rule does not cost the rest."
  (and (vector? value) (every? value map?)))

(defn display-buffer-rules (value)
  "The `:display-buffer` rules of `value` that are valid (`display-buffer-rule-valid?`) — what
`pool/ed-display-buffer` consults."
  (if (vector? value) (into [] (seq/filter value display-buffer-rule-valid?)) []))

(defn display-buffer-warnings (cfg)
  "A warning naming each `:display-buffer` rule of `cfg` that is dropped, and why."
  (let (value (get cfg :display-buffer))
    (if (vector? value)
      (into []
        (seq/keep (seq/enumerate value)
          (fn ([i rule])
            (when (not (display-buffer-rule-valid? rule))
              (str "init.blsp: :display-buffer rule "
                (inc i)
                " "
                (pr-str rule)
                " is dropped — want {:match a complete regex, a keyword or a symbol, :action "
                ":same-window / :other-window / :reuse / :side / {:side :size} / :new-frame}")))))
      [])))

(defn display-rule-action (rule)
  "A `:display-buffer` rule's action as `{:kind … :side … :size …}`: a keyword from
`*display-actions*`, or a map `{:side :bottom :size 0.3}` for a side window (the rule's own
`:side` / `:size` keys serve too), defaulting to the bottom and 0.3 of the frame."
  (let (action (:action rule)
        side-map (if (map? action) action {}))
    {:kind (if (map? action) :side action)
     :side (or (:side side-map) (:side rule) :bottom)
     :size (or (:size side-map) (:size rule) 0.3)}))
