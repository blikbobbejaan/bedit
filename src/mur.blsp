(defmodule mur
  "The TOP of the mur porcelain: `:use`s every mur module, so loading mur loads all of it and
every command a menu, keymap or `vcscore` row names by symbol is there — and holds the two menus
(transients, as git's are), reached through `vcscore` wherever the buffer is in a mur working copy:

- C-x M-g (and `?` in *mur-status*) — every mur verb, from one key: the change (say what it
  is for, save, land, drop), trunk (update, sync, log, versions), the forge (its page, the
  open changes, checks, discussion, reviews), and `!` any mur command
- C-c g — mur about THIS file: its diff since the last save, its history, save it as the
  change's next version, claim it, restore it"
  (:use murcore)
  (:use murbar)
  (:use murstatus)
  (:use murforge)
  (:use interactive)) ; defcommand

(def mur-dispatch-transient
  {:name 'mur-dispatch
   :title "mur"
   :groups [{:title "The change"
             :suffixes [["c"
                          'murstatus/cmd-mur-change
                          "say what it is for (a fresh change once it holds files)"]
                         ["r" 'murstatus/cmd-mur-rename "say it again"]
                         ["s" 'murstatus/cmd-mur-save "save its next version"]
                         ["l" 'murstatus/cmd-mur-land "land it on trunk"]
                         ["x" 'murstatus/cmd-mur-drop "drop it"]]}
             {:title "Trunk"
              :suffixes [["u" 'murstatus/cmd-mur-update "update onto the latest trunk"]
                          ["y" 'murstatus/cmd-mur-sync "send what the forge lacks"]
                          ["L" 'murstatus/cmd-mur-log "its history"]
                          ["V" 'murstatus/cmd-mur-versions "this change's versions"]]}
             {:title "The forge"
              :suffixes [["o" 'murforge/cmd-mur-browse "the change's page"]
                          ["O" 'murforge/cmd-mur-open-changes "every open change"]
                          ["C" 'murforge/cmd-mur-checks "checks"]
                          ["D" 'murforge/cmd-mur-discussion "discussion"]
                          ["R" 'murforge/cmd-mur-reviews "reviews"]]}
             {:title "Elsewhere"
              :suffixes [["g" 'murstatus/cmd-mur-status "the status buffer"]
                          ["!" 'murstatus/cmd-mur-run-command "any mur command"]
                          ["$" 'vcsproc/cmd-vcs-process "what ran"]]}]})

(defcommand cmd-mur-dispatch
  (m key)
  "Every mur verb, from one key (C-x M-g in a mur working copy, ? in *mur-status*)."
  (transient/ed-transient-open m mur-dispatch-transient))

(def mur-file-transient
  {:name 'mur-file
   :title "This file"
   :groups [{:title "Look"
             :suffixes [["d" 'murstatus/cmd-mur-diff "its changes since the last save"]
                         ["l" 'murstatus/cmd-mur-log-file "its history on trunk"]]}
             {:title "Change"
              :suffixes [["s" 'murstatus/cmd-mur-save "save it as the change's next version"]
                          ["a" 'murstatus/cmd-mur-claim "claim it for this change"]
                          ["k" 'murstatus/cmd-mur-restore "restore it as the last save has it"]]}
             {:title "Elsewhere"
              :suffixes [["g" 'murstatus/cmd-mur-status "the status buffer"]]}]})

(defcommand cmd-mur-file-menu
  (m key)
  "mur about this file (C-c g in a mur working copy): diff, history, save, claim, restore —
without opening the status buffer."
  (transient/ed-transient-open m mur-file-transient))
