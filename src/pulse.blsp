(defmodule pulse
  "A brief flash on the line point lands on after a JUMP (Emacs's pulsar): another window,
another buffer, or point moved `*jump-lines*` lines or more by one key command — which is
what `other-window`, recenter, imenu, xref, goto-line and a page scroll all do, the commands
pulsar pulses for. Typing never pulses (it moves a line at a time), and nor does the mouse:
a jump is a KEY command's, told apart by `:command-count`, which only a key command
advances.

A post-step row notices the jump and records `:pulse` — the buffer, the line and a `:level`
from 1 — and a timer row fades the level to nothing over `*pulse-ms*` while one is showing.
`ed-pulse-layer`, a pane layer, lays a translucent band over the line at that level. On with
the init file's `:pulse` (the model's `:pulse-on`).

Two rules keep it calm (`model/ed-reduce-motion?`'s comment): under `:reduce-motion` the
band is STATIC — no fade, no timer — and the next command clears it; and a key the desktop
REPEATS (`:key-repeat`, a held C-v) starts no pulse and ends the one showing, so a held key
never leaves a flash trailing behind the page."
  (:use editor/buffer) ; buffer-current-line
  (:use editor/display :only [frect]) ; the band
  (:use model) ; ed-current-buf / ed-current-pane / register-post-step / register-timer-client
  (:use panegeometry :only []) ; which rows a line takes
  (:use theme)) ; the palette the pulse face is a formula over

(theme/defchrome face-pulse {:bg *blue*}) ; the flash (pulsar's `pulsar-generic`)

(def *pulse-ms* 280) ; how long the flash takes to fade (pulsar's sample: 5 × 55 ms)
(def *pulse-tick-ms* 40) ; how often it steps while it fades
(def *pulse-static-level* 0.6) ; the band's level under `:reduce-motion`, where it does not fade
(def *jump-lines* 5) ; a move of this many lines or more in one command is a jump

(defn- where (m)
  ;; `[buffer-index line]` of the selected pane — what a jump changes
  [(:buffer (ed-current-pane m)) (buffer-current-line (ed-current-buf m))])

(defn- jumped? (before after)
  (or (not (= (first before) (first after)))
    (>= (math/abs (- (second after) (second before))) *jump-lines*)))

(defn- started (m here)
  ;; the pulse a jump to `here` starts: fading from 1, or static under :reduce-motion
  (if (ed-reduce-motion? m)
    {:buffer (first here) :line (second here) :level *pulse-static-level* :static true}
    {:buffer (first here) :line (second here) :level 1.0}))

(defn note-jump (m)
  "The post-step row: when a key command ran since the last step (`:command-count` moved)
and it JUMPED (`jumped?`), start a pulse on the line point is on — unless the key was an OS
repeat (`:key-repeat`), which starts none and clears any showing. Any other command clears
a static pulse (`:reduce-motion`'s, which has no fade to end it). Remembers where point is
either way, so the next command is measured from there — after a mouse click too. O(1), and
the model unchanged when nothing moved."
  (if (not (:pulse-on m))
    m
    (let (count (:command-count m)
          here (where m)
          seen (:pulse-seen m)
          commanded (and seen (not (= count (first seen))))
          noted (assoc m :pulse-seen [count here]))
      (cond
        (= [count here] seen) m
        (not commanded) noted
        (:key-repeat m) (dissoc noted :pulse)
        (jumped? (second seen) here) (assoc noted :pulse (started m here))
        (:static (:pulse m)) (dissoc noted :pulse)
        else noted))))

(defn timer-spec (m)
  "The fade's timer while a fading pulse is showing, else none — a static one has no timer."
  (let (pulse (:pulse m))
    (when (and pulse (not (:static pulse))) {:every *pulse-tick-ms*})))

(defn fade (m)
  "One step of the fade: the level down by a tick's share, the pulse gone at nothing. A
static pulse does not fade."
  (let (pulse (:pulse m))
    (if (or (nil? pulse) (:static pulse))
      m
      (let (level (- (:level pulse) (/ (* 1.0 *pulse-tick-ms*) *pulse-ms*)))
        (if (<= level 0.0) (dissoc m :pulse) (assoc m :pulse (assoc pulse :level level)))))))

(defn ed-pulse-layer (m pane buf geometry)
  "The pulse on the selected pane's line after a jump: a translucent band over the rows the line
takes, as opaque as the pulse's fading `:level`. `()` with no pulse, for another buffer, in a
zoomed pane (its rows are the region's), or in a terminal."
  (let (pulse (:pulse m))
    (if (or (nil? pulse)
          (nil? geometry)
          (not (:selected pane))
          (not (:gui m))
          (not (nil? (get (:payload pane) :zoom)))
          (not (= (:buffer pulse) (:buffer (:payload pane)))))
      '()
      (let (body (panegeometry/geometry-span geometry :body))
        (map (panegeometry/ed-line-screen-rows geometry (:line pulse) (:text-height geometry))
          (fn ([row _from _to _entry])
            (frect (+ (first body) 0.0)
              (+ (:y geometry) row 0.0)
              (+ (second body) 0.0)
              1.0
              face-pulse
              (* 0.45 (:level pulse)))))))))

(register-pane-layer :pulse {:rank 10 :slot :over-text :run 'pulse/ed-pulse-layer})
(register-post-step :pulse {:order 90 :run 'pulse/note-jump})
(register-timer-client :pulse 'pulse/timer-spec 'pulse/fade)
