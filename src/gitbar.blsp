(defmodule gitbar
  "git on the mode line, for every buffer in a repo: a ⎇ branch segment, a state dot,
`↓2 ↑1` against the upstream and `+staged ~unstaged ?untracked` counts — each clickable to
`C-x g`. git's row in `vcscore` (`register-vcs-backend :git`): `vcscore` computes the summary
off the loop on the idle beat and draws the chip this module describes (`git-chip`); this
module only knows what git's summary holds and how it reads."
  (:use vcscore) ; register-vcs-backend — git's row
  (:use gitcore)) ; git-git / git-entries / git-upstream / the faces

;; ---- the status-bar segments (branch + working-tree indicator) --------------
;; The branch and a colour-coded working-tree indicator on the status bar, for **every**
;; buffer in a repo (not just *git-status*). Built from the summary `vcscore` caches on the model
;; as `:vcs-summary`, which the view lays out. Both segments are clickable (→ `C-x g`) and
;; carry a hover tooltip.

(def *git-branch-glyph* "⎇ ") ; the branch marker; set to "git:" if your font lacks ⎇

(defn git-summary (root)
  "A working-tree summary for the status bar, or nil outside a repo: `{:root :branch :label
:upstream :ahead :behind :staged :unstaged :untracked}`. Counts come from `git status
--porcelain`; ahead/behind are best-effort strings vs the upstream. A few `git` calls, so `vc`
runs it off the render path, on the idle beat."
  (if (nil? root)
    nil
    (let (entries (git-entries (:stdout (git-git root ["status" "--porcelain" "-z"])))
          upstream (git-upstream root)
          ab (and upstream (git-ahead-behind root))
          branch (git-branch root))
      {:root root
       :branch branch
       :label branch
       :upstream upstream
       :ahead (and ab (:ahead ab))
       :behind (and ab (:behind ab))
       :staged (count (seq/filter entries git-staged?))
       :unstaged (count (seq/filter entries git-unstaged?))
       :untracked (count (seq/filter entries git-untracked?))})))

(defn- git-dot-face (summary)
  "The state-dot colour: yellow when there are unstaged changes (a dirty tree), green when
only staged (ready to commit) or clean."
  (cond
    (> (:unstaged summary) 0) git-face-unstaged
    (> (:staged summary) 0) git-face-staged
    :else git-face-clean))

(defn- git-repo-tooltip (summary)
  "The branch segment's hover tooltip: repo name, branch, upstream, and ahead/behind."
  (append [(str "Repo:   " (git-basename (:root summary))) (str "Branch: " (:branch summary))]
    (if (:upstream summary)
      [(str "Upstream: " (:upstream summary))
        (str "↑ " (or (:ahead summary) "0") " ahead    ↓ " (or (:behind summary) "0") " behind")]
      ["(no upstream)"])))

(defn- git-tree-tooltip (summary)
  "The state-dot segment's hover tooltip: the working-tree counts, or 'clean'."
  (if (and (= (:staged summary) 0) (= (:unstaged summary) 0) (= (:untracked summary) 0))
    ["Working tree clean"]
    [(str "Staged:    " (:staged summary))
      (str "Unstaged:  " (:unstaged summary))
      (str "Untracked: " (:untracked summary))]))

(defn- git-count (id prefix n face meaning)
  "A colour-coded count for the chip (`+3`), or nil when the count is 0 (so it vanishes)."
  (if (= n 0) nil {:id id :text (str prefix n) :face face :tooltip (str n " " meaning)}))

(defn- git-sync-count (s)
  "An ahead/behind count as an int — they arrive from `git rev-list --count` as strings,
and a missing upstream leaves them absent entirely."
  (let (n (if (string? s) (string/->number s) s))
    (if (int? n) n 0)))

(defn git-sync-mark (summary)
  "The `↓2 ↑1` upstream count, or nil when the branch is level with its upstream (or has
none). What the background fetch is FOR: on the mode line it is the thing you glance at — and
`↓` appearing on its own is the notification arriving twice, once as a message you might
miss and once as a mark that stays."
  (if (nil? summary)
    nil
    (let (behind (git-sync-count (:behind summary))
          ahead (git-sync-count (:ahead summary))
          ;; `[count glyph meaning]` for each direction there is something to move
          moves (seq/filter [[behind "↓" "to pull"] [ahead "↑" "to push"]]
                  (fn (move) (> (first move) 0))))
      (if (empty? moves)
        nil
        {:id :git-sync
         :text (string/join (map moves (fn ([n glyph _]) (str glyph n))) " ")
         ;; behind reads as "there is something to pull" — the colour the unstaged count
         ;; uses for "you have work to do"; ahead-only is quieter, it is just unpushed
         :face (if (> behind 0) git-face-unstaged git-face-branch)
         :tooltip (string/join (map moves (fn ([n _ meaning]) (str n " " meaning))) ", ")}))))

(defn git-chip (summary)
  "git's chip (`vcscore/vcs-chip-segments` draws it) from `summary`, or nil: the ⎇ branch
(tooltip: repo / upstream / ahead-behind), the working tree's dot, then `↓↑` against the
upstream and `+staged ~unstaged ?untracked`, each only when non-zero. Pure."
  (if (nil? summary)
    nil
    {:glyph *git-branch-glyph*
     :label (:branch summary)
     :label-face git-face-branch
     :tooltip (git-repo-tooltip summary)
     :dot-face (git-dot-face summary)
     :dot-tooltip (git-tree-tooltip summary)
     :counts [(git-sync-mark summary)
               (git-count :git-staged "+" (:staged summary) git-face-staged "staged")
               (git-count :git-unstaged "~" (:unstaged summary) git-face-unstaged "unstaged")
               (git-count :git-untracked "?" (:untracked summary) git-face-untracked "untracked")]}))
(register-vcs-backend :git
  {:status 'gitstatus/cmd-git-status
   :dispatch 'git/cmd-git-dispatch
   :file-menu 'git/cmd-git-file-menu
   :diff-file 'gitview/cmd-git-diff-file
   :log-file 'gitview/cmd-git-log-file
   :blame 'gitview/cmd-git-blame
   :summary 'gitbar/git-summary
   :chip 'gitbar/git-chip})
