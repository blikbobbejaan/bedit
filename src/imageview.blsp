(defmodule imageview
  "Viewing an image (Emacs's image-mode): a PNG, JPEG, GIF, WebP or BMP opens as a picture rather
than as hex. Brood decodes it (`gui/image-thumb`, scaled to fit the pane) and the pane paints it
in half-block cells — `▀`, its top pixel the glyph's colour, its bottom pixel the cell's
background — so it shows the same in a window and in a terminal. The buffer is read-only; its
one line names the image. A file that does not decode opens as the hex view, as any binary."
  (:use editor/buffer) ; the buffer that holds the image
  (:use editor/display :only [text]) ; the cells
  (:use model) ; register-presenter / register-pane-layer / message
  (:use memo) ; defmemo — a picture is decoded once per size
  (:use modes :only []) ; register-special-type runs at load, after modes declares its kinds
  (:use theme) ; *base*, the background a transparent pixel shows
  (:use pool :only [ed-show-named]) ; the buffer it shows in
  (:use projects :only [file-display-name])) ; its name in a project

(defn ed-open-image (m path root bytes)
  "Open the image at `path` (`bytes` its contents, already read) as an `:image` buffer — or as the
hex view when it does not decode."
  (let (probe (gui/image-thumb bytes 4096 4096))
    (if (nil? probe)
      (hexl/ed-open-binary m path root bytes)
      (let (title (str (string/upper (string/replace (or (path/extension path) "image") "." ""))
                    " "
                    (:width probe)
                    "×"
                    (:height probe)
                    " — "
                    (path/basename path)
                    "\n")
            shown (ed-show-named m (file-display-name path root) title :image))
        (message (ed-set-buf shown
                   (assoc (set-read-only (ed-current-buf shown) true)
                     :file path
                     :dir (path/dirname path)
                     :image-bytes bytes))
          (str "image " (:width probe) "×" (:height probe)))))))

;; ---- the picture, in half-block cells -----------------------------------------

(defn- hex-channel (colour offset)
  ;; the 0-255 channel at `offset` of a `#rrggbb` colour
  (let (digits "0123456789abcdef"
        text (string/lower colour))
    (+ (* 16 (index-of digits (string/char-at text offset)))
      (index-of digits (string/char-at text (inc offset))))))

(sig pixel-colour (any int int int string -> string))
(defn- pixel-colour (rgba width x y background)
  ;; `#rrggbb` of pixel (x, y) of a row-major RGBA8 picture `width` wide, over `background` (the
  ;; theme's, so a transparent pixel shows the editor behind it) by its alpha
  (let (at (* 4 (+ x (* y width)))
        alpha (bytes/at rgba (+ at 3))
        channel (fn (offset under)
                  (math/quot (+ (* (bytes/at rgba (+ at offset)) alpha) (* under (- 255 alpha)))
                    255)))
    (string/format "#%02x%02x%02x"
      (channel 0 (hex-channel background 1))
      (channel 1 (hex-channel background 3))
      (channel 2 (hex-channel background 5)))))

(sig thumb (any int int -> (or nil (record &open :width int :height int :rgba any))))
(defn- thumb (bytes cols rows)
  ;; `bytes` decoded to fit `cols` cells by `rows` — two pixels a cell, one above the other
  (gui/image-thumb bytes cols (* 2 rows)))

;; check-allow: what the memo holds is the body's list of cells
(check-allow :trusted
  (defmemo picture-cells 4 (bytes cols rows background)
    "`[row col fg bg]` for every cell of the picture `bytes` decoded to fit `cols` cells by `rows`
— two pixels a cell, one above the other, over `background` — row by row."
    (let (picture (thumb bytes cols rows))
      (if (nil? picture)
        '()
        (let (width (:width picture)
              height (:height picture)
              rgba (:rgba picture))
          (mapcat (range 0 (math/quot (inc height) 2))
            (fn (row)
              (map (range 0 width)
                (fn (col)
                  (let (top (* 2 row)
                        bottom (math/min (dec height) (inc top)))
                    [row
                      col
                      (pixel-colour rgba width col top background)
                      (pixel-colour rgba width col bottom background)]))))))))))

(defn image-layer (m pane buf geometry)
  "The pane layer: an `:image` buffer's picture under its title line, fitted to the pane."
  (let (bytes (:image-bytes buf))
    (if (nil? bytes)
      '()
      (let ([left width] (panegeometry/geometry-span geometry :text)
            height (math/max 1 (dec (:text-height geometry)))
            top (inc (:y geometry)))
        (map (picture-cells bytes width height *base*)
          (fn ([row col fg bg]) (text (+ top row) (+ left col) "▀" {:fg fg :bg bg})))))))

(defn image-deps (m pane buf)
  "What the layer reads besides the text: the image, and the background it is drawn over."
  [(:image-bytes buf) *base*])

(register-presenter :image 'imageview/ed-open-image)
(register-pane-layer :image
  {:rank 5 :slot :with-text :run 'imageview/image-layer :deps 'imageview/image-deps})

(def image-mode-layer
  {:name 'image
   :doc "An image, painted in the pane — q quits."})

(modes/register-special-type :image 'imageview/image-mode-layer)
