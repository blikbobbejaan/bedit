(defmodule codecrumbs
  "Breadcrumbs for code (Emacs's breadcrumb-mode): the header line names the definitions point
is inside — `XB.Probe › run` — as Org's names the headings. A tree-sitter mode reads them off
the held parse (each `deflanguage` names a `:breadcrumbs` service that calls this): the chain
of nodes around point, kept to the ones the language declares definitions
(`editor/treesit/definitions`), each named by the first word on its line that is not a keyword
(`def`, `pub fn`, `class`…). A Lisp names the top-level form point is in. With no current parse
(a large file catching up), no crumbs — never a parse on the frame."
  (:use editor/buffer)) ; the rope and point

(def *keywords*
  ;; the words before a definition's name, in the languages bedit parses
  #{"def"
    "defp" "defmacro" "defmacrop" "defmodule" "defprotocol" "defimpl" "defstruct" "defdelegate"
    "defguard" "defn" "defn-" "class" "module" "fn" "function" "func" "pub" "async" "static"
    "export" "default" "struct" "impl" "trait" "enum" "type" "interface" "abstract" "public"
    "private" "protected" "override" "self" "const" "let" "var" "unsafe" "extern" "mod" "for"
    "crate" "get" "set" "*"})

(defn definition-name (head)
  "The name a definition's first line `head` gives it: its first word that is not a keyword.

    (codecrumbs/definition-name \"  pub async fn fetch(url: &str) {\")   ;=> \"fetch\"
    (codecrumbs/definition-name \"defmodule XB.Probe do\")   ;=> \"XB.Probe\""
  (seq/find (map (regex/find-all "[A-Za-z_*][A-Za-z0-9_.!?*-]*" head) (fn (found) (:text found)))
    (fn (word) (not (contains? *keywords* word)))))

(defn- definition? (node definitions rope)
  ;; whether chain `node` is a definition: its kind is one the language declares, or it is a
  ;; call whose callee is (Elixir's `def`, a call)
  (or (contains? (or (:kinds definitions) #{}) (:kind node))
    (and (= (:kind node) :call)
      (let (callee (first (regex/find-all "^[A-Za-z_][A-Za-z0-9_]*"
                            (text/slice rope
                              (:start node)
                              (math/min (:end node) (+ (:start node) 32))))))
        (and callee (contains? (or (:calls definitions) #{}) (:text callee)))))))

(defn tree-crumbs (lang buffer tree)
  "The definitions point of `buffer` is inside, outermost first, by name — from `tree`, a held
parse of exactly `buffer`'s text in `lang`; `()` without one."
  (if (nil? tree)
    '()
    (let (rope (buffer-rope buffer)
          definitions (editor/treesit/definitions lang)
          chain (editor/treesit/node-chain rope lang (buffer-point buffer) tree))
      (seq/keep chain
        (fn (node)
          (when (definition? node definitions rope)
            (let (line (text/char->line rope (:start node))
                  line-end (if (< (inc line) (text/line-count rope))
                             (text/line->char rope (inc line))
                             (text/length rope)))
              (definition-name (text/slice rope (:start node) line-end)))))))))

(defn form-crumbs (buffer &optional (tree nil))
  "A Lisp mode's `:breadcrumbs`: the name of the top-level form point is in (`(defn run …` gives
`run`), or `()` outside one."
  (let (rope (buffer-rope buffer)
        point (buffer-point buffer)
        start (reflect/scan-form-start rope point)
        end (reflect/scan-form-end rope start 1))
    (if (or (> point end)
          (not (= (text/slice rope start (math/min (inc start) (text/length rope))) "(")))
      '()
      (let (line (text/char->line rope start)
            line-end (if (< (inc line) (text/line-count rope))
                       (text/line->char rope (inc line))
                       (text/length rope))
            head (text/slice rope (inc start) line-end)
            name (definition-name head))
        (if name (list name) '())))))
