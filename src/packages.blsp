(defmodule packages
  "bedit's package manager: install / update / remove hive packages that `:enhances bedit`, at
RUNTIME with no restart, plus the *Packages* browser (`M-x package-list`). Packages install
into a USER directory — `~/.config/bedit/packages/` (the Emacs `elpa` model) — NOT the
project's build `_deps`, so a plugin is something a user adds live, never a build dependency.

The heavy lifting is std's: `package/registry-install` (download + sha-VERIFY + extract),
`package/registry-enhancers` (list installable bedit plugins — the runtime `--enhances`),
`package/registry-latest-version` (update checks), and `project/enhancers-in` (which INSTALLED
packages enhance bedit). Each answers a failure CARRYING ITS REASON (brood ADR-559) — the
registry unreachable, the package unpublished, a failed download, a checksum mismatch — and
that reason is what the echo area and the *Packages* status line say.

Fetching the list, installing and updating are network work, so each runs OFF the loop as a
`std/task` (`*package-job-timeout-ms*`): one at a time, C-g cancels it, C-x C-c asks while it
runs, and the *Packages* buffer's status line says what is running and how the last one
ended. An install lands in a STAGING directory first and is moved into place only when it
downloaded, verified and enhances this bedit — so a failed, refused or cancelled install
leaves the copy that was there. Removing is local and stays on the loop.

This module is bedit's POLICY: the user dir + load-path, applying and unapplying a
contribution (themes today), and the UI. A plugin that lacks its entry or throws is not
applied, and the install says why — one bad package never blocks the editor."
  (:use editor/keymap :only [keymap-bind]) ; the mode keymap below
  (:use interactive) ; defcommand — the M-x commands
  (:use themes) ; register-theme! — a theme contribution, claimed for its package
  (:use config) ; config-dir — the user package dir lives under it
  (:use model) ; message / ed-headless? / register-task-reply / register-exit-query
  (:use pool) ; ed-show-named / ed-name-prompt / ed-goto-line / ed-upsert-named
  (:use editor/buffer) ; buffer-current-line — the *Packages* row at point
  (:use task :only [task])) ; task — the network work runs off the loop
;; A plugin needing a newer bedit than we are is not applied. What its `:enhances {bedit …}`
;; constraint is checked against comes from `about/bedit-version` — the manifest, read at
;; the moment it is asked — rather than a constant here "kept in lockstep with project.blsp".
;; It was not kept in lockstep: this said 0.2.0 against a manifest two releases further on
;; (0.4.1), so every plugin declaring `:enhances {bedit ">= 0.3"}` was silently refused. A
;; version a human has to remember to copy is a version that is wrong.
(def *bedit-name* "bedit")

(def *package-job-timeout-ms* 300000)
;; Five minutes before a list fetch, an install or an update is killed and reported as timed
;; out: a large plugin over a slow link takes a while, a registry that never answers should
;; not hold the one package slot for the rest of the session.

(defdyn *registry*
  {:enhancers (fn (app) (package/registry-enhancers app))
   :latest-version (fn (name) (package/registry-latest-version name))
   :install (fn (name dest-dir) (package/registry-install name dest-dir))})
;; The three registry calls this module makes, as data: a test binds its own (no network in a
;; test), and a launch reads it ON the loop and hands it to the task, because a binding does
;; not cross into the task's process.

;; ---- the user package directory (~/.config/bedit/packages) ------------------

(defn user-package-dir ()
  "Where installed plugins live: `~/.config/bedit/packages/` (honouring $XDG_CONFIG_HOME)."
  (path/join (config/config-dir) "packages"))

(defn- pkg-dir (name) (path/join (user-package-dir) name))
(defn- pkg-manifest (name) (path/join (pkg-dir name) "project.blsp"))

(defn- plist-get (plist key)
  "The value after `key` in a plist, or nil — a local copy (no dependency on the project tool)."
  (cond
    (or (nil? plist) (nil? (rest plist))) nil
    (= (first plist) key) (first (rest plist))
    else (plist-get (rest (rest plist)) key)))

(defn- manifest-value (name key)
  "A value from an installed package's `(project …)` manifest, or nil."
  (try
    (let (form (reflect/read-string (file/slurp (pkg-manifest name))))
      (if (and (list? form) (= (first form) 'project))
        (plist-get (rest form) key)
        nil))
    (catch e
      (do (log/warn (str "packages: cannot read the manifest of " name ": " (error-message e))) nil))))

(defn installed? (name)
  "Whether package `name` is installed in the user package dir."
  (file/exists? (pkg-manifest name)))

(defn installed-version (name)
  "The installed version string of `name`, or nil — nil without a word when it is not installed
(every hive row asks), a logged warning only for a manifest that is there and does not read."
  (when (installed? name) (manifest-value name :version)))

(defn installed-packages ()
  "The names of packages installed in the user package dir (a dir with a project.blsp)."
  (if (not (file/exists? (user-package-dir)))
    []
    (vec (seq/filter (file/ls (user-package-dir)) installed?))))

;; ---- apply / unapply a contribution (themes today) -------------------------

(defn- add-to-load-path! (name)
  "Put package `name`'s src/ on `*load-path*` so `(require-one 'name)` finds it (idempotent)."
  (reflect/add-load-path (path/join (pkg-dir name) "src")))

(defn- reload-sources (name)
  "Load every source file of package `name` again — what an UPDATE of a plugin this image has
already loaded needs, since `require-one` of a loaded module is a no-op and would keep running
the old code until a restart. In load order (`reflect/source-load-order`): a module after the
ones it uses, so a macro the update changed is defined again before the file that expands
it, and one reload is enough."
  (doseq (file (reflect/source-load-order (seq/filter (file/walk-files (path/join (pkg-dir name)
                                                                         "src"))
                                            (fn (path) (string/ends-with? path ".blsp")))))
    (load-package-file name file)))

(defn- entry-symbol (name) (symbol (str name "/bedit-plugin")))

(defn- loaded-contribution (name)
  "What package `name`'s plugin contributes in the image AS IT IS — its entry called if it is
bound, loading nothing — or nil: a package never loaded, or one whose entry fails, contributed
nothing that is still registered."
  (let (entry (entry-symbol name))
    (when (bound? entry)
      (let (contribution (check-allow :discarded-catch
                           (try ((reflect/eval entry)) (catch _ nil))))
        (when (map? contribution) contribution)))))

(defn- source-files (name)
  "Every `.blsp` file under package `name`'s src/."
  (let (dir (path/join (pkg-dir name) "src"))
    (if (file/exists? dir)
      (seq/filter (file/walk-files dir) (fn (path) (string/ends-with? path ".blsp")))
      ())))

(defn package-modules (name)
  "The modules package `name`'s files declare — each file's `(defmodule …)` — as a set of
strings. A file that does not open with one declares none."
  (into #{}
    (seq/keep (source-files name)
      (fn (file)
        (let (head (check-allow :discarded-catch
                     (try (reflect/read-first (file/slurp file)) (catch _ nil))))
          (when (and (list? head) (= (first head) 'defmodule) (symbol? (second head)))
            (->string (second head))))))))

(defn- global-namespace (global)
  ;; everything before the last `/` of a global's name, nil for a root name
  (let (parts (string/split (->string global) "/"))
    (when (> (count parts) 1) (string/join (take parts (dec (count parts))) "/"))))

(defn- sited-under? (global prefix)
  ;; whether `global`'s definition was last loaded from a file under `prefix`
  (let (site (reflect/source-location global))
    (and (vector? site) (string/starts-with? (str (first site)) prefix))))

(defn- global-value (global)
  (check-allow :discarded-catch (try (reflect/eval global) (catch _ nil))))

(defn- define-global (global value)
  ;; `global` bound to `value` again — the root escape names it whatever module asks
  (reflect/eval (list 'def (symbol (str "/" global)) (list 'quote value))))

(defn plugin-definitions (name)
  "Every global package `name`'s code FIRST defined in this image: the names its load left
sited in its files that were unbound before it ([[note-loaded]] keeps them — a file without
a `defmodule` included, whose names are root names), and any name in its own modules
([[package-modules]]) sited there. A core name the package REDEFINED is not among them: it
was bound before, and retiring the package restores it ([[restore-redefinitions]])."
  (let (prefix (str (pkg-dir name) "/")
        modules (package-modules name)
        noted (seq/filter (registry/lookup :packages/defined name []) (fn (global) (bound? global))))
    (vec (seq/distinct (append noted
                         (seq/filter (reflect/global-names)
                           (fn (global)
                             (and (contains? modules (global-namespace global))
                               (sited-under? global prefix)))))))))

;; ---- core names a package redefined ----------------------------------------
;; A package's file may redefine a name the editor already had — a core function it patches
;; (`(defn bedit/keyhelp/ed-key-label …)`). Retiring that by source location undefined it:
;; the core function was gone until a restart. So a package's load is compared with the
;; globals as they were before it ([[global-values]]): a name sited in its files afterwards,
;; outside its own modules, that was bound before with another value is a REDEFINITION.
;;
;; Two packages may patch the same function, so each redefined global keeps a STACK, as a
;; registry row does (`ownership`): `:packages/redefinitions` global -> `{:base :stack [{:package
;; :value} …]}`, the value from before any package and each package's on top, the live one
;; last. Retiring a package splices its layer out: the top one restores the layer below it
;; (or the base), a lower one leaves the live patch alone — so removing A while B's patch is
;; live keeps B's, and removing B then gives back the core function, never A's (whose helpers
;; went with A). Emacs's `unload-feature` restores a function the same way.

(defn- global-values ()
  "Every global's value now, by name — what a package's load is compared against."
  (fold (reflect/global-names) {} (fn (acc global) (assoc acc global (global-value global)))))

(defn plugin-redefinitions (name before)
  "The globals package `name`'s files REDEFINED, as `{global value-before}`: sited under its
directory now, outside its own modules ([[package-modules]]), bound in `before` (a
[[global-values]] taken before its load) with a value it no longer has."
  (let (prefix (str (pkg-dir name) "/")
        modules (package-modules name))
    (into {}
      (seq/keep (reflect/global-names)
        (fn (global)
          (when (and (contains? before global)
                  (sited-under? global prefix)
                  (not (contains? modules (global-namespace global)))
                  (not (= (get before global) (global-value global))))
            [global (get before global)]))))))

(defn- note-redefinitions (name before)
  ;; each redefined global's stack gets this package's layer on top (its earlier one gone)
  (doseq ([global value-before] (plugin-redefinitions name before))
    (let (record (registry/lookup :packages/redefinitions global {:base value-before :stack []})
          others (into [] (seq/reject (:stack record) (fn (layer) (= (:package layer) name)))))
      (registry/put! :packages/redefinitions
        global
        (assoc record :stack (conj others {:package name :value (global-value global)}))))))

(defn restore-redefinitions (name)
  "Take package `name`'s layer out of every redefined global's stack: where it was the live
patch the layer below it is bound again (another package's, or the value from before any
package), where it was not the live patch is left alone. Answers how many globals it had
patched."
  (fold (registry/entries :packages/redefinitions)
    0
    (fn (patched [global record])
      (let (stack (:stack record)
            kept (into [] (seq/reject stack (fn (layer) (= (:package layer) name)))))
        (cond
          (= (count kept) (count stack)) patched
          (empty? kept)
            (do
              (registry/remove! :packages/redefinitions global)
              (define-global global (:base record))
              (inc patched))
          (= (:package (last stack)) name)
            (do
              (registry/put! :packages/redefinitions global (assoc record :stack kept))
              (define-global global (:value (last kept)))
              (inc patched))
          else
            (do
              (registry/put! :packages/redefinitions global (assoc record :stack kept))
              (inc patched)))))))

(defn- retire-definitions (name)
  "Remove every global package `name`'s code first defined (`reflect/undef`, brood ADR-391)
and answer how many went. What an update does BEFORE loading the new version, so a function
the new version dropped is gone rather than callable with the old body, and what a remove
does so the removed package's code stops running. A caller still holding one raises `unbound
symbol (removed by reflect/undef …)` — said, not silently old. Its registrations are taken
back first, so nothing the editor runs still names one."
  (let (retired (count (seq/filter (plugin-definitions name)
                         (fn (global)
                           (check-allow :discarded-catch
                             (try (reflect/undef global) (catch _ false)))))))
    (registry/remove! :packages/defined name)
    retired))

;; ---- registrations the package made ----------------------------------------------

(defn- claimant-file (name)
  ;; what a registration made while package `name` is applied, outside a load of one of its
  ;; files, is claimed for (`ownership/*claimant*`): a file under its directory
  (path/join (pkg-dir name) "project.blsp"))

(defn- module-symbols (name) (into #{} (map (package-modules name) symbol)))

(defn release-registrations (name)
  "Take back every registry entry package `name` made through bedit's registries — its idle
jobs, task replies, event, down and timer handlers, exit queries, post-steps, mode line chips,
commands, modes, file types, settings and themes, at load or as its code ran
(`ownership/release-under!`) — and answer the `[kind key]`s released. An entry it replaced
comes back."
  (ownership/release-under! (pkg-dir name)))

(defn- adopt-settings (name before)
  "Claim for package `name` the settings its sources declare ([[package-settings]]) that its
load wrote — `settings/define` writes std's registry directly — over what the registry held
`before` the load, so they leave init.blsp's settings with the package."
  (doseq (setting (package-settings name))
    (when (not (= (get before setting) (registry/lookup config/*settings* setting)))
      (ownership/adopt! config/*settings*
        setting
        (claimant-file name)
        (contains? before setting)
        (get before setting)))))

;; A package may write std's registries DIRECTLY — `editor/layers/register-type-layers`,
;; `register-system-layer`, a `registry/put!` of its own — past bedit's claims. The kernel
;; records the module whose load made each registry write (`registry/written-by`), so what the
;; package's modules wrote is known; what each map entry held BEFORE the load is kept beside it
;; (`:packages/std-writes`), and retiring the package puts that back, or takes the write back
;; (`registry/retract`) where there was nothing.

(defn- path-present? (table path)
  (let (head (first path)
        more (rest path))
    (and (map? table)
      (contains? table head)
      (or (empty? more) (and (map? (get table head)) (contains? (get table head) (first more)))))))

(defn- note-std-writes (name before)
  ;; each map entry the package's modules' loads wrote, with what it held in `before`
  (registry/put! :packages/std-writes
    name
    (vec (seq/keep (registry/written-by (module-symbols name))
           (fn (write)
             (when (:path write)
               (let (prior (get before (:global write))
                     present? (path-present? prior (:path write)))
                 {:global (:global write)
                  :path (:path write)
                  :present? present?
                  :before (when present? (map/get-in prior (:path write)))})))))))

(defn- retract-std-writes (name)
  "Take back every std registry write package `name`'s modules' loads made that is still
there — a map entry gets back what it held before the load, or goes; a list member goes —
and answer the writes."
  (let (recorded (registry/lookup :packages/std-writes name [])
        writes (registry/written-by (module-symbols name)))
    (registry/remove! :packages/std-writes name)
    (doseq (write writes)
      (let (prior (seq/find recorded
                    (fn (entry)
                      (and (= (:global entry) (:global write)) (= (:path entry) (:path write))))))
        (if (and prior (:present? prior))
          (registry/restore write (:before prior))
          (registry/retract write))))
    writes))

;; A file WITHOUT a `defmodule` loads in the root namespace, and the kernel records no writer
;; for a root write — `registry/written-by` cannot list what it registered. So such a file's
;; load is bracketed: the std registry globals before and after it are compared, and every
;; entry it added or changed, and every list member it added, is kept as the package's
;; (`:packages/loose-writes`), to be put back or retracted as a module's writes are.

(def- *std-registry-globals*
  ;; the registry globals a package can write directly: std's named registries and
  ;; editor/layers' four tables
  ['registry/*registries*
    'editor/layers/*type-layers* 'editor/layers/*auto-type-by-interpreter*
    'editor/layers/*system-layers* 'editor/layers/*auto-type-by-file*])

(defn- registry-snapshot ()
  (into {} (map *std-registry-globals* (fn (global) [global (global-value global)]))))

(defn- map-entry-changes (global before after)
  ;; `{:global :path :value :present? :before}` for each entry `after` added or changed
  (seq/keep after
    (fn ([key value])
      (when (or (not (map? before)) (not (contains? before key)) (not (= (get before key) value)))
        {:global global
         :path [key]
         :value value
         :present? (and (map? before) (contains? before key))
         :before (when (map? before) (get before key))}))))

(defn- registry-changes (before after)
  "The std registry writes between two [[registry-snapshot]]s: map entries added or changed
(`registry/*registries*` two keys deep, its bookkeeping ids left out) and list members added."
  (let (bookkeeping #{"ownership" "packages"})
    (vec (mapcat *std-registry-globals*
           (fn (global)
             (let (old (get before global)
                   new (get after global))
               (cond
                 (= old new) []
                 (= global 'registry/*registries*)
                   (mapcat (seq/reject (vec new)
                             (fn ([id _table])
                               (and (keyword? id)
                                 (contains? bookkeeping (ownership/symbol-namespace id)))))
                     (fn ([id table])
                       (map (map-entry-changes global (get old id) table)
                         (fn (change) (assoc change :path [id (first (:path change))])))))
                 (map? new) (map-entry-changes global old new)
                 else
                   (map (seq/reject (vec new) (fn (member) (includes? (or old ()) member)))
                     (fn (member) {:global global :member member})))))))))

(defn- defines-module? (file)
  (let (head (check-allow :discarded-catch
               (try (reflect/read-first (file/slurp file)) (catch _ nil))))
    (and (list? head) (= (first head) 'defmodule))))

(defn- load-package-file (name file)
  "Load one of package `name`'s files; one without a `defmodule` with its std registry writes
recorded for the package (`:packages/loose-writes`)."
  (if (defines-module? file)
    (reflect/load file)
    (let (before (registry-snapshot)
          _ (reflect/load file)
          changes (registry-changes before (registry-snapshot)))
      (registry/put! :packages/loose-writes
        name
        (into (registry/lookup :packages/loose-writes name []) changes)))))

(defn- retract-loose-writes (name)
  "Take back the std registry writes package `name`'s `defmodule`-less files made that are
still as they left them — an entry gets back what it held before, or goes; a member goes —
and answer them."
  (let (writes (registry/lookup :packages/loose-writes name []))
    (registry/remove! :packages/loose-writes name)
    (doseq (write writes)
      (let (table (global-value (:global write)))
        (cond
          (:member write) (when (includes? (or table ()) (:member write)) (registry/retract write))
          (and (path-present? table (:path write))
            (= (map/get-in table (:path write)) (:value write)))
            (if (:present? write)
              (registry/restore write (:before write))
              (registry/retract write))
          else nil)))
    writes))

;; ---- the backstop: rows that still name the package ------------------------------
;; A row registered where neither a load nor a dispatch could attribute it (a hook called
;; straight through `reflect/call-if-bound`, a timer) is found by what it NAMES: a hook symbol
;; in one of the package's namespaces, a function defined there, a name its files first
;; defined. Retiring the package drops every such row from bedit's registries and std's.

(defn- function-name (value)
  ;; the qualified name a named function prints with (`#<fn pkg/f>`), else nil
  (let (printed (pr-str value))
    (when (and (string/starts-with? printed "#<fn ") (string/ends-with? printed ">"))
      (symbol (string/substring printed 5 (dec (string/length printed)))))))

(defn- names-package? (value namespaces defined)
  "Whether `value` mentions, at any depth, a symbol or a named function of the package:
in one of `namespaces` (strings) or among the globals it first `defined` (a set)."
  (let (ours? (fn (sym)
                (or (contains? defined sym)
                  (contains? namespaces (ownership/symbol-namespace sym)))))
    (letrec (walk (fn (stack)
                    (if (empty? stack)
                      false
                      (let (item (first stack)
                            more (rest stack))
                        (cond
                          (symbol? item) (or (ours? item) (walk more))
                          (fn? item)
                            (let (named (function-name item))
                              (or (and named (ours? named)) (walk more)))
                          (map? item) (walk (append (keys item) (vals item) more))
                          (or (vector? item) (list? item) (set? item))
                            (walk (append (vec item) more))
                          else (walk more))))))
      (walk (list value)))))

(defn- drop-references (name)
  "Drop every registry row — bedit's and `editor/layers`' — that still names package `name`,
and answer the buffer types it took away."
  (let (namespaces (package-modules name)
        defined (into #{} (registry/lookup :packages/defined name []))
        ours? (fn (value) (names-package? value namespaces defined))
        bookkeeping #{"ownership" "packages"})
    (doseq ([id table] registry/*registries*)
      (when (not (and (keyword? id) (contains? bookkeeping (ownership/symbol-namespace id))))
        (doseq ([key entry] table) (when (ours? entry) (ownership/drop-entry! id key)))))
    (doseq (ref editor/layers/*system-layers*)
      (when (ours? ref) (editor/layers/unregister-system-layer ref)))
    (doseq (rule editor/layers/*auto-type-by-file*)
      (when (ours? (:match rule)) (editor/layers/unregister-file-type (:match rule) (:type rule))))
    (into #{}
      (seq/keep editor/layers/*type-layers*
        (fn ([type refs])
          (when (ours? refs) (ownership/drop-entry! :modes/type-layers type) type))))))

;; ---- retiring a package -----------------------------------------------------------

(defn- note-loaded (name globals-before settings-before)
  "Record what package `name`'s load did, against the image `globals-before` it: the globals
it first defined (`:packages/defined`), the core ones it redefined, the std registry entries
it wrote with what they held, its settings — and its namespaces, so its commands and hooks
register for it as they run (`ownership/own-namespace!`)."
  (let (prefix (str (pkg-dir name) "/"))
    (registry/put! :packages/defined
      name
      (vec (seq/filter (reflect/global-names)
             (fn (global)
               (and (not (contains? globals-before global)) (sited-under? global prefix))))))
    (note-redefinitions name globals-before)
    (note-std-writes name globals-before)
    (adopt-settings name settings-before)
    (doseq (module (package-modules name)) (ownership/own-namespace! module (claimant-file name)))))

(defn retire-package (name)
  "Take package `name` out of the live editor, in the one order that leaves nothing pointing
at a name about to go: its bedit registrations back ([[release-registrations]]), the std
registry entries its modules wrote directly back ([[retract-std-writes]]), any row still
naming it dropped ([[drop-references]]), the core names it redefined restored
([[restore-redefinitions]]), then the globals it first defined removed
([[retire-definitions]]). The image half of [[remove!]] and [[update-plugin!]], which put
the open buffers right ([[ed-settle-package-buffers]]) with the buffer types it answers.
Answers `{:released :restored :retired :types}`."
  (let (released (release-registrations name)
        loose-writes (retract-loose-writes name)
        std-writes (retract-std-writes name)
        dropped-types (drop-references name)
        restored (restore-redefinitions name)
        retired (retire-definitions name)
        types (into dropped-types
                (append (seq/keep released (fn ([kind key]) (when (= kind :modes/type-layers) key)))
                  (seq/keep (append std-writes loose-writes)
                    (fn (write)
                      (when (and (= (:global write) 'editor/layers/*type-layers*) (:path write))
                        (first (:path write))))))))
    (doseq (module (package-modules name)) (ownership/disown-namespace! module))
    {:released (count released) :restored restored :retired retired :types types}))

(defn ed-settle-package-buffers (m name types)
  "`m` with every buffer of one of `types` — the buffer types package `name`'s retirement
took away — seeded again: in the mode its type has now (the new version's, or the core mode
the package had replaced), else in fundamental mode, and *Messages* says which went to
fundamental mode, as Emacs's `unload-feature` puts a removed major mode's buffers in
`fundamental-mode`."
  (if (empty? types)
    m
    (let ([settled orphaned] (fold (range (count (:buffers m)))
                               [m []]
                               (fn (acc index)
                                 (let ([model names] acc
                                       buf (ed-buf-at model index))
                                   (cond
                                     (not (contains? types (:type buf))) acc
                                     (empty? (editor/layers/layers-for-type (:type buf)))
                                       [(ed-set-buf-at model
                                          index
                                          (editor/layers/init-buffer-layers (editor/layers/set-buffer-type buf
                                                                              :fundamental)))
                                         (conj names (buffer-name buf))]
                                     else
                                       [(ed-set-buf-at model
                                          index
                                          (editor/layers/init-buffer-layers buf))
                                         names])))))
      (if (empty? orphaned)
        settled
        (message settled
          (str "removed "
            name
            ": "
            (string/join orphaned ", ")
            (if (= (count orphaned) 1) " is" " are")
            " in fundamental mode now"))))))

(defn plugin-entry (name &optional (reload? false))
  "Load package `name` (its src must be on the load-path) — again, from its files, when
`reload?` — and return its `(bedit-plugin)` contribution map, or a failure saying why not:
its module did not load (the load's own error), it has no `bedit-plugin` entry, or the entry
threw. A module the image loaded once and whose definitions were since retired (a removed
package installed again) is loaded from its files too: `require-one` would take it as loaded."
  (let (module (symbol name)
        entry-name (entry-symbol name)
        loaded (try
                 (do
                   (if reload? (reload-sources name) (require-one module))
                   (when (not (bound? entry-name)) (reload-sources name))
                   true)
                 (catch e (failure "its module did not load: " (error-message e)))))
    (cond
      (failure? loaded) loaded
      (not (bound? entry-name)) (failure "it has no `" name "/bedit-plugin` entry")
      else
        (try
          (let (contribution ((reflect/eval entry-name)))
            (if (map? contribution)
              contribution
              (failure "its `bedit-plugin` answered " (pr-str contribution) ", not a map")))
          (catch e (failure "its `bedit-plugin` threw: " (error-message e)))))))

(defn apply-plugin! (name &optional (reload? false))
  "Load package `name`'s contribution into the LIVE editor: put it on the load-path, load it,
register its themes. Answers true, or the failure [[plugin-entry]] gave — which says why —
and records which it was ([[package-status]]). Realtime: the theme appears in
`M-x theme-select` immediately. Everything the package registers — at load, or here — is
claimed for it (`ownership`), so it can all be taken back.

With `reload?` its files are loaded again even when the image has its module — what an
update needs after [[update-plugin!]] retired the old version."
  (add-to-load-path! name)
  (let (settings-before (registry/entries config/*settings*)
        globals-before (global-values)
        contribution (ownership/with-claimant (claimant-file name)
                       (fn ()
                         (let (loaded (plugin-entry name reload?))
                           (when (not (failure? loaded))
                             (doseq (theme (or (:themes loaded) [])) (register-theme! theme)))
                           loaded))))
    (note-loaded name globals-before settings-before)
    (if (failure? contribution)
      (do (note-status name :broken (error-message contribution)) contribution)
      (do (note-status name :loaded nil) true))))

(defn update-plugin! (m name)
  "`[m' applied]`: package `name`'s loaded version RETIRED and the files now in its directory
applied, as package.el reloads an upgraded package and better — everything the old version
registered taken back, the core names it redefined restored and every global it first
defined removed ([[retire-package]]) before the new files load, so nothing the new version
dropped stays callable or registered and what it registers is there once; then the open
buffers of a mode it took away seeded again in the new version's mode, else fundamental
([[ed-settle-package-buffers]]). `applied` is [[apply-plugin!]]'s answer: an update that
fails to load leaves none of the old version behind either — the package reads as broken,
with the reason."
  (let (retired (retire-package name)
        applied (apply-plugin! name true))
    [(ed-settle-package-buffers m name (:types retired)) applied]))

;; ---- what became of each installed package -----------------------------------------
;; Emacs's package.el marks a package it will not activate (`incompat`, `disabled`) and says so;
;; one bedit does not load is never dropped in silence. Kept in a process-global registry
;; (`:packages/status`), since startup loads packages in a process of its own.

(defn- note-status (name status reason)
  (registry/put! :packages/status name {:status status :reason reason}))

(defn package-status (name)
  "What became of installed package `name` in this image: `{:status :reason}` — `:loaded`,
`:broken` (it did not load or its plugin failed; `:reason` says how) or `:incompatible` (it
does not declare it enhances this bedit; `:reason` says what it asks for) — or nil when it was
never looked at."
  (registry/lookup :packages/status name))

(defn incompatible-reason (name)
  "Why installed package `name` is not for this bedit: it asks for another bedit version, or it
does not say it enhances bedit at all (an upgrade of bedit past the range it declared, or a
package put there by hand)."
  (let (enhances (manifest-value name :enhances)
        wanted (when (map? enhances) (get enhances (symbol *bedit-name*))))
    (if (nil? wanted)
      "it does not declare that it enhances bedit"
      (str "it needs bedit "
        (if (string? wanted) wanted (pr-str wanted))
        ", and this is bedit "
        (about/bedit-version)))))

(defn load-problems ()
  "What startup says about the installed packages it did not load: one line per incompatible or
broken package, with the reason. `[]` when every one loaded."
  (vec (seq/keep (sort (installed-packages))
         (fn (name)
           (let (status (package-status name))
             (case (:status status)
               :incompatible (str "packages: " name " was not loaded — " (:reason status))
               :broken (str "packages: " name " is broken — " (:reason status))
               nil))))))

;; ---- startup: discover + load what's installed -----------------------------

(defn- compatible-in (dir)
  "The packages under `dir` that `:enhances` THIS bedit — name and version range both — the
one test startup and an install share (std's `project/enhancers-in`)."
  (project/enhancers-in dir *bedit-name* (about/bedit-version)))

(defn load-installed! ()
  "At startup: put every installed package that `:enhances` this bedit on the load-path, and
apply it. Returns the vector of names applied. Safe with no packages dir (⇒ []). A refused
package (another editor's, or for another bedit version — a bedit upgrade can make one so) is
not put on the load path at all: its `src/` would otherwise shadow modules for code that never
asked for it. It is not dropped in silence either: each installed package's fate is recorded
([[package-status]]) for the *Packages* buffer and [[load-problems]]."
  (let (compatible (compatible-in (user-package-dir)))
    (doseq (name (installed-packages))
      (when (not (includes? compatible name))
        (note-status name :incompatible (incompatible-reason name))))
    (vec (seq/keep compatible (fn (name) (when (= true (apply-plugin! name)) name))))))

;; ---- the network work: what a package job does (in its task) -------------------
;; Each answers an OUTCOME map — never raises, so a reason never turns into a bare \"the task
;; errored\": `{:kind :name …}` plus `:error` (the reason, a string) when it failed.

(defn- reason-of (value)
  "The reason a registry call gave: a failure's message, or a raised error's."
  (error-message value))

(defn- clear-stale-staging (packages-dir)
  "Remove the staging directories a cancelled or crashed install left behind. Best effort: a
cancelled install's extraction may still be finishing in one, and a leftover is harmless —
it holds no manifest at the top, so it is never taken for a package."
  (when (file/dir? packages-dir)
    (doseq (entry (file/ls packages-dir))
      (when (string/starts-with? entry ".staging-")
        (check-allow :discarded-catch
          (try (file/rmdir (path/join packages-dir entry)) (catch _ nil)))))))

(defn- staged-install (registry name)
  "Install `name` through `registry`'s `:install` into a fresh staging directory, and move it
into place only when it arrived AND enhances this bedit. Answers the install's result map
(its `:path` the final one), or a failure carrying the reason — the installed copy, if there
was one, untouched. The signing pins (brood ADR-212) travel into the staging directory and
back, so trust on first use still sees the key it pinned."
  (let (packages-dir (user-package-dir)
        _ (clear-stale-staging packages-dir)
        staging (path/join packages-dir (str ".staging-" (rand/token 4)))
        pins (path/join packages-dir ".signing-pins.blsp")
        staged-pins (path/join staging ".signing-pins.blsp"))
    (file/mkdir staging)
    (when (file/exists? pins) (file/cp pins staged-pins))
    (let (result (try ((:install registry) name staging) (catch e (failure (error-message e)))))
      (cond
        (failure? result) (do (file/rmdir staging) result)
        (not (includes? (compatible-in staging) name))
          (do
            (file/rmdir staging)
            (failure name " does not enhance bedit " (about/bedit-version) " — not installed"))
        else
          (do
            (when (file/exists? staged-pins) (file/cp staged-pins pins))
            (file/rmdir (pkg-dir name))
            (file/rename (path/join staging name) (pkg-dir name))
            (file/rmdir staging)
            (assoc result :path (pkg-dir name)))))))

(defn- fetch-list (registry)
  ;; the hive's bedit packages, or the reason it could not say
  (let (listed (try ((:enhancers registry) *bedit-name*) (catch e (failure (error-message e)))))
    (cond
      (failure? listed) {:kind :list :error (reason-of listed)}
      (or (list? listed) (vector? listed)) {:kind :list :available (vec listed)}
      ;; nil: a registry answer with no `:packages` — nothing published yet
      else {:kind :list :available []})))

(defn- install-job (registry name)
  (let (result (staged-install registry name))
    (if (failure? result)
      {:kind :install :name name :error (reason-of result)}
      {:kind :install :name name :result result})))

(defn- update-job (registry name)
  ;; newer on the hive: install it; current: say so; the version check failing: say why
  (let (installed (installed-version name)
        latest (try ((:latest-version registry) name) (catch e (failure (error-message e)))))
    (cond
      (failure? latest) {:kind :update :name name :error (reason-of latest)}
      (nil? latest) {:kind :update :name name :error (str name " is not published on the registry")}
      (and installed (not (version/newer? latest installed)))
        {:kind :update :name name :current true}
      else
        (let (result (staged-install registry name))
          (if (failure? result)
            {:kind :update :name name :error (reason-of result)}
            {:kind :update :name name :result result})))))

(defn run-package-job (registry job)
  "Do package `job` (`{:kind :list}`, `{:kind :install :name}` or `{:kind :update :name}`)
through `registry` (a [[*registry*]] map) and answer its outcome: the job with `:available`
(a list), `:result` (an install), `:current` (an update with nothing newer) — or `:error`, the
reason it failed. Never raises. What a package task runs; inline when headless."
  (try
    (case (:kind job)
      :list (fetch-list registry)
      :install (install-job registry (:name job))
      :update (update-job registry (:name job))
      {:kind (:kind job) :name (:name job) :error (str "no such package job: " (:kind job))})
    (catch e (assoc job :error (error-message e)))))

;; ---- running one off the loop ------------------------------------------------

(defn job-label (job)
  "What a package job is doing, for the status line and C-x C-c: `installing foo`."
  (case (:kind job)
    :list "fetching the package list"
    :install (str "installing " (:name job))
    :update (str "updating " (:name job))
    (str (:kind job))))

(defn package-busy (m)
  "What C-x C-c would kill (`model/register-exit-query`): the package job in flight."
  (if (:package-job m) [(str "package manager: " (job-label (:package-job-info m)))] []))

(defn launch-job (m job)
  "Start package `job` off the loop — refused, with a message naming the running one, while
another is in flight. Headless (a test, a batch run) runs it inline. The *Packages* status line
says what is running.

The two bindings the job reads — `*registry*` and `config/*config-base*` — are captured HERE
and bound again in the task: a binding does not cross into the task's process, and a test's
scratch config dir must not turn into the user's own there."
  (cond
    (:package-job m) (busy-message m)
    (ed-headless?)
      (ed-package-done (assoc m :package-job-info job) (run-package-job *registry* job))
    else
      (let (registry *registry*
            config-base *config-base*
            handle (task (fn ()
                           (binding (*registry* registry *config-base* config-base)
                             (run-package-job registry job)))
                     {:timeout *package-job-timeout-ms*})
            label (str (job-label job) "…"))
        (refresh-packages (message (assoc m
                                     :package-job handle
                                     :package-job-info job
                                     :package-status label)
                            label)))))

(defn- apply-outcome (m outcome)
  "`[m' note]`: a finished install or update applied — an update through [[update-plugin!]],
which puts its mode's open buffers right — and what it says (the echo area and the status
line): the version and signature, a failure's reason, and — when it arrived but its plugin
did not load — why not."
  (let (name (:name outcome)
        update? (= (:kind outcome) :update)
        verb (if update? "update" "install"))
    (cond
      (:error outcome) [m (str verb " of " name " failed: " (:error outcome))]
      (:current outcome) [m (str name " is already up to date")]
      else
        (let ([applied-model applied] (if update? (update-plugin! m name) [m (apply-plugin! name)])
              note (if update?
                     (str "updated " name " → " (:version (:result outcome)))
                     (installed-note name (:result outcome))))
          [applied-model
            (if (failure? applied)
              (str note " — but it was not applied: " (error-message applied))
              (str note " — applied live"))]))))

(check-allow :trusted
  ;; the network work of M-x package-list / package-install / package-update; C-g stops it
  (register-task-reply :package-job
    'packages/ed-package-done
    nil
    "packages"
    {:cancel-on-quit? true :on-quit 'packages/ed-package-quit})
  (register-exit-query :packages 'packages/package-busy)
  (sig ed-package-done (model any -> model))
  (defn ed-package-done (m outcome)
    "Fold a finished package job: a list replaces the browser's rows, an install or update is
applied live and redraws them — and a failure says its reason in the echo area AND on the
*Packages* status line, rather than a bare `install failed`. A nil `outcome` is the task having
died or timed out, said as such."
    (let (job (or (:package-job-info m) {})
          m1 (dissoc m :package-job :package-job-info))
      (cond
        (nil? outcome)
          (let (note (str (job-label job)
                       " failed or timed out after " *package-job-timeout-ms* "ms")
                shown (refresh-packages (message (assoc m1 :package-status note) note)))
            (if (= (:kind job) :list)
              (refill-package-prompt shown note)
              (settle-package-prompt shown)))
        (= (:kind outcome) :list)
        ;; an open package prompt takes the list too, or says why there is none
          (if (:error outcome)
            (let (note (str "could not fetch the package list: " (:error outcome)))
              (refill-package-prompt (refresh-packages (message (assoc m1 :package-status note)
                                                         note))
                note))
            (refill-package-prompt (refresh-packages (assoc m1
                                                       :package-list (:available outcome)
                                                       :package-status nil))))
        else
          (let ([applied note] (apply-outcome m1 outcome))
            (settle-package-prompt (refresh-packages (message (assoc applied :package-status note)
                                                       note))))))))

(defn settle-package-prompt (m)
  "After a job that was not the list's ends, a package prompt opened while it ran (saying the
manager was busy) gets what it waited for: the list fetched now when it has never been —
the prompt saying so until it lands — and its candidates and status brought up to date. Any
other prompt, or none, is left alone."
  (if (nil? (map/get-in m [:minibuffer :package-prompt]))
    m
    (let (fetched (fetch-list-once m))
      (cond
        ;; the fetch is out: the prompt says so, and the list refills it when it lands
        (:package-job fetched) (refill-package-prompt fetched (prompt-status fetched))
        ;; no fetch was needed: the prompt over what is known, its busy note gone
        (= fetched m) (refill-package-prompt fetched nil)
        ;; a fetch ran inline (headless) and its landing refilled the prompt already
        else fetched))))

(defn ed-package-quit (m)
  "C-g's clean-up for a package job (`:on-quit`; the task already killed): the status line says
it stopped, and so does C-g. A cancelled install leaves the installed copy as it was — it never
left its staging directory."
  (let (note (str (job-label (or (:package-job-info m) {})) " stopped"))
    (ed-quit-note (refresh-packages (assoc (dissoc m :package-job-info) :package-status note)) note)))

;; ---- remove (local, so on the loop) ---------------------------------------------

(defn remove! (m name)
  "`[m' removed?]`: package `name` taken out of the live editor and deleted from the user dir —
everything it registered taken back, the core names it redefined restored, the globals it
first defined removed ([[retire-package]]), so its code stops running without a restart and
nothing the editor runs names it; and every open buffer in a mode it took away put in
fundamental mode, said in *Messages* ([[ed-settle-package-buffers]]). `removed?` is false,
and `m` unchanged, when it was not installed."
  (if (not (installed? name))
    [m false]
    (let (retired (retire-package name))
      (registry/remove! :packages/status name)
      (file/rmdir (pkg-dir name))
      [(ed-settle-package-buffers m name (:types retired)) true])))

;; ---- the *Packages* browser (M-x package-list) -----------------------------
;; Rows are 0-indexed to the buffer line (the git-status/dired discipline), nil for the header
;; lines, so `package-row-at` reads the row under point.

(defn- row-status (installed latest)
  (cond
    (nil? installed) :available
    (and latest (version/newer? latest installed)) :update
    else :installed))

(defn- with-load-status (row)
  "`row` as this image left its package: an installed one that did not load reads `broken` or
`incompatible`, the reason in place of its description — what package.el's list shows for a
package it will not activate."
  (let (status (when (:installed row) (package-status (:name row))))
    (if (includes? [:broken :incompatible] (:status status))
      (assoc row :status (:status status) :description (str "(" (:reason status) ")"))
      row)))

(defn package-rows (available)
  "The merged package list for the browser: every hive bedit package in `available` (the
registry's `{:name :latest_version :description}` maps, as last fetched) annotated with its
install status as the DISK has it now, plus any installed package not among them (a local/dev
one, or every installed one before the list has arrived). Each row is
`{:name :installed :latest :status :description}`; an installed package this image could not
load is `:broken` or `:incompatible`, its description the reason ([[package-status]])."
  (let (available-names (map available :name)
        from-hive (map available
                    (fn (entry)
                      (let (name (:name entry)
                            installed (installed-version name)
                            latest (:latest_version entry))
                        {:name name
                         :installed installed
                         :latest latest
                         :description (or (:description entry) "")
                         :status (row-status installed latest)})))
        orphans (seq/keep (installed-packages)
                  (fn (name)
                    (when (not (includes? available-names name))
                      {:name name
                       :installed (installed-version name)
                       :latest nil
                       :description "(installed — not on the registry)"
                       :status :installed}))))
    (map (append from-hive orphans) with-load-status)))

(defn- pad (s width)
  (let (text (str (or s "-")))
    (if (>= (count text) width) text (str text (string/repeat " " (- width (count text)))))))

(defn- status-label (status)
  (case status
    :update "update"
    :installed "installed"
    :broken "broken"
    :incompatible "incompatible"
    "available"))

(defn- render-package-row (row)
  (str "  "
    (pad (status-label (:status row)) 13)
    (pad (:name row) 30)
    (pad (:installed row) 11)
    (pad (:latest row) 10)
    (:description row)))

(def *packages-title*
  "  bedit packages — RET describe · i install · d remove · u update · g refresh · q quit")

(def *packages-columns*
  (str "  "
    (pad "Status" 13)
    (pad "Package" 30)
    (pad "Installed" 11)
    (pad "Latest" 10)
    "Description"))

(def *packages-header-lines* 3)
;; The title, the STATUS line (what is running, how the last job ended — blank when there is
;; nothing to say) and the column heads: the first package is the line after them.

(defn render-packages (rows &optional (status nil))
  "The *Packages* buffer text, and the line→row vector aligned to it (nil for header lines).
`status` is the second line: what is running, or how the last job ended (one line)."
  (let (header-lines [*packages-title*
                       (if (nil? status) "" (str "  " (one-line status)))
                       *packages-columns*]
        body (map rows render-package-row)
        ;; rows aligned to buffer lines: one nil per header line, then one row per body line
        line-rows (append (map header-lines (fn (_) nil)) rows))
    {:text (string/join (append header-lines body) "\n")
     :rows line-rows}))

(defn package-row-at (m)
  "The package row under point in *Packages*, or nil on a header line."
  (let (rows (:package-rows m)
        i (buffer-current-line (ed-current-buf m)))
    (if (and rows (>= i 0) (< i (count rows))) (nth rows i) nil)))

(defn- browser-text (m)
  ;; the rendering of what the model knows: the last fetched list against the disk now
  (render-packages (package-rows (or (:package-list m) [])) (:package-status m)))

(defn refresh-packages (m)
  "Redraw *Packages* in place from what the model knows — the last fetched list, the disk as
it is now, the status line — keeping point on its line (or, from the header, moving it to the
first package once there is one) and the selection where it is. A no-op when the browser is not
open (a job started from a prompt)."
  (let (index (ed-buffer-index-by-name m "*Packages*"))
    (if (nil? index)
      m
      ;; the line a reader is on: the selected window's when it shows the browser (a pane's
      ;; point is window-local), else the buffer's own
      (let (line (buffer-current-line (if (= (ed-current-index m) index)
                                        (ed-current-buf m)
                                        (nth (:buffers m) index)))
            target (inc (math/max line *packages-header-lines*))
            rendered (browser-text m)
            updated (ed-upsert-named (assoc m :package-rows (:rows rendered))
                      "*Packages*"
                      (:text rendered)
                      :packages)
            placed (ed-update-named updated "*Packages*" (fn (b) (ed-goto-line b target))))
        ;; every window on it opens at that line: a pane's point into the old text is an
        ;; offset into a different layout now
        (ed-map-panes placed
          (fn (pane) (if (= (:buffer pane) index) (assoc pane :point nil :mark nil) pane)))))))

(defn show-packages (m)
  "Show *Packages* — the installed packages at once, the hive's when its list arrives — and
fetch the list off the loop. Point lands on the first package."
  (let (rendered (browser-text m)
        shown (ed-show-named (assoc m :package-rows (:rows rendered))
                "*Packages*"
                (:text rendered)
                :packages)
        placed (ed-apply shown (fn (b) (ed-goto-line b (inc *packages-header-lines*)))))
    (if (:package-job placed) placed (launch-job placed {:kind :list}))))

;; ---- commands --------------------------------------------------------------

(defcommand cmd-package-list
  (m key)
  "Browse bedit packages from the hive (`M-x package-list`) — install/remove/update live. The
list is fetched off the loop; the status line says when it is coming, and why when it cannot."
  (show-packages m))

(defcommand cmd-package-refresh
  (m key)
  "Re-fetch the package list from the hive and redraw *Packages* (g), off the loop."
  (launch-job m {:kind :list}))

(defcommand cmd-package-quit
  (m key)
  "Bury the *Packages* buffer (q)."
  (commands/cmd-kill-buffer m key))

(defn installed-note (name result)
  "What an install says: the name and version, `signed` when its signature verified against
the key pinned on first install (brood's ADR-212 — `package/registry-install` reports it),
and the warning when something about the signature is wrong. Advisory, as the check is: the
package is installed either way, and this is where the user finds out."
  (let (warning (:warning result))
    (str "installed "
      name
      " "
      (:version result)
      (if (= (:signature result) :verified) " (signed)" "")
      (if (string? warning) (str " — WARNING: " warning) ""))))

(defcommand cmd-package-install
  (m key)
  "Install the package on the current *Packages* line (i), off the loop — its theme appears in
theme-select when it lands. Outside the browser, prompts for a package name."
  (let (row (package-row-at m))
    (cond
      (nil? row) (cmd-package-install-prompt m key)
      (installed? (:name row)) (message m (str (:name row) " is already installed — u to update"))
      else (launch-job m {:kind :install :name (:name row)}))))

(defn- prompt-status (m)
  ;; what a package prompt says it is waiting on: the list on its way, or why it is not
  (let (job (:package-job-info m))
    (cond
      (and (:package-job m) (= (:kind job) :list)) "fetching the package list…"
      (:package-job m) (str "the package manager is busy " (job-label job))
      else nil)))

(defn- prompt-names (m kind)
  "The names a package prompt of `kind` completes over: the hive's packages as last fetched
for `:install`; those and every installed one for `:describe`."
  (let (listed (map (or (:package-list m) []) :name))
    (if (= kind :describe) (seq/distinct (append (installed-packages) listed)) listed)))

(defn package-prompt (m kind prompt on-complete)
  "A minibuffer prompt `prompt` over the packages `m` knows — `kind` `:install` (the hive's)
or `:describe` (those and the installed ones) — running `on-complete` on the answer, saying
what it is waiting on (`:status`). Marked `:package-prompt kind` so the list landing refills
it ([[refill-package-prompt]])."
  (merge (ed-name-prompt prompt (prompt-names m kind) on-complete)
    {:package-prompt kind :status (prompt-status m)}))

(defn fetch-list-once (m)
  "`m` with the hive's package list being fetched off the loop when it has never been and no
package job runs — what a package prompt does before it opens."
  (if (and (nil? (:package-list m)) (nil? (:package-job m))) (launch-job m {:kind :list}) m))

(defn refill-package-prompt (m &optional note)
  "`m` with an open package prompt ([[package-prompt]]) given the packages just fetched —
the typed text kept, the candidates re-ranked from them — and `note` (a failure's reason, or
nil) as what it says. Any other prompt, or none, is left alone."
  (let (mb (:minibuffer m)
        kind (when mb (:package-prompt mb)))
    (if (nil? kind)
      m
      (let (names (prompt-names m kind)
            fresh (ed-name-prompt "" names (:on-complete mb)))
        (assoc (ed-mb-stop-ranker m)
          :minibuffer
            (assoc (merge (dissoc mb :ranker :cand-cache :sel :asked)
                     {:complete-fn (:complete-fn fresh) :rank-source (:rank-source fresh)})
              :status note))))))

(defcommand cmd-package-install-prompt
  (m key)
  "Prompt for a bedit package to install (M-x package-install), completing over the hive's
packages. Before the list has ever been fetched it is fetched now, off the loop: the prompt
opens at once saying so, and its candidates arrive when the hive answers. Any name may be
typed meanwhile."
  (let (fetched (fetch-list-once m))
    (assoc fetched
      :minibuffer
        (package-prompt fetched
          :install "Install package: "
          (fn (mm name) (launch-job mm {:kind :install :name name}))))))

;; ---- what is known about one package (C-h P) -----------------------------------

(def- *settings-registry-names*
  ;; how a package's source names bedit's settings registry in a `settings/define`
  #{:bedit/settings 'config/*settings* '*settings*})

(defn- setting-declared (form)
  "The setting name a `(settings/define <bedit's registry> :name …)` form declares, or nil."
  (when (and (list? form)
          (>= (count form) 3)
          (includes? ['settings/define 'define] (first form))
          (contains? *settings-registry-names* (second form))
          (keyword? (nth form 2)))
    (nth form 2)))

(defn- settings-in-forms (forms)
  "Every setting `forms` declare, at any depth, in the order they appear."
  (letrec (walk (fn (stack found)
                  (if (empty? stack)
                    found
                    (let (form (first stack)
                          more (rest stack)
                          declared (setting-declared form))
                      (cond
                        declared (walk more (conj found declared))
                        (or (list? form) (vector? form)) (walk (append (vec form) more) found)
                        else (walk more found))))))
    (walk forms [])))

(defn package-settings (name)
  "The init.blsp settings installed package `name` declares — every `(settings/define …)` of
bedit's registry its sources hold, READ, not evaluated, so a package not yet loaded answers
too. `[]` when it declares none or is not installed."
  (let (dir (path/join (pkg-dir name) "src"))
    (if (not (file/exists? dir))
      []
      (vec (seq/distinct (mapcat (seq/filter (file/walk-files dir)
                                   (fn (path) (string/ends-with? path ".blsp")))
                           (fn (file)
                             (settings-in-forms (check-allow :discarded-catch
                                                  (try
                                                    (reflect/read-all (file/slurp file))
                                                    (catch e ())))))))))))

(defn package-info (m name)
  "Everything bedit knows about package `name`, or nil when nothing does: `{:name :installed
:latest :status :reason :description :enhances :settings :themes}` — the installed copy's
manifest (its version, description, what it `:enhances`), the hive's row as last fetched (the
newest version), the settings its sources declare ([[package-settings]]) and the themes its
plugin contributes as loaded now. An installed package this image could not load is `:status`
`:broken` or `:incompatible`, with the `:reason` ([[package-status]])."
  (let (row (seq/find (or (:package-list m) []) (fn (entry) (= (:name entry) name)))
        installed (installed-version name)
        latest (:latest_version row)
        load-status (when installed (package-status name))
        failed? (includes? [:broken :incompatible] (:status load-status))
        contribution (when (and installed (not failed?)) (loaded-contribution name)))
    (when (or row installed)
      {:name name
       :installed installed
       :latest latest
       :status (if failed? (:status load-status) (row-status installed latest))
       :reason (when failed? (:reason load-status))
       :description (or (when installed (manifest-value name :description)) (:description row))
       :enhances (or (when installed (manifest-value name :enhances)) (:enhances row))
       :settings (if installed (package-settings name) [])
       :themes (if (map? contribution) (map (or (:themes contribution) []) :name) [])})))

(defn- busy-message (m)
  ;; what a refused request says while a job runs
  (message m
    (str "the package manager is busy " (job-label (:package-job-info m)) " — C-g stops it")))

(defn remove-package (m name)
  "Remove package `name` live and redraw *Packages* — refused while a package job runs, since
an install or update of it landing afterwards would put it straight back."
  (if (:package-job m)
    (busy-message m)
    (let ([removed-model removed?] (remove! (message m (str "removed " name)) name))
      (if removed? (refresh-packages removed-model) (message m (str name " is not installed"))))))

(defcommand cmd-package-remove
  (m key)
  "Remove the package on the current *Packages* line (d), live — its theme leaves theme-select.
Outside the browser, prompts."
  (let (row (package-row-at m))
    (if (nil? row) (cmd-package-remove-prompt m key) (remove-package m (:name row)))))

(defcommand cmd-package-remove-prompt
  (m key)
  "Prompt for an installed package to remove (M-x package-remove)."
  (assoc m
    :minibuffer (ed-name-prompt "Remove package: " (installed-packages) remove-package)))

(defcommand cmd-package-update
  (m key)
  "Update the package on the current *Packages* line (u) to the hive's newest version, off the
loop, and reload it live. Outside the browser, prompts."
  (let (row (package-row-at m))
    (cond
      (nil? row) (cmd-package-update-prompt m key)
      (not (installed? (:name row))) (message m (str (:name row) " is not installed"))
      else (launch-job m {:kind :update :name (:name row)}))))

(defcommand cmd-package-update-prompt
  (m key)
  "Prompt for an installed package to update (M-x package-update)."
  (assoc m
    :minibuffer
      (ed-name-prompt "Update package: "
        (installed-packages)
        (fn (mm name) (launch-job mm {:kind :update :name name})))))

;; ---- packages (the *Packages* browser — M-x package-list) -------------------
(def packages-keymap
  (-> {}
    (keymap-bind ["i"] 'packages/cmd-package-install) ; i — install the package under point
    (keymap-bind ["d"] 'packages/cmd-package-remove) ; d — remove it
    (keymap-bind ["u"] 'packages/cmd-package-update) ; u — update it to the newest version
    (keymap-bind ["g"] 'packages/cmd-package-refresh) ; g — re-fetch the list from the hive
    (keymap-bind [:enter] 'help/cmd-describe-package) ; RET — describe the package under point (C-h P)
    (keymap-bind ["q"] 'packages/cmd-package-quit) ; q — bury the buffer
    (keymap-bind [:ctrl-n] 'commands/cmd-next-line)
    (keymap-bind [:ctrl-p] 'commands/cmd-previous-line)
    (keymap-bind [:down] 'commands/cmd-next-line)
    (keymap-bind [:up] 'commands/cmd-previous-line)))

(def packages-mode-layer
  {:name 'packages
   :doc "Installed and available bedit packages — i installs, u updates, d removes."
   :keymap packages/packages-keymap
   ;; C-n/C-p and the arrows are rebound here to the ORDINARY line motions, and RET to C-h P's
   ;; describe-package; claiming those would hide them from M-x in every other buffer, so
   ;; they stay global
   :commands (modes/layer-commands packages/packages-keymap
               {:except ["next-line" "previous-line" "describe-package"]})})

(modes/register-special-type :packages 'packages/packages-mode-layer)
