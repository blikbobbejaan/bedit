(defmodule syntaxtree
  "The tree-sitter parse tree each pool buffer keeps (brood ADR-443), so highlighting
reparses a document INCREMENTALLY from its last tree instead of re-parsing a sliced window
from scratch on every keystroke.

The model's `:syntax-trees` maps a pool index to `{:tree :rope :lang :from-rope :changes}`:
the kernel's handle, the rope it was parsed from, its language, the rope of the tree it was
updated from, and `editor/treesit/tree-changes` of that update (the char ranges whose
colouring may differ). `panes/ed-refresh-spans` brings the entries of the buffers on screen
up to date each event (`ed-sync-syntax-trees`) and reads them to colour a band
(`editor/treesit/fontify-tree`); `pool/ed-kill-at` drops a killed buffer's
(`ed-drop-syntax-tree-slot`); `treewarm` opens a large buffer's first tree off the loop.

Keyed by pool index, the way `:hosted` is, and kept honest the same way: a kill shifts the
keys above it down. A key that ever names a different document than its tree was parsed
from costs a full reparse and is never wrong, because a handle carries its own text and an
update diffs the two ropes.

A handle is freed in ONE place, after a turn commits (`ed-release-dropped-trees`, which
`input/ed-update` calls): every handle the model held before the turn and not after. Nothing
else here frees, so a turn that throws and is rolled back still names live handles; what a
thrown turn opened is left to the kernel's least-recently-used bound."
  (:use editor/buffer) ; buffer-rope / buffer-length
  (:use model)) ; ed-buf-at / ed-mode-service

(defdyn *tree-open-max*
  ;; The largest buffer whose FIRST tree is opened on the loop. A cold whole-document parse
  ;; of 250 KB costs ~650 ms; below about 40 KB it is imperceptible. A larger buffer keeps
  ;; the windowed slice path until `treewarm` has opened its tree in a task; after that
  ;; every update is incremental and cheap at any size.
  40000)

;; ---- the editor/treesit tree API ------------------------------------------------
;; Each answers nil when the call raises (a language whose grammar is not loaded), which
;; every caller reads as "no tree: take the slice path".

(defn- or-nil (thunk)
  ;; the error IS the answer: a language without a loaded grammar has no tree
  (check-allow :discarded-catch
    (try (thunk) (catch _ nil))))

(defn tree-open (rope lang)
  "A fresh tree handle for the whole document `rope` in tree-sitter language `lang`, or nil."
  (or-nil (fn () (editor/treesit/open-tree rope lang))))

(defn- splice-edits (rope buf)
  "The edits that turned `rope` into `buf`'s text, as the kernel's reparse takes them —
`[start old-end new-end]` per splice, oldest first, each against the text the one before it
left — read from the buffer's own splice log (`buffer-splices-since`), or nil when the log
cannot account for the change (it overflowed, or the text was replaced wholesale)."
  (let (splices (buffer-splices-since (assoc buf :rope rope) buf))
    (when (and splices (not (empty? splices)))
      (into []
        (map splices (fn ([lo hi replacement]) [lo hi (+ lo (string/length replacement))]))))))

(defn- tree-update (tree from-rope buf lang)
  ;; Told the edits when the buffer's splice log knows them, so the kernel need not find the
  ;; change by comparing `from-rope` with the new text — a scan of both ropes per keystroke.
  ;; Without them (nil) it compares, which is exact for one contiguous edit and sound for
  ;; several. Edits that do not fit the two texts are an error rather than a wrong tree, and
  ;; that falls back to the comparison too.
  (let (rope (buffer-rope buf)
        edits (splice-edits from-rope buf)
        told (when edits (or-nil (fn () (editor/treesit/update-tree tree rope lang edits)))))
    (or told (or-nil (fn () (editor/treesit/update-tree tree rope lang nil))))))

(defn tree-free (tree)
  "Drop `tree`'s handle now (nil-safe)."
  (when tree (or-nil (fn () (editor/treesit/free-tree tree)))))

(defn tree-alive? (tree)
  "Whether `tree`'s handle is still held — not freed, not evicted (`editor/treesit/tree-alive?`,
which builds nothing: the check made per event, where asking `tree-changed-ranges` would
build its vector only to test it for nil). False on a runtime without tree handles."
  (= true (or-nil (fn () (editor/treesit/tree-alive? tree)))))

(defn tree-changed-ranges (tree)
  "`editor/treesit/tree-changes` of `tree`: `[[start end] …]`, `true` for a fresh parse, nil
when the handle is gone."
  (or-nil (fn () (editor/treesit/tree-changes tree))))

(defn tree-spans (tree faces from to)
  "`[start end face]` spans, absolute, for chars `[from, to)` of `tree` coloured by the face
table `faces` — `[]` when nothing there is coloured — or nil when the handle is gone."
  (or-nil (fn () (editor/treesit/fontify-tree tree faces from to))))

;; ---- the per-buffer store ----------------------------------------------------------

(defn syntax-tree-entry (m idx)
  "Pool buffer `idx`'s tree entry, or nil."
  (get (or (:syntax-trees m) {}) idx))

(defn current-syntax-tree (m idx buf)
  "Pool buffer `idx`'s tree entry when it was parsed from `buf`'s rope exactly — the only
entry `editor/treesit/fontify-tree` may be asked about, since its offsets are that text's."
  (let (entry (syntax-tree-entry m idx))
    (when (and entry (= (:rope entry) (buffer-rope buf))) entry)))

(defn held-tree-for (entry buf lang)
  "`entry`'s tree handle when it was parsed as `lang` from exactly `buf`'s rope, else nil —
the one test before a held tree is passed to a structural query (`editor/treesit/point-*`,
`indent-column`), whose offsets must be that text's. A command reads the entry off the
model once and asks this of the buffer it is moving in, which an edit in the same command
may already have moved past the tree."
  (when (and entry (= (:lang entry) lang) (= (:rope entry) (buffer-rope buf))) (:tree entry)))

(defn- without-entry (m idx)
  (assoc m :syntax-trees (dissoc (or (:syntax-trees m) {}) idx)))

(defn install-syntax-tree (m idx tree rope lang)
  "`m` with `tree` (parsed from `rope` as `lang`) as pool buffer `idx`'s tree, in place of the
one it had (freed once the turn commits). A fresh parse, so its changes are `true` — every
cached band is suspect."
  (assoc m
    :syntax-trees
      (assoc (or (:syntax-trees m) {})
        idx {:tree tree :rope rope :lang lang :from-rope nil :changes true})))

(defn- synced-entry (m idx buf)
  "`m` with pool buffer `idx`'s tree brought up to `buf`'s rope: kept when current, updated
incrementally from the old tree when the rope moved, opened when there is none and the
buffer is small enough to parse on the loop, dropped when the buffer is no longer a
tree-sitter one.

An entry whose handle is gone (evicted, or freed by a turn that a render failure then rolled
back) counts as none: updating from it would be a full parse anyway, on the loop, so a small
buffer reopens and a large one waits for `treewarm`."
  (let (held (syntax-tree-entry m idx)
        entry (when (and held (tree-alive? (:tree held))) held)
        lang (ed-mode-service buf :ts-lang)
        rope (buffer-rope buf))
    (cond
      (or (nil? lang) (nil? (ed-mode-service buf :ts-faces))) (without-entry m idx)
      (and entry (= (:lang entry) lang) (= (:rope entry) rope)) m
      (and entry (= (:lang entry) lang))
        (let (updated (tree-update (:tree entry) (:rope entry) buf lang))
          (if (nil? updated)
            (without-entry m idx)
            (assoc-in m
              [:syntax-trees idx]
              {:tree updated
               :rope rope
               :lang lang
               :from-rope (:rope entry)
               :changes (tree-changed-ranges updated)})))
      (> (buffer-length buf) *tree-open-max*) (without-entry m idx)
      else
        (let (opened (tree-open rope lang))
          (if (nil? opened) (without-entry m idx) (install-syntax-tree m idx opened rope lang))))))

(defn ed-sync-syntax-trees (m indices)
  "`m` with the trees of the pool buffers at `indices` (the ones on screen) brought up to
date, and every entry whose index fell off the end of the pool dropped."
  (let (pool-size (count (:buffers m))
        swept (fold (keys (or (:syntax-trees m) {}))
                m
                (fn (acc idx) (if (>= idx pool-size) (without-entry acc idx) acc))))
    (fold (seq/distinct indices)
      swept
      (fn (acc idx)
        (if (and (int? idx) (< idx pool-size)) (synced-entry acc idx (ed-buf-at acc idx)) acc)))))

(defn- held-trees (m)
  (map (vals (or (:syntax-trees m) {})) (fn (entry) (:tree entry))))

(defn ed-release-dropped-trees (before after)
  "`after`, once every tree handle `before` held and `after` does not has been freed — the one
place a handle is freed, run when a turn COMMITS, so a turn rolled back to `before` frees
nothing it still names. Freeing a gone handle is a no-op, so a nested turn (a macro's replay)
releasing first is harmless."
  (let (held (held-trees before))
    (if (empty? held)
      after
      (let (kept (held-trees after))
        (do
          (doseq (tree held) (when (not (includes? kept tree)) (tree-free tree)))
          after)))))

(defn- shift-warm-index (m killed)
  "`m` with its in-flight warm's `:tree-warm-index` following pool slot `killed`'s removal."
  (let (index (:tree-warm-index m))
    (cond
      (not (int? index)) m
      (= index killed) (assoc m :tree-warm-index nil)
      (> index killed) (assoc m :tree-warm-index (dec index))
      else m)))

(defn ed-drop-syntax-tree-slot (m killed)
  "Drop pool slot `killed`'s tree ahead of its removal from the pool (freed once the turn
commits), and shift the entries above it down one — mirroring the pool shift, as
`hosted/hosted-drop-slot` does for `:hosted`, so every surviving tree stays with its
document. A warm in flight (`treewarm`) is re-aimed the same way: at the buffer it was
warming, or at none when that is the one killed, so its tree is freed on arrival rather than
installed on a neighbour."
  (let (cleared (shift-warm-index (without-entry m killed) killed)
        trees (:syntax-trees cleared))
    (if (nil? trees)
      cleared
      (assoc cleared
        :syntax-trees
          (fold (%map-pairs trees)
            {}
            (fn (acc [index entry])
              (assoc acc (if (> index killed) (dec index) index) entry)))))))
